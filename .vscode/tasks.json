{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🤖 Explain Go File with Ollama",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": [
                "explain",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "🚀 Generate Handler",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": [
                "generate",
                "handler",
                "${fileBasenameNoExtension}",
                "handler for ${fileBasenameNoExtension}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🧪 Generate Tests",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": [
                "test",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🐛 Debug Code",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": [
                "debug",
                "${input:errorMessage}",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🛡️ Security Analysis",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": [
                "security",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🔍 Check Ollama Health",
            "type": "shell",
            "command": "D:\\go-ollama-agent\\go-ollama-agent.exe",
            "args": ["health"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        }
    ],
    "inputs": [
        {
            "id": "errorMessage",
            "type": "promptString",
            "description": "Enter the error message to debug:",
            "default": "nil pointer dereference"
        }
    ]
}