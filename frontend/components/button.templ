templ Button(btn domain.Button) {
	<button
		id={ btn.Id }
		type="button"
		class={ btn.BtnClass }
		if btn.IsDisabled {
			disabled
		}
		if btn.HxRequestType == "POST" {
			hx-post={ btn.HxActionURL }
		}
		if btn.HxRequestType == "GET" {
			hx-get={ btn.HxActionURL }
		}
		if btn.HxRequestType == "DELETE" {
			hx-delete={ btn.HxActionURL }
		}
		if btn.HxRequestType == "PUT" {
			hx-put={ btn.HxActionURL }
		}
		if btn.HxTarget !="" {
			hx-target={ btn.HxTarget }
		}
		if btn.HxSwap !="" {
			hx-swap={ btn.HxSwap }
		}
		if btn.HxInclude !="" {
			hx-include={ btn.HxInclude }
		}
		if btn.HxVals !="" {
			hx-vals={ btn.HxVals }
		}
		hx-headers='{"X-Request-Source": "btn"}'
		if btn.HxOnAfterRequest != "" {
			hx-on::after-request={ templ.JSFuncCall(fmt.Sprintf("%s", btn.HxOnAfterRequest), btn.HxOnAfterRequestArgs...) }
		}
		if btn.HxOnClick != "" {
			onclick={ templ.JSFuncCall(btn.HxOnClick, btn.HxOnClickArg...) }
		}
	>
		if btn.Icon != "" {
			@Icon(btn.Icon, common.ClassIcon)
		}
		{ btn.LabelText }
	</button>
}

templ ButtonOpenFileDialog(btn domain.Button) {
	<button
		id={ btn.Id }
		type="button"
		class={ btn.BtnClass }
		if btn.IsDisabled {
			disabled
		}
		if btn.HxOnClick != "" {
			hx-on:click={ templ.JSFuncCall(btn.HxOnClick, btn.HxOnClickArg...) }
		}
	>
		if btn.Icon != "" {
			@Icon(btn.Icon, common.ClassIcon)
		}
		if btn.LabelText != "" {
			{ btn.LabelText }
		}
	</button>
}

templ SearchButton(config domain.SearchButtonConfig) {
	<!-- Search button with relative positioning -->
	<div class="">
		<button
			id={ "search-button-" + config.ID }
			name={ config.Name }
			if config.ClassButton != "" {
				class={ config.ClassButton }
			}
			if config.Disabled {
				disabled
			}
			if config.HxUrl !="" {
				hx-get={ config.HxUrl }
			}
			if config.HxTarget !="" {
				hx-target={ config.HxTarget }
			}
			if config.HxSwap !="" {
				hx-swap={ config.HxSwap }
			}
			if config.HxVals !="" {
				hx-vals={ config.HxVals }
			}
			hx-include="this"
			hx-on::after-request={ templ.JSFuncCall("showSearchDialog", "search-dropdown", "search-button-"+config.ID) }
		>
			🔍
		</button>
		<!-- Dropdown container positioned below button -->
		<div
			id="search-dropdown"
			class="hidden absolute top-full left-0 mt-1 w-[50rem] md:w-[40rem] lg:w-[50rem] bg-white border border-gray-300 rounded shadow-lg z-50 max-h-160 overflow-auto"
			onclick="event.stopPropagation()"
		>
			<!-- Content loaded here by HTMX -->
		</div>
	</div>
}
