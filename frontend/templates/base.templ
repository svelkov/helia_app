package templates

import "helia/internal/domain"
import "helia/i18n"

templ Base(isLoggedIn bool, content templ.Component, menuItems domain.MenuDataItems, subMenuItems []domain.SubMenuItem, title string, userName, year string, currentMenu string, comboCompany, comboPoslGod, comboKar, comboLanguage domain.ComboFieldConfig, translator *i18n.Service) {
	<!DOCTYPE html>
	<html lang="en" class="h-screen">
		@Head()
		<style>
			.content-with-bg {
				background-image: url('/frontend/static/helia_background.png');
				background-size: cover;
				background-position: center;
				background-repeat: no-repeat;
				background-attachment: fixed;
			}
		</style>
		<body class="flex flex-col h-screen m-0 p-0 bg-gray-100 text-sm dark:bg-gray-900 dark:text-gray-100">
			<!-- Header -->
			@Header(isLoggedIn, comboCompany, comboPoslGod, comboKar, comboLanguage, translator)
			<!-- Secondary Menu (Conditional) -->
			if isLoggedIn {
				@TopMenu(isLoggedIn, userName, menuItems, currentMenu, translator, comboLanguage.SelectedValue)
				<div id="info-message" class="hidden bg-green-500 text-white rounded flex h-18 text-xl justify-center items-center text-center"></div>
			}
			<!-- Main Content -->
			<div class="flex flex-1 min-h-0 overflow-hidden">
				<!-- Sidebar (Conditional) -->
				if isLoggedIn {
					@Side_nav(subMenuItems)
				}
				<!-- Content Area -->
			<main id="content" class="flex-1 p-1 overflow-y-auto text-sm w-full min-h-0 content-with-bg">
					@content
				</main>
			</div>
			<div id="report-container" class="hidden"></div>
			<!-- Footer content area -->
			@Footer(year)
			<!-- Theme Toggle Script -->
		</body>
