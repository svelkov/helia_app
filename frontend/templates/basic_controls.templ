package templates

import (
	"fmt"

	"helia/internal/common"
)

// Then in template:
templ NumericInputField(id string, value float64, decimals int, disabled bool, classString string) {
	<input
		id={ id }
		name={ id }
		type="text"
        pattern="[0-9]*"
		if disabled {
			disabled
		}
		class={ classString }
		value={ common.FormatNumberWithSystemLocale(value, decimals) }
	/>
}

templ TextInputField(id string, value string, labelText, fieldType string, hasLabel, disabled bool, classInput, classLabel, blurEndpoint, hxTarget, hxVals string) {
	if hasLabel {
		<!-- Label - fixed width -->
		<label for={ id } class={ classLabel }>{ labelText }</label>
	}
	<input
		id={ id }
		name={ id }
		type={ fieldType }
		if disabled {
			disabled
		}
		if blurEndpoint != "" {
			hx-trigger="blur"
			hx-get={ blurEndpoint }
			if hxTarget != "" {
				hx-target={ fmt.Sprintf("#%s", hxTarget) }
				hx-swap="none"
				hx-on--after-request={ fmt.Sprintf("document.getElementById('%s').value = event.detail.xhr.responseText", hxTarget) }
			}
		}
		if hxVals != "" {
			hx-vals={ hxVals }
		}
		class={ classInput }
	/>
}

templ InputField(fieldName, label string, fieldType string) {
	<!-- Date inputs od datuma-->
	<div class="flex items-center gap-2 mb-1">
		<!-- Label - fixed width -->
		<label for={ fieldName } class="text-sm text-gray-700 whitespace-nowrap w-20 flex-shrink-0">{ label }</label>
		<!-- First input - fixed width -->
		<input
			id={ fieldName }
			name={ fieldName }
			type={ fieldType }
			class="h-6 w-30 text-sm rounded-l-sm border border-blue-400 focus:border-blue-500 focus:ring-blue-500 px-1 border text-left"
		/>
	</div>
}

templ SearchButton(fieldId, name, hxUrl, hxTarget, hxSwap, vkonta string) {
	<!-- Search button with relative positioning -->
	<div class="relative">
		<button
			id={ "search-button-" + fieldId }
			name={ name }
			class="h-6 text-sm bg-gray-200 hover:bg-gray-300 px-1 rounded border border-blue-400 flex items-center justify-center flex-shrink-0"
			hx-get={ hxUrl }
			hx-target="#search-dropdown"
			hx-swap="innerHTML"
			hx-include="this"
			hx-vals={ fmt.Sprintf(`{"vkonta": "%s"}`, vkonta) }
			hx-on::after-request={ templ.JSFuncCall("showSearchDialog", fieldId) }
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<!-- Dropdown container positioned below button -->
		<div
			id="search-dropdown"
			class="hidden absolute top-full left-0 mt-1 w-[50rem] md:w-[40rem] lg:w-[50rem] bg-white border border-gray-300 rounded shadow-lg z-50 max-h-160 overflow-auto"
			onclick="event.stopPropagation()"
		>
			<!-- Content loaded here by HTMX -->
		</div>
	</div>
}

templ SearchButtonDialog(id, name, placeholder, hxUrl, hxTarget, hxSwap, vkonta string) {
	<!-- Backend returns this HTML structure: -->
	<div class="p-2 text-sm rounded focus:border-blue-500">
		<!-- Search input field -->
		<div class="mb-3">
			<input
				type="text"
				id="search-input"
				name="query"
				placeholder={ placeholder }
				class="w-full p-2 h-6 text-sm border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500"
				hx-trigger="keyup changed delay:300ms"
				hx-get={ hxUrl }
				hx-target={ hxTarget }
				hx-swap={ hxSwap }
				autocomplete="false"
				hx-vals={ fmt.Sprintf(`{"vkonta": "%s"}`, vkonta) }
				autofocus
			/>
		</div>
		<!-- Search results container -->
		<div id="search-results" class="max-h-64 overflow-auto">
			<!-- Initial results or "Type to search" message -->
			<div class="text-gray-500 text-sm p-2 text-center">
				Type to search for konto...
			</div>
		</div>
		<!-- Close button -->
		<div class="mt-3 pt-2 border-t border-gray-200">
			<button
				class="text-sm px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded"
				onclick={ templ.JSFuncCall("hideDropdown", "search-dropdown") }
			>
				Close
			</button>
		</div>
	</div>
}
