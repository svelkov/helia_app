package templates

import (
	"fmt"

	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

// Then in template:
templ NumericInputField(config domain.InputFieldConfig) {
	<input
		type={ config.FieldType }
		id={ config.ID }
		name={ config.Name }
		value={ config.Value }
		if config.Disabled {
			disabled
		}
		if config.MinLength != "" {
			minlength={ config.MinLength }
		}
		if config.MaxLength != "" {
			maxlength={ config.MaxLength }
		}
		if config.Pattern != "" {
			pattern={ config.Pattern }
		}
		if config.TabIndex != "" {
			tabindex={ config.TabIndex }
		}
		type="number"
		inputmode="numeric"
		oninput="this.value = this.value.replace(/[^0-9.]/g, '');"
		class={ config.ClassInput + " [&::-webkit-outer-spin-button]:hidden [&::-webkit-inner-spin-button]:hidden" }
		value={ common.FormatNumberWithSystemLocale(config.Value, config.DecimalPlaces) }
	/>
}

templ LabelField(config domain.LabelFieldConfig) {
	<label for={ config.ID } class={ config.ClassLabel }>{ config.LabelText }</label>
}

templ TextInputField(config domain.InputFieldConfig) {
	<input
		type={ config.FieldType }
		id={ config.ID }
		name={ config.Name }
		value={ config.Value }
		class={ config.ClassInput }
		if config.Disabled {
			disabled
		}
		if config.BlurEndpoint != "" {
			hx-trigger="blur"
			hx-get={ config.BlurEndpoint }
			if config.HxTarget != "" {
				hx-target={ fmt.Sprintf("#%s", config.HxTarget) }
				hx-swap="innerHTML"
				hx-on--after-request={ fmt.Sprintf(`
					const xhr = event.detail.xhr;
					try {
						// Try to use xhr.response if it's already parsed
						document.getElementById('%s').value = xhr.response.message || JSON.parse(xhr.responseText).message;
					} catch (e) {
						document.getElementById('%s').value = xhr.responseText;
					}
					`, config.HxTarget, config.HxTarget) }
			}
		}
		if config.HxGet != "" {
			hx-get={ config.HxGet }
		}
		if config.HxTarget != "" {
			hx-target={ fmt.Sprintf("#%s", config.HxTarget) }
		}
		if config.HxTrigger != "" {
			hx-trigger={ config.HxTrigger }
		}
		if config.HxInclude != "" {
			hx-include={ config.HxInclude }
		}
		if config.HxSwap != "" {
			hx-swap={ config.HxSwap }
		}
		if config.HxVals != "" {
			hx-vals={ config.HxVals }
		}
		if config.HxInclude != "" {
			hx-include={ config.HxInclude }
		}
		if config.MinLength != "" {
			minlength={ config.MinLength }
		}
		if config.MaxLength != "" {
			maxlength={ config.MaxLength }
		}
		if config.Pattern != "" {
			pattern={ config.Pattern }
		}
		if config.HxOnAfterRequest != "" {
			hx-on::after-request={ templ.JSFuncCall(fmt.Sprintf("%s", config.HxOnAfterRequest), config.ID) }
		}
		if config.TabIndex != "" {
			tabindex={ config.TabIndex }
		}
		if config.OnInput != "" {
			oninput={ templ.JSFuncCall("clearFieldError", config.ID) }
		}
		if config.OnFocus != "" {
			onfocus={ templ.JSFuncCall("clearFieldError", config.ID) }
		}
	/>
}

templ ValidationField(id, className string) {
	<!-- Error Container -->
	<div id={ fmt.Sprintf("%s-error", id) } class={ className }></div>
}

templ SearchButton(config domain.SearchButtonConfig) {
	<!-- Search button with relative positioning -->
	<div class="">
		<button
			id={ "search-button-" + config.ID }
			name={ config.Name }
			if config.ClassButton != "" {
				class={ config.ClassButton }
			}
			if config.Disabled {
				disabled
			}
			if config.HxUrl !="" {
				hx-get={ config.HxUrl }
			}
			if config.HxTarget !="" {
				hx-target={ config.HxTarget }
			}
			if config.HxSwap !="" {
				hx-swap={ config.HxSwap }
			}
			if config.HxVals !="" {
				hx-vals={ config.HxVals }
			}
			hx-include="this"
			hx-on::after-request={ templ.JSFuncCall("showSearchDialog", config.ID) }
		>
			🔍
		</button>
		<!-- Dropdown container positioned below button -->
		<div
			id="search-dropdown"
			class="hidden absolute top-full left-0 mt-1 w-[50rem] md:w-[40rem] lg:w-[50rem] bg-white border border-gray-300 rounded shadow-lg z-50 max-h-160 overflow-auto"
			onclick="event.stopPropagation()"
		>
			<!-- Content loaded here by HTMX -->
		</div>
	</div>
}

templ ComboBoxField(comboConfig domain.ComboFieldConfig, translator *i18n.Service) {
	if comboConfig.HasLabel {
		<!-- Label - fixed width -->
		<label for={ comboConfig.ID } class={ comboConfig.ClassLabel }>{ translator.Label(comboConfig.LabelText) }</label>
	}
	<select
		id={ comboConfig.ID }
		name={ comboConfig.Name }
		if comboConfig.Disabled {
			disabled
		}
		if comboConfig.ChangeEndpoint != "" {
			hx-get={ comboConfig.ChangeEndpoint }
			if comboConfig.HxChangeTarget != "" {
				if comboConfig.HxChangeTarget == "body" {
					hx-target={ fmt.Sprintf("%s", comboConfig.HxChangeTarget) }
				} else {
					hx-target={ fmt.Sprintf("#%s", comboConfig.HxChangeTarget) }
				}
				hx-swap={ comboConfig.HxSwap }
			}
		}
		if comboConfig.HxParams != "" {
			hx-params={ comboConfig.HxParams }
		}
		if comboConfig.HxVals != "" {
			hx-vals={ comboConfig.HxVals }
		}
		if comboConfig.HxOnAfterRequest != "" {
			hx-on::after-request={ templ.JSFuncCall(fmt.Sprintf("%s", comboConfig.HxOnAfterRequest), comboConfig.ID) }
		}
		class={ comboConfig.ClassSelect }
	>
		for _, item := range comboConfig.OptionValues {
			if fmt.Sprintf("%v",item.Key) == comboConfig.SelectedValue {
				<option value={ item.Key } selected>{ item.Value }</option>
			} else {
				<option value={ item.Key }>{ item.Value }</option>
			}
		}
	</select>
}

templ ComboBoxFieldAsTable(comboConfig domain.ComboFieldConfig, translator *i18n.Service) {
	<!-- Container -->
	<div class="flex items-center gap-1">
		<!-- Label - optional -->
		if comboConfig.HasLabel {
			<label for={ comboConfig.ID } class={ comboConfig.ClassLabel }>{ translator.Label(comboConfig.LabelText) }</label>
		}
		<!-- Table-like Combo Box -->
		<div class="relative flex-1">
			<!-- Hidden input to store selected value -->
			<input type="hidden" id={ comboConfig.ID } name={ comboConfig.Name }/>
			<!-- Toggle Button -->
			<button
				type="button"
				if comboConfig.Disabled {
					disabled
				}
				onclick={ templ.JSFuncCall(fmt.Sprintf("document.getElementById('%s-dropdown').classList.toggle('hidden')", comboConfig.ID)) }
				class={ fmt.Sprintf("%s %s", comboConfig.ClassSelect, "text-left flex items-center justify-between") }
			>
				<span id={ fmt.Sprintf("%s-display", comboConfig.ID) }>{ comboConfig.Placeholder }</span>
				<span>▼</span>
			</button>
			<!-- Table-like Dropdown -->
			<div id={ fmt.Sprintf("%s-dropdown", comboConfig.ID) } class="absolute top-full left-0 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-lg z-10 hidden overflow-hidden">
				<!-- Header Row -->
				<div class="grid grid-cols-3 gap-0 bg-blue-100 border-b border-gray-300">
					<div class="px-3 py-2 text-xs font-bold text-blue-800 border-r border-gray-300">Šifra</div>
					<div class="px-3 py-2 text-xs font-bold text-blue-800 border-r border-gray-300 flex-1">Opis</div>
					<div class="px-3 py-2 text-xs font-bold text-blue-800">Tip</div>
				</div>
				<!-- Data Rows - Loop through OptionValues -->
				for idx, item := range comboConfig.OptionValues {
					<div
						class={ fmt.Sprintf("grid grid-cols-3 gap-0 hover:bg-blue-100 cursor-pointer %s", map[bool]string{true: "border-b border-gray-200"}[idx < len(comboConfig.OptionValues)-1]) }
						onclick={ templ.JSFuncCall(fmt.Sprintf("selectComboOption('%s', '%s', '%s')", comboConfig.ID, item.Key, item.Value)) }
					>
						<div class="px-3 py-2 text-sm border-r border-gray-200">{ item.Key }</div>
						<div class="px-3 py-2 text-sm border-r border-gray-200">{ item.Value }</div>
						<div class="px-3 py-2 text-sm">-</div>
					</div>
				}
			</div>
		</div>
	</div>
	<!-- Generic dropdown handler script -->
	<script>
		function selectComboOption(fieldId, key, value) {
			document.getElementById(fieldId).value = key;
			document.getElementById(fieldId + '-display').textContent = value;
			document.getElementById(fieldId + '-dropdown').classList.add('hidden');
		}
		
		// Close dropdown when clicking outside
		document.addEventListener('click', function(event) {
			const allDropdowns = document.querySelectorAll('[id*="-dropdown"]');
			allDropdowns.forEach(dropdown => {
				const fieldId = dropdown.id.replace('-dropdown', '');
				const button = document.querySelector(`[onclick*="${fieldId}"]`);
				if (!dropdown.contains(event.target) && event.target !== button) {
					dropdown.classList.add('hidden');
				}
			});
		});
	</script>
}

templ SearchButtonDialog(id, name, placeholder, hxUrl, hxTarget, hxSwap, hxVals string, translator *i18n.Service) {
	<!-- Backend returns this HTML structure: -->
	<div class="p-2 text-sm rounded focus:border-blue-500">
		<!-- Search input field -->
		<div class="mb-3">
			<input
				type="text"
				id="search-input"
				name="query"
				placeholder={ translator.Placeholder(placeholder) }
				class="w-full p-2 h-6 text-sm border border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500"
				hx-trigger="keyup changed delay:300ms"
				if hxUrl !="" {
					hx-get={ hxUrl }
				}
				if hxTarget !="" {
					hx-target={ hxTarget }
				}
				if hxSwap !="" {
					hx-swap={ hxSwap }
				} else {
					hx-swap="innerHTML"
				}
				if hxVals !="" {
					hx-vals={ hxVals }
				}
				autocomplete="false"
				autofocus
			/>
		</div>
		<!-- Search results container -->
		<div
			id="search-results"
			class="max-h-64 overflow-auto"
		>
			<!-- Initial results or "Type to search" message -->
			<div class="text-gray-500 text-sm p-2 text-center">
				{ placeholder }
			</div>
		</div>
		<!-- Close button -->
		<div class="mt-3 pt-2 border-t border-gray-200">
			<button
				class="text-sm px-3 py-1 bg-gray-200 hover:bg-gray-300 rounded"
				onclick={ templ.JSFuncCall("hideDropdown", "search-dropdown") }
			>
				Close
			</button>
		</div>
	</div>
	@ShowMessage()
}

templ CheckboxField(cfg domain.CheckboxFieldConfig, translator *i18n.Service) {
	<label class={ cfg.ClassLabel }>
		<input
			type="checkbox"
			name={ cfg.Name }
			id={ cfg.ID }
			class={ cfg.ClassCheckbox }
		/>
		<span class={ cfg.ClassCheckboxSpan }>
			{ translator.Label(cfg.LabelText) }
		</span>
		if cfg.IsChecked {
			checked = true
		}
		if cfg.OnChange != "" {
			<script>
				document.getElementById("{ cfg.ID }").addEventListener('change', function() {{
					{ cfg.OnChange }
				}});
			</script>
		}
	</label>
}

templ RadioButtonField(cfg domain.RadioFieldConfig, translator *i18n.Service) {
	<label class="flex items-center gap-2">
		<input
			type="radio"
			name={ cfg.Name }
			id={ cfg.ID }
			value={ cfg.Value }
			class={ cfg.ClassSelect }
			if cfg.TabIndex != "" {
				tabindex={ cfg.TabIndex }
			}
			if cfg.IsSelected {
				checked="checked"
			}
		/>
		<span class={cfg.ClassSelect}>{ translator.Label(cfg.LabelText) }</span>
	</label>
}
