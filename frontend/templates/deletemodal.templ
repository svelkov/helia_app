package templates

import "helia/internal/domain"

templ DeleteDialog(dialog domain.Dialog, btnConfirm, btnCancel, btnClose domain.Button) {
	@Dialog("delete-dialog", DeleteDialogContent(dialog.Id), dialog, btnConfirm, btnCancel, btnClose)
}

templ DeleteDialogContent(rowID string) {
	<p class="mt-3 mb-3 ml-3 text-xl flex items-center justify-center gap-2">Da li zelite da obrišete slog sa ID: { rowID }?</p>
}
