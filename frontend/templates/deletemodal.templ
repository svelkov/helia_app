package templates

import "helia/internal/domain"
import "helia/i18n"
import "helia/internal/common"

templ DeleteDialog(csrfToken string, dialog domain.Dialog, btnConfirm, btnCancel, btnClose domain.Button, rowID string, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in max-w-full w-auto">
			<!-- Title Bar (Flush on Left, Top, Right) -->
			if btnConfirm.Id == "btn-delete" {
				<div class="bg-red-600 text-white h-9 flex justify-between items-center rounded-t-lg">
					<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
					@CloseButton(btnClose)
				</div>
			} else {
				<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
					<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
					@CloseButton(btnClose)
				</div>
			}
			<!-- Content -->
			<form
				hx-delete={ dialog.HxActionURL }
				hx-target="#info-message"
				hx-boost="false"
				class="grid grid-cols-1 md:grid-cols-[auto,auto] gap-2 gap-x-4 p-3 bg-white shadow-lg rounded-lg w-auto"
			>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<div class="px-1 py-1 col-span-2 max-h-[70vh] overflow-y-auto">
					<p class="mt-3 mb-3 ml-3 text-xl flex items-center justify-center gap-2">{ translator.Label("Brisanje sloga sa ID: ") } { rowID }?</p>
				</div>
				<div class="bg-white col-span-2 px-3 py-3 flex justify-end space-x-1 pt-4">
					@ConfirmButton(btnConfirm, translator)
					@CancelButton(btnCancel, translator)
				</div>
			</form>
		</div>
	</div>
	@CloseDialogScript()
	<script>
		function handleDeleteResponse(dialogId) {
			// Check if the response is an error (400 Bad Request)
			console.log("in handleDeleteResponse()", dialogId)
			//console.log("handleFieldErrors:", event.detail)
			try {
				// Get the response text from the backend
				const responseText = event.detail.xhr.responseText;
				//console.log("Response text:", responseText)
				
				// Check if response is empty or not JSON
				if (!responseText || responseText.trim() === '') {
					//console.log("Empty response, closing dialog");
					closeDialog(dialogId);
					return;
				}
				
				// Try to parse as JSON
				let response;
				try {
					response = JSON.parse(responseText);
				} catch (parseError) {
					console.error("Response is not valid JSON:", parseError);
					//console.log("Response text was:", responseText);
					// If not JSON, assume it's HTML success response, close dialog
					closeDialog(dialogId);
					return;
				}
				
				// If we get here, response is valid JSON
				// Clear previous error messages
				document.querySelectorAll('.input-error').forEach(el => el.remove());
				document.querySelectorAll('input').forEach(input => {
					input.classList.remove('border-red-500');
				});
				
				// Handle validation errors
				if (response.errors && response.errors.length > 0) {
					//console.log("Errors found:", response.errors)
					// Loop through errors and show error messages for each field
					response.errors.forEach(error => {
						const field = document.querySelector(`input[name="${error.field}"]`);
						if (field) {
							field.classList.add('border-red-500'); // Add red border to invalid field
							// Add error message below the input field
							const errorMessage = document.createElement('p');
							errorMessage.className = 'text-red-500 text-xs mt-1 input-error';
							errorMessage.textContent = error.message;
							field.insertAdjacentElement('afterend', errorMessage);
						}
					});
					return;
				}
				
				// Handle success response
				if (response.success) {
					showMessage(response.message);
					closeDialog(dialogId);
					return;
				}
				
				// Handle error response
				if (!response.success) {
					showMessage(response.message, true);
					return;
				}	
				
			} catch (e) {
				console.error("Unexpected error in handleDialogResponse():", e);
				closeDialog(dialogId);
			}
		}
	</script>
}
