			}
		}
	</script>
}

templ HandleTipdokAfterRequestScript() {
	<script>
	    function handleTipdokAfterRequest(event) {
			console.log("Tipdok changed, fetching next nalog...", event);
            htmx.trigger('#nalog-trigger', 'tipdokChanged');
        }
	</script>
}

templ SelectRowScript() {
	<script>
		function selectRow(row) {
		   // console.log("Row clicked:", row);
		   // Deselect any previously selected row by removing the 'bg-blue-300' class
			const selectedRow = document.querySelector('.bg-blue-300');
			if (selectedRow) {
			selectedRow.classList.remove('bg-blue-300');
			}

			// Select the clicked row
			row.classList.add('bg-blue-300');
		}
	</script>
}

templ HandleDblClickKontoSelectionScript() {
	<script>
 		function handleDblClickKontoSelection(element) {
	        if (!element) return;
			console.log("handleDblClickKontoSelection: element =", element);
			const destField = element.getAttribute('data-dest-field');
			console.log("handleDblClickKontoSelection: destField =", destField);
			// data-value-col: which column index holds the code value (default 0 = first column)
			const valueCol = parseInt(element.getAttribute('data-value-col') || '0');
    		console.log("handleDblClickKontoSelection: valueCol =", valueCol);
			// Get all table cells in this row
			const cells = element.querySelectorAll('td');
			
			// col 0 = code (konto/sifra), col 1 = second code (sifra), col 2 = naziv
			const vals = Array.from(cells).map(td => td.querySelector('.text-sm')?.textContent?.trim() || '');
			const selectedVal = vals[valueCol] || '';
			const nazivVal = vals[2] || '';
			
			// Set values in form
			if (destField) {
				const destFieldNaziv = destField + 'naziv';
				clearFieldError(destField);
				const fieldInput = document.getElementById(destField);
				const fieldNaziv = document.getElementById(destFieldNaziv);
				if (fieldInput) fieldInput.value = selectedVal;
				if (fieldNaziv) fieldNaziv.value = nazivVal;
			}
			// Close the dialog
            hideDropdown('search-dropdown');
        }
	</script>
}

templ RestrictNumericInput() {
	<script>
		function restrictNumericInput(el, maxDecimals) {
			maxDecimals = (maxDecimals !== undefined) ? maxDecimals
				: (parseInt(el.getAttribute('data-decimals')) || 4);
			const sep = (1.1).toLocaleString().replace(/[0-9]/g, '')[0] || '.';
			const other = sep === '.' ? ',' : '.';
			let v = el.value;
			// predznak minus samo na pocetku i samo jednom
			const neg = v.startsWith('-');
			v = v.replace(/-/g, '');
			// zadrzati samo cifre i separatore
			v = v.replace(/[^0-9.,]/g, '');
			// ukloniti suprotni separator
			v = v.replace(new RegExp('\\' + other, 'g'), '');
			// samo jedan decimalni separator
			const idx = v.indexOf(sep);
			if (idx !== -1) {
				const decimals = v.substring(idx + 1).replace(new RegExp('\\' + sep, 'g'), '');
				v = v.substring(0, idx + 1) + decimals.substring(0, maxDecimals);
			}
			if (neg) v = '-' + v;
			el.value = v;
		}
	</script>
}

templ HandleFormResponseScript() {
	<script>
		// handleFormResponse — universal htmx after-request handler for all dialogs.
		// Usage: hx-on::after-request="handleFormResponse(event, 'POST', 'dialog-nalog')"
		// Conventions:
		//   • dialogId  — id of the dialog root element, e.g. "dialog-nalog"
		//   • message div id = dialogId + "-message",  e.g. "dialog-nalog-message"
		//   • staging slots (#dialog-confirm, #dialog-stavkenaloga) receive sub-dialog HTML
		function handleFormResponse(event, requestType, dialogId, showMsg = true) {
			// Guard: ignore requests from child non-button elements (e.g. combos, inputs with hx-trigger)
			// but allow requests from submit buttons (which have their own hx-post/put and bubble up).
			const _elt = event.detail?.elt;
			if (event.currentTarget && _elt !== event.currentTarget && _elt?.tagName !== 'BUTTON') return;
			const xhr  = event.detail.xhr;
			const ok   = xhr.status === 200 || xhr.status === 201;
			const resp = _dlg_tryJSON(xhr.responseText);
			console.log("Parsed response:", resp);
			// HTML response → new sub-dialog was injected by HTMX into a staging slot
			if (ok && !resp) {
				_dlg_openSubDialog(dialogId, event.detail.target);
				return;
			}

			const msgDiv = _dlg_msgDiv(dialogId);
			if (msgDiv) { msgDiv.classList.add('hidden'); msgDiv.textContent = ''; }

			// Validation field errors
			if (resp?.errors?.length) {
				_dlg_fieldErrors(resp.errors);
				return;
			}

			// Failure (HTTP error or explicit success:false)
			if (!ok || resp?.success === false) {
				console.log("Request failed:", resp?.message || xhr.statusText);
				_dlg_msg(msgDiv, resp?.message, true);
				return;
			}

			// Success
			if (showMsg && resp?.message) {
				_dlg_msg(msgDiv, resp.message, false);
				if (dialogId) setTimeout(() => closeDialog(dialogId), 1500);
			} else if (dialogId) {
				closeDialog(dialogId);
			}
		}

		// Open a sub-dialog that HTMX just injected into a staging slot.
		// Wipes the confirm slot and removes the closing dialog without moving the new one.
		function _dlg_openSubDialog(closingId, swapTarget) {
			// Find new dialog: check swap target first (skip dialog-confirm — it holds current dialog)
			let next = null;
			if (swapTarget?.id !== 'dialog-confirm') {
				const c = swapTarget?.querySelector(':scope > [id]');
				if (c && c.id !== closingId) next = c;
			}
			if (!next) {
				for (const slotId of ['dialog-stavkenaloga', 'dialog-message']) {
					const c = document.getElementById(slotId)?.querySelector(':scope > [id]');
					if (c && c.id !== closingId) { next = c; break; }
				}
			}
			// Clean up old dialogs
			const confirmSlot = document.getElementById('dialog-confirm');
			if (confirmSlot) confirmSlot.innerHTML = '';
			document.getElementById(closingId)?.remove();
			// Show new dialog in place (no DOM move — keeps htmx handlers intact)
			if (next) next.classList.remove('hidden', 'opacity-0');
		}

		function _dlg_msgDiv(dialogId) {
			if (!dialogId) return document.getElementById('dialog-form-message');
			const dlg = document.getElementById(dialogId);
			return dlg?.querySelector('[id$="-message"]')
				|| document.getElementById(dialogId + '-message')
				|| document.getElementById('dialog-form-message');
		}

		function _dlg_tryJSON(text) {
			try { return text?.trim() ? JSON.parse(text) : null; } catch { return null; }
		}

		function _dlg_msg(div, text, isError) {
			if (!div) { if (isError) alert(text); return; }
			// Measure the sibling form width BEFORE unhiding, so a long message
			// cannot expand the w-auto dialog box beyond its natural content width.
			const siblingForm = div.closest('form') || div.parentElement?.querySelector('form');
			const maxW = siblingForm ? siblingForm.offsetWidth : 0;
			div.className = (isError
				? 'p-2 text-sm text-red-800 bg-red-100 border border-red-300'
				: 'p-2 text-sm text-green-800 bg-green-100 border border-green-300')
				+ ' rounded-lg w-full';
			if (maxW > 0) div.style.maxWidth = maxW + 'px';
			div.style.wordBreak = 'break-all';
			div.style.overflowWrap = 'anywhere';
			div.style.whiteSpace = 'normal';
			div.textContent = text;
			div.classList.remove('hidden');
			div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			setTimeout(() => div.classList.add('hidden'), isError ? 5000 : 3000);
		}

		function _dlg_fieldErrors(errors) {
			document.querySelectorAll('.input-error').forEach(el => el.remove());
			document.querySelectorAll('.field-error-inline').forEach(el => { el.textContent = ''; });
			document.querySelectorAll('input').forEach(el => el.classList.remove('border-red-500'));
			errors.forEach(({ field, message }) => {
				const input = document.querySelector(`input[name="${field}"]`);
				if (!input) return;
				input.classList.add('border-red-500');
				const inline = document.getElementById(`${field}-error`);
				if (inline) { inline.textContent = message; return; }
				let wrap = input.closest('.input-error-wrapper');
				if (!wrap) {
					wrap = document.createElement('div');
					wrap.className = 'input-error-wrapper flex flex-col';
					wrap.style.maxWidth = input.offsetWidth + 'px';
					input.parentNode.insertBefore(wrap, input);
					wrap.appendChild(input);
				}
				const p = document.createElement('p');
				p.className = 'text-red-500 text-xs mt-1 input-error whitespace-normal break-words';
				p.textContent = message;
				wrap.appendChild(p);
			});
		}
	</script>
}

templ CloseDialogScript() {
	<script>
		function closeDialog(id) {
			console.log("Closing dialog with ID:", id);
			const dialogElm = document.getElementById(id);
			if (dialogElm) {
				dialogElm.classList.add("opacity-0"); // Fade-out effect
				setTimeout(() => {
					dialogElm.classList.add("hidden");
				}, 300); // Delay to allow fade-out animation

				// Restore the style of actions column if needed
				document.querySelectorAll(".actions-column").forEach(el => {
					el.classList.remove('static');
        			el.classList.add('sticky', 'right-0', 'z-10');
				});
			}
		}
		// Close dialog when pressing "Escape"
		document.addEventListener("keydown", function(event) {
			if (event.key === "Escape") {
				const openDialog = document.querySelector(".fixed:not(.hidden)");
				if (openDialog) {
					closeDialog(openDialog.id);
				}
			}
		});
    </script>
}

templ HideDropdownScript() {
	<script> 
		function hideDropdown(dropdownId) {
			const el = document.getElementById(dropdownId);
			if (el) el.classList.add('hidden');
		}
	</script>
}

// Position dropdown below the button that opened it
templ PositionDropdownScript() {
	<script>
		function positionDropdown(dropdownId, buttonId) {
			const button = document.getElementById(buttonId);
			const dropdown = document.getElementById(dropdownId);
			if (!(button && dropdown)) return;
			const rect = button.getBoundingClientRect();
			dropdown.style.position = 'absolute';
			dropdown.style.top = (rect.bottom + window.scrollY) + 'px';
			dropdown.style.left = (rect.left + window.scrollX) + 'px';
			dropdown.style.zIndex = '1000';
		}
	</script>
}

templ SelectItemScript() {
	// Generic function to select item and close dialog
	<script>
		function selectItem(dropdownId, valueFieldId, nameFieldId, value, name) {
			const vf = document.getElementById(valueFieldId);
			const nf = document.getElementById(nameFieldId);
			if (vf) vf.value = value;
			if (nf) nf.value = name;
			hideDropdown(dropdownId);
			
			// Trigger blur event to update other fields
			if (vf) vf.dispatchEvent(new Event('blur'));
		}
	</script>
}

templ ShowDropdownScript() {
	<script>
		// Show dropdown function
		function showDropdown(dropdownId, buttonId) {
			// First hide any other open dropdowns
			const dropdowns = document.querySelectorAll('[id^="search-dropdown"]');
			dropdowns.forEach(dropdown => {
				dropdown.classList.add('hidden');
			});
			
			// Show the requested dropdown
			const dropdown = document.getElementById(dropdownId);
			dropdown.classList.remove('hidden');
			
			// Position it below the button
			positionDropdown(dropdownId, buttonId);
		}
	</script>
}

// ShowSearchDialogScript renders the JavaScript needed for the search popup
// This should be included once per page, not per popup instance
templ ShowSearchDialogScript() {
	<script>
		function showSearchDialog(dropdownId, buttonId, fixed = true) {
			const dropdown = document.getElementById(dropdownId);
			const button = document.getElementById(buttonId);

			if (!dropdown) return;
			dropdown.classList.remove('hidden');
			if (fixed) {
				const button = document.getElementById(buttonId);
				if (button) {
				const rect = button.getBoundingClientRect();
				const scrollX = window.scrollX || window.pageXOffset;
				const scrollY = window.scrollY || window.pageYOffset;
				dropdown.style.position = 'fixed';
				dropdown.style.top = (rect.bottom + scrollY) + 'px';
				dropdown.style.left = (rect.left + scrollX) + 'px';
				dropdown.style.zIndex = '1000';
				}
			} else {
				positionDropdown(dropdownId, buttonId);
			}
		}

		// Close dropdown when clicking outside
		document.addEventListener('click', function(event) {
			const dropdowns = document.querySelectorAll('[id^="search-dropdown"]');
			dropdowns.forEach(dropdown => {
				if (!dropdown.contains(event.target) && !event.target.closest('[onclick*="showDropdown"]')) {
					dropdown.classList.add('hidden');
				}
			});
		});
	</script>
}

templ ShowMessageScript() {
	<script>
		function showMessage(message, isError = false) {
			const infoMessage = document.getElementById('dialog-form-message');

			// Set the message text
			infoMessage.textContent = message;
			// Reset previous styles
			infoMessage.classList.remove('hidden', 'bg-green-500', 'bg-red-500', 'text-white');
			// Add appropriate styles based on success or error
			if (isError) {
				infoMessage.classList.add('bg-red-500', 'text-white', 'w-full', 'whitespace-normal', 'break-words');
			} else {
				infoMessage.classList.add('bg-green-500', 'text-white', 'w-full', 'whitespace-normal', 'break-words');
			}
			// Show the message
			infoMessage.classList.remove('hidden');
			// Hide the message after 3 seconds
			setTimeout(() => {
				infoMessage.classList.add('hidden');
			}, 3000);
		}
	</script>
}

templ PopulateFproUpdateFormScript() {
	<script>
		// populateFproUpdateForm — reads the JSON response from /api/fpro/stavka/update
		// and assigns values to the matching form fields in nalog-stavke-form.
		// Usage (htmx after-request): hx-on::after-request="populateFproUpdateFormFromEvent(event)"
		function populateFproUpdateFormFromEvent(event) {
			const xhr = event?.detail?.xhr;
			console.log("populateFproUpdateFormFromEvent: event =", event);
			if (!xhr) {
				console.error("populateFproUpdateFormFromEvent: No xhr found in event detail", event);
				return;
			}
			console.log("populateFproUpdateFormFromEvent: xhr =", xhr);
			if (xhr.status !== 200) return;
			let data;
			try { data = JSON.parse(xhr.responseText); } catch { return; }
			populateFproUpdateForm(data);
			_fpro_lockTable();
		}

		function populateFproUpdateForm(data) {
			function setVal(id, value) {
				const el = document.getElementById(id);
				if (el) el.value = (value !== null && value !== undefined) ? value : '';
			}
			// Convert dot-decimal string to comma-decimal (e.g. "1234.56" → "1234,56")
			function toComma(str) {
				return (str || '0').replace('.', ',');
			}

			// Text / date fields
			setVal('konto',    data.konto);
			setVal('sifra',    data.sifra);
			setVal('opisknj',  data.opisknj);
			setVal('dokum',    data.dokum);
			setVal('dadok',    data.dadok);
			setVal('dokumv',   data.dokumv);
			setVal('dadokv',   data.datdokv);   // JSON key: datdokv → field id: dadokv
			setVal('napomena', data.napomena);

			// Integer fields
			setVal('tra',     data.tra);
			setVal('travez',  data.travez);

			// Select / combo fields
			setVal('vrd',        data.vrd);
			setVal('magaciniid', data.magaciniid);
			setVal('fispid',     data.fispid);
			setVal('komid',      data.komid);
			setVal('idorgjed',   data.idorgjed);
			setVal('mestotrid',  data.mestrotrid); // JSON key: mestrotrid → field id: mestotrid
			setVal('idvalute',   data.idvalute);

			// Numeric fields — server sends dot decimal; form uses comma decimal
			setVal('duguje',    toComma(data.duguje));
			setVal('potrazuje', toComma(data.potrazuje));
			setVal('deviznos',  toComma(data.deviznos));
			setVal('kurs',      toComma(data.kurs));

			// Ensure a hidden idfpro field exists so the PUT payload carries the record id
			const form = document.getElementById('nalog-stavke-form');
			if (!form) return;
			let hdnFpro = form.querySelector('input[name="idfpro"]');
			if (!hdnFpro) {
				hdnFpro = document.createElement('input');
				hdnFpro.type  = 'hidden';
				hdnFpro.name  = 'idfpro';
				form.appendChild(hdnFpro);
			}
			hdnFpro.value = data.idfpro || '';
		}

		// Lock the table while a row is being edited
		function _fpro_lockTable() {
			const container = document.getElementById('table-stavke-container');
			if (!container || container.querySelector('#fpro-table-lock')) return;
			const overlay = document.createElement('div');
			overlay.id = 'fpro-table-lock';
			overlay.style.cssText = 'position:absolute;inset:0;background:rgba(255,255,255,0.55);cursor:not-allowed;z-index:10;border-radius:inherit;';
			container.appendChild(overlay);
			_dlg_msg(document.getElementById('dialog-form-message'), 'Uređivanje u toku — sačuvajte stavku', false);
			['btn-cancel', 'btn-print-stavke', 'btn-nazad'].forEach(id => {
				const btn = document.getElementById(id);
				if (!btn) return;
				if (id === 'btn-cancel') { btn.disabled = false; btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
				else { btn.disabled = true; btn.classList.add('opacity-50', 'cursor-not-allowed'); }
			});
		}

		// Unlock the table (called automatically on fpro:changed)
		function _fpro_unlockTable() {
			document.getElementById('fpro-table-lock')?.remove();
			['btn-cancel', 'btn-print-stavke', 'btn-nazad'].forEach(id => {
				const btn = document.getElementById(id);
				if (!btn) return;
				if (id === 'btn-cancel') { btn.disabled = true; btn.classList.add('opacity-50', 'cursor-not-allowed'); }
				else { btn.disabled = false; btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
			});
		}

		// Unlock whenever a save or delete completes (fpro:changed fires from body)
		document.body.addEventListener('fpro:changed', _fpro_unlockTable);
	</script>
}

templ SearchPopupScript() {
	<script>
        // Toggle popup visibility
        function togglePopup(fieldId) {
            const popup = document.getElementById(`${fieldId}-popup`);
            const isHidden = popup.classList.contains('hidden');
            
            // Close all other popups first
            document.querySelectorAll('.absolute.z-50').forEach(el => {
                if (el !== popup) el.classList.add('hidden');
            });
            
            // Toggle this popup
            popup.classList.toggle('hidden');
            
            if (!isHidden) {
                setTimeout(() => document.getElementById(`search-input-${fieldId}`).focus(), 10);
            }
        }

        // Reset search input
        function resetSearch(fieldId) {
            document.getElementById(`search-input-${fieldId}`).value = '';
            htmx.trigger(`#search-input-${fieldId}`, 'keyup');
        }

        // Close popup when clicking outside
        document.addEventListener('click', function(event) {
            // Check all popups
            document.querySelectorAll('[id$="-popup"]').forEach(popup => {
                const fieldId = popup.id.replace('-popup', '');
                const field = document.getElementById(fieldId);
                const searchButton = document.querySelector(`button[onclick="togglePopup('${fieldId}')"]`);
                
                if (field && searchButton && 
                    !popup.contains(event.target) && 
                    !field.contains(event.target) && 
                    !searchButton.contains(event.target)) {
                    popup.classList.add('hidden');
                }
            });
        });

        // Close popup on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                document.querySelectorAll('[id$="-popup"]').forEach(popup => {
                    popup.classList.add('hidden');
                });
            }
        });
    </script>
}
