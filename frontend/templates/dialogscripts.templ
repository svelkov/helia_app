package templates

templ DeactivateActionsColumn() {
	<script>
    	function deactivateActionsColumn() {
			console.log("in Deactivating actions column function");
			// Restore the style of actions column if needed
			document.querySelectorAll(".actions-column").forEach(el => {
				el.classList.add('static');
        		el.classList.remove('sticky', 'right-0', 'z-10');
			});
		}
		
    </script>
}

templ ShowMessage() {
	<script>
		function selectRow(row) {
		   // console.log("Row clicked:", row);
		   // Deselect any previously selected row by removing the 'bg-blue-300' class
			const selectedRow = document.querySelector('.bg-blue-300');
			if (selectedRow) {
			selectedRow.classList.remove('bg-blue-300');
			}

			// Select the clicked row
			row.classList.add('bg-blue-300');
		}

  		function handleDblClickKontoSelection(element) {
	        if (!element) return;
			const destField = element.getAttribute('data-dest-field');
			console.log("selectedrow:", element)
			console.log(" destination field:",destField )
    		// Get all table cells in this row
			const cells = element.querySelectorAll('td');
			
			// Extract values by cell index
			const firstVal = cells[0]?.querySelector('.text-sm')?.textContent?.trim() || '';
			const secondVal = cells[1]?.querySelector('.text-sm')?.textContent?.trim() || '';
			const thirdVal = cells[2]?.querySelector('.text-sm')?.textContent?.trim() || '';
			
			// Set values in form
			if (destField == "konto") {
				clearFieldError("konto")
				const kontoInput = document.getElementById('konto');
				const kontoNaziv = document.getElementById('kontonaziv');
				if (kontoInput) kontoInput.value = firstVal;
				if (kontoNaziv) kontoNaziv.value = thirdVal;
			}
			
			if (destField == "sifra") {
				clearFieldError("sifra")
				const sifraInput = document.getElementById('sifra');
				const sifraNaziv = document.getElementById('sifranaziv');
				if (sifraInput) sifraInput.value = secondVal;
				if (sifraNaziv) sifraNaziv.value = thirdVal;
			}
			
			// Close the dialog
            hideDropdown('search-dropdown');
        }


		function showMessage(message, isError = false) {
			const infoMessage = document.getElementById('info-message');

			// Set the message text
			infoMessage.textContent = message;
			// Reset previous styles
			infoMessage.classList.remove('hidden', 'bg-green-500', 'bg-red-500', 'text-white');
			// Add appropriate styles based on success or error
			if (isError) {
				infoMessage.classList.add('bg-red-500', 'text-white');
			} else {
				infoMessage.classList.add('bg-green-500', 'text-white');
			}
			// Show the message
			infoMessage.classList.remove('hidden');
			// Hide the message after 3 seconds
			setTimeout(() => {
				infoMessage.classList.add('hidden');
			}, 3000);
		}

		function handleDialogResponse(dialogName) {
			// Check if the response is an error (400 Bad Request)
			console.log("in handleDialogResponse()", dialogName)
			console.log("handleFieldErrors:", event.detail)
			try {
				// Parse the JSON response from the backend
				const response = JSON.parse(event.detail.xhr.responseText);
				// Clear previous error messages
				document.querySelectorAll('.input-error').forEach(el => el.remove());
				document.querySelectorAll('input').forEach(input => {
					input.classList.remove('border-red-500');
				});
				if (response.errors && response.errors.length > 0) {
					//console.log("errors:", response.errors)
					// Loop through errors and show error messages for each field
					response.errors.forEach(error => {
						const field = document.querySelector(`input[name="${error.field}"]`);
						if (field) {
							field.classList.add('border-red-500'); // Add red border to invalid field
							// Add error message below the input field
							const errorMessage = document.createElement('p');
							errorMessage.className = 'text-red-500 text-xs mt-1 input-error';
							errorMessage.textContent = error.message;
							field.insertAdjacentElement('afterend', errorMessage);
						}
					});
					return
				}
				if (response.success) {
					showMessage(response.message);
					closeDialog(dialogName);
				}
				if (!response.success) {
					showMessage(response.message, !response.succes);
				}	
					//close the dialog that is sent as parameter
				
				return
			} catch (e) {
				console.error("Invalid JSON response, funkcija handleDialogResponse()", e);
			}
		}
			
		function clearFieldError(inputElement) {
			// If inputElement is already a DOM element
			const elm = document.getElementById(inputElement);
			if (elm) {
				elm.classList.remove('border-red-500');

				let nextSibling = elm.nextElementSibling;

				while (nextSibling && nextSibling.classList.contains('input-error')) {
					nextSibling.remove();
					nextSibling = elm.nextElementSibling;
				}
			}
		}	

		function handleNextNalogResponse(dialogName) {
			console.log("handleNextNalogResponse:", event.detail);
			
			try {
				console.log("u handleNextNalogResponse() ")
				const response = JSON.parse(event.detail.xhr.responseText);
				
				// Check if response has the expected structure
				if (response && response.success && response.nalog) {
					console.log("response", response.nalog);
					
					const nalogElement = document.getElementById('nalog');
					if (nalogElement) {
						nalogElement.value = response.nalog;
					} else {
						console.error("Element with id 'nalog' not found");
					}
				} else {
					console.warn("Response missing expected data:", response);
				}
				
			} catch (e) {
				console.error("Invalid JSON response", e);
			}
		}
		
	</script>
}

templ CloseDialogScript() {
	<script>
		function closeDialog(id) {
			console.log("Closing dialog with ID:", id);
			const dialogElm = document.getElementById(id);
			if (dialogElm) {
				dialogElm.classList.add("opacity-0"); // Fade-out effect
				setTimeout(() => {
					dialogElm.classList.add("hidden");
				}, 300); // Delay to allow fade-out animation

				// Restore the style of actions column if needed
				document.querySelectorAll(".actions-column").forEach(el => {
					el.classList.remove('static');
        			el.classList.add('sticky', 'right-0', 'z-10');
				});
			}
		}
		// Close dialog when pressing "Escape"
		document.addEventListener("keydown", function(event) {
			if (event.key === "Escape") {
				const openDialog = document.querySelector(".fixed:not(.hidden)");
				if (openDialog) {
					closeDialog(openDialog.id);
				}
			}
		}); 
    </script>
}

templ OpenDialogScript(id string) {
	<!-- JavaScript Functions -->
	<script>
		function openDialog() {
			document.querySelectorAll('.actions-column').forEach(el => {
				el.classList.remove('sticky', 'right-0', 'z-10');
				el.classList.add('static');
			});
		}
	</script>
}

