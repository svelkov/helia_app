package templates

// EnterNavigationScript makes Enter and Tab move through the fields of the forms that ask for it (like the
// dialogs with DialogFocusTrapScript, e.g. Robni promet), e.g. the screens of the entry of the robni
// dokumenti. A form asks for it with the attribute data-enter-nav on the container of its fields:
//
//	<div data-enter-nav="robno-fakture-sacuvaj"> ... the fields ... </div>
//
// The fields are taken in the order of their tabindex (the positive ones first, then the rest in the
// order of the page), within the container only, and the fields of an inert (locked) container are
// skipped. Enter and Tab go to the next field, Shift+Tab to the previous one. After the last field the
// focus goes to the button whose id is the value of data-enter-nav (e.g. "Sačuvaj" of the form, so a next
// Enter saves it; without it Tab goes back to the first field and Enter stays on the last one).
//
// The browser's own Tab is not used: a tabindex is global to the page, so it would jump to the fields with
// the same tabindex of the page under a dialog. The keyboard navigation of the tabs (TabNav) leaves the
// containers with data-enter-nav to this script. Enter or Tab that a control used itself (defaultPrevented,
// e.g. a TableCombo selecting a row of its results with Enter), Enter in a textarea, a button or a link and
// the search inputs (type search, e.g. the search of a grid) stay as they are. The listener is installed
// once.
templ EnterNavigationScript() {
	@enterNavigationScript.Once() {
		<script>
			// enterNavFields returns the fields of a container in the order Enter and Tab go through them.
			function enterNavFields(container) {
				const fields = Array.from(container.querySelectorAll(
					'input:not([type="hidden"]):not([disabled]):not([readonly]), select:not([disabled]), textarea:not([disabled])'))
					.filter(el => el.tabIndex >= 0 && el.type !== 'search' && el.getClientRects().length > 0 && !el.closest('[inert]'));
				// The positive tabindex first (in its order), then the rest in the order of the page.
				return fields.map((el, i) => ({ el, i, t: el.tabIndex > 0 ? el.tabIndex : Infinity }))
					.sort((a, b) => a.t - b.t || a.i - b.i).map(x => x.el);
			}
			if (!window.enterNavListener) {
				window.enterNavListener = true;
				document.addEventListener('keydown', function (evt) {
					const isTab = evt.key === 'Tab';
					if ((evt.key !== 'Enter' && !isTab) || evt.defaultPrevented || evt.ctrlKey || evt.altKey || evt.isComposing) return;
					if (!isTab && evt.shiftKey) return;
					const el = evt.target;
					const tag = (el.tagName || '').toLowerCase();
					if (tag !== 'input' && tag !== 'select' && tag !== 'textarea') return;
					// Enter in a textarea is a new line; Enter in a search runs the search.
					if (!isTab && (tag === 'textarea' || el.type === 'search')) return;
					const container = el.closest('[data-enter-nav]');
					if (!container || container.closest('[inert]')) return;
					const fields = enterNavFields(container);
					const idx = fields.indexOf(el);
					if (idx < 0) return;
					evt.preventDefault();
					if (isTab && evt.shiftKey) {
						fields[(idx - 1 + fields.length) % fields.length].focus();
						return;
					}
					if (idx < fields.length - 1) {
						fields[idx + 1].focus();
						return;
					}
					// The last field: the button of the container (e.g. "Sačuvaj"); else Tab goes back to the
					// first field.
					const btn = container.dataset.enterNav ? document.getElementById(container.dataset.enterNav) : null;
					if (btn && !btn.disabled) {
						btn.focus();
					} else if (isTab) {
						fields[0].focus();
					}
				});
			}
		</script>
	}
}

var enterNavigationScript = templ.NewOnceHandle()
