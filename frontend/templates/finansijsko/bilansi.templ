								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic7),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "13",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_08",
								Name:       "pozic_8",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic8),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "14",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_09",
								Name:       "pozic_9",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic9),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "15",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_10",
								Name:       "pozic_10",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic10),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "16",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_11",
								Name:       "pozic_11",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic11),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "17",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_12",
								Name:       "pozic_12",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic12),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "18",
							})
						</div>
					</div>
					<!-- Nivo podataka checkbox -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "lblbs_nivo_podataka",
							LabelText:  translator.Label("Nivo podataka"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@tmpl.NumericInputField(domain.InputFieldConfig{
							ID:         "bs_nivo_podataka",
							Name:       "nipo",
							FieldType:  "text",
							Value:      fmt.Sprintf("%d", bilsData.NiPo),
							ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
							MaxLength:  "2",
							TabIndex:   "18",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
				</div>
				<!-- Buttons - Bottom Right Aligned -->
				<div class="flex gap-1 justify-end">
					@tmpl.SaveButton(btnSave, translator)
					@tmpl.CancelButton(btnCancel, translator)
				</div>
			</form>
			<!-- Message Display Area at Bottom -->
			<div id="dialog-message" class="hidden"></div>
		</div>
	</div>
	@tmpl.HandleFormResponse()
}

// Tab 3 - Stampanje bilansa stanja (Print Balance Sheet)
templ StampanjeBilansaStanja(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint, btnExportXML domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Control Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-2">
					@tmpl.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "bs_skraceni_bilans",
						Name:      "bs_skraceni_bilans",
						Value:     "Y",
						LabelText: translator.Label("Skraćeni bilans"),
						Checked:   false,
						TabIndex:  "1",
					}, translator)
					<span class="text-sm font-medium ml-4">{ translator.Label("Stanje na dan") }:</span>
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "bs_stanje_datum",
						Name:       "bs_stanje_datum",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "2",
					})
					<div class="flex-1"></div>
					<div class="flex items-center gap-1">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.PrintButton(btnPrint, translator)
						@tmpl.Button(btnExportXML, translator)
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="bilansi-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}

// Tab 4 - Bilans uspeha (Income Statement)
templ BilansUspeha(tabs domain.TabData, tbl domain.TableData, searchInput domain.InputControl, totals *domain.BilansiTotals, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Summary panel -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
				<div class="grid grid-cols-4 gap-4 text-sm">
					<!-- Column 1 and 2: Empty -->
					<div></div>
					<div></div>
					<!-- Column 2: Main values -->
					<div class="space-y-1">
						<!-- Tekuća godina -->
						<div class="flex justify-between items-center">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_tekuca_godina",
								LabelText:  translator.Label("Tekuća godina"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "tekuca_godina",
								Name:       "tekuca_godina",
								FieldType:  "text",
								Value:      "0.00",
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
							})
						</div>
						<!-- Prethodna godina -->
						<div class="flex justify-between items-center">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_prethodna_godina",
								LabelText:  translator.Label("Prethodna godina"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "prethodna_godina",
								Name:       "prethodna_godina",
								FieldType:  "text",
								Value:      "0.00",
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
							})
						</div>
					</div>
					<!-- Column 3: Thousands values -->
					<div class="space-y-1">
						<!-- Tekuća u hiljadama -->
						<div class="flex justify-between items-center">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_tekuca_hiljada",
								LabelText:  translator.Label("Tekuća u hiljadama"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "tekuca_hiljada",
								Name:       "tekuca_hiljada",
								FieldType:  "text",
								Value:      "0",
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
							})
						</div>
						<!-- Prethodna u hiljadama -->
						<div class="flex justify-between items-center">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_prethodna_hiljada",
								LabelText:  translator.Label("Prethodna u hiljadama"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "prethodna_hiljada",
								Name:       "prethodna_hiljada",
								FieldType:  "text",
								Value:      "0",
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
							})
						</div>
					</div>
				</div>
			</div>
			<!-- Table section -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tbl, searchInput)
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-container"></div>
	@tmpl.ShowMessage()
	@tmpl.SpinnerScript()
}

// BilansUspehaForm is a separate form component for Bilans uspeha
templ BilansUspehaForm(csrfToken string, bilsData domain.Bilu, dialog domain.Dialog, btnSave, btnCancel, btnClose domain.Button, translator *i18n.Service) {
	<div id={ dialog.Id } class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4">
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in max-w-4xl w-full max-h-[90vh] overflow-y-auto">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg sticky top-0 z-10">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@tmpl.CloseButton(btnClose)
			</div>
			<form
				if dialog.HxRequestType == "PUT" {
					hx-put={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'PUT')"
				}
				if dialog.HxRequestType == "POST" {
					hx-post={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'POST')"
				}
				hx-target="#dialog-message"
				hx-boost="false"
				onsubmit="return false;"
				class="p-3 bg-white rounded-b-lg flex flex-col"
			>
				<!-- Fields Section -->
				<div class="p-1 flex-1 mb-3">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<!-- Top Row: Redni broj, Oznaka za AOP -->
					<div class="flex items-center gap-2 mb-1">
						<div class="flex items-center gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lblbs_redni_broj",
								LabelText:  translator.Label("Redni broj"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_redni_broj",
								Name:       "rbr",
								FieldType:  "text",
								Value:      fmt.Sprintf("%d", bilsData.Rbr),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "1",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<div class="flex items-center gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lblbs_oznaka_aop",
								LabelText:  translator.Label("Oznaka za AOP"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_oznaka_aop",
								Name:       "aop",
								FieldType:  "text",
								Value:      fmt.Sprintf("%d", bilsData.AOP),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<!-- Nivo podataka checkbox -->
						<div class="flex items-center gap-1">
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "bs_skraceni",
								Name:      "skraceni",
								LabelText: "AOP skracenog bilansa",
								Checked:   bilsData.Skraceni == 1,
								TabIndex:  "3",
							}, translator)
						</div>
					</div>
					<!-- Second Row: Grupa računa -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "lblbs_grupa_racuna",
							LabelText:  translator.Label("Grupa računa, račun"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "bs_grupa_racuna",
							Name:       "grac",
							FieldType:  "text",
							Value:      bilsData.Grac,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "50",
							TabIndex:   "4",
						})
					</div>
					<!-- Third Row: Naziv pozicije -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "lblbs_naziv_pozicije",
							LabelText:  translator.Label("Naziv pozicije"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "bs_naziv_pozicije",
							Name:       "nazp",
							FieldType:  "text",
							Value:      bilsData.NazP,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "160",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Fourth Row: Spisak konta -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "lblbs_spisak_konta",
							LabelText:  translator.Label("Spisak konta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "bs_spisak_konta",
							Name:       "konta",
							FieldType:  "text",
							Value:      bilsData.Konta,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "90",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Input fields row 1 - Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lblbs_spisak_konta",
								LabelText:  translator.Label("Pozicije"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_01",
								Name:       "pozic_1",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic1),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "7",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_02",
								Name:       "pozic_2",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic2),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "8",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_03",
								Name:       "pozic_3",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic3),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_04",
								Name:       "pozic_4",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic4),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "10",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_05",
								Name:       "pozic_5",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic5),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "11",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_06",
								Name:       "pozic_6",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic6),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "12",
							})
						</div>
					</div>
					<!-- Input fields row 2 - Additional Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lblbs_pozicije",
								LabelText:  "",
								ClassLabel: common.ClassLabel + " w-40",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_07",
								Name:       "pozic_7",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic7),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "13",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_08",
								Name:       "pozic_8",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic8),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "14",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_09",
								Name:       "pozic_9",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic9),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "15",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_10",
								Name:       "pozic_10",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic10),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "16",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_11",
								Name:       "pozic_11",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic11),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "17",
							})
							@tmpl.NumericInputField(domain.InputFieldConfig{
								ID:         "bs_input_12",
								Name:       "pozic_12",
								FieldType:  "text",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic12),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "18",
							})
						</div>
					</div>
					<!-- Nivo podataka checkbox -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "lblbs_nivo_podataka",
							LabelText:  translator.Label("Nivo podataka"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@tmpl.NumericInputField(domain.InputFieldConfig{
							ID:         "bs_nivo_podataka",
							Name:       "nipo",
							FieldType:  "text",
							Value:      fmt.Sprintf("%d", bilsData.NiPo),
							ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
							MaxLength:  "2",
							TabIndex:   "18",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
				</div>
				<!-- Buttons - Bottom Right Aligned -->
				<div class="flex gap-1 justify-end">
					@tmpl.SaveButton(btnSave, translator)
					@tmpl.CancelButton(btnCancel, translator)
				</div>
			</form>
			<!-- Message Display Area at Bottom -->
			<div id="dialog-message" class="hidden"></div>
		</div>
	</div>
	@tmpl.HandleFormResponse()
}

// Tab 5 - Stampanje bilansa uspeha (Print Income Statement)
templ StampanjeBilansaUspeha(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint, btnExportXML domain.Button, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 5 Content -->
		<div id="tab5" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Control Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-2">
					@tmpl.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "bu_skraceni_bilans",
						Name:      "bu_skraceni_bilans",
						Value:     "Y",
						LabelText: translator.Label("Skraćeni bilans"),
						Checked:   false,
						TabIndex:  "1",
					}, translator)
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "lbloddatuma",
						LabelText:  translator.Label("Od datuma"),
						ClassLabel: common.ClassLabel,
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "oddatuma",
						Name:       "oddatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "2",
					})
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "lbldodatuma",
						LabelText:  translator.Label("Do datuma"),
						ClassLabel: common.ClassLabel,
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "dodatuma",
						Name:       "dodatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "3",
					})
					<div class="flex-1"></div>
					<div class="flex items-center gap-1">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.PrintButton(btnPrint, translator)
						@tmpl.Button(btnExportXML, translator)
					</div>
				</div>
			</div>
			<!-- Data Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}
