package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

// Main entry point for Bilansi module
templ BilansiMain(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@ZakljucniList(tabs, tbl, btnObrada, btnPrint, searchInput, translator, gnGod)
	</div>
}

// Tab 1 - Zakljucni list (Closing List)
templ ZakljucniList(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Column Layout -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex gap-2">
					<!-- Left Column -->
					<div class="w-2/5">
						<!-- Row 1: Tip zakljucnog lista -->
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "tipzakljucnoglista",
								LabelText:  translator.Label("Tip zakljucnog lista"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							<div class="flex gap-3">
								@tmpl.RadioButtonField(domain.RadioFieldConfig{
									ID:         "zakljucni-analitika",
									Name:       "tip_zakljucni",
									Value:      "1",
									LabelText:  translator.Label("Analitika"),
									IsSelected: true,
									TabIndex:   "1",
								}, translator)
								@tmpl.RadioButtonField(domain.RadioFieldConfig{
									ID:         "zakljucni-subsintetika",
									Name:       "tip_zakljucni",
									Value:      "2",
									LabelText:  translator.Label("Subsintetika"),
									IsSelected: false,
									TabIndex:   "2",
								}, translator)
								@tmpl.RadioButtonField(domain.RadioFieldConfig{
									ID:         "zakljucni-sintetika",
									Name:       "tip_zakljucni",
									Value:      "3",
									LabelText:  translator.Label("Sintetika"),
									IsSelected: false,
									TabIndex:   "3",
								}, translator)
							</div>
						</div>
						<!-- Row 2: Od konta and Od sifre -->
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_odkonta",
								LabelText:  translator.Label("Od konta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "odkonta",
								Name:       "odkonta",
								FieldType:  "text",
								Value:      "0000",
								ClassInput: common.ClassInputTextEnabled + " w-20",
								MinLength:  "3",
								MaxLength:  "6",
								TabIndex:   "4",
							})
							@tmpl.SearchButton(domain.SearchButtonConfig{
								ID:          "odkonta",
								Name:        "search-odkonta",
								HxUrl:       "/api/promet/searchbutton",
								HxTarget:    "#search-dropdown",
								HxSwap:      "innerHTML",
								HxVals:      `{"vkonta": "2"}`,
								ClassButton: common.ClassButton,
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_odsifre",
								LabelText:  translator.Label("Od šifre"),
								ClassLabel: common.ClassLabel + " w-20",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "odsifre",
								Name:       "odsifre",
								FieldType:  "text",
								Value:      "00",
								ClassInput: common.ClassInputTextEnabled + " w-20",
								MinLength:  "2",
								MaxLength:  "6",
								TabIndex:   "6",
							})
							@tmpl.SearchButton(domain.SearchButtonConfig{
								ID:          "odsifre",
								Name:        "search-odsifre",
								HxUrl:       "/api/promet/searchbutton",
								HxTarget:    "#search-dropdown",
								HxSwap:      "innerHTML",
								HxVals:      `{"vkonta": "2"}`,
								ClassButton: common.ClassButton,
							})
						</div>
						<!-- Row 3: Do konta and Do sifre -->
						<div class="flex items-center gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_dokonta",
								LabelText:  translator.Label("Do konta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dokonta",
								Name:       "dokonta",
								FieldType:  "text",
								Value:      "999999",
								ClassInput: common.ClassInputTextEnabled + " w-20",
								MinLength:  "3",
								MaxLength:  "6",
								TabIndex:   "5",
							})
							@tmpl.SearchButton(domain.SearchButtonConfig{
								ID:          "dokonta",
								Name:        "search-dokonta",
								HxUrl:       "/api/promet/searchbutton",
								HxTarget:    "#search-dropdown",
								HxSwap:      "innerHTML",
								HxVals:      `{"vkonta": "2"}`,
								ClassButton: common.ClassButton,
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_dosifre",
								LabelText:  translator.Label("Do šifre"),
								ClassLabel: common.ClassLabel + " w-20",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dosifre",
								Name:       "dosifre",
								FieldType:  "text",
								Value:      "999999",
								ClassInput: common.ClassInputTextEnabled + " w-20",
								MinLength:  "2",
								MaxLength:  "6",
								TabIndex:   "7",
							})
							@tmpl.SearchButton(domain.SearchButtonConfig{
								ID:          "dosifre",
								Name:        "search-dosifre",
								HxUrl:       "/api/promet/searchbutton",
								HxTarget:    "#search-dropdown",
								HxSwap:      "innerHTML",
								HxVals:      `{"vkonta": "2"}`,
								ClassButton: common.ClassButton,
							})
						</div>
					</div>
					<!-- Right Column -->
					<div class="w-3/5">
						<!-- Row 1: Checkboxes for display variants -->
						<div class="flex items-center gap-2 mb-1">
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "analitickakonta",
								Name:      "analitickakonta",
								LabelText: translator.Label("Štampanje analitičkih konta"),
								Checked:   true,
								TabIndex:  "11",
							}, translator)
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "klasa9",
								Name:      "klasa9",
								LabelText: translator.Label("Štampanje klase 9"),
								Checked:   false,
								TabIndex:  "12",
							}, translator)
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "samosaprometom",
								Name:      "samosaprometom",
								LabelText: translator.Label("Štampanje konta samo sa prometom"),
								Checked:   false,
								TabIndex:  "13",
							}, translator)
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "zabanku",
								Name:      "zabanku",
								LabelText: translator.Label("Štampanje za banku"),
								Checked:   false,
								TabIndex:  "14",
							}, translator)
						</div>
						<!-- Row 2: Od datuma and Do datuma -->
						<div class="flex items-center gap-4 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_oddatuma",
								LabelText:  translator.Label("Od datuma"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "oddatuma",
								Name:       "oddatuma",
								FieldType:  "date",
								Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "8",
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_datumobrade",
								LabelText:  translator.Label("Datum obrade"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "datumobrade",
								Name:       "datumobrade",
								FieldType:  "date",
								Value:      time.Now().Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "10",
							})
						</div>
						<!-- Row 3: Datum obrade and Buttons -->
						<div class="flex items-center gap-4">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "lbl_dodatuma",
								LabelText:  translator.Label("Do datuma"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dodatuma",
								Name:       "dodatuma",
								FieldType:  "date",
								Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-28 w-full",
								TabIndex:   "9",
							})
							<div class="flex-1"></div>
							<div class="flex items-center gap-1">
								@tmpl.FormObradaButton(btnObrada, translator)
								@tmpl.PrintButton(btnPrint, translator)
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="bilansi-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}

// BilansStanjaForm is a separate form component for Bilans stanja
templ BilansStanjaForm(translator *i18n.Service, gnGod int) {
	<!-- Parameters Section -->
	<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
		<!-- Row 1: Redni broj, Grupa računa, Naziv pozicije -->
		<div class="flex items-center gap-1 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_redni_broj",
				LabelText:  translator.Label("Redni broj"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_redni_broj",
				Name:       "bs_redni_broj",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-20",
				TabIndex:   "1",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_grupa_racuna",
				LabelText:  translator.Label("Grupa računa"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_grupa_racuna",
				Name:       "bs_grupa_racuna",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-40",
				TabIndex:   "2",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_naziv_pozicije",
				LabelText:  translator.Label("Naziv pozicije"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_naziv_pozicije",
				Name:       "bs_naziv_pozicije",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-60",
				TabIndex:   "3",
			})
		</div>
		<!-- Row 2: Oznaka za AOP, Spisak konta, Tekuća godina -->
		<div class="flex items-center gap-1 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_oznaka_aop",
				LabelText:  translator.Label("Oznaka za AOP"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_oznaka_aop",
				Name:       "bs_oznaka_aop",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-20",
				TabIndex:   "4",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_spisak_konta",
				LabelText:  translator.Label("Spisak konta"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_spisak_konta",
				Name:       "bs_spisak_konta",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-60",
				TabIndex:   "5",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_tekuca_godina",
				LabelText:  translator.Label("Tekuća godina"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_tekuca_godina",
				Name:       "bs_tekuca_godina",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-32",
				TabIndex:   "6",
			})
		</div>
		<!-- Row 3: Prethodna godina, Nivo podataka, Tekuća u hiljadama -->
		<div class="flex items-center gap-1 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_prethodna_godina",
				LabelText:  translator.Label("Prethodna godina"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_prethodna_godina",
				Name:       "bs_prethodna_godina",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-32",
				TabIndex:   "7",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_nivo_podataka",
				LabelText:  translator.Label("Nivo podataka"),
				ClassLabel: common.ClassLabel + " w-28",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_nivo_podataka",
				Name:       "bs_nivo_podataka",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-20",
				TabIndex:   "8",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bs_tekuca_hiljada",
				LabelText:  translator.Label("Tekuća u hiljadama"),
				ClassLabel: common.ClassLabel + " w-32",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bs_tekuca_hiljada",
				Name:       "bs_tekuca_hiljada",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-32",
				TabIndex:   "9",
			})
		</div>
		<!-- Input fields row with multiple inputs -->
		<div class="flex gap-2 mt-2">
			<div class="flex gap-1">
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_01",
					Name:       "bs_input_01",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "10",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_02",
					Name:       "bs_input_02",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "11",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_03",
					Name:       "bs_input_03",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "12",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_04",
					Name:       "bs_input_04",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "13",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_05",
					Name:       "bs_input_05",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "14",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_06",
					Name:       "bs_input_06",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "15",
				})
			</div>
			<button class="px-3 py-1 text-xs text-gray-600">...</button>
		</div>
		<div class="flex gap-2 mt-1">
			<div class="flex gap-1">
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_07",
					Name:       "bs_input_07",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "16",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_08",
					Name:       "bs_input_08",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "17",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_09",
					Name:       "bs_input_09",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "18",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_10",
					Name:       "bs_input_10",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "19",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_11",
					Name:       "bs_input_11",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "20",
				})
				@tmpl.TextInputField(domain.InputFieldConfig{
					ID:         "bs_input_12",
					Name:       "bs_input_12",
					FieldType:  "text",
					Value:      "0000",
					ClassInput: common.ClassInputTextEnabled + " w-14 text-center",
					TabIndex:   "21",
				})
			</div>
		</div>
		<!-- Buttons -->
		<div class="flex gap-2 justify-center mt-2">
			<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Novi") }</button>
			<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Izmeni") }</button>
			<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Kopiraj") }</button>
			<button class="px-3 py-1 bg-red-500 hover:bg-red-600 text-white text-sm rounded">{ translator.Label("Briši") }</button>
		</div>
	</div>
}

// Tab 2 - Bilans stanja (Balance Sheet)
templ BilansStanja(tabs domain.TabData, tbl domain.TableData, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Search Section - Full width -->
			<div class="border bg-blue-50 border-blue-400 mt-1 p-1 rounded-lg">
				@tmpl.Search_Part(tbl, searchInput)
			</div>
			<!-- Table and Summary Section -->
			<div class="flex flex-row gap-1 flex-1 min-h-0 overflow-hidden">
				<!-- Main data table -->
				<div class="flex-1 border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden">
					<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
						@tmpl.Table(tbl, translator)
					</div>
				</div>
				<!-- Summary panel -->
				<div class="border bg-white border-gray-300 p-2 rounded-lg w-48 overflow-y-auto">
					<div class="space-y-2 text-sm">
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Tekuća godina") }:</span>
							<span class="font-bold text-right">0.00</span>
						</div>
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Tekuća u hiljadama") }:</span>
							<span class="font-bold text-right">0</span>
						</div>
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Prethodna godina") }:</span>
							<span class="font-bold text-right">0.00</span>
						</div>
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Prethodna u hiljadama") }:</span>
							<span class="font-bold text-right">0</span>
						</div>
						<hr class="my-2"/>
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Prethodna PS") }:</span>
							<span class="font-bold text-right">0.00</span>
						</div>
						<div class="flex justify-between">
							<span class="font-medium">{ translator.Label("Prethodna PS hiljada") }:</span>
							<span class="font-bold text-right">0.00</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}

// Tab 3 - Stampanje bilansa stanja (Print Balance Sheet)
templ StampanjeBilansStanja(tabs domain.TabData, tbl domain.TableData, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Control Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-2">
					@tmpl.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "bs_skraceni_bilans",
						Name:      "bs_skraceni_bilans",
						Value:     "Y",
						LabelText: translator.Label("Skraćeni bilans"),
						Checked:   false,
						TabIndex:  "1",
					}, translator)
					<span class="text-sm font-medium ml-4">{ translator.Label("Stanje na dan") }:</span>
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "bs_stanje_datum",
						Name:       "bs_stanje_datum",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "2",
					})
					<div class="flex-1"></div>
					<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Obradi") }</button>
					<button class="px-3 py-1 bg-green-500 hover:bg-green-600 text-white text-sm rounded">{ translator.Label("Štampaj") }</button>
					<button class="px-3 py-1 bg-purple-500 hover:bg-purple-600 text-white text-sm rounded">{ translator.Label("Export XML") }</button>
				</div>
			</div>
			<!-- Data Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}

// BilansUspehaForm is a separate form component for Bilans uspeha
templ BilansUspehaForm(translator *i18n.Service, gnGod int) {
	<!-- Parameters Section -->
	<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
		<!-- Row 1: Redni broj, Grupa računa, Naziv pozicije -->
		<div class="flex items-center gap-1 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "bu_redni_broj",
				LabelText:  translator.Label("Redni broj"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "bu_redni_broj",
				Name:       "bu_redni_broj",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " w-20",
