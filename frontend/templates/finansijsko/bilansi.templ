package finansijsko

import (
	"fmt"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
	"helia/frontend/components"
)

// biluPrintRowClass returns CSS classes for a Bilans Uspeha print row.
// Summary rows (empty Grac, fields[0]=="") get a subtle background; leaf rows stay white.
func biluPrintRowClass(fields []string) string {
	if len(fields) > 0 && fields[0] == "" {
		return "bg-blue-50 font-semibold"
	}
	return ""
}

// biluCharAt returns the character at position i from s, or " " if out of bounds.
func biluCharAt(s string, i int) string {
	r := []rune(s)
	if i < len(r) {
		return string(r[i])
	}
	return " "
}

// Main entry point for Bilansi module
templ BilansiMain(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Tab Content -->
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@ZakljucniList(tabs, tbl, btnObrada, btnPrint, searchInput, translator, gnGod)
	</div>
	@tmpl.CloseDialogScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleFormResponseScript()
	@tmpl.OpenPrintWithParamsScript()
	@tmpl.HandleBackendResponseScript()
}

// Tab 1 - Zakljucni list (Closing List)
templ ZakljucniList(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Sections - Horizontal Layout -->
			<div class="flex gap-1">
				<!-- Parameters Section - Left Column -->
				<div class="w-2/5 border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
					<!-- Row 1: Tip zakljucnog lista -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "tipzakljucnoglista",
							LabelText:  translator.Label("Tip zakljucnog lista"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						<div class="flex gap-3">
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "zakljucni-analitika",
								Name:       "tip_zakljucni",
								Value:      "1",
								LabelText:  "Analitika",
								IsSelected: true,
								TabIndex:   "1",
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "zakljucni-subsintetika",
								Name:       "tip_zakljucni",
								Value:      "2",
								LabelText:  "Subsintetika",
								IsSelected: false,
								TabIndex:   "2",
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "zakljucni-sintetika",
								Name:       "tip_zakljucni",
								Value:      "3",
								LabelText:  "Sintetika",
								IsSelected: false,
								TabIndex:   "3",
							}, translator)
						</div>
					</div>
					<!-- Row 2: Od konta and Od sifre -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odkonta",
							LabelText:  translator.Label("Od konta"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odkonta",
							Name:       "odkonta",
							FieldType:  "text",
							Value:      "0000",
							ClassInput: common.ClassInputTextEnabled + " w-20",
							MinLength:  "3",
							MaxLength:  "6",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "odkonta",
							Name:        "search-odkonta",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"odkonta": document.getElementById('odkonta').value, "vkonta": "2"}`,
							ClassButton: common.ClassButton,
						})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od šifre"),
							ClassLabel: common.ClassLabel + " w-20",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odsifre",
							Name:       "odsifre",
							FieldType:  "text",
							Value:      "00",
							ClassInput: common.ClassInputTextEnabled + " w-20",
							MinLength:  "2",
							MaxLength:  "6",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('odkonta').value, "vkonta": "1"}`,
							ClassButton: common.ClassButton,
						})
					</div>
					<!-- Row 3: Do konta and Do sifre -->
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dokonta",
							LabelText:  translator.Label("Do konta"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dokonta",
							Name:       "dokonta",
							FieldType:  "text",
							Value:      "999999",
							ClassInput: common.ClassInputTextEnabled + " w-20",
							MinLength:  "3",
							MaxLength:  "6",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "dokonta",
							Name:        "search-dokonta",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('dokonta').value, "vkonta": "2"}`,
							ClassButton: common.ClassButton,
						})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do šifre"),
							ClassLabel: common.ClassLabel + " w-20",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dosifre",
							Name:       "dosifre",
							FieldType:  "text",
							Value:      "999999",
							ClassInput: common.ClassInputTextEnabled + " w-20",
							MinLength:  "2",
							MaxLength:  "6",
							TabIndex:   "7",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('dokonta').value, "vkonta": "1"}`,
							ClassButton: common.ClassButton,
						})
					</div>
				</div>
				<!-- Parameters Section - Right Column -->
				<div class="w-3/5 border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
					<!-- Row 1: Checkboxes for display variants -->
					<div class="flex items-center gap-2 mb-1">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:        "analitickakonta",
							Name:      "analitickakonta",
							LabelText: "Štampanje analitičkih konta",
							Checked:   true,
							TabIndex:  "11",
						}, translator)
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:        "klasa9",
							Name:      "klasa9",
							LabelText: "Štampanje klase 9",
							Checked:   false,
							TabIndex:  "12",
						}, translator)
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:        "samosaprometom",
							Name:      "samosaprometom",
							LabelText: "Štampanje konta samo sa prometom",
							Checked:   false,
							TabIndex:  "13",
						}, translator)
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:        "zabanku",
							Name:      "zabanku",
							LabelText: "Štampanje za banku",
							Checked:   false,
							TabIndex:  "14",
						}, translator)
					</div>
					<!-- Row 2: Od datuma and Do datuma -->
					<div class="flex items-center gap-4 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-28",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "8",
						})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datumobrade",
							LabelText:  translator.Label("Datum obrade"),
							ClassLabel: common.ClassLabel + " w-28",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datumobrade",
							Name:       "datumobrade",
							FieldType:  "date",
							Value:      time.Now().Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "10",
						})
					</div>
					<!-- Row 3: Datum obrade and Buttons -->
					<div class="flex items-center gap-4">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodatuma",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-28",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-28 w-full",
							TabIndex:   "9",
						})
						<div class="flex-1"></div>
						<div class="flex items-center gap-1">
							@components.FormObradaButton(btnObrada, translator)
							@components.Search_PartPrintButton(btnPrint)
						</div>
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="bilansi-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-container"></div>
	<script>
		// Enable/disable sifra field based on tip_zakljucni selection
		function enableDisableField() {
			const checkedRadio = document.querySelector('input[name="tip_zakljucni"]:checked');
			if (!checkedRadio) return;
			
			const isAnalitika = checkedRadio.value === '1';
			const odSifraInput = document.getElementById('odsifre');
			const doSifraInput = document.getElementById('dosifre');
	
			const odSifreBtn = document.querySelector('[name="search-odsifre"]');
			const doSifreBtn = document.querySelector('[name="search-dosifre"]');
			if (odSifreBtn) {
				odSifreBtn.disabled = !isAnalitika;
				odSifreBtn.classList.toggle('cursor-pointer', isAnalitika);
				odSifreBtn.classList.toggle('cursor-not-allowed', !isAnalitika);
			}
			if (doSifreBtn) {
				doSifreBtn.disabled = !isAnalitika;
				doSifreBtn.classList.toggle('cursor-pointer', isAnalitika);
				doSifreBtn.classList.toggle('cursor-not-allowed', !isAnalitika);
			}

			if (odSifraInput) {
				odSifraInput.disabled = !isAnalitika;
				doSifraInput.disabled = !isAnalitika;
				if (!isAnalitika) {
					odSifraInput.value = '';
					doSifraInput.value = '';
				}else {
					odSifraInput.value = '00';
					doSifraInput.value = '999999';
				}
			}
		}
		
		// Use event delegation for radio button changes
		document.addEventListener('change', function(evt) {
			document.querySelectorAll('.input-error').forEach(el => el.remove());
			document.querySelectorAll('.field-error-inline').forEach(el => { el.textContent = ''; });
			document.querySelectorAll('input').forEach(el => el.classList.remove('border-red-500'));
			if (evt.target.name === 'tip_zakljucni') {
				// Clear all validation errors when radio group changes
				enableDisableField();
			} 
		});

		// Re-attach after HTMX swaps
		document.addEventListener('htmx:afterSwap', function(evt) {
			const targetId = evt.detail.target.id;
			if (targetId === 'tab1') {
				setTimeout(enableDisableField, 50);
			}
		});
	</script>
	@tmpl.ClearFieldErrorScript()
	@tmpl.SearchPopupScript()
	@components.SpinnerScript()
}

// Tab 2 - Bilans stanja (Balance Sheet)
templ BilansStanja(tabs domain.TabData, tbl domain.TableData, totals domain.BilansiTotals, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Dialog display container - placed first so HTMX finds it before the Table's internal dialog-container -->
		<div id="dialog-container"></div>
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Summary panel -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
				<div class="grid grid-cols-4 gap-4 text-sm">
					<!-- Column 1 and 2: Empty -->
					<div></div>
					<div></div>
					<!-- Column 2: Main values -->
					<div class="space-y-1">
						<!-- Tekuća godina -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tekuca_godina",
								LabelText:  translator.Label("Tekuća godina"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "tekuca_godina",
								Name:       "tekuca_godina",
								FieldType:  "text",
								Value:      totals.TekGod,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
							})
						</div>
						<!-- Prethodna godina -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "prethodna_godina",
								LabelText:  translator.Label("Prethodna godina"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "prethodna_godina",
								Name:       "prethodna_godina",
								FieldType:  "text",
								Value:      totals.PrethGod,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
							})
						</div>
						<!-- Početno Stanje -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "pocetno_stanje",
								LabelText:  translator.Label("Početno Stanje"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "pocetno_stanje",
								Name:       "pocetno_stanje",
								FieldType:  "text",
								Value:      totals.PocStanje,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
							})
						</div>
					</div>
					<!-- Column 3: Thousands values -->
					<div class="space-y-1">
						<!-- Tekuća u hiljadama -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tekuca_hiljada",
								LabelText:  translator.Label("Tekuća u hiljadama"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "tekuca_hiljada",
								Name:       "tekuca_hiljada",
								FieldType:  "text",
								Value:      totals.TekGodH,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
							})
						</div>
						<!-- Prethodna u hiljadama -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "prethodna_hiljada",
								LabelText:  translator.Label("Prethodna u hiljadama"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "prethodna_hiljada",
								Name:       "prethodna_hiljada",
								FieldType:  "text",
								Value:      totals.PrethGodH,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
							})
						</div>
						<!-- Početno u hiljadama -->
						<div class="flex justify-between items-center">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "pocetno_hiljada",
								LabelText:  translator.Label("Početno u hiljadama"),
								ClassLabel: common.ClassLabel + " w-42",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "pocetno_hiljada",
								Name:       "pocetno_hiljada",
								FieldType:  "text",
								Value:      totals.PocStanjeH,
								Disabled:   true,
								ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
							})
						</div>
					</div>
				</div>
			</div>
			<!-- Table section -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	@tmpl.ShowMessageScript()
	@components.SpinnerScript()
}

// BilansStanjaForm is a separate form component for Bilans stanja
templ BilansStanjaForm(csrfToken string, bilsData domain.Bils, dialog domain.Dialog, btnSave, btnCancel, btnClose domain.Button, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in max-w-4xl w-full max-h-[90vh] overflow-y-auto">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg sticky top-0 z-50">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<form
				if dialog.HxRequestType == "PUT" {
					hx-put={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'PUT', this.dataset.dialogId)"
				}
				if dialog.HxRequestType == "POST" {
					hx-post={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'POST', this.dataset.dialogId)"
				}
				data-dialog-id={ dialog.Id }
				hx-target={ "#" + dialog.Id + "-message" }
				hx-boost="false"
				onsubmit="return false;"
				class="p-3 bg-white rounded-b-lg flex flex-col"
			>
				<!-- Fields Section -->
				<div class="p-1 flex-1 mb-3">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<!-- Top Row: Redni broj, Oznaka za AOP -->
					<div class="flex items-center gap-2 mb-1">
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_redni_broj",
								LabelText:  translator.Label("Redni broj"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_redni_broj",
								Name:       "rbr",
								FieldType:  "number",
								Value:      fmt.Sprintf("%d", bilsData.Rbr),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "1",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_oznaka_aop",
								LabelText:  translator.Label("Oznaka za AOP"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_oznaka_aop",
								Name:       "aop",
								FieldType:  "number",
								Value:      fmt.Sprintf("%d", bilsData.AOP),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<!-- Nivo podataka checkbox -->
						<div class="flex items-center gap-1">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "bs_skraceni",
								Name:      "skraceni",
								LabelText: "AOP skracenog bilansa",
								Checked:   bilsData.Skraceni == 1,
								TabIndex:  "3",
							}, translator)
						</div>
					</div>
					<!-- Second Row: Grupa računa -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_grupa_racuna",
							LabelText:  translator.Label("Grupa računa, račun"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_grupa_racuna",
							Name:       "grac",
							FieldType:  "text",
							Value:      bilsData.Grac,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "50",
							TabIndex:   "4",
						})
					</div>
					<!-- Third Row: Naziv pozicije -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_naziv_pozicije",
							LabelText:  translator.Label("Naziv pozicije"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_naziv_pozicije",
							Name:       "nazp",
							FieldType:  "text",
							Value:      bilsData.NazP,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "160",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Fourth Row: Spisak konta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_spisak_konta",
							LabelText:  translator.Label("Spisak konta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_spisak_konta",
							Name:       "konta",
							FieldType:  "text",
							Value:      bilsData.Konta,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "90",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Input fields row 1 - Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_spisak_konta",
								LabelText:  translator.Label("Pozicije"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_01",
								Name:       "pozic_1",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic1),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "7",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_02",
								Name:       "pozic_2",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic2),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "8",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_03",
								Name:       "pozic_3",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic3),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_04",
								Name:       "pozic_4",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic4),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "10",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_05",
								Name:       "pozic_5",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic5),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "11",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_06",
								Name:       "pozic_6",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic6),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "12",
							})
						</div>
					</div>
					<!-- Input fields row 2 - Additional Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_pozicije",
								LabelText:  "",
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_07",
								Name:       "pozic_7",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic7),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "13",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_08",
								Name:       "pozic_8",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic8),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "14",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_09",
								Name:       "pozic_9",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic9),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "15",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_10",
								Name:       "pozic_10",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic10),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "16",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_11",
								Name:       "pozic_11",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic11),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "17",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_12",
								Name:       "pozic_12",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic12),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "18",
							})
						</div>
					</div>
					<!-- Nivo podataka checkbox -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_nivo_podataka",
							LabelText:  translator.Label("Nivo podataka"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_nivo_podataka",
							Name:       "nipo",
							FieldType:  "number",
							Value:      fmt.Sprintf("%d", bilsData.NiPo),
							ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
							MaxLength:  "2",
							TabIndex:   "18",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
				</div>
				<!-- Buttons - Bottom Right Aligned -->
				<div class="flex gap-1 justify-end">
					@components.SaveButton(btnSave, translator)
					@components.CancelButton(btnCancel, translator)
				</div>
			</form>
			<!-- Message Display Area at Bottom -->
			<div id={ dialog.Id + "-message" } class="hidden"></div>
		</div>
	</div>
	@tmpl.HandleFormResponseScript()
}

// Tab 3 - Stampanje bilansa stanja (Print Balance Sheet)
templ StampanjeBilansaStanja(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint, btnExportXML domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Control Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-2">
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "skraceni",
						Name:      "skraceni",
						LabelText: translator.Label("Skraćeni bilans"),
						Checked:   false,
						TabIndex:  "1",
					}, translator)
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "pocstanjepg",
						Name:      "pocstanjepg",
						Value:     "false",
						LabelText: translator.Label("Preuzmi početno stanje iz prosle godine"),
						Checked:   false,
						TabIndex:  "2",
					}, translator)
					<span class="text-sm font-medium ml-4">{ translator.Label("Stanje na dan") }:</span>
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "stanjenadan",
						Name:       "stanjenadan",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "2",
					})
					<div class="flex-1"></div>
					<div class="flex items-center gap-1">
						@components.FormObradaButton(btnObrada, translator)
						@components.Search_PartPrintButton(btnPrint)
						@components.Button(btnExportXML)
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="bilansi-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessageScript()
}

// Tab 4 - Bilans uspeha (Income Statement)
templ BilansUspeha(tabs domain.TabData, tbl domain.TableData, searchInput domain.InputControl, totals *domain.BilansiTotals, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Summary panel -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
				<div class="grid grid-cols-4 gap-4 text-sm">
					<!-- Column 1 and 2: Empty -->
					<div></div>
					<div
						class="flex-1 min-h-0 overflow-auto"
						hx-get={ tbl.DetailURL }
						hx-trigger="bilu:changed from:body"
						hx-swap="innerHTML"
						hx-headers='{"X-Request-Source": "btnpage"}'
					></div>
					<!-- Column 2: Main values -->
					<div id="bilu_totals" class="flex gap-4 justify-end col-span-2">
						<div class="space-y-1">
							<!-- Tekuća godina -->
							<div class="flex justify-between items-center">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "tekuca_godina",
									LabelText:  translator.Label("Tekuća godina"),
									ClassLabel: common.ClassLabel + " w-44",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "tekuca_godina",
									Name:       "tekuca_godina",
									FieldType:  "text",
									Value:      totals.TekGod,
									Disabled:   true,
									ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
								})
							</div>
							<!-- Prethodna godina -->
							<div class="flex justify-between items-center">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "prethodna_godina",
									LabelText:  translator.Label("Prethodna godina"),
									ClassLabel: common.ClassLabel + " w-44",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "prethodna_godina",
									Name:       "prethodna_godina",
									FieldType:  "text",
									Value:      totals.PrethGod,
									Disabled:   true,
									ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold",
								})
							</div>
						</div>
						<!-- Column 3: Thousands values -->
						<div class="space-y-1">
							<!-- Tekuća u hiljadama -->
							<div class="flex justify-between items-center">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "tekuca_hiljada",
									LabelText:  translator.Label("Tekuća u hiljadama"),
									ClassLabel: common.ClassLabel + " w-44",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "tekuca_hiljada",
									Name:       "tekuca_hiljada",
									FieldType:  "text",
									Value:      totals.TekGodH,
									Disabled:   true,
									ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
								})
							</div>
							<!-- Prethodna u hiljadama -->
							<div class="flex justify-between items-center">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "prethodna_hiljada",
									LabelText:  translator.Label("Prethodna u hiljadama"),
									ClassLabel: common.ClassLabel + " w-44",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "prethodna_hiljada",
									Name:       "prethodna_hiljada",
									FieldType:  "text",
									Value:      totals.PrethGodH,
									Disabled:   true,
									ClassInput: common.ClassInputTextEnabled + " w-40 text-right font-bold mr-2",
								})
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Table section -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-container"></div>
	@tmpl.ShowMessageScript()
	@components.SpinnerScript()
}

// BilansUspehaForm is a separate form component for Bilans uspeha
templ BilansUspehaForm(csrfToken string, bilsData domain.Bilu, dialog domain.Dialog, btnSave, btnCancel, btnClose domain.Button, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in max-w-4xl w-full max-h-[90vh] overflow-y-auto">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg sticky top-0 z-10">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<form
				if dialog.HxRequestType == "PUT" {
					hx-put={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'PUT', this.dataset.dialogId)"
				}
				if dialog.HxRequestType == "POST" {
					hx-post={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'POST', this.dataset.dialogId)"
				}
				data-dialog-id={ dialog.Id }
				hx-target={ "#" + dialog.Id + "-message" }
				hx-boost="false"
				onsubmit="return false;"
				class="p-3 bg-white rounded-b-lg flex flex-col"
			>
				<!-- Fields Section -->
				<div class="p-1 flex-1 mb-3">
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<!-- Top Row: Redni broj, Oznaka za AOP -->
					<div class="flex items-center gap-2 mb-1">
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_redni_broj",
								LabelText:  translator.Label("Redni broj"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_redni_broj",
								Name:       "rbr",
								FieldType:  "number",
								Value:      fmt.Sprintf("%d", bilsData.Rbr),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "1",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_oznaka_aop",
								LabelText:  translator.Label("Oznaka za AOP"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_oznaka_aop",
								Name:       "aop",
								FieldType:  "number",
								Value:      fmt.Sprintf("%d", bilsData.AOP),
								ClassInput: common.ClassInputTextEnabled + " w-24",
								MaxLength:  "4",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<!-- Nivo podataka checkbox -->
						<div class="flex items-center gap-1">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:        "bs_skraceni",
								Name:      "skraceni",
								LabelText: "AOP skracenog bilansa",
								Checked:   bilsData.Skraceni == 1,
								TabIndex:  "3",
							}, translator)
						</div>
					</div>
					<!-- Second Row: Grupa računa -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_grupa_racuna",
							LabelText:  translator.Label("Grupa računa, račun"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_grupa_racuna",
							Name:       "grac",
							FieldType:  "text",
							Value:      bilsData.Grac,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "50",
							TabIndex:   "4",
						})
					</div>
					<!-- Third Row: Naziv pozicije -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_naziv_pozicije",
							LabelText:  translator.Label("Naziv pozicije"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_naziv_pozicije",
							Name:       "nazp",
							FieldType:  "text",
							Value:      bilsData.NazP,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "160",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Fourth Row: Spisak konta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_spisak_konta",
							LabelText:  translator.Label("Spisak konta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_spisak_konta",
							Name:       "konta",
							FieldType:  "text",
							Value:      bilsData.Konta,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "90",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Input fields row 1 - Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_spisak_konta",
								LabelText:  translator.Label("Pozicije"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_01",
								Name:       "pozic_1",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic1),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "7",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_02",
								Name:       "pozic_2",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic2),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "8",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_03",
								Name:       "pozic_3",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic3),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_04",
								Name:       "pozic_4",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic4),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "10",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_05",
								Name:       "pozic_5",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic5),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "11",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_06",
								Name:       "pozic_6",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic6),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "12",
							})
						</div>
					</div>
					<!-- Input fields row 2 - Additional Pozicije controls -->
					<div class="flex gap-1 mb-1">
						<div class="flex gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "bs_pozicije",
								LabelText:  "",
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_07",
								Name:       "pozic_7",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic7),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "13",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_08",
								Name:       "pozic_8",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic8),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "14",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_09",
								Name:       "pozic_9",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic9),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "15",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_10",
								Name:       "pozic_10",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic10),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "16",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_11",
								Name:       "pozic_11",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic11),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "17",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "bs_input_12",
								Name:       "pozic_12",
								FieldType:  "number",
								Value:      fmt.Sprintf("%04d", bilsData.Pozic12),
								ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
								MaxLength:  "4",
								TabIndex:   "18",
							})
						</div>
					</div>
					<!-- Nivo podataka checkbox -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bs_nivo_podataka",
							LabelText:  translator.Label("Nivo podataka"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bs_nivo_podataka",
							Name:       "nipo",
							FieldType:  "number",
							Value:      fmt.Sprintf("%d", bilsData.NiPo),
							ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
							MaxLength:  "2",
							TabIndex:   "18",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
				</div>
				<!-- Buttons - Bottom Right Aligned -->
				<div class="flex gap-1 justify-end">
					@components.SaveButton(btnSave, translator)
					@components.CancelButton(btnCancel, translator)
				</div>
			</form>
			<!-- Message Display Area at Bottom -->
			<div id={ dialog.Id + "-message" } class="hidden"></div>
		</div>
	</div>
	@tmpl.HandleFormResponseScript()
}

// Tab 5 - Stampanje bilansa uspeha (Print Income Statement)
templ StampanjeBilansaUspeha(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint, btnExportXML domain.Button, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Bilansi"), tabs, "#tab-content", "bilansi-panel", translator)
		</div>
		<!-- Tab 5 Content -->
		<div id="tab5" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Control Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-4">
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "skraceni",
						Name:      "skraceni",
						Value:     "false",
						LabelText: translator.Label("Skraćeni bilans"),
						Checked:   false,
						TabIndex:  "1",
					}, translator)
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:        "pocstanjepg",
						Name:      "pocstanjepg",
						Value:     "false",
						LabelText: translator.Label("Preuzmi početno stanje iz prosle godine"),
						Checked:   false,
						TabIndex:  "2",
					}, translator)
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddatuma",
						LabelText:  translator.Label("Od datuma"),
						ClassLabel: common.ClassLabel,
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddatuma",
						Name:       "oddatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "3",
					})
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodatuma",
						LabelText:  translator.Label("Do datuma"),
						ClassLabel: common.ClassLabel,
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodatuma",
						Name:       "dodatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "4",
					})
					<div class="flex-1"></div>
					<div class="flex items-center gap-1">
						@components.FormObradaButton(btnObrada, translator)
						@components.Search_PartPrintButton(btnPrint)
						@components.Button(btnExportXML)
					</div>
				</div>
			</div>
			<!-- Data Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<div id="bilu-print-area" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.LoadingSpinner()
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessageScript()
	@components.SpinnerScript()
}
