package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

// EPP Main - Evidencija prethodnog poreza (Evidence of Previous Tax Credit)
templ EppMain(tabs domain.TabData, tblSekcije domain.TableData, btnNew, btnDelete domain.Button, searchInput domain.InputControl, gnGod int, translator *i18n.Service) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@EppSekcijeIzvori(tabs, tblSekcije, btnNew, btnDelete, searchInput, gnGod, translator)
	</div>
}

// Tab 1 - Sekcije i izvori
templ EppSekcijeIzvori(tabs domain.TabData, tbl domain.TableData, btnNew, btnDelete domain.Button, searchInput domain.InputControl, gnGod int, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("title.evidencija_prethodnog_poreza"), tabs, "#tab-content", "epp-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center gap-1">
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "oddatuma",
						LabelText:  translator.Label("label.od_datuma"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "oddatuma",
						Name:       "oddatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32 mr-2",
						TabIndex:   "1",
					})
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "dodatuma",
						LabelText:  translator.Label("label.do_datuma"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "dodatuma",
						Name:       "dodatuma",
						FieldType:  "date",
						Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "2",
					})
					<div class="flex-1"></div>
					@tmpl.FormObradaButton(btnNew, translator)
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="epp-sekcije-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessageScript()
}

