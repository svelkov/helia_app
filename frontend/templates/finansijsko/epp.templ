// Dialog for EPP entry - Sekcije i izvori
templ DialogEppSekcije(btnSave, btnCancel domain.Button, translator *i18n.Service) {
	<!-- Dialog Container -->
	<div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
		<div class="bg-white rounded-lg shadow-xl max-w-5xl w-full mx-4 max-h-[90vh] overflow-y-auto">
			<!-- Header -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title("title.unos_epp_sekcije") }</h2>
				<button onclick="closeDialog()" class="text-white hover:text-gray-200 mr-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Form Content -->
			<div class="p-4 space-y-4">
				<!-- Section 1: Osnovni podaci -->
				<div class="pl-2 pb-2">
					<div class="font-bold text-sm text-gray-900 border-b-2 border-gray-400 pb-2">{ translator.Text("text.osnovni_podaci") }</div>
					<div class="space-y-2 pt-2">
						<!-- Row 1: Sekcija and Izvor -->
						<div class="flex items-center gap-2">
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "sekcija",
									LabelText:  translator.Label("label.sekcija"),
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "sekcija",
									Name:       "sekcija",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "1",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "izvor",
									LabelText:  translator.Label("label.izvor"),
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "izvor",
									Name:       "izvor",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "2",
								})
							</div>
						</div>
						<!-- Row 2: Osnovna stopa -->
						<div class="flex items-center gap-2">
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "osnovna",
									LabelText:  translator.Label("label.osnovna_stopa"),
									ClassLabel: "w-32",
								})
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:            "osnovna",
									Name:          "osnovna",
									Value:         "0.00",
									ClassInput:    common.ClassInputTextEnabled + " w-32 text-right",
									DecimalPlaces: 2,
									TabIndex:      "3",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "posebna",
									LabelText:  translator.Label("label.posebna_stopa"),
									ClassLabel: "w-32",
								})
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:            "posebna",
									Name:          "posebna",
									Value:         "0.00",
									ClassInput:    common.ClassInputTextEnabled + " w-32 text-right",
									DecimalPlaces: 2,
									TabIndex:      "4",
								})
							</div>
						</div>
					</div>
				</div>
				<!-- Section 2: Aktivni računi -->
				<div class="pl-2 pb-2">
					<div class="font-bold text-sm text-gray-900 border-b-2 border-gray-400 pb-2">{ translator.Text("text.aktivni_racuni") }</div>
					<div class="space-y-2 pt-2">
						<!-- Row 1: Aktivni račun 1, 2, 3, 4 -->
						<div class="flex items-center gap-2">
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "akt1",
									LabelText:  translator.Label("label.aktivni_racun") + " 1",
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "akt1",
									Name:       "akt1",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "5",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "akt2",
									LabelText:  translator.Label("label.aktivni_racun") + " 2",
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "akt2",
									Name:       "akt2",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "6",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "akt3",
									LabelText:  translator.Label("label.aktivni_racun") + " 3",
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "akt3",
									Name:       "akt3",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "7",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "akt4",
									LabelText:  translator.Label("label.aktivni_racun") + " 4",
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "akt4",
									Name:       "akt4",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "8",
								})
							</div>
						</div>
						<!-- Row 2: KPR početna, KPR početna PDV dodatna, KPR početna PDV-->
						<div class="flex items-center gap-2">
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "kprpoc",
									LabelText:  translator.Label("label.kpr_pocetna"),
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "kprpoc",
									Name:       "kprpoc",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "9",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "krpdodatnap",
									LabelText:  translator.Label("label.kpr_dodatna_pdv"),
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "krpdodatnap",
									Name:       "krpdodatnap",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "10",
								})
							</div>
							<div class="flex items-center gap-2 flex-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "kprpdv",
									LabelText:  translator.Label("label.kpr_pdv_racun"),
									ClassLabel: "w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "kprpdv",
									Name:       "kprpdv",
									FieldType:  "text",
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "11",
								})
							</div>
						</div>
					</div>
				</div>
				<!-- Action Buttons -->
				<div class="flex justify-end gap-2 pt-4 border-t border-gray-300">
					@tmpl.SaveButton(btnSave, translator)
					@tmpl.CancelButton(btnCancel, translator)
				</div>
			</div>
		</div>
	</div>
}
