package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

templ IzvodiMain(tabs domain.TabData, tblMaster domain.TableData, tblDetail domain.TableData, btnImport, btnAzurKonta, btnBrisi domain.Button, bankValues []domain.ComboItem, gnGod int, translator *i18n.Service, csrfToken string) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@UcitavanjeIzvoda(tabs, tblMaster, tblDetail, btnImport, btnAzurKonta, btnBrisi, bankValues, gnGod, translator, csrfToken)
	</div>
}

// Tab 1 - Učitavanje izvoda
templ UcitavanjeIzvoda(tabs domain.TabData, tblMaster domain.TableData, tblDetail domain.TableData, btnImport, btnAzurKonta, btnBrisi domain.Button, bankValues []domain.ComboItem, gnGod int, translator *i18n.Service, csrfToken string) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Učitavanje i knjiženje izvoda"), tabs, "#tab-content", "izvodi-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<!-- Parameters Section -->
			<form
				id="import-form"
				hx-post={ btnImport.HxActionURL }
				hx-target={ btnImport.HxTarget }
				hx-swap="innerHTML"
				hx-request-headers='{"X-Request-Source": "btnimport"}'
				hx-encoding="multipart/form-data"
				hx-vals={ btnImport.HxVals }
			>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<!-- Hidden file input to store the actual file -->
				<input type="hidden" id="file-input-data" name="file"/>
				<input type="hidden" id="file-type-data" name="file_type"/>
				<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
					<div class="grid grid-cols-3 gap-1">
						<!-- Left part - 2/3 -->
						<div class="col-span-2">
							<div class="mb-1">
								<label class="text-sm font-medium text-gray-700 mb-1 block">Software</label>
								<div class="flex flex-wrap gap-1">
									<label class="flex items-center">
										<input type="radio" name="software" value="halcom" checked class="mr-1"/>
										<span class="text-sm">Halcom</span>
									</label>
									<label class="flex items-center">
										<input type="radio" name="software" value="office_banking" class="mr-1"/>
										<span class="text-sm">Office Banking (XML)</span>
									</label>
									<label class="flex items-center">
										<input type="radio" name="software" value="raiffeisen" class="mr-1"/>
										<span class="text-sm">Raiffeisen (XML)</span>
									</label>
									<label class="flex items-center">
										<input type="radio" name="software" value="societe" class="mr-1"/>
										<span class="text-sm">Societe Generale (XML)</span>
									</label>
									<label class="flex items-center">
										<input type="radio" name="software" value="otp" class="mr-1"/>
										<span class="text-sm">OTP banka (XML)</span>
									</label>
									<label class="flex items-center">
										<input type="radio" name="software" value="trezor" class="mr-1"/>
										<span class="text-sm">Trezor (XML)</span>
									</label>
								</div>
							</div>
							<div class="flex items-center gap-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "filepath",
									LabelText:  translator.Label("Putanja do .csv, .xlsx, .xml dokumenta"),
									ClassLabel: common.ClassLabel + " w-64",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "filepath",
									Name:       "filepath",
									FieldType:  "text",
									Disabled:   false,
									ClassInput: common.ClassInputTextEnabled + " flex-1",
									TabIndex:   "1",
								})
								<button
									type="button"
									onclick="openFileDialog()"
									class={ common.ClassPrintButton }
								>
									@tmpl.Icon("file-select", common.ClassIcon)
									{ translator.Label("Izaberi fajl") }
								</button>
							</div>
						</div>
						<!-- Right part - 1/3 -->
						<div class="col-span-1 flex flex-col gap-1">
							<label class="flex items-center">
								<input type="checkbox" id="povezivanje_jmbg" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500 mr-2"/>
								<span class="text-sm text-gray-700">{ translator.Label("Povezivanje konta preko JMBG") }</span>
							</label>
							<label class="flex items-center">
								<input type="checkbox" id="azuriraj_konta" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500 mr-2"/>
								<span class="text-sm text-gray-700">{ translator.Label("Ažuriraj konta koja su već uneta u detalje izvoda") }</span>
							</label>
							<label class="flex items-center">
								<input type="checkbox" id="brisanje_prikaza" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500 mr-2"/>
								<span class="text-sm text-gray-700">{ translator.Label("Brisanje prikazanih dokumenata") }</span>
							</label>
							<div class="flex gap-1 mt-1 justify-end">
								@tmpl.Button(btnImport)
								@tmpl.Button(btnAzurKonta)
								@tmpl.Button(btnBrisi)
							</div>
						</div>
					</div>
				</div>
			</form>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden" style="flex: 0 0 40%;">
				<div id="izvodi-master-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblMaster, translator)
				</div>
			</div>
			<!-- Detail Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<h3 class="text-sm font-medium text-gray-700 mb-1">{ translator.Label("DETALJI IZVODA") }</h3>
				<div id="izvodi-detail-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetail, translator)
				</div>
			</div>
		</div>
	</div>
	@tmpl.ShowMessageScript()
	@tmpl.FileSelectScript()
}

// Tab 2 - Knjiženje izvoda
templ KnjizenjeIzvoda(tabs domain.TabData, tblMaster domain.TableData, tblDetail domain.TableData, btnObrada, btnRavnoteza, btnKnjizenje domain.Button, bankaValues, tipdokValues []domain.ComboItem, gnGod int, nextNalog string, translator *i18n.Service, csrfToken string) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Učitavanje i knjiženje izvoda"), tabs, "#tab-content", "izvodi-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div id="nalog-trigger" hx-get="/api/nalozi/nextnalog" hx-trigger="tipdokChanged" hx-vals='js:{"tipdok": document.getElementById("tipdok").value}' hx-on::after-request="handleNextNalogResponse('')" style="display:none;"></div>
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
				<div class="grid grid-cols-2 gap-3">
					<!-- Left part - 1/2 - Parametri za selekciju -->
					<div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "idbanke",
								LabelText:  translator.Label("Banka"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.ComboBoxField(domain.ComboFieldConfig{
								ID:           "idbanke",
								Name:         "idbanke",
								ClassSelect:  common.ClassSelect,
								OptionValues: bankaValues,
								TabIndex:     "1",
							}, translator)
						</div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "odbrojaizvoda",
								LabelText:  translator.Label("Od broja izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "odbrojaizvoda",
								Name:       "odbrojaizvoda",
								FieldType:  "text",
								Value:      "0",
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "2",
							})
							<div class="flex-1"></div>
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "oddatuma",
								LabelText:  translator.Label("Od datuma izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "oddatuma",
								Name:       "oddatuma",
								FieldType:  "date",
								Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "4",
							})
						</div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "dobrojaizvoda",
								LabelText:  translator.Label("Do broja izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dobrojaizvoda",
								Name:       "dobrojaizvoda",
								FieldType:  "text",
								Value:      "999999",
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "3",
							})
							<div class="flex-1"></div>
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "dodatuma",
								LabelText:  translator.Label("Do datuma izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dodatuma",
								Name:       "dodatuma",
								FieldType:  "date",
								Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "5",
							})
						</div>
						<div class="flex justify-end">
							@tmpl.Button(btnObrada)
						</div>
					</div>
					<!-- Right part - 1/2 - Parametri za knjiženje -->
					<div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.ComboBoxField(domain.ComboFieldConfig{
								ID:               "tipdok",
								Name:             "tipdok",
								ClassSelect:      common.ClassSelect + " flex-1",
								OptionValues:     tipdokValues,
								TabIndex:         "6",
								HxVals:           `js:{"tipdok": document.getElementById("tipdok").value}`,
								ChangeEndpoint:   "/api/nalozi/nextnalog",
								HxSwap:           "none",
								HxOnAfterRequest: "handleTipdokAfterRequest",
							}, translator)
						</div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "nalog",
								LabelText:  translator.Label("Broj naloga"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "nalog",
								Name:       "nalog",
								FieldType:  "text",
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								Value:      nextNalog,
								TabIndex:   "7",
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "datumnaloga",
								LabelText:  translator.Label("Datum naloga"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "datumnaloga",
								Name:       "datumnaloga",
								FieldType:  "date",
								Value:      time.Now().Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								TabIndex:   "8",
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "datumobrade",
								LabelText:  translator.Label("Datum obrade"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "datumobrade",
								Name:       "datumobrade",
								FieldType:  "date",
								Value:      time.Now().Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								TabIndex:   "9",
							})
						</div>
						<div class="flex items-center gap-1 mb-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "opisknjizenja",
								LabelText:  translator.Label("Opis knjiženja"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "opisknjizenja",
								Name:       "opisknjizenja",
								Value:      "Izvod",
								FieldType:  "text",
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								TabIndex:   "10",
							})
						</div>
						<div class="flex items-center justify-between">
							<label class="flex items-center">
								<input type="checkbox" id="jedan_izvod_nalog" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500 mr-2"/>
								<span class="text-sm text-gray-700">{ translator.Label("Jedan izvod jedan nalog") }</span>
							</label>
							<div class="flex gap-1">
								@tmpl.Button(btnRavnoteza)
								@tmpl.Button(btnKnjizenje)
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden" style="flex: 0 0 35%;">
				<div id="izvodi-master-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblMaster, translator)
				</div>
			</div>
			<!-- Detail Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<h3 class="text-sm font-medium text-gray-700 mb-1">{ translator.Label("DETALJI IZVODA") }</h3>
				<div id="izvodi-detail-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetail, translator)
				</div>
			</div>
		</div>
	</div>
	@tmpl.ShowMessageScript()
	@tmpl.HandleNextNalogResponseScript()
	@tmpl.HandleTipdokAfterRequestScript()
}

// Tab 3 - Pregled proknjiženih i neproknjiženih izvoda
templ PregledIzvoda(tabs domain.TabData, tblMaster domain.TableData, tblDetail domain.TableData, btnObrada domain.Button, bankaValues []domain.ComboItem, gnGod int, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Učitavanje i knjiženje izvoda"), tabs, "#tab-content", "izvodi-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg">
				<div class="grid grid-cols-2 gap-3">
					<!-- Left half: banka, radios, checkbox -->
					<div class="flex flex-col gap-2">
						<div class="flex items-center">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "idbanke",
								LabelText:  translator.Label("Banka"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@tmpl.ComboBoxField(domain.ComboFieldConfig{
								ID:           "idbanke",
								Name:         "idbanke",
								ClassSelect:  common.ClassSelect,
								OptionValues: bankaValues,
								TabIndex:     "1",
							}, translator)
						</div>
						<div class="flex items-center gap-2 pl-28">
							@tmpl.RadioButtonField(domain.RadioFieldConfig{
								ID:          "status_proknjizeni",
								Name:        "status",
								LabelText:   "Proknjiženi",
								Value:       "40",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  true,
							}, translator)
							@tmpl.RadioButtonField(domain.RadioFieldConfig{
								ID:          "status_neproknjizeni",
								Name:        "status",
								LabelText:   "Neproknjiženi",
								Value:       "1",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
							}, translator)
						</div>
						<div class="flex items-center pl-28">
							@tmpl.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "oznaci_neporknjizene",
								Name:              "oznaci_neproknjizene",
								LabelText:         "Označi prikazane izvode kao neproknjižene",
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan,
							}, translator)
						</div>
					</div>
					<!-- Right half: ranges and obrada -->
					<div class="flex flex-col gap-1">
						<div class="flex items-center gap-1 flex-wrap justify-between">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "odbrojaizvoda",
								LabelText:  translator.Label("Od broja izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "odbrojaizvoda",
								Name:       "odbrojaizvoda",
								FieldType:  "text",
								Value:      "0",
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "2",
							})
							<div class="flex items-center gap-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "oddatuma",
									LabelText:  translator.Label("Od datuma izvoda"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "oddatuma",
									Name:       "oddatuma",
									FieldType:  "date",
									Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
									ClassInput: common.ClassInputTextEnabled + " w-32",
									TabIndex:   "3",
								})
							</div>
						</div>
						<div class="flex items-center gap-1 flex-wrap justify-between">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "dobrojaizvoda",
								LabelText:  translator.Label("Do broja izvoda"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dobrojaizvoda",
								Name:       "dobrojaizvoda",
								FieldType:  "text",
								Value:      "999999",
								ClassInput: common.ClassInputTextEnabled + " w-28",
								TabIndex:   "4",
							})
							<div class="flex items-center gap-1">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "dodatuma",
									LabelText:  translator.Label("Do datuma izvoda"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@tmpl.TextInputField(domain.InputFieldConfig{
									ID:         "dodatuma",
									Name:       "dodatuma",
									FieldType:  "date",
									Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
									ClassInput: common.ClassInputTextEnabled + " w-32",
									TabIndex:   "5",
								})
							</div>
						</div>
						<!-- Note row -->
						<div class="mt-1 flex items-start">
							<div class="flex items-start">
								<p class="text-sm text-red-600 font-medium">
									{ translator.Label("Napomena izvodi") }
								</p>
							</div>
							<div class="ml-auto flex items-end justify-end">
								@tmpl.FormObradaButton(btnObrada, translator)
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden" style="flex: 0 0 40%;">
				<div id="izvodi-master-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblMaster, translator)
				</div>
			</div>
			<!-- Detail Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<h3 class="text-sm font-medium text-gray-700 mb-1">{ translator.Label("DETALJI IZVODA") }</h3>
				<div id="izvodi-detail-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetail, translator)
				</div>
			</div>
		</div>
	</div>
	@tmpl.ShowMessageScript()
}
