package finansijsko

import (
	"helia/config"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
	"helia/frontend/components"
)

// Main Kompenzacije content with tabs
templ KompenzacijeContent(tabs domain.TabData, tbl domain.TableData, searchControl domain.InputControl, btnObrada, btnPrint domain.Button, translator *i18n.Service, csrfToken string) {
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@tmpl.TabNav(translator.Title("Kompenzacije"), tabs, "#tab-content", "kompenzacije-panel", translator)
		<div id="kompenzacije-tab-content" class="flex-1 min-h-0">
			@KompenzacijePregledPartnera(tabs, tbl, searchControl, btnObrada, btnPrint, translator, csrfToken)
		</div>
	</div>
}

// Tab 1: Pregled partnera za kompenzacije
templ KompenzacijePregledPartnera(tabs domain.TabData, tbl domain.TableData, searchControl domain.InputControl, btnObrada, btnPrint domain.Button, translator *i18n.Service, csrfToken string) {
	<!-- Container with full height -->
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kompenzacije"), tabs, "#tab-content", "kompenzacije-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1 pt-1">
			<!-- Action buttons -->
			<div class="flex gap-1 p-1 justify-end">
				@components.FormObradaButton(btnObrada, translator)
			</div>
			<div class="border bg-blue-100 p-1 border border-blue-400 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchControl)
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	@components.SpinnerScript()
}

// Tab 2: Formiranje kompenzacije
templ KompenzacijeFormiranje(tabs domain.TabData, duznikData, poverilacData domain.TableData, btnObrada, btnFormKomp domain.Button, translator *i18n.Service, csrfToken string, gnGod int, kontaConfig config.KontaConfig) {
	<!-- Container with full height -->
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kompenzacije"), tabs, "#tab-content", "kompenzacije-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab2" class="flex flex-col h-full overflow-hidden">
			<!-- Main Grid - Three columns -->
			<!-- <form id="kompenzacije-form" method="post" hx-post="/api/kompenzacije/formiranje" hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }> -->
			<div class="grid grid-cols-3 gap-1 flex-shrink-0">
				<!-- Column 1: Dužnik -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Dužnik") }
					</div>
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto_duznika",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto_duznika",
							Name:         "konto_duznika",
							Disabled:     false,
							FieldType:    "number",
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontoduznikanaziv",
							HxVals:       `js:{"konto": document.getElementById('konto_duznika').value, "vkonta": "2"}`,
							HxInclude:    "this",
							MinLength:    "4",
							MaxLength:    "6",
							TabIndex:     "1",
							Value:        kontaConfig.KontoKupca,
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError"})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btnkonto_duznika",
							Name:        "search-konto-duznika",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kontoduznikanaziv",
							Name:       "kontoduznikanaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Sifra Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sifra_duznika",
							LabelText:  translator.Label("Šifra"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "sifra_duznika",
							Name:         "sifra_duznika",
							Disabled:     false,
							FieldType:    "number",
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifra_duznika_naziv",
							HxVals:       `js:{"konto": document.getElementById('konto_duznika').value, "sifra":document.getElementById('sifra_duznika').value,  "vkonta": "1"}`,
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "3",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btnsifra_duznika",
							Name:        "search-sifra-duznika",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto_duznika').value, "sifra":document.getElementById('sifra_duznika').value,  "vkonta": "1"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "sifra_duznika_naziv",
							Name:       "sifra_duznika_naziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Column 2: Poverilac -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Poverilac") }
					</div>
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto_poverioca",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto_poverioca",
							Name:         "konto_poverioca",
							Disabled:     false,
							FieldType:    "number",
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "konto_poverioca_naziv",
							HxVals:       `js:{"konto": document.getElementById('konto_poverioca').value, "vkonta": "2"}`,
							HxInclude:    "this",
							MinLength:    "4",
							MaxLength:    "6",
							TabIndex:     "1",
							Value:        kontaConfig.KontoDobavljaca,
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError"})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btnkonto_poverioca",
							Name:        "search-konto_poverioca",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto_poverioca').value, "sifra":document.getElementById('sifra_poverioca').value,  "vkonta": "2"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "konto_poverioca_naziv",
							Name:       "konto_poverioca_naziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Sifra Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sifra_poverioca",
							LabelText:  translator.Label("Šifra"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "sifra_poverioca",
							Name:         "sifra_poverioca",
							Disabled:     false,
							FieldType:    "number",
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifra_poverioca_naziv",
							HxVals:       `js:{"konto": document.getElementById('konto_poverioca').value, "sifra":document.getElementById('sifra_poverioca').value,  "vkonta": "1"}`,
							Value:        "",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "3",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btnsifra_poverioca",
							Name:        "search-sifra_poverioca",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto_poverioca').value, "sifra":document.getElementById('sifra_poverioca').value,  "vkonta": "1"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "sifra_poverioca_naziv",
							Name:       "sifra_poverioca_naziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Column 3: Parameters -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Parametri") }
					</div>
					<!-- Hidden CSRF token -->
					<input type="hidden" id="_csrf" name="_csrf" value={ csrfToken }/>
					<!-- Stanje na dan + Checkbox -->
					<div class="flex items-center gap-2 mb-1">
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "stanje_na_dan",
								LabelText:  translator.Label("Stanje na dan"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "stanje_na_dan",
								Name:       "stanje_na_dan",
								FieldType:  "date",
								Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "7",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
							})
						</div>
						<div class="flex items-center gap-1">
							<input id="check_dospele" type="checkbox" class="h-4 w-4 rounded border-blue-400 text-blue-600 focus:ring-blue-500"/>
							<label for="check_dospele" class="text-xs text-gray-700">{ translator.Label("Dospeli računi") }</label>
						</div>
					</div>
					<!-- Datum kompenzacije -->
					<div class="flex items-center gap-1 mb-2">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datum_kompenzacije",
							LabelText:  translator.Label("Datum kompenzacije"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datum_kompenzacije",
							Name:       "datum_kompenzacije",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "8",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Action buttons -->
					<div class="flex justify-end gap-1 ml-auto">
						@components.FormObradaButton(btnObrada, translator)
						<button
							id="btnFormKomp"
							type="button"
							data-csrf-token={ csrfToken }
							onclick="handleFormKompClick(event)"
							class="px-3 py-1 bg-green-600 hover:bg-green-700 text-white text-xs rounded transition"
						>
							{ translator.Label(btnFormKomp.LabelText) }
						</button>
					</div>
				</div>
			</div>
			<!-- Warning message -->
			<textarea readonly rows="2" class="w-full bg-red-50 border border-red-300 p-1 mb-1 rounded text-xs text-red-700 resize-none">{ translator.Message("napomena_kompenzacije") }</textarea>
			<!-- Details section -->
			<div id="kompenzacije-detalji" class="flex-1 min-h-0">
				@KompenzacijeFormirajDetalji(duznikData, poverilacData, translator)
			</div>
			<!-- </form> -->
		</div>
	</div>
	<!-- Global search dropdown for all search buttons -->
	<div id="search-dropdown" class="hidden fixed bg-white border border-gray-300 rounded-lg shadow-xl z-[9999] max-w-2xl min-w-[400px] max-h-[500px] overflow-auto"></div>
	@tmpl.SearchPopupScript()
	@tmpl.ShowMessageScript()
	@components.SpinnerScript()
	@tmpl.ClearFieldErrorScript()
	<script>
	console.log("KompenzacijeFormiranje script loaded");
	
	function handleFormKompClick(event) {
		console.log("Button clicked!");
		event.preventDefault();
		
		const duznikTable = document.getElementById('duznik-table');
		const poverilacTable = document.getElementById('poverilac-table');
		
		const duznikRows = [];
		const poverilacRows = [];
		
		// Collect duznik table data
		if (duznikTable) {
			const rows = duznikTable.querySelectorAll('tbody tr');
			rows.forEach(row => {
				const cells = row.querySelectorAll('td');
				const rowData = {};
				cells.forEach((cell, index) => {
					rowData[`col_${index}`] = cell.textContent.trim();
				});
				duznikRows.push(rowData);
			});
		}
		
		// Collect poverilac table data
		if (poverilacTable) {
			const rows = poverilacTable.querySelectorAll('tbody tr');
			rows.forEach(row => {
				const cells = row.querySelectorAll('td');
				const rowData = {};
				cells.forEach((cell, index) => {
					rowData[`col_${index}`] = cell.textContent.trim();
				});
				poverilacRows.push(rowData);
			});
		}
		
		// Build payload
		const payload = {
			konto_duznika: document.getElementById('konto_duznika').value,
			sifra_duznika: document.getElementById('sifra_duznika').value,
			konto_poverioca: document.getElementById('konto_poverioca').value,
			sifra_poverioca: document.getElementById('sifra_poverioca').value,
			stanje_na_dan: document.getElementById('stanje_na_dan').value,
			datum_kompenzacije: document.getElementById('datum_kompenzacije').value,
			check_dospele: document.getElementById('check_dospele').checked,
			duznik_rows: duznikRows,
			poverilac_rows: poverilacRows
		};
		
		console.log("Payload prepared:", payload);
		
		// Get CSRF token from button data attribute
		const button = document.getElementById('btnFormKomp');
		const csrfToken = button.getAttribute('data-csrf-token');
		
		console.log("CSRF Token:", csrfToken);
		
		const headers = {
			'Content-Type': 'application/json',
			'X-CSRF-Token': csrfToken || ''
		};
		console.log("Request headers:", headers);
		
		// Make fetch request with JSON body
		fetch('/api/kompenzacije/formiranje/formiraj', {
			method: 'POST',
			headers: headers,
			body: JSON.stringify(payload)
		})
		.then(response => {
			console.log("Response status:", response.status);
			if (!response.ok) {
				throw new Error(`HTTP error! status: ${response.status}`);
			}
			return response.text();
		})
		.then(html => {
			console.log("Response received, updating DOM");
			const targetEl = document.getElementById('kompenzacije-detalji');
			if (targetEl) {
				targetEl.innerHTML = html;
			}
		})
		.catch(error => {
			console.error('Error:', error);
			alert('Error: ' + error.message);
		});
	}
	</script>
}

templ KompenzacijeFormirajDetalji(duznikData, poverilacData domain.TableData, translator *i18n.Service) {
	<!-- Two tables side by side - fills parent container -->
	<div class="grid grid-cols-2 gap-1 h-full min-h-0">
		<!-- Left table: Dužničke obaveze -->
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden">
			@components.LoadingSpinner()
			@components.Search_Part(duznikData, domain.InputControl{})
			<!-- Table -->
			<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				<div id="duznik-table">
					@components.Table(duznikData, translator)
				</div>
			</div>
		</div>
		<!-- Right table: Poverilačke obaveze -->
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden">
			@components.LoadingSpinner()
			@components.Search_Part(poverilacData, domain.InputControl{})
			<!-- Table -->
			<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				<div id="poverilac-table">
					@components.Table(poverilacData, translator)
				</div>
			</div>
		</div>
	</div>
}

// Tab 3: Pregled kompenzacija
templ KompenzacijePregled(tabs domain.TabData, tbl domain.TableData, dokumentaData domain.TableData, searchControl domain.InputControl, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	<!-- Container with full height -->
	<div id="tab-content" class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kompenzacije"), tabs, "#tab-content", "kompenzacije-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab3" class="flex flex-col h-full">
			<!-- Filter section -->
			<div class="bg-blue-100 border border-blue-400 mt-1 p-2 rounded-lg">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-4">
						<span class="text-sm font-semibold">{ translator.Label("KOMPENZACIJE - Prikaz dokumenata") }</span>
						<div class="flex gap-3">
							<label class="flex items-center gap-1">
								<input type="radio" name="status-filter" value="nepotvrdjen" class="form-radio text-blue-600"/>
								<span class="text-sm">{ translator.Label("Nepotvrdjeni") }</span>
							</label>
							<label class="flex items-center gap-1">
								<input type="radio" name="status-filter" value="potvrđen" class="form-radio text-blue-600"/>
								<span class="text-sm">{ translator.Label("Potvrdjeni") }</span>
							</label>
							<label class="flex items-center gap-1">
								<input type="radio" name="status-filter" value="proknjizen" class="form-radio text-blue-600"/>
								<span class="text-sm">{ translator.Label("Proknjiženi") }</span>
							</label>
							<label class="flex items-center gap-1">
								<input type="radio" name="status-filter" value="svi" class="form-radio text-blue-600" checked/>
								<span class="text-sm">{ translator.Label("Svi") }</span>
							</label>
						</div>
					</div>
					<div class="flex gap-1">
						@components.FormObradaButton(btnObrada, translator)
						@components.PrintButton(btnPrint, translator)
					</div>
				</div>
			</div>
			<!-- Two tables split 50/50 vertically -->
			<div class="grid grid-rows-2 gap-1 flex-1 min-h-0 overflow-hidden mt-1 relative">
				<!-- Overlay spinner -->
				<div id="loading-spinner" class="hidden absolute inset-0 flex items-center justify-center bg-black bg-opacity-30 rounded-lg z-50">
					<div class="flex flex-col items-center justify-center gap-3">
						<div class="relative h-16 w-16">
							<!-- Outer ring -->
							<div class="absolute inset-0 rounded-full border-4 border-transparent border-t-blue-600 border-r-blue-400 animate-spin" style="animation-duration: 1.5s"></div>
							<!-- Inner ring -->
							<div class="absolute inset-2 rounded-full border-4 border-transparent border-b-blue-600 border-l-blue-400 animate-spin" style="animation-duration: 1s; animation-direction: reverse"></div>
						</div>
						<div class="text-white text-sm font-medium">loading...</div>
					</div>
				</div>
				<!-- Main kompenzacije table -->
				<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
					@components.Search_Part(tbl, searchControl)
					<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
						@components.Table(tbl, translator)
					</div>
				</div>
				<!-- Documents in kompenzacija table -->
				<div class="border bg-blue-100 border-blue-400 rounded-lg p-1 flex flex-col min-h-0">
					<h4 class="text-sm font-semibold text-blue-700 mb-1">{ translator.Title("DOKUMENTA SADRŽANA U KOMPENZACIJI") }</h4>
					<div class="flex-1 overflow-auto">
						@components.Table(dokumentaData, translator)
					</div>
				</div>
			</div>
		</div>
	</div>
	@components.SpinnerScript()
}

// Tab 4: Knjiženje kompenzacija
templ KompenzacijeKnjizenje(tabs domain.TabData, tbl domain.TableData, dokumentaData domain.TableData, tipdokValues []domain.ComboItem, btnPrikazi, btnRavnoteza, btnKnjizi domain.Button, translator *i18n.Service, csrfToken string) {
	<!-- Container with full height -->
	<div id="tab-content" class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kompenzacije"), tabs, "#tab-content", "kompenzacije-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab4" class="flex flex-col h-full">
			<!-- Main Grid - Two columns (1/3 vs 2/3) -->
			<div class="grid grid-cols-3 gap-1">
				<!-- Column 1: Date and Number Range -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Period") }
					</div>
					<!-- Od datuma Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "od-datuma-kompenz",
							LabelText:  translator.Label("Od datuma kompenzacije"),
							ClassLabel: common.ClassLabel + " w-48",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "od-datuma-kompenz",
							Name:       "od-datuma-kompenz",
							FieldType:  "date",
							Value:      "2025-12-26",
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "1",
						})
					</div>
					<!-- Do datuma Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "do-datuma-kompenz",
							LabelText:  translator.Label("Do datuma kompenzacije"),
							ClassLabel: common.ClassLabel + " w-48",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "do-datuma-kompenz",
							Name:       "do-datuma-kompenz",
							FieldType:  "date",
							Value:      "2026-01-09",
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2",
						})
					</div>
					<!-- Od broja Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "od-broja-komp",
							LabelText:  translator.Label("Od broja kompenzacije"),
							ClassLabel: common.ClassLabel + " w-48",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "od-broja-komp",
							Name:       "od-broja-komp",
							FieldType:  "number",
							Value:      "1",
							ClassInput: common.ClassInputTextEnabled + " w-24",
							TabIndex:   "3",
						})
					</div>
					<!-- Do broja Field -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "do-broja-komp",
							LabelText:  translator.Label("Do broja kompenzacije"),
							ClassLabel: common.ClassLabel + " w-48",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "do-broja-komp",
							Name:       "do-broja-komp",
							FieldType:  "number",
							Value:      "999999",
							ClassInput: common.ClassInputTextEnabled + " w-24",
							TabIndex:   "4",
						})
					</div>
				</div>
				<!-- Column 2: Parameters -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col col-span-2">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Parametri") }
					</div>
					<!-- Vrsta naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "tipdok-knjizenje",
							LabelText:  translator.Label("Vrsta naloga za knjiženje"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "tipdok-knjizenje",
							Name:         "tipdok-knjizenje",
							ClassSelect:  common.ClassSelect + " flex-1",
							OptionValues: tipdokValues,
							TabIndex:     "5",
						}, translator)
					</div>
					<!-- Opis knjizenja -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis-knjizenja",
							LabelText:  translator.Label("Opis knjiženja"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis-knjizenja",
							Name:       "opis-knjizenja",
							FieldType:  "text",
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							TabIndex:   "6",
						})
					</div>
					<!-- Broj naloga, Datum naloga, Datum obrade in one row -->
					<div class="flex items-center gap-2 mb-2">
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "broj-naloga",
								LabelText:  translator.Label("Broj naloga"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "broj-naloga",
								Name:       "broj-naloga",
								FieldType:  "text",
								ClassInput: common.ClassInputTextEnabled + " w-20",
								TabIndex:   "7",
							})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datum-naloga",
								LabelText:  translator.Label("Datum naloga"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datum-naloga",
								Name:       "datum-naloga",
								FieldType:  "date",
								Value:      "2026-01-16",
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "8",
							})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datum-obrade",
								LabelText:  translator.Label("Datum obrade"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datum-obrade",
								Name:       "datum-obrade",
								FieldType:  "date",
								Value:      "2026-01-16",
								ClassInput: common.ClassInputTextEnabled,
								TabIndex:   "9",
							})
						</div>
					</div>
					<!-- Action buttons -->
					<div class="flex justify-end gap-1">
						@components.FormObradaButton(btnPrikazi, translator)
						@components.AddButton(btnRavnoteza, translator)
						@components.SaveButton(btnKnjizi, translator)
					</div>
				</div>
			</div>
			<!-- Two tables stacked vertically -->
			<div class="grid grid-rows-2 gap-1 flex-1 min-h-0 overflow-hidden">
				<!-- Main kompenzacije table -->
				<div class="border bg-blue-100 border-blue-400 rounded-lg p-1 flex flex-col min-h-0">
					<h4 class="text-xs font-semibold text-blue-700 mb-1">{ translator.Title("KOMPENZACIJE") }</h4>
					<div class="flex-1 overflow-auto">
						@components.Table(tbl, translator)
					</div>
				</div>
				<!-- Documents in kompenzacija table -->
				<div class="border bg-blue-100 border-blue-400 rounded-lg p-1 flex flex-col min-h-0">
					<h4 class="text-xs font-semibold text-blue-700 mb-1">{ translator.Title("DOKUMENTA SADRŽANA U KOMPENZACIJI") }</h4>
					<div class="flex-1 overflow-auto">
						@components.Table(dokumentaData, translator)
					</div>
				</div>
			</div>
		</div>
	</div>
}
