templ NaloziKopiranjeDialog(model domain.KopirajNalog, btnSave domain.Button, translator *i18n.Service, csrfToken string) {
	<input type="hidden" name="_csrf" value={ csrfToken }/>
	<div class="text-blue-800 font-bold text-sm mb-1">
		{ translator.Text("Podaci o nalogu iz kojeg se kopira") }
	</div>
	<div class="box-content flex flex-col p-2 border-2 border-gray-300 rounded-md">
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "vrstanalogaold",
				LabelText:  translator.Label("Vrsta naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "vrstanalogaold",
				Name:       "vrstanalogaold",
				Value:      model.TipdokOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled + " w-full",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "brojnalogaold",
				LabelText:  translator.Label("Broj naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "brojnalogaold",
				Name:       "brojnalogaold",
				Value:      model.NalogOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled + " w-42",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datumknjold",
				LabelText:  translator.Label("Datum naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datumknjold",
				Name:       "datumnknjold",
				Value:      model.DatKnjOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled,
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datumobradeold",
				LabelText:  translator.Label("Datum Obrade"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datumobradeold",
				Name:       "datumobradeold",
				Value:      model.DanalOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled,
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "opisknjizenjaold",
				LabelText:  translator.Label("Opis knjizenja"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "opisknjizenjaold",
				Name:       "opisknjizenjaold",
				Value:      model.OpisOld,
				Disabled:   true,
				FieldType:  "text",
				ClassInput: common.ClassInputTextDisabled + " w-full",
			})
		</div>
	</div>
	<!-- Full-width Description Section -->
	<div class="text-blue-800 font-bold text-sm mb-1">
		{ translator.Text("Podaci o novom nalogu") }
	</div>
	<div class="box-content flex flex-col p-2 border-2 border-gray-300 rounded-md">
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "tipdok",
				LabelText:  translator.Label("Vrsta Naloga"),
				ClassLabel: common.ClassLabel + " w-24 ",
			})
			@tmpl.ComboBoxField(domain.ComboFieldConfig{
				ID:             "tipdok",
				Name:           "tipdok",
				Placeholder:    translator.Placeholder("Select"),
				Disabled:       false,
				ClassSelect:    common.ClassSelect + " w-full ",
				HxSwap:         "innerHTML",
				HxChangeTarget: "vrstanaloganew",
				HxVals:         `js:{"tipdok": document.getElementById("tipdok").value}`,
				OptionValues:   model.TipdokValues,
			}, translator)
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "nalog",
				LabelText:  translator.Label("Broj naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:               "nalog",
				Name:             "nalog",
				Value:            model.NalogNew,
				FieldType:        "text",
				Disabled:         false,
				ClassInput:       common.ClassInputTextEnabled,
				HxGet:            "/api/nalozi/nextnalog",
				HxTrigger:        "change from:select[name='tipdok']",
				HxInclude:        "select[name='tipdok']",
				HxOnAfterRequest: "handleNextNalogResponse",
				OnInput:          "clearFieldError",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "danal",
				LabelText:  translator.Label("Datum naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "danal",
				Name:       "danal",
				Value:      model.DanalNew,
				FieldType:  "date",
				Disabled:   false,
				ClassInput: common.ClassInputTextEnabled + " w-full",
				OnInput:    "clearFieldError",
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datob",
				LabelText:  translator.Label("Datum Obrade"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datob",
				Name:       "datob",
				Value:      model.DatknjNew,
				FieldType:  "date",
				Disabled:   false,
				ClassInput: common.ClassInputTextDisabled + " w-full",
				OnInput:    "clearFieldError",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "opis",
				LabelText:  translator.Label("Opis knjizenja"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "opis",
				Name:       "opis",
				Value:      model.OpisNew,
				FieldType:  "text",
				Disabled:   false,
				ClassInput: common.ClassInputTextEnabled + " w-full",
			})
		</div>
	</div>
}

templ NaloziStorniranjeDialog(model domain.KopirajNalog, btnSave domain.Button, translator *i18n.Service, csrfToken string) {
	<input type="hidden" name="_csrf" value={ csrfToken }/>
	<div class="text-blue-800 font-bold text-sm mb-1">
		{ translator.Text("Podaci o nalogu koji se stornira") }
	</div>
	<div class="box-content flex flex-col p-2 border-2 border-gray-300 rounded-md">
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "vrstanalogaold",
				LabelText:  translator.Label("Vrsta naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "vrstanalogaold",
				Name:       "vrstanalogaold",
				Value:      model.TipdokOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled + " w-full",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "brojnalogaold",
				LabelText:  translator.Label("Broj naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "brojnalogaold",
				Name:       "brojnalogaold",
				Value:      model.NalogOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled + " w-42",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datumknjold",
				LabelText:  translator.Label("Datum naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datumknjold",
				Name:       "datumnknjold",
				Value:      model.DatKnjOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled,
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datumobradeold",
				LabelText:  translator.Label("Datum Obrade"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datumobradeold",
				Name:       "datumobradeold",
				Value:      model.DanalOld,
				FieldType:  "text",
				Disabled:   true,
				ClassInput: common.ClassInputTextDisabled,
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "opisknjizenjaold",
				LabelText:  translator.Label("Opis knjizenja"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "opisknjizenjaold",
				Name:       "opisknjizenjaold",
				Value:      model.OpisOld,
				Disabled:   true,
				FieldType:  "text",
				ClassInput: common.ClassInputTextDisabled + " w-full",
			})
		</div>
	</div>
	<!-- Storniranje Details Section -->
	<div class="text-blue-800 font-bold text-sm mb-1">
		{ translator.Text("Podaci o novom nalogu") }
	</div>
	<div class="box-content flex flex-col p-2 border-2 border-gray-300 rounded-md">
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "nalog",
				LabelText:  translator.Label("Broj naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "nalog",
				Name:       "nalog",
				Value:      model.NalogNew,
				FieldType:  "text",
				Disabled:   false,
				ClassInput: common.ClassInputTextDisabled + " w-42",
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "danal",
				LabelText:  translator.Label("Datum naloga"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "danal",
				Name:       "danal",
				Value:      model.DanalNew,
				FieldType:  "text",
				Disabled:   false,
				ClassInput: common.ClassInputTextDisabled,
			})
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "datob",
				LabelText:  translator.Label("Datum Obrade"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
				ID:         "datob",
				Name:       "datob",
				Value:      model.DanalNew,
				FieldType:  "text",
				Disabled:   false,
				ClassInput: common.ClassInputTextDisabled,
			})
		</div>
		<div class="flex items-center space-x-2 mb-1">
			@tmpl.LabelField(domain.LabelFieldConfig{
				ID:         "opis",
				LabelText:  translator.Label("Opis knjizenja"),
				ClassLabel: common.ClassLabel + " w-24",
			})
			@tmpl.TextInputField(domain.InputFieldConfig{
