package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

// Main entry point for Otvorene stavke module
templ OtvoreneStavkeMain(tabs domain.TabData, tblPartneri, tblDetalji domain.TableData, btnObrada, btnPrint, btnOpomene domain.Button, searchInput, searchInputDetalji domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@OtvoreneStavke(tabs, tblPartneri, tblDetalji, btnObrada, btnPrint, btnOpomene, searchInput, searchInputDetalji, translator, gnGod)
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleDblClickKontoSelectionScript()
	@tmpl.SpinnerScript()
	@tmpl.OpenPrintWithParamsScript()¨
	@tmpl.HandleBackendResponseScript()
}

// Tab 1 - Otvorene stavke (Open Items)
templ OtvoreneStavke(tabs domain.TabData, tblPartneri, tblDetalji domain.TableData, btnObrada, btnPrint, btnOpomene domain.Button, searchInput, searchInputDetalji domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "otvorene-stavke-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Od Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Do Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Right Column - Date and Days -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Pod datumom -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "poddatumom",
							LabelText:  translator.Label("Pod datumom"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "poddatumom",
							Name:       "poddatumom",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Otv. stavke preko broja dana -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "otvstavkedana",
							LabelText:  translator.Label("Otv. stavke preko broja dana"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.NumericInputField(domain.InputFieldConfig{
							ID:         "otvstavkedana",
							Name:       "otvstavkedana",
							FieldType:  "text",
							Value:      "0",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-20",
							TabIndex:   "5",
							MaxLength:  "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 mt-auto">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.Search_PartPrintButton(btnPrint)
						@tmpl.Search_PartPrintButton(btnOpomene)
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tblPartneri, searchInput)
				<!-- Table -->
				<div id="otvorenestavketable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblPartneri, translator)
				</div>
			</div>
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tblDetalji, searchInputDetalji)
				<!-- Table -->
				<div id="otvorenestavketabledetalji" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetalji, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	<input type="hidden" id="otvorene-selected-id" name="otvorene-selected-id" value=""/>
	<input type="hidden" id="stampaotvstavke" name="stampaotvstavke" value="otvstavke"/>
	<input type="hidden" id="stampaopomena" name="stampaopomena" value="opomena"/>
	<script>
			// Capture selected row ID from hx-get attribute when a partneri row is clicked
		if (!window.otvoreneStavkeRowIdListener) {
			window.otvoreneStavkeRowIdListener = true;
			document.addEventListener('htmx:beforeRequest', function(evt) {
				const el = evt.detail.elt;
				if (el.tagName === 'TR' && el.closest('#otvorenestavketable')) {
					const hxGet = el.getAttribute('hx-get') || '';
					const id = hxGet.split('/').pop();
					const input = document.getElementById('otvorene-selected-id');
					if (input && id) input.value = id;
				}
			});
		}
		// Listen for table data to be loaded via HTMX, then auto-click first row once
		if (!window.otvoreneStavkeFirstRowListener) {
			window.otvoreneStavkeFirstRowListener = true;
			window.handleOtvoreneStavkeFirstRow = function(evt) {
				const target = evt.detail.target;
				// Trigger ONLY when partneri table is swapped, NOT when details table is swapped
				if (target.id === 'otvorenestavketable') {
					console.log('Selecting first row after table data loaded');
					setTimeout(() => {
						const firstRow = document.querySelector('#tab1 table tbody tr');
						if (firstRow) {
							// Prevent this listener from running again
							document.removeEventListener('htmx:afterSwap', window.handleOtvoreneStavkeFirstRow);
							firstRow.click();
						}
					}, 500);
				}
			};
			
			document.addEventListener('htmx:afterSwap', window.handleOtvoreneStavkeFirstRow);
		}
	</script>
}

// Tab 2 - Zatvorene stavke (Closed Items)
templ ZatvoreneStavke(tabs domain.TabData, tblPartneri, tblDetalji domain.TableData, btnObrada, btnStampa domain.Button, searchInput, searchInputDetalji domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "otvorene-stavke-panel", translator)
		</div>
		<!-- Tab 2 Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Od Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Do Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Right Column - Date Range -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Od datuma -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Do datuma -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dodatuma",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 mt-auto">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.Search_PartPrintButton(btnStampa)
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tblPartneri, searchInput)
				<!-- Table -->
				<div id="zatvorenestavketable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblPartneri, translator)
				</div>
			</div>
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tblDetalji, searchInputDetalji)
				<!-- Table -->
				<div id="zatvorenestavketabledetalji" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetalji, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	<!-- Hidden input: holds the ID of the currently selected partneri row for use by the print button -->
	<input type="hidden" id="zatvorene-selected-id" name="zatvorene-selected-id" value=""/>
	<script>
		// Capture selected row ID from hx-get attribute when a partneri row is clicked
		if (!window.zatvoreneStavkeRowIdListener) {
			window.zatvoreneStavkeRowIdListener = true;
			document.addEventListener('htmx:beforeRequest', function(evt) {
				const el = evt.detail.elt;
				if (el.tagName === 'TR' && el.closest('#zatvorenestavketable')) {
					const hxGet = el.getAttribute('hx-get') || '';
					const id = hxGet.split('/').pop();
					const input = document.getElementById('zatvorene-selected-id');
					if (input && id) input.value = id;
				}
			});
		}
		// Listen for table data to be loaded via HTMX, then auto-click first row once
		if (!window.zatvoreneStavkeFirstRowListener) {
			window.zatvoreneStavkeFirstRowListener = true;
			
			window.handleZatvoreneStavkeFirstRow = function(evt) {
				const target = evt.detail.target;
				console.log('ZatvoreneStavke afterSwap event, target ID:', target?.id);
				// Trigger ONLY when partneri table is swapped, NOT when details table is swapped
				if (target.id === 'zatvorenestavketable') {
					console.log('Selecting first row after table data loaded');
					setTimeout(() => {
						const firstRow = document.querySelector('#tab2 table tbody tr');
						console.log('First row element:', firstRow);
						if (firstRow) {
							console.log('Clicking first row, row has hx attributes:', firstRow.attributes);
							// Prevent this listener from running again
							document.removeEventListener('htmx:afterSwap', window.handleZatvoreneStavkeFirstRow);
							firstRow.click();
						}
					}, 100);
				}
			};
			
			document.addEventListener('htmx:afterSwap', window.handleZatvoreneStavkeFirstRow);
		}
	</script>
}

// Tab 3 - IOS (Izvod otvorenih stavki - Statement of Open Items)
templ IOS(tabs domain.TabData, tblPartneri, tblDetalji domain.TableData, btnObrada, btnIOS domain.Button, searchInput, searchInputDetalji domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "otvorene-stavke-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Od Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Do Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Right Column - Date and Days -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
					<!-- Od datuma -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "poddatumom",
							Name:       "poddatumom",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Otv. stavke preko broja dana -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "otvstavkedana",
							LabelText:  translator.Label("Otv. stavke preko broja dana"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "otvstavkedana",
							Name:       "otvstavkedana",
							FieldType:  "number",
							Value:      "0",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-20",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
							MaxLength:  "3",
						})
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 mt-auto">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.Search_PartPrintButton(btnIOS)
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tblPartneri, searchInput)
				<!-- Table -->
				<div id="iostable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblPartneri, translator)
				</div>
			</div>
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tblDetalji, searchInputDetalji)
				<!-- Table -->
				<div id="iostabledetalji" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetalji, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	<!-- Hidden input: holds the ID of the currently selected IOS partneri row for use by the print button -->
	<input type="hidden" id="ios-selected-id" name="ios-selected-id" value=""/>
	<script>
		// Capture selected row ID from hx-get attribute when a partneri row is clicked
		if (!window.iosRowIdListener) {
			window.iosRowIdListener = true;
			document.addEventListener('htmx:beforeRequest', function(evt) {
				const el = evt.detail.elt;
				if (el.tagName === 'TR' && el.closest('#iostable')) {
					const hxGet = el.getAttribute('hx-get') || '';
					const id = hxGet.split('/').pop();
					const input = document.getElementById('ios-selected-id');
					if (input && id) input.value = id;
				}
			});
		}
		// Listen for table data to be loaded via HTMX, then auto-click first row once
		if (!window.iosFirstRowListener) {
			window.iosFirstRowListener = true;
			window.handleIOSFirstRow = function(evt) {
				const target = evt.detail.target;
				console.log('IOS afterSwap event, target ID:', target?.id);
				// Trigger ONLY when partneri table is swapped, NOT when details table is swapped
				if (target.id === 'iostable') {
					console.log('Selecting first row after table data loaded');
					setTimeout(() => {
						const firstRow = document.querySelector('#tab3 table tbody tr');
						console.log('First row element:', firstRow);
						if (firstRow) {
							console.log('Clicking first row, row has hx attributes:', firstRow.attributes);
							// Prevent this listener from running again
							document.removeEventListener('htmx:afterSwap', window.handleIOSFirstRow);
							firstRow.click();
						}
					}, 100);
				}
			};
			
			document.addEventListener('htmx:afterSwap', window.handleIOSFirstRow);
		}
	</script>
}

// Tab 4 - Dospela potraživanja/dugovanja (Due Receivables/Payables)
templ DospelaPotrazivanja(tabs domain.TabData, tblPartneri, tblDetalji domain.TableData, btnObrada, btnPrint domain.Button, searchInput, searchInputDetalji domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "dospela-potrazivanja-panel", translator)
		</div>
		<!-- Tab 4 Content -->
		<div id="tab4" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col">
					<!-- Konto Field -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Od Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Do Šifre -->
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do šifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Right Column - Radio Buttons -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col">
					<!-- First Radio Set - Display Type with Date -->
					<div class="mb-2 flex items-center gap-1">
						<div class="flex flex-row gap-4">
							<label class="flex items-center gap-2 cursor-pointer">
								<input type="radio" name="tip_pregleda" value="A" class="w-4 h-4" tabindex="4" checked/>
								<span class="text-sm">{ translator.Label("Prikaz analitički") }</span>
							</label>
							<label class="flex items-center gap-2 cursor-pointer">
								<input type="radio" name="tip_pregleda" value="S" class="w-4 h-4" tabindex="5"/>
								<span class="text-sm">{ translator.Label("Prikaz sintetički") }</span>
							</label>
						</div>
						<div class="flex-1"></div>
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "poddatumom",
							LabelText:  translator.Label("Pod datumom"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "poddatumom",
							Name:       "poddatumom",
							FieldType:  "date",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<!-- Second Radio Set - Date Filter -->
					<div class="flex flex-col gap-1 mb-2">
						<div class="flex items-center gap-1">
							<label class="flex items-center gap-1 cursor-pointer">
								<input type="radio" name="tip_potrazivanja" value="D" class="w-4 h-4" tabindex="7" checked/>
								<span class="text-sm">{ translator.Label("Potraživanja koja dospevaju u narednih") }</span>
							</label>
						</div>
						<div class="flex items-center justify-between gap-1">
							<div class="flex items-center gap-1">
								<label class="flex items-center gap-1 cursor-pointer">
									<input type="radio" name="tip_potrazivanja" value="S" class="w-4 h-4" tabindex="8"/>
									<span class="text-sm">{ translator.Label("Potraživanja koja su starija od") }</span>
								</label>
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:         "brojdana",
									Name:       "brojdana",
									FieldType:  "text",
									Disabled:   false,
									ClassInput: common.ClassInputTextEnabled + " ml-16 w-16",
									MaxLength:  "3",
									Value:      "30",
									TabIndex:   "9",
									OnInput:    "clearFieldError",
									OnFocus:    "clearFieldError",
								})
								<span class="text-sm">{ translator.Label("dana") }</span>
							</div>
							<!-- Buttons -->
							<div class="flex gap-1">
								@tmpl.FormObradaButton(btnObrada, translator)
								@tmpl.Search_PartPrintButton(btnPrint)
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tblPartneri, searchInput)
				<!-- Table -->
				<div id="dospelatable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblPartneri, translator)
				</div>
			</div>
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@tmpl.Search_Part(tblDetalji, searchInputDetalji)
				<!-- Table -->
				<div id="dospelatabledetalji" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tblDetalji, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.HandleDialogResponseScript("dialog-content")
	@tmpl.ClearFieldErrorScript()
	@tmpl.SpinnerScript()
	<script>
		// Listen for table data to be loaded via HTMX, then auto-click first row once
		if (!window.dospelaFirstRowListener) {
			window.dospelaFirstRowListener = true;
			window.handleDospelaFirstRow = function(evt) {
				const target = evt.detail.target;
				console.log('dospela potrazivanja/obaveze afterSwap event, target ID:', target?.id);
				// Trigger ONLY when partneri table is swapped, NOT when details table is swapped
				if (target.id === 'dospelatable') {
					console.log('Selecting first row after table data loaded');
					setTimeout(() => {
						const firstRow = document.querySelector('#tab4 table tbody tr');
						console.log('First row element:', firstRow);
						if (firstRow) {
							console.log('Clicking first row, row has hx attributes:', firstRow.attributes);
							// Prevent this listener from running again
							document.removeEventListener('htmx:afterSwap', window.handleDospelaFirstRow);
							firstRow.click();
						}
					}, 100);
				}
			};
			
			document.addEventListener('htmx:afterSwap', window.handleDospelaFirstRow);
		}
	</script>
}

// Tab 5 - Pregled Dugovanja/Obaveze po starosti (Overview of Payables by Age)
templ PregledPotrazivanjaObaveze(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "pregled-dugovanja-panel", translator)
		</div>
		<!-- Tab 5 Content -->
		<div id="tab5" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Radio Buttons, Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col gap-1">
					<!-- Row 1: Radio Set - Display Type (Horizontal) -->
					<div class="flex flex-row gap-4">
						<label class="flex items-center gap-2 cursor-pointer">
							<input type="radio" name="tip_pregleda" value="K" class="w-4 h-4" tabindex="1" checked/>
							<span class="text-sm">{ translator.Label("Pregled dugovanja kupaca") }</span>
						</label>
						<label class="flex items-center gap-2 cursor-pointer">
							<input type="radio" name="tip_pregleda" value="D" class="w-4 h-4" tabindex="2"/>
							<span class="text-sm">{ translator.Label("Pregled obaveza prema dobavljačima") }</span>
						</label>
					</div>
					<!-- Row 2: Od Konta and Od Šifre -->
					<div class="flex gap-1">
						<div class="flex items-center gap-1 flex-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "odkonta",
								LabelText:  translator.Label("Od konta"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "odkonta",
								Name:       "odkonta",
								FieldType:  "text",
								Value:      "0000",
								Disabled:   false,
								ClassInput: common.ClassInputTextEnabled + " w-24",
								TabIndex:   "3",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
								MinLength:  "4",
								MaxLength:  "6",
							})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
