// Tab 8 - Povezivanje računa i uplata (Account and Payment Linking)
templ PovezivanjRacunaIUplata(tabs domain.TabData, tbl domain.TableData, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke"), tabs, "#tab-content", "otvorene-stavke-panel", translator)
		</div>
		<!-- Tab 8 Content -->
		<div id="tab8" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div class="border bg-yellow-100 border-yellow-400 p-2 rounded-lg">
				<div class="flex items-center gap-2">
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "konto8",
						LabelText:  translator.Label("Konto"),
						ClassLabel: "text-sm font-medium w-16",
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "konto8",
						Name:       "konto8",
						FieldType:  "text",
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "1",
					})
					<button class="px-2 py-1 bg-blue-500 text-white text-xs rounded">F3</button>
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "pocetakkonta8",
						LabelText:  translator.Label("Početak od šifre"),
						ClassLabel: "text-sm font-medium w-28",
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "pocetakkonta8",
						Name:       "pocetakkonta8",
						FieldType:  "text",
						Value:      "00",
						ClassInput: common.ClassInputTextEnabled + " w-20",
						TabIndex:   "2",
					})
					<button class="px-2 py-1 bg-blue-500 text-white text-xs rounded">F3</button>
					@tmpl.LabelField(domain.LabelFieldConfig{
						ID:         "zavrsenisifra8",
						LabelText:  translator.Label("Završeno sa šifrom"),
						ClassLabel: "text-sm font-medium w-28",
					})
					@tmpl.TextInputField(domain.InputFieldConfig{
						ID:         "zavrsenisifra8",
						Name:       "zavrsenisifra8",
						FieldType:  "text",
						Value:      "999999",
						ClassInput: common.ClassInputTextEnabled + " w-20",
						TabIndex:   "3",
					})
					<button class="px-2 py-1 bg-blue-500 text-white text-xs rounded">F3</button>
					<div class="flex-1"></div>
					<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Obradi") }</button>
					<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Zatv. račun") }</button>
					<button class="px-3 py-1 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded">{ translator.Label("Nazad") }</button>
				</div>
				<div class="flex items-center gap-2 mt-2">
					<div class="border bg-white border-gray-300 p-2 rounded w-32">
						<div class="text-xs font-bold mb-2">{ translator.Label("Iznosi") }</div>
						<div class="flex justify-between text-xs mb-1">
							<span>{ translator.Label("Iznos za razdoblje") }</span>
							<span class="font-bold">0,00</span>
						</div>
						<div class="flex justify-between text-xs mb-1">
							<span>{ translator.Label("Selektovani iznos") }</span>
							<span class="font-bold">0,00</span>
						</div>
						<div class="flex justify-between text-xs">
							<span>{ translator.Label("Ostatak") }</span>
							<span class="font-bold">0,00</span>
						</div>
					</div>
				</div>
			</div>
			<!-- Three-column layout -->
			<div class="flex flex-row gap-1 flex-1 min-h-0">
				<!-- Partners Column -->
				<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden w-1/3">
					<div class="text-sm font-bold mb-1 px-1">{ translator.Label("PARTNERI") }</div>
					<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
						<table class="w-full text-xs border-collapse">
							<thead>
								<tr class="bg-gray-700 text-white sticky top-0">
									<th class="border border-gray-400 px-1 py-1 text-left">Konto</th>
									<th class="border border-gray-400 px-1 py-1 text-left">Sifra</th>
									<th class="border border-gray-400 px-1 py-1 text-left">Naziv</th>
								</tr>
							</thead>
							<tbody>
								<!-- Partner rows -->
							</tbody>
						</table>
					</div>
				</div>
				<!-- Payments/Documents Columns -->
				<div class="flex flex-col gap-1 flex-1 min-h-0">
					<!-- Payments Column -->
					<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
						<div class="text-sm font-bold mb-1 px-1">{ translator.Label("UPLATE") }</div>
						<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
							<table class="w-full text-xs border-collapse">
								<thead>
									<tr class="bg-gray-700 text-white sticky top-0">
										<th class="border border-gray-400 px-1 py-1 text-left">Broj naloga</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Datum naloga</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Dokument</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Datum dokumenta</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Dospece</th>
									</tr>
								</thead>
								<tbody>
									<!-- Payment rows -->
								</tbody>
							</table>
						</div>
						<div class="border-t border-gray-400 p-1 bg-gray-100 font-bold text-xs">
							<span>TOTAL:</span>
						</div>
					</div>
					<!-- Invoices/Accounts Column -->
					<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
						<div class="text-sm font-bold mb-1 px-1">{ translator.Label("RAČUNI") }</div>
						<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
							<table class="w-full text-xs border-collapse">
								<thead>
									<tr class="bg-green-600 text-white sticky top-0">
										<th class="border border-gray-400 px-1 py-1 text-left">Broj naloga</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Broj dokumenta</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Rodov. godina</th>
										<th class="border border-gray-400 px-1 py-1 text-left">OJ</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Datum dokumenta</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Rok</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Dospeće</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Iznos računa</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Nezatvoren</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Kompenzacije</th>
										<th class="border border-gray-400 px-1 py-1 text-left">Iznos za zatvaranje</th>
									</tr>
								</thead>
								<tbody>
									<!-- Account rows -->
								</tbody>
							</table>
						</div>
						<div class="border-t border-gray-400 p-1 bg-gray-100 font-bold text-xs">
							<span>TOTAL:</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.ShowMessage()
}
