// Tab 7 - Povezivanje računa i uplata (Account and Payment Linking)
templ PovezivanjeRacunaUplata(tabs domain.TabData, tblPartneri, tblUplate, tblFakture domain.TableData, btnObrada, btnZatvaranje, btnNazad domain.Button, searchPartneri domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "otvorene-stavke-panel", translator)
		</div>
		<!-- Tab 7 Content -->
		<div id="tab7" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-1 rounded-lg flex flex-row gap-2">
				<!-- Left: Input fields -->
				<div class="flex flex-col gap-1 flex-1">
					<!-- Konto Field -->
					<div class="flex items-center gap-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Počev od šifre -->
					<div class="flex items-center gap-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Počev od šifre"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Zaključno sa šifrom -->
					<div class="flex items-center gap-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Zaključno sa šifrom"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "3",
							OnInput:      "clearFieldError",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
				</div>
				<!-- Right: Buttons + Iznosi fieldset -->
				<div class="flex flex-col gap-1 flex-1">
					<!-- Buttons row -->
					<div class="flex items-center gap-1 justify-end">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.FormObradaButton(btnZatvaranje, translator)
						@tmpl.Button(btnNazad)
					</div>
					<!-- Iznosi fieldset - single row, fills parent -->
					<fieldset class="px-2 pt-0 w-full">
						<div class="grid grid-cols-3 gap-2">
							<div class="flex flex-col gap-0.5">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "iznoszarazvodjenje",
									LabelText:  translator.Label("Iznos za razvođenje"),
									ClassLabel: common.ClassLabel + " text-blue-800 font-bold text-xs",
								})
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:            "iznoszarazvodjenje",
									Name:          "iznoszarazvodjenje",
									Disabled:      true,
									ClassInput:    common.ClassInputNumericDisabled + " text-blue-800 font-bold text-sm w-full",
									DecimalPlaces: 2,
									MaxLength:     "18",
									TabIndex:      "-1",
								})
							</div>
							<div class="flex flex-col gap-0.5">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "selelektovaniiznos",
									LabelText:  translator.Label("Selektovani iznos"),
									ClassLabel: common.ClassLabel + " text-blue-800 font-bold text-xs",
								})
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:            "selelektovaniiznos",
									Name:          "selelektovaniiznos",
									Disabled:      true,
									ClassInput:    common.ClassInputNumericDisabled + " text-blue-800 font-bold text-sm w-full",
									DecimalPlaces: 2,
									MaxLength:     "18",
									TabIndex:      "-1",
								})
							</div>
							<div class="flex flex-col gap-0.5">
								@tmpl.LabelField(domain.LabelFieldConfig{
									ID:         "ostatak",
									LabelText:  translator.Label("Ostatak"),
									ClassLabel: common.ClassLabel + " text-blue-800 font-bold text-xs",
								})
								@tmpl.NumericInputField(domain.InputFieldConfig{
									ID:            "ostatak",
									Name:          "ostatak",
									Disabled:      true,
									ClassInput:    common.ClassInputNumericDisabled + " text-blue-800 font-bold text-sm w-full",
									DecimalPlaces: 2,
									MaxLength:     "18",
									TabIndex:      "-1",
								})
							</div>
						</div>
					</fieldset>
				</div>
			</div>
			<!-- Data Section: Two Columns -->
			<div class="flex flex-row gap-1 flex-1 min-h-0">
				<!-- Left Column: PARTNERI -->
				<div class="flex flex-col border bg-blue-100 border-blue-400 p-1 rounded-lg min-h-0 overflow-hidden w-1/2">
					@tmpl.LoadingSpinner()
					@tmpl.Search_Part(tblPartneri, searchPartneri)
					@tmpl.Table(tblPartneri, translator)
				</div>
				<!-- Right Column: UPLATE + RAČUNI stacked -->
				<div class="flex flex-col gap-1 w-1/2 min-h-0">
					<!-- UPLATE -->
					<div class="flex flex-col border bg-blue-100 border-blue-400 p-1 rounded-lg min-h-0 overflow-hidden flex-1">
						@tmpl.Table(tblUplate, translator)
					</div>
					<!-- RAČUNI -->
					<div class="flex flex-col border bg-blue-100 border-blue-400 p-1 rounded-lg min-h-0 overflow-hidden flex-1">
						@tmpl.Table(tblFakture, translator)
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container -->
	<div id="pov-dialog-content"></div>
	@tmpl.ClearFieldErrorScript()
	@tmpl.SpinnerScript()
	<div id="search-dropdown"></div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.HandleDblClickKontoSelectionScript()
}
