							OnFocus:    "clearFieldError",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dospece120",
							Name:       "dospece120",
							FieldType:  "text",
							Value:      "120",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-8",
							TabIndex:   "12",
							MinLength:  "1",
							MaxLength:  "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="flex gap-1 justify-end mt-auto">
						@tmpl.FormObradaButton(btnObrada, translator)
						@tmpl.Search_PartPrintButton(btnPrint)
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="dugovanjatable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.HandleDialogResponseScript("dialog-content")
	@tmpl.ClearFieldErrorScript()
	@tmpl.SpinnerScript()
	<script>
		// Listen for table data to be loaded via HTMX, then auto-click first row once
		if (!window.dospelaFirstRowListener) {
			window.dospelaFirstRowListener = true;
			window.handleDospelaFirstRow = function(evt) {
				const target = evt.detail.target;
				console.log('dospela potrazivanja/obaveze afterSwap event, target ID:', target?.id);
				// Trigger ONLY when partneri table is swapped, NOT when details table is swapped
				if (target.id === 'dospelatable') {
					console.log('Selecting first row after table data loaded');
					setTimeout(() => {
						const firstRow = document.querySelector('#tab4 table tbody tr');
						console.log('First row element:', firstRow);
						if (firstRow) {
							console.log('Clicking first row, row has hx attributes:', firstRow.attributes);
							// Prevent this listener from running again
							document.removeEventListener('htmx:afterSwap', window.handleDospelaFirstRow);
							firstRow.click();
						}
					}, 100);
				}
			};
			
			document.addEventListener('htmx:afterSwap', window.handleDospelaFirstRow);
		}
	</script>
}

// Tab 6 - Pregled dospelog duga po starosti (Overview of Due Debt by Age)
templ PregledDospelogDugaPoStarosti(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service, gnGod int) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Otvorene stavke, dugovanja, potraživanja"), tabs, "#tab-content", "pregled-dospelog-duga-po-starosti-panel", translator)
		</div>
		<!-- Tab 6 Content -->
		<div id="tab6" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section - Two Columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Radio Buttons, Konto and Sifre -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col gap-1">
					<!-- Row 1: Radio Set - Display Type (Horizontal) -->
