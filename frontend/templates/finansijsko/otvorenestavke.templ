								TabIndex:   "5",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError",
								MinLength:  "2",
								MaxLength:  "6",
							})
						</div>
					</div>
					<!-- Row 3: Do Konta and Do Šifre -->
					<div class="flex gap-1">
