							ClassInput: common.ClassInputTextEnabled + " w-8",
							TabIndex:   "9",
							MinLength:  "1",
							MaxLength:  "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dospece60",
							Name:       "dospece60",
							FieldType:  "text",
							Value:      "60",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-8",
							TabIndex:   "10",
							MinLength:  "1",
							MaxLength:  "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dospece90",
							Name:       "dospece90",
							FieldType:  "text",
							Value:      "90",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-8",
							TabIndex:   "11",
							MinLength:  "1",
							MaxLength:  "3",
