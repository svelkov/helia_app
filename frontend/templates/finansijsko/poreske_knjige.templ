package finansijsko

import (
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

templ PoreskeKnjigeMain(tabs domain.TabData, tblIzdatih domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, knjigaValues []domain.ComboItem, gnGod int, translator *i18n.Service) {
	<!-- Tab Content -->
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@KnjigaIzdatihRacuna(tabs, tblIzdatih, btnObrada, btnPrint, searchInput, knjigaValues, gnGod, translator)
	</div>
	@tmpl.ShowMessageScript()
	@tmpl.HandleBackendResponseScript()
	@components.SpinnerScript()
}

// Tab 1 - Knjiga izdatih racuna
templ KnjigaIzdatihRacuna(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, knjigaValues []domain.ComboItem, gnGod int, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Poreske knjige i prijava"), tabs, "#tab-content", "poreske-knjige-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Parameters Section -->
			<div class="border bg-blue-100 border-blue-400 mt-1 p-2 rounded-lg">
				<div class="grid grid-cols-[40%_25%_33%] gap-x-3 items-center">
					<div class="col-start-1 row-start-1 flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "knjiga",
							LabelText:  translator.Label("Vrsta knjige računa"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "knjiga",
							Name:         "knjiga",
							ClassSelect:  common.ClassSelect + " w-96",
							OptionValues: knjigaValues,
							TabIndex:     "1",
						}, translator)
					</div>
					<div class="col-start-1 row-start-2 flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-32 mr-2",
							TabIndex:   "2",
						})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodatuma",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-28",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, time.Now().Month(), time.Now().Day(), 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
						})
					</div>
					<div class="col-start-2 row-start-1 flex items-center gap-1 whitespace-nowrap">
						<input type="checkbox" id="stampaponalozima" name="stampaponalozima" tabindex="4" class="w-4 h-4"/>
						<label for="stampaponalozima" class="text-gray-900">{ translator.Label("Štampaj knjigu po nalozima") }</label>
					</div>
					<div class="col-start-2 row-start-2 flex items-center gap-1 whitespace-nowrap">
						<input type="checkbox" id="stampaponalozimazbirno" name="stampaponalozimazbirno" tabindex="5" class="w-4 h-4"/>
						<label for="stampaponalozimazbirno" class="text-gray-900">{ translator.Label("Štampaj knjigu po nalozima zbirno") }</label>
					</div>
					<div class="col-start-3 row-start-2 flex items-center justify-end gap-1">
						@components.FormObradaButton(btnObrada, translator)
						@components.Search_PartPrintButton(btnPrint)
					</div>
				</div>
			</div>
			<!-- Master Table -->
			<div class="border bg-blue-100 border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="poreske-knjige-table" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<!-- Dialog display container-->
	<div id="dialog-content"></div>
	@tmpl.OpenPrintWithParamsScript()
}

// Tab 2 - Knjiga ulaznih racuna
