templ PrometTotalValues(total domain.TotalValues, translator *i18n.Service) {
	<div
		id="totalvalues"
		class="border p-1 rounded-lg"
		hx-get="/api/promet/totalvalues"
		hx-trigger="click from:#obrada-btn"
		hx-target="#totalvalues"
		hx-swap="innerHTML"
		hx-vals="js:{
            konto: document.getElementById('konto')?.value,
            sifra: document.getElementById('sifra')?.value,
            oddatuma: document.getElementById('oddatuma')?.value,
            dodatuma: document.getElementById('dodatuma')?.value,
			odmi: document.getElementById('odmi')?.value,
			domi: document.getElementById('domi')?.value,
			odkonta: document.getElementById('odkonta')?.value,
			dokonta: document.getElementById('dokonta')?.value,
			odsifre: document.getElementById('odsifre')?.value,
			dosifre: document.getElementById('dosifre')?.value,
			tabname: document.querySelector('button[aria-selected=true]')?.id
        }"
	>
		<div class="grid grid-cols-4 gap-1 mb-px text-sm font-medium text-gray-700 h-6 items-center">
			<div class="text-center"></div>
			<div class="text-center">{ translator.Label("Duguje") }</div>
			<div class="text-center">{ translator.Label("Potražuje") }</div>
			<div class="text-center">{ translator.Label("Saldo") }</div>
		</div>
		<div
			class="grid grid-cols-4 gap-1 mb-1 h-6 items-center"
		>
			<div class="text-sm text-gray-600">{ translator.Label("Promet do") }</div>
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "dugujedo",
				Value:         common.FormatNumberWithSystemLocale(total.DugDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "potrazujedo",
				Value:         common.FormatNumberWithSystemLocale(total.PotDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "saldodo",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
		<div class="grid grid-cols-4 gap-1 mb-1 h-6 items-center">
			<div class="text-sm text-gray-600">{ translator.Label("Promet za period") }</div>
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "dugujeperiod",
				Value:         common.FormatNumberWithSystemLocale(total.DugPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "potrazujeperiod",
				Value:         common.FormatNumberWithSystemLocale(total.PotPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "saldoperiod",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
		<div class="grid grid-cols-4 gap-1 h-6 items-center">
			<div class="text-sm text-gray-600">{ translator.Label("Ukupan promet") }</div>
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "dugujeukupno",
				Value:         common.FormatNumberWithSystemLocale(total.DugTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "potrazujeukupno",
				Value:         common.FormatNumberWithSystemLocale(total.PotTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "saldoukupno",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				FieldType:     "number",
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
	</div>
}
