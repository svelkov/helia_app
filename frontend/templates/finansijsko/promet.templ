						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Od Sifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifranaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							Value:        "00",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Do Sifre"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifranaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							Value:        "999999",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "3",
						})
						@tmpl.SearchButton(domain.SearchButtonConfig{
							ID:          "dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center justify-between gap-1 mb-1">
						<div class="flex items-center gap-1">
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "oddatuma",
								LabelText:  translator.Label("Od Datuma"),
								ClassLabel: common.ClassLabel + " w-24",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "oddatuma",
								Name:       "oddatuma",
								FieldType:  "date",
								Disabled:   false,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								TabIndex:   "4",
							})
							@tmpl.LabelField(domain.LabelFieldConfig{
								ID:         "dodatuma",
								LabelText:  translator.Label("Do Datuma"),
								ClassLabel: common.ClassLabel + " w-20",
							})
							@tmpl.TextInputField(domain.InputFieldConfig{
								ID:         "dodatuma",
								Name:       "dodatuma",
								FieldType:  "date",
								Disabled:   false,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
								TabIndex:   "5",
							})
						</div>
						<!-- Buttons on the right -->
						<div class="flex items-center space-x-1">
							@tmpl.FormObradaButton(btnObrada, translator)
							@tmpl.PrintButton(btnPrint, translator)
						</div>
					</div>
				</div>
				<!-- Values Div - Numeric Right Aligned -->
				<div class="border mt-1 mb-1 bg-blue-100 border border-blue-400 p-1 rounded-lg">
					@PrometTotalValues(total, translator)
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@tmpl.LoadingSpinner()
				@tmpl.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="promettable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@tmpl.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	@tmpl.SpinnerScript()
}

templ PrometTotalValues(total domain.TotalValues, translator *i18n.Service) {
	<div
		id="totalvalues"
		class="border p-1 rounded-lg"
		hx-get="/api/promet/totalvalues"
		hx-trigger="click from:#obrada-btn"
		hx-target="#totalvalues"
		hx-swap="innerHTML"
		hx-vals="js:{
            konto: document.getElementById('konto')?.value,
            sifra: document.getElementById('sifra')?.value,
            oddatuma: document.getElementById('oddatuma')?.value,
            dodatuma: document.getElementById('dodatuma')?.value,
			odmi: document.getElementById('odmi')?.value,
			domi: document.getElementById('domi')?.value,
			odkonta: document.getElementById('odkonta')?.value,
			dokonta: document.getElementById('dokonta')?.value,
			odsifre: document.getElementById('odsifre')?.value,
			dosifre: document.getElementById('dosifre')?.value,
			tabname: document.querySelector('button[aria-selected=true]')?.id
        }"
	>
		<div class="grid grid-cols-4 gap-1 mb-px text-sm font-medium text-gray-700 h-6 items-center">
			<div class="text-center"></div>
			<div class="text-center">{ translator.Label("Duguje") }</div>
			<div class="text-center">{ translator.Label("Potražuje") }</div>
			<div class="text-center">{ translator.Label("Saldo") }</div>
		</div>
		<div
			class="grid grid-cols-4 gap-1 mb-1 h-6 items-center"
		>
			<div class="text-sm text-gray-600">{ translator.Label("Promet do") }</div>
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "dugujedo",
				Value:         common.FormatNumberWithSystemLocale(total.DugDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "potrazujedo",
				Value:         common.FormatNumberWithSystemLocale(total.PotDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "saldodo",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoDo, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
		<div class="grid grid-cols-4 gap-1 mb-1 h-6 items-center">
			<div class="text-sm text-gray-600">{ translator.Label("Promet za period") }</div>
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "dugujeperiod",
				Value:         common.FormatNumberWithSystemLocale(total.DugPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "potrazujeperiod",
				Value:         common.FormatNumberWithSystemLocale(total.PotPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "saldoperiod",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoPer, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
		<div class="grid grid-cols-4 gap-1 h-6 items-center">
			<div class="text-sm text-gray-600">{ translator.Label("Ukupan promet") }</div>
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "dugujeukupno",
				Value:         common.FormatNumberWithSystemLocale(total.DugTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "potrazujeukupno",
				Value:         common.FormatNumberWithSystemLocale(total.PotTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
			@tmpl.NumericInputField(domain.InputFieldConfig{
				ID:            "saldoukupno",
				Value:         common.FormatNumberWithSystemLocale(total.SaldoTot, 2),
				DecimalPlaces: 2,
				Disabled:      true,
				ClassInput:    common.ClassInputNumericDisabled,
			})
		</div>
	</div>
}
