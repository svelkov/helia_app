package finansijsko

import (
	"fmt"
	tmpl "helia/frontend/templates"
	"helia/internal/domain"
	"helia/pkg/utils"
)

templ PrometMain(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.PrometTotalValues) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@PrometAnalitickihKonta(tabs, tbl, btnPrint, btnObrada, total)
	</div>
	<script>
        // Tab switching functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Set first tab as active
            document.querySelector('[hx-get="/promet/analitickakonta"]').classList.remove('bg-gray-200', 'text-gray-700');
            document.querySelector('[hx-get="/promet/analitickakonta"]').classList.add('bg-blue-600', 'text-white');
            
            // Tab click handler
            document.querySelectorAll('[hx-get^="/promet"]').forEach(tab => {
                tab.addEventListener('click', function() {
                    // Update tab styles
                    document.querySelectorAll('[hx-get^="/promet"]').forEach(t => {
                        t.classList.remove('bg-blue-600', 'text-white');
                        t.classList.add('bg-gray-200', 'text-gray-700');
                    });
                    this.classList.remove('bg-gray-200', 'text-gray-700');
                    this.classList.add('bg-blue-600', 'text-white');
                });
            });
        });
    </script>
}

templ PrometNav(tabs domain.TabData) {
	<h2 class="text-xl font-semibold">PROMET</h2>
	<nav class="py-1 h-8 text-sm font-medium text-gray-700 flex items-center whitespace-nowrap" aria-label="Tabs">
		for _, item := range tabs.Tabs {
			<input id={ fmt.Sprintf("tab%s", item.Name) } type="hidden" name="sourceTab" value={ item.Name }/>
			<button
				id={ item.ID }
				if item.IsActive {
					class="whitespace-nowrap rounded-t-lg py-1 px-1 font-medium text-sm rounded-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
				} else {
					class="whitespace-nowrap rounded-t-lg py-1 px-1 font-medium text-sm rounded-sm text-gray-600 bg-white border border-gray-300 hover:text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
				}
				hx-get={ item.HXRequestUrl }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-headers='{"X-Request-Source": "tab"}'
				aria-controls="promet-panel"
				aria-selected={ fmt.Sprintf("%v", item.IsActive) }
			>
				{ item.Label }
			</button>
		}
	</nav>
}

// Tab 1 - Promet analitickih konta
templ PrometAnalitickihKonta(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.PrometTotalValues) {
	<!-- Tab Navigation -->
	@PrometNav(tabs)
	<!-- Tab 1 Content -->
	<div id="tab1">
		<!-- First Row - Two divs side by side -->
		<div class="grid grid-cols-2 gap-1">
			<!-- Parameters Div - Left Aligned -->
			<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg">
				<div class="flex items-center gap-2 mb-1">
					@tmpl.TextInputField("konto", "", "Konto", "text", true, false, utils.ClassInputTextEnabled, utils.ClassLabel, "api/fkpl/trazikonto", "kontonaziv", `{"vkonta": "2"}`)
					@tmpl.SearchButton("konto", "konto", "/api/promet/searchbutton", "#search-dropdown", "innerHTML", "2")
					@tmpl.TextInputField("kontonaziv", "", "", "text", false, true, utils.ClassInputTextDisabled, "", "", "", "")
				</div>
				<div class="flex items-center gap-2 mb-1">
					@tmpl.TextInputField("sifra", "", "Sifra", "text", true, false, utils.ClassInputTextEnabled, utils.ClassLabel, "api/fkpl/trazikonto", "sifranaziv", `js:{"konto": document.getElementById('konto').value, "vkonta": "1"}`)
					@tmpl.SearchButton("sifra", "sifra", "/api/promet/searchbutton", "#search-dropdown", "innerHTML", "1")
					@tmpl.TextInputField("sifranaziv", "", "", "text", false, true, utils.ClassInputTextDisabled, "", "", "", "")
				</div>
				@tmpl.InputField("oddatuma", "Od datuma", "date")
				@tmpl.InputField("dodatuma", "Do datuma", "date")
				<div class="mb-1 flex items-center justify-between h-6">
					<!-- Checkbox group on the left -->
					<div class="flex items-center">
						<input type="checkbox" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500"/>
						<span class="ml-1 text-sm text-gray-700">Dodatni parametri</span>
					</div>
					<!-- Buttons on the right -->
					<div class="flex items-center space-x-1">
						@tmpl.FormObradaButton(btnObrada)
						@tmpl.FormPrintButton(btnPrint)
					</div>
				</div>
			</div>
			<!-- Values Div - Numeric Right Aligned -->
			<div class="border mt-1 mb-1 bg-blue-100 border border-blue-400 p-1 rounded-lg">
				@TotalValues(total)
			</div>
		</div>
		<div class="flex flex-col">
			<!-- Parent should have: class="flex flex-col" -->
			<!-- Table Section -->
			<div id="promettable" class="flex-1 rounded-t-lg overflow-x-auto overflow-y-auto border border-gray-200 rounded-lg">
				@tmpl.Table(tbl)
			</div>
		</div>
	</div>
}

