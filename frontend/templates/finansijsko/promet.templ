templ TotalValues(total domain.PrometTotalValues) {
	<div id="totalvalues" class="border p-1 rounded-lg">
		<div class="grid grid-cols-4 gap-1 mb-px text-sm font-medium text-gray-700 h-6 items-center">
			<div class="text-center"></div>
			<div class="text-center">Duguje</div>
			<div class="text-center">Potražuje</div>
			<div class="text-center">Saldo</div>
		</div>
		<div
			class="grid grid-cols-4 gap-1 mb-1 h-6 items-center"
			hx-get="/api/promet/totalvalues"
			hx-trigger="click from:#obrada-btn"
			hx-target="#totalvalues"
			hx-swap="innerHTML"
			hx-include="#konto, #sifra, #oddatuma, #dodatuma"
			hx-vals='{"konto": document.getElementById("konto").value, "sifra": document.getElementById("sifra").value, "oddatuma": document.getElementById("oddatuma").value, "dodatuma": document.getElementById("dodatuma").value }'
		>
			<div class="text-sm text-gray-600">Promet do:</div>
			@tmpl.NumericInputField("dugujedo", total.DugDo, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("potrazujedo", total.PotDo, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("saldodo", total.SaldoDo, 2, true, utils.ClassInputNumericDisabled)
		</div>
		<div class="grid grid-cols-4 gap-1 mb-1 h-6 items-center">
			<div class="text-sm text-gray-600">Promet za period:</div>
			@tmpl.NumericInputField("dugujeperiod", total.DugPer, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("potrazujeperiod", total.PotPer, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("saldoperiod", total.SaldoPer, 2, true, utils.ClassInputNumericDisabled)
		</div>
		<div class="grid grid-cols-4 gap-1 h-6 items-center">
			<div class="text-sm text-gray-600">Ukupan promet:</div>
			@tmpl.NumericInputField("dugujeukupno", total.DugTot, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("potrazujeukupno", total.PotTot, 2, true, utils.ClassInputNumericDisabled)
			@tmpl.NumericInputField("saldoukupno", total.SaldoTot, 2, true, utils.ClassInputNumericDisabled)
		</div>
	</div>
}
