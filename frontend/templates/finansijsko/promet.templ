package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
	"helia/frontend/components"
)

templ PrometMain(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.TotalValues, searchInput domain.InputControl, gnGod int, checkBoxURL string, translator *i18n.Service) {
	<!-- Tab Content -->
	<div id="tab-content" class="flex flex-col h-full">
		@PrometAnalitickihKonta(tabs, tbl, btnPrint, btnObrada, total, searchInput, gnGod, checkBoxURL, translator)
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleDblClickKontoSelectionScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.CloseDialogScript()
	@tmpl.OpenPrintWithParamsScript()
}

// Tab 1 - Promet analitickih konta
templ PrometAnalitickihKonta(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.TotalValues, searchInput domain.InputControl, gnGod int, checkBoxURL string, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Promet"), tabs, "#tab-content", "promet-panel", translator)
		</div>
		<!-- Tab 1 Content -->
		<div id="tab1" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- First Row - Two divs side by side -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Parameters Div - Left Aligned -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sifra",
							LabelText:  translator.Label("Sifra"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "sifra",
							Name:         "sifra",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifranaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('sifra').value, "vkonta": "1", "destfield": "sifra"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "sifra",
							Name:        "search-sifra",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "sifra"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "sifranaziv",
							Name:       "sifranaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							ClassLabel: common.ClassLabel + " w-24",
							LabelText:  translator.Label("Od datuma"),
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodatuma",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-24 ",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="mb-1 flex items-center justify-between h-6">
						<!-- Checkbox group on the left -->
						<div class="flex items-center justify-center gap-2 pl-24">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:               "dodatniparametri",
								Name:             "dodatniparametri",
								LabelText:        translator.Label("Dodatni parametri"),
								ClassCheckbox:    common.ClassCheckbox,
								OnChangeEndpoint: checkBoxURL,
								HxTarget:         "#dialog-proment-analitika-stampa",
							}, translator)
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dodatniparametri",
								ClassLabel: common.ClassCheckboxLabel,
							})
						</div>
						<!-- Buttons on the right -->
						<div class="flex items-center space-x-1">
							@components.FormObradaButton(btnObrada, translator)
							@components.PrintButton(btnPrint, translator)
						</div>
					</div>
				</div>
				<!-- Values Div - Numeric Right Aligned -->
				<div class="border mt-1 bg-blue-100 border border-blue-400 p-1 rounded-lg">
					@PrometTotalValues(total, translator)
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="promettable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
			<div id="dialog-proment-analitika-stampa"></div>
		</div>
	</div>
}

templ PrometAnalitickihKontaDialog(dialog domain.Dialog, btnPrint, btnCancel, btnClose domain.Button, prometParams domain.PrometParam, gnGod int, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in w-auto min-w-[380px]">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- Content -->
			<div class="space-y-1">
				<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in w-auto min-w-[700px] max-w-5xl">
					<fieldset class="border-2 border-blue-500 rounded-lg m-3 mb-2 p-1">
						<legend class="text-sm font-bold text-blue-700">{ translator.Title("Selekcija parametara za štampu") }</legend>
						<!-- Top checkboxes + Datum štampe -->
						<div class="flex flex-wrap items-center gap-4 mb-2">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "saldapomesecima",
								Name:              "saldapomesecima",
								LabelText:         translator.Label("Štampaj salda po mesecima"),
								IsChecked:         false,
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan,
							}, translator)
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "ukupansaldo",
								Name:              "ukupansaldo",
								LabelText:         translator.Label("Štampaj ukupan saldo posle svake stavke"),
								IsChecked:         false,
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan,
							}, translator)
						</div>
						<!-- Konta + Šifre + Buttons row -->
						<div class="grid grid-cols-[1fr_1fr_auto] gap-2 mb-1 items-start">
							<!-- Konta column -->
							<div class="space-y-1">
								<div class="flex items-center gap-1">
									@components.LabelField(domain.LabelFieldConfig{
										ID:         "odkonta",
										LabelText:  translator.Label("Počev od konta"),
										ClassLabel: common.ClassLabel + " w-40",
									})
									@components.TextInputField(domain.InputFieldConfig{
										ID:         "odkonta",
										Name:       "odkonta",
										FieldType:  "text",
										ClassInput: common.ClassInputTextEnabled + " w-20",
										MaxLength:  "6",
										Value:      prometParams.Konto,
										OnInput:    "clearFieldError",
										OnFocus:    "clearFieldError",
									})
									@components.SearchButton(domain.SearchButtonConfig{
										ID:          "btn-odkonta",
										Name:        "btn-odkonta",
										HxUrl:       "/api/promet/searchbutton",
										HxTarget:    "#search-dropdown",
										HxSwap:      "innerHTML",
										HxVals:      `{"vkonta": "1", "destfield": "odkonta"}`,
										ClassButton: common.ClassButton,
									})
								</div>
								<div class="flex items-center gap-1">
									@components.LabelField(domain.LabelFieldConfig{
										ID:         "dokonta",
										LabelText:  translator.Label("Zaključno sa kontom"),
										ClassLabel: common.ClassLabel + " w-40",
									})
									@components.TextInputField(domain.InputFieldConfig{
										ID:         "dokonta",
										Name:       "dokonta",
										FieldType:  "text",
										ClassInput: common.ClassInputTextEnabled + " w-20",
										MaxLength:  "6",
										Value:      prometParams.Konto,
										OnInput:    "clearFieldError",
										OnFocus:    "clearFieldError",
									})
									@components.SearchButton(domain.SearchButtonConfig{
										ID:          "btn-dokonta",
										Name:        "btn-dokonta",
										HxUrl:       "/api/promet/searchbutton",
										HxTarget:    "#search-dropdown",
										HxSwap:      "innerHTML",
										HxVals:      `{"vkonta": "1", "destfield": "dokonta"}`,
										ClassButton: common.ClassButton,
									})
								</div>
							</div>
							<!-- Šifre column -->
							<div class="space-y-1">
								<div class="flex items-center gap-1">
									@components.LabelField(domain.LabelFieldConfig{
										ID:         "odsifre",
										LabelText:  translator.Label("Počev od šifre"),
										ClassLabel: common.ClassLabel + " w-36",
									})
									@components.TextInputField(domain.InputFieldConfig{
										ID:         "odsifre",
										Name:       "odsifre",
										FieldType:  "text",
										ClassInput: common.ClassInputTextEnabled + " w-20",
										MaxLength:  "6",
										Value:      prometParams.Sifra,
										OnInput:    "clearFieldError",
										OnFocus:    "clearFieldError",
									})
									@components.SearchButton(domain.SearchButtonConfig{
										ID:          "btn-odsifre",
										Name:        "btn-odsifre",
										HxUrl:       "/api/promet/searchbutton",
										HxTarget:    "#search-dropdown",
										HxSwap:      "innerHTML",
										HxVals:      `{"vkonta": "1", "destfield": "odsifre"}`,
										ClassButton: common.ClassButton,
									})
								</div>
								<div class="flex items-center gap-1">
									@components.LabelField(domain.LabelFieldConfig{
										ID:         "dosifre",
										LabelText:  translator.Label("Zaključno sa šifrom"),
										ClassLabel: common.ClassLabel + " w-36",
									})
									@components.TextInputField(domain.InputFieldConfig{
										ID:         "dosifre",
										Name:       "dosifre",
										FieldType:  "text",
										ClassInput: common.ClassInputTextEnabled + " w-20",
										MaxLength:  "6",
										Value:      prometParams.Sifra,
										OnInput:    "clearFieldError",
										OnFocus:    "clearFieldError",
									})
									@components.SearchButton(domain.SearchButtonConfig{
										ID:          "btn-dosifre",
										Name:        "btn-dosifre",
										HxUrl:       "/api/promet/searchbutton",
										HxTarget:    "#search-dropdown",
										HxSwap:      "innerHTML",
										HxVals:      `{"vkonta": "1", "destfield": "dosifre"}`,
										ClassButton: common.ClassButton,
									})
								</div>
							</div>
						</div>
						<div class="flex items-center gap-1 mb-4 ml-auto">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumstampe",
								LabelText:  translator.Label("Datum štampe"),
								ClassLabel: common.ClassLabel + " whitespace-nowrap w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumstampe",
								Name:       "datumstampe",
								FieldType:  "date",
								ClassInput: common.ClassInputTextEnabled + " w-36",
								Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							})
						</div>
						<!-- Option checkboxes row -->
						<div class="flex items-center gap-8 mb-2">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "karticadeviznihkonta",
								Name:              "karticadeviznihkonta",
								LabelText:         "KARTICA DEVIZNIH KONTA",
								IsChecked:         false,
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan + " font-semibold text-blue-800",
							}, translator)
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "karticasakolicinom",
								Name:              "karticasakolicinom",
								LabelText:         "KARTICA SA KOLIČINOM",
								IsChecked:         false,
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan + " font-semibold text-blue-800",
							}, translator)
						</div>
					</fieldset>
					<div class="mt-2 ml-4 mb-4 mr-4">
						<div class="mb-2 border-b-2 border-blue-500 pt-2">
							<label class={ common.ClassCheckboxLabel + " font-bold" }>
								<input
									type="checkbox"
									id="dodatnikriterijumi"
									name="dodatnikriterijumi"
									checked="checked"
									class={ common.ClassCheckbox }
									onchange="document.getElementById('sak-dodatni-content').style.display = this.checked ? 'block' : 'none'"
								/>
								<span class={ common.ClassCheckboxSpan + " font-bold" }>{ translator.Label("Dodatni kriterijumi") }</span>
							</label>
						</div>
					</div>
					@DodatniKriterijumi(prometParams, translator)
					<!-- Buttons -->
					<div class="flex justify-end gap-1 px-4 pb-4">
						@components.Search_PartPrintButton(btnPrint)
						@components.CancelButton(btnCancel, translator)
					</div>
				</div>
			</div>
		</div>
	</div>
	<script>
		function sakToggle(chk, ids) {
			ids.forEach(function(id) {
				var el = document.getElementById(id);
				if (el) el.disabled = !chk.checked;
			});
		}
	</script>
}

templ PrometAnalitickihKontaDodatniParametri(dialog domain.Dialog, btnClose, btnSelect, btnCancel domain.Button, prometParams domain.PrometParam, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in w-auto min-w-[380px]">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			@DodatniKriterijumi(prometParams, translator)
			<!-- Buttons -->
			<div class="flex justify-end gap-1 px-4 pb-4">
				@components.SaveButton(btnSelect, translator)
				@components.CancelButton(btnCancel, translator)
			</div>
		</div>
	</div>
}

templ DodatniKriterijumi(prometParams domain.PrometParam, translator *i18n.Service) {
	<!-- Dodatni kriterijumi section -->
	<div class="mt-2 ml-4 mb-4 mr-4">
		<div id="sak-dodatni-content" style="display: block;">
			<!-- Row: Po grupi naloga -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpogrupinaloga"
						name="chkpogrupinaloga"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['odvrstenaloga','dovrstenaloga'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po grupi naloga ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "odvrstenaloga",
					LabelText:  translator.Label("Od vrste naloga"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "odvrstenaloga",
					Name:       "odvrstenaloga",
					FieldType:  "text",
					Disabled:   true,
					ClassInput: common.ClassInputTextEnabled + " w-32",
					Value:      "0",
				})
				@components.LabelField(domain.LabelFieldConfig{
					LabelText:  translator.Label("Do vrste naloga"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "dovrstenaloga",
					Name:       "dovrstenaloga",
					FieldType:  "text",
					Disabled:   true,
					ClassInput: common.ClassInputTextEnabled + " w-32",
					Value:      "0",
				})
			</div>
			<!-- Row: Po broju naloga -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpobrojunaloga"
						name="chkpobrojunaloga"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['odbrojanaloga','dobrojanaloga'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po broju naloga ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "odbrojanaloga", LabelText: translator.Label("Od broja naloga"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "odbrojanaloga", Name: "odbrojanaloga", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32", Value: "0"})
				@components.LabelField(domain.LabelFieldConfig{ID: "dobrojanaloga", LabelText: translator.Label("Do broja naloga"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "dobrojanaloga", Name: "dobrojanaloga", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32", Value: "0"})
			</div>
			<!-- Row: Po datumu naloga -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpodatumnaloga"
						name="chkpodatumnaloga"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['oddatumnaloga','dodatumnaloga'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po datumu naloga ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "oddatumnaloga", LabelText: translator.Label("Od datuma naloga"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "oddatumnaloga", Name: "oddatumnaloga", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
				@components.LabelField(domain.LabelFieldConfig{ID: "dodatumnaloga", LabelText: translator.Label("Do datuma naloga"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "dodatumnaloga", Name: "dodatumnaloga", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
			</div>
			<!-- Row: Po datumu obrade -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpodatumuobrade"
						name="chkpodatumuobrade"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['oddatumobrade','dodatumobrade'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po datumu obrade ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "oddatumobrade", LabelText: translator.Label("Od datuma obrade"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "oddatumobrade", Name: "oddatumobrade", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
				@components.LabelField(domain.LabelFieldConfig{ID: "dodatumobrade", LabelText: translator.Label("Do datuma obrade"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "dodatumobrade", Name: "dodatumobrade", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
			</div>
			<!-- Row: Po vrsti dokumenta -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpovrstidokumenta"
						name="chkpovrstidokumenta"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['vrstedokumenta'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po vrsti dokumenta ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "vrstedokumenta", LabelText: translator.Label("Vrste dokumentata"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "vrstedokumenta", Name: "vrstedokumenta", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " flex-1", Placeholder: "Unesite šifre vrsta dokumenta razdvojene zarezom"})
			</div>
			<!-- Row: Po broju dokumenta -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpobrojudokumenta"
						name="chkpobrojudokumenta"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['odbrojadokumenta','dobrojadokumenta'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po broju dokumenta ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "odbrojadokumenta", LabelText: translator.Label("Od broja dokumenta"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "odbrojadokumenta", Name: "odbrojadokumenta", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32", Value: "0"})
				@components.LabelField(domain.LabelFieldConfig{ID: "dobrojadokumenta", LabelText: translator.Label("Do broja dokumenta"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "dobrojadokumenta", Name: "dobrojadokumenta", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32", Value: "0"})
			</div>
			<!-- Row: Po datumu dokumenta -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpodatumudokumenta"
						name="chkpodatumudokumenta"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['oddatumadokumenta','dodatumadokumenta'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po datumu dokumenta ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "oddatumadokumenta", LabelText: translator.Label("Od datuma dokumenta"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "oddatumadokumenta", Name: "oddatumadokumenta", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
				@components.LabelField(domain.LabelFieldConfig{ID: "dodatumadokumenta", LabelText: translator.Label("Do datuma dokumenta"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "dodatumadokumenta", Name: "dodatumadokumenta", FieldType: "date", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-32"})
			</div>
			<!-- Row: Po iznosu -->
			<div class="flex items-center gap-2 mb-1">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkpoiznosu"
						name="chkpoiznosu"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['odiznosa','doiznosa'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po iznosu ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "odiznosa", LabelText: translator.Label("Od iznosa"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "odiznosa", Name: "odiznosa", Disabled: true, FieldType: "number", ClassInput: common.ClassInputNumericDisabled + " w-32", DecimalPlaces: 2})
				@components.LabelField(domain.LabelFieldConfig{ID: "doiznosa", LabelText: translator.Label("Do iznosa"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "doiznosa", Name: "doiznosa", Disabled: true, FieldType: "number", ClassInput: common.ClassInputNumericDisabled + " w-32", DecimalPlaces: 2})
			</div>
			<!-- Row: Po načinu knjiženja -->
			<div class="flex items-center gap-2">
				<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0" }>
					<input
						type="checkbox"
						id="chkponacinuknjizenja"
						name="chkponacinuknjizenja"
						class={ common.ClassCheckbox }
						onchange="sakToggle(this,['nacinknjizenja'])"
					/>
					<span class={ common.ClassCheckboxSpan }>{ translator.Label("Po načinu knjiženja ?") }</span>
				</label>
				@components.LabelField(domain.LabelFieldConfig{ID: "nacinknjizenja", LabelText: translator.Label("Način knjiženja"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{ID: "nacinknjizenja", Name: "nacinknjizenja", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextEnabled + " flex-1", Placeholder: "1-Duguje, 2-St.duguje, 3-Potražuje, 4-St.potražuje"})
			</div>
		</div>
	</div>
}

// Tab 2 - Analiticka kartica po mestima isporuke
templ AnalitickaKarticaPoMI(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.TotalValues, searchInput domain.InputControl, gnGod int, translator *i18n.Service) {
	<!-- Tab Navigation -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Promet"), tabs, "#tab-content", "promet-panel", translator)
		</div>
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Two divs side by side -->
			<!-- First Row - Two divs side by side -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Parameters Div - Left Aligned -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sifra",
							LabelText:  translator.Label("Sifra"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "sifra",
							Name:         "sifra",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifranaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('sifra').value, "vkonta": "1", "destfield": "sifra"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "sifra",
							Name:        "search-sifra",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "sifra"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "sifranaziv",
							Name:       "sifranaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  "Od Datuma",
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodatuma",
							LabelText:  "Do Datuma",
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odmi",
							LabelText:  "Od Mesta Isp.",
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "odmi",
							Name:         "odmi",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/mi/trazimi",
							HxTarget:     "odminaziv",
							Value:        "0",
							MinLength:    "1",
							MaxLength:    "6",
							TabIndex:     "5",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "odmi",
							Name:        "search-odmi",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odminaziv",
							Name:       "odminaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "domi",
							LabelText:  "Do Mesta Isp.",
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "domi",
							Name:         "domi",
							Value:        "999",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/mi/trazimi",
							HxTarget:     "dominaziv",
							MinLength:    "1",
							MaxLength:    "6",
							TabIndex:     "6",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "search-domi",
							Name:        "search-domi",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dominaziv",
							Name:       "dominaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="mb-1 flex items-center justify-between h-6">
						<!-- saldo po mesecima checkbox on the left -->
						<div class="flex items-center">
							@components.CheckboxField(domain.CheckboxFieldConfig{
								ID:                "saldapomesecima",
								Name:              "saldapomesecima",
								LabelText:         translator.Label("Štampaj salda po mesecima"),
								IsChecked:         false,
								ClassLabel:        common.ClassCheckboxLabel,
								ClassCheckbox:     common.ClassCheckbox,
								ClassCheckboxSpan: common.ClassCheckboxSpan,
							}, translator)
						</div>
						<!-- Buttons on the right -->
						<div class="flex items-center pt-1 space-x-1">
							@components.FormObradaButton(btnObrada, translator)
							@components.Search_PartPrintButton(btnPrint)
						</div>
					</div>
				</div>
				<!-- Values Div - Numeric Right Aligned -->
				<div class="border mt-1 bg-blue-100 border border-blue-400 p-1 rounded-lg">
					@PrometTotalValues(total, translator)
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id="prometable" class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
}

// Tab 3 - Promet deviznih analitickih konta
templ PrometDeviznihAnalitickihKonta(tabs domain.TabData, tblHdr domain.TableData, tblDevizni domain.TableData, btnPrint, btnObrada domain.Button, total domain.TotalValues, gnGod int, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Tab Navigation -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Promet"), tabs, "#tab-content", "promet-panel", translator)
		</div>
		<!-- Tab 3 Content -->
		<div id="tab3" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- First Row - Two divs side by side -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Parameters Div - Left Aligned -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Konto"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sifra",
							LabelText:  translator.Label("Sifra"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "sifra",
							Name:         "sifra",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "sifranaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('sifra').value, "vkonta": "1", "destfield": "sifra"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "sifra",
							Name:        "search-sifra",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "1", "destfield": "sifra"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "sifranaziv",
							Name:       "sifranaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatuma",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatuma",
							Name:       "oddatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 1, 1, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nalog",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-24",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatuma",
							Name:       "dodatuma",
							FieldType:  "date",
							Value:      time.Date(gnGod, 12, 31, 0, 0, 0, 0, time.UTC).Format(common.HtmlLayout),
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError",
						})
						<!-- Checkbox group on the left -->
						<div class="flex items-center">
							<input type="checkbox" class="h-4 w-4 rounded border border-blue-400 text-blue-600 focus:ring-blue-500"/>
							<span class="ml-1 text-sm text-gray-700">Dodatni parametri</span>
						</div>
						<!-- Buttons on the right -->
						<div class="flex items-center space-x-1 ml-auto pt-1">
							@components.FormObradaButton(btnObrada, translator)
							@components.PrintButton(btnPrint, translator)
						</div>
					</div>
				</div>
				<!-- Values Div - Numeric Right Aligned -->
				<div class="border mt-1 bg-blue-100 border border-blue-400 p-1 rounded-lg">
					@PrometTotalValues(total, translator)
				</div>
			</div>
			<!-- Group Data Table -->
			@PrometDeviznaKontaTables(tblHdr, tblDevizni, searchInput, translator)
		</div>
		<div id="dialog-proment-analitika-stampa"></div>
	</div>
}

templ PrometDeviznaKontaTables(tblHdr domain.TableData, tblDevizni domain.TableData, searchInput domain.InputControl, translator *i18n.Service) {
	<div id="promettable-container" class="border bg-blue-100 border border-blue-400 p-1 mt-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tblHdr, searchInput)
		<!-- Table -->
		<div id="promettable" class="flex-[2] overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tblHdr, translator)
		</div>
		if tblDevizni.ContentTitle != "" {
			<h4 class="text-sm font-semibold text-blue-700">{ tblDevizni.ContentTitle }</h4>
		} else {
			<div></div>
		}
		<!-- Table Section -->
		<div id="promettable-dev" class="flex-[1] overflow-x-auto overflow-y-auto border border-gray-200 rounded-lg">
			@components.Table(tblDevizni, translator)
