						<div><span class="font-semibold text-blue-600">{ translator.Label("Dobavljač") }:</span> <span id="total-dobavljac">431,432,433,434,435,436</span></div>
						<div><span class="font-semibold text-blue-600">{ translator.Label("Primijen avans") }:</span> <span id="total-primljen">430</span></div>
						<div><span class="font-semibold text-blue-600">{ translator.Label("Dat avans") }:</span> <span id="total-dat">150,151,152,153,154,155</span></div>
					</div>
				</div>
			</div>
			<!-- Partner Balance Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
				<div class="text-blue-800 font-bold text-xs">
					{ translator.Text("Pregled salda partnera") }
				</div>
