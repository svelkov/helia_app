package finansijsko

import (
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
	"helia/frontend/components"
)

templ SaldaMain(tabs domain.TabData, tbl domain.TableData, btnPrint, btnObrada domain.Button, total domain.SaldaDto, saldaURLtotals string, translator *i18n.Service) {
	<!-- Tab Content -->
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@SaldaPojedinacnihKonta(tabs, tbl, btnObrada, btnPrint, total, saldaURLtotals, translator)
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleDblClickKontoSelectionScript()
	@components.SpinnerScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.OpenPrintWithParamsScript()
	@tmpl.CloseDialogScript()
}

// Tab 1 - Salda pojedinačnih konta
templ SaldaPojedinacnihKonta(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, total domain.SaldaDto, saldaURLtotals string, translator *i18n.Service) {
	<!-- Tab Navigation -->
	<div class="bg-blue-100 border-b border-blue-600">
		@tmpl.TabNav(translator.Title("Salda konta"), tabs, "#tab-content", "salda-panel", translator)
	</div>
	<!-- Tab Content -->
	<div id="tab1">
		<!-- Main Grid - Two columns 1/2 to 1/2 -->
		<div class="grid grid-cols-2 gap-1">
			<!-- Left Column - Parameters -->
			<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 p-1 rounded-lg flex flex-col">
				<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
					{ translator.Text("Parametri") }
				</div>
				<!-- Radio Buttons -->
				<div class="flex items-center gap-3 mb-2">
					<label class="flex items-center gap-1">
						<input id="sintetika" type="radio" name="tipkonta" value="3" checked class="h-4 w-4 rounded border-blue-400 text-blue-600 focus:ring-blue-500"/>
						<span class="text-sm text-gray-700">{ translator.Label("Sintetika") }</span>
					</label>
					<label class="flex items-center gap-1">
						<input id="subsintetika" type="radio" name="tipkonta" value="2" class="h-4 w-4 rounded border-blue-400 text-blue-600 focus:ring-blue-500"/>
						<span class="text-sm text-gray-700">{ translator.Label("Subsintetika") }</span>
					</label>
					<label class="flex items-center gap-1">
						<input id="analitika" type="radio" name="tipkonta" value="1" class="h-4 w-4 rounded border-blue-400 text-blue-600 focus:ring-blue-500"/>
						<span class="text-sm text-gray-700">{ translator.Label("Analitika") }</span>
					</label>
				</div>
				<!-- Konto Field -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "konto",
						LabelText:  translator.Label("Konto"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:           "konto",
						Name:         "konto",
						FieldType:    "text",
						Disabled:     false,
						ClassInput:   common.ClassInputTextEnabled + " w-24",
						BlurEndpoint: "api/fkpl/trazikonto",
						HxTarget:     "kontonaziv",
						HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": getVkontaValue(), "destfield": "konto"}`,
						HxInclude:    "this",
						MinLength:    "2",
						MaxLength:    "6",
						TabIndex:     "1",
						OnInput:      "clearFieldError",
						OnFocus:      "clearFieldError"})
					@components.SearchButton(domain.SearchButtonConfig{
						ID:          "konto",
						Name:        "search-konto",
						HxUrl:       "/api/promet/searchbutton",
						HxTarget:    "#search-dropdown",
						HxSwap:      "innerHTML",
						HxVals:      `js:{"vkonta": getVkontaValue(), "destfield": "konto"}`,
						ClassButton: common.ClassButton,
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "kontonaziv",
						Name:       "kontonaziv",
						FieldType:  "text",
						Disabled:   true,
						ClassInput: common.ClassInputTextEnabled + " w-full",
						TabIndex:   "-1",
					})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "sifra",
						LabelText:  translator.Label("Sifra"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:           "sifra",
						Name:         "sifra",
						FieldType:    "text",
						Disabled:     true,
						ClassInput:   common.ClassInputTextEnabled + " w-24",
						BlurEndpoint: "api/fkpl/trazikonto",
						HxTarget:     "sifranaziv",
						HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('sifra').value, "vkonta": "1", "destfield": "sifra"}`,
						HxInclude:    "this",
						MinLength:    "2",
						MaxLength:    "6",
						TabIndex:     "2",
						OnInput:      "clearFieldError",
						OnFocus:      "clearFieldError"})
					@components.SearchButton(domain.SearchButtonConfig{
						ID:          "sifra",
						Name:        "search-sifra",
						HxUrl:       "/api/promet/searchbutton",
						HxTarget:    "#search-dropdown",
						HxSwap:      "innerHTML",
						Disabled:    true,
						HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "sifra"}`,
						ClassButton: common.ClassButton + " cursor-not-allowed",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "sifranaziv",
						Name:       "sifranaziv",
						FieldType:  "text",
						Disabled:   true,
						ClassInput: common.ClassInputTextEnabled + " w-full",
						TabIndex:   "-1",
					})
				</div>
				<!-- Obradi Button -->
				<div class="flex justify-end gap-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
				<div class="border mt-auto mb-1 bg-blue-100 border border-blue-400 mt-2 p-1 rounded-lg">
					@SaldaTotalValues(total, saldaURLtotals, translator)
				</div>
			</div>
			<!-- Right Column - Monthly Data Table -->
			<div class="border bg-blue-100 border border-blue-400 mt-1 mb-1 rounded-lg flex flex-col">
				<div class="text-blue-800 font-bold text-xs p-1 mb-1">
					{ translator.Text("Mesečna salda") }
				</div>
				<!-- Monthly Data Table -->
				<div class="border bg-blue-100 rounded-lg p-1 flex flex-col min-h-0 overflow-hidden flex-1 relative">
					@components.LoadingSpinner()
					<div class="flex-1 overflow-y-auto">
						@components.Table(tbl, translator)
					</div>
				</div>
			</div>
		</div>
		<!-- Chart Section -->
		<div class="border bg-blue-50 border border-blue-400 p-1 rounded-lg">
			<div class="text-blue-800 font-bold text-xs mb-1">
				{ translator.Text("Prikaz salda") }
			</div>
			<div id="saldachart-container" class="flex-1 min-h-80 bg-white rounded border border-gray-300 p-2">
				<canvas id="saldachart"></canvas>
			</div>
		</div>
	</div>
	@ChartScript()
}

// Tab 2 - Salda grupe konta
templ SaldaGrupeKonta(tabs domain.TabData, tbl domain.TableData, btnObrada, btnPrint domain.Button, monthsComboItems []domain.ComboItem, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Salda konta"), tabs, "#tab-content", "salda-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab2" class="flex-1 min-h-0 flex flex-col gap-1">
			<!-- Main Grid - Two columns -->
			<div class="grid grid-cols-2 gap-1">
				<!-- Left Column - Parameters -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1">
						{ translator.Text("Parametri") }
					</div>
					<!-- Počev od konta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odkonta",
							LabelText:  translator.Label("Od Konta"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "odkonta",
							Name:         "odkonta",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-20",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odkontanaziv",
							HxVals:       `js:{"konto": document.getElementById('odkonta').value, "vkonta": "2", "destfield": "odkonta"}`,
							HxInclude:    "this",
							Value:        "0000",
							MaxLength:    "6",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-odkonta",
							Name:        "search-odkonta",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "odkonta"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odkontanaziv",
							Name:       "odkontanaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-full",
							TabIndex:   "-1",
						})
					</div>
					<!-- Zakljucno sa kontom -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dokonta",
							LabelText:  translator.Label("Do Konta"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "dokonta",
							Name:         "dokonta",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-20",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dokontanaziv",
							HxVals:       `js:{"konto": document.getElementById('dokonta').value, "vkonta": "2", "destfield": "dokonta"}`,
							HxInclude:    "this",
							Value:        "999999",
							MaxLength:    "6",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-dokonta",
							Name:        "search-dokonta",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "dokonta"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dokontanaziv",
							Name:       "dokontanaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-full",
							TabIndex:   "-1",
						})
					</div>
					<!-- Počev od šifre -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odsifre",
							LabelText:  translator.Label("Počev od šifre"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "odsifre",
							Name:         "odsifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-20",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "odsifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('odsifre').value, "vkonta": "1", "destfield": "odsifre"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							Value:        "00",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-odsifre",
							Name:        "search-odsifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "odsifre"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odsifrenaziv",
							Name:       "odsifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Zakljucno sa šifrom -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dosifre",
							LabelText:  translator.Label("Zakljucno sa šifrom"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "dosifre",
							Name:         "dosifre",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-20",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "dosifrenaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "sifra": document.getElementById('dosifre').value, "vkonta": "1", "destfield": "dosifre"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "2",
							Value:        "999999",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-dosifre",
							Name:        "search-dosifre",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `js:{"konto": document.getElementById('konto').value, "vkonta": "1", "destfield": "dosifre"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dosifrenaziv",
							Name:       "dosifrenaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<!-- Checkbox: Prikaz salda po valutama -->
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "chk_salda_valute",
						Name:              "chk_salda_valute",
						LabelText:         "Prikaz salda po valutama",
						IsChecked:         false,
						ClassLabel:        common.ClassCheckboxLabel + " mt-1",
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
					}, translator)
				</div>
				<!-- Right Column - Report Type Selection -->
				<div class="border bg-blue-100 border border-blue-400 mt-1 p-1 rounded-lg flex flex-col">
					<!-- Tip izveštaja -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "cbx_tipizvestaja",
							LabelText:  translator.Label("Tip izveštaja"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:          "cbx_tipizvestaja",
							Name:        "cbx_tipizvestaja",
							Placeholder: "",
							HasLabel:    false,
							Disabled:    false,
							ClassSelect: common.ClassSelect + " w-full",
							OptionValues: []domain.ComboItem{
								{Key: "analitika", Value: "Salda grupe konta (analitika)"},
								{Key: "subsintetika", Value: "Salda grupe konta (subsintetika)"},
								{Key: "sintetika", Value: "Salda grupe konta (sintetika)"},
								{Key: "klasa_sifra", Value: "Prikaz klase po šifri/kontu"},
								{Key: "klasa_subsintetika", Value: "Prikaz klase po subsintetičkom kontu"},
							},
						}, translator)
					</div>
					<!-- Izbor klase -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "cbx_klasa",
							LabelText:  translator.Label("Izbor klase"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "cbx_klasa",
							Name:         "cbx_klasa",
							Placeholder:  "",
							HasLabel:     false,
							Disabled:     true,
							ClassSelect:  common.ClassSelect + " w-full",
							OptionValues: []domain.ComboItem{},
						}, translator)
					</div>
					<!-- Od meseca -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "cbx_odmeseca",
							LabelText:  translator.Label("Od meseca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "cbx_odmeseca",
							Name:          "cbx_odmeseca",
							Placeholder:   "",
							HasLabel:      false,
							Disabled:      false,
							ClassSelect:   common.ClassSelect + " w-40",
							OptionValues:  monthsComboItems,
							SelectedValue: "1",
						}, translator)
					</div>
					<!-- Do meseca -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "cbx_domeseca",
							LabelText:  translator.Label("Do meseca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "cbx_domeseca",
							Name:          "cbx_domeseca",
							Placeholder:   "",
							HasLabel:      false,
							Disabled:      false,
							ClassSelect:   common.ClassSelect + " w-40",
							OptionValues:  monthsComboItems,
							SelectedValue: "12",
						}, translator)
					</div>
					<!-- Od salda -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odsalda",
							LabelText:  translator.Label("Od salda"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odsalda",
							Name:       "odsalda",
							FieldType:  "number",
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-40",
							Value:      "0",
						})
					</div>
					<!-- Do salda -->
					<div class="flex items-center gap-1 mb-2">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dosalda",
							LabelText:  translator.Label("Do salda"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dosalda",
							Name:       "dosalda",
							FieldType:  "number",
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-40",
							Value:      "0",
						})
					</div>
					<!-- Saldo filter radio set -->
					<div class="flex items-center gap-2 mb-2">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "saldo_filter_label",
							LabelText:  translator.Label("Prikaz salda"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						<div class="flex items-center gap-3">
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "saldo_filter_sva_salda",
								Name:       "saldo_filter",
								Value:      "sva_salda",
								LabelText:  "sva_salda",
								IsSelected: true,
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "saldo_filter_razl_nula",
								Name:       "saldo_filter",
								Value:      "razl_nula",
								LabelText:  "saldo_<>_0",
								IsSelected: false,
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "saldo_filter_vece_nula",
								Name:       "saldo_filter",
								Value:      "vece_nula",
								LabelText:  "saldo_>_0",
								IsSelected: false,
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "saldo_filter_manje_nula",
								Name:       "saldo_filter",
								Value:      "manje_nula",
								LabelText:  "saldo_<_0",
								IsSelected: false,
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:         "saldo_filter_nula",
								Name:       "saldo_filter",
								Value:      "nula",
								LabelText:  "saldo_=_0",
								IsSelected: false,
							}, translator)
						</div>
					</div>
					<!-- Obradi and Print Buttons -->
					<div class="flex justify-end gap-1">
						@components.FormObradaButton(btnObrada, translator)
						@components.PrintButton(btnPrint, translator)
					</div>
				</div>
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
	<script>
		(function() {
			function setField(id, enabled) {
				const el = document.getElementById(id);
				if (!el) return;
				el.disabled = !enabled;
				['!bg-gray-300', 'text-gray-500', 'cursor-not-allowed', 'opacity-75'].forEach(c => el.classList.toggle(c, !enabled));
			}
			function setBtn(name, enabled) {
				const el = document.querySelector('[name="' + name + '"]');
				if (!el) return;
				el.disabled = !enabled;
				['!bg-gray-300', 'text-gray-500', 'cursor-not-allowed', 'opacity-75'].forEach(c => el.classList.toggle(c, !enabled));
			}
			function applyTipIzvestaja(val) {
				const kontoOn  = val === 'analitika' || val === 'subsintetika' || val === 'sintetika';
				const sifreOn  = val === 'analitika' || val === 'klasa_sifra';
				const klasaOn  = val === 'klasa_sifra' || val === 'klasa_subsintetika';
				setField('odkonta',  kontoOn);  setBtn('search-odkonta',  kontoOn);
				setField('dokonta',  kontoOn);  setBtn('search-dokonta',  kontoOn);
				setField('odsifre',  sifreOn);  setBtn('search-odsifre',  sifreOn);
				setField('dosifre',  sifreOn);  setBtn('search-dosifre',  sifreOn);
				setField('cbx_klasa', klasaOn);
			}
			function applySaldoFilter(val) {
				const saldoOn = val === 'vece_nula' || val === 'manje_nula';
				setField('odsalda', saldoOn);
				setField('dosalda', saldoOn);
				const od = document.getElementById('odsalda');
				const dod = document.getElementById('dosalda');
				if (!od || !dod) return;
				if (val === 'vece_nula') {
					od.value  = '0.01';
					dod.value = '9999999999999.99';
				} else if (val === 'manje_nula') {
					od.value  = '-9999999999999.99';
					dod.value = '-0.01';
				} else {
					od.value  = '0';
					dod.value = '0';
				}
			}
			function init() {
				const sel = document.getElementById('cbx_tipizvestaja');
				if (!sel) return;
				sel.addEventListener('change', function() { applyTipIzvestaja(this.value); });
				applyTipIzvestaja(sel.value);
				document.querySelectorAll('input[name="saldo_filter"]').forEach(function(r) {
					r.addEventListener('change', function() { applySaldoFilter(this.value); });
				});
				const checked = document.querySelector('input[name="saldo_filter"]:checked');
				applySaldoFilter(checked ? checked.value : '');
			}
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', init);
			} else {
				init();
			}
		})();
	</script>
}

// Tab 3 - Salda partneri
templ SaldaPartneri(tabs domain.TabData, tblPartneri domain.TableData, inputControl domain.InputControl, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="flex flex-col h-full">
		<!-- Tab Navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Salda konta"), tabs, "#tab-content", "salda-panel", translator)
		</div>
		<!-- Tab Content -->
		<div id="tab3" class="flex-1 min-h-0">
			<!-- Main Grid - Two columns 1/2 to 1/2 with full height -->
			<div class="grid grid-cols-2 gap-1 min-h-0 h-full">
				<!-- Left Column - Partner List (Full Height) -->
				<div class="border bg-blue-100 border border-blue-400 p-1 mt-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
					<div class="text-blue-800 font-bold text-xs mb-1 border-b border-gray-400 pb-1 flex-shrink-0 flex justify-between items-center">
						<span>{ translator.Title("Partneri") }</span>
					</div>
					@components.LoadingSpinner()
					@components.Search_Part(tblPartneri, inputControl)
					<!-- Partner Table - Constrained height with scrollbar -->
					<div class="flex-1 overflow-y-auto overflow-x-auto min-h-0">
						@components.Table(tblPartneri, translator)
					</div>
				</div>
				<!-- Right Column - Two Stacked Sections -->
				<div id="saldapartneri-detalji" class="flex flex-col h-full gap-1 overflow-hidden"></div>
				<div id="dialog-salda-partneri-stampa" class="flex flex-col h-full gap-1"></div>
			</div>
		</div>
	</div>
	<script>
		(function() {
			function clickFirstPartnerRow() {
				const firstRow = document.querySelector('#saldapartneri-table tbody tr');
				if (firstRow) firstRow.click();
			}
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function() { setTimeout(clickFirstPartnerRow, 300); });
			} else {
				setTimeout(clickFirstPartnerRow, 300);
			}
		})();
	</script>
}

templ SaldaPartneriStampaDialog(dialog domain.Dialog, btnPrint, btnCancel, btnClose domain.Button, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in w-auto min-w-[380px]">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- Content -->
			<div class="p-2 space-y-1">
				<!-- Checkboxes -->
				<div class="flex items-center gap-2">
					<input type="checkbox" id="stampaj-detalje" name="stampajdetalje" class="h-4 w-4"/>
					<label for="stampaj-detalje" class="text-sm">{ translator.Label("Stampaj detalje") }</label>
				</div>
				<div class="flex items-center gap-2 pb-4">
					<input type="checkbox" id="novi-partner-nova-strana" name="novipartnernova" class="h-4 w-4"/>
					<label for="novi-partner-nova-strana" class="text-sm">{ translator.Label("Novi partner nova strana") }</label>
				</div>
				<!-- Sifra Range -->
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "odsifre",
						LabelText:  translator.Label("Počev od sifre"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "odsifre",
						Name:       "odsifre",
						FieldType:  "text",
						Disabled:   false,
						ClassInput: common.ClassInputTextEnabled + " w-24",
						Value:      "00",
						MaxLength:  "6",
						OnFocus:    "clearFieldError",
						OnInput:    "clearFieldError",
					})
				</div>
				<div class="flex items-center gap-1 pb-4">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dosifre",
						LabelText:  translator.Label("Zaključno sa sifrom"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dosifre",
						Name:       "dosifre",
						FieldType:  "text",
						Disabled:   false,
						ClassInput: common.ClassInputTextEnabled + " w-24",
						Value:      "999999",
						MaxLength:  "6",
						OnFocus:    "clearFieldError",
						OnInput:    "clearFieldError",
					})
				</div>
			</div>
			<!-- Buttons -->
			<div class="flex justify-end gap-1 px-4 pb-4">
				@components.Search_PartPrintButton(btnPrint)
				@components.CancelButton(btnCancel, translator)
			</div>
		</div>
	</div>
}

