templ ChartScript() {
	<script>
		let saldaChartInstance = null;

		// Helper function to get vkonta value based on radio selection
		function getVkontaValue() {
			const checkedRadio = document.querySelector('input[name="tipkonta"]:checked');
			if (!checkedRadio) return '';
			
			// Map radio values to vkonta values
			const valueMap = {
				'1': '2',  // Analitika → 2
				'2': '2',  // Subsintetika → 2
				'3': '3'   // Sintetika → 3
			};
			
			return valueMap[checkedRadio.value] || checkedRadio.value;
		}

		function initializeSaldaChart() {
			const ctx = document.getElementById('saldachart');
			if (!ctx) return;

			// Get table data from the page - find the table in tab1
			const months = [];
			const duguje = [];
			const potrazuje = [];
			const saldo = [];

			// Extract data from table rows in tab1
			const tab1 = document.getElementById('tab1');
			if (!tab1) return;
			
			const tableRows = tab1.querySelectorAll('table tbody tr');
			
			tableRows.forEach(row => {
				const cells = row.querySelectorAll('td');
				if (cells.length >= 4) {
					months.push(cells[0].textContent.trim());
					duguje.push(parseFloat(cells[1].textContent.replace(/,/g, '').replace(/\./g, '')) || 0);
					potrazuje.push(parseFloat(cells[2].textContent.replace(/,/g, '').replace(/\./g, '')) || 0);
					saldo.push(parseFloat(cells[3].textContent.replace(/,/g, '').replace(/\./g, '')) || 0);
				}
			});

			// Only create chart if we have data
			if (months.length === 0) {
				console.log('No data found for chart');
				return;
			}

			// Destroy previous chart instance if it exists
			if (saldaChartInstance) {
				saldaChartInstance.destroy();
			}

			// Create new chart
			saldaChartInstance = new Chart(ctx, {
				type: 'bar',
				data: {
					labels: months,
					datasets: [
						{
							label: 'Duguje',
							data: duguje,
							backgroundColor: 'rgba(59, 130, 246, 0.5)',
							borderColor: 'rgba(59, 130, 246, 1)',
							borderWidth: 1
						},
						{
							label: 'Potražuje',
							data: potrazuje,
							backgroundColor: 'rgba(34, 197, 94, 0.5)',
							borderColor: 'rgba(34, 197, 94, 1)',
							borderWidth: 1
						},
						{
							label: 'Saldo',
							data: saldo,
							backgroundColor: 'rgba(239, 68, 68, 0.5)',
							borderColor: 'rgba(239, 68, 68, 1)',
							borderWidth: 1
						}
					]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
						legend: {
							position: 'top',
						},
						title: {
							display: true,
							text: 'Salda konta'
						}
					},
					scales: {
						y: {
							beginAtZero: true
						}
					}
				}
			});
		}

		// Initialize chart when data changes (after obrada)
		document.addEventListener('htmx:afterSwap', function(evt) {
			const target = evt.detail.target;
			// Check if we're in tab1 or if table body was swapped
			if (target.id === 'tab1' || target.closest('table') || target.parentElement?.querySelector('table')) {
				setTimeout(initializeSaldaChart, 100);
			}
		    // Only auto-click first row on initial tab3 load, NOT on detail updates
		    if (target.id === 'tab3' && !target.dataset.initialized) {
				console.log('Selecting first row in saldapartneri-table after HTMX swap');
		    	target.dataset.initialized = 'true';
        	    setTimeout(() => {
            	    const firstRow = document.querySelector('#tab3 table tbody tr');
                	if (firstRow) firstRow.click();
            	}, 600);
        	}
		});

		// Enable/disable sifra field based on tipkonta selection
		function enableDisableField() {
			const checkedRadio = document.querySelector('input[name="tipkonta"]:checked');
			if (!checkedRadio) return;
			
			const isAnalitika = checkedRadio.value === '1';
			const sifraInput = document.getElementById('sifra');
			const sifraSearchBtn = document.querySelector('[name="search-sifra"]');
			
			if (sifraInput) {
				sifraInput.disabled = !isAnalitika;
				if (!isAnalitika) {
					sifraInput.value = '';
					const sifraNaziv = document.getElementById('sifranaziv');
					if (sifraNaziv) {
						sifraNaziv.value = '';
					}
				}
			}
			if (sifraSearchBtn) {
				sifraSearchBtn.disabled = !isAnalitika;
				sifraSearchBtn.classList.toggle('cursor-pointer', isAnalitika);
				sifraSearchBtn.classList.toggle('cursor-not-allowed', !isAnalitika);
			}
		}
		
		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
			initializeSaldaChart();
		});

		// Use event delegation for radio button changes
		document.addEventListener('change', function(evt) {
			if (evt.target.name === 'tipkonta') {
				enableDisableField();
			}
		});

		// Re-attach after HTMX swaps
		document.addEventListener('htmx:afterSwap', function(evt) {
			const targetId = evt.detail.target.id;
			if (targetId === 'tab1') {
				setTimeout(enableDisableField, 50);
			}
		});
	</script>
}
