templ ChartScript() {
	<script>
		let saldaChartInstance = null;

		// Helper function to get vkonta value based on radio selection
		function getVkontaValue() {
			const checkedRadio = document.querySelector('input[name="tipkonta"]:checked');
			if (!checkedRadio) return '';
			
			// Map radio values to vkonta values
			const valueMap = {
				'1': '2',  // Analitika → 2
				'2': '2',  // Subsintetika → 2
				'3': '3'   // Sintetika → 3
			};
			
			return valueMap[checkedRadio.value] || checkedRadio.value;
		}

		function initializeSaldaChart() {
			const ctx = document.getElementById('saldachart');
			if (!ctx) return;

			// Get table data from the page
			const months = [];
			const duguje = [];
			const potrazuje = [];
			const saldo = [];

			// Extract data from table rows
			const tableRows = document.querySelectorAll('#saldatable tbody tr');
			tableRows.forEach(row => {
				const cells = row.querySelectorAll('td');
				if (cells.length >= 4) {
					months.push(cells[0].textContent.trim());
					duguje.push(parseFloat(cells[1].textContent.replace(/,/g, '')) || 0);
					potrazuje.push(parseFloat(cells[2].textContent.replace(/,/g, '')) || 0);
					saldo.push(parseFloat(cells[3].textContent.replace(/,/g, '')) || 0);
				}
			});

			// Destroy previous chart instance if it exists
			if (saldaChartInstance) {
				saldaChartInstance.destroy();
			}

			// Create new chart
			saldaChartInstance = new Chart(ctx, {
				type: 'bar',
				data: {
					labels: months,
					datasets: [
						{
							label: 'Duguje',
							data: duguje,
							backgroundColor: 'rgba(59, 130, 246, 0.5)',
							borderColor: 'rgba(59, 130, 246, 1)',
							borderWidth: 1
						},
						{
							label: 'Potražuje',
							data: potrazuje,
							backgroundColor: 'rgba(34, 197, 94, 0.5)',
							borderColor: 'rgba(34, 197, 94, 1)',
							borderWidth: 1
						},
						{
							label: 'Saldo',
							data: saldo,
							backgroundColor: 'rgba(239, 68, 68, 0.5)',
							borderColor: 'rgba(239, 68, 68, 1)',
							borderWidth: 1
						}
					]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
						legend: {
							position: 'top',
						},
						title: {
							display: true,
							text: 'Salda konta'
						}
					},
					scales: {
						y: {
							beginAtZero: true
						}
					}
				}
			});
		}

		// Initialize chart when data changes (after obrada)
		document.addEventListener('htmx:afterSwap', function(evt) {
			console.log('HTMX afterSwap event detected for salda chart initialization: id', evt.detail.target.id);
			if (evt.detail.target.id === 'saldatable' || evt.detail.target.closest('#tab1')) {
				setTimeout(initializeSaldaChart, 100);
			}
		    if (evt.detail.target.id === 'tab-content' || evt.detail.target.id === 'saldapartneri-table' || evt.detail.target.closest('#tab3')) {
				console.log('Selecting first row in saldapartneri-table after HTMX swap');
        	    setTimeout(() => {
            	    const firstRow = document.querySelector('#saldapartneri-table tbody tr');
                	if (firstRow) firstRow.click();
            	}, 600);
        	}
		});

		// Enable/disable sifra field based on tipkonta selection
		function toggleSifraField() {
			const checkedRadio = document.querySelector('input[name="tipkonta"]:checked');
			if (!checkedRadio) return;
			
			const isAnalitika = checkedRadio.value === '1';
			const sifraInput = document.getElementById('sifra');
			const sifraSearchBtn = document.getElementById('btn-sifra');
			
			console.log('Toggle sifra - isAnalitika:', isAnalitika, 'sifraInput:', sifraInput, 'button:', sifraSearchBtn);
			
			if (sifraInput) {
				sifraInput.disabled = !isAnalitika;
				if (!isAnalitika) {
					sifraInput.value = '';
					const sifraNaziv = document.getElementById('sifranaziv');
					if (sifraNaziv) {
						sifraNaziv.value = '';
					}
				}
				console.log('sifra disabled set to:', sifraInput.disabled);
			}
			if (sifraSearchBtn) {
				sifraSearchBtn.disabled = !isAnalitika;
				console.log('search button disabled set to:', sifraSearchBtn.disabled);
			}
		}
		
		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
            console.log('Document loaded, initializing salda chart.');
			initializeSaldaChart();
			console.log('Salda chart initialized');
		});

		// Use event delegation for radio button changes
		document.addEventListener('change', function(evt) {
			if (evt.target.name === 'tipkonta') {
				console.log('Radio changed to:', evt.target.value);
				toggleSifraField();
			}
		});

		// Re-attach after HTMX swaps (single listener for all targets)
		document.addEventListener('htmx:afterSwap', function(evt) {
			console.log('HTMX afterSwap fired, target:', evt.detail.target.id);
			const targetId = evt.detail.target.id;
			if (targetId === 'saldatable') {
				setTimeout(initializeSaldaChart, 100);
			} else if (targetId === 'tab-content' || targetId === 'tab1') {
				console.log('Setting up sifra toggle after HTMX swap');
				setTimeout(toggleSifraField, 50);
			}
		});
	</script>
}
