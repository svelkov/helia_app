package templates

import (
	"fmt"
	"helia/internal/domain"
	"net/url"
	"strings"
	"helia/internal/i18n"
)

templ TopMenu(menuItems domain.MenuDataItems, currentMenu string, comboCompany, comboPoslGod, comboKar domain.ComboFieldConfig, translator *i18n.Service, lang string) {
	<div class="bg-gradient-to-r from-blue-900 to-blue-900 text-white shadow-xl shadow-blue-600/50">
		<nav class="flex flex-wrap">
			for _, item := range menuItems.MenuItems {
				<button
					id={ fmt.Sprintf("menu-%s", strings.ReplaceAll(strings.ToLower(item.Name), " ", "-")) }
					name={ translator.Menu(lang, item.Name) }
					hx-get={ fmt.Sprintf("/get-menu?menuName=%s", url.QueryEscape(item.Name)) }
					hx-trigger="click"
					hx-target="#side-menu"
					hx-swap="outerHTML"
					if item.Name == currentMenu {
						class="menu-btn px-2 py-2 font-medium border-r border-b rounded--t-md text-sm bg-white text-blue-800 focus:outline-none transition-colors duration-200"
					} else {
						class="menu-btn px-2 py-2 font-medium border-r border-b rounded-t-md text-sm focus:outline-none bg-blue-900 text-white transition-colors duration-200"
					}
					type="button"
					onclick="document.querySelectorAll('nav button').forEach(b => b.className = 'px-2 py-2 border-r border-b rounded-t-md font-medium text-sm bg-blue-900 text-white');
                this.className = 'px-2 py-2 border-r border-b rounded-t-md font-medium text-sm bg-white text-blue-800';"
				>
					{ item.DisplayName }
				</button>
			}
			<!-- Right-aligned Combo Boxes -->
			<div class="ml-auto flex items-center space-x-4 pr-4">
				<!-- Company Select -->
				<div class="flex items-center space-x-2">
					@ComboBoxField(comboCompany)
				</div>
				<!-- Poslovna Godina Select -->
				<div class="flex items-center space-x-2">
					@ComboBoxField(comboPoslGod)
				</div>
				<div class="flex items-center space-x-2">
					@ComboBoxField(comboKar)
				</div>
			</div>
		</nav>
	</div>
}
