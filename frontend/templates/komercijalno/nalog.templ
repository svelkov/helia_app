package komercijalno

import (
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	tmpl_robno "helia/frontend/templates/robno"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
	"strings"
)

//
// Nalozi za isporuku (the legacy pr_PorudzbenicaProdaja of the komercijalno with its stavke
// pr_PorudzbenicaProdaja_DETALJI, the porudžbenice od kupaca, opened from the menu): two main screens, the tabs
// "Pregled naloga za isporuku" (the first one) and "Pregled delimično realizovanih naloga" (KomPregled). "Dodaj" and
// "Izmeni" of the first one open the entry dialog of a nalog: the one of the profaktura (ProfakturaBody) with the fields
// only a nalog has (ProVarijanta): its profaktura, the bank of the payment of an izvoz, its status, the finansijsko
// stanje of the kupac and "Skidaj zalihe po starosti" of the stavke.
//

// NalogPregled renders a main screen (the tab of ui) with the scripts of the entry dialog.
templ NalogPregled(pui domain.KomPregledUI, tab string, magacini []domain.ComboItem, magaciniID int, tbl domain.TableData, search domain.InputControl, stavkeTbl domain.TableData, translator *i18n.Service) {
	@KomPregled(pui, "Nalozi za isporuku", tab, nil, magacini, 0, magaciniID, templ.NopComponent, tbl, search, stavkeTbl, translator)
	@tmpl_robno.RobnoFaktureScript()
	@tmpl.RestrictNumericInputScript()
	@proScript.Once() {
		@proScriptBody()
	}
	@nalScript.Once() {
		@nalScriptBody()
	}
}

var nalScript = templ.NewOnceHandle()

// NalogVarijanta is the entry dialog of the profaktura as the one of a nalog: its titles, the urls of its script (nui)
// and its own fields.
func NalogVarijanta(dok domain.KomNalogDokument, nui domain.KomNalogUI, translator *i18n.Service) ProVarijanta {
	return ProVarijanta{Naslov: "Nalozi za isporuku", StavkeNaslov: "Stavke naloga", NijeSacuvano: "Podaci o nalogu nisu sačuvani",
		Sacuvajte: "Sačuvajte podatke o nalogu da bi ste mogli da radite sa stavkama",
		Atributi:  templ.Attributes{"data-profaktura-url": nui.ProfakturaURL, "data-saldo-url": nui.SaldoURL},
		Dokument:  nalDokument(dok, translator), Uslovi: nalUslovi(dok, translator), Desno: nalSaldo(dok.Saldo, translator),
		Stavka: nalStavka(dok, translator)}
}

// nalDokument renders the profaktura of the nalog (the legacy EDT_PROFAKTURA with BTN_TraziPROFAK: the potvrđene
// profakture of its magacin; fixed once the nalog has one) with its datum.
templ nalDokument(dok domain.KomNalogDokument, translator *i18n.Service) {
	{{ d := dok.Dodatno }}
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "profakturaid", LabelText: translator.Label("Broj profakture"), ClassLabel: common.ClassLabel + " w-36"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "profakturaid-combo",
			Name:         "profakturaid",
			ValueID:      "profakturaid",
			Value:        proID(d.VrdokID),
			DisplayValue: porBroj(d.ProDokum),
			Placeholder:  "Pretraži po broju ili kupcu",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			ClassWrapper: common.ClassPrvoPolje,
			SearchURL:    "/api/search/profakture-potvrdjene",
			HxVals:       "js:{magaciniid: document.getElementById('magaciniid')?.value || ''}",
			OnSelect:     "komNalProfaktura",
			AllowEmpty:   true,
			HideDetails:  true,
			Disabled:     d.VrdokID > 0,
			TabIndex:     "4",
		}, translator)
		@porProcitano("datprofak", "Datum profakture", porNullDatum(d.ProDadok), common.ClassLabelDrugoPoljeSiroko, "flex-1 min-w-0", translator)
	</div>
}

// nalUslovi renders the bank of the payment of an izvoz (the legacy EDT_SIFBANK with f_Trazi_BNKIZV) and the status
// of the nalog.
templ nalUslovi(dok domain.KomNalogDokument, translator *i18n.Service) {
	{{ d := dok.Dodatno }}
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "bnkizvid", LabelText: translator.Label("Banka za uplatu - izvoz"), ClassLabel: common.ClassLabel + " w-36"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "bnkizvid-combo",
			Name:         "bnkizvid",
			ValueID:      "bnkizvid",
			Value:        proID(d.BnkizvID),
			DisplayValue: nalBanka(d),
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassWrapper: "relative flex-1 min-w-0",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			SearchURL:    "/api/search/banke-izvoz",
			AllowEmpty:   true,
			HideDetails:  true,
			TabIndex:     "15",
		}, translator)
	</div>
	<div class="flex items-center gap-1 min-w-0">
		@porProcitano("nalstatus", "Status dokumenta", strings.TrimSpace(nalStatus(dok)+" "+translator.Label(dok.StatusOpis)), common.ClassLabel+" w-36", "flex-1 min-w-0", translator)
	</div>
}

// nalSaldo renders the finansijsko stanje of the kupac (the legacy SaldoKUPCA): proknjiženo, neproknjiženo and ukupno.
templ nalSaldo(s domain.KomNalogSaldo, translator *i18n.Service) {
	<fieldset id="kom-nal-saldo" class="border border-blue-400 bg-blue-100 p-1 rounded-lg min-w-0">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Finansijsko stanje kupca") }</legend>
		<div class="grid grid-cols-[auto_minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-1">
			@nalIznos("nalsaldo-realizacija", "Proknjižena realiz.", s.Realizacija, translator)
			@nalIznos("nalsaldo-placeno", "Plaćeno", s.Placeno, translator)
			@nalIznos("nalsaldo-saldo", "Saldo", s.Saldo, translator)
			<span></span>
			<span></span>
			@nalIznos("nalsaldo-dospelo", "Dospelo", s.Dospelo, translator)
			@nalIznos("nalsaldo-nedospelo", "Nedospelo", s.Nedospelo, translator)
			@nalIznos("nalsaldo-realizacijarob", "Neproknjižena realiz.", s.RealizacijaRob, translator)
			@nalIznos("nalsaldo-dospelorob", "Dospelo", s.DospeloRob, translator)
			@nalIznos("nalsaldo-nedospelorob", "Nedospelo", s.NedospeloRob, translator)
			<span class="col-span-6 text-sm font-semibold text-blue-900">{ translator.Label("Ukupno") }:</span>
			@nalIznos("nalsaldo-ukdospelo", "Dospelo", s.UkDospelo, translator)
			@nalIznos("nalsaldo-uknedospelo", "Nedospelo", s.UkNedospelo, translator)
			@nalIznos("nalsaldo-uksaldo", "Saldo", s.UkSaldo, translator)
		</div>
	</fieldset>
}

// nalIznos renders a label with a read only amount of the finansijsko stanje of the kupac.
templ nalIznos(id, label string, iznos float64, translator *i18n.Service) {
	@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: translator.Label(label), ClassLabel: common.ClassLabel + " text-right"})
	@components.TextInputField(domain.InputFieldConfig{ID: id, FieldType: "text", Value: common.FormatNumberWithSystemLocale(iznos, 2), Disabled: true,
		ClassInput: common.ClassInputTextDisabled + " w-full min-w-0 text-right"})
}

// nalStavka renders "Skidaj zalihe po starosti" of a magacin with the lots (the legacy CBOX_ZALSTAROST, checked at the
// start): the količina of a new stavka is split over the lots, the oldest first.
templ nalStavka(dok domain.KomNalogDokument, translator *i18n.Service) {
	if dok.Header.Tipzal == 2 {
		@components.CheckboxField(domain.CheckboxFieldConfig{
			ID:                "postarosti",
			Name:              "postarosti",
			Value:             "true",
			IsChecked:         true,
			LabelText:         translator.Label("Skidaj zalihe po starosti"),
			ClassLabel:        common.ClassLabel + " flex items-center gap-1 mr-2",
			ClassCheckbox:     common.ClassCheckbox,
			ClassCheckboxSpan: "text-sm",
			TabIndex:          "-1"}, translator)
	}
}

// nalBanka is the text of the combo of the bank of the payment of an izvoz: "šifra - opis" ("" without one).
func nalBanka(d domain.KomNalogDodatno) string {
	if d.SifBank <= 0 {
		return ""
	}
	return strings.TrimSuffix(strconv.Itoa(d.SifBank)+" - "+d.BnkDes, " - ")
}

// nalStatus is the status of the nalog of the dialog (10 for a new one).
func nalStatus(dok domain.KomNalogDokument) string {
	if dok.Header.RdokID <= 0 || dok.Header.Doksts == "" {
		return domain.KomNalogNov
	}
	return dok.Header.Doksts
}
