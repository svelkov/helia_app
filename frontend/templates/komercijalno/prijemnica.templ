package komercijalno

import (
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	tmpl_robno "helia/frontend/templates/robno"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
)

//
// Prijemnica materijala po porudžbenici (the legacy pr_PrijemnicaSIROVINE of the komercijalno, opened from the menu):
// the main screen is the pregled of the prijemnice (KomPregled without the vrsta: all the vrste of the prijemnice of
// the magacin, like the legacy tab "Pregled prijemnica"). "Dodaj" and "Izmeni" open the entry dialog of a prijemnica
// (KomDialog): the header and the stavke as the two collapsible controls of the faktura (RobnoFakturePanel and
// RobnoFaktureScript: the stavke are disabled until the header is saved), the stavke with the stavke of the
// porudžbenica ("Količine po porudžbenici"), "Pakovanje" and "Karton identifikacije".
//

// PrijemnicaPregled renders the main screen with the scripts of the entry dialog.
templ PrijemnicaPregled(pui domain.KomPregledUI, magacini []domain.ComboItem, magaciniID int, tbl domain.TableData, search domain.InputControl, stavkeTbl domain.TableData, translator *i18n.Service) {
	@KomPregled(pui, "Prijemnica materijala po porudžbenici", "Pregled prijemnica", nil, magacini, 0, magaciniID, templ.NopComponent, tbl, search, stavkeTbl, translator)
	@tmpl_robno.RobnoFaktureScript()
	@tmpl.RestrictNumericInputScript()
	@prijScript.Once() {
		@prijScriptBody()
	}
}

var prijScript = templ.NewOnceHandle()

// PrijemnicaDialog renders the entry dialog of a prijemnica ("Dodaj" and "Izmeni" of the main screen).
templ PrijemnicaDialog(ui domain.RobnoFaktureUI, kui domain.KomPrijUI, dok domain.KomPrijDokument, izvori, tbl domain.TableData, btns domain.RobnoFaktureButtons, dugmad domain.KomPrijButtons, btnClose domain.Button, translator *i18n.Service, csrfToken string) {
	@KomDialog(ui.DialogID, translator.Title("Prijemnica materijala po porudžbenici"), ui.InfoID, btnClose, csrfToken, PrijemnicaBody(ui, kui, dok, izvori, tbl, btns, dugmad, translator))
}

// PrijemnicaBody renders the content of the entry dialog: "Štampa" and "Nazad", the header control and the stavke
// control.
templ PrijemnicaBody(ui domain.RobnoFaktureUI, kui domain.KomPrijUI, dok domain.KomPrijDokument, izvori, tbl domain.TableData, btns domain.RobnoFaktureButtons, dugmad domain.KomPrijButtons, translator *i18n.Service) {
	<div
		id={ ui.BodyID }
		data-stavke-aktivne={ strconv.FormatBool(dok.Header.Snimljen) }
		data-novi-url={ ui.NoviURL }
		data-ima-stavke={ strconv.FormatBool(dok.ImaStavke) }
		data-rdokid={ strconv.FormatInt(dok.Header.RdokID, 10) }
		class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0"
	>
		<div class="flex items-center gap-2 border border-blue-400 bg-blue-100 rounded-lg px-1 py-0.5">
			<span class={ "font-bold text-sm text-red-700", templ.KV("hidden", !dok.Header.Storno) }>{ translator.Label("STORNO DOKUMENT") }</span>
			<!-- "Štampa" of the prijemnica (the legacy BTN_Print4) before "Nazad" -->
			<div class="ml-auto flex items-center gap-1">
				if dugmad.Stampa.Id != "" {
					@components.Search_PartPrintButton(dugmad.Stampa)
				}
				@components.Button(btns.Back)
			</div>
		</div>
		@tmpl_robno.RobnoFakturePanel(ui.HeaderPanelID, translator.Label("Podaci o dokumentu"), prijHeaderStanje(dok.Header.Snimljen, translator), !dok.Header.Snimljen, !dok.Header.Snimljen, false, btns.Save.Id, tmpl_robno.RobnoFaktureIzmeniZaglavlje(btns.Modify, dok.Header.Snimljen), prijHeaderFields(dok, translator), porHeaderButtons(btns, dugmad.Potvrda))
		@tmpl_robno.RobnoFakturePanel(ui.StavkePanelID, translator.Label("Stavke prijemnice"), prijStavkeStanje(dok.Header.Snimljen, translator), dok.Header.Snimljen, dok.Header.Snimljen, true, btns.SaveStavka.Id, templ.NopComponent, prijStavkeFields(ui, kui, dok, izvori, tbl, btns, dugmad, translator), templ.NopComponent)
		<!-- The dialogs of the stavke -->
		<div id={ ui.StavkaInfoID } class="contents"></div>
	</div>
}

// prijHeaderFields renders the fields of the header in the groups of the legacy window: on the left the podaci o
// dokumentu (the org. jedinica and the mesto troška of the porudžbenica; the vrsta and the magacin, fixed for a saved
// prijemnica; the porudžbenica with its search and datum, fixed for a saved prijemnica; the broj and the datum of the
// prijemnica), on the right the podaci o dobavljaču of the porudžbenica (read only).
templ prijHeaderFields(dok domain.KomPrijDokument, translator *i18n.Service) {
	{{ h := dok.Header }}
	{{ sacuvan := h.RdokID > 0 }}
	<input type="hidden" name="rdokid" value={ strconv.FormatInt(h.RdokID, 10) }/>
	<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-1">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg min-w-0">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
			<div class="flex flex-col gap-y-1">
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("prijoj", "OJ", h.OrgjedText, common.ClassLabel+" w-36", "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("prijmt", "Mesto troška", h.MestoTroskaText, common.ClassLabel+" w-36", "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "vrd", LabelText: translator.Label("Vrsta dokumenta"), ClassLabel: common.ClassLabel + " w-36"})
					@components.ComboBoxField(domain.ComboFieldConfig{ID: "vrd", Name: "vrd", Disabled: sacuvan, ClassSelect: common.ClassInputTextEnabled + " flex-1 min-w-0",
						OptionValues: dok.Vrste, SelectedValue: strconv.Itoa(h.Vrd), TabIndex: "1"}, translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "magaciniid", LabelText: translator.Label("Magacin"), ClassLabel: common.ClassLabel + " w-36"})
					@components.ComboBoxField(domain.ComboFieldConfig{ID: "magaciniid", Name: "magaciniid", Disabled: sacuvan, ClassSelect: common.ClassInputTextEnabled + " flex-1 min-w-0",
						OptionValues: dok.Magacini, SelectedValue: strconv.Itoa(h.MagaciniID), TabIndex: "2"}, translator)
				</div>
				<!-- The potvrđena porudžbenica of the magacin (the legacy BTN_TraziDOK): a selected one gives a new
				     prijemnica with its data; fixed for a saved prijemnica -->
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "vrdokid", LabelText: translator.Label("Broj porudžbenice"), ClassLabel: common.ClassLabel + " w-36"})
					@components.TableCombo(domain.TableComboConfig{
						ID:           "vrdokid-combo",
						Name:         "vrdokid",
						ValueID:      "vrdokid",
						Value:        zahtevID(h.VrdokID),
						DisplayValue: porBroj(h.VezaDokum),
						Placeholder:  "Pretraži po broju ili tekstu",
						ClassInput:   common.ClassInputTextEnabled + " w-full",
						ClassWrapper: common.ClassPrvoPolje,
						SearchURL:    "/api/search/porudzbenice-potvrdjene",
						HxVals:       "js:{magaciniid: document.getElementById('magaciniid').value}",
						OnSelect:     "komPrijVeza",
						AllowEmpty:   true,
						Disabled:     sacuvan,
						TabIndex:     "3",
					}, translator)
					@components.LabelField(domain.LabelFieldConfig{ID: "vezadatum", LabelText: translator.Label("Datum porudžbenice"), ClassLabel: common.ClassLabelDrugoPoljeSiroko})
					@components.TextInputField(domain.InputFieldConfig{ID: "vezadatum", FieldType: "text", Value: porNullDatum(h.VezaDatum), Disabled: true,
						ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "brdok", LabelText: translator.Label("Broj prijemnice"), ClassLabel: common.ClassLabel + " w-36"})
					<!-- The broj of the prijemnica (the next one of the vrsta in the magacin, given at the save) -->
					@components.TextInputField(domain.InputFieldConfig{ID: "brdok", FieldType: "text", Value: strconv.Itoa(h.Dokum), Disabled: true,
						ClassInput: common.ClassInputTextDisabled + " " + common.ClassPrvoPolje + " text-right"})
					@components.LabelField(domain.LabelFieldConfig{ID: "datum", LabelText: translator.Label("Datum prijemnice"), ClassLabel: common.ClassLabelDrugoPoljeSiroko})
					@components.TextInputField(domain.InputFieldConfig{ID: "datum", Name: "datum", FieldType: "date", Value: prijDatum(h), TabIndex: "4",
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0", OnInput: "clearFieldError", OnFocus: "clearFieldError"})
				</div>
			</div>
		</fieldset>
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg min-w-0">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dobavljaču") }</legend>
			<div class="flex flex-col gap-y-1">
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("prijfkto", "Konto dobavljača", h.Fkto, common.ClassLabel+" w-36", common.ClassPrvoPolje, translator)
					@porProcitano("prijfana", "Analitička šifra", h.Fana, common.ClassLabelDrugoPoljeSiroko, "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("dobnaziv", "Naziv dobavljača", h.Dobavljac.Naziv, common.ClassLabel+" w-36", "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("dobadresa", "Adresa", h.Dobavljac.Adresa, common.ClassLabel+" w-36", "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("dobpobro", "Poštanski broj", h.Dobavljac.Pobro, common.ClassLabel+" w-36", common.ClassPrvoPolje, translator)
					@porProcitano("dobmesto", "Mesto", h.Dobavljac.Mesto, common.ClassLabelDrugoPoljeSiroko, "flex-1 min-w-0", translator)
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@porProcitano("dobpib", "PIB", h.Dobavljac.Pib, common.ClassLabel+" w-36", common.ClassPrvoPolje, translator)
					@porProcitano("dobpdv", "Sistem PDV-a", translator.Label(h.Dobavljac.SistemPdv), common.ClassLabelDrugoPoljeSiroko, "flex-1 min-w-0", translator)
				</div>
			</div>
		</fieldset>
	</div>
}

// prijStavkeFields is the body of the stavke control: the stavke of the porudžbenica (the legacy "Količine po
// porudžbenici") with "Dodaj", "Dodaj sve", "Vrati poslednju" and "Vrati sve", the entry of a stavka (the redni broj,
// the konto of the magacin, the šifra artikla with its search, its naziv and JM, the količina na dokumentu, the
// primljena količina, the serija and the OTK), its buttons with "Pakovanje" and "Karton identifikacije", and the grid
// of the stavke ("Izmeni" and "Obriši" of every row; a click of a row selects it for the karton).
templ prijStavkeFields(ui domain.RobnoFaktureUI, kui domain.KomPrijUI, dok domain.KomPrijDokument, izvori, tbl domain.TableData, btns domain.RobnoFaktureButtons, dugmad domain.KomPrijButtons, translator *i18n.Service) {
	if dok.Header.VrdokID > 0 {
		<!-- The stavke of the porudžbenica: a click of a row selects it for "Dodaj" -->
		<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col max-h-48 min-h-[6rem] overflow-hidden">
			<div class="flex items-center gap-1">
				<span class="font-semibold text-sm text-blue-900 px-1">{ translator.Label("Količine po porudžbenici") }</span>
				<input type="hidden" id={ kui.IzvorID } name={ kui.IzvorID } value=""/>
				<div class="ml-auto flex items-center gap-1">
					@components.Button(dugmad.Dodaj)
					@components.Button(dugmad.DodajSve)
					@components.Button(dugmad.VratiPoslednju)
					@components.Button(dugmad.VratiSve)
				</div>
			</div>
			<div class="flex-1 min-h-0 overflow-auto">
				@components.Table(izvori, translator)
			</div>
		</div>
	}
	<fieldset
		id="kom-prij-stavka"
		class="border border-blue-400 bg-blue-100 p-1 rounded-lg"
		data-artikal-url={ ui.ArtikalURL }
		data-novi-rbr={ strconv.Itoa(dok.NoviRbr) }
		data-konto={ prijPrviKonto(dok.Konta) }
	>
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(dok.Header.RdokID, 10) }/>
		<input type="hidden" id="stavkarproid" name="rproid" value="0"/>
		<div class="flex flex-col gap-1">
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "stavkarbr", LabelText: translator.Label("Red. br."), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "stavkarbr", FieldType: "text", Value: strconv.Itoa(dok.NoviRbr), Disabled: true,
					ClassInput: common.ClassInputTextDisabled + " !w-14 text-right"})
				@components.LabelField(domain.LabelFieldConfig{ID: "konto", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.ComboBoxField(domain.ComboFieldConfig{ID: "konto", Name: "konto", ClassSelect: common.ClassInputTextEnabled + " !w-24",
					OptionValues: dok.Konta, SelectedValue: prijPrviKonto(dok.Konta), TabIndex: "1"}, translator)
				@components.LabelField(domain.LabelFieldConfig{ID: "sifraartikla", LabelText: translator.Label("Šifra artikla"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TableCombo(domain.TableComboConfig{
					ID:           "sifraartikla-combo",
					Name:         "sifraartikla",
					ValueID:      "sifraartikla",
					Placeholder:  "Šifra, naziv ili barkod",
					ClassInput:   common.ClassInputTextEnabled + " w-full",
					ClassWrapper: "!w-32 shrink-0",
					SearchURL:    "/api/search/artikli-sirovine",
					FreeText:     true,
					HideDetails:  true,
					TabIndex:     "2",
				}, translator)
				@components.TextInputField(domain.InputFieldConfig{ID: "nazivartikla", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
				@components.TextInputField(domain.InputFieldConfig{ID: "jm", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-14"})
			</div>
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "trazkolic", LabelText: translator.Label("Količina na dokumentu"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "trazkolic", Name: "trazkolic", FieldType: "number", DecimalPlaces: 3, SelectOnFocus: true, Value: "0",
					MaxLength: "18", OnFocus: "clearFieldError", TabIndex: "3", ClassInput: common.ClassInputTextEnabled + " !w-28 text-right"})
				@components.LabelField(domain.LabelFieldConfig{ID: "kolic", LabelText: translator.Label("Primljena količina"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{ID: "kolic", Name: "kolic", FieldType: "number", DecimalPlaces: 3, SelectOnFocus: true, Value: "0",
					MaxLength: "18", OnFocus: "clearFieldError", TabIndex: "4", ClassInput: common.ClassInputTextEnabled + " !w-28 text-right"})
				@components.LabelField(domain.LabelFieldConfig{ID: "serija", LabelText: translator.Label("Serija"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{ID: "serija", Name: "serija", FieldType: "text", MaxLength: "15", OnFocus: "clearFieldError",
					TabIndex: "5", ClassInput: common.ClassInputTextEnabled + " !w-36"})
				@components.LabelField(domain.LabelFieldConfig{ID: "otk", LabelText: "OTK", ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{ID: "otk", Name: "otk", FieldType: "text", MaxLength: "15", TabIndex: "6",
					ClassInput: common.ClassInputTextEnabled + " !w-24"})
			</div>
		</div>
	</fieldset>
	<div class="flex items-center justify-end gap-1">
		<!-- The selected stavka of the grid ("Karton identifikacije") -->
		<input type="hidden" id={ kui.KartonID } name={ kui.KartonID } value=""/>
		if dugmad.Pakovanje.Id != "" {
			@components.Button(dugmad.Pakovanje)
		}
		if dugmad.Karton.Id != "" {
			@components.Search_PartPrintButton(dugmad.Karton)
		}
		@tmpl_robno.RobnoFaktureStavkeButtons(btns)
	</div>
	if tbl.TableID != "" {
		<div id="kom-prij-stavke-grid" class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// PrijemnicaPakovanja renders the dialog "Pakovanje" (the legacy pr_Pakovanja "Količine po pakovanju"): the stavke of the
// prijemnica with their pakovanje (a click of a row puts it in the form), the form of the pakovanje of the selected
// stavka (the količina po pakovanju and the broj pakovanja), "Sačuvaj" and "Nazad".
templ PrijemnicaPakovanja(dialog domain.Dialog, tbl domain.TableData, rdokID int64, btnSave, btnNazad, btnClose domain.Button, translator *i18n.Service) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-blue-100 rounded-lg shadow-2xl flex flex-col w-[70vw] max-h-[75vh]">
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg flex-shrink-0">
				<h2 class="text-lg font-semibold ml-4">{ translator.Label(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<div class="flex-1 min-h-0 overflow-auto p-2">
				@components.Table(tbl, translator)
			</div>
			<div id={ dialog.Id + "-forma" } class="flex items-center gap-1 p-2 border-t border-blue-300">
				<input type="hidden" name="rdokid" value={ strconv.FormatInt(rdokID, 10) }/>
				<input type="hidden" id="pakrproid" name="pakrproid" value=""/>
				@components.TextInputField(domain.InputFieldConfig{ID: "paknaziv", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
				@components.LabelField(domain.LabelFieldConfig{ID: "kolpopak", LabelText: translator.Label("Količina po pakovanju"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{ID: "kolpopak", Name: "kolpopak", FieldType: "number", DecimalPlaces: 3, SelectOnFocus: true, Value: "0",
					MaxLength: "18", ClassInput: common.ClassInputTextEnabled + " !w-28 text-right"})
				@components.LabelField(domain.LabelFieldConfig{ID: "brpak", LabelText: translator.Label("Broj pakovanja"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{ID: "brpak", Name: "brpak", FieldType: "number", DecimalPlaces: 0, SelectOnFocus: true, Value: "0",
					MaxLength: "9", ClassInput: common.ClassInputTextEnabled + " !w-20 text-right"})
				@components.Button(btnSave)
				@components.Button(btnNazad)
			</div>
		</div>
	</div>
}

// prijDatum is the datum of the prijemnica for the date field.
func prijDatum(h domain.KomPrijHeaderView) string {
	if h.Datum.IsZero() {
		return ""
	}
	return h.Datum.Format(common.HtmlLayout)
}

// prijPrviKonto is the first konto of the magacin, the default konto of a stavka (the legacy MAGKONTO of the magacin).
func prijPrviKonto(konta []domain.ComboItem) string {
	if len(konta) == 0 {
		return ""
	}
	return konta[0].Key
}

// prijHeaderStanje is the text of the title bar of the header control.
func prijHeaderStanje(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Podaci su sačuvani - koristite Izmeni za izmenu")
	}
	return translator.Label("Podaci o prijemnici nisu sačuvani")
}

// prijStavkeStanje is the text of the title bar of the stavke control: the stavke are available only after the header
// is saved.
func prijStavkeStanje(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Unos stavki je omogućen")
	}
	return translator.Label("Sačuvajte podatke o prijemnici da bi ste mogli da radite sa stavkama")
}
