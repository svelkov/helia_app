package opstipodaci

import (
	"fmt"
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

templ AddUpdateForm(csrfToken string, dialog domain.Dialog, fields []domain.Fields, btnSave, btnCancel, btnClose domain.Button, translator *i18n.Service) {
	<div
		id={ dialog.Id }
		role="dialog"
		aria-modal="true"
		class={ common.ClassMainDialogDiv }
		tabindex="-1"
	>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in max-w-full w-auto">
			<!-- Title Bar (Flush on Left, Top, Right) -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ dialog.Title }</h2>
				@components.CloseButton(btnClose)
			</div>
			<form
				id="dialog-form"
				if dialog.HxRequestType == "PUT" {
					hx-put={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'PUT', this.dataset.dialogId)"
				}
				if dialog.HxRequestType == "POST" {
					hx-post={ dialog.HxActionURL }
					hx-on::after-request="handleFormResponse(event, 'POST', this.dataset.dialogId)"
				}
				data-dialog-id={ dialog.Id }
				hx-target={ "#" + dialog.Id + "-message" }
				hx-boost="false"
				onsubmit="return false;"
				class="grid grid-cols-1 md:grid-cols-[auto,auto] gap-2 gap-x-4 p-3 bg-white shadow-lg rounded-lg w-auto"
			>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				for i, field  := range fields {
					<div class="flex flex-row items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         field.Name,
							LabelText:  translator.Label(field.Label),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         field.Name,
							Name:       field.Name,
							FieldType:  field.Type,
							TabIndex:   fmt.Sprintf("%d", i+1),
							Value:      field.Value,
							MaxLength:  field.MaxLength,
							ClassInput: common.ClassInputTextEnabled + field.ControlWidth,
						})
					</div>
				}
				<div class="bg-white col-span-2 px-3 py-3 flex items-center justify-end pt-4 gap-1">
					@components.SaveButton(btnSave, translator)
					@components.CancelButton(btnCancel, translator)
				</div>
			</form>
			<!-- Message Display Area at Bottom -->
			<div id={ dialog.Id + "-message" } class="hidden"></div>
		</div>
	</div>
	@tmpl.HandleFormResponseScript()
	@tmpl.CloseDialogScript()
	@DialogFocusTrapScript()
}

templ DialogFocusTrapScript() {
	<script>
		(function () {
			if (window.__dialogFocusTrapInitialized) return;
			window.__dialogFocusTrapInitialized = true;

			const DIALOG_SELECTOR = '[role="dialog"][aria-modal="true"]';
			const FOCUSABLE_SELECTOR = [
				'button:not([disabled])',
				'[href]:not([disabled])',
				'input:not([disabled]):not([type="hidden"])',
				'select:not([disabled])',
				'textarea:not([disabled])',
				'[tabindex]:not([tabindex="-1"]):not([disabled])'
			].join(', ');

			function isVisible(el) {
				if (!el) return false;
				const style = window.getComputedStyle(el);
				if (style.display === 'none' || style.visibility === 'hidden') return false;
				return el.getClientRects().length > 0;
			}

			function getFocusable(dialog) {
				return Array.from(dialog.querySelectorAll(FOCUSABLE_SELECTOR))
					.filter(isVisible)
					.sort((a, b) => {
						// Respect explicit positive tabindex ordering WITHIN the dialog only.
						const at = parseInt(a.getAttribute('tabindex') || '0', 10);
						const bt = parseInt(b.getAttribute('tabindex') || '0', 10);
						if (at > 0 && bt > 0 && at !== bt) return at - bt;
						if (at > 0 && bt <= 0) return -1;
						if (bt > 0 && at <= 0) return 1;
						return 0; // fall back to DOM order for tabindex 0 / default
					});
			}

			function getActiveDialog() {
				const dialogs = Array.from(document.querySelectorAll(DIALOG_SELECTOR)).filter(isVisible);
				return dialogs.length ? dialogs[dialogs.length - 1] : null;
			}

			// THE KEY FIX: make every sibling of the active dialog's top-level
			// container inert, so the browser's native Tab traversal (which is
			// what actually escapes with positive tabindex values) has nothing
			// outside the dialog to land on.
			function updateInertState() {
				const activeDialog = getActiveDialog();
				Array.from(document.body.children).forEach(function (child) {
					if (!activeDialog) {
						child.inert = false;
						return;
					}
					if (child === activeDialog || child.contains(activeDialog)) {
						child.inert = false;
					} else {
						child.inert = true;
					}
				});
			}

			function focusFirstField(dialog) {
				const focusable = getFocusable(dialog);
				if (focusable.length > 0) focusable[0].focus();
				else dialog.focus();
			}

			function primeNewDialogs(root) {
				(root || document).querySelectorAll(DIALOG_SELECTOR).forEach(function (dialog) {
					if (dialog.dataset.focusPrimed === 'true') return;
					dialog.dataset.focusPrimed = 'true';
					setTimeout(function () {
						updateInertState();
						if (isVisible(dialog)) focusFirstField(dialog);
					}, 50);
				});
			}

			// Wraparound is still needed even with inert, since Tab past the
			// last focusable element normally goes to the browser chrome, not
			// back to the first field.
			document.addEventListener('keydown', function (e) {
				const dialog = getActiveDialog();
				if (!dialog) return;

				const focusable = getFocusable(dialog);
				if (focusable.length === 0) return;

				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				const active = document.activeElement;

				if (e.key === 'Tab') {
					if (e.shiftKey && active === first) {
						e.preventDefault();
						last.focus();
					} else if (!e.shiftKey && active === last) {
						e.preventDefault();
						first.focus();
					}
					return;
				}

				if (e.key === 'Escape') {
					e.preventDefault();
					if (typeof closeDialog === 'function') closeDialog(dialog.id);
					return;
				}

				if (e.key === 'Enter') {
					const tag = (active.tagName || '').toLowerCase();
					if (tag === 'button' || tag === 'a') return;

					e.preventDefault();
					const inputs = focusable.filter(el => el.tagName === 'INPUT' && el.type !== 'hidden');
					if (inputs.length === 0) return;
					const idx = inputs.indexOf(active);
					const next = idx !== -1 ? inputs[(idx + 1) % inputs.length] : inputs[0];
					next.focus();
				}
			}, true);

			// Recompute inert state whenever the DOM changes (dialog opens/closes
			// via htmx swap, class toggle, etc.) — catches it regardless of how
			// your app shows/hides dialogs.
			const observer = new MutationObserver(function () {
				window.requestAnimationFrame(updateInertState);
				primeNewDialogs(document);
			});
			observer.observe(document.body, {
				childList: true,
				subtree: true,
				attributes: true,
				attributeFilter: ['class', 'style', 'hidden']
			});

			document.addEventListener('DOMContentLoaded', function () {
				primeNewDialogs(document);
				updateInertState();
			});
			document.body.addEventListener('htmx:afterSettle', function (e) {
				primeNewDialogs(e.target);
				updateInertState();
			});
			if (document.readyState !== 'loading') {
				primeNewDialogs(document);
				updateInertState();
			}
		})();
	</script>
}
