						@tmpl.TextInputField(domain.InputFieldConfig{
							ID:         "webstranica",
							Name:       "webstranica",
							FieldType:  "url",
							Disabled:   false,
							ClassInput: common.ClassInputTextEnabled + " flex-1 text-xs",
							MaxLength:  "150",
							TabIndex:   "14",
							Value:      partneriData.Website,
						})
					</div>
					<!-- E-mail -->
					<div class="flex items-center gap-1">
						@tmpl.LabelField(domain.LabelFieldConfig{
							ID:         "email",
							LabelText:  translator.Label("E-mail"),
							ClassLabel: common.ClassLabel + " w-28 flex-shrink-0",
