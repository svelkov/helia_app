templ PartneriScript() {
	<script>
		console.log("PartneriScript loaded - script tag executed");
		
		function handleProveriPIBResponse(event) {
			console.log("handleProveriPIBResponse called");
			console.log("Event:", event);
			
			try {
				// Get response from HTMX event
				const responseText = event.detail.xhr.responseText;
				console.log("Response text:", responseText);
				
				const response = JSON.parse(responseText);
				console.log("Parsed response:", response);
				
				// Check if response has the expected structure
				if (response && response.success) {
					console.log("PIB data received:", response.naziv);
					
					// Update form fields with response data - check if property EXISTS, not if truthy
					if ('naziv' in response) {
						const nazivElement = document.getElementById('naziv');
						if (nazivElement) nazivElement.value = response.naziv || '';
					}
					
					if ('naziv1' in response) {
						const punazivElement = document.getElementById('punaziv');
						if (punazivElement) punazivElement.value = response.naziv1 || '';
					}
					
					if ('adresa' in response) {
						const adresaElement = document.getElementById('adresa');
						if (adresaElement) adresaElement.value = response.adresa || '';
					}
					
					if ('mesto' in response) {
						const mestoElement = document.getElementById('mesto');
						if (mestoElement) mestoElement.value = response.mesto || '';
					}
					
					if ('pobro' in response) {
						const postbrojElement = document.getElementById('postbroj');
						if (postbrojElement) postbrojElement.value = response.pobro || '';
					}
					
					if ('matbr' in response) {
						const maticniBrojElement = document.getElementById('maticnibroj');
						if (maticniBrojElement) maticniBrojElement.value = response.matbr || '';
					}
					
				// Handle tekRacuni rows if present
				if ('tekRacuni' in response && response.tekRacuni && Array.isArray(response.tekRacuni)) {
					console.log("Received tekRacuni data:", response.tekRacuni);
					// Find the table body and update it
					const tableBody = document.getElementById('tekuciracuni-table-body');
					if (tableBody) {
						// Clear existing rows
						tableBody.innerHTML = '';
						// Add rows with tekRacuni data
						response.tekRacuni.forEach((racun, index) => {
							const newRow = document.createElement('tr');
							newRow.className = 'tekracuni-row hover:bg-blue-50';
							newRow.setAttribute('data-index', index);
							newRow.innerHTML = `
								<td class="border border-gray-300 px-1">
									<input type="text" class="w-full border rounded px-1 h-7 tekrac-redbroj" placeholder="Redni broj" value="${racun.redbroj || index + 1}"/>
								</td>
								<td class="border border-gray-300 px-1">
									<input type="text" class="w-full border rounded px-1 h-7 tekrac-brojracuna" placeholder="Broj računa" maxlength="20" value="${racun.brojracuna || ''}"/>
								</td>
								<td class="border border-gray-300 px-1">
									<input type="text" class="w-full border rounded px-1 h-7 tekrac-banka" placeholder="Banka" value="${racun.banka || ''}"/>
								</td>
								<td class="border border-gray-300 px-1 text-center">
									<button type="button" class="bg-red-500 text-white text-xs px-1 h-6 w-20 rounded hover:bg-red-600 delete-row">
										Obriši
									</button>
								</td>
							`;
							tableBody.appendChild(newRow);
						});
						console.log("Table updated with tekRacuni data");
						// Re-attach delete handlers
						attachDeleteHandlers();
						}
					}
				} else {
					console.warn("Response missing success flag:", response);
				}
				
			} catch (e) {
				console.error("Error parsing PIB response", e);
			}
		}
		
		// Listen for HTMX events on document level
		document.addEventListener('htmx:afterRequest', function(event) {
			console.log("HTMX afterRequest event fired on document");
		});
		
		// Also try attach to button when it exists
		function attachButtonListener() {
			const btn = document.getElementById('btnProveriPIB');
			console.log("Looking for btnProveriPIB button, found:", btn);
			if (btn) {
				btn.addEventListener('click', function() {
					console.log("Button clicked!");
				});
				btn.addEventListener('htmx:beforeRequest', function() {
					console.log("HTMX beforeRequest on button");
				});
				btn.addEventListener('htmx:afterRequest', handleProveriPIBResponse);
				console.log("Event listeners attached to btnProveriPIB");
			} else {
				console.warn("btnProveriPIB button not found");
			}
		}
		
		// Try attaching immediately
		attachButtonListener();
		
		// Try attaching on DOMContentLoaded
		document.addEventListener('DOMContentLoaded', attachButtonListener);
		
		// Try attaching with delay
		setTimeout(attachButtonListener, 100);
		setTimeout(attachButtonListener, 300);

		function handleDialogResponse(dialogName) {
			// Check if the response is an error (400 Bad Request)
			console.log("in handleDialogResponse()", dialogName)
			//console.log("handleFieldErrors:", event.detail)
			try {
				// Get the response text from the backend
				const responseText = event.detail.xhr.responseText;
				console.log("handleDialogResponse:Response text:", responseText)
				
				// Check if response is empty or not JSON
				if (!responseText || responseText.trim() === '') {
					//console.log("Empty response, closing dialog");
					closeDialog(dialogName);
					return;
				}
				
				// Try to parse as JSON
				let response;
				try {
					response = JSON.parse(responseText);
				} catch (parseError) {
					console.error("Response is not valid JSON...");
					//console.log("Response text was:", responseText);
					// If not JSON, assume it's HTML success response, close dialog
					closeDialog(dialogName);
					return;
				}
				
				// If we get here, response is valid JSON
				// Clear previous error messages
				document.querySelectorAll('.input-error').forEach(el => el.remove());
				document.querySelectorAll('input').forEach(input => {
					input.classList.remove('border-red-500');
				});
				
				// Handle validation errors
				if (response.errors && response.errors.length > 0) {
					//console.log("Errors found:", response.errors)
					// Loop through errors and show error messages for each field
					response.errors.forEach(error => {
						const field = document.querySelector(`input[name="${error.field}"]`);
						if (field) {
							field.classList.add('border-red-500'); // Add red border to invalid field
							// Add error message below the input field
							const errorMessage = document.createElement('p');
							errorMessage.className = 'text-red-500 text-xs mt-1 input-error';
							errorMessage.textContent = error.message;
							field.insertAdjacentElement('afterend', errorMessage);
						}
					});
					return;
				}
				
				// Handle success response
				if (response.success) {
					showMessage(response.message);
					closeDialog(dialogName);
					return;
				}
				
				// Handle error response
				if (!response.success) {
					showMessage(response.message, true);
					return;
				}	
				
			} catch (e) {
				console.error("Unexpected error in handleDialogResponse():", e);
				closeDialog(dialogName);
			}
		}

		// ============ TEKRACUNI TABLE EDITING ==============
		function initTekRacuniTable() {
			console.log("initTekRacuniTable() called!");
			const addBtn = document.getElementById('add-tekracuni-row');
			const tableBody = document.getElementById('tekuciracuni-table-body');
			const form = document.querySelector('form');
			
			console.log("Add button found:", !!addBtn);
			console.log("Table body found:", !!tableBody);
			console.log("Form found:", !!form);
			
			// Add new row button handler
			if (addBtn) {
				addBtn.addEventListener('click', function(e) {
					e.preventDefault();
					addTekRacuniRow();
				});
				console.log("Added click listener to add-tekracuni-row button");
			}

			// Delete row handlers
			attachDeleteHandlers();

			// Use htmx:configRequest instead of beforeRequest - this fires at the right time
			// to allow us to modify the FormData before it's sent
			if (form) {
				console.log("Attempting to attach collectTekRacuniData listener to form via htmx:configRequest");
				form.addEventListener('htmx:configRequest', function(event) {
					console.log("htmx:configRequest fired on form element!");
					addTekRacuniDataToRequest(event);
				});
			}
		}

		function addTekRacuniRow() {
			const tableBody = document.getElementById('tekuciracuni-table-body');
			const newIndex = tableBody.querySelectorAll('tr').length;
			
			const newRow = document.createElement('tr');
			newRow.className = 'tekracuni-row hover:bg-blue-50';
			newRow.setAttribute('data-index', newIndex);
			newRow.innerHTML = `
				<td class="border border-gray-300 px-1">
					<input type="text" class="w-full border rounded px-1 h-7 tekrac-redbroj" placeholder="Redni broj"/>
				</td>
				<td class="border border-gray-300 px-1">
					<input type="text" class="w-full border rounded px-1 h-7 tekrac-brojracuna" placeholder="Broj računa" maxlength="20"/>
				</td>
				<td class="border border-gray-300 px-1">
					<input type="text" class="w-full border rounded px-1 h-7 tekrac-banka" placeholder="Banka"/>
				</td>
				<td class="border border-gray-300 px-1 text-center">
					<button type="button" class="bg-red-500 text-white text-xs px-1 w-20 h-6 rounded hover:bg-red-600 delete-row">
						Obriši
					</button>
				</td>
			`;
			
			tableBody.appendChild(newRow);
			attachDeleteHandlers();
		}

		function attachDeleteHandlers() {
			document.querySelectorAll('.delete-row').forEach(btn => {
				// Remove existing listeners by cloning
				const newBtn = btn.cloneNode(true);
				btn.parentNode.replaceChild(newBtn, btn);
			});

			document.querySelectorAll('.delete-row').forEach(btn => {
				btn.addEventListener('click', function(e) {
					e.preventDefault();
					this.closest('tr').remove();
				});
			});
		}

		function addTekRacuniDataToRequest(event) {
			console.log("addTekRacuniDataToRequest() called!");
			
			const tableBody = document.getElementById('tekuciracuni-table-body');
			if (!tableBody) {
				console.warn("tekuciracuni-table-body not found!");
				return;
			}
			
			const rows = tableBody.querySelectorAll('tr');
			console.log("Found", rows.length, "rows in table");
			
			// Get the FormData object from HTMX that will be sent
			// It's in event.detail.formData (for modern HTMX) or we can create our own
			const formData = event.detail.formData;
			
			if (!formData) {
				console.log("FormData not available in event.detail.formData, HTMX might be using different serialization");
				return;
			}
			
			console.log("Adding tekracuni data to FormData");
			
			// Add tekracuni rows to the FormData
			rows.forEach((row, index) => {
				const redbroj = row.querySelector('.tekrac-redbroj')?.value || '';
				const brojracuna = row.querySelector('.tekrac-brojracuna')?.value || '';
				const banka = row.querySelector('.tekrac-banka')?.value || '';
				
				console.log(`Row ${index}: redbroj='${redbroj}', brojracuna='${brojracuna}', banka='${banka}'`);
				
				// Only add non-empty rows
				if (redbroj || brojracuna || banka) {
					formData.append(`tekracuni[${index}].redbroj`, redbroj);
					formData.append(`tekracuni[${index}].brojracuna`, brojracuna);
					formData.append(`tekracuni[${index}].banka`, banka);
					console.log(`  Added to FormData for tekracuni[${index}]`);
				}
			});
			
			console.log("addTekRacuniDataToRequest completed");
		}
		
		function collectTekRacuniData(event) {
			console.log("collectTekRacuniData() called! Event:", event);
			
			const tableBody = document.getElementById('tekuciracuni-table-body');
			if (!tableBody) {
				console.warn("tekuciracuni-table-body not found!");
				return;
			}
			
			const rows = tableBody.querySelectorAll('tr');
			const form = document.querySelector('form');
			
			console.log("collectTekRacuniData: Found tableBody, rows count:", rows.length);
			console.log("collectTekRacuniData: Form element:", form);
			
			// Remove old hidden inputs
			document.querySelectorAll('input[name^="tekracuni"]').forEach(el => el.remove());
			
			let hiddenInputCount = 0;
			
			// Add new hidden inputs for each row
			rows.forEach((row, index) => {
				const redbroj = row.querySelector('.tekrac-redbroj')?.value || '';
				const brojracuna = row.querySelector('.tekrac-brojracuna')?.value || '';
				const banka = row.querySelector('.tekrac-banka')?.value || '';
				
				console.log(`Row ${index}: redbroj='${redbroj}', brojracuna='${brojracuna}', banka='${banka}'`);
				
				// Only add non-empty rows
				if (redbroj || brojracuna || banka) {
					createHiddenInput(form, `tekracuni[${index}].redbroj`, redbroj);
					createHiddenInput(form, `tekracuni[${index}].brojracuna`, brojracuna);
					createHiddenInput(form, `tekracuni[${index}].banka`, banka);
					hiddenInputCount += 3;
					console.log(`  Added hidden inputs for tekracuni[${index}]`);
				}
			});
			
			console.log("collectTekRacuniData completed - added", hiddenInputCount, "hidden inputs total");
			
			// VERIFY: Check that hidden inputs are actually in the form
			setTimeout(() => {
				const tekracuniInputs = form.querySelectorAll('input[name^="tekracuni"]');
				console.log("VERIFICATION: Hidden inputs in form after collection:", tekracuniInputs.length);
				tekracuniInputs.forEach((input, idx) => {
					console.log(`  Input ${idx}: name='${input.name}', value='${input.value}'`);
				});
			}, 10);
		}

		function createHiddenInput(form, name, value) {
			const input = document.createElement('input');
			input.type = 'hidden';
			input.name = name;
			input.value = value;
			form.appendChild(input);
		}

		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
			console.log("DOMContentLoaded event fired, calling initTekRacuniTable");
			initTekRacuniTable();
		});
		
		// Also call immediately for dynamically inserted forms
		console.log("About to call initTekRacuniTable immediately");
		initTekRacuniTable();
		
		// Fallback: attach listener at document level for htmx:configRequest events
		// This is the ideal place to add FormData values before request is sent
		document.addEventListener('htmx:configRequest', function(event) {
			console.log("Document-level htmx:configRequest fired!", event);
			const target = event.detail.target;
			console.log("Event target:", target, "Target tag:", target?.tagName);
			
			// Check if this is a form or inside a form
			if (target && (target.tagName === 'FORM' || target.closest('form'))) {
				console.log("This is a form submission - calling addTekRacuniDataToRequest from document listener");
				addTekRacuniDataToRequest(event);
			}
		});
	</script>
}
