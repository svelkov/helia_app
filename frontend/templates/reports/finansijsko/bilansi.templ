package finansijsko

import (
	"fmt"
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"time"
)

// ZakljucniListObrazacStampa renders a printable full-page Zakljucni list report.
templ ZakljucniListObrazacStampa(repParams domain.ReportParameters, params domain.ZakljucniStampaParams, tbl domain.TableData, tblSummary domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, nil, nil, ZakljucniListReport(params, tbl, tblSummary, translator))
}

templ ZakljucniListReport(params domain.ZakljucniStampaParams, tbl domain.TableData, tblSummary domain.TableData, translator *i18n.Service) {
	<!-- Screen preview header, hidden in print: the printed report repeats it on every page through
	     the table's <thead>. -->
	<div class="print:hidden">
		@ZakljucniListReportHeader(params, translator)
	</div>
	@ZakljucniListReportBody(params, tbl, translator)
	@ZakljucniListReportSummary(params, tblSummary, translator)
	@rep.ReportEnd(nil)
}

templ ZakljucniListReportHeader(params domain.ZakljucniStampaParams, translator *i18n.Service) {
	<!-- 12-col grid: 3/12 | 8/12 | 1/12 - identical on screen, in print and in the PDF export -->
	<div class="grid grid-cols-12 items-start gap-2 text-[10px] mb-2">
		<!-- Column 1 (3/12): Naziv, Adresa, Post broj / Mesto, Matični broj, Šifra delatnosti -->
		<div class="text-left col-span-3">
			<div class="font-bold text-sm">{ params.Naziv }</div>
			<div>{ params.Adresa }, { params.PostBroj } { params.Mesto } - { fmt.Sprintf("%d", params.God) }. { translator.Label("godina") }</div>
			<div>{ translator.Label("Matični broj") } : { params.MaticniBroj }</div>
			<div>{ translator.Label("Šifra delatnosti") } : { params.SifraDelatnosti }</div>
		</div>
		<!-- Column 2 (6/12): Report name + parameters (period, datum obrade) -->
		<div class="text-center col-span-6">
			<h1 class="text-[13px] font-bold tracking-wide mb-1">{ translator.Title(params.ReportTitle) }</h1>
			<div class="text-[11px] font-semibold">
				{ translator.Label("Za period od") }: <span class="font-bold">{ params.OdDatuma }</span>
				&nbsp;&nbsp;{ translator.Label("do") }: <span class="font-bold">{ params.DoDatuma }</span>
				&nbsp;&nbsp;&nbsp;&nbsp;{ translator.Label("Datum obrade") }: <span class="font-bold">{ params.DatumObrade }</span>
			</div>
		</div>
		<!-- Column 3 (3/12): date/time and page (browser/CSS handles page number) -->
		<div class="text-right col-span-3">
			<div class="page-info">{ time.Now().Format("02.01.2006 15:04:05") }</div>
		</div>
	</div>
}

templ ZakljucniListReportBody(params domain.ZakljucniStampaParams, tbl domain.TableData, translator *i18n.Service) {
	<!-- No border on the <table> itself: the repeating print header row must stay borderless.
	     The grid borders come from the individual th/td cells. -->
	<table class="w-full table-fixed border-collapse text-[10px] [border-collapse:collapse]">
		<!-- Explicit column widths: keeps the layout identical in print, where the repeating
		     header row below becomes the first row of the table (table-layout: fixed). -->
		if params.ZaBanku == "false" {
			<colgroup>
				<col style="width:4%"/>
				<col style="width:4%"/>
				<col style="width:4%"/>
				<col style="width:21%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
			</colgroup>
		} else {
			<colgroup>
				<col style="width:4%"/>
				<col style="width:4%"/>
				<col style="width:4%"/>
				<col style="width:37%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
				<col style="width:12%"/>
			</colgroup>
		}
		<thead class="text-[10px] bg-gray-200">
			<!-- Print only (no-export keeps it out of the Excel export). thead => repeated on every printed page. -->
			<tr class="report-repeat-header no-export hidden print:table-row">
				if params.ZaBanku == "false" {
					<td colspan="12" class="border-0 bg-white p-1 align-top">
						@ZakljucniListReportHeader(params, translator)
					</td>
				} else {
					<td colspan="8" class="border-0 bg-white p-1 align-top">
						@ZakljucniListReportHeader(params, translator)
					</td>
				}
			</tr>
			if params.ZaBanku == "false" {
				<!-- Row 1: full columns (početno stanje + tekući promet + ukupan promet + saldo) -->
				<tr>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Redni broj") }</th>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Konto") }</th>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Šifra") }</th>
					<th rowspan="2" class="border border-black px-1 w-[21%] text-center">{ translator.Label("NAZIV") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("POČETNO STANJE") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("TEKUĆI PROMET") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("UKUPAN PROMET") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("SALDO") }</th>
				</tr>
				<tr>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
				</tr>
			} else {
				<!-- Row 1: za banku columns (ukupan promet + saldo only) -->
				<tr>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Redni broj") }</th>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Konto") }</th>
					<th rowspan="2" class="border border-black px-1 w-[4%] text-center">{ translator.Label("Šifra") }</th>
					<th rowspan="2" class="border border-black px-1 w-[37%] text-center">{ translator.Label("NAZIV") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("UKUPAN PROMET") }</th>
					<th colspan="2" class="border border-black px-1 text-center">{ translator.Label("SALDO") }</th>
				</tr>
				<tr>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Duguje") }</th>
					<th class="border border-black px-1 text-center w-[12%]">{ translator.Label("Potražuje") }</th>
				</tr>
			}
		</thead>
		<tbody>
			for i, row := range tbl.Rows {
				if len(row.Fields) < 12 {
					continue
				}
				// Fields[0] encodes row type:
				//   "G1" = innermost group total (subsintetika / sintetika / grupa depending on tipLista)
				//   "G2" = next group total
				//   "G3" = next group total
				//   "G4" = outermost group total (klasa, only tipLista=1)
				//   "T"  = grand total
				//   otherwise = data row (rbr number)
				switch row.Fields[0] {
					case "G1":
						<!-- G1 — innermost group subtotal (subgroup-header style) -->
						<tr class="subgroup-header font-semibold bg-gray-50 border-t border-black">
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-semibold">{ row.Fields[1] }</td>
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-semibold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-semibold">{ row.Fields[11] }</td>
						</tr>
					case "G2":
						<!-- G2 — second group subtotal (group-header style) -->
						<tr class="group-header font-bold bg-gray-100 border-t border-black">
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[1] }</td>
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[11] }</td>
						</tr>
					case "G3":
						<!-- G3 — third group subtotal (group-total style) -->
						<tr class="group-total font-bold bg-gray-200 border-t-2 border-black">
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[1] }</td>
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[11] }</td>
						</tr>
					case "G4":
						<!-- G4 — outermost group subtotal (klasa, tipLista=1 only) -->
						<tr class="group-total font-bold bg-gray-300 border-t-2 border-black">
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[1] }</td>
							<td class="border border-black px-1 py-[2px]"></td>
							<td class="border border-black px-1 py-[2px] font-bold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[11] }</td>
						</tr>
					case "T":
						<!-- T — grand total row -->
						<tr class="grand-total font-bold border-t-2 border-black bg-gray-400">
							<td colspan="4" class="border border-black px-1 py-[2px] font-bold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[11] }</td>
						</tr>
					default:
						<!-- DATA row — alternating background -->
						<tr
							class={ func() string {
							if i%2 == 1 {
								return "bg-gray-50 hover:bg-yellow-50 print:hover:bg-gray-50"
							}
							return "bg-white hover:bg-yellow-50 print:hover:bg-white"
						}() }
						>
							<td class="border border-black px-1 py-[2px] text-center">{ row.Fields[0] }</td>
							<td class="border border-black px-1 py-[2px]">{ row.Fields[1] }</td>
							<td class="border border-black px-1 py-[2px] text-center">{ row.Fields[2] }</td>
							<td class="border border-black px-1 py-[2px]">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[11] }</td>
						</tr>
				}
			}
		</tbody>
	</table>
}

templ ZakljucniListReportSummary(params domain.ZakljucniStampaParams, tblSummary domain.TableData, translator *i18n.Service) {
	if len(tblSummary.Rows) == 0 {
		return
	}
	<!-- Page break: gray gap on screen, real break on print - the rekapitulacija and the signatures are
	     printed on a page of their own (same markup the shared report layout uses before its summary). -->
	<div class="print:hidden -mx-8 h-16 bg-gray-200 border-y border-gray-300"></div>
	<div class="hidden print:block" style="break-before: page;"></div>
	<!-- Rekapitulacija po klasama: no-break keeps the table on the page it starts on -->
	<div class="pt-10 print:pt-8 no-break">
		<!-- The header of the report is printed on the page of the summary as well (on screen it stays
		     only above the table; on the other pages the main table repeats it through its <thead>). -->
		<div class="hidden print:block mb-2 no-export">
			@ZakljucniListReportHeader(params, translator)
		</div>
		<div class="text-[11px] font-bold mb-1">{ translator.Label("rekapitulacija_po_klasama") }:</div>
		<table class="w-full table-fixed border-collapse text-[10px] border border-black [border-collapse:collapse]">
			if params.ZaBanku == "false" {
				<colgroup>
					<col style="width:4%"/>
					<col style="width:6%"/>
					<col style="width:5%"/>
					<col style="width:18%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
				</colgroup>
			} else {
				<colgroup>
					<col style="width:4%"/>
					<col style="width:8%"/>
					<col style="width:6%"/>
					<col style="width:31%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
					<col style="width:12%"/>
				</colgroup>
			}
			<tbody>
				for _, row := range tblSummary.Rows {
					if len(row.Fields) < 12 {
						continue
					}
					if row.Fields[0] == "T" {
						<tr class="font-bold bg-gray-400 border-t-2 border-black">
							<td colspan="4" class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right font-bold">{ row.Fields[11] }</td>
						</tr>
					} else {
						<tr class="border-t border-black bg-gray-200 print:bg-gray-200">
							<td colspan="4" class="border border-black px-1 py-[2px] text-right">{ row.Fields[3] }</td>
							if params.ZaBanku == "false" {
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[4] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[5] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[6] }</td>
								<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[7] }</td>
							}
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[8] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[9] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[10] }</td>
							<td class="border border-black px-1 py-[2px] text-right">{ row.Fields[11] }</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	<!-- Signature block: kept on the same page as the rekapitulacija (no-break) -->
	<div class="mt-8 flex justify-between items-end text-[10px] no-break">
		<!-- Left: U / Dana -->
		<div class="flex flex-col gap-4 w-[22%]">
			<div class="flex items-end gap-1">
				<span>U</span>
				<div class="border-b border-black flex-1 mb-[2px]"></div>
			</div>
			<div class="flex items-end gap-1">
				<span>{ translator.Label("Dana") }</span>
				<div class="border-b border-black flex-1 mb-[2px]"></div>
				<span>{ translator.Label("godine") }</span>
			</div>
		</div>
		<!-- Center: Lice odgovorno -->
		<div class="flex flex-col items-center gap-4 w-[32%]">
			<div class="border-b border-black w-full"></div>
			<div>{ translator.Label("lice odgovorno za sastavljanje bilansa") }</div>
		</div>
		<!-- Right: Rukovodilac -->
		<div class="flex flex-col items-center gap-4 w-[32%]">
			<div class="border-b border-black w-full"></div>
			<div>{ translator.Label("rukovodilac pravnog lica") }</div>
		</div>
	</div>
}

// BilansStanjaObrazacStampa renders a printable full-page report for a single bilans stanja,
// reusing the shared report layout components.
templ BilansStanjaObrazacStampa(repParams domain.ReportParameters, params domain.BilansiStampaParams, tblStavke domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tblStavke, translator, nil, nil,BilansStanjaReport(params, tblStavke, translator))
}

templ BilansStanjaReport(params domain.BilansiStampaParams, tblStavke domain.TableData, translator *i18n.Service) {
	@BilansStanjaReportHeader(params, tblStavke, translator)
	@BilansStanjaReportBody(params, tblStavke, translator)
	@BilansStanjaReportSummary(params, tblStavke, translator)
}

templ BilansStanjaReportHeader(params domain.BilansiStampaParams, tbl domain.TableData, translator *i18n.Service) {
	<div class="mb-2 text-right font-semibold">
		{ translator.Label("Prilog 2") }
	</div>
	<!-- Official header -->
	<table class="mb-3 w-full table-fixed border border-black text-center text-[10px] [border-collapse:collapse]">
		<colgroup>
			<col span="24" class="w-[4.166%]"/>
		</colgroup>
		<tbody>
			<tr>
				<td colspan="24" class="h-5 border border-black font-semibold">
					{ translator.Label("Popunjava pravno lice - preduzetnik") }
				</td>
			</tr>
			<!-- 24 small boxes -->
			<tr>
				for i := 0; i < 8; i++ {
					<td class="border border-black text-sm font-bold">{ common.BilansCharAt(params.MaticniBroj, i) }</td>
				}
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				for i := 0; i < 9; i++ {
					<td class="border border-black text-sm font-bold">{ common.BilansCharAt(params.PIB, i) }</td>
				}
			</tr>
			<!-- Labels -->
			<tr>
				<td colspan="8" class="h-5 border border-black font-semibold">
					{ translator.Label("Matični broj") }
				</td>
				<td class="border border-black"></td>
				<td colspan="5" class="border border-black font-semibold">
					{ translator.Label("Šifra delatnosti") }
				</td>
				<td class="border border-black"></td>
				<td colspan="9" class="border border-black font-semibold">
					{ translator.Label("PIB") }
				</td>
			</tr>
			<tr>
				<td colspan="24" class="h-5 border border-black font-semibold">
					{ translator.Label("Popunjava Agencija za privredne registre") }
				</td>
			</tr>
			<!-- Empty APR row above numbers -->
			<tr>
				<td class="h-7 border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td colspan="9" class="border border-black"></td>
				<td class="border border-black"></td>
				<td colspan="4" class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
				<td class="border border-black"></td>
			</tr>
			<!-- Number row: 1 2 3, 19, 20-26 -->
			<tr>
				<td class="border border-black">1</td>
				<td class="border border-black">2</td>
				<td class="border border-black">3</td>
				<td colspan="9" class="border border-black"></td>
				<td class="border border-black">19</td>
				<td colspan="4" class="border border-black"></td>
				<td class="border border-black">20</td>
				<td class="border border-black">21</td>
				<td class="border border-black">22</td>
				<td class="border border-black">23</td>
				<td class="border border-black">24</td>
				<td class="border border-black">25</td>
				<td class="border border-black">26</td>
			</tr>
			<tr>
				<td colspan="3" class="h-5 border border-black font-semibold">
					{ translator.Label("Vrsta posla") }
				</td>
				<td colspan="21" class="border border-black"></td>
			</tr>
		</tbody>
	</table>
	<div class="mt-4 space-y-3">
		<div class="flex gap-2">
			<span class="text-xs">{ translator.Label("Naziv") }:</span>
			<div class="flex-1 text-sm font-bold border-b border-black">{ params.Naziv }</div>
		</div>
		<div class="flex gap-2">
			<span class="text-xs">{ translator.Label("Sedište") }:</span>
			<div class="flex-1 text-sm font-bold border-b border-black">{ params.Adresa }, { params.PostBroj } { params.Mesto } </div>
		</div>
	</div>
	<div class="mt-8 mb-4 text-center">
		<h1 class="text-lg font-bold tracking-wide">{ translator.Title("Bilans stanja") }</h1>
		<div class="text-sm font-semibold">
			{ translator.Label("Na dan") }: { params.OdDatuma } { translator.Label("godine") }
		</div>
	</div>
}

templ BilansStanjaReportBody(params domain.BilansiStampaParams, tblStavke domain.TableData, translator *i18n.Service) {
	<div class="mb-1 text-right text-[10px]">
		- { translator.Label("u hiljadama dinara") } -
	</div>
	<table class="w-full table-fixed border bg-gray-200 border-black text-center [border-collapse:collapse]">
		<!-- HEADER -->
		<thead class="text-[11px]">
			<!-- Row 1 -->
			<tr>
				<th rowspan="3" class="border border-black px-1 w-[14%]">
					{ translator.Label("Grupa računa,") }
					<br/>
					{ translator.Label("račun") }
				</th>
				<th rowspan="3" class="border border-black px-1 w-[36%] tracking-[0.3em]">
					{ translator.Label("POZICIJA") }
				</th>
				<th rowspan="3" class="border border-black px-1 w-[6%]">
					{ translator.Label("AOP") }
				</th>
				<th rowspan="3" class="border border-black px-1 w-[10%]">
					{ translator.Label("Napomena") }
					<br/>
					{ translator.Label("broj") }
				</th>
				<th colspan="3" class="border border-black px-1 w-[34%]">
					{ translator.Label("Iznos") }
				</th>
			</tr>
			<!-- Row 2 -->
			<tr>
				<th rowspan="2" class="border border-black px-1">
					{ translator.Label("Tekuća godina") }
				</th>
				<th colspan="2" class="border border-black px-1">
					{ translator.Label("Prethodna godina") }
				</th>
			</tr>
			<!-- Row 3 -->
			<tr>
				<th class="border border-black px-1">
					{ translator.Label("Krajnje stanje") }
					<br/>
					__ 20__
				</th>
				<th class="border border-black px-1">
					{ translator.Label("Početno stanje") }
					<br/>
					01.01.20__
				</th>
			</tr>
			<!-- Column numbers -->
			<tr>
				<th class="border border-black">1</th>
				<th class="border border-black">2</th>
				<th class="border border-black">3</th>
				<th class="border border-black">4</th>
				<th class="border border-black">5</th>
				<th class="border border-black">6</th>
				<th class="border border-black">7</th>
			</tr>
		</thead>
		@rep.ReportTableBody(tblStavke, "", translator)
	</table>
}

templ BilansStanjaReportSummary(params domain.BilansiStampaParams, tblKonta domain.TableData, translator *i18n.Service) {
	<!-- FOOTER -->
	<div class="mt-16 text-[11px]">
		<!-- Top row -->
		<div class="flex justify-between items-start">
			<!-- Left -->
			<div class="w-1/3">
				<div class="mb-6">
					<span>{ translator.Label("U") }</span>
					<div class="border-b border-black w-40 mt-1"></div>
				</div>
				<div class="flex items-end gap-2">
					<span>{ translator.Label("Dana") }</span>
					<div class="border-b border-black w-24"></div>
					<span>20</span>
					<div class="border-b border-black w-12"></div>
					<span>{ translator.Label("godine") }.</span>
				</div>
			</div>
			<!-- Center -->
			<div class="w-1/3 text-center">
				<div class="font-semibold leading-tight">
					{ translator.Label("Lice odgovorno za sastavljanje") }
					<br/>
					{ translator.Label("finansijskog izveštaja") }
				</div>
				<div class="border-b border-black w-56 mx-auto mt-8"></div>
			</div>
			<!-- Right -->
			<div class="w-1/3 text-center">
				<div class="font-semibold">
					{ translator.Label("Zakonski zastupnik") }
				</div>
				<div class="border-b border-black w-56 mx-auto mt-8"></div>
			</div>
		</div>
		<!-- Bottom center -->
		<div class="text-center mt-12 font-semibold text-lg">
			{ translator.Label("M.P.") }
		</div>
	</div>
}

// BilansUspehaObrazacStampa renders a printable full-page report for a single bilans uspeha,
// reusing the shared report layout components.
templ BilansUspehaObrazacStampa(repParams domain.ReportParameters, params domain.BilansiStampaParams, tblStavke domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tblStavke, translator, nil, nil,BilansUspehaReport(params, tblStavke, translator))
}

templ BilansUspehaReport(params domain.BilansiStampaParams, tblStavke domain.TableData, translator *i18n.Service) {
	@BilansUspehaReportHeader(params, tblStavke, translator)
	@BilansUspehaReportBody(params, tblStavke, translator)
	@BilansUspehaReportSummary(params, tblStavke, translator)
}

