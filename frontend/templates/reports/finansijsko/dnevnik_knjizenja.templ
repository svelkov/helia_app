package finansijsko

import (
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/domain"
)

// DnevnikKnjizenjaStampa renders a printable full-page Dnevnik knjizenja report.
templ DnevnikKnjizenjaStampa(tblStavke domain.TableData, tblKonta domain.TableData, params domain.ReportParameters, translator *i18n.Service) {
	@rep.Report(params, tblStavke, translator, DnevnikKnjizenjaReportParam(params, translator), nil, nil)
}

templ DnevnikKnjizenjaReportParam(params domain.ReportParameters, translator *i18n.Service) {
	<div class="text-center text-[11px] font-semibold mb-3">
		{ params.ParameterItems["OdDatuma"].Name }:
		<span class="font-bold">{ params.ParameterItems["OdDatuma"].Value }</span>
		&nbsp;&nbsp;{ params.ParameterItems["DoDatuma"].Name }:
		<span class="font-bold">{ params.ParameterItems["DoDatuma"].Value }</span>
	</div>
}


templ DnevnikKnjizenjaReportSummary(tblKonta domain.TableData, translator *i18n.Service) {
	<div class="mt-6">
		<div class="text-[11px] font-bold mb-1">{ translator.Title("Promet po kontima za nalog") }:</div>
		@rep.ReportTable(tblKonta, translator)
	</div>
}
