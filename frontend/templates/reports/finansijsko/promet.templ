templ KarticaSintKontaStampaTable(tbl domain.TableData, translator *i18n.Service) {
	<table class="w-full border-collapse report-table mt-2 print:w-full print:text-[11pt] print:table-auto print:border-collapse">
		<thead>
			<tr class="bg-blue-800 text-white text-center print:bg-gray-300 print:text-black">
				for _, header := range tbl.Headers {
					<th class="border border-gray-300 px-1 text-center text-xs font-semibold print:bg-gray-300 print:text-black print:px-1">
						{ translator.Label(header.Label) }
					</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, row := range tbl.Rows {
				<tr class="hover:bg-yellow-50 print:hover:bg-white">
					for j, cell := range row.Fields {
						<td
							class={ fmt.Sprintf("border border-gray-300 px-1 text-sm print:text-[9pt] print:px-1 text-%s", func() string {
								if j < len(tbl.Headers) && tbl.Headers[j].TextAlign != "" {
									return tbl.Headers[j].TextAlign
								}
								return "left"
							}()) }
						>
							{ cell }
						</td>
					}
				</tr>
			}
		</tbody>
		if tbl.HasTotals {
			<tfoot>
				<tr class="bg-blue-900 text-white font-bold print:bg-gray-700 print:text-white">
					for j, total := range tbl.Totals {
						<td
							class={ fmt.Sprintf("border border-gray-300 px-1 text-sm font-bold print:text-[9pt] print:px-1 text-%s", func() string {
								if j < len(tbl.Headers) && tbl.Headers[j].TextAlign != "" {
									return tbl.Headers[j].TextAlign
								}
								return "left"
							}()) }
						>
							{ total }
						</td>
					}
				</tr>
			</tfoot>
		}
	</table>
}

