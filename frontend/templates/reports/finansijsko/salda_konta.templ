templ SaldaKlase56MTGroupTable(tbl domain.TableData, translator *i18n.Service) {
	<table class="w-full border-collapse report-table mt-2 print:w-full print:text-[10pt] print:table-auto print:border-collapse">
		<thead>
			<tr class="bg-blue-900 text-white text-center print:bg-gray-200 print:text-black print:page-break-inside-auto">
				for _, header := range tbl.Headers {
					<th class="border border-gray-300 px-1 text-center text-sm font-semibold print:bg-gray-200 print:text-black print:px-1">
						{ translator.Label(header.Label) }
					</th>
				}
			</tr>
		</thead>
		<tbody>
			for i, row := range tbl.Rows {
				if row.ClassRow == "group-header" {
					<tr class="bg-gray-300 print:bg-gray-300 print:page-break-inside-avoid">
						<td class="border border-gray-300 px-2 text-sm font-bold">{ row.Fields[0] }</td>
						<td colspan={ fmt.Sprintf("%d", len(tbl.Headers)-1) } class="border border-gray-300 px-2 text-sm font-bold">{ row.Fields[1] }</td>
					</tr>
				} else if row.ClassRow == "group-total" {
					<tr class="bg-blue-50 font-bold border-t border-gray-400 print:bg-blue-50 print:page-break-inside-avoid">
						for j, cell := range row.Fields {
							<td
								class={ fmt.Sprintf("border border-gray-300 px-1 text-sm font-bold print:text-[10pt] print:px-1 %s",
									func() string {
										if tbl.Headers[j].TextAlign != "" {
											return fmt.Sprintf("text-%s", tbl.Headers[j].TextAlign)
										}
										return ""
									}()) }
							>
								{ cell }
							</td>
						}
					</tr>
				} else {
					<tr
						class={ fmt.Sprintf("hover:bg-yellow-50 print:hover:bg-white print:page-break-inside-avoid %s",
							func() string {
								if i%2 == 1 {
									return "bg-gray-50 print:bg-gray-50"
								}
								return "bg-white print:bg-white"
							}()) }
					>
						for j, cell := range row.Fields {
							<td
								class={ fmt.Sprintf("border border-gray-300 px-1 text-sm print:text-[10pt] print:px-1 print:break-words print:whitespace-normal %s",
									func() string {
										if tbl.Headers[j].TextAlign != "" {
											return fmt.Sprintf("text-%s", tbl.Headers[j].TextAlign)
										}
										return ""
									}()) }
							>
								{ cell }
							</td>
						}
					</tr>
				}
			}
		</tbody>
		if tbl.HasTotals {
			<tfoot>
				<tr class="bg-blue-50 font-bold border-t-2 border-blue-900 print:bg-blue-50 print:page-break-inside-avoid">
					for j, header := range tbl.Headers {
						if header.IncludeInTotals {
							<td class="border border-gray-300 px-1 text-sm print:text-[10pt] print:px-1 font-bold text-right">
								{ tbl.Totals[j] }
							</td>
						} else {
							<td class="border border-gray-300 px-1 text-sm print:text-[10pt] print:px-1 bg-blue-50">
								{ tbl.Totals[j] }
							</td>
						}
					}
				</tr>
			</tfoot>
		}
	</table>
}

// SaldaPartneraPoKontimaStampa renders printable Pregled stanja partnera po kontima.
templ SaldaPartneraPoKontimaStampa(repParams domain.ReportParameters, tbl domain.TableData, stampajDetalje bool, noviPartnerNovaSt bool, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, SaldaPartneraPoKontimaContent(repParams, tbl, stampajDetalje, noviPartnerNovaSt, translator))
}

templ SaldaPartneraPoKontimaContent(repParams domain.ReportParameters, tbl domain.TableData, stampajDetalje bool, noviPartnerNovaSt bool, translator *i18n.Service) {
	@rep.ReportHeader(repParams)
	@rep.ReportTitle(repParams)
	<div class="text-center text-[11px] font-semibold mb-3">
		{ translator.Label("Od Partnera") }: <span class="font-bold">{ repParams.ParameterItems["OdPartnera"].Value }</span>
		&nbsp;&nbsp;&nbsp;{ translator.Label("Do Partnera") }: <span class="font-bold">{ repParams.ParameterItems["DoPartnera"].Value }</span>
		&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{ repParams.ParameterItems["StanjeNaDan"].Name }: <span class="font-bold">{ repParams.ParameterItems["StanjeNaDan"].Value }</span>
	</div>
	@SaldaPartneraPoKontimaTable(tbl, stampajDetalje, noviPartnerNovaSt, translator)
	@rep.ReportEnd(nil)
}

templ SaldaPartneraPoKontimaTable(tbl domain.TableData, stampajDetalje bool, noviPartnerNovaSt bool, translator *i18n.Service) {
	<table class="w-full border-collapse report-table mt-2 print:w-full print:text-[10pt] print:table-auto print:border-collapse">
		<thead></thead>
		<tbody>
			for _, row := range tbl.Rows {
				if row.ClassRow == "partner-header" {
					<tr
						class="bg-gray-700 text-white print:bg-gray-700 print:text-white"
						if noviPartnerNovaSt {
							style="break-before: page;"
						}
					>
						<td colspan={ fmt.Sprintf("%d", len(tbl.Headers)) } class="border border-gray-400 px-2 py-1 text-sm font-bold">
							if len(row.Fields) > 0 {
								{ row.Fields[0] }
							}
							if len(row.Fields) > 1 && row.Fields[1] != "" {
								&nbsp;&nbsp;|&nbsp;&nbsp;{ row.Fields[1] }
							}
							if len(row.Fields) > 2 && row.Fields[2] != "" {
								&nbsp;&nbsp;{ row.Fields[2] }
							}
							if len(row.Fields) > 3 && row.Fields[3] != "" {
								&nbsp;{ row.Fields[3] }
							}
							if len(row.Fields) > 4 && row.Fields[4] != "" {
								&nbsp;&nbsp;PIB:&nbsp;{ row.Fields[4] }
							}
						</td>
					</tr>
				} else if row.ClassRow == "konto-header" {
					<tr class="bg-blue-200 print:bg-blue-200">
						<td colspan={ fmt.Sprintf("%d", len(tbl.Headers)) } class="border border-gray-300 px-2 py-1 text-sm font-bold">
							if len(row.Fields) > 0 {
								{ row.Fields[0] }
							}
							if len(row.Fields) > 1 && row.Fields[1] != "" {
								&nbsp;{ row.Fields[1] }
							}
						</td>
					</tr>
					<tr class="bg-blue-800 text-white text-center print:bg-gray-300 print:text-black">
						for _, header := range tbl.Headers {
							<th
								class={ fmt.Sprintf("border border-gray-300 px-1 text-center text-xs font-semibold print:bg-gray-300 print:text-black print:px-1 text-%s", func() string {
									if header.TextAlign != "" {
										return header.TextAlign
									} else {
										return "left"
									}
								}()) }
							>
								{ translator.Label(header.Label) }
							</th>
						}
					</tr>
				} else if row.ClassRow == "konto-total" {
					<tr class="bg-blue-50 font-bold border-t border-gray-400 print:bg-blue-50">
						<td colspan={ fmt.Sprintf("%d", len(tbl.Headers)-3) } class="border border-gray-300 px-2 py-1 text-sm font-bold">
							if len(row.Fields) > 0 {
								{ row.Fields[0] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 1 {
								{ row.Fields[1] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 2 {
								{ row.Fields[2] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 3 {
								{ row.Fields[3] }
							}
						</td>
					</tr>
				} else if row.ClassRow == "partner-total" {
					<tr class="bg-gray-200 font-bold border-t-2 border-gray-500 print:bg-gray-200">
						<td colspan={ fmt.Sprintf("%d", len(tbl.Headers)-3) } class="border border-gray-300 px-2 py-1 text-sm font-bold">
							if len(row.Fields) > 0 {
								{ row.Fields[0] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 1 {
								{ row.Fields[1] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 2 {
								{ row.Fields[2] }
							}
						</td>
						<td class="border border-gray-300 px-1 text-sm font-bold text-right">
							if len(row.Fields) > 3 {
								{ row.Fields[3] }
							}
						</td>
					</tr>
				} else {
					<tr class="hover:bg-yellow-50 print:hover:bg-white">
						for j, cell := range row.Fields {
							<td
								class={ fmt.Sprintf("border border-gray-300 px-1 text-sm print:text-[9pt] print:px-1 text-%s", func() string {
if j < len(tbl.Headers) && tbl.Headers[j].TextAlign != "" {
return tbl.Headers[j].TextAlign
}
return "left"
}()) }
							>
								{ cell }
							</td>
						}
					</tr>
				}
			}
		</tbody>
		if tbl.HasTotals {
			<tfoot>
				<tr class="bg-blue-900 text-white font-bold print:bg-gray-700 print:text-white">
					for j, total := range tbl.Totals {
						<td
							class={ fmt.Sprintf("border border-gray-300 px-1 text-sm font-bold print:text-[9pt] print:px-1 text-%s", func() string {
if j < len(tbl.Headers) && tbl.Headers[j].TextAlign != "" {
return tbl.Headers[j].TextAlign
}
return "left"
}()) }
						>
							{ total }
						</td>
					}
				</tr>
			</tfoot>
		}
	</table>
}
