package komercijalno

import (
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
	"strings"
)

// NalogStampa renders the print of a nalog za isporuku (the legacy PR_RPT_NALOGPRODAJA): the page header (the logo,
// the kupac, the magacin and the org. jedinica on the left; the firm with the tekući račun of the nalog, the title with
// the broj and the datum on the right), the stavke with the tražena količina and an empty line for the potvrđena one
// (OTK, serija and rok trajanja only in a magacin with the lots), the klasa cena, the teren prodaje (empty, the legacy
// has no source of it), the napomena, the ukupna težina and zapremina, the lines of the radnici and "Nepotvrđen
// dokument!" of a new nalog.
templ NalogStampa(repParams domain.ReportParameters, p domain.KomNalogStampa, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, nalStampaSadrzaj(repParams, p, translator))
}

templ nalStampaSadrzaj(repParams domain.ReportParameters, p domain.KomNalogStampa, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				<col style="width: 6%"/>
				<col style="width: 9%"/>
				if p.Lot {
					<col style="width: 33%"/>
					<col style="width: 8%"/>
					<col style="width: 9%"/>
					<col style="width: 9%"/>
				} else {
					<col style="width: 59%"/>
				}
				<col style="width: 5%"/>
				<col style="width: 10%"/>
				<col style="width: 11%"/>
			</colgroup>
			<thead>
				<tr>
					<td colspan={ nalStampaKolone(p) } class="pb-3">
						@nalStampaZaglavlje(repParams, p, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ common.ClassStampaTh }>{ translator.Label("Red. br.") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Šifra art./sirovine") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("OPIS ARTIKLA / SIROVINE") }</th>
					if p.Lot {
						<th class={ common.ClassStampaTh }>OTK</th>
						<th class={ common.ClassStampaTh }>{ translator.Label("Serija") }</th>
						<th class={ common.ClassStampaTh }>{ translator.Label("Rok trajanja") }</th>
					}
					<th class={ common.ClassStampaTh }>JM</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Tražena količina") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Potvrđena količina") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range p.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ common.ClassStampaTd + " text-center" }>{ strconv.Itoa(s.Rbr) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ strconv.Itoa(s.Sifra) }</td>
						<td class={ common.ClassStampaTd + " break-words whitespace-pre-line" }>{ s.Opis }</td>
						if p.Lot {
							<td class={ common.ClassStampaTd }>{ s.Otk }</td>
							<td class={ common.ClassStampaTd }>{ s.Serija }</td>
							<td class={ common.ClassStampaTd + " text-center" }>{ s.Rok }</td>
						}
						<td class={ common.ClassStampaTd }>{ s.JM }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Kolicina, porDecimale(s.Decimale)) }</td>
						<td class={ common.ClassStampaTd + " text-center" }>__________</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="mt-3 grid grid-cols-2 gap-6 items-start print:page-break-inside-avoid">
			<div class="grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
				<span class="text-right">{ translator.Label("Klasa cena") }:</span>
				<span>{ p.KlasaCena }</span>
				<span class="text-right">{ translator.Label("Teren prodaje") }:</span>
				<span></span>
				<span class="text-right">{ translator.Label("Napomena") }:</span>
				<span class="whitespace-pre-line">{ p.Napomena }</span>
			</div>
			<div class="grid grid-cols-[auto_auto_auto] gap-x-2 leading-snug justify-start">
				<span class="text-right">{ translator.Label("Ukupna težina") }:</span>
				<span class="text-right">{ common.FormatNumberWithSystemLocale(p.Tezina, 3) }</span>
				<span>Kg</span>
				<span class="text-right">{ translator.Label("Ukupna zapremina m3") }:</span>
				<span class="text-right">{ common.FormatNumberWithSystemLocale(p.Zapremina, 3) }</span>
				<span></span>
			</div>
		</div>
		<div class="mt-10 grid grid-cols-2 gap-16 print:page-break-inside-avoid">
			<div class="border-t border-black text-center pt-1">{ translator.Label("Utovario radnik") }</div>
			<div class="border-t border-black text-center pt-1">{ translator.Label("Predao radnik") }</div>
		</div>
		if p.Nepotvrdjen {
			<div class="mt-4 font-bold text-center uppercase">{ translator.Label("Nepotvrđen dokument!") }</div>
		}
	</div>
}

// nalStampaZaglavlje renders the page header of the nalog: the logo and the kupac (a box marked by its corners) with
// the magacin and the org. jedinica on the left, the firm and the title with the broj and the datum on the right.
templ nalStampaZaglavlje(repParams domain.ReportParameters, p domain.KomNalogStampa, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 object-contain"/>
			}
			@proKupacBox(p.Kupac, translator.Label("KUPAC"), translator.Label("Tel/fax"), nil)
			<div class="mt-2 grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
				<span class="text-right">{ translator.Label("Magacin") }:</span>
				<span>{ p.Magacin }</span>
				<span class="text-right">{ translator.Label("OJ koja izdaje nalog") }:</span>
				<span>{ p.OJ }</span>
			</div>
		</div>
		<div>
			<div class="font-bold text-[13px] print:text-[11pt]">{ p.Firma.Naziv }</div>
			<div class="mt-1">{ strings.TrimSpace(p.Firma.Pobro + " " + p.Firma.Mesto + " , " + p.Firma.Adresa) }</div>
			<div class="text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug mt-1">
				<div>{ zahtevObveznik(p.Firma, translator) }</div>
				<div>{ zahtevApr(p.Firma, translator) }</div>
				<div>{ translator.Label("PIB") } : { p.Firma.Pib }</div>
				<div>{ translator.Label("Matični broj") } : { p.Firma.Matbr }</div>
				<div>{ translator.Label("Šifra delatnosti") } : { p.Firma.Sifdel }</div>
				<div>{ translator.Label("Telefon/faks") } : { p.Firma.Tel }</div>
			</div>
			if p.TekuciRacun != "" {
				<div class="text-[10px] print:text-[8pt] mt-1">{ translator.Label("Tekući račun") } : { p.TekuciRacun }</div>
			}
			<div class="mt-4">
				<span class="font-bold text-[16px] print:text-[13pt]">{ translator.Label("NALOG ZA OTPREMU BR.:") }</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ strconv.Itoa(p.Dokum) }</span>
			</div>
			<div class="mt-2">
				<span>{ translator.Label("Datum naloga") }:</span>
				<span class="font-bold ml-1">{ proStampaDatum(p.Datum) }</span>
			</div>
		</div>
	</div>
}

// nalStampaKolone is the number of the columns of the stavke of the print.
func nalStampaKolone(p domain.KomNalogStampa) string {
	if p.Lot {
		return "9"
	}
	return "6"
}
