package komercijalno

import (
	"database/sql"
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
	"strings"
)

// ProfakturaStampa renders the print of a profaktura (the legacy PR_RPT_PROFAKTURA; in a foreign valuta
// PR_RPT_PROFAKTURAIZV, in English with the cene in the valuta and without PDV).
templ ProfakturaStampa(repParams domain.ReportParameters, p domain.KomProStampa, translator *i18n.Service) {
	if p.Ino {
		@rep.Report(repParams, domain.TableData{}, translator, nil, nil, proStampaIzvoz(repParams, p, translator))
	} else {
		@rep.Report(repParams, domain.TableData{}, translator, nil, nil, proStampaDomaca(repParams, p, translator))
	}
}

// proStampaDomaca renders the domestic profaktura like the legacy report: the page header (the logo, the kupac with the
// mesto isporuke, the uslovi, the firm with its računi, the title with the broj, the datum, the valuta and the mesto
// izdavanja), the stavke (the headers repeat on every page), the totals (BRUTO, RABAT, NETO with the ugovoreni rabat and
// the kasa, the PDV per stopa of a PDV obveznik, UKUPNA NAKNADA), slovima, the napomena, the neto težina, "Dokument
// izdao" and the poresko oslobođenje.
templ proStampaDomaca(repParams domain.ReportParameters, p domain.KomProStampa, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				<col style="width: 5%"/>
				<col style="width: 7%"/>
				<col style="width: 27%"/>
				<col style="width: 5%"/>
				<col style="width: 9%"/>
				<col style="width: 10%"/>
				<col style="width: 6%"/>
				<col style="width: 9%"/>
				<col style="width: 5%"/>
				<col style="width: 7%"/>
				<col style="width: 10%"/>
			</colgroup>
			<thead>
				<tr>
					<td colspan="11" class="pb-3">
						@proStampaZaglavlje(repParams, p, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ common.ClassStampaTh }>{ translator.Label("Red. br.") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Šifra artikla") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Naziv artikla") }</th>
					<th class={ common.ClassStampaTh }>JM</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Količina") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Prodajna cena") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("% Rabata") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ common.ClassStampaTh }>% PDV</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("PDV po JM") }</th>
					<th class={ common.ClassStampaTh }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range p.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ common.ClassStampaTd + " text-center" }>{ strconv.Itoa(s.Rbr) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ strconv.Itoa(s.Sifra) }</td>
						<td class={ common.ClassStampaTd + " break-words whitespace-pre-line" }>{ s.Naziv }</td>
						<td class={ common.ClassStampaTd }>{ s.JM }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Kolicina, porDecimale(s.Decimale)) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Cena, 2) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.ProcRab, 2) }%</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Rabat, 2) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Stopa, 0) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.PdvJM, 2) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Iznos, 2) }</td>
					</tr>
				}
			</tbody>
		</table>
		<!-- The totals (ITERATION_SVEGA … ITERATION_ZANAPLATU) -->
		<div class="mt-2 flex justify-end print:page-break-inside-avoid">
			<div class="w-80 grid grid-cols-[1fr_auto] gap-x-3 leading-snug">
				@proZbir(translator.Label("BRUTO"), p.Svega, false)
				if p.Rabat > 0 {
					@proZbir(translator.Label("RABAT"), p.Rabat, false)
				}
				if p.NetoPrikaz {
					@proZbir(translator.Label("NETO"), p.Neto, false)
				}
				if p.Ugrabat != 0 {
					@proZbir(translator.Label("UGOVORENI RABAT")+" "+common.FormatNumberWithSystemLocale(p.UgrabatPct, 2)+"%", p.Ugrabat, false)
				}
				if p.Kasa != 0 {
					@proZbir(translator.Label("KASA")+" "+common.FormatNumberWithSystemLocale(p.KasaPct, 2)+"%", p.Kasa, false)
				}
				for _, pdv := range p.PdvPoStopama {
					@proZbir(translator.Label("PORESKA OSNOVICA"), pdv.Osnovica, false)
					@proZbir(translator.Label("PDV PO STOPI")+" "+common.FormatNumberWithSystemLocale(pdv.Stopa, 0)+"%", pdv.Pdv, false)
				}
				@proZbir(translator.Label("UKUPNA NAKNADA"), p.ZaNaplatu, true)
			</div>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-6 items-start print:page-break-inside-avoid">
			<div class="leading-snug">
				if p.Slovima != "" {
					<div><span>{ translator.Label("Slovima") }:</span> <span class="italic">{ p.Slovima }</span></div>
				}
				<div class="mt-2">{ translator.Label("Napomena") }:</div>
				<div class="min-h-[2rem] whitespace-pre-line">{ p.Napomena }</div>
				<div class="mt-2">{ translator.Label("Neto težina") }: { common.FormatNumberWithSystemLocale(p.NetoTezina, 3) } K</div>
			</div>
			<div class="flex justify-end">
				<div class="w-64 mt-10 flex items-end gap-2">
					<span class="whitespace-nowrap">{ translator.Label("Dokument izdao") }:</span>
					<div class="flex-1 border-b border-black"></div>
				</div>
			</div>
		</div>
		if p.Pornapomena != "" {
			<div class="mt-3">{ translator.Label("NAPOMENA: Oslobođeno plaćanja PDV-a po") } { p.Pornapomena }</div>
		}
	</div>
}

// proStampaZaglavlje renders the page header of the domestic profaktura: on the left the logo, the kupac (a box marked
// by its corners, like the faktura) with the mesto isporuke and the uslovi plaćanja, the rok, the komercijalista, the
// vozač and the broj vozila; on the right the firm with its računi and the title with the broj, the datum, the valuta
// and the mesto izdavanja.
templ proStampaZaglavlje(repParams domain.ReportParameters, p domain.KomProStampa, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 object-contain"/>
			}
			@proKupacBox(p.Kupac, translator.Label("KUPAC"), translator.Label("Tel/fax"), proMestoIsporukeTekst(p, "M. Isporuke:"))
			<div class="mt-2 grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
				<span>{ translator.Label("Uslovi plaćanja") }:</span>
				<span>{ p.Pla }</span>
				<span>{ translator.Label("Rok plaćanja") }:</span>
				<span><span class="font-bold">{ strconv.Itoa(p.Rok) }</span> { translator.Label("dana") }</span>
				<span>{ translator.Label("Komercijalista") }:</span>
				<span>{ p.Komercijalista }</span>
				<span>{ translator.Label("Vozač") }:</span>
				<span>{ p.Vozac } <span class="ml-6">{ translator.Label("Broj vozila") }: { p.Brvozila }</span></span>
			</div>
		</div>
		<div>
			<div class="font-bold text-[13px] print:text-[11pt]">{ p.Firma.Naziv }</div>
			<div class="mt-1">{ proAdresa(p) }</div>
			<div class="text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug mt-1">
				<div>{ zahtevObveznik(p.Firma, translator) }</div>
				<div>{ zahtevApr(p.Firma, translator) }</div>
				<div>{ translator.Label("PIB") } : { p.Firma.Pib }</div>
				<div>{ translator.Label("Matični broj") } : { p.Firma.Matbr }</div>
				<div>{ translator.Label("Šifra delatnosti") } : { p.Firma.Sifdel }</div>
				<div>{ translator.Label("Telefon/faks") } : { p.Firma.Tel }</div>
			</div>
			if len(p.ZiroRacuni) > 0 {
				<div class="text-[10px] print:text-[8pt] mt-1">{ translator.Label("Tekući račun") } : { strings.Join(p.ZiroRacuni, "; ") }</div>
			}
			<div class="mt-4">
				<span class="font-bold text-[16px] print:text-[13pt]">{ translator.Label("Profaktura br.:") }</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ strconv.Itoa(p.Dokum) }</span>
			</div>
			<div class="mt-2 grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
				<span class="text-right">{ translator.Label("Datum profakture") }:</span>
				<span class="font-bold">{ proStampaDatum(p.Datum) }</span>
				<span class="text-right">{ translator.Label("Valuta") }:</span>
				<span class="font-bold">{ proStampaDatum(p.Valuta) }</span>
				<span class="text-right">{ translator.Label("Mesto izdavanja profakture") }:</span>
				<span>{ p.MestoIzdavanja }</span>
			</div>
		</div>
	</div>
}

// proKupacBox renders the kupac of the print in a box marked only by its four corners, with its mesto isporuke.
templ proKupacBox(k domain.KomPonudaStampaDobavljac, naslov, tel string, mestoIsporuke []string) {
	<div class="relative mt-2 px-3 py-2 leading-snug">
		<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
		<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
		<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
		<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
		<div>
			<span class="font-bold italic uppercase">{ naslov }:</span>
			<span class="ml-1">{ strings.TrimSpace(k.Konto + " " + k.Sifra) }</span>
		</div>
		<div class="font-bold text-[14px] print:text-[12pt] mt-0.5">{ k.Naziv }</div>
		<div class="mt-1">{ k.Adresa }</div>
		<div>{ k.Mesto }</div>
		<div>{ ponudaDobavljacPib(k) }</div>
		if strings.TrimSpace(k.Telefon) != "" {
			<div>{ tel } : { k.Telefon }</div>
		}
		for _, red := range mestoIsporuke {
			<div class="mt-1 first:mt-1">{ red }</div>
		}
	</div>
}

// proStampaIzvoz renders the izvozna profaktura like the legacy PR_RPT_PROFAKTURAIZV (in English): the page header,
// the stavke at the cena in the valuta, the totals in the valuta (TOTAL, DISCOUNT, SUBTOTAL with the guarantee discount
// and the discount for payment in advance, TOTAL FOR PAYMENT), the notes, the delivery terms, the total net weight, the
// sales department, the fixed texts and the declaration of the exporter (with the izvozna izjava).
templ proStampaIzvoz(repParams domain.ReportParameters, p domain.KomProStampa, translator *i18n.Service) {
	{{ val := strings.ToUpper(strings.TrimSpace(p.OznVal)) }}
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				<col style="width: 6%"/>
				<col style="width: 8%"/>
				<col style="width: 34%"/>
				<col style="width: 7%"/>
				<col style="width: 10%"/>
				<col style="width: 11%"/>
				<col style="width: 7%"/>
				<col style="width: 8%"/>
				<col style="width: 9%"/>
			</colgroup>
			<thead>
				<tr>
					<td colspan="9" class="pb-3">
						<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
							<div>
								if repParams.CompanyLogo != "" {
									<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 object-contain"/>
								}
								@proKupacBox(p.Kupac, "KUPAC", "Tel/fax", proMestoIsporukeTekst(p, "Delivery. Place:"))
								<div class="mt-2 grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
									<span>Despatch note:</span>
									<span>{ p.Otp }</span>
									<span>Payment condition:</span>
									<span>{ p.Pla }</span>
									<span>Sales person:</span>
									<span>{ p.Komercijalista }</span>
								</div>
							</div>
							<div>
								<div class="font-bold text-[13px] print:text-[11pt]">{ p.Firma.Naziv }</div>
								<div class="mt-1">{ proAdresa(p) }</div>
								<div class="text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug mt-1">
									<div>{ zahtevObveznik(p.Firma, translator) }</div>
									<div>{ zahtevApr(p.Firma, translator) }</div>
									<div>PIB : { p.Firma.Pib }</div>
									<div>{ translator.Label("Matični broj") } : { p.Firma.Matbr }</div>
									<div>{ translator.Label("Šifra delatnosti") } : { p.Firma.Sifdel }</div>
									<div>{ translator.Label("Telefon/faks") } : { p.Firma.Tel }</div>
								</div>
								<div class="mt-4">
									<span class="font-bold text-[16px] print:text-[13pt]">PROFORMA No.:</span>
									<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ strconv.Itoa(p.Dokum) }</span>
								</div>
								<div class="mt-2 grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
									<span class="text-right">Proforma Date:</span>
									<span class="font-bold">{ proStampaDatum(p.Datum) }</span>
									<span class="text-right">Due date:</span>
									<span class="font-bold">{ proStampaDatum(p.Valuta) }</span>
									<span class="text-right">Place of issuing:</span>
									<span>{ p.MestoIzdavanja }</span>
								</div>
							</div>
						</div>
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ common.ClassStampaTh }>Line No.</th>
					<th class={ common.ClassStampaTh }>Product ID</th>
					<th class={ common.ClassStampaTh }>DESCRIPTION</th>
					<th class={ common.ClassStampaTh }>Measure Unit</th>
					<th class={ common.ClassStampaTh }>Quantity</th>
					<th class={ common.ClassStampaTh }>Unit Price { val }</th>
					<th class={ common.ClassStampaTh }>% Discount</th>
					<th class={ common.ClassStampaTh }>Discount</th>
					<th class={ common.ClassStampaTh }>TOTAL { val }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range p.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ common.ClassStampaTd + " text-center" }>{ strconv.Itoa(s.Rbr) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ strconv.Itoa(s.Sifra) }</td>
						<td class={ common.ClassStampaTd + " break-words whitespace-pre-line" }>{ s.Naziv }</td>
						<td class={ common.ClassStampaTd }>{ s.JM }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Kolicina, porDecimale(s.Decimale)) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Cena, 2) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.ProcRab, 2) }%</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Rabat, 2) }</td>
						<td class={ common.ClassStampaTd + " text-right" }>{ common.FormatNumberWithSystemLocale(s.Iznos, 2) }</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="mt-2 flex justify-end print:page-break-inside-avoid">
			<div class="w-96 grid grid-cols-[1fr_auto] gap-x-3 leading-snug">
				@proZbir("TOTAL "+val, p.Svega, false)
				if p.Rabat > 0 {
					@proZbir("DISCOUNT "+val, p.Rabat, false)
				}
				if p.NetoPrikaz {
					@proZbir("SUBTOTAL", p.Neto, false)
				}
				if p.Ugrabat != 0 {
					@proZbir("Guarantee discount "+common.FormatNumberWithSystemLocale(p.UgrabatPct, 2)+"%", p.Ugrabat, false)
				}
				if p.Kasa != 0 {
					@proZbir("Discount for payment in advance "+common.FormatNumberWithSystemLocale(p.KasaPct, 2)+"%", p.Kasa, false)
				}
				@proZbir("TOTAL FOR PAYMENT "+val, p.ZaNaplatu, true)
			</div>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-6 items-start print:page-break-inside-avoid">
			<div class="leading-snug">
				<div>Notes:</div>
				<div class="min-h-[2rem] whitespace-pre-line">{ p.Napomena }</div>
				<div class="mt-2">Delivery terms: { p.Paritet }</div>
				<div>Total net weight: { common.FormatNumberWithSystemLocale(p.NetoTezina, 3) } K</div>
			</div>
			<div class="flex justify-end">
				<div class="w-64 mt-6 text-center">
					<div class="mb-8">Sales department</div>
					<div class="border-t border-black"></div>
				</div>
			</div>
		</div>
		<div class="mt-4 leading-snug">
			<div>The goods remain property of seller until the payment is effected.</div>
			<div>Oslobodjeno placanja PDV-a po clanu 24. stav 1 tacka 2, Zakona o PDV-u</div>
			if p.Izjizv {
				<div class="mt-2">
					The exporter of the products covered by this document (customs autorization No. ____________________) declares that, except
					where otherwise clearly indicated, these products are of Serbian preferential origin - no cumulation applied
				</div>
			}
		</div>
	</div>
}

// proZbir renders a total of the print: its caption and its value.
templ proZbir(label string, value float64, bold bool) {
	<span class={ "text-right uppercase", templ.KV("font-bold", bold) }>{ label }:</span>
	<span class={ "text-right border-b border-black min-w-[7rem]", templ.KV("font-bold", bold) }>{ common.FormatNumberWithSystemLocale(value, 2) }</span>
}

// proMestoIsporukeTekst are the lines of the mesto isporuke of the print (the legacy ITEM_MISP and ITEM_MISP1), with
// its caption; none without it.
func proMestoIsporukeTekst(p domain.KomProStampa, naslov string) []string {
	if strings.TrimSpace(p.MestoIsporuke) == "" {
		return nil
	}
	return []string{naslov + p.MestoIsporuke, p.MestoIsporuke2}
}

// proAdresa is the adresa of the firm (with the adresa of the magacin; the legacy ITEM_Adresa).
func proAdresa(p domain.KomProStampa) string {
	return strings.TrimSpace(p.Firma.Pobro + " " + p.Firma.Mesto + " , " + p.Firma.Adresa)
}

// proStampaDatum is a datum of the print (dd.mm.yyyy, "" without it).
func proStampaDatum(d sql.NullTime) string {
	if !d.Valid {
		return ""
	}
	return d.Time.Format(common.DateLayout)
}
