package reports

import (
	"helia/internal/domain"
	"time"
	"helia/internal/i18n"
)


templ Report(parameters domain.ReportParameters, translator *i18n.Service) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
			<title>Report - { parameters.ReportName }</title>
			<style>
				@media print {
					@page {
						margin: 1cm;
						@bottom-right {
							content: "Page " counter(page) " of " counter(pages);
							font-size: 10pt;
							color: #666;
						}
						@top-left {
							content: "{ parameters.CompanyName }";
							font-size: 10pt;
							color: #666;
						}
					}
					.no-print {
						display: none !important;
					}
				}
			</style>
		</head>
		<body>
			<!-- Your report content goes here -->
			<h1>{ parameters.ReportName }</h1>
			<button class="no-print" onclick="window.print()">{ translator.Label("Stampaj/Generi PDF") }</button>
		</body>
	</html>
}

templ ReportHeader1(parameters domain.ReportParameters) {
	<!-- Header Section -->
	<header class="mb-8">
		<!-- First Row: Logo and Company Name -->
		<div class="flex items-center gap-4 mb-6">
			<!-- Company Logo Placeholder -->
			<div
				class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center border-2 border-blue-300 print:border-blue-200"
			>
				<span class="text-2xl font-bold text-blue-600">🏢</span>
			</div>
			<h1 class="text-4xl font-bold text-gray-900">{ parameters.CompanyName }</h1>
		</div>
		<!-- Second Row: Generated info -->
		<div class="flex justify-between items-center mb-1">
			<div class="text-xs text-gray-600 space-y-1">
				<p class="font-small">📅 Generated:  </p>
				<p class="font-small">👤 Generated by: { parameters.UserName }</p>
			</div>
		</div>
		<!-- Third Row: Report Title -->
		<div class="flex justify-between items-center mb-8 border-b-2 border-gray-300 pb-4">
			<h2 class="text-3xl font-bold text-gray-800 capitalize">
				{ parameters.ReportName }
			</h2>
		</div>
	</header>
}

templ ReportBody1(parameters domain.ReportParameters, translator *i18n.Service) {
	<!-- Body Section -->
	<body class="bg-gray-50 print:bg-white">
		<!-- Print Controls -->
		<div class="fixed pt-10 right-6 z-50 bg-white p-4 rounded shadow-xl flex gap-3 no-print">
			<button
				onclick="window.print()"
				class="bg-blue-600 text-white px-2 h-7 rounded hover:bg-blue-700 flex items-center gap-1 font-semibold"
			>
				<span>🖨️</span>
				<span>{ translator.Label("Stampaj") }</span>
			</button>
			<button
				onclick="window.close()"
				class="bg-gray-600 text-white px-2 h-7 rounded hover:bg-gray-700 flex items-center gap-1 font-semibold"
			>
				<span>❌</span>
				<span>{ translator.Label("Zatvori") }</span>
			</button>
		</div>
		<!-- Main Report Container -->
		<div class="min-h-screen max-w-full py-8 px-4 flex items-center justify-center print:py-0 print:px-0">
			<div
				class="bg-white rounded-xl shadow-xl p-8 w-[90%] print:w-full print:shadow-none print:rounded-none print:p-0"
			>
				<!-- Header Section -->
				@ReportHeader1(parameters)
				<!-- Parameters Section - Two Column Grid -->
				@ReportParams1(parameters)
				<!-- Report Data Section -->
				@ReportData1()
				<!-- Footer -->
				@ReportFooter1(parameters)
			</div>
		</div>
	</body>
}

templ ReportParams1(parameters domain.ReportParameters) {
	<!-- Parameters Section -->
	<!-- Parameters Section - Two Column Grid -->
	<section class="mb-8">
		<h3 class="text-xl font-semibold text-gray-800 mb-6">Report Parameters</h3>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div class="space-y-4">
				<div class="bg-gray-50 p-5 rounded-lg border border-gray-200 print:bg-transparent"></div>
			</div>
			<div class="space-y-1"></div>
		</div>
	</section>
}

templ ReportData1() {
	<!-- Data Section -->
	<div></div>
}

templ ReportSummary() {
	<!-- Summary Section -->
	<div></div>
}

templ ReportFooter1(parameters domain.ReportParameters) {
	<!-- Footer Section -->
	<!-- Footer -->
	<footer class="pt-8 border-t-2 border-gray-200">
		<p class="text-sm text-gray-600 text-center">
			Generated on { time.Now().Format( "January 2, 2006") } • { parameters.CompanyName } • Confidential
		</p>
	</footer>
}
