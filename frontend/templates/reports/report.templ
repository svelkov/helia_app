package reports

import (
	"fmt"
	"helia/i18n"
	"helia/internal/domain"
	"time"
)

// Main Report Template
templ Report(parameters domain.ReportParameters, tableData domain.TableData, translator *i18n.Service, summaryComponent templ.Component) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<title>{ parameters.ReportName } - { parameters.CompanyName }</title>
			<style>
			/* @page must be at top level, not inside @media print */
			/* @top-right requires Chrome 128+ — thead::before below is the Chrome fallback */
			@page {
				size: A4;
				margin: 8mm 10mm 12mm 10mm;
				@top-right {
					content: "Stranica " counter(page);
					font-size: 9pt;
					font-family: sans-serif;
					color: #374151;
					text-align: left;
				}
			}

			@media print {
				.page-info {
					font-size: 8pt;
					color: #374151;
				}
				
				/* Ensure page numbers appear on each printed page */
				.page-break {
					position: relative;
					page-break-after: always;
				}
		
				html, body {
					margin: 0;
					padding: 0;
					width: 100%;
				}
				
				body {
					background: white;
				}
				
				.no-print {
					display: none !important;
				}
				
				.print-container {
					width: 100%;
					margin: 0;
					padding: 0;
					background: white;
				}
				
				.no-break {
					page-break-inside: avoid;
				}
				
				/* Table should break naturally across pages */
				table {
					width: 100%;
					border-collapse: collapse;
					page-break-inside: auto;
					table-layout: fixed;
				}
				
				/* Repeat header on each page */
				thead {
					display: table-header-group;
					page-break-inside: avoid;
				}

				tbody {
					display: table-row-group;
				}
				
				/* Table header rows - keep with content */
				thead tr {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				/* Keep group headers with next row */
				tr.group-header {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				tr.subgroup-header {
					page-break-inside: avoid;
					page-break-after: auto;
				}
				
				tr.group-total {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				tr.group-footer {
					page-break-inside: avoid;
				}
				
				tr.grand-total {
					page-break-inside: avoid;
				}
				
				/* Regular data rows can break */
				tr {
					page-break-inside: auto;
				}
				
				tfoot {
					display: table-row-group;
					page-break-inside: avoid;
				}
			}
			/* Screen view */
			@media screen {
				
				.page-break {
					width: 210mm;
					margin: 20px auto;
					padding: 15mm;
					background: white;
					box-shadow: 0 0 10px rgba(0,0,0,0.1);
					min-height: 297mm;
				}
			}
		</style>
		</head>
		<body class="bg-gray-100 print:bg-white print:h-auto print:p-5 font-sans">
			<!-- Print Controls -->
			<div class="fixed top-1 right-1 z-50 bg-white p-1 rounded shadow-lg flex gap-2 print:hidden">
				<button
					onclick="window.print()"
					class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm font-semibold"
				>
					🖨️ { translator.Button("Stampa") }
				</button>
				<button onclick="exportToPDF()" class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm font-semibold">
					Download PDF
				</button>
				<button
					onclick="window.close()"
					class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm font-semibold"
				>
					❌ { translator.Button("Zatvori") }
				</button>
			</div>
			<!-- Main Report Container -->
			<div class="py-2 px-4 print:py-0 print:px-0 print:w-full print:m-0 print:p-0">
				<div class="bg-white rounded-lg shadow-lg px-8 py-10 print:shadow-none print:rounded-none print:p-0 max-w-6xl mx-auto print:mx-0 print:max-w-full print:bg-white">
					<!-- Header: Company Info, Date/Time, Page -->
					@ReportHeader(parameters)
					<!-- Report Title -->
					@ReportTitle(parameters)
					<!-- Report Parameters as Headers (Two Columns) -->
					@ReportParametersHeader(parameters)
					<!-- Report Data/Table -->
					@ReportTableSection(tableData, translator)
					if summaryComponent != nil {
						<!-- Page break: gray gap on screen, real break on print -->
						<div class="print:hidden -mx-8 h-16 bg-gray-200 border-y border-gray-300"></div>
						<div class="hidden print:block" style="page-break-before: always;"></div>
						<!-- Summary Section (e.g., Totals, Averages) -->
						<div class="pt-10 print:pt-8">
							@summaryComponent
						</div>
					}
					<!-- Footer -->
					@ReportFooter(parameters)
				</div>
			</div>
			@ReportPaginationScript()
			@ReportKeyboardShortcutsScript()
		</body>
	</html>
}

// Header with Company Info (Left), Date/Time and Page (Right)
templ ReportHeader(parameters domain.ReportParameters) {
	<div class="mb-2 border-b-2 border-gray-300 print:m-0 print:mb-1 print:pb-1 print:border-b print:border-gray-300">
		<div class="flex justify-between items-start">
			<!-- Left: Company Info -->
			<div class="text-xs text-gray-700 space-y-0.5 print:text-[9pt]">
				<p class="font-bold text-sm print:text-sm print:leading-tight">{ parameters.CompanyName }</p>
				<p class="text-gray-600 print:text-gray-700 print:text-[8pt]">Nov Sad - { fmt.Sprintf("%d", time.Now().Year()) } godine</p>
			</div>
			<!-- Right: Date/Time and Page Info -->
			<div class="text-xs text-gray-700 text-right space-y-0.5 print:text-[8pt]">
				<p class="print:leading-tight">{ time.Now().Format("02.01.2006 15:04:05") }</p>
			</div>
		</div>
	</div>
}

// Report Title
templ ReportTitle(parameters domain.ReportParameters) {
	<div class="mb-1 text-center print:m-0 print:mb-1">
		<h1 class="text-2xl font-bold text-gray-900 uppercase print:text-base print:leading-tight">
			{ parameters.ReportName }
		</h1>
	</div>
}

// Report Parameters as Two-Column Headers
templ ReportParametersHeader(parameters domain.ReportParameters) {
	<div class="mb-1 grid grid-cols-2 gap-6 print:gap-2 print:m-0 print:mb-2 print:pb-1 print:border-b print:border-gray-300">
		for _, param := range parameters.ParameterItems {
			<div class="flex gap-1 items-center text-sm text-gray-700 print:text-[8pt] print:leading-tight">
				<span class="font-semibold">{ param.Name }:</span>
				<span>{ param.Value }</span>
			</div>
		}
	</div>
}

// Report Table Section - uses ReportTable from tablereport.templ
templ ReportTableSection(tableData domain.TableData, translator *i18n.Service) {
	<div class="mb-1 overflow-x-auto print:overflow-visible print:mt-4 print:mb-4 print:mx-0">
		@ReportTable(tableData, translator)
	</div>
}

// Group Template (for grouped report data)
templ ReportGroup(groupName string, groupData interface{}) {
	<div class="mt-2 mb-4">
		<h3 class="text-lg font-bold text-gray-800 bg-gray-100 px-3 py-2 border-l-4 border-blue-900">
			{ groupName }
		</h3>
	</div>
}

// Subgroup Template (for nested grouping)
templ ReportSubgroup(subgroupName string, subgroupData interface{}) {
	<div class="mt-4 mb-2 ml-4">
		<h4 class="text-base font-semibold text-gray-700 bg-gray-50 px-3 py-1 border-l-4 border-gray-400">
			{ subgroupName }
		</h4>
	</div>
}

templ ReportEnd(endOfReport templ.Component) {
	<div>
		@endOfReport
	</div>
	<div class="mt-6 text-center font-bold text-gray-700 print:mt-4 print:text-[9pt]">
		*** KRAJ IZVEŠTAJA ***
	</div>
}

// Footer
templ ReportFooter(parameters domain.ReportParameters) {
	<div class="mt-1 pt-1 border-t-2 border-gray-300 text-center text-xs text-gray-600 space-y-1 print:m-0 print:mt-2 print:pt-1 print:text-[7pt] print:space-y-0 print:border-t print:border-gray-300">
		<p class="print:leading-tight">
			Generated on { time.Now().Format("January 2, 2006") } at { time.Now().Format("15:04:05") }
			by { parameters.UserName }
		</p>
		<p class="text-gray-500 print:text-gray-600 print:leading-tight">
			{ parameters.CompanyName } • Confidential
		</p>
	</div>
}

templ ReportPaginationScript() {
	<script>
		async function exportToPDF() {
			// Show loading state
			const btn = event.target;
			const originalText = btn.innerText;
			btn.innerText = 'Generating PDF...';
			btn.disabled = true;
			
			try {
				// Dynamic import for better performance
				const html2pdf = (await import('https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js')).default;
				
				const element = document.querySelector('.print-container') || document.querySelector('.bg-white');
				const opt = {
					margin: [0.6, 0.5, 0.6, 0.5], // top, right, bottom, left (in inches)
					filename: '{ parameters.ReportName }.pdf',
					image: { type: 'jpeg', quality: 0.98 },
					html2canvas: { scale: 2, letterRendering: true, useCORS: true },
					jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
				};
				await html2pdf().set(opt).from(element).save();
			} catch (error) {
				console.error('PDF generation failed:', error);
				// Fallback to print
				window.print();
			} finally {
				btn.innerText = originalText;
				btn.disabled = false;
			}
		}
		
		function updatePageNumbers() {
			const currentPageSpan = document.getElementById('current-page');
			const totalPagesSpan = document.getElementById('total-pages');
			
			if (!currentPageSpan || !totalPagesSpan) return;
			
			// Calculate total pages
			const pageHeight = 1123;
			const totalHeight = document.body.scrollHeight;
			const totalPages = Math.max(1, Math.ceil(totalHeight / pageHeight));
			totalPagesSpan.textContent = totalPages;
			
			// Calculate current page based on scroll
			const scrollPosition = window.scrollY;
			const currentPage = Math.min(totalPages, Math.max(1, Math.floor(scrollPosition / pageHeight) + 1));
			currentPageSpan.textContent = currentPage;
			
			// Update all page info elements
			document.querySelectorAll('.page-info').forEach(el => {
				if (el.id !== 'page-info-header') {
					el.textContent = `Stranica ${currentPage} / ${totalPages}`;
				}
			});
			
			// Store for print
			window._totalPages = totalPages;
		}
		
		// Debounced update
		let timeout;
		function debouncedUpdate() {
			clearTimeout(timeout);
			timeout = setTimeout(updatePageNumbers, 100);
		}
		
		// Watch for content changes
		const observer = new MutationObserver(debouncedUpdate);
		observer.observe(document.body, {
			childList: true,
			subtree: true,
			attributes: true,
			attributeFilter: ['style', 'class']
		});
		
		// Event listeners
		window.addEventListener('scroll', debouncedUpdate);
		window.addEventListener('resize', debouncedUpdate);
		window.addEventListener('load', updatePageNumbers);
		
		// Initial update
		updatePageNumbers();
		
	</script>
}

templ ReportKeyboardShortcutsScript() {
	<script>
		document.addEventListener('keydown', (e) => {
			// Ctrl/Cmd + P for print
			if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
				e.preventDefault();
				window.print();
			}
			// Ctrl/Cmd + Shift + E for export
			if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'E') {
				e.preventDefault();
				exportToPDF();
			}
			// Escape to close
			if (e.key === 'Escape') {
				window.close();
			}
		});
	</script>
}
