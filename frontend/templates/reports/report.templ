package reports

import (
	"helia/internal/domain"
	"time"
	"helia/i18n"
	"fmt"
)

// Main Report Template
templ Report(parameters domain.ReportParameters, tableData domain.TableData, translator *i18n.Service) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<title>{ parameters.ReportName } - { parameters.CompanyName }</title>
			<style>
				@page {
					size: A4;
					margin: 12mm;
				}
				@media print {
					* {
						box-sizing: border-box;
					}
					html, body {
						margin: 0 !important;
						padding: 0 !important;
						width: 100% !important;
						height: auto !important;
						background: white !important;
					}
					body {
						font-size: 10pt;
					}
					.no-print {
						display: none !important;
					}
					.page-break {
						page-break-after: always;
					}
					.print-container {
						max-width: 100% !important;
						width: 100% !important;
						margin: 0 !important;
						padding: 0 !important;
						page-break-after: avoid;
					}
					table {
						page-break-inside: auto;
						width: 100%;
						table-layout: auto;
						border-collapse: collapse;
						font-size: 9pt;
					}
					tr {
						page-break-inside: avoid;
					}
					td, th {
						word-wrap: break-word;
						word-break: break-word;
						white-space: normal;
						padding: 4px 2px;
						overflow-wrap: break-word;
						page-break-inside: avoid;
					}
					th {
						background-color: #f0f0f0;
						font-weight: bold;
					}
				}
				table {
					width: 100%;
					table-layout: auto;
					border-collapse: collapse;
				}
				td, th {
					word-wrap: break-word;
					word-break: break-word;
					white-space: normal;
					overflow-wrap: break-word;
				}
				body {
					font-family: Arial, sans-serif;
				}
			</style>
		</head>
		<body class="bg-gray-100 print:bg-white">
			<!-- Print Controls -->
			<div class="fixed top-4 right-4 z-50 bg-white p-3 rounded shadow-lg flex gap-2 no-print">
				<button
					onclick="window.print()"
					class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm font-semibold"
				>
					🖨️ { translator.Label("Stampaj") }
				</button>
				<button
					onclick="window.close()"
					class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm font-semibold"
				>
					❌ { translator.Label("Zatvori") }
				</button>
			</div>

			<!-- Main Report Container -->
			<div class="py-6 px-4 print:py-0 print:px-0 print-container">
				<div class="bg-white rounded-lg shadow-lg p-8 print:shadow-none print:rounded-none print:p-6 max-w-6xl mx-auto print:mx-0 print:max-w-full">
					<!-- Header: Company Info, Date/Time, Page -->
					@ReportHeader(parameters)
					
					<!-- Report Title -->
					@ReportTitle(parameters)
					
					<!-- Report Parameters as Headers (Two Columns) -->
					@ReportParametersHeader(parameters)
					
					<!-- Report Data/Table -->
					@ReportTableSection(tableData, translator)
					
					<!-- Footer -->
					@ReportFooter(parameters)
				</div>
			</div>
		</body>
	</html>
}

// Header with Company Info (Left), Date/Time and Page (Right)
templ ReportHeader(parameters domain.ReportParameters) {
	<div class="mb-6 border-b-2 border-gray-300 pb-4">
		<div class="flex justify-between items-start">
			<!-- Left: Company Info -->
			<div class="text-xs text-gray-700 space-y-0.5">
				<p class="font-bold text-sm">{ parameters.CompanyName }</p>
				<p class="text-gray-600">Nov Sad - { fmt.Sprintf("%d", time.Now().Year()) } godine</p>
			</div>
			
			<!-- Right: Date/Time and Page Info -->
			<div class="text-xs text-gray-700 text-right space-y-0.5">
				<p>{ time.Now().Format("02.01.2006 15:04:05") }</p>
				<p class="print:hidden page-info" id="page-info">Stranica 1 / </p>
			</div>
		</div>
	</div>
}

// Report Title
templ ReportTitle(parameters domain.ReportParameters) {
	<div class="mb-6 text-center">
		<h1 class="text-2xl font-bold text-gray-900 uppercase">
			{ parameters.ReportName }
		</h1>
	</div>
}

// Report Parameters as Two-Column Headers
templ ReportParametersHeader(parameters domain.ReportParameters) {
	<div class="mb-6 grid grid-cols-2 gap-6">
		<!-- Left Column -->
		<div class="space-y-2 text-sm">
			for key, value := range parameters.Parameters {
				if key == "DateFrom" || key == "PlaceFrom" || key == "Department" {
					<div class="flex">
						<span class="font-semibold text-gray-700 w-24">{ key }:</span>
						<span class="text-gray-600">{ fmt.Sprintf("%v", value) }</span>
					</div>
				}
			}
		</div>
		
		<!-- Right Column -->
		<div class="space-y-2 text-sm">
			for key, value := range parameters.Parameters {
				if key != "DateFrom" && key != "PlaceFrom" && key != "Department" {
					<div class="flex">
						<span class="font-semibold text-gray-700 w-24">{ key }:</span>
						<span class="text-gray-600">{ fmt.Sprintf("%v", value) }</span>
					</div>
				}
			}
		</div>
	</div>
}

// Report Table Section - uses ReportTable from tablereport.templ
templ ReportTableSection(tableData domain.TableData, translator *i18n.Service) {
	<div class="mb-8">
		@ReportTable(tableData, translator)
	</div>
}

// Group Template (for grouped report data)
templ ReportGroup(groupName string, groupData interface{}) {
	<div class="mt-6 mb-4">
		<h3 class="text-lg font-bold text-gray-800 bg-gray-100 px-3 py-2 border-l-4 border-blue-900">
			{ groupName }
		</h3>
	</div>
}

// Subgroup Template (for nested grouping)
templ ReportSubgroup(subgroupName string, subgroupData interface{}) {
	<div class="mt-4 mb-2 ml-4">
		<h4 class="text-base font-semibold text-gray-700 bg-gray-50 px-3 py-1 border-l-4 border-gray-400">
			{ subgroupName }
		</h4>
	</div>
}

// Footer
templ ReportFooter(parameters domain.ReportParameters) {
	<div class="mt-8 pt-6 border-t-2 border-gray-300 text-center text-xs text-gray-600 space-y-1">
		<p>
			Generated on { time.Now().Format("January 2, 2006") } at { time.Now().Format("15:04:05") }
			 by { parameters.UserName }
		</p>
		<p class="text-gray-500">
			{ parameters.CompanyName } • Confidential
		</p>
	</div>
}

// Pagination script (add this to generate page info)
templ ReportPaginationScript() {
	<script>
		function updatePageNumbers() {
			const pageInfo = document.getElementById('page-info');
			if (pageInfo && window.print) {
				// This is a simplified version - in production, calculate actual page count
				pageInfo.textContent = 'Stranica 1 / ' + Math.ceil(document.body.scrollHeight / window.innerHeight);
			}
		}
		
		window.addEventListener('beforeprint', updatePageNumbers);
		window.addEventListener('load', updatePageNumbers);
	</script>
}
