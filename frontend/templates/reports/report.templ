package reports

import (
	"fmt"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/domain"
	"time"
)

// ============================================================================
// Main Report Template
templ Report(parameters domain.ReportParameters, tableData domain.TableData, translator *i18n.Service, paramBlock templ.Component, summaryComponent templ.Component, customReport templ.Component) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="report-name" content={ parameters.ReportName }/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
			<title>{ parameters.ReportName } - { parameters.CompanyName }</title>
			<style>
			/* @page must be at top level, not inside @media print */
			    @page {
					size: A4 { parameters.Orientation };
					margin: 14mm 8mm 14mm 8mm;
					@bottom-right {
						content: "Strana: " counter(page) " / " counter(pages);
						font-size: 9pt;
						font-family: sans-serif;
						color: #374151;
						vertical-align: bottom;
						padding-bottom: 6mm;
					}
				}

				@media print {
					.page-info {
						font-size: 8pt;
						color: #374151;
					}

					html, body {
						margin: 0;
						padding: 0;
						width: 100%;
					}

					body {
						background: white;
					}

					/* Note: .no-export must NOT be hidden here — it only marks elements for the Excel
					   exporter (the export script strips them from the cloned table), and the repeating
					   page header row carries it. Hiding it in print removes the page header. */
					.no-print {
						display: none !important;
					}

					/* Repeating page header row (first row of the report table <thead>): hidden on
					   screen, a real table row in print so the browser repeats it on every page. */
					tr.report-repeat-header {
						display: table-row !important;
					}

					.print-container {
						width: 100%;
						margin: 0;
						padding: 0;
						background: white;
					}

					.no-break {
						page-break-inside: avoid;
						break-inside: avoid;
					}

					table {
						width: 100%;
						border-collapse: collapse;
						page-break-inside: auto;
						table-layout: fixed;
					}

					/* Repeat header on each printed page */
					thead {
						display: table-header-group;
					}

					tbody {
						display: table-row-group;
					}

					thead tr {
						page-break-inside: avoid;
						page-break-after: avoid;
					}

					tr.group-header {
						page-break-inside: avoid;
						page-break-after: avoid;
					}

					tr.subgroup-header {
						page-break-inside: avoid;
						page-break-after: auto;
					}

					tr.group-total {
						page-break-inside: avoid;
						page-break-after: avoid;
					}

					tr.grand-total {
						page-break-inside: avoid;
					}

					tr {
						page-break-inside: auto;
					}

					tfoot {
						display: table-row-group;
						page-break-inside: avoid;
					}
				}

				@media screen {
					.page-break {
						width: 210mm;
						margin: 10px auto;
						padding: 15mm;
						background: white;
						box-shadow: 0 0 10px rgba(0,0,0,0.1);
						min-height: 297mm;
					}
				}
			</style>
		</head>
		<body class="bg-gray-100 mb-4 print:bg-white print:h-auto font-sans">
			<!-- Print Controls -->
			<div class="fixed top-2 right-2 z-50 bg-white p-2 rounded shadow-lg flex gap-2 items-center print:hidden no-export">
				<button
					onclick="window.print()"
					class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm font-semibold"
				>
					🖨️ { translator.Button("Stampa") }
				</button>
				<button onclick="exportToExcel(event)" class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 text-sm font-semibold">
					📊 Export Excel
				</button>
				<button
					onclick="window.close()"
					class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm font-semibold"
				>
					❌ { translator.Button("Zatvori") }
				</button>
			</div>
			<!-- Main Report Container -->
			<div class="py-2 px-4 print:py-0 print:px-0 print:w-full print:m-0 print:p-0">
				<div class="bg-white rounded-lg shadow-lg px-8 py-10 print:shadow-none print:rounded-none print:p-0 max-w-full mx-auto print:mx-0 print:bg-white overflow-x-auto print:overflow-visible">
					if customReport != nil {
						@customReport
					} else {
						@ReportContent(parameters, paramBlock, tableData, translator, summaryComponent)
					}
				</div>
			</div>
			@ReportExcelExportScript()
			@ReportKeyboardShortcutsScript()
			@tmpl.OpenPrintWithParamsScript()
		</body>
	</html>
}
// Header with Company Info (Left), Date/Time and Page (Right)
templ ReportHeader(parameters domain.ReportParameters) {
	<div class="mb-2 border-b-2 border-gray-300 print:m-0 print:mb-1 print:pb-1 print:border-b print:border-gray-300">
		<div class="flex justify-between items-start">
			<!-- Left: Company Info -->
			<div class="text-xs text-gray-700 space-y-0.5 print:text-[9pt]">
				<p class="font-bold text-sm print:text-sm print:leading-tight">{ parameters.CompanyName }</p>
				<p class="text-xs text-black print:text-black print:text-xs">{ parameters.Adress }, { parameters.Postcode } { parameters.City } - { fmt.Sprintf("%d", time.Now().Year()) } godine</p>
			</div>
			<!-- Right: Date/Time and Page Info -->
			<div class="text-xs text-gray-700 text-right space-y-0.5 print:text-[8pt]">
				<p class="print:leading-tight">{ time.Now().Format("02.01.2006 15:04:05") }</p>
			</div>
		</div>
		<!-- Column 3 (2/12): date/time and page (browser/CSS handles page number) -->
		<div class="text-right col-span-2">
			<div class="page-info">{ time.Now().Format("02.01.2006 15:04:05") }</div>
		</div>
	</div>
}
// Report Title
templ ReportTitle(parameters domain.ReportParameters) {
	<div class="mb-1 text-center print:m-0 print:mb-1">
		<h2 class="text-xl font-bold text-gray-900 uppercase print:text-base print:leading-tight">
			{ parameters.ReportName }
		</h2>
	</div>
}
// ============================================================================
// Repeating Page Header (3 / 8 / 1 grid)
// ============================================================================

// ReportPageHeader renders the header content that repeats on every printed
// page: company info (3/12) | report title + parameters (8/12) | date & time
// (1/12). This is the single source of truth for that content — it's used
// both inside <thead> for print (see ReportTableHeadWithPageHeader in
// tablereport.templ) and, unconditionally, for the screen preview via
// ReportPageHeaderScreen below.
templ ReportPageHeader(repParams domain.ReportParameters, paramBlock templ.Component, translator *i18n.Service) {
	<!-- 12-col grid: 2/12 | 8/12 | 2/12. The outer columns MUST stay equal, otherwise the centre column
	     (and the title inside it) ends up off-centre on the page. -->
	<div class="grid grid-cols-12 items-start gap-2 text-[10px] w-full">
		<!-- Column 1 (2/12): company info -->
		<div class="text-left col-span-2">
			<div class="font-bold text-sm print:text-sm print:leading-tight">{ repParams.CompanyName }</div>
			<div class="print:leading-tight">
				{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", time.Now().Year()) }. { translator.Label("godina") }
			</div>
		</div>
		<!-- Column 2 (8/12): title + parameters, centred on the page (2/12 + 4/12 = 6/12) -->
		<div class="text-center col-span-8">
			<h1 class="text-[14px] font-bold tracking-wide uppercase print:leading-tight">{ repParams.ReportName }</h1>
			<!-- Centred parameter block with no bottom margin of its own ([&>*]:!mb-0 neutralises the
			     margins of the parameter components) so no blank line shows up above the table. -->
			<div class="mt-0.5 flex flex-col items-center [&>*]:max-w-full [&>*]:!mb-0">
				if paramBlock != nil {
					@paramBlock
				} else if len(repParams.ParameterItems) > 0 {
					@ReportPageHeaderParams(repParams)
				}
			</div>
		</div>
		<!-- Column 3 (2/12): date & time; page number comes from the @page counter -->
		<div class="text-right col-span-2">
			<div class="page-info whitespace-nowrap">{ time.Now().Format("02.01.2006") }</div>
			<div class="page-info whitespace-nowrap">{ time.Now().Format("15:04:05") }</div>
		</div>
	</div>
}

// ReportPageHeaderParams renders ReportParameters.ParameterItems as centred
// inline items; used when the caller doesn't supply its own paramBlock.
templ ReportPageHeaderParams(repParams domain.ReportParameters) {
	<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 text-[10px] print:text-[9pt] leading-tight print:gap-x-2 print:gap-y-0">
		for _, param := range repParams.ParameterItems {
			<span class="whitespace-nowrap">
				if param.Name != "" {
					<span class="font-semibold">{ param.Name }</span>
					<span>:</span>
				}
				<span class="font-bold">{ param.Value }</span>
			</span>
		}
	</div>
}

// ReportPageHeaderScreen renders the same header content for the on-screen
// preview, hidden on print (print:hidden) since the print copy is rendered
// separately inside the table's <thead> so it repeats on every page.
templ ReportPageHeaderScreen(repParams domain.ReportParameters, paramBlock templ.Component, translator *i18n.Service) {
	<div class="print:hidden mb-1 pb-1 border-b border-gray-300">
		@ReportPageHeader(repParams, paramBlock, translator)
	</div>
}

// ============================================================================
// Content orchestration (default, non-customReport path)
// ============================================================================
templ ReportContent(repParams domain.ReportParameters, paramBlock templ.Component, tableData domain.TableData, translator *i18n.Service, summaryComponent templ.Component) {
	@ReportPageHeaderScreen(repParams, paramBlock, translator)
	<div class="overflow-x-auto print:overflow-visible print:mt-0 print:mb-4 print:mx-0">
		@ReportTableWithPageHeader(tableData, translator, ReportPageHeader(repParams, paramBlock, translator))
	</div>
	if summaryComponent != nil {
		<!-- Page break: gray gap on screen, real break on print -->
		<div class="print:hidden -mx-8 h-16 bg-gray-200 border-y border-gray-300"></div>
		<div class="hidden print:block" style="break-before: page;"></div>
		<div class="pt-10 print:pt-8 no-break">
			@summaryComponent
		</div>
	}
	@ReportEnd(nil)
	@ReportFooter(repParams)
}

// ============================================================================
// End-of-report marker
// ============================================================================
templ ReportEnd(endOfReport templ.Component) {
	if endOfReport != nil {
		<div class="mt-2">
			@endOfReport
		</div>
		<div class="mt-6 text-left text-gray-700 print:mt-4 print:text-[7pt] no-break">
			*** KRAJ IZVEŠTAJA ***
		</div>
	} else {
		<div class="mt-6 text-left text-xs text-gray-700 print:mt-4 print:text-[7pt] no-break">
			*** KRAJ IZVEŠTAJA ***
		</div>
	}
}

// ============================================================================
// Footer
// ============================================================================
templ ReportFooter(parameters domain.ReportParameters) {
	<div class="mt-1 pt-1 border-t-2 border-gray-300 text-center text-xs text-gray-600 space-y-1 print:m-0 print:mt-2 print:pt-1 print:text-[7pt] print:space-y-0 print:border-t print:border-gray-300 no-break">
		<p class="print:leading-tight">
			Generated on { time.Now().Format("January 2, 2006") } at { time.Now().Format("15:04:05") }
			by { parameters.UserName }
		</p>
		<p class="text-gray-500 print:text-gray-600 print:leading-tight">
			{ parameters.CompanyName } • Confidential
		</p>
	</div>
}


// ============================================================================
// Client-side scripts
// ============================================================================
templ ReportExcelExportScript() {
	<script>
		async function exportToExcel(event) {
			const btn = event.target;
			const originalText = btn.innerText;
			btn.innerText = 'Exporting...';
			btn.disabled = true;
			try {
				await new Promise((resolve, reject) => {
					if (window.XLSX) { resolve(); return; }
					const s = document.createElement('script');
					s.src = 'https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js';
					s.onload = resolve;
					s.onerror = reject;
					document.head.appendChild(s);
				});
				const table = document.querySelector('table');
				if (!table) { alert('No table found to export.'); return; }
				// Print-only helper rows (e.g. the repeating page header) must
				// not leak into the exported sheet.
				const exportTable = table.cloneNode(true);
				exportTable.querySelectorAll('.no-export').forEach(el => el.remove());
				const wb = XLSX.utils.table_to_book(exportTable, { sheet: 'Izvestaj', raw: false });
				const excelName = document.querySelector('meta[name="report-name"]')?.content || 'Izvestaj';
				XLSX.writeFile(wb, excelName + '.xlsx');
			} catch (error) {
				console.error('Excel export failed:', error);
				alert('Export failed: ' + error.message);
			} finally {
				btn.innerText = originalText;
				btn.disabled = false;
			}
		}
	</script>
}

templ ReportKeyboardShortcutsScript() {
	<script>
		document.addEventListener('keydown', (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
				e.preventDefault();
				window.print();
			}
			if (e.key === 'Escape') {
				window.close();
			}
		});
	</script>
}
