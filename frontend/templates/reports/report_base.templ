package reports

import (
	"fmt"
	"helia/internal/domain"
	"time"
)

templ ReportPage(tbl domain.TableData, params map[string]interface{}, company string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ tbl.ContentTitle }</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://unpkg.com/htmx.org@1.9.6"></script>
			<style>
       			@media print {
					@page {
						margin: 1cm;
						@bottom-right {
							content: "Page " counter(page) " of " counter(pages);
							font-size: 10pt;
							color: #666;
							margin-bottom: 5px;
						}
						@top-left {
							content: "-";
							font-size: 10pt;
							color: #666;
						}
					}
					.no-print {
						display: none !important;
					}
				}
			</style>
		</head>
		<body class="bg-gray-50 p-6 ">
			<!-- Print Controls -->
			<div class="fixed top-15 right-6 z-50 bg-white p-3 rounded shadow-xl flex gap-1 no-print">
				<button
					onclick="window.print()"
					class="bg-blue-600 text-white px-3 h-6 rounded hover:bg-blue-700 flex items-center gap-1 font-semibold"
				>
					<span>🖨️</span>
					<span>Stampaj</span>
				</button>
				<button
					onclick="window.close()"
					class="bg-gray-600 text-white px-3 h-6 rounded hover:bg-gray-700 flex items-center gap-1 font-semibold"
				>
					<span>❌</span>
					<span>Zatvori</span>
				</button>
			</div>
			<div id="report-container" class=" max-w-full mx-auto bg-white rounded-lg shadow-md overflow-hidden">
				@ReportHeader1(tbl, params, company)
				@ReportDetail1(tbl)
				@ReportFooter1(company, time.Now().Year(), time.Now())
			</div>
		</body>
	</html>
}

// ReportHeader, ReportDetail, ReportFooter remain unchanged as per your original code.
// (Only the template for ReportPage was modified above)
templ ReportHeader1(tbl domain.TableData, params map[string]interface{}, companyName string) {
	<div class="bg-gray-100 border-b border-gray-200 report-header p-4">
		<div class="flex justify-between items-start mb-4">
			<!-- Left side: Logo and Company Name -->
			<div class="flex items-center gap-2">
				<div class="w-8 h-8 bg-blue-100 rounded flex items-center justify-center border-2 border-blue-300">
					<span class="text-sm font-bold text-blue-600">🏢</span>
				</div>
				<h1 class="text-lg font-bold text-gray-900">Company Name Inc.</h1>
			</div>
			<!-- Right side: Date and User info -->
			<div class="text-right">
				<p class="text-xs text-gray-700">
					<span class="font-xs">📅 Datum izvestaja:</span> 05.09.2023 14:30:45
				</p>
				<p class="text-xs text-gray-700">
					<span class="font-xs">👤 Kreiran od:</span>
				</p>
			</div>
		</div>
		<!-- Second Row: Generated info -->
		<div class="flex justify-between items-center mb-1">
			<div class="text-xs text-gray-600 space-y-1">
				<p class="font-small"></p>
			</div>
		</div>
		<div class="mt-2 flex flex-wrap gap-4 text-sm text-gray-600">
			for key, value := range params {
				<p><span class="font-medium">{ key }:</span> { fmt.Sprintf("%v", value) }</p>
			}
		</div>
	</div>
}

templ ReportDetail1(tbl domain.TableData) {
	<div class="overflow-x-auto px-1 py-1">
		<table class="min-w-full max-w-full divide-y divide-gray-200 border border-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th scope="col" class="px-1 py-1 text-left text-sm font-medium text-gray-500 uppercase tracking-wider">
						#
					</th>
					for _, field := range tbl.Headers {
						<th scope="col" class="px-1 py-1 text-left text-sm font-medium text-gray-500 uppercase tracking-wider">
							{ field.Label }
						</th>
					}
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for i, row := range tbl.Rows {
					<tr class={ "odd:bg-white even:bg-gray-10 hover:bg-gray-100" }>
						<td class="whitespace-nowrap px-1 py-1 border-r border-gray-200 text-left text-sm font-medium text-gray-500 uppercase tracking-wider">
							{ fmt.Sprintf("%d", i+1) }
						</td>
						for _, field := range row.Fields {
							<td class="whitespace-nowrap px-1 py-1 border-r border-gray-200 text-left text-sm font-medium text-gray-500 uppercase tracking-wider">
								{ field }
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ ReportFooter1(company string, year int, generatedTime time.Time) {
	<div class="bg-gray-100 p-4 border-t border-gray-200 report-footer mt-auto overflow-x-auto px-6 py-4">
		<div class="flex justify-between items-center text-xs text-gray-600">
			<p>© { fmt.Sprintf("%d", year) } { company }. Sva prava zadržana.</p>
		</div>
	</div>
}
