package reports

import (
	"fmt"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/domain"
	"time"
)

// Main Report Template
templ ReportOLD(parameters domain.ReportParameters, tableData domain.TableData, translator *i18n.Service, summaryComponent templ.Component, customReport templ.Component) {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="report-name" content={ parameters.ReportName }/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
			<title>{ parameters.ReportName } - { parameters.CompanyName }</title>
			<style>
			/* @page must be at top level, not inside @media print */
			/* @top-right requires Chrome 128+ — thead::before below is the Chrome fallback */
			@page {
				size: A4 { parameters.Orientation };
				margin: 14mm 8mm 14mm 8mm;
				@bottom-right {
					content: "Strana: " counter(page) " / " counter(pages);
					font-size: 9pt;
					font-family: sans-serif;
					color: #374151;
					vertical-align: bottom;
					padding-bottom: 6mm;
				}
			}

			@media print {
				.page-info {
					font-size: 8pt;
					color: #374151;
				}
				
				/* Ensure page numbers appear on each printed page */
				.page-break {
					position: relative;
					page-break-after: always;
				}
		
				html, body {
					margin: 0;
					padding: 0;
					width: 100%;
				}
				
				body {
					background: white;
				}
				
				.no-print {
					display: none !important;
				}
				
				.print-container {
					width: 100%;
					margin: 0;
					padding: 0;
					background: white;
				}
				
				.no-break {
					page-break-inside: avoid;
				}

				/* "Nova strana po grupi" - begins the group band on a new page */
				.page-break-before {
					page-break-before: always;
					break-before: page;
				}
				
				/* Table should break naturally across pages */
				table {
					width: 100%;
					border-collapse: collapse;
					page-break-inside: auto;
					table-layout: fixed;
				}
				
				/* Repeat header on each page */
				thead {
					display: table-header-group;
					page-break-inside: avoid;
				}

				tbody {
					display: table-row-group;
				}
				
				/* Table header rows - keep with content */
				thead tr {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				/* Keep group headers with next row */
				tr.group-header {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				tr.subgroup-header {
					page-break-inside: avoid;
					page-break-after: auto;
				}
				
				tr.group-total {
					page-break-inside: avoid;
					page-break-after: avoid;
				}
				
				tr.group-footer {
					page-break-inside: avoid;
				}
				
				tr.grand-total {
					page-break-inside: avoid;
				}
				
				/* Regular data rows can break */
				tr {
					page-break-inside: auto;
				}
				
				tfoot {
					display: table-row-group;
					page-break-inside: avoid;
				}
			}
			/* Screen view */
			@media screen {
				
				.page-break {
					width: 210mm;
					margin: 10px auto;
					padding: 15mm;
					background: white;
					box-shadow: 0 0 10px rgba(0,0,0,0.1);
					min-height: 297mm;
				}
			}
		</style>
		</head>
		<body class="bg-gray-100 mb-4 print:bg-white print:h-auto font-sans">
			<!-- Print Controls -->
			<div class="fixed top-2 right-2 z-50 bg-white p-2 rounded shadow-lg flex gap-2 items-center print:hidden">
				<button
					onclick="window.print()"
					class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm font-semibold"
				>
					🖨️ { translator.Button("Stampa") }
				</button>
				<button onclick="exportToExcel()" class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 text-sm font-semibold">
					📊 Export Excel
				</button>
				<button
					onclick="window.close()"
					class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm font-semibold"
				>
					❌ { translator.Button("Zatvori") }
				</button>
			</div>
			<!-- Main Report Container -->
			<div class="py-2 px-4 print:py-0 print:px-0 print:w-full print:m-0 print:p-0">
				<div class="bg-white rounded-lg shadow-lg px-8 py-10 print:shadow-none print:rounded-none print:p-0 max-w-full mx-auto print:mx-0 print:bg-white overflow-x-auto print:overflow-visible">
					if customReport != nil {
						@customReport
					} else {
						<!-- Header: Company Info, Date/Time, Page -->
						@ReportHeaderOLD(parameters)
						<!-- Report Title -->
						@ReportTitleOLD(parameters)
						<!-- Report Parameters as Headers (Two Columns) -->
						@ReportParametersHeaderOLD(parameters)
						<!-- Report Data/Table -->
						@ReportTableSectionOLD(tableData, translator)
						if summaryComponent != nil {
							<!-- Page break: gray gap on screen, real break on print -->
							<div class="print:hidden -mx-8 h-16 bg-gray-200 border-y border-gray-300"></div>
							<div class="hidden print:block" style="page-break-before: always;"></div>
							<!-- Summary Section (e.g., Totals, Averages) -->
							<div class="pt-10 print:pt-8">
								@summaryComponent
							</div>
						}
						<!-- Footer -->
						@ReportFooterOLD(parameters)
					}
				</div>
			</div>
			@ReportPaginationScript()
			@ReportKeyboardShortcutsScriptOLD()
			@tmpl.OpenPrintWithParamsScript()
		</body>
	</html>
}

// Header with Company Info (Left), Date/Time and Page (Right)
templ ReportHeaderOLD(parameters domain.ReportParameters) {
	<div class="mb-2 border-b-2 border-gray-300 print:m-0 print:mb-1 print:pb-1 print:border-b print:border-gray-300">
		<div class="flex justify-between items-start">
			<!-- Left: Company Info -->
			<div class="text-xs text-gray-700 space-y-0.5 print:text-[9pt]">
				<p class="font-bold text-sm print:text-sm print:leading-tight">{ parameters.CompanyName }</p>
				<p class="text-xs text-black print:text-black print:text-xs">{ parameters.Adress }, { parameters.Postcode } { parameters.City } - { fmt.Sprintf("%d", time.Now().Year()) } godine</p>
			</div>
			<!-- Right: Date/Time and Page Info -->
			<div class="text-xs text-gray-700 text-right space-y-0.5 print:text-[8pt]">
				<p class="print:leading-tight">{ time.Now().Format("02.01.2006 15:04:05") }</p>
			</div>
		</div>
		<!-- Column 3 (2/12): date/time and page (browser/CSS handles page number) -->
		<div class="text-right col-span-2">
			<div class="page-info">{ time.Now().Format("02.01.2006 15:04:05") }</div>
		</div>
	</div>
}

// Report Title
templ ReportTitleOLD(parameters domain.ReportParameters) {
	<div class="mb-1 text-center print:m-0 print:mb-1">
		<h2 class="text-xl font-bold text-gray-900 uppercase print:text-base print:leading-tight">
			{ parameters.ReportName }
		</h2>
	</div>
}

// Report Parameters as Two-Column Headers
templ ReportParametersHeaderOLD(parameters domain.ReportParameters) {
	<div class="mb-1 grid grid-cols-2 gap-1 print:gap-2 print:m-0 print:mb-2 print:pb-1 print:border-b print:border-gray-300">
		for _, param := range parameters.ParameterItems {
			<div class="flex gap-1 items-center text-sm text-gray-700 print:text-[8pt] print:leading-tight">
				if param.Name != "" {
					<span class="font-semibold">{ param.Name }:</span>
				} else {
					<span></span>
				}
				<span class="font-bold">{ param.Value }</span>
			</div>
		}
	</div>
}

// Report Table Section - uses ReportTable from tablereport.templ
templ ReportTableSectionOLD(tableData domain.TableData, translator *i18n.Service) {
	<div class="mb-1 overflow-x-auto print:overflow-visible print:mt-4 print:mb-4 print:mx-0">
		@ReportTableOLD(tableData, translator)
	</div>
}

// ReportPageHeaderOLD renders the report page header in a 2/12 | 8/12 | 2/12 grid: the company data on
// the left, the report title - with the parameters the report was run with directly below it - in the
// centre and the print timestamp on the right.
//
// It is rendered twice by every report: once inside a screen-only div (ReportPageHeaderScreen / the
// screen preview of ReportContent) and once as the repeating print header row of the report table
// (ReportTableWithPageHeader / ReportTableHeadWithPageHeader), which makes the browser repeat it at
// the top of every printed page.
templ ReportPageHeaderOLD(repParams domain.ReportParameters, paramBlock templ.Component, translator *i18n.Service) {
	<!-- 12-col grid: 2/12 | 8/12 | 2/12 - identical on screen, in print and in the PDF export -->
	<div class="grid grid-cols-12 items-start gap-2 text-[10px] mb-2">
		<!-- Column 1 (2/12): Company data -->
		<div class="text-left col-span-2">
			<div class="font-bold text-sm print:text-sm print:leading-tight">{ repParams.CompanyName }</div>
			<div class="print:leading-tight">{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", time.Now().Year()) }. { translator.Label("godina") }</div>
		</div>
		<!-- Column 2 (8/12): report title with the parameters the report was run with, directly below it -->
		<div class="text-center col-span-8">
			<h1 class="text-[14px] font-bold tracking-wide uppercase print:leading-tight">{ repParams.ReportName }</h1>
			<!-- Centred parameter block; [&>*]:max-w-full keeps wide parameter tables inside the column. -->
			<div class="mt-0.5 mb-1 flex flex-col items-center [&>*]:max-w-full">
				if paramBlock != nil {
					@paramBlock
				} else if len(repParams.ParameterItems) > 0 {
					@ReportPageHeaderParamsOLD(repParams)
				}
			</div>
		</div>
		<!-- Column 3 (2/12): date and time; the page number is added by the @page rule. -->
		<div class="text-right col-span-2">
			<div class="page-info">{ time.Now().Format("02.01.2006 15:04:05") }</div>
		</div>
	</div>
}

// ReportPageHeaderParamsOLD renders ReportParameters.ParameterItems as centred inline items; used for the
// reports that do not render their own parameter component.
templ ReportPageHeaderParamsOLD(repParams domain.ReportParameters) {
	<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 text-[10px] print:text-[9pt] leading-tight print:gap-x-2 print:gap-y-0">
		for _, param := range repParams.ParameterItems {
			<span class="whitespace-nowrap">
				if param.Name != "" {
					<span class="font-semibold">{ param.Name }</span>
					<span>:</span>
				}
				<span class="font-bold">{ param.Value }</span>
			</span>
		}
	</div>
}

// ReportPageHeaderScreenOLD renders the screen-only copy of the repeating page header. The print copy is
// rendered by the report's own table <thead> (ReportTableHeadWithPageHeader), so the header appears at
// the top of every printed page.
templ ReportPageHeaderScreenOLD(repParams domain.ReportParameters, paramBlock templ.Component, translator *i18n.Service) {
	<div class="print:hidden">
		@ReportPageHeaderOLD(repParams, paramBlock, translator)
	</div>
}

// ReportContentWithPageHeader renders the standard report body for the reports whose table uses the
// shared row renderer: the screen preview header, the table with the repeating print header and the
// end-of-report marker.
templ ReportContentWithPageHeader(repParams domain.ReportParameters, paramBlock templ.Component, tbl domain.TableData, translator *i18n.Service) {
	@ReportPageHeaderScreenOLD(repParams, paramBlock, translator)
	<div class="mb-1 overflow-x-auto print:overflow-visible print:mt-4 print:mb-4 print:mx-0">
		@ReportTableWithPageHeader(tbl, translator, ReportPageHeaderScreenOLD(repParams, paramBlock, translator))
	</div>
	@ReportEndOLD(nil)
}

// Group Template (for grouped report data)
templ ReportGroup(groupName string, groupData interface{}) {
	<div class="mt-2 mb-4">
		<h3 class="text-lg font-bold text-gray-800 bg-gray-100 px-3 py-2 border-l-4 border-blue-900">
			{ groupName }
		</h3>
	</div>
}

// Subgroup Template (for nested grouping)
templ ReportSubgroup(subgroupName string, subgroupData interface{}) {
	<div class="mt-4 mb-2 ml-4">
		<h4 class="text-base font-semibold text-gray-700 bg-gray-50 px-3 py-1 border-l-4 border-gray-400">
			{ subgroupName }
		</h4>
	</div>
}

templ ReportEndOLD(endOfReport templ.Component) {
	if endOfReport != nil {
		<div class="mt-2">
			@endOfReport
		</div>
		<div class="mt-6 text-left text-gray-700 print:mt-4 print:text-[7pt]">
			*** KRAJ IZVEŠTAJA ***
		</div>
	} else {
		<div class="mt-6 text-left text-xs text-gray-700 print:mt-4 print:text-[7pt]">
			*** KRAJ IZVEŠTAJA ***
		</div>
	}
}

// Footer
templ ReportFooterOLD(parameters domain.ReportParameters) {
	<div class="mt-1 pt-1 border-t-2 border-gray-300 text-center text-xs text-gray-600 space-y-1 print:m-0 print:mt-2 print:pt-1 print:text-[7pt] print:space-y-0 print:border-t print:border-gray-300">
		<p class="print:leading-tight">
			Generated on { time.Now().Format("January 2, 2006") } at { time.Now().Format("15:04:05") }
			by { parameters.UserName }
		</p>
		<p class="text-gray-500 print:text-gray-600 print:leading-tight">
			{ parameters.CompanyName } • Confidential
		</p>
	</div>
}

templ ReportPaginationScript() {
	<script>
		async function exportToExcel() {
			const btn = event.target;
			const originalText = btn.innerText;
			btn.innerText = 'Exporting...';
			btn.disabled = true;
			try {
				// Load SheetJS from CDN
				await new Promise((resolve, reject) => {
					if (window.XLSX) { resolve(); return; }
					const s = document.createElement('script');
					s.src = 'https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js';
					s.onload = resolve;
					s.onerror = reject;
					document.head.appendChild(s);
				});
				// Find the first table in the report container
				const table = document.querySelector('table');
				if (!table) { alert('No table found to export.'); return; }
				// Print-only helper rows (e.g. repeating print headers) must not leak into the sheet
				const exportTable = table.cloneNode(true);
				exportTable.querySelectorAll('.no-export').forEach(el => el.remove());
				const wb = XLSX.utils.table_to_book(exportTable, { sheet: 'Izvestaj', raw: false });
				const excelName = document.querySelector('meta[name="report-name"]')?.content || 'Izvestaj';
				XLSX.writeFile(wb, excelName + '.xlsx');
			} catch (error) {
				console.error('Excel export failed:', error);
				alert('Export failed: ' + error.message);
			} finally {
				btn.innerText = originalText;
				btn.disabled = false;
			}
		}

		function updatePageNumbers() {
			const currentPageSpan = document.getElementById('current-page');
			const totalPagesSpan = document.getElementById('total-pages');
			
			// A4 page height at 96dpi minus margins (~24mm total vertical margin)
			const pageHeightPx = (297 - 24) * 96 / 25.4;
			const totalHeight = document.body.scrollHeight;
			const totalPages = Math.max(1, Math.ceil(totalHeight / pageHeightPx));
			
			const scrollPosition = window.scrollY;
			const currentPage = Math.min(totalPages, Math.max(1, Math.floor(scrollPosition / pageHeightPx) + 1));
			
			if (currentPageSpan) currentPageSpan.textContent = currentPage;
			if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
			
			// Store for print
			window._totalPages = totalPages;
		}
		
		// Debounced update
		let timeout;
		function debouncedUpdate() {
			clearTimeout(timeout);
			timeout = setTimeout(updatePageNumbers, 100);
		}
		
		// Watch for content changes
		const observer = new MutationObserver(debouncedUpdate);
		observer.observe(document.body, {
			childList: true,
			subtree: true,
			attributes: true,
			attributeFilter: ['style', 'class']
		});
		
		// Event listeners
		window.addEventListener('scroll', debouncedUpdate);
		window.addEventListener('resize', debouncedUpdate);
		window.addEventListener('load', updatePageNumbers);
		
		// Initial update
		updatePageNumbers();
		
	</script>
}

templ ReportKeyboardShortcutsScriptOLD() {
	<script>
		document.addEventListener('keydown', (e) => {
			// Ctrl/Cmd + P for print
			if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
				e.preventDefault();
				window.print();
			}
			// Escape to close
			if (e.key === 'Escape') {
				window.close();
			}
		});
	</script>
}
