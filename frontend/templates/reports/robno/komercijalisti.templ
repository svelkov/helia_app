package robno

import (
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/domain"
)

// KomercijalistiStampa renders a printable Komercijalisti report.
templ KomercijalistiStampa(repParams domain.ReportParameters, tbl domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, KomercijalistiContent(repParams, tbl, translator))
}

templ KomercijalistiContent(repParams domain.ReportParameters, tbl domain.TableData, translator *i18n.Service) {
	@rep.ReportHeader(repParams)
	@rep.ReportTitle(repParams)
	@rep.ReportTableSection(tbl, translator)
	@rep.ReportEnd(nil)
}
