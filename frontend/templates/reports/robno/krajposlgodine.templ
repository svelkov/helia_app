package robno

import (
	"fmt"
	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/domain"
)

templ KrajPoslovneGodineStampa(params domain.KrajPoslovneGodineParams, tbl domain.TableData, rp domain.ReportParameters, translator *i18n.Service) {
	@rep.Report(rp, tbl, translator, KrajPoslovneGodineParam(params, translator), nil, KrajPoslovneGodineContent(params, tbl, rp, translator))
}

templ ROB_RPT_POPISNALISTA(params domain.KrajPoslovneGodineParams, tbl domain.TableData, translator *i18n.Service) {
	@KrajPoslovneGodineStampa(params, tbl, domain.ReportParameters{ReportName: "POPISNALISTA"}, translator)
}

templ ROB_RPT_POPISNALISTA2(params domain.KrajPoslovneGodineParams, tbl domain.TableData, translator *i18n.Service) {
	@KrajPoslovneGodineStampa(params, tbl, domain.ReportParameters{ReportName: "POPISNALISTA2"}, translator)
}

templ KrajPoslovneGodineContent(params domain.KrajPoslovneGodineParams, tbl domain.TableData, rp domain.ReportParameters, translator *i18n.Service) {
	@rep.ReportContentWithPageHeader(rp, KrajPoslovneGodineParam(params, translator), tbl, translator)
}

// KrajPoslovneGodineParam prints the magacin and konto range the report was run with; it is rendered
// inside the centre column of the report header, directly below the report title.
templ KrajPoslovneGodineParam(params domain.KrajPoslovneGodineParams, translator *i18n.Service) {
	<div class="text-[10px] print:text-[9pt] leading-tight">
		<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 print:gap-x-2 print:gap-y-0">
			<span class="whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Magacin") }</span>
				<span class="font-bold">{ fmt.Sprint(params.Magacin) }</span>
			</span>
			<span class="whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Konto") }</span>
				<span class="font-bold">{ params.OdKonta }</span>
				<span class="font-bold">-</span>
				<span class="font-bold">{ params.DoKonta }</span>
			</span>
		</div>
	</div>
}
