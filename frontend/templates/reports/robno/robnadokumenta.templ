package robno

import (
	"fmt"
	"strings"
	"time"

	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/domain"
)

// RobnoDokumentaPrikazUkupneObradeStampa renders the printable "Prikaz ukupne obrade" report (tab 6
templ RobnoDokumentaPrikazUkupneObradeStampa(repParams domain.ReportParameters, tbl domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, nil, nil, nil)
}

// RobnoDokumentaPrikazNalogaStampa renders the printable "Prikaz naloga" report (tab 7): the robni
// nalozi of the selection, the same grid the tab shows. paramItems is the selection, rendered in the
// order the handler passes it (ReportParameters.ParameterItems is a map and is iterated randomly).
templ RobnoDokumentaPrikazNalogaStampa(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoDokumentaPrikazNalogaParametri(paramItems), nil, nil)
}

// RobnoDokumentaPrikazDokumenataUNaloguStampa renders the printable "Prikaz dokumenata u nalogu"
// report (tab 8): the robni dokumenti of the selection, the same grid the tab shows.
templ RobnoDokumentaPrikazDokumenataUNaloguStampa(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoDokumentaPrikazNalogaParametri(paramItems), nil, nil)
}

// RobnoDokumentaPrikazDokumenataPoOperateruStampa renders the printable "Prikaz dokumenata po
// operateru" report (tab 9): the per-operater summary of the selection, the same grid the tab shows.
templ RobnoDokumentaPrikazDokumenataPoOperateruStampa(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoDokumentaPrikazNalogaParametri(paramItems), nil, nil)
}

// RobnoDokumentaPregledStampaStampa renders the printable "Pregled dokumenta - Štampa" report (tab
// 2): the robni dokumenti of the selection, the same grid the sub-tab shows. paramItems is the
// selection, rendered in the order the handler passes it.
templ RobnoDokumentaPregledStampaStampa(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoDokumentaPrikazNalogaParametri(paramItems), nil, nil)
}

// RobnoDokumentaPrikazNalogaParametri renders the parameters of the prints of the tabs "Prikaz
// naloga" (7), "Prikaz dokumenata u nalogu" (8) and "Prikaz dokumenata po operateru" (9) in the
// order of the slice (same markup as the shared ReportPageHeaderParams, which cannot be used here
// because it renders the unordered map).
templ RobnoDokumentaPrikazNalogaParametri(items []domain.ParameterItem) {
	<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 text-[10px] print:text-[9pt] leading-tight print:gap-x-2 print:gap-y-0">
		for _, item := range items {
			<span class="whitespace-nowrap">
				if item.Name != "" {
					<span class="font-semibold">{ item.Name }</span>
					<span>:</span>
				}
				<span class="font-bold">{ item.Value }</span>
			</span>
		}
	</div>
}

//
// Tab 3 - "Specifikacije dokumenta" print: the report RobSpecifikacijaFakture
// ("SPECIFIKACIJA EKSTERNIH RACUNA")
//

// RobSpecifikacijaFakture renders the printable "Specifikacija eksternih računa" report: one row per
// stavka of the robni dokumenti of the selection, the total of every nalog, the total of the whole
// selection and the "Ambalaza" summary (the PDV per poreska stopa). The rows, the totals and the
// summary come from the service (the "nalog-total", "report-total", "ambalaza" and "ambalaza-total"
// bands of the rows); paramItems is the selection, rendered in the order the handler passes it.
templ RobSpecifikacijaFakture(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoDokumentaPrikazNalogaParametri(paramItems), nil, RobSpecifikacijaFaktureContent(repParams, tbl, paramItems, translator))
}

// RobSpecifikacijaFaktureContent renders the content of the report: the table of the selection with
// the bands the service adds to it (the totals of the nalog and of the report) and the "Ambalaza"
// summary under the table. The page header repeats on every printed page through the <thead> of the
// table; on screen it is rendered above the table (the header of the <thead> row is print only).
templ RobSpecifikacijaFaktureContent(repParams domain.ReportParameters, tbl domain.TableData, paramItems []domain.ParameterItem, translator *i18n.Service) {
	@rep.ReportPageHeaderScreen(repParams, RobnoDokumentaPrikazNalogaParametri(paramItems), translator)
	<div class="overflow-x-auto print:overflow-visible print:mt-2 print:mb-2 print:mx-0">
		<table class={ rep.ReportTableClass() }>
			@rep.ReportTableColgroup(rep.ReportColumnWidths(tbl.Headers))
			@rep.ReportTableHeadWithPageHeader(tbl, translator, rep.ReportPageHeader(repParams, RobnoDokumentaPrikazNalogaParametri(paramItems), translator))
			<tbody>
				for _, row := range tbl.Rows {
					if row.ClassRow == "nalog-total" || row.ClassRow == "report-total" {
						<!-- The total of a nalog / of the whole selection: the label over the columns before
						     the amounts and every amount in its own column, like the legacy report. -->
						<tr class="group-total bg-blue-50 font-bold border-t border-blue-900 print:bg-blue-50 print:page-break-inside-avoid">
							<td colspan={ fmt.Sprintf("%d", robSpecifikacijaFaktureAmountColumn(tbl.Headers)) } class="border border-gray-300 px-1 text-sm print:text-[9pt] print:px-1">
								if len(row.Fields) > 0 {
									{ row.Fields[0] }
								}
							</td>
							for j := robSpecifikacijaFaktureAmountColumn(tbl.Headers); j < len(row.Fields); j++ {
								<td class="border border-gray-300 px-1 text-sm print:text-[9pt] print:px-1 text-right">
									{ row.Fields[j] }
								</td>
							}
						</tr>
					} else if row.ClassRow != "ambalaza" && row.ClassRow != "ambalaza-total" {
						<!-- One stavka of a robni dokument of the selection. -->
						<tr class="print:page-break-inside-avoid">
							for j, cell := range row.Fields {
								<td class={ robSpecifikacijaFaktureCellClass(tbl.Headers, j) }>{ cell }</td>
							}
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
	@RobSpecifikacijaFaktureAmbalaza(tbl, translator)
	@rep.ReportEnd(nil)
}

// RobSpecifikacijaFaktureAmbalaza renders the "Ambalaza" summary of the report: the PDV of the
// selection per poreska stopa, from the rows the service emits with the "ambalaza" ClassRow and the
// "Ukupno:" row with the "ambalaza-total" one.
templ RobSpecifikacijaFaktureAmbalaza(tbl domain.TableData, translator *i18n.Service) {
	<div class="mt-3 print:mt-2 no-break">
		<div class="font-bold text-sm print:text-[9pt] mb-1">{ translator.Label("Ambalaza") } :</div>
		<table class="w-1/2 border-collapse print:w-1/2 print:table-auto">
			<thead>
				<tr class="bg-blue-900 text-white print:bg-gray-200 print:text-black">
					<th class="border border-gray-300 px-1 text-sm text-center print:text-[9pt]">{ translator.Label("Stopa") }</th>
					<th class="border border-gray-300 px-1 text-sm text-center print:text-[9pt]">{ translator.Label("Osnovica") }</th>
					<th class="border border-gray-300 px-1 text-sm text-center print:text-[9pt]">{ translator.Label("PDV") }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range tbl.Rows {
					if row.ClassRow == "ambalaza" {
						<tr class="print:page-break-inside-avoid">
							for _, cell := range row.Fields {
								<td class="border border-gray-300 px-1 text-sm text-right print:text-[9pt] print:px-1">{ cell }</td>
							}
						</tr>
					} else if row.ClassRow == "ambalaza-total" {
						<tr class="font-bold bg-blue-50 border-t border-blue-900 print:bg-blue-50 print:page-break-inside-avoid">
							for _, cell := range row.Fields {
								<td class="border border-gray-300 px-1 text-sm text-right print:text-[9pt] print:px-1">{ cell }</td>
							}
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// robSpecifikacijaFaktureAmountColumn returns the index of the first column of the amounts of the
// report (its "Iznos" column): the totals of the report print their label over the columns before it
// and one amount per column.
func robSpecifikacijaFaktureAmountColumn(headers []domain.Fields) int {
	for i, header := range headers {
		if header.Name == "iznos" {
			return i
		}
	}
	return len(headers)
}

// robSpecifikacijaFaktureCellClass returns the classes of one cell of the report table, honouring the
// alignment declared by the column.
func robSpecifikacijaFaktureCellClass(headers []domain.Fields, index int) string {
	align := ""
	if index < len(headers) && headers[index].TextAlign != "" {
		align = " text-" + headers[index].TextAlign
	}
	return "border border-gray-300 px-1 text-sm print:text-[9pt] print:px-1 print:break-words print:whitespace-normal" + align
}

//
// "Fakture veleprodaje" print: the report RobnoStampaFaktura (the legacy ROB_RPT_STAMPA_FAKTURA)
//

// RobnoStampaFaktura renders the printed fakture of the selection, every faktura from a new page: the
// header of the document (the izdavalac from repParams, the kupac and the data of the document), the
// stavke and the closing blocks of the legacy report, each printed only when it has data.
templ RobnoStampaFaktura(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaDokumenti(repParams, fakture, translator), translator))
}

// RobnoStampaDokumenti renders the printed robni dokumenti one after the other (common to the prints of
// every vrsta dokumenta): a gray gap between them on screen and a page break in print, like the other
// prints of several documents (GrupeNaloziReport).
templ RobnoStampaDokumenti(dokumenti []templ.Component, translator *i18n.Service) {
	if len(dokumenti) == 0 {
		<div class="text-sm text-gray-700">{ translator.Message("Nema podataka za prikaz") }</div>
	}
	for i, dokument := range dokumenti {
		if i > 0 {
			<div class="print:hidden -mx-8 h-8 bg-gray-200 border-y border-gray-300 my-4"></div>
			<div class="hidden print:block" style="page-break-before: always;"></div>
		}
		@dokument
	}
}

// robnoStampaFakturaDokumenti returns the printed fakture for RobnoStampaDokumenti.
func robnoStampaFakturaDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaFakturaContent renders the invoice. The header of the document and the header of the
// stavke are the <thead> of the table of the stavke, so the browser repeats them on every printed page
// like the page header of the legacy report.
templ RobnoStampaFakturaContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaColumnWidths)) } class="pb-2">
						@RobnoStampaFakturaZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("VP Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Procenat rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass + " whitespace-nowrap" }>{ translator.Label("Procenat PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Pdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaAvansi(fak, translator)
		@RobnoStampaFakturaRekapitulacija(fak, translator)
		@RobnoStampaFakturaRate(fak, translator)
		@RobnoStampaFakturaAmbalaza(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		@RobnoStampaFakturaKrajDokumenta(fak, translator)
	</div>
}

// RobnoStampaFakturaZaglavlje renders the page header of the invoice like the legacy report: on the
// left the logo, the kupac (in a box marked by its corners) and the data of the sale, on the right
// the izdavalac, the title of the document ("Račun: vrd-broj") and its dates.
templ RobnoStampaFakturaZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, kupac, mesto isporuke and the data of the sale. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 object-contain"/>
			}
			<!-- The kupac: a box marked only by its four corners, like the legacy report. -->
			<div class="relative mt-2 px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5">{ fak.KupacNaziv }</div>
				<div class="mt-1">{ fak.KupacAdresa }</div>
				<div class="flex justify-between gap-2">
					<span>{ fak.KupacMesto }</span>
					<span class="whitespace-nowrap mr-4">{ translator.Label("PAK") }<span class="ml-6">{ fak.KupacPak }</span></span>
				</div>
				<div>{ translator.Label("PIB") } : { fak.KupacPib }</div>
				<div class="flex gap-6">
					<span>{ translator.Label("Matični broj") } : { fak.KupacMbr }</span>
					<span>{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</span>
				</div>
				if fak.MestoIsporuke != "" || fak.MestoIsporuke2 != "" {
					<div class="mt-1">
						<div>{ fak.MestoIsporuke }</div>
						<div>{ fak.MestoIsporuke2 }</div>
					</div>
				}
			</div>
			<!-- The data of the sale: the rows are printed also when their value is empty, like the
			     legacy report (only the otpremnica and the narudžbenica only when they are set). -->
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				if fak.Otpremnica != "" {
					@robnoStampaFakturaPolje(translator.Label("Na osnovu otpremnice"), fak.Otpremnica)
				}
				if fak.Narudzbenica != "" {
					@robnoStampaFakturaPolje(translator.Label("Na osnovu narudžbenice"), fak.Narudzbenica)
				}
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
			</div>
			<div class="grid grid-cols-2 gap-x-3 leading-snug">
				<div>{ translator.Label("Vozač") } : <span class="font-bold">{ fak.Vozac }</span></div>
				<div>{ translator.Label("Broj vozila") } : <span class="font-bold">{ fak.RegBrojVozila }</span></div>
			</div>
		</div>
		<!-- Right: izdavalac and the data of the document. -->
		<div>
			<div class="text-left leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div class="mt-1">{ fak.FirmaAdresa }</div>
			</div>
			<!-- The data of the firm under its name and adresa, one font size smaller than the adresa,
			     in two columns like the legacy report. -->
			<div class="text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaEmail != "" {
					<div class="col-span-2">{ fak.FirmaEmail }</div>
				}
				if fak.FirmaBpg != "" {
					<div class="col-span-2">{ fak.FirmaBpg }</div>
				}
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<!-- "Račun: 130-1156" -->
			<div class="mt-5 text-center">
				<span class="font-bold text-[16px] print:text-[13pt]">{ fak.Naslov }:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum prometa dobara"), fak.DatumPrometa)
				@robnoStampaFakturaDesnoPolje(robnoStampaFakturaNaslov(fak.ValutaNaslov, translator.Label("Valuta")), fak.Valuta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja računa"), fak.MestoIzdavanja)
				@robnoStampaFakturaDesnoPolje(translator.Label("Skladište"), fak.MagacinOpis)
			</div>
			if fak.FirmaBanka != "" {
				<div class="mt-1 text-right">{ fak.FirmaBanka }</div>
			}
		</div>
	</div>
}

// RobnoStampaFakturaAvansi renders the avansni računi closed with the invoice (ITERATION_AVANS).
templ RobnoStampaFakturaAvansi(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	if len(fak.Avansi) > 0 {
		<table class="w-full border-collapse mt-2 no-break">
			<thead>
				<tr class="bg-gray-100 print:bg-gray-100">
					<th class={ robnoStampaThClass }>{ translator.Label("Naplata po avansu") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Datum avansa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Osnovica") }</th>
					<th class={ robnoStampaThClass + " whitespace-nowrap" }>{ translator.Label("Procenat PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV") }</th>
				</tr>
			</thead>
			<tbody>
				for _, a := range fak.Avansi {
					<tr>
						<td class={ robnoStampaTdClass }>{ a.Broj }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ a.Datum }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ a.Osnovica }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ a.Stopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ a.Pdv }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// RobnoStampaFakturaRekapitulacija renders the totals of the invoice under the stavke, aligned to
// the right like the legacy report: SVEGA (the iznos of the stavke), RABAT, then for every poreska
// stopa (the lowest first) its OSNOVICA and "PDV PO STOPI x%", ZA NAPLATU, and after it the za
// naplatu po danima, the avansni PDV per stopa (ITERATION_AVPDV) and the totals of the avansi.
templ RobnoStampaFakturaRekapitulacija(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="mt-1 flex justify-end no-break">
		<table class="w-[45%] border-collapse">
			<colgroup>
				<col style="width: 30%"/>
				<col style="width: 35%"/>
				<col style="width: 35%"/>
			</colgroup>
			<tbody>
				@robnoStampaFakturaZbir("", translator.Label("Svega"), fak.Svega, false)
				@robnoStampaFakturaZbir("", translator.Label("Rabat"), fak.Rabat, false)
				for _, p := range fak.PdvPoStopama {
					@robnoStampaFakturaZbir("", translator.Label("Osnovica"), p.Osnovica, false)
					@robnoStampaFakturaZbir(translator.Label("PDV po stopi"), p.Stopa, p.Pdv, false)
				}
				@robnoStampaFakturaZbir("", robnoStampaFakturaNaslov(fak.ZaNaplatuNaslov, translator.Label("Za naplatu")), fak.ZaNaplatu, true)
				for _, dan := range fak.ZaNaplatuPoDanima {
					@robnoStampaFakturaZbir(translator.Label("Za naplatu do"), dan.Datum, dan.Iznos, false)
				}
				for _, p := range fak.AvansniPdv {
					@robnoStampaFakturaZbir(translator.Label("Avansni PDV po stopi"), p.Stopa+" "+translator.Label("Osnovica"), p.Osnovica, false)
					@robnoStampaFakturaZbir(translator.Label("Avansni PDV po stopi"), p.Stopa+" "+translator.Label("PDV"), p.Pdv, false)
				}
				if fak.UkupnoAvans != "" {
					@robnoStampaFakturaZbir("", translator.Label("Ukupno avans sa PDV-om"), fak.UkupnoAvans, true)
					@robnoStampaFakturaZbir("", translator.Label("Ostalo za uplatu"), fak.OstaloZaUplatu, true)
				}
				@robnoStampaFakturaZbir("", translator.Label("Ukupno sa PDV-om"), fak.UkupnoSaPdv, true)
			</tbody>
		</table>
	</div>
}

// RobnoStampaFakturaRate renders the rate of the invoice and their totals (ITERATION_RATEHDR,
// _RATEDET and _RATETOT).
templ RobnoStampaFakturaRate(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	if len(fak.Rate) > 0 {
		<div class="mt-3 no-break">
			<div class="font-bold mb-1">{ translator.Label("Rate za fakturu") }</div>
			<table class="w-full border-collapse">
				<thead>
					<tr class="bg-gray-200 print:bg-gray-200">
						<th class={ robnoStampaThClass }>{ translator.Label("Rata") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Datum rate") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Procenat rate") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Osnovica") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("PDV") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Ukupno sa PDV-om") }</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range fak.Rate {
						<tr>
							<td class={ robnoStampaTdClass + " text-right" }>{ r.Rbr }</td>
							<td class={ robnoStampaTdClass + " text-center" }>{ r.Datum }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ r.Procenat }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ r.Osnovica }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ r.Pdv }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ r.UkSaPdv }</td>
						</tr>
					}
					<tr class="font-bold bg-blue-50 print:bg-blue-50">
						<td colspan="3" class={ robnoStampaTdClass + " text-right" }>{ translator.Label("Ukupno") }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ fak.RateUkOsnovica }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ fak.RateUkPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ fak.RateUkSaPdv }</td>
					</tr>
				</tbody>
			</table>
		</div>
	}
}

// RobnoStampaFakturaAmbalaza renders the evidentna ambalaža of the invoice (ITERATION_AMBHEDER and
// _AMBBODY).
templ RobnoStampaFakturaAmbalaza(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	if len(fak.Ambalaza) > 0 {
		<div class="mt-3 no-break">
			<div class="font-bold text-[13px] print:text-[11pt] uppercase mb-1">{ translator.Label("Evidentna ambalaža") }</div>
			<table class="w-full border-collapse">
				<thead>
					<tr class="bg-gray-200 print:bg-gray-200">
						<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Stopa") }</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range fak.Ambalaza {
						<tr>
							<td class={ robnoStampaTdClass + " text-right" }>{ a.Rbr }</td>
							<td class={ robnoStampaTdClass }>{ a.Sifra }</td>
							<td class={ robnoStampaTdClass }>{ a.Naziv }</td>
							<td class={ robnoStampaTdClass + " text-center" }>{ a.Jm }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ a.Kolicina }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ a.Cena }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ a.Iznos }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ a.Stopa }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// RobnoStampaFakturaNapomene renders the poresko oslobođenje (ITERATION_PORNAP) and the obaveštenje o
// umanjenju odbitka prethodnog PDV-a (ITERATION_UMANJENJE).
templ RobnoStampaFakturaNapomene(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	if fak.OslobodjenjeClan != "" {
		<div class="mt-3 flex justify-between gap-4 no-break">
			<span>{ translator.TextWithParams("faktura_napomena_oslobodjeno", map[string]string{"clan": fak.OslobodjenjeClan}) }</span>
			<span class="font-bold">{ fak.OslobodjenjeIznos }</span>
		</div>
	}
	if fak.PoreskaNapomena != "" {
		<div class="mt-2 no-break">{ translator.Label("Napomena") }: { fak.PoreskaNapomena }</div>
	}
	if fak.Umanjenje {
		<div class="mt-3 no-break">
			<div class="font-semibold">{ translator.Text("faktura_umanjenje_naslov") }</div>
			<div>{ translator.TextWithParams("faktura_umanjenje", map[string]string{"clan": fak.UmanjenjeClan}) }</div>
		</div>
	}
}

// RobnoStampaFakturaKrajDokumenta renders the end of the invoice (ITERATION_ENDDOC) like the legacy
// report: the napomena and the shipping data, the notes on the kamata and on the pečat, the
// signatures (the caption above the line) and the note on the nadležan sud.
templ RobnoStampaFakturaKrajDokumenta(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@robnoStampaFakturaKraj(fak, "faktura_nadlezan_sud", translator)
}

// robnoStampaFakturaKraj renders the end of a faktura (see RobnoStampaFakturaKrajDokumenta) with the
// text of the note on the nadležan sud (sudText: the sud of the isporučilac robe or usluga).
templ robnoStampaFakturaKraj(fak domain.RobnoStampaFakturaView, sudText string, translator *i18n.Service) {
	<div class="mt-4 no-break">
		<div class="grid grid-cols-3 gap-4 items-start">
			<div class="col-span-2 min-h-[3rem] whitespace-pre-line">{ fak.Napomena }</div>
			<div class="grid grid-cols-[1fr_auto] gap-x-2 leading-snug">
				@robnoStampaFakturaDesnoPolje(translator.Label("Bruto težina"), fak.BrutoTezina)
				@robnoStampaFakturaDesnoPolje(translator.Label("Neto težina"), fak.NetoTezina)
				@robnoStampaFakturaDesnoPolje(translator.Label("Broj kutija"), fak.BrojKutija)
				@robnoStampaFakturaDesnoPolje(translator.Label("Broj paleta"), fak.BrojPaleta)
			</div>
		</div>
		<div class="mt-3 space-y-1">
			<div>{ translator.Text("faktura_zatezna_kamata") }</div>
			<div>{ translator.Text("faktura_bez_pecata") }</div>
		</div>
		<div class="mt-4 grid grid-cols-3 gap-12 text-center text-[13px] print:text-[11pt]">
			for _, potpis := range []string{"Fakturisao", "Robu izdao", "Robu primio"} {
				<div>
					<div>{ translator.Label(potpis) }</div>
					<div class="mt-8 border-b border-black mx-4"></div>
				</div>
			}
		</div>
		<div class="mt-6">{ translator.Text(sudText) }</div>
	</div>
}

// robnoStampaFakturaPolje renders one "label : value" row of the left block of the header (a row of a
// two column grid), with the value in bold like the legacy report.
templ robnoStampaFakturaPolje(label, value string) {
	<span>{ label } :</span>
	<span class="font-bold">{ value }</span>
}

// robnoStampaFakturaDesnoPolje renders one "label : value" row of a right aligned block (a row of a two
// column grid), with the label aligned to the value like the legacy report. The row is skipped when
// the value is empty.
templ robnoStampaFakturaDesnoPolje(label, value string) {
	if value != "" {
		<span class="text-right">{ label } :</span>
		<span class="font-bold text-right">{ value }</span>
	}
}

// robnoStampaFakturaZbir renders one row of the totals of the invoice: an optional prefix on the left
templ robnoStampaFakturaZbir(prefix, label, value string, bold bool) {
	if value != "" {
		<tr class={ "font-bold", templ.KV("border-b border-black", !bold) }>
			<td class="px-1 py-0.5 text-left uppercase whitespace-nowrap">{ prefix }</td>
			<td class="px-1 py-0.5 text-right uppercase whitespace-nowrap">{ label } :</td>
			<td class="px-1 py-0.5 text-right text-[13px] print:text-[11pt]">{ value }</td>
		</tr>
	}
}

// robnoStampaFakturaNaslov returns the caption of the print when it has its own (naslov), else the
// caption of the faktura.
func robnoStampaFakturaNaslov(naslov, faktura string) string {
	if naslov != "" {
		return naslov
	}
	return faktura
}

// robnoStampaFakturaColumnWidths are the widths of the columns of the stavke of the invoice: Red. br.,
// šifra, naziv, JM, količina, cena, % rabata, vrednost rabata, % PDV-a, iznos PDV-a and iznos.
var robnoStampaFakturaColumnWidths = []string{"4%", "7%", "24%", "4%", "8%", "9%", "6%", "9%", "8%", "9%", "12%"}

const (
	robnoStampaThClass = "border border-gray-500 px-1 py-0.5 text-center font-semibold text-[10px] print:text-[8pt] leading-tight"
	robnoStampaTdClass = "border border-gray-300 px-1 py-0.5 align-top text-[10px] print:text-[8pt]"
)

//
// Štampa izvozne fakture: the report RobnoStampaFakturaIzvoz (the faktura in a foreign valuta, the
// legacy PR_RPT_FAKTURA_OTPIZV). The legacy report is printed in English, so its captions are not
// translated.
//

// RobnoStampaFakturaIzvoz renders the printed izvozne fakture of the selection, every faktura from a
// new page.
templ RobnoStampaFakturaIzvoz(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaIzvozView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaIzvozDokumenti(repParams, fakture), translator))
}

// robnoStampaFakturaIzvozDokumenti returns the printed izvozne fakture for RobnoStampaDokumenti.
func robnoStampaFakturaIzvozDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaIzvozView) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaIzvozContent(repParams, fak))
	}
	return dokumenti
}

// RobnoStampaFakturaIzvozContent renders one izvozna faktura like the legacy report: the header and the
// header of the stavke are the <thead> of the table of the stavke (repeated on every printed page);
// after the stavke the totals in the valuta (TOTAL, DISCOUNT, SUBTOTAL with the guarantee discount and
// the discount for payment in advance, TOTAL FOR PAYMENT), the notes, the delivery terms, the weights,
// the PDV exemption, the izjava of the exporter and the sales department, the country of origin with
// the currency and the total in RSD, and the bank instructions.
templ RobnoStampaFakturaIzvozContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaIzvozView) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaIzvozColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaIzvozColumnWidths)) } class="pb-2">
						@RobnoStampaFakturaIzvozZaglavlje(repParams, fak)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>Line No.:</th>
					<th class={ robnoStampaThClass }>Product ID</th>
					<th class={ robnoStampaThClass }>DESCRIPTION</th>
					<th class={ robnoStampaThClass }>Country of origin</th>
					<th class={ robnoStampaThClass }>PCN</th>
					<th class={ robnoStampaThClass }>Measure Unit</th>
					<th class={ robnoStampaThClass }>Quantity</th>
					<th class={ robnoStampaThClass }>Unit Price { fak.Valuta }</th>
					<th class={ robnoStampaThClass }>% Discount</th>
					<th class={ robnoStampaThClass }>TOTAL { fak.Valuta }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Zemlja }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Pcn }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		<!-- The totals in the valuta. -->
		<div class="mt-1 flex justify-end no-break">
			<table class="w-[45%] border-collapse">
				<colgroup>
					<col style="width: 60%"/>
					<col style="width: 40%"/>
				</colgroup>
				<tbody>
					@robnoStampaFakturaIzvozZbir("TOTAL "+fak.Valuta, fak.Svega, true)
					@robnoStampaFakturaIzvozZbir("DISCOUNT "+fak.Valuta, fak.Rabat, true)
					if fak.ImaPopuste {
						@robnoStampaFakturaIzvozZbir("SUBTOTAL", fak.Neto, true)
						@robnoStampaFakturaIzvozZbir("Guarantee discount "+fak.UgRabatProc, fak.UgRabat, false)
						@robnoStampaFakturaIzvozZbir("Discount for payment in advance "+fak.KasaProc, fak.Kasa, false)
					}
					@robnoStampaFakturaIzvozZbir("TOTAL FOR PAYMENT "+fak.Valuta, fak.ZaNaplatu, true)
				</tbody>
			</table>
		</div>
		<!-- The notes, the delivery terms, the weights, the PDV exemption, the izjava and the sales
		     department. -->
		<div class="mt-2 grid grid-cols-[1fr_auto] gap-8 no-break">
			<div class="space-y-1">
				<div class="flex gap-2">
					<span>Notes:</span>
					<span class="whitespace-pre-line">{ fak.Napomena }</span>
				</div>
				<div class="pt-4">Delivery terms: <span class="ml-2">{ fak.Paritet }</span></div>
				<div>Total btto weight: <span class="ml-2 font-bold">{ fak.BrutoTezina }</span></div>
				<div>Total net weight: <span class="ml-3 font-bold">{ fak.NetoTezina }</span></div>
				<div class="pt-2">Oslobodjeno placanja PDV-a po clanu 24. stav 1 tacka 2, Zakona o PDV-u</div>
				if fak.Izjava != "" {
					<div class="pt-2">{ fak.Izjava }</div>
				}
			</div>
			<div class="w-56 pt-10 text-center">
				<div class="text-[13px] print:text-[11pt]">Sales department</div>
				<div class="mt-8 border-b border-black"></div>
			</div>
		</div>
		<!-- The country of origin, the currency and the total in RSD. -->
		<div class="mt-3 no-break">
			<div>Country of origin: <span class="ml-2 font-bold">SERBIA</span></div>
			<div class="flex justify-between">
				<span>Currency: <span class="ml-2 font-bold">{ fak.Valuta }</span></span>
				<span>Total RSD: <span class="ml-2 font-bold">{ fak.UkupnoRsd }</span></span>
			</div>
			<div>THE GOODS REMAIN PROPERTY OF SELLER UNTIL THE PAYMENT IS EFFECTED</div>
		</div>
		@robnoStampaFakturaIzvozBanka(fak)
	</div>
}

// RobnoStampaFakturaIzvozZaglavlje renders the page header of the izvozna faktura like the legacy
// report: on the left the logo, the kupac (CUSTOMER, in a box marked by its corners) with the
// destination and the data of the shipment; on the right the izdavalac with its account, the title
// ("INVOICE No.: 136-43"), the invoice date and the place of issue.
templ RobnoStampaFakturaIzvozZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaIzvozView) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the kupac, the destination and the shipment. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic">CUSTOMER:</span>
					<span class="ml-1">{ fak.KupacSifra }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="text-center">{ fak.KupacMesto }</div>
				<div class="text-center">{ fak.KupacPib }</div>
				<div class="flex justify-between gap-6">
					<span>{ fak.KupacMbr }</span>
					<span>{ fak.KupacTelefon }</span>
				</div>
			</div>
			if fak.Destinacija != "" {
				<div class="mt-1 text-center leading-snug">
					<div>{ fak.Destinacija }</div>
					<div>{ fak.Destinacija2 }</div>
				</div>
			}
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				<span>Despatch note:</span>
				<span class="font-bold">{ fak.Otpremnica }</span>
				<span>Payment condition:</span>
				<span class="font-bold">{ fak.UslovPlacanja }</span>
				<span>Driver name :</span>
				<span class="flex justify-between gap-2">
					<span class="font-bold">{ fak.Vozac }</span>
					<span>Truck number : <span class="font-bold">{ fak.BrojVozila }</span></span>
				</span>
			</div>
		</div>
		<!-- Right: the izdavalac, the title and the invoice date. -->
		<div>
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaMbr }</div>
				<div></div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 text-center font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<div class="mt-5 text-center">
				<span class="font-bold text-[16px] print:text-[13pt]">INVOICE No.:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-2 leading-snug text-[12px] print:text-[10pt]">
				<span class="text-right">Invoice date:</span>
				<span class="font-bold">{ fak.DatumFakture }</span>
				<span class="text-right">Place of issue of invoice:</span>
				<span class="font-bold">{ fak.MestoIzdavanja }</span>
			</div>
		</div>
	</div>
}

// robnoStampaFakturaIzvozBanka renders the bank instructions of an izvozna faktura or profaktura
// (when the document has a bank): 57A the beneficiary's bank with its SWIFT, 59 the account and the
// beneficiary, 54A the correspondent bank.
templ robnoStampaFakturaIzvozBanka(fak domain.RobnoStampaFakturaIzvozView) {
	if fak.BankaNaziv != "" || fak.BankaRacun != "" {
		<div class="mt-3 grid grid-cols-[auto_auto_1fr] gap-x-3 gap-y-1 no-break">
			<span class="font-bold">By bank transfer to:</span>
			<span>57A: beneficiary's bank:</span>
			<div>
				<div>{ fak.BankaNaziv }</div>
				<div>{ fak.BankaSwift }</div>
			</div>
			<span></span>
			<span>59: beneficiary:</span>
			<div>
				<div>{ fak.BankaRacun }</div>
				<div>{ fak.BankaKorisnik }</div>
			</div>
			<span></span>
			<span>54A: correspondent bank:</span>
			<div>{ fak.BankaKorespondent }</div>
		</div>
	}
}

// robnoStampaFakturaIzvozZbir renders one row of the totals of the izvozna faktura: the label aligned to
// the right and the amount over a line (bold for the totals).
templ robnoStampaFakturaIzvozZbir(label, value string, bold bool) {
	<tr class={ "border-b border-black", templ.KV("font-bold", bold) }>
		<td class="px-1 py-0.5 text-right whitespace-nowrap">{ label } :</td>
		<td class="px-1 py-0.5 text-right">{ value }</td>
	</tr>
}

// robnoStampaFakturaIzvozColumnWidths are the widths of the columns of the stavke of the izvozna
// faktura: line no., product id, description, country of origin, PCN, measure unit, quantity, unit
// price, % discount and total value.
var robnoStampaFakturaIzvozColumnWidths = []string{"5%", "6%", "28%", "9%", "9%", "7%", "8%", "9%", "8%", "11%"}

//
// Štampa izvozne profakture: the report RobnoStampaProfakturaIzvoz (the profakture in a foreign
// valuta, the legacy ROB_RPT_PROFAKTURAIZV). The legacy report is printed in English, so its captions
// are not translated.
//

// RobnoStampaProfakturaIzvoz renders the printed izvozne profakture of the selection, every profaktura
// from a new page.
templ RobnoStampaProfakturaIzvoz(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaIzvozView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaProfakturaIzvozDokumenti(repParams, fakture), translator))
}

// robnoStampaProfakturaIzvozDokumenti returns the printed izvozne profakture for RobnoStampaDokumenti.
func robnoStampaProfakturaIzvozDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaIzvozView) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaProfakturaIzvozContent(repParams, fak))
	}
	return dokumenti
}

// RobnoStampaProfakturaIzvozContent renders one izvozna profaktura like the legacy report: the header
// and the header of the stavke are the <thead> of the table of the stavke (repeated on every printed
// page); after the stavke the totals (TOTAL, DISCOUNT, SUBTOTAL with the guarantee discount and the
// discount for payment in advance, TOTAL FOR PAYMENT), the notes, the delivery terms, the net weight,
// the ownership clause, the PDV exemption, the izjava of the exporter and the sales department, the
// currency with the total in RSD and the bank instructions.
templ RobnoStampaProfakturaIzvozContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaIzvozView) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaProfakturaIzvozColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaProfakturaIzvozColumnWidths)) } class="pb-2">
						@RobnoStampaProfakturaIzvozZaglavlje(repParams, fak)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>Line No.</th>
					<th class={ robnoStampaThClass }>Product ID</th>
					<th class={ robnoStampaThClass }>DESCRIPTION</th>
					<th class={ robnoStampaThClass }>Measure Unit</th>
					<th class={ robnoStampaThClass }>Quantity</th>
					<th class={ robnoStampaThClass }>Unit Price</th>
					<th class={ robnoStampaThClass }>% Discount</th>
					<th class={ robnoStampaThClass }>Discount</th>
					<th class={ robnoStampaThClass }>TOTAL</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Popust }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		<!-- The totals. -->
		<div class="mt-1 flex justify-end no-break">
			<table class="w-[45%] border-collapse">
				<colgroup>
					<col style="width: 60%"/>
					<col style="width: 40%"/>
				</colgroup>
				<tbody>
					@robnoStampaFakturaIzvozZbir("TOTAL", fak.Svega, true)
					@robnoStampaFakturaIzvozZbir("DISCOUNT", fak.Rabat, true)
					if fak.ImaPopuste {
						@robnoStampaFakturaIzvozZbir("SUBTOTAL", fak.Neto, true)
						@robnoStampaFakturaIzvozZbir("Guarantee discount "+fak.UgRabatProc, fak.UgRabat, false)
						@robnoStampaFakturaIzvozZbir("Discount for payment in advance "+fak.KasaProc, fak.Kasa, false)
					}
					@robnoStampaFakturaIzvozZbir("TOTAL FOR PAYMENT", fak.ZaNaplatu, true)
				</tbody>
			</table>
		</div>
		<!-- The notes, the delivery terms, the net weight, the clauses, the izjava and the sales
		     department. -->
		<div class="mt-2 grid grid-cols-[1fr_auto] gap-8 no-break">
			<div class="space-y-1">
				<div class="flex gap-2">
					<span>Notes:</span>
					<span class="whitespace-pre-line">{ fak.Napomena }</span>
				</div>
				<div class="pt-4">Delivery terms: <span class="ml-2">{ fak.Paritet }</span></div>
				<div>Total net weight: <span class="ml-2 font-bold">{ fak.NetoTezina }</span> <span class="ml-2 font-bold">Kg</span></div>
				<div class="pt-2">The goods remain property of seller until the payment is effected.</div>
				<div>Oslobodjeno placanja PDV-a po clanu 24. stav 1 tacka 2, Zakona o PDV-u</div>
				if fak.Izjava != "" {
					<div class="pt-2">{ fak.Izjava }</div>
				}
			</div>
			<div class="w-56 pt-10 text-center">
				<div class="text-[13px] print:text-[11pt]">Sales department</div>
				<div class="mt-8 border-b border-black"></div>
			</div>
		</div>
		<!-- The currency, the total in RSD and the bank instructions. -->
		<div class="mt-3 flex justify-between no-break">
			<span>Currency: <span class="ml-2 font-bold">{ fak.Valuta }</span></span>
			<span>Total RSD: <span class="ml-2 font-bold">{ fak.UkupnoRsd }</span></span>
		</div>
		@robnoStampaFakturaIzvozBanka(fak)
	</div>
}

// RobnoStampaProfakturaIzvozZaglavlje renders the page header of the izvozna profaktura like the legacy
// report: on the left the logo, the kupac (KUPAC, in a box marked by its corners) with the delivery
// place, the despatch note, the payment condition and the sales person; on the right the izdavalac with
// its tekući račun, the title ("PROFORMA No.: 900-5"), the proforma date, the due date and the place of
// issue.
templ RobnoStampaProfakturaIzvozZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaIzvozView) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the kupac and the data of the sale. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic">KUPAC:</span>
					<span class="ml-1">{ fak.KupacSifra }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="text-center">{ fak.KupacMesto }</div>
				<div class="text-center">{ fak.KupacPib }</div>
				<div class="flex justify-between gap-6">
					<span>{ fak.KupacMbr }</span>
					<span>{ fak.KupacTelefon }</span>
				</div>
			</div>
			if fak.Destinacija != "" {
				<div class="mt-1 text-center leading-snug">
					<div>{ fak.Destinacija }</div>
					<div>{ fak.Destinacija2 }</div>
				</div>
			}
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				<span>Despatch note:</span>
				<span class="font-bold">{ fak.Otpremnica }</span>
				<span>Payment condition:</span>
				<span class="font-bold">{ fak.UslovPlacanja }</span>
				<span>Sales person :</span>
				<span class="font-bold">{ fak.Komercijalista }</span>
			</div>
		</div>
		<!-- Right: the izdavalac, the title and the dates. -->
		<div>
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 text-center font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<div class="mt-5 text-center">
				<span class="font-bold text-[16px] print:text-[13pt]">PROFORMA No.:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-2 leading-snug text-[12px] print:text-[10pt]">
				<span class="text-right">Proforma Date:</span>
				<span class="font-bold">{ fak.DatumFakture }</span>
				<span class="text-right">Due date:</span>
				<span class="font-bold">{ fak.DatumDospeca }</span>
				<span class="text-right">Place of issue:</span>
				<span class="font-bold">{ fak.MestoIzdavanja }</span>
			</div>
		</div>
	</div>
}

// robnoStampaProfakturaIzvozColumnWidths are the widths of the columns of the stavke of the izvozna
// profaktura: line no., product id, description, measure unit, quantity, unit price, % discount,
// discount and total.
var robnoStampaProfakturaIzvozColumnWidths = []string{"5%", "7%", "35%", "7%", "9%", "9%", "8%", "9%", "11%"}

//
// Štampa profakture: the report RobnoStampaProfaktura (the group PRO of the vrste dokumenta in the
// domestic valuta, the legacy ROB_RPT_STAMPA_PROFAKTURA)
//

// RobnoStampaProfaktura renders the printed profakture (ponude) of the selection, every profaktura from
// a new page.
templ RobnoStampaProfaktura(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaProfakturaDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaProfakturaDokumenti returns the printed profakture for RobnoStampaDokumenti.
func robnoStampaProfakturaDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaProfakturaContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaProfakturaContent renders one profaktura like the legacy report: the header and the header
// of the stavke are the <thead> of the table of the stavke (repeated on every printed page); after the
// stavke the avans, the osnovica and the PDV per stopa, SVEGA, RABAT and ZA NAPLATU, the napomena with
// the signature of who issued the document, the za naplatu po danima, the avansno uplaćen PDV, the
// ambalaža and the poreska napomena.
templ RobnoStampaProfakturaContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaColumnWidths)) } class="pb-2">
						@RobnoStampaProfakturaZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("VP Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Pdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		<!-- AVANS, the osnovica and the PDV per stopa, SVEGA, RABAT and ZA NAPLATU. -->
		<div class="mt-1 flex justify-end no-break">
			<table class="w-[45%] border-collapse">
				<colgroup>
					<col style="width: 30%"/>
					<col style="width: 35%"/>
					<col style="width: 35%"/>
				</colgroup>
				<tbody>
					@robnoStampaFakturaZbir("", translator.Label("Avans"), fak.UkupnoAvans, false)
					for _, p := range fak.PdvPoStopama {
						@robnoStampaFakturaZbir("", translator.Label("Osnovica"), p.Osnovica, false)
						@robnoStampaFakturaZbir(translator.Label("PDV po stopi"), p.Stopa, p.Pdv, false)
					}
					@robnoStampaFakturaZbir("", translator.Label("Svega"), fak.Svega, false)
					@robnoStampaFakturaZbir("", translator.Label("Rabat"), fak.Rabat, false)
					@robnoStampaFakturaZbir("", translator.Label("Za naplatu"), fak.ZaNaplatu, false)
					if fak.OstaloZaUplatu != "" {
						@robnoStampaFakturaZbir("", translator.Label("Ostalo za uplatu"), fak.OstaloZaUplatu, true)
					}
				</tbody>
			</table>
		</div>
		<!-- The napomena and who issued the document. -->
		<div class="mt-3 grid grid-cols-[1fr_auto] gap-8 no-break">
			<div class="min-h-[3rem] whitespace-pre-line">{ fak.Napomena }</div>
			<div class="w-56 pt-10 text-center">
				<div class="text-[13px] print:text-[11pt]">{ translator.Label("Dokument izdao") }</div>
				<div class="mt-8 border-b border-black"></div>
			</div>
		</div>
		<!-- ZA NAPLATU po danima and the avansno uplaćen PDV per stopa. -->
		if len(fak.ZaNaplatuPoDanima) > 0 || len(fak.AvansniPdv) > 0 {
			<div class="mt-2 flex justify-end no-break">
				<table class="w-[70%] border-collapse">
					<tbody>
						for _, dan := range fak.ZaNaplatuPoDanima {
							<tr class="font-bold border-b border-black">
								<td class="px-1 py-0.5 text-right uppercase">{ translator.Label("Dospeva") } :</td>
								<td class="px-1 py-0.5">{ dan.Datum }</td>
								<td class="px-1 py-0.5 text-right uppercase">{ translator.Label("Za naplatu") } :</td>
								<td class="px-1 py-0.5 text-right">{ dan.Iznos }</td>
							</tr>
						}
						for _, p := range fak.AvansniPdv {
							<tr class="font-bold border-b border-black">
								<td class="px-1 py-0.5 text-right uppercase">{ translator.Label("Avansno uplaćen PDV po stopi") }: { p.Stopa }</td>
								<td class="px-1 py-0.5">{ translator.Label("Osnovica") }: { p.Osnovica }</td>
								<td class="px-1 py-0.5 text-right uppercase">{ translator.Label("PDV") } :</td>
								<td class="px-1 py-0.5 text-right">{ p.Pdv }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@RobnoStampaFakturaAmbalaza(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
	</div>
}

// RobnoStampaProfakturaZaglavlje renders the page header of the profaktura like the legacy report: on
// the left the logo, the kupac (in a box marked by its corners), the uslovi and the rok plaćanja and the
// komercijalista; on the right the firm with its tekući računi and their banks, the title
// ("PROFAKTURA Br.: 900-5" or "PONUDA: 900-5") and the dates of the document.
templ RobnoStampaProfakturaZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the kupac and the data of the sale. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5">{ fak.KupacNaziv }</div>
				<div class="mt-1">{ fak.KupacAdresa }</div>
				<div class="flex justify-between gap-2">
					<span>{ fak.KupacMesto }</span>
					<span class="whitespace-nowrap mr-4">{ translator.Label("PAK") }<span class="ml-6">{ fak.KupacPak }</span></span>
				</div>
				<div>{ translator.Label("PIB") } : { fak.KupacPib }</div>
				<div class="flex gap-6">
					<span>{ translator.Label("Matični broj") } : { fak.KupacMbr }</span>
					<span>{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</span>
				</div>
				if fak.MestoIsporuke != "" {
					<div class="mt-1">
						<div>{ fak.MestoIsporuke }</div>
						<div>{ fak.MestoIsporuke2 }</div>
					</div>
				}
			</div>
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
			</div>
		</div>
		<!-- Right: the firm, the title and the dates of the document. -->
		<div>
			<div class="text-left leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div class="mt-1">{ fak.FirmaAdresa }</div>
			</div>
			<div class="text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 font-bold">{ fak.FirmaZiro }</div>
				}
				if fak.FirmaBankeNazivi != "" {
					<div class="col-span-2">{ fak.FirmaBankeNazivi }</div>
				}
			</div>
			<!-- "PROFAKTURA Br.: 900-5" -->
			<div class="mt-5 text-center">
				<span class="font-bold italic uppercase text-[16px] print:text-[13pt]">{ fak.Naslov }:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum prometa dobara"), fak.DatumPrometa)
				@robnoStampaFakturaDesnoPolje(translator.Label("Valuta"), fak.Valuta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja dokumenta"), fak.MestoIzdavanja)
			</div>
		</div>
	</div>
}

//
// Štampa knjižnog odobrenja i zaduženja: the report RobnoStampaFakturaKnjizno (the groups KPK and KPF
// of the vrste dokumenta, the legacy PR_RPT_KNJODOBRENJE)
//

// RobnoStampaFakturaKnjizno renders the printed knjižna odobrenja and zaduženja of the selection, every
// document from a new page, with the header of the faktura (the title "Knjižno odobrenje" or "Knjižno
// zaduženje"; the odobrenje with the datum of the smanjenje instead of the valuta).
templ RobnoStampaFakturaKnjizno(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaKnjiznoDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaFakturaKnjiznoDokumenti returns the printed knjižna odobrenja and zaduženja for
// RobnoStampaDokumenti.
func robnoStampaFakturaKnjiznoDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaKnjiznoContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaFakturaKnjiznoContent renders one knjižno odobrenje or zaduženje like the legacy report:
// the header of the faktura, the stavke with the barkod and the PDV of one unit, the avansi, the
// totals (ZA POVRAĆAJ for the odobrenje), the rate, the poreska napomena and the end of the document
// with the napomena on the izmena of the poreska osnovica (the odobrenje).
templ RobnoStampaFakturaKnjiznoContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@robnoStampaFakturaPoJmContent(repParams, fak, true, translator)
}

// robnoStampaFakturaPoJmContent renders a faktura whose stavke show the PDV of one unit (the knjižno
// odobrenje and the faktura-otpremnica): the header of the faktura, the stavke (with the barkod when
// barkod is set), the avansi, the totals, the rate, the poreska napomena, the napomena on the izmena
// of the poreska osnovica (when the view asks for it) and the end of the document.
templ robnoStampaFakturaPoJmContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, barkod bool, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaPoJmColumnWidths(barkod) {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaPoJmColumnWidths(barkod))) } class="pb-2">
						@RobnoStampaFakturaZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					if barkod {
						<th class={ robnoStampaThClass }>{ translator.Label("Barkod") }</th>
					}
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Prodajna cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV po JM") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						if barkod {
							<td class={ robnoStampaTdClass }>{ s.Barkod }</td>
						}
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.PdvPoJm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaAvansi(fak, translator)
		@RobnoStampaFakturaRekapitulacija(fak, translator)
		@RobnoStampaFakturaRate(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		if fak.NapomenaOsnovica {
			<div class="mt-3 no-break">
				<div>{ translator.Text("knjizno_odobrenje_osnovica") }</div>
				<div>{ translator.Text("knjizno_odobrenje_saglasnost") }</div>
			</div>
		}
		@RobnoStampaFakturaKrajDokumenta(fak, translator)
	</div>
}

// robnoStampaFakturaPoJmColumnWidths returns the widths of the columns of the stavke of a faktura with
// the PDV of one unit: Red. br., šifra, (barkod,) naziv, JM, količina, prodajna cena, % rabata,
// vrednost rabata, % PDV-a, PDV po JM and iznos.
func robnoStampaFakturaPoJmColumnWidths(barkod bool) []string {
	if barkod {
		return []string{"4%", "6%", "9%", "22%", "4%", "7%", "8%", "6%", "8%", "6%", "8%", "12%"}
	}
	return []string{"4%", "6%", "31%", "4%", "7%", "8%", "6%", "8%", "6%", "8%", "12%"}
}

//
// Štampa fakture-otpremnice: the report RobnoStampaFakturaOtpremnica (the fakture of the tip
// proizvodnje 2 and the group FZR, the legacy PR_RPT_FAKTURA_OTP)
//

// RobnoStampaFakturaOtpremnica renders the printed fakture-otpremnice of the selection, every document
// from a new page, with the header of the faktura (the title "Račun", "Otpremnica", "Storno ..." or
// "Konačni račun" and the Skladište) and the stavke with the PDV of one unit.
templ RobnoStampaFakturaOtpremnica(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaOtpremnicaDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaFakturaOtpremnicaDokumenti returns the printed fakture-otpremnice for RobnoStampaDokumenti.
func robnoStampaFakturaOtpremnicaDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, robnoStampaFakturaPoJmContent(repParams, fak, false, translator))
	}
	return dokumenti
}

//
// Štampa knjižnog pisma: the report RobnoStampaKnjiznoPismo (the knjižna pisma with stavke, the groups
// KNO and KNZ, the legacy ROB_RPT_KNJPISMO)
//

// RobnoStampaKnjiznoPismo renders the printed knjižna pisma of the selection, every knjižno pismo from a
// new page.
templ RobnoStampaKnjiznoPismo(repParams domain.ReportParameters, pisma []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaKnjiznoPismoDokumenti(repParams, pisma, translator), translator))
}

// robnoStampaKnjiznoPismoDokumenti returns the printed knjižna pisma for RobnoStampaDokumenti.
func robnoStampaKnjiznoPismoDokumenti(repParams domain.ReportParameters, pisma []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(pisma))
	for _, fak := range pisma {
		dokumenti = append(dokumenti, RobnoStampaKnjiznoPismoContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaKnjiznoPismoContent renders one knjižno pismo like the legacy report: the header of the
// document and the header of the stavke are the <thead> of the table (repeated on every printed page);
// after the stavke BRUTO, RABAT, the neto with the ugovoreni rabat and the kasa (when the document has
// them), the poreska osnovica and the PDV per stopa (the difference to the faktura), the UKUPNA
// NAKNADA, the naknada in words, the napomena, the signatures, the napomena on the izmena of the poreska
// osnovica and the poreska napomena.
templ RobnoStampaKnjiznoPismoContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaPoJmColumnWidths(false) {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaPoJmColumnWidths(false))) } class="pb-2">
						@RobnoStampaKnjiznoPismoZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Ispravka cene") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV po JM") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.PdvPoJm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		<!-- BRUTO, RABAT, the neto with the ugovoreni rabat and the kasa, the osnovica and the PDV per stopa
		     and the UKUPNA NAKNADA. -->
		<div class="mt-1 flex justify-end no-break">
			<table class="w-[45%] border-collapse">
				<colgroup>
					<col style="width: 30%"/>
					<col style="width: 35%"/>
					<col style="width: 35%"/>
				</colgroup>
				<tbody>
					@robnoStampaFakturaZbir("", translator.Label("Bruto"), fak.Svega, false)
					@robnoStampaFakturaZbir("", translator.Label("Rabat"), fak.Rabat, false)
					@robnoStampaFakturaZbir("", translator.Label("Neto"), fak.Neto, false)
					@robnoStampaFakturaZbir("", translator.Label("Ugovoreni rabat"), fak.UgovoreniRabat, false)
					@robnoStampaFakturaZbir("", translator.Label("Kasa"), fak.Kasa, false)
					for _, p := range fak.PdvPoStopama {
						@robnoStampaFakturaZbir("", translator.Label("Poreska osnovica"), p.Osnovica, false)
						@robnoStampaFakturaZbir(translator.Label("PDV po stopi"), p.Stopa, p.Pdv, false)
					}
					@robnoStampaFakturaZbir("", translator.Label("Ukupna naknada"), fak.ZaNaplatu, true)
				</tbody>
			</table>
		</div>
		<!-- The naknada in words, the napomena, the signatures and the napomene. -->
		<div class="mt-2 no-break">
			<div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
				<span>{ translator.Label("Slovima") }:</span>
				<span class="font-bold">{ fak.Slovima }</span>
				<span>{ translator.Label("Napomena") }:</span>
				<span class="whitespace-pre-line">{ fak.Napomena }</span>
			</div>
			<div class="mt-6 grid grid-cols-3 gap-12 text-center text-[12px] print:text-[10pt]">
				for _, potpis := range []string{"Kontrolisao", "Formirao", "Odgovorno lice"} {
					<div>
						<div>{ translator.Label(potpis) }:</div>
						<div class="mt-8 border-b border-black"></div>
					</div>
				}
			</div>
			<div class="mt-6 grid grid-cols-2 gap-12 text-center text-[12px] print:text-[10pt] items-end">
				<div>
					<div>{ repParams.CompanyName }</div>
					<div class="mt-6 border-b border-black"></div>
					<div class="mt-1">{ translator.Label("Sektor prodaje") }</div>
				</div>
				<div>
					<div>{ translator.Label("Saglasan") }:</div>
					<div>{ fak.KupacNaziv }</div>
					<div class="mt-6 border-b border-black"></div>
				</div>
			</div>
			if fak.NapomenaPorez != "" {
				<div class="mt-4 whitespace-pre-line">{ fak.NapomenaPorez }</div>
			}
			<div class="mt-4">{ translator.Text("dokument_punovazan_bez_pecata") }</div>
			if fak.PoreskaNapomena != "" {
				<div class="mt-2">{ translator.Label("Napomena") }: { translator.Label("Oslobođeno plaćanja PDV-a po") } { fak.PoreskaNapomena }</div>
			}
		</div>
	</div>
}

// RobnoStampaKnjiznoPismoZaglavlje renders the page header of the knjižno pismo like the legacy report:
// on the left the logo, the kupac (in a box marked by its corners) with the mesto isporuke, the tip of
// the knjižno pismo, the vezni dokument and the komercijalista; on the right the firm, the title
// ("KNJIŽNO ODOBRENJE Br.: 270-5" or "KNJIŽNO ZADUŽENJE Br."), the datum of the document, the nalog and
// the mesto izdavanja dokumenta, and "Odobravamo/Zadužujemo Vas kako sledi".
templ RobnoStampaKnjiznoPismoZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the kupac and the data of the knjižno pismo. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="text-center">{ fak.KupacMesto }</div>
				<div class="text-center">{ fak.KupacPib }</div>
				<div class="text-center">{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</div>
				if fak.MestoIsporuke != "" {
					<div class="mt-1 text-center">
						<div>{ fak.MestoIsporuke }</div>
						<div>{ fak.MestoIsporuke2 }</div>
					</div>
				}
			</div>
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				<span>{ translator.Label("Tip knjižnog pisma") }:</span>
				<span class="font-bold">{ fak.TipKnjiznogPisma }</span>
				<span></span>
				<span>{ fak.VezniDokument }</span>
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
			</div>
		</div>
		<!-- Right: the firm, the title and the data of the document. -->
		<div>
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
			</div>
			<div class="mt-5 text-center">
				<span class="font-bold italic uppercase text-[16px] print:text-[13pt]">{ fak.Naslov }</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja dokumenta"), fak.MestoIzdavanja)
			</div>
			if fak.OdobravaZaduzuje != "" {
				<div class="mt-3 text-right font-bold">{ fak.OdobravaZaduzuje }</div>
			}
		</div>
	</div>
}

// RobnoStampaKnjiznoPismoFin renders the printed finansijska knjižna pisma (without stavke, the legacy
// ROB_RPT_KNJPISMOFIN) of the selection, every knjižno pismo from a new page.
templ RobnoStampaKnjiznoPismoFin(repParams domain.ReportParameters, pisma []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaKnjiznoPismoFinDokumenti(repParams, pisma, translator), translator))
}

// robnoStampaKnjiznoPismoFinDokumenti returns the printed finansijska knjižna pisma for
// RobnoStampaDokumenti.
func robnoStampaKnjiznoPismoFinDokumenti(repParams domain.ReportParameters, pisma []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(pisma))
	for _, fak := range pisma {
		dokumenti = append(dokumenti, RobnoStampaKnjiznoPismoFinContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaKnjiznoPismoFinContent renders one finansijsko knjižno pismo like the legacy report: the
// header of the knjižno pismo, the poreska osnovica and the PDV with its stopa and the UKUPNA NAKNADA in
// a frame, the naknada in words, the napomena, the napomena on the izmena of the poreska osnovica, the
// signatures of the sektor prodaje and of the kupac (SAGLASAN, with the datum) and the poreska napomena.
templ RobnoStampaKnjiznoPismoFinContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		@RobnoStampaKnjiznoPismoZaglavlje(repParams, fak, translator)
		<!-- The poreska osnovica, the PDV and the UKUPNA NAKNADA in a frame. -->
		<div class="mt-3 border border-black no-break">
			<div class="flex justify-end">
				<table class="w-[45%] border-collapse">
					<colgroup>
						<col style="width: 30%"/>
						<col style="width: 35%"/>
						<col style="width: 35%"/>
					</colgroup>
					<tbody>
						for _, p := range fak.PdvPoStopama {
							@robnoStampaFakturaZbir("", translator.Label("Poreska osnovica"), p.Osnovica, false)
							@robnoStampaFakturaZbir(translator.Label("PDV po stopi"), p.Stopa, p.Pdv, false)
						}
						@robnoStampaFakturaZbir("", translator.Label("Ukupna naknada"), fak.ZaNaplatu, true)
					</tbody>
				</table>
			</div>
		</div>
		<!-- The naknada in words, the napomene and the signatures. -->
		<div class="mt-3 no-break">
			<div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
				if fak.Slovima != "" {
					<span>{ translator.Label("Slovima") }:</span>
					<span class="font-bold">{ fak.Slovima }</span>
				}
				<span>{ translator.Label("Napomena") }:</span>
				<span class="whitespace-pre-line">{ fak.Napomena }</span>
			</div>
			if fak.NapomenaPorez != "" {
				<div class="mt-4 whitespace-pre-line">{ fak.NapomenaPorez }</div>
			}
			<div class="mt-16 grid grid-cols-2 gap-12 text-center text-[12px] print:text-[10pt] items-end">
				<div>
					<div>{ repParams.CompanyName }</div>
					<div class="mt-6 border-b border-black"></div>
					<div class="mt-1">{ translator.Label("Sektor prodaje") }</div>
				</div>
				<div>
					<div>{ translator.Label("Saglasan") }:</div>
					<div>{ fak.KupacNaziv }</div>
					<div class="mt-6 border-b border-black"></div>
					<div class="mt-1 flex items-end gap-2">
						<span>{ translator.Label("Datum") }</span>
						<span class="w-24 border-b border-black"></span>
					</div>
				</div>
			</div>
			if fak.PoreskaNapomena != "" {
				<div class="mt-4">{ translator.Label("Napomena") }: { translator.Label("Oslobođeno plaćanja PDV-a po") } { fak.PoreskaNapomena }</div>
			}
		</div>
	</div>
}

// Štampa popisa: the report RobnoStampaPopis (vrsta dokumenta 101)
// RobnoStampaPopis renders the printed popisi of the selection, every popis from a new page: the
templ RobnoStampaPopis(repParams domain.ReportParameters, popisi []domain.RobnoStampaPopisView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaPopisDokumenti(repParams, popisi, translator), translator))
}

// robnoStampaPopisDokumenti returns the printed popisi for RobnoStampaDokumenti.
func robnoStampaPopisDokumenti(repParams domain.ReportParameters, popisi []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(popisi))
	for _, pop := range popisi {
		dokumenti = append(dokumenti, RobnoStampaPopisContent(repParams, pop, translator))
	}
	return dokumenti
}

// RobnoStampaPopisContent renders one popis. The header of the document and the header of the stavke
// are the <thead> of the table of the stavke, so the browser repeats them on every printed page; the
// totals are the <tfoot> of the table.
templ RobnoStampaPopisContent(repParams domain.ReportParameters, pop domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		@robnoStampaPopisTabela(repParams, pop, translator)
		@RobnoStampaPopisPotpisi(translator)
	</div>
}

// robnoStampaPopisTabela renders the stavke of a popis or of an opšti dokument with the nabavna and the
// prodajna cena (rbr, konto, šifra, naziv, JM, količina, nabavna cena and vrednost, cena and iznos) and
// the totals of the nabavna vrednost and of the iznos. The header of the document and the header of
// the stavke are the <thead> of the table, so the browser repeats them on every printed page.
templ robnoStampaPopisTabela(repParams domain.ReportParameters, pop domain.RobnoStampaPopisView, translator *i18n.Service) {
	<table class="w-full border-collapse" style="table-layout: fixed;">
		<colgroup>
			for _, width := range robnoStampaPopisColumnWidths {
				<col style={ "width: " + width }/>
			}
		</colgroup>
		<thead>
			<tr>
				<td colspan={ fmt.Sprintf("%d", len(robnoStampaPopisColumnWidths)) } class="pb-2">
					@RobnoStampaPopisZaglavlje(repParams, pop, translator)
				</td>
			</tr>
			<tr class="bg-gray-200 print:bg-gray-200">
				<th class={ robnoStampaThClass }>{ translator.Label("RBR.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Konto") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Nabavna cena") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Nabavna vrednost") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
			</tr>
		</thead>
		<tbody>
			for _, st := range pop.Stavke {
				<tr class="print:page-break-inside-avoid">
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
					<td class={ robnoStampaTdClass }>{ st.Konto }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
					<td class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
					<td class={ robnoStampaTdClass }>{ st.Jm }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaCena }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaVrednost }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
				</tr>
			}
		</tbody>
		<tfoot>
			<tr class="font-bold print:page-break-inside-avoid">
				<td colspan="7" class="border border-gray-500 px-1 py-0.5 text-right uppercase">{ translator.Label("Ukupno") }</td>
				<td class="border border-gray-500 px-1 py-0.5 text-right">{ pop.UkupnoNabavnaVrednost }</td>
				<td class="border border-gray-500 px-1 py-0.5"></td>
				<td class="border border-gray-500 px-1 py-0.5 text-right">{ pop.UkupnoIznos }</td>
			</tr>
		</tfoot>
	</table>
}

// RobnoStampaPopisZaglavlje renders the page header of the popis: the firm on the left, the broj and
templ RobnoStampaPopisZaglavlje(repParams domain.ReportParameters, pop domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-left font-normal">
		<div class="grid grid-cols-[1fr_2fr_1fr] items-start">
			<!-- The firm like the header of the default reports (rep.ReportPageHeader): the naziv in bold and
			     the adresa, poštanski broj, mesto and godina of the session under it. -->
			<div class="text-[10px]">
				<div class="font-bold text-sm print:leading-tight">{ repParams.CompanyName }</div>
				<div class="print:leading-tight">
					{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", robnoStampaGodina(repParams)) }. { translator.Label("godina") }
				</div>
			</div>
			<div class="grid grid-cols-[auto_auto] justify-center gap-x-2 text-[15px] print:text-[13pt] leading-snug">
				<span class="font-bold text-right">{ translator.Label("Broj dokumenta") }:</span>
				<span>{ pop.BrojDokumenta }</span>
				<span class="font-bold text-right">{ translator.Label("Datum dokumenta") }:</span>
				<span>{ pop.DatumDokumenta }</span>
			</div>
			<div></div>
		</div>
		<div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1">
			if pop.Grupa == "POP" {
				@robnoStampaPopisPolje("", "")
			} else {
				@robnoStampaPopisPolje(translator.Label("Izvorni dokument"), pop.IzvorniDokument)
			}
			@robnoStampaPopisPolje(translator.Label("Vrsta dokum."), pop.VrstaDokumenta)
			@robnoStampaPopisPolje(translator.Label("Vrsta/Broj naloga"), pop.Nalog)
			@robnoStampaPopisPolje(translator.Label("Magacin"), pop.Magacin)
			@robnoStampaPopisPolje(translator.Label("OJ"), pop.Oj)
			@robnoStampaPopisPolje(translator.Label("OJ gde ide roba"), pop.OjPrijem)
			@robnoStampaPopisPolje(translator.Label("Mesto troška"), pop.MestoTroska)
			@robnoStampaPopisPolje(translator.Label("Mesto troška gde ide roba"), pop.MestoTroskaPrijem)
		</div>
	</div>
}

// robnoStampaGodina returns the godina of the header of a printed robni dokument: the godina of the
// session (repParams.God), else the current year like the default reports.
func robnoStampaGodina(repParams domain.ReportParameters) int {
	if repParams.God != 0 {
		return repParams.God
	}
	return time.Now().Year()
}

// robnoStampaPopisPolje renders one "label: value" cell of the header of the popis: the label aligned
// to the right of its half of the header, the value in bold (an empty label leaves the cell empty).
templ robnoStampaPopisPolje(label, value string) {
	<div class="grid grid-cols-[1fr_1fr] gap-x-2">
		if label != "" {
			<span class="text-right">{ label }:</span>
			<span class="font-bold">{ value }</span>
		}
	</div>
}

// RobnoStampaPopisPotpisi renders the signatures of the popis: the računopolagač on the left and the
// three members of the popisna komisija on the right.
templ RobnoStampaPopisPotpisi(translator *i18n.Service) {
	<div class="mt-6 grid grid-cols-2 gap-12 no-break">
		<div>
			<div>{ translator.Label("Računopolagač") }</div>
			<div class="mt-10 border-b border-black w-3/4"></div>
		</div>
		<div>
			<div class="ml-8">{ translator.Label("Popisna komisija") }:</div>
			for _, clan := range []string{"1.", "2.", "3."} {
				<div class="mt-4 flex items-end gap-2">
					<span>{ clan }</span>
					<span class="flex-1 border-b border-black"></span>
				</div>
			}
		</div>
	</div>
}

// robnoStampaPopisColumnWidths are the widths of the columns of the stavke of the popis: rbr, konto,
// šifra, naziv, JM, količina, nabavna cena, nabavna vrednost, cena and iznos.
var robnoStampaPopisColumnWidths = []string{"5%", "6%", "6%", "28%", "5%", "10%", "9%", "12%", "8%", "11%"}

//
// Štampa kalkulacije veleprodaje: the report RobnoStampaKalkulacija (prijemni listovi, the group PLT
// of the vrste dokumenta, the legacy RPT_ROB_KALKULACIJA)
//

// RobnoStampaKalkulacija renders the printed kalkulacije veleprodaje of the selection, every kalkulacija
// from a new page: a domestic document with RobnoStampaKalkulacijaContent (with the porezi of the
// document of the dobavljač), a document in a foreign valuta with RobnoStampaKalkulacijaInoContent
// (with the valuta and the kurs).
templ RobnoStampaKalkulacija(repParams domain.ReportParameters, kalkulacije []domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaKalkulacijaDokumenti(repParams, kalkulacije, translator), translator))
}

// robnoStampaKalkulacijaDokumenti returns the printed kalkulacije for RobnoStampaDokumenti, each with
// the template of its valuta.
func robnoStampaKalkulacijaDokumenti(repParams domain.ReportParameters, kalkulacije []domain.RobnoStampaKalkulacijaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(kalkulacije))
	for _, kal := range kalkulacije {
		if kal.Maloprodaja {
			dokumenti = append(dokumenti, RobnoStampaKalkulacijaMPContent(repParams, kal, translator))
		} else if kal.Devizni {
			dokumenti = append(dokumenti, RobnoStampaKalkulacijaInoContent(repParams, kal, translator))
		} else {
			dokumenti = append(dokumenti, RobnoStampaKalkulacijaContent(repParams, kal, translator))
		}
	}
	return dokumenti
}

// RobnoStampaKalkulacijaContent renders the kalkulacija of a domestic dobavljač: the stavke, the porezi
// of the document of the dobavljač by poreska tarifa and the signatures.
templ RobnoStampaKalkulacijaContent(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		@RobnoStampaKalkulacijaStavke(repParams, kal, translator)
		@RobnoStampaKalkulacijaPorezi(kal, translator)
		@RobnoStampaKalkulacijaPotpisi(translator)
	</div>
}

// RobnoStampaKalkulacijaInoContent renders the kalkulacija of a foreign dobavljač (a document in a
// foreign valuta): the stavke, the valuta with the devizni kurs and the signatures.
templ RobnoStampaKalkulacijaInoContent(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		@RobnoStampaKalkulacijaStavke(repParams, kal, translator)
		<div class="mt-10 flex gap-6 no-break">
			<span>{ translator.Label("Valuta") }:</span>
			<span>{ kal.Valuta } { translator.Label("Devizni kurs") }: 1 { kal.Oznaka } = { kal.Kurs }</span>
		</div>
		@RobnoStampaKalkulacijaPotpisi(translator)
	</div>
}

// RobnoStampaKalkulacijaStavke renders the stavke of the kalkulacija, two lines per artikal (the cene
// on the first line, the vrednosti on the second), with the totals of the document. The header of the
// document and the two lines of the header of the stavke are the <thead> of the table, so the browser
// repeats them on every printed page like the page header of the legacy report.
templ RobnoStampaKalkulacijaStavke(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<table class="w-full border-collapse" style="table-layout: fixed;">
		<colgroup>
			for _, width := range robnoStampaKalkulacijaColumnWidths {
				<col style={ "width: " + width }/>
			}
		</colgroup>
		<thead>
			<tr>
				<td colspan={ fmt.Sprintf("%d", len(robnoStampaKalkulacijaColumnWidths)) } class="pb-2">
					@RobnoStampaKalkulacijaZaglavlje(repParams, kal, translator)
				</td>
			</tr>
			<tr class="bg-gray-200 print:bg-gray-200">
				<th class={ robnoStampaThClass }>{ translator.Label("Red. br.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Fakturna cena") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Neto fakt. cena") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Oz na") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Zavisni trošak") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Zavis.troš. dr.dobavlj.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Oz na") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Zav.tr. interni") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Nabavna cena") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("% VP marže") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Veleprodajna cena") }</th>
			</tr>
			<tr class="bg-gray-200 print:bg-gray-200">
				<th colspan="5" class="bg-white"></th>
				<th class={ robnoStampaThClass }>{ translator.Label("Fakturna vrednost") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Neto fakt. vrednost") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("ka tr.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Vrednost zav.troška") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Vre. zav.tr. dr.dobav.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("ka tr.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Vr. int. zav.troš") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Nabavna vrednost") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Vrednost marže") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Veleprodajna vrednost") }</th>
			</tr>
		</thead>
		for _, st := range kal.Stavke {
			<tbody class="print:page-break-inside-avoid" style="break-inside: avoid;">
				<tr>
					<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
					<td rowspan="2" class={ robnoStampaTdClass }>{ st.Sifra }</td>
					<td rowspan="2" class={ robnoStampaTdClass + " break-words align-middle" }>{ st.Naziv }</td>
					<td rowspan="2" class={ robnoStampaTdClass + " align-middle" }>{ st.Jm }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.FakturnaCena }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Rabat }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NetoCena }</td>
					<td class={ robnoStampaTdClass + " text-center" }>{ st.OznakaTroska }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.ZavisniTrosak }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.ZavisniTrosakDobavljaca }</td>
					<td class={ robnoStampaTdClass + " text-center" }>{ st.OznakaInternog }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.InterniTrosak }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaCena }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Marza }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VpCena }</td>
				</tr>
				<tr>
					<td class={ robnoStampaTdClass }></td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.FakturnaVrednost }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostRabata }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NetoVrednost }</td>
					<td class={ robnoStampaTdClass }></td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostTroska }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostTroskaDobavljaca }</td>
					<td class={ robnoStampaTdClass }></td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostInternog }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaVrednost }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostMarze }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.VpVrednost }</td>
				</tr>
			</tbody>
		}
		<tfoot>
			<tr class="font-bold print:page-break-inside-avoid">
				<td colspan="4" class="px-1 py-0.5 text-center text-[11px] print:text-[9pt]">{ translator.Label("Ukupno za dokument") }: { kal.BrojDokumenta }</td>
				<td></td>
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.FakturnaVrednost)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostRabata)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.NetoVrednost)
				<td></td>
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostTroska)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostTroskaDobavljaca)
				<td></td>
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostInternog)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.NabavnaVrednost)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostMarze)
				@robnoStampaKalkulacijaUkupno(kal.Ukupno.VpVrednost)
			</tr>
		</tfoot>
	</table>
}

// robnoStampaKalkulacijaUkupno renders one total of the kalkulacija (a bold framed cell).
templ robnoStampaKalkulacijaUkupno(value string) {
	<td class="border border-gray-500 px-1 py-0.5 text-right text-[10px] print:text-[8pt]">{ value }</td>
}

// RobnoStampaKalkulacijaZaglavlje renders the page header of the kalkulacija: the firm and the title
templ RobnoStampaKalkulacijaZaglavlje(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<div class="text-left font-normal text-[10px] print:text-[8pt]">
		<div class="grid grid-cols-[1fr_2fr_1fr] items-start">
			<div>
				<div class="print:leading-tight">{ repParams.CompanyName }</div>
				<div class="print:leading-tight">
					{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", robnoStampaGodina(repParams)) }. { translator.Label("godina") }
				</div>
			</div>
			<div class="text-center text-[16px] print:text-[13pt] font-bold uppercase">
				{ translator.Label("Kalkulacija veleprodaje br.") }: { kal.BrojDokumenta }
			</div>
			<div></div>
		</div>
		<div class="mt-3 grid grid-cols-[45%_30%_25%] items-end">
			<div class="flex items-baseline gap-6 border-b border-black pb-0.5">
				<span class="text-[15px] print:text-[12pt] font-bold uppercase">{ translator.Label("Dobavljač") }</span>
				<span>{ translator.Label("Konto dobavljača") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.KontoDobavljaca }</span></span>
				<span>{ translator.Label("Analitička šifra") } <span class="ml-1 font-bold">{ kal.SifraDobavljaca }</span></span>
			</div>
			<div class="text-center">
				{ translator.Label("Magacin") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.Magacin }</span>
			</div>
			<div>
				{ translator.Label("Vrsta/Broj naloga") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.Nalog }</span>
			</div>
		</div>
		<div class="mt-2 grid grid-cols-[45%_30%_25%] items-start">
			<div>
				<div class="font-bold">{ kal.DobavljacNaziv }</div>
				<div class="mt-2 grid grid-cols-[2fr_2fr_1fr] gap-x-2 font-bold">
					<span>{ kal.DobavljacAdresa }</span>
					<span>{ kal.DobavljacMesto }</span>
					<span><span class="font-normal">{ translator.Label("PIB") }</span> { kal.DobavljacPib }</span>
				</div>
			</div>
			<div class="grid grid-cols-[1fr_1fr] gap-x-2">
				<span class="text-right">{ translator.Label("Datum dokumenta") }</span>
				<span class="font-bold">{ kal.DatumDokumenta }</span>
				<span class="text-right">{ translator.Label("Način dopremanja") }</span>
				<span class="font-bold">{ kal.NacinDopremanja }</span>
				<span class="text-right">{ translator.Label("Br. dokum. dobavlj.") }</span>
				<span>{ kal.DokumentDobavljaca }</span>
				<span class="text-right">{ translator.Label("Datum dokum. dobavlj.") }</span>
				<span class="font-bold">{ kal.DatumDokumentaDobavljaca }</span>
			</div>
			<div class="grid grid-cols-[auto_1fr] gap-x-2">
				<span class="text-right">{ translator.Label("Način plaćanja") }</span>
				<span class="font-bold">{ kal.NacinPlacanja }</span>
				<span class="text-right">{ translator.Label("Rok plaćanja") }</span>
				<span><span class="font-bold">{ kal.RokPlacanja }</span> <span class="ml-4">{ translator.Label("Dana") }</span></span>
				<span class="text-right">{ translator.Label("Napomena") }</span>
				<span>{ kal.Napomena }</span>
			</div>
		</div>
	</div>
}

// RobnoStampaKalkulacijaPorezi renders the porezi of the document of a domestic dobavljač ("Po
// dokumentu dobavljača"): per poreska tarifa the iznos of the document, the osnovica, the obračunat
// porez, the tarifa and the stopa, with the totals.
templ RobnoStampaKalkulacijaPorezi(kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	if len(kal.Porezi) > 0 {
		<div class="mt-4 no-break">
			<div class="font-bold uppercase">{ translator.Label("Po dokumentu dobavljača") }:</div>
			<table class="border-collapse" style="width: 45%; table-layout: fixed;">
				<colgroup>
					<col style="width: 24%"/>
					<col style="width: 24%"/>
					<col style="width: 24%"/>
					<col style="width: 14%"/>
					<col style="width: 14%"/>
				</colgroup>
				<thead>
					<tr class="bg-gray-200 print:bg-gray-200">
						<th class={ robnoStampaThClass }>{ translator.Label("Iznos dokumenta dobavljača") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Osnovica") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Obračunat porez prilikom nabavke") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Poreska tarifa") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("% Poreza") }</th>
					</tr>
				</thead>
				<tbody>
					for _, pz := range kal.Porezi {
						<tr>
							<td class={ robnoStampaTdClass + " text-right" }>{ pz.IznosDokumenta }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ pz.Osnovica }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ pz.Porez }</td>
							<td class={ robnoStampaTdClass + " text-center" }>{ pz.Tarifa }</td>
							<td class={ robnoStampaTdClass + " text-right" }>{ pz.Stopa }</td>
						</tr>
					}
					<tr class="font-bold">
						@robnoStampaKalkulacijaUkupno(kal.UkupnoPorezi.IznosDokumenta)
						@robnoStampaKalkulacijaUkupno(kal.UkupnoPorezi.Osnovica)
						@robnoStampaKalkulacijaUkupno(kal.UkupnoPorezi.Porez)
					</tr>
				</tbody>
			</table>
		</div>
	}
}

// RobnoStampaKalkulacijaPotpisi renders the signatures of the kalkulacija: the referent kalkulisanja,
// who received the goods and who checked them.
templ RobnoStampaKalkulacijaPotpisi(translator *i18n.Service) {
	<div class="mt-6 grid grid-cols-3 gap-16 px-8 text-center font-bold no-break">
		for _, potpis := range []string{"Referent kalkulisanja", "Robu primio", "Kontrolisao"} {
			<div>
				<div>{ translator.Label(potpis) }</div>
				<div class="mt-10 border-b border-black"></div>
			</div>
		}
	</div>
}

// robnoStampaKalkulacijaColumnWidths are the widths of the columns of the stavke of the kalkulacija:
// Red. br., šifra, naziv, JM, količina, fakturna cena, % rabata, neto fakturna cena, oznaka, zavisni
// trošak, zavisni trošak drugih dobavljača, oznaka, interni zavisni trošak, nabavna cena, % marže and
// veleprodajna cena (the vrednosti on the second line share them).
var robnoStampaKalkulacijaColumnWidths = []string{"3%", "4%", "14.5%", "3.5%", "6%", "6.5%", "6%", "6.5%", "2%", "6%", "7%", "2%", "5.5%", "7%", "7%", "7.5%"}

// RobnoStampaKalkulacijaMPContent renders the kalkulacija maloprodaje (the legacy RPT_ROB_KALKULACIJA_MP):
// the stavke at the maloprodajne cene, the porezi of the document of the dobavljač and of the kalkulacija
// side by side and the signatures.
templ RobnoStampaKalkulacijaMPContent(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaKalkulacijaMPColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaKalkulacijaMPColumnWidths)) } class="pb-2">
						@RobnoStampaKalkulacijaMPZaglavlje(repParams, kal, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Red. br.") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Fakturna cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Neto fakt. cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Oz na") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Zavisni trošak") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Nabavna cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% MP marže") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Maloprodajna cena sa PDV") }</th>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Fakturna vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Neto fakt. vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("ka tr.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost zav.troška") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Nabavna vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost marže") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Maloprodajna vrednost") }</th>
				</tr>
			</thead>
			for _, st := range kal.Stavke {
				<tbody class="print:page-break-inside-avoid" style="break-inside: avoid;">
					<tr>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td rowspan="2" class={ robnoStampaTdClass }>{ st.Sifra }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " break-words align-middle" }>{ st.Naziv }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " align-middle" }>{ st.Jm }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.FakturnaCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NetoCena }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.OznakaTroska }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.ZavisniTrosak }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Marza }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StopaPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.MpCena }</td>
					</tr>
					<tr>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.FakturnaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NetoVrednost }</td>
						<td class={ robnoStampaTdClass }></td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostTroska }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostMarze }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.VrednostPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.MpVrednost }</td>
					</tr>
				</tbody>
			}
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="5" class="px-1 py-0.5 text-center text-[11px] print:text-[9pt]">{ translator.Label("Ukupno za dokument") }: { kal.BrojDokumenta }</td>
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.FakturnaVrednost)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostRabata)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.NetoVrednost)
					<td></td>
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostTroska)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.NabavnaVrednost)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostMarze)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.VrednostPdv)
					@robnoStampaKalkulacijaUkupno(kal.Ukupno.MpVrednost)
				</tr>
			</tfoot>
		</table>
		<div class="mt-4 flex justify-between items-start gap-6 no-break">
			<div class="flex-1">
				@RobnoStampaKalkulacijaPorezi(kal, translator)
			</div>
			if len(kal.PoreziKalkulacije) > 0 {
				<div class="w-[30%] mt-4">
					<div class="font-bold uppercase">{ translator.Label("Po kalkulaciji") }:</div>
					<table class="w-full border-collapse" style="table-layout: fixed;">
						<thead>
							<tr class="bg-gray-200 print:bg-gray-200">
								<th class={ robnoStampaThClass }>{ translator.Label("Osnovica") }</th>
								<th class={ robnoStampaThClass }>{ translator.Label("Ukalkulisani porez") }</th>
								<th class={ robnoStampaThClass }>{ translator.Label("Poreska tarifa") }</th>
								<th class={ robnoStampaThClass }>{ translator.Label("% Poreza") }</th>
							</tr>
						</thead>
						<tbody>
							for _, pz := range kal.PoreziKalkulacije {
								<tr>
									<td class={ robnoStampaTdClass + " text-right" }>{ pz.Osnovica }</td>
									<td class={ robnoStampaTdClass + " text-right" }>{ pz.Porez }</td>
									<td class={ robnoStampaTdClass + " text-center" }>{ pz.Tarifa }</td>
									<td class={ robnoStampaTdClass + " text-right" }>{ pz.Stopa }</td>
								</tr>
							}
							<tr class="font-bold">
								@robnoStampaKalkulacijaUkupno(kal.UkupnoPoreziKalk.Osnovica)
								@robnoStampaKalkulacijaUkupno(kal.UkupnoPoreziKalk.Porez)
							</tr>
						</tbody>
					</table>
				</div>
			}
		</div>
		<div class="mt-6 grid grid-cols-3 gap-16 px-8 text-center font-bold no-break">
			for _, potpis := range []string{"Referent kalkulacije", "Robu primio", "Kontrolisao"} {
				<div>
					<div>{ translator.Label(potpis) }</div>
					<div class="mt-10 border-b border-black"></div>
				</div>
			}
		</div>
	</div>
}

// RobnoStampaKalkulacijaMPZaglavlje renders the page header of the kalkulacija maloprodaje like the
// legacy report: the firm (naziv, adresa and mesto, PIB with the šifra delatnosti and the matični broj,
// telefon) and the title with the time of the print; the dobavljač, the prodavnica with the dates and the
// documents, the nalog with the način and the rok plaćanja and the napomena.
templ RobnoStampaKalkulacijaMPZaglavlje(repParams domain.ReportParameters, kal domain.RobnoStampaKalkulacijaView, translator *i18n.Service) {
	<div class="text-left font-normal text-[10px] print:text-[8pt]">
		<div class="grid grid-cols-[1fr_2fr_1fr] items-start">
			<div class="text-center leading-snug">
				<div>{ repParams.CompanyName }</div>
				<div>{ kal.FirmaMesto }</div>
				<div>{ kal.FirmaPib }</div>
				<div>{ kal.FirmaTel }</div>
			</div>
			<div class="text-center text-[16px] print:text-[13pt] font-bold uppercase">
				{ translator.Label("Kalkulacija maloprodaje br.") }: { kal.BrojDokumenta }
			</div>
			<div class="text-right">{ kal.VremeStampe }</div>
		</div>
		<div class="mt-3 grid grid-cols-[45%_30%_25%] items-end">
			<div class="flex items-baseline gap-6 border-b border-black pb-0.5">
				<span class="text-[15px] print:text-[12pt] font-bold uppercase">{ translator.Label("Dobavljač") }</span>
				<span>{ translator.Label("Konto dobavljača") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.KontoDobavljaca }</span></span>
				<span>{ translator.Label("Analitička šifra") } <span class="ml-1 font-bold">{ kal.SifraDobavljaca }</span></span>
			</div>
			<div class="text-center">
				{ translator.Label("Prodavnica") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.Prodavnica }</span>
			</div>
			<div>
				{ translator.Label("Vrsta/Broj naloga") } <span class="ml-1 text-[13px] print:text-[10pt] font-bold">{ kal.Nalog }</span>
			</div>
		</div>
		<div class="mt-2 grid grid-cols-[45%_30%_25%] items-start">
			<div>
				<div class="font-bold">{ kal.DobavljacNaziv }</div>
				<div class="mt-2 grid grid-cols-[2fr_2fr_1fr] gap-x-2 font-bold">
					<span>{ kal.DobavljacAdresa }</span>
					<span>{ kal.DobavljacMesto }</span>
					<span><span class="font-normal">{ translator.Label("PIB") }</span> { kal.DobavljacPib }</span>
				</div>
			</div>
			<div class="grid grid-cols-[1fr_1fr] gap-x-2">
				<span class="text-right">{ translator.Label("Datum dokumenta") }</span>
				<span class="font-bold">{ kal.DatumDokumenta }</span>
				<span class="text-right">{ translator.Label("Način dopremanja") }</span>
				<span class="font-bold">{ kal.NacinDopremanja }</span>
				<span class="text-right">{ translator.Label("Br. dokum. dobavlj.") }</span>
				<span>{ kal.DokumentDobavljaca }</span>
				<span class="text-right">{ translator.Label("Datum dokum. dobavlj.") }</span>
				<span class="font-bold">{ kal.DatumDokumentaDobavljaca }</span>
			</div>
			<div class="grid grid-cols-[auto_1fr] gap-x-2">
				<span class="text-right">{ translator.Label("Način plaćanja") }</span>
				<span class="font-bold">{ kal.NacinPlacanja }</span>
				<span class="text-right">{ translator.Label("Rok plaćanja") }</span>
				<span><span class="font-bold">{ kal.RokPlacanja }</span> <span class="ml-4">{ translator.Label("Dana") }</span></span>
				<span class="text-right">{ translator.Label("Napomena") }</span>
				<span>{ kal.Napomena }</span>
			</div>
		</div>
	</div>
}

// robnoStampaKalkulacijaMPColumnWidths are the widths of the columns of the stavke of the kalkulacija
// maloprodaje: Red. br., šifra, naziv, JM, količina, fakturna cena, % rabata, neto fakturna cena, oznaka,
// zavisni trošak, nabavna cena, % MP marže, % PDV-a and maloprodajna cena sa PDV (the vrednosti on the
// second line share them).
var robnoStampaKalkulacijaMPColumnWidths = []string{"3%", "4.5%", "17%", "3.5%", "6.5%", "7.5%", "7%", "7.5%", "2.5%", "7%", "8%", "8%", "7.5%", "10.5%"}

//
// Štampa internog prenosa proizvodnje: the report RobnoStampaInterniPrenos (the group PPR of the vrste
// dokumenta, the legacy ROB_RPT_INTRAC_PROIZV)
//

// RobnoStampaInterniPrenos renders the printed interni prenosi proizvodnje or interne zaključnice (the
// legacy ROB_RPT_STAMPA_INTRAC, the view marked Interna: the VP cena and the veleprodajni rabat, the
// barkod under the naziv, the mesto of the firm without the godina) of the selection, every document from
// a new page.
templ RobnoStampaInterniPrenos(repParams domain.ReportParameters, prenosi []domain.RobnoStampaInterniPrenosView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaInterniPrenosDokumenti(repParams, prenosi, translator), translator))
}

// robnoStampaInterniPrenosDokumenti returns the printed interni prenosi for RobnoStampaDokumenti.
func robnoStampaInterniPrenosDokumenti(repParams domain.ReportParameters, prenosi []domain.RobnoStampaInterniPrenosView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(prenosi))
	for _, p := range prenosi {
		out = append(out, RobnoStampaInterniPrenosContent(repParams, p, translator))
	}
	return out
}

// RobnoStampaInterniPrenosContent renders one interni prenos proizvodnje like the legacy report: the
// header of the document and the header of the stavke are the <thead> of the table (repeated on every
// printed page); the stavke on two lines (the cene, the vrednosti), the totals of the document, the
// signatures and the porezi per tarifa with their total.
templ RobnoStampaInterniPrenosContent(repParams domain.ReportParameters, p domain.RobnoStampaInterniPrenosView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaInterniPrenosColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaInterniPrenosColumnWidths)) } class="pb-2">
						@RobnoStampaInterniPrenosZaglavlje(repParams, p, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					if p.Interna {
						<th class={ robnoStampaThClass }>{ translator.Label("VP Cena") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Velepr. rabat") }</th>
					} else {
						<th class={ robnoStampaThClass }>{ translator.Label("Proizvodna cena") }</th>
						<th class={ robnoStampaThClass }>{ translator.Label("Rabat") }</th>
					}
					<th class={ robnoStampaThClass }>{ translator.Label("Nabavna vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Marža") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Malopr. cena bez poreza") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Taksa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska tarifa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Malopr. cena sa porezom") }</th>
				</tr>
			</thead>
			for _, st := range p.Stavke {
				<tbody class="print:page-break-inside-avoid" style="break-inside: avoid;">
					<tr>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " break-words" }>
							<div class="whitespace-pre-line">{ st.Naziv }</div>
							if st.Barkod != "" {
								<div>{ st.Barkod }</div>
							}
						</td>
						<td rowspan="2" class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Marza }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.McBezPoreza }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Taksa }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Tarifa }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Stopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Mc }</td>
					</tr>
					<tr>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Vrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.RabatIznos }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NabavnaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.MarzaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.McBezPorezaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.TaksaVrednost }</td>
						<td class={ robnoStampaTdClass }></td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.PorezVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.McVrednost }</td>
					</tr>
				</tbody>
			}
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="5" class="px-1 py-0.5 text-center">{ translator.Label("Ukupno za dokument") }: { p.BrojDokumenta }</td>
					@robnoStampaKalkulacijaUkupno(p.Ukupno.Vrednost)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.RabatIznos)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.NabavnaVrednost)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.MarzaVrednost)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.McBezPorezaVrednost)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.TaksaVrednost)
					<td></td>
					@robnoStampaKalkulacijaUkupno(p.Ukupno.PorezVrednost)
					@robnoStampaKalkulacijaUkupno(p.Ukupno.McVrednost)
				</tr>
			</tfoot>
		</table>
		<div class="mt-8 grid grid-cols-3 gap-8 no-break">
			for _, potpis := range []string{"Fakturisao", "Robu izdao", "Robu primio"} {
				<div class="flex items-end gap-2">
					<span>{ translator.Label(potpis) } :</span>
					<span class="flex-1 border-b border-black"></span>
				</div>
			}
		</div>
		@robnoStampaInterniPrenosPorezi(p, translator)
	</div>
}

// robnoStampaInterniPrenosPorezi renders the porezi per tarifa of the interni prenos with their total
// (the legacy ITERATION_PORHEDER, _PORBODY and _PDV_TOT).
templ robnoStampaInterniPrenosPorezi(p domain.RobnoStampaInterniPrenosView, translator *i18n.Service) {
	if len(p.Porezi) > 0 {
		<table class="mt-4 border-collapse no-break" style="width: 55%; table-layout: fixed;">
			<thead>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("SP") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Tarifa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska osnovica") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Malopr. iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, pz := range p.Porezi {
					<tr>
						<td class={ robnoStampaTdClass + " text-center" }>{ pz.Sp }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ pz.Tarifa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ pz.Osnovica }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ pz.Stopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ pz.Pdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ pz.MaloprodajniIznos }</td>
					</tr>
				}
				<tr class="font-bold">
					<td colspan="2" class="border border-gray-500 px-1 py-0.5 text-center uppercase">{ translator.Label("Ukupno") }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ p.UkupnoPorezi.Osnovica }</td>
					<td class="border border-gray-500 px-1 py-0.5"></td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ p.UkupnoPorezi.Pdv }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ p.UkupnoPorezi.MaloprodajniIznos }</td>
				</tr>
			</tbody>
		</table>
	}
}

// RobnoStampaInterniPrenosZaglavlje renders the page header of the interni prenos proizvodnje like the
// legacy report: the firm on the left, the opis of the vrsta dokumenta with the broj, the date and the
// nalog in the middle, the objekat the goods come from (the magacin with its adresa) and the one they go
// to (the konto and the šifra with the naziv) on the right.
templ RobnoStampaInterniPrenosZaglavlje(repParams domain.ReportParameters, p domain.RobnoStampaInterniPrenosView, translator *i18n.Service) {
	<div class="grid grid-cols-[1fr_1fr_1.4fr] gap-4 items-start text-left font-normal">
		<div class="text-[10px]">
			<div class="font-bold text-sm print:leading-tight">{ repParams.CompanyName }</div>
			if p.Interna {
				<div class="print:leading-tight">{ repParams.City }</div>
			} else {
				<div class="print:leading-tight">{ repParams.City } - { fmt.Sprintf("%d", robnoStampaGodina(repParams)) }. { translator.Label("godina") }</div>
			}
		</div>
		<div class="text-center leading-snug">
			<div class="font-bold text-[14px] print:text-[12pt]">{ p.Naslov } { p.BrojDokumenta }</div>
			<div class="mt-2">{ translator.Label("Datum dokumenta") }: <span class="font-bold">{ p.DatumDokumenta }</span></div>
			<div>{ translator.Label("Vrsta/Broj naloga") }: <span class="font-bold">{ p.Nalog }</span></div>
		</div>
		<div class="grid grid-cols-[auto_1fr] gap-x-2 leading-snug">
			<span class="text-right">{ translator.Label("Objekat odakle dolazi roba") }:</span>
			<div>
				<div class="font-bold">{ p.MagacinIzlaz }</div>
				<div>{ p.MagacinIzlazAdresa }</div>
			</div>
			<span class="text-right">{ translator.Label("Objekat gde ide roba") }:</span>
			<div>
				<div class="font-bold">{ p.ObjekatPrijem }</div>
				<div>{ p.ObjekatPrijemNaziv }</div>
			</div>
		</div>
	</div>
}

// robnoStampaInterniPrenosColumnWidths are the widths of the columns of the stavke of the interni prenos:
// rbr, šifra, naziv, JM, količina, proizvodna cena, rabat, nabavna vrednost, marža, maloprodajna cena bez
// poreza, taksa, poreska tarifa, poreska stopa and maloprodajna cena sa porezom.
var robnoStampaInterniPrenosColumnWidths = []string{"3%", "4%", "24%", "3%", "6%", "7%", "6%", "7%", "6%", "8%", "6%", "6%", "6%", "8%"}

//
// Štampa računa - otpremnice interne zaključnice: the report RobnoStampaInternaZakljucnicaRacun (the group
// IRT with the option irrn, the legacy ROB_RPT_STAMPA_INTRACFKT)
//

// RobnoStampaInternaZakljucnicaRacun renders the printed računi - otpremnice of the interne zaključnice of
// the selection, every document from a new page.
templ RobnoStampaInternaZakljucnicaRacun(repParams domain.ReportParameters, racuni []domain.RobnoStampaInternaZakljucnicaRacunView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaInternaZakljucnicaRacunDokumenti(repParams, racuni, translator), translator))
}

// robnoStampaInternaZakljucnicaRacunDokumenti returns the printed računi for RobnoStampaDokumenti.
func robnoStampaInternaZakljucnicaRacunDokumenti(repParams domain.ReportParameters, racuni []domain.RobnoStampaInternaZakljucnicaRacunView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(racuni))
	for _, r := range racuni {
		out = append(out, RobnoStampaInternaZakljucnicaRacunContent(repParams, r, translator))
	}
	return out
}

// RobnoStampaInternaZakljucnicaRacunContent renders one račun - otpremnica like the legacy report: the
// header and the header of the stavke are the <thead> of the table (repeated on every printed page); the
// stavke at the maloprodajne cene, the end of the račun (the napomena, the kamata, the signatures, the
// sud), the porezi per tarifa, the PDV per stopa with SVEGA, RABAT and ZA NAPLATU and the poreska
// napomena.
templ RobnoStampaInternaZakljucnicaRacunContent(repParams domain.ReportParameters, r domain.RobnoStampaInternaZakljucnicaRacunView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaInternaZakljucnicaRacunColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaInternaZakljucnicaRacunColumnWidths)) } class="pb-2">
						@RobnoStampaInternaZakljucnicaRacunZaglavlje(repParams, r.Faktura, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Malopr. cena bez poreza") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska tarifa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Malopr. cena sa porezom") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Maloprodajna vrednost") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range r.Prenos.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words whitespace-pre-line" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.McBezPoreza }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Tarifa }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Stopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Mc }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.McVrednost }</td>
					</tr>
				}
			</tbody>
		</table>
		@robnoStampaFakturaKraj(r.Faktura, "faktura_nadlezan_sud", translator)
		@robnoStampaInterniPrenosPorezi(r.Prenos, translator)
		@RobnoStampaFakturaMPRekapitulacija(r.Faktura, translator)
		if r.Faktura.PoreskaNapomena != "" {
			<div class="mt-2 no-break">{ translator.Label("Napomena") }: { translator.Label("Oslobođeno plaćanja PDV-a po") } { r.Faktura.PoreskaNapomena }</div>
		}
	</div>
}

// RobnoStampaInternaZakljucnicaRacunZaglavlje renders the page header of the račun - otpremnica like the
// legacy report: on the left the logo, the kupac (in a box marked by its corners) with the mesto
// isporuke and the otpremnica, the uslovi and the rok plaćanja; on the right the izdavalac, the title
// with the broj and the dates of the document.
templ RobnoStampaInternaZakljucnicaRacunZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					if fak.KupacKonto != "" || fak.KupacSifra != "" {
						<span class="ml-1">{ translator.Label("Šifra kupca") } : { strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
					}
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="text-center">{ fak.KupacPib }</div>
				<div class="text-center">{ fak.KupacTelefon }</div>
				if fak.MestoIsporuke != "" {
					<div class="mt-1 text-center">
						<div>{ fak.MestoIsporuke }</div>
						<div>{ fak.MestoIsporuke2 }</div>
					</div>
				}
			</div>
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				@robnoStampaFakturaPolje(translator.Label("Na osnovu otpremnice"), fak.Otpremnica)
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
			</div>
		</div>
		<div>
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
				<div>{ fak.FirmaZiro }</div>
				<div>{ fak.FirmaBankeNazivi }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug text-center">
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div class="col-span-2">{ fak.FirmaTel }</div>
			</div>
			<div class="mt-5 text-center">
				<span class="font-bold italic text-[16px] print:text-[13pt]">{ fak.Naslov } :</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum prometa dobara"), fak.DatumPrometa)
				@robnoStampaFakturaDesnoPolje(translator.Label("Valuta"), fak.Valuta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja računa"), fak.MestoIzdavanja)
			</div>
		</div>
	</div>
}

// robnoStampaInternaZakljucnicaRacunColumnWidths are the widths of the columns of the stavke of the
// račun - otpremnica: rbr, šifra, naziv, JM, količina, maloprodajna cena bez poreza, poreska tarifa,
// poreska stopa, maloprodajna cena sa porezom and maloprodajna vrednost.
var robnoStampaInternaZakljucnicaRacunColumnWidths = []string{"4%", "7%", "31%", "5%", "8%", "10%", "7%", "7%", "10%", "11%"}

//
// Štampa maloprodajnog računa: the report RobnoStampaFakturaMP (the group DIR of the vrste dokumenta,
// the legacy ROB_RPT_STAMPA_FAKTURA_MP)
//

// RobnoStampaFakturaMP renders the printed maloprodajni računi of the selection, every račun from a new
// page: the header (the firm with its magacin, the kupac and the data of the document), the stavke at
// the cena with the PDV, the avans, the PDV per poreska stopa, the totals and the end of the račun.
templ RobnoStampaFakturaMP(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaMPDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaFakturaMPDokumenti returns the printed maloprodajni računi for RobnoStampaDokumenti.
func robnoStampaFakturaMPDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaMPContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaFakturaMPContent renders one maloprodajni račun. The header of the document and the
// header of the stavke are the <thead> of the table of the stavke, so the browser repeats them on every
// printed page like the page header of the legacy report.
templ RobnoStampaFakturaMPContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaMPColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaMPColumnWidths)) } class="pb-2">
						@RobnoStampaFakturaMPZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("RBR.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Jed. mere") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Poreska stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena sa PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Rabat") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaMPRekapitulacija(fak, translator)
		@RobnoStampaFakturaAmbalaza(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		@RobnoStampaFakturaKrajDokumenta(fak, translator)
	</div>
}

// RobnoStampaFakturaMPZaglavlje renders the page header of the maloprodajni račun like the legacy
// report: on the left the logo, the firm (with the adresa of the magacin), its data, the Skladište
// (the magacin with its telefon and e-mail) and the data of the sale; on the right the kupac (in a box
// marked by its corners) with the mesto isporuke, the title "MP-Račun br.:" with the broj of the
// document and its dates.
templ RobnoStampaFakturaMPZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the firm, the Skladište and the data of the sale. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 text-center font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<!-- Skladište: the magacin of the print. -->
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				<span>{ translator.Label("Skladište") } :</span>
				<div class="text-center">
					<div class="font-bold">{ fak.MagacinOpis }</div>
					<div>{ fak.MagacinTel }</div>
					<div>{ fak.MagacinEmail }</div>
				</div>
			</div>
			<!-- The data of the sale. -->
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				@robnoStampaFakturaPolje(translator.Label("Na osnovu dokumenta"), fak.Otpremnica)
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
			</div>
			<div class="grid grid-cols-2 gap-x-3 leading-snug">
				<div>{ translator.Label("Vozač") } : <span class="font-bold">{ fak.Vozac }</span></div>
				<div>{ translator.Label("Broj vozila") } : <span class="font-bold">{ fak.RegBrojVozila }</span></div>
			</div>
		</div>
		<!-- Right: the kupac, the title and the data of the document. -->
		<div>
			<!-- The kupac: a box marked only by its four corners, like the legacy report. -->
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="flex justify-between gap-2">
					<span>{ fak.KupacMesto }</span>
					<span class="whitespace-nowrap mr-4">{ translator.Label("PAK") }<span class="ml-6">{ fak.KupacPak }</span></span>
				</div>
				<div class="text-center">{ translator.Label("PIB") } : { fak.KupacPib }</div>
				<div class="flex justify-between gap-6">
					<span>{ translator.Label("Matični broj") } : { fak.KupacMbr }</span>
					<span>{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</span>
				</div>
			</div>
			if fak.MestoIsporuke != "" || fak.MestoIsporuke2 != "" {
				<div class="mt-1 text-center leading-snug">
					<div>{ fak.MestoIsporuke }</div>
					<div>{ fak.MestoIsporuke2 }</div>
				</div>
			}
			<!-- "MP-Račun br.: 196-12" -->
			<div class="mt-4 text-center">
				<span class="font-bold text-[16px] print:text-[13pt]">{ fak.Naslov }:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum prometa dobara"), fak.DatumPrometa)
				@robnoStampaFakturaDesnoPolje(robnoStampaFakturaNaslov(fak.ValutaNaslov, translator.Label("Valuta")), fak.Valuta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja računa"), fak.MestoIzdavanja)
			</div>
		</div>
	</div>
}

// RobnoStampaFakturaMPRekapitulacija renders the totals of the maloprodajni račun like the legacy
// report: the avans with its PDV (ITERATION_AVANS), the PDV per poreska stopa with its osnovica and
// the iznos with the PDV (ITERATION_PDV), SVEGA, RABAT and ZA NAPLATU in a box on the right, the za
// naplatu po danima and the avansni PDV per stopa (ITERATION_AVPDV).
templ RobnoStampaFakturaMPRekapitulacija(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="mt-1 no-break">
		if fak.UkupnoAvans != "" {
			<div class="flex justify-end">
				<div class="w-[31%] grid grid-cols-2 border-b border-black font-bold">
					<span class="px-1 py-0.5 text-right uppercase">{ translator.Label("Avans") } :</span>
					<span class="px-1 py-0.5 text-right">{ fak.UkupnoAvans }</span>
				</div>
			</div>
		}
		for _, p := range fak.PdvPoStopama {
			<div class="grid grid-cols-[auto_1fr_auto_1fr_auto_1fr_1fr] gap-x-2 items-baseline py-0.5 font-bold">
				<span class="uppercase whitespace-nowrap">{ translator.Label("Porez na dodatu vrednost po stopi") } :</span>
				<span class="text-right">{ p.Stopa }</span>
				<span class="font-normal">{ translator.Label("Osnovica") } :</span>
				<span class="text-right">{ p.Osnovica }</span>
				<span class="font-normal">{ translator.Label("PDV") } :</span>
				<span class="text-right">{ p.Pdv }</span>
				<span class="text-right">{ p.Iznos }</span>
			</div>
		}
		<div class="mt-1 flex justify-end">
			<table class="w-[31%] border-collapse border border-black">
				<tbody>
					@robnoStampaFakturaMPZbir(translator.Label("Svega"), fak.Svega)
					@robnoStampaFakturaMPZbir(translator.Label("Rabat"), fak.Rabat)
					@robnoStampaFakturaMPZbir(translator.Label("Za naplatu"), fak.ZaNaplatu)
					if fak.OstaloZaUplatu != "" {
						@robnoStampaFakturaMPZbir(translator.Label("Ostalo za uplatu"), fak.OstaloZaUplatu)
					}
				</tbody>
			</table>
		</div>
		if len(fak.ZaNaplatuPoDanima) > 0 || len(fak.AvansniPdv) > 0 {
			<div class="mt-1 flex justify-end">
				<table class="w-[60%] border-collapse">
					<tbody>
						for _, dan := range fak.ZaNaplatuPoDanima {
							@robnoStampaFakturaZbir(translator.Label("Za naplatu do"), dan.Datum, dan.Iznos, false)
						}
						for _, p := range fak.AvansniPdv {
							@robnoStampaFakturaZbir(translator.Label("Avansni PDV po stopi"), p.Stopa+" "+translator.Label("Osnovica"), p.Osnovica, false)
							@robnoStampaFakturaZbir(translator.Label("Avansni PDV po stopi"), p.Stopa+" "+translator.Label("PDV"), p.Pdv, false)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// robnoStampaFakturaMPZbir renders one row of the box of the totals of the maloprodajni račun (SVEGA,
// RABAT, ZA NAPLATU): the label and the amount, framed.
templ robnoStampaFakturaMPZbir(label, value string) {
	<tr class="font-bold border-b border-black">
		<td class="px-1 py-0.5 text-right uppercase whitespace-nowrap border-r border-black">{ label } :</td>
		<td class="px-1 py-0.5 text-right text-[13px] print:text-[11pt]">{ value }</td>
	</tr>
}

// robnoStampaFakturaMPColumnWidths are the widths of the columns of the stavke of the maloprodajni
// račun: Red. br., naziv, jedinica mere, količina, poreska stopa, cena sa PDV, rabat and iznos.
var robnoStampaFakturaMPColumnWidths = []string{"4%", "35%", "6%", "9%", "9%", "13%", "8%", "16%"}

//
// Štampa opšteg dokumenta: the report RobnoStampaOpstiDokument (the groups OPD, POT, KOL and FIN of the
// vrste dokumenta, the legacy RPT_OPDSTAMPA)
//

// RobnoStampaOpstiDokument renders the printed opšti dokumenti of the selection, every document from a
// new page, with the header of the popis (the firm, the broj and the date, the nalog, the izvorni
// dokument, the vrsta dokumenta, the magacin, the organizacione jedinice and the mesta troška).
templ RobnoStampaOpstiDokument(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaOpstiDokumenti(repParams, dokumenti, translator), translator))
}

// robnoStampaOpstiDokumenti returns the printed opšti dokumenti for RobnoStampaDokumenti.
func robnoStampaOpstiDokumenti(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(dokumenti))
	for _, dok := range dokumenti {
		out = append(out, RobnoStampaOpstiDokumentContent(repParams, dok, translator))
	}
	return out
}

// RobnoStampaOpstiDokumentContent renders one opšti dokument by the group of its vrsta, like the
// legacy report: a finansijski dokument (FIN) only with the iznos of the stavke (ITERATION_FINHEDER,
// _BODYFIN and FINUKUPNO), a količinski dokument (KOL) only with the količina (ITERATION_KOLHEDER,
// _KOLBODY and _KOLFOOTER), the others with the nabavna and the prodajna cena (the body of the
// report). A popis tekuće godine (POT) ends with the signatures of the popis (POPISFOOTER), the others
// with the signatures of who issued, received and approved the goods (FINKOLFOOTER).
templ RobnoStampaOpstiDokumentContent(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		switch dok.Grupa {
			case "FIN":
				@robnoStampaOpstiDokumentJednaVrednost(repParams, dok, translator.Label("Iznos"), true, translator)
			case "KOL":
				@robnoStampaOpstiDokumentJednaVrednost(repParams, dok, translator.Label("Količina"), false, translator)
			default:
				@robnoStampaPopisTabela(repParams, dok, translator)
		}
		if dok.Grupa == "POT" {
			@RobnoStampaPopisPotpisi(translator)
		} else {
			@RobnoStampaOpstiDokumentPotpisi(translator)
		}
	</div>
}

// robnoStampaOpstiDokumentJednaVrednost renders the stavke of a finansijski (iznos) or of a količinski
// (not iznos: the količina) opšti dokument: rbr, konto, šifra, naziv, JM and the one value, with its
// total ("UKUPNO ZA DOKUMENT").
templ robnoStampaOpstiDokumentJednaVrednost(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, vrednost string, iznos bool, translator *i18n.Service) {
	<table class="w-full border-collapse" style="table-layout: fixed;">
		<colgroup>
			for _, width := range robnoStampaOpstiDokumentColumnWidths {
				<col style={ "width: " + width }/>
			}
		</colgroup>
		<thead>
			<tr>
				<td colspan={ fmt.Sprintf("%d", len(robnoStampaOpstiDokumentColumnWidths)) } class="pb-2">
					@RobnoStampaPopisZaglavlje(repParams, dok, translator)
				</td>
			</tr>
			<tr class="bg-gray-200 print:bg-gray-200">
				<th class={ robnoStampaThClass }>{ translator.Label("RBR.") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Konto") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
				<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
				<th class={ robnoStampaThClass }>{ vrednost }</th>
			</tr>
		</thead>
		<tbody>
			for _, st := range dok.Stavke {
				<tr class="print:page-break-inside-avoid">
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
					<td class={ robnoStampaTdClass }>{ st.Konto }</td>
					<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
					<td class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
					<td class={ robnoStampaTdClass }>{ st.Jm }</td>
					if iznos {
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
					} else {
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
					}
				</tr>
			}
		</tbody>
		<tfoot>
			<tr class="font-bold print:page-break-inside-avoid">
				<td colspan="5" class="border border-gray-500 px-1 py-0.5 text-right uppercase">{ translator.Label("Ukupno za dokument") }:</td>
				<td class="border border-gray-500 px-1 py-0.5 text-right">
					if iznos {
						{ dok.UkupnoIznos }
					} else {
						{ dok.UkupnoKolicina }
					}
				</td>
			</tr>
		</tfoot>
	</table>
}

// RobnoStampaOpstiDokumentPotpisi renders the signatures of an opšti dokument (FINKOLFOOTER): who issued
// and who received the goods on the left, who approved the document on the right.
templ RobnoStampaOpstiDokumentPotpisi(translator *i18n.Service) {
	<div class="mt-10 grid grid-cols-2 gap-12 items-end no-break">
		<div class="space-y-6">
			<div class="flex items-end gap-2">
				<span>{ translator.Label("Robu izdao") }:</span>
				<span class="flex-1 border-b border-black"></span>
			</div>
			<div class="flex items-end gap-2">
				<span>{ translator.Label("Robu primio") }:</span>
				<span class="flex-1 border-b border-black"></span>
			</div>
		</div>
		<div class="flex items-end gap-2">
			<span>{ translator.Label("Odobrio") }:</span>
			<span class="flex-1 border-b border-black"></span>
		</div>
	</div>
}

// robnoStampaOpstiDokumentColumnWidths are the widths of the columns of the stavke of a finansijski or
// of a količinski opšti dokument: rbr, konto, šifra, naziv, JM and the iznos or the količina.
var robnoStampaOpstiDokumentColumnWidths = []string{"6%", "6%", "8%", "50%", "6%", "24%"}

//
// Štampa prenosnice: the report RobnoStampaPrenosnica (the group PRI of the vrste dokumenta, the legacy
// RPT_ROB_PRENOSNICE)
//

// RobnoStampaPrenosnica renders the printed prenosnice of the selection, every prenosnica from a new
// page.
templ RobnoStampaPrenosnica(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaPrenosnicaDokumenti(repParams, dokumenti, translator), translator))
}

// robnoStampaPrenosnicaDokumenti returns the printed prenosnice for RobnoStampaDokumenti.
func robnoStampaPrenosnicaDokumenti(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(dokumenti))
	for _, dok := range dokumenti {
		out = append(out, RobnoStampaPrenosnicaContent(repParams, dok, translator))
	}
	return out
}

// RobnoStampaPrenosnicaContent renders one prenosnica like the legacy report: the header of the document
// and the header of the stavke are the <thead> of the table (repeated on every printed page); the
// stavke with the cena and the vrednost, UKUPNO and the signatures of who received, approved and
// handed over the goods.
templ RobnoStampaPrenosnicaContent(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaPrenosnicaColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaPrenosnicaColumnWidths)) } class="pb-2">
						@RobnoStampaPrenosnicaZaglavlje(repParams, dok, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("RBR.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Konto") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range dok.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass }>{ st.Konto }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words whitespace-pre-line" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="7" class="border border-gray-500 px-1 py-0.5 text-right uppercase">{ translator.Label("Ukupno") }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoIznos }</td>
				</tr>
			</tfoot>
		</table>
		@robnoStampaPrenosnicaPotpisi(translator)
	</div>
}

// robnoStampaPrenosnicaPotpisi renders the signatures of who received, approved and handed over the
// goods (the prenosnica and the zaduženje sitnog inventara).
templ robnoStampaPrenosnicaPotpisi(translator *i18n.Service) {
	<div class="mt-8 grid grid-cols-3 gap-8 no-break">
		for _, potpis := range []string{"Primio", "Odobrio", "Predao"} {
			<div class="flex items-end gap-2">
				<span>{ translator.Label(potpis) }:</span>
				<span class="flex-1 border-b border-black"></span>
			</div>
		}
	</div>
}

// RobnoStampaPrenosnicaZaglavlje renders the page header of the prenosnica: the firm on the left and the
// broj and the date of the document in the middle (like the popis); under them the nalog on the left,
// the vrsta dokumenta, the magacin the goods come from and the one they go to on the right.
templ RobnoStampaPrenosnicaZaglavlje(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-left font-normal">
		<div class="grid grid-cols-[1fr_2fr_1fr] items-start">
			<div class="text-[10px]">
				<div class="font-bold text-sm print:leading-tight">{ repParams.CompanyName }</div>
				<div class="print:leading-tight">
					{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", robnoStampaGodina(repParams)) }. { translator.Label("godina") }
				</div>
			</div>
			<div class="grid grid-cols-[auto_auto] justify-center gap-x-2 text-[15px] print:text-[13pt] leading-snug">
				<span class="font-bold text-right">{ translator.Label("Broj dokumenta") }:</span>
				<span>{ dok.BrojDokumenta }</span>
				<span class="font-bold text-right">{ translator.Label("Datum dokumenta") }:</span>
				<span>{ dok.DatumDokumenta }</span>
			</div>
			<div></div>
		</div>
		<div class="mt-2 grid grid-cols-2 gap-x-6 items-end">
			<div>
				@robnoStampaPopisPolje(translator.Label("Vrsta/Broj naloga"), dok.Nalog)
			</div>
			<div class="space-y-1">
				@robnoStampaPopisPolje(translator.Label("Vrsta dokumenta"), dok.VrstaDokumenta)
				@robnoStampaPopisPolje(translator.Label("Magacin odakle dolazi roba"), dok.Magacin)
				@robnoStampaPopisPolje(translator.Label("Magacin gde ide roba"), dok.MagacinPrijem)
			</div>
		</div>
	</div>
}

// robnoStampaPrenosnicaColumnWidths are the widths of the columns of the stavke of the prenosnica: rbr,
// konto, šifra, naziv, JM, količina, cena and vrednost.
var robnoStampaPrenosnicaColumnWidths = []string{"5%", "6%", "7%", "44%", "5%", "10%", "10%", "13%"}

//
// Štampa popisa tekuće godine: the report RobnoStampaPopisTekGod (the group PTG of the vrste dokumenta,
// the legacy RPT_POPIS_TEKGOD)
//

// RobnoStampaPopisTekGod renders the printed popisi tekuće godine of the selection, every popis from a
// new page.
templ RobnoStampaPopisTekGod(repParams domain.ReportParameters, popisi []domain.RobnoStampaPopisView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaPopisTekGodDokumenti(repParams, popisi, translator), translator))
}

// robnoStampaPopisTekGodDokumenti returns the printed popisi tekuće godine for RobnoStampaDokumenti.
func robnoStampaPopisTekGodDokumenti(repParams domain.ReportParameters, popisi []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(popisi))
	for _, pop := range popisi {
		out = append(out, RobnoStampaPopisTekGodContent(repParams, pop, translator))
	}
	return out
}

// RobnoStampaPopisTekGodContent renders one popis tekuće godine like the legacy report: the header of the
// document and the header of the stavke are the <thead> of the table (repeated on every printed page);
// the stavke with the otk, the serija and the rok trajanja, UKUPNO and the signatures of the popis.
templ RobnoStampaPopisTekGodContent(repParams domain.ReportParameters, pop domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaPopisTekGodColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaPopisTekGodColumnWidths)) } class="pb-2">
						@RobnoStampaPopisTekGodZaglavlje(repParams, pop, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Konto") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("OTK") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Serija") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Rok") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range pop.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass }>{ st.Konto }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td class={ robnoStampaTdClass }>{ st.Otk }</td>
						<td class={ robnoStampaTdClass }>{ st.Serija }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Rok }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="10" class="border border-gray-500 px-1 py-0.5 text-right uppercase">{ translator.Label("Ukupno") }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ pop.UkupnoIznos }</td>
				</tr>
			</tfoot>
		</table>
		@RobnoStampaPopisPotpisi(translator)
	</div>
}

// RobnoStampaPopisTekGodZaglavlje renders the page header of the popis tekuće godine: the firm on the
