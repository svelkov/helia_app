// RobnoStampaZaduzenjeSIContent renders one zaduženje sitnog inventara like the legacy report: the header
// of the document and the header of the stavke are the <thead> of the table (repeated on every printed
// page); the stavke, UKUPNO of the količina, of the cena and of the vrednost and the signatures of who
// received, approved and handed over the goods.
templ RobnoStampaZaduzenjeSIContent(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	@robnoStampaZaduzenjeContent(dok, RobnoStampaZaduzenjeSIZaglavlje(repParams, dok, translator), translator)
}

// robnoStampaZaduzenjeContent renders one zaduženje (sitnog inventara or gradilišta) with its header
// (zaglavlje): the header of the document and the header of the stavke are the <thead> of the table
// (repeated on every printed page); the stavke, UKUPNO of the količina, of the cena and of the vrednost
// and the signatures of who received, approved and handed over the goods.
templ robnoStampaZaduzenjeContent(dok domain.RobnoStampaPopisView, zaglavlje templ.Component, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaPrenosnicaColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaPrenosnicaColumnWidths)) } class="pb-2">
						@zaglavlje
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Konto") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range dok.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass }>{ st.Konto }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words whitespace-pre-line" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="5" class="border border-gray-500 px-1 py-0.5 text-right uppercase">{ translator.Label("Ukupno") }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoKolicina }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoCena }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoIznos }</td>
				</tr>
			</tfoot>
		</table>
		@robnoStampaPrenosnicaPotpisi(translator)
	</div>
}

// RobnoStampaZaduzenjeSIZaglavlje renders the page header of the zaduženje sitnog inventara: the firm on
// the left and the broj (nalog-vrsta-broj) and the date of the document in the middle; under them the
// nalog, the organizaciona jedinica, the mesto troška and the konto of the radnik on the left, the vrsta
// dokumenta, the magacin, the organizaciona jedinica and the mesto troška the goods go to and the radnik
// on the right.
templ RobnoStampaZaduzenjeSIZaglavlje(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-left font-normal">
		<div class="grid grid-cols-[1fr_2fr_1fr] items-start">
			<div class="text-[10px]">
				<div class="font-bold text-sm print:leading-tight">{ repParams.CompanyName }</div>
				<div class="print:leading-tight">
					{ repParams.Adress }, { repParams.Postcode } { repParams.City } - { fmt.Sprintf("%d", robnoStampaGodina(repParams)) }. { translator.Label("godina") }
				</div>
			</div>
			<div class="grid grid-cols-[auto_auto] justify-center gap-x-2 text-[15px] print:text-[13pt] leading-snug">
				<span class="font-bold text-right">{ translator.Label("Broj dokumenta") }:</span>
				<span>{ dok.BrojDokumenta }</span>
				<span class="font-bold text-right">{ translator.Label("Datum dokumenta") }:</span>
				<span>{ dok.DatumDokumenta }</span>
			</div>
			<div></div>
		</div>
		<div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1">
			@robnoStampaPopisPolje("", "")
			@robnoStampaPopisPolje(translator.Label("Vrsta dokumenta"), dok.VrstaDokumenta)
			@robnoStampaPopisPolje(translator.Label("Vrsta/Broj naloga"), dok.Nalog)
			@robnoStampaPopisPolje(translator.Label("Magacin"), dok.Magacin)
			@robnoStampaPopisPolje(translator.Label("OJ"), dok.Oj)
			@robnoStampaPopisPolje(translator.Label("OJ gde ide roba"), dok.OjPrijem)
			@robnoStampaPopisPolje(translator.Label("Mesto troška"), dok.MestoTroska)
			@robnoStampaPopisPolje(translator.Label("Mesto troška gde ide roba"), dok.MestoTroskaPrijem)
			@robnoStampaPopisPolje(translator.Label("Konto radnika"), dok.KontoRadnika)
			@robnoStampaPopisPolje(translator.Label("Šifra radnika"), dok.SifraRadnika)
		</div>
	</div>
}

