//

// RobnoStampaNivelacija renders the printed nivelacije cena of the selection, every nivelacija from a
// new page.
templ RobnoStampaNivelacija(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaNivelacijaDokumenti(repParams, dokumenti, translator), translator))
}

// robnoStampaNivelacijaDokumenti returns the printed nivelacije cena for RobnoStampaDokumenti.
func robnoStampaNivelacijaDokumenti(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(dokumenti))
	for _, dok := range dokumenti {
		out = append(out, RobnoStampaNivelacijaContent(repParams, dok, translator))
	}
	return out
}

// RobnoStampaNivelacijaContent renders one nivelacija cena like the legacy report: the header of the
// document and the header of the stavke are the <thead> of the table (repeated on every printed page);
// the stavke with the stara and the nova cena and vrednost, the procenat and the vrednost of the
// nivelacija, the totals of the document, the signatures of the računopolagač and of the komisija and,
// on the last document of a nalog of a print of more nalozi, the total of the nalog.
templ RobnoStampaNivelacijaContent(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaNivelacijaColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaNivelacijaColumnWidths)) } class="pb-2">
						@RobnoStampaNivelacijaZaglavlje(repParams, dok, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Šifra artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Stara cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Stara vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Procenat") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Nova cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Nova vrednost") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost nivelacije") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range dok.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Sifra }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass }>{ st.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StaraCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StaraVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Procenat }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Razlika }</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr class="font-bold print:page-break-inside-avoid">
					<td colspan="6" class="px-1 py-0.5 text-right">{ translator.Label("Ukupno") }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoStaraVrednost }</td>
					<td colspan="2"></td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoNovaVrednost }</td>
					<td class="border border-gray-500 px-1 py-0.5 text-right">{ dok.UkupnoRazlika }</td>
				</tr>
			</tfoot>
		</table>
		<div class="mt-8 grid grid-cols-2 gap-16 no-break">
			<div class="flex items-end gap-2">
				<span>{ translator.Label("Računopolagač") }:</span>
				<span class="flex-1 border-b border-black"></span>
			</div>
			<div class="flex items-end gap-2">
				<span>{ translator.Label("Komisija") }:</span>
				<span class="flex-1 border-b border-black"></span>
			</div>
		</div>
		if dok.UkupnoZaNalog != "" {
			<div class="mt-4 flex justify-end gap-6 font-bold no-break">
				<span>{ translator.Label("Ukupno za nalog") }: { dok.NalogNivelacije }</span>
				<span class="border-t border-black min-w-[8rem] text-right">{ dok.UkupnoZaNalog }</span>
			</div>
		}
	</div>
}

// RobnoStampaNivelacijaZaglavlje renders the page header of the nivelacija cena like the legacy report:
// the firm with its adresa and PIB, the nalog (on a print of more nalozi), the title "NIVELACIJA CENA
// BR.:" with the broj of the document, the datum of the nivelacija and the napomena.
templ RobnoStampaNivelacijaZaglavlje(repParams domain.ReportParameters, dok domain.RobnoStampaPopisView, translator *i18n.Service) {
	<div class="text-left font-normal">
		<div class="text-[10px] leading-snug">
			<div class="font-bold text-sm">{ repParams.CompanyName }</div>
			<div>{ repParams.Adress } , { repParams.Postcode } { repParams.City }</div>
			<div>{ translator.Label("PIB") } { repParams.PIB }</div>
		</div>
		if dok.NalogNivelacije != "" {
			<div class="mt-2 font-bold">{ translator.Label("Nalog") }: { dok.NalogNivelacije }</div>
		}
		<div class="mt-2 text-center text-[16px] print:text-[13pt] font-bold uppercase">
			{ translator.Label("Nivelacija cena br.") }: { dok.BrojDokumenta }
		</div>
		<div class="mt-1 flex gap-10">
			<span>{ translator.Label("Datum nivelacije") }: <span class="font-bold">{ dok.DatumDokumenta }</span></span>
			<span>{ translator.Label("Napomena") }: <span class="font-bold">{ dok.Napomena }</span></span>
		</div>
	</div>
}

// robnoStampaNivelacijaColumnWidths are the widths of the columns of the stavke of the nivelacija cena:
// rbr, šifra, naziv, JM, količina, stara cena, stara vrednost, procenat, nova cena, nova vrednost and
// vrednost of the nivelacija.
var robnoStampaNivelacijaColumnWidths = []string{"4%", "6%", "24%", "4%", "8%", "8%", "10%", "7%", "8%", "10%", "11%"}

//
// Štampa fakture usluga: the report RobnoStampaFakturaUsluge (the groups PRE and FUR of the vrste
// dokumenta, the legacy ROB_RPT_STAMPA_FAKTURA_USLUGE2)
//

// RobnoStampaFakturaUsluge renders the printed fakture usluga of the selection, every faktura from a
// new page: the header (the firm with the title and the dates of the document, the kupac with the data
// of the sale), the stavke without the šifra and with the cena and the iznos bez PDV, the totals, the
// poreska napomena, the rate, the ambalaža and the end of the faktura.
templ RobnoStampaFakturaUsluge(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaUslugeDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaFakturaUslugeDokumenti returns the printed fakture usluga for RobnoStampaDokumenti.
func robnoStampaFakturaUslugeDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaUslugeContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaFakturaUslugeContent renders one faktura usluga. The header of the document and the
// header of the stavke are the <thead> of the table of the stavke, so the browser repeats them on every
// printed page like the page header of the legacy report.
templ RobnoStampaFakturaUslugeContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaUslugeColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaUslugeColumnWidths)) } class="pb-2">
						@RobnoStampaFakturaUslugeZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Naziv") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("J.M.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena bez PDV") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Vrednost rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("% PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos PDV-a") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos bez PDV") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Jm }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Rabat }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Pdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaAvansi(fak, translator)
		@RobnoStampaFakturaRekapitulacija(fak, translator)
		@RobnoStampaFakturaAmbalaza(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		@RobnoStampaFakturaRate(fak, translator)
		@robnoStampaFakturaKraj(fak, "faktura_nadlezan_sud_usluge", translator)
	</div>
}

// RobnoStampaFakturaUslugeZaglavlje renders the page header of the faktura usluga like the legacy
// report: on the left the logo, the firm (with the adresa of the magacin) and its data, the title
// ("Račun: vrd-broj") and the dates of the document; on the right the kupac (in a box marked by its
// corners) with the mesto isporuke and the data of the sale.
templ RobnoStampaFakturaUslugeZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the firm, the title and the dates of the document. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				<div>{ fak.FirmaEmail }</div>
				<div>{ fak.FirmaBpg }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 text-center font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<!-- "Račun: 170-62" -->
			<div class="mt-4 text-center">
				<span class="font-bold italic text-[16px] print:text-[13pt]">{ fak.Naslov }:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum prometa dobara"), fak.DatumPrometa)
				@robnoStampaFakturaDesnoPolje(robnoStampaFakturaNaslov(fak.ValutaNaslov, translator.Label("Valuta")), fak.Valuta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja računa"), fak.MestoIzdavanja)
			</div>
		</div>
		<!-- Right: the kupac and the data of the sale. -->
		<div>
			<!-- The kupac: a box marked only by its four corners, like the legacy report. -->
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="flex justify-between gap-2">
					<span>{ fak.KupacMesto }</span>
					<span class="whitespace-nowrap mr-4">{ translator.Label("PAK") }<span class="ml-6">{ fak.KupacPak }</span></span>
				</div>
				<div class="text-center">{ translator.Label("PIB") } : { fak.KupacPib }</div>
				<div class="flex justify-between gap-6">
					<span>{ translator.Label("Matični broj") } : { fak.KupacMbr }</span>
					<span>{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</span>
				</div>
			</div>
			if fak.MestoIsporuke != "" {
				<div class="mt-1 text-center leading-snug">
					<div>{ fak.MestoIsporuke }</div>
					<div>{ fak.MestoIsporuke2 }</div>
				</div>
			}
			<!-- The data of the sale. -->
			<div class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				@robnoStampaFakturaPolje(translator.Label("Na osnovu otpremnice"), fak.Otpremnica)
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
				@robnoStampaFakturaPolje(translator.Label("Vozač"), fak.Vozac)
				@robnoStampaFakturaPolje(translator.Label("Broj vozila"), fak.RegBrojVozila)
			</div>
		</div>
	</div>
}

// robnoStampaFakturaUslugeColumnWidths are the widths of the columns of the stavke of the faktura
// usluga: Red. br., naziv, JM, količina, cena bez PDV, % rabata, vrednost rabata, % PDV-a, iznos PDV-a
// and iznos bez PDV.
var robnoStampaFakturaUslugeColumnWidths = []string{"5%", "34%", "5%", "8%", "10%", "6%", "8%", "5%", "8%", "11%"}

//
// Štampa avansnog računa: the report RobnoStampaFakturaAvansni (the groups ARA and ARU of the vrste
// dokumenta, the legacy ROB_RPT_STAMPA_ARA)
//

// RobnoStampaFakturaAvansni renders the printed avansni računi of the selection, every račun from a new
// page: the header (the kupac with the data of the sale on the left, the firm with the title and the
// dates of the document on the right), the stavke, the totals, the poreska napomena and the end of the
// račun.
templ RobnoStampaFakturaAvansni(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaFakturaAvansniDokumenti(repParams, fakture, translator), translator))
}

// robnoStampaFakturaAvansniDokumenti returns the printed avansni računi for RobnoStampaDokumenti.
func robnoStampaFakturaAvansniDokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaFakturaAvansniContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaFakturaAvansniContent renders one avansni račun. The header of the document and the header
// of the stavke are the <thead> of the table of the stavke, so the browser repeats them on every
// printed page like the page header of the legacy report.
templ RobnoStampaFakturaAvansniContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaFakturaAvansniColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaFakturaAvansniColumnWidths)) } class="pb-2">
						@RobnoStampaFakturaAvansniZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Redni broj") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Opis ili naziv robe ili usluge") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("%Rabata") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Por. stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos") }</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ s.Rbr }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ s.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Cena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.ProcRabata }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ s.ProcPdv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ s.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaAvansniRekapitulacija(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		<div class="mt-3 no-break">{ translator.Text("faktura_bez_pecata") }</div>
		@RobnoStampaFakturaAvansniPotpisi(translator)
	</div>
}

// RobnoStampaFakturaAvansniZaglavlje renders the page header of the avansni račun like the legacy
// report: on the left the logo, the kupac (in a box marked by its corners), the uslovi plaćanja, the
// komercijalista and the vezni dokument; on the right the firm with its data, the title ("AVANSNI
// RAČUN Br.: 172-8"), the datum of the avansna uplata and of the document, the nalog and the mesto
// izdavanja računa.
templ RobnoStampaFakturaAvansniZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-6 items-start text-left font-normal">
		<!-- Left: logo, the kupac and the data of the sale. -->
		<div>
			if repParams.CompanyLogo != "" {
				<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
			}
			<!-- The kupac: a box marked only by its four corners, like the legacy report. -->
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5 text-center">{ fak.KupacNaziv }</div>
				<div class="text-center">{ fak.KupacAdresa }</div>
				<div class="text-center">{ fak.KupacMesto }</div>
				<div class="text-center">{ translator.Label("PIB") } : { fak.KupacPib }</div>
				<div class="text-center">{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</div>
			</div>
			<div class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 leading-snug">
				@robnoStampaFakturaPolje(translator.Label("Uslovi plaćanja"), fak.UsloviPlacanja)
				@robnoStampaFakturaPolje(translator.Label("Komercijalista"), strings.TrimSpace(fak.Komercijalista+" "+fak.KomercijalistaOpis))
				<span>{ translator.Label("Vezni dokument") } :</span>
				<div>
					<div class="font-bold">{ fak.VezniDokument }</div>
					<div>{ fak.VezniDokumentOpis }</div>
				</div>
			</div>
		</div>
		<!-- Right: the firm, the title and the dates of the document. -->
		<div>
			<div class="text-center leading-snug">
				<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
				<div>{ fak.FirmaAdresa }</div>
			</div>
			<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
				<div>{ fak.FirmaObveznik }</div>
				<div>{ fak.FirmaApr }</div>
				<div>{ fak.FirmaPib }</div>
				<div>{ fak.FirmaMbr }</div>
				<div>{ fak.FirmaSifdel }</div>
				<div>{ fak.FirmaTel }</div>
				if fak.FirmaZiro != "" {
					<div class="col-span-2 mt-1 text-center font-bold">{ fak.FirmaZiro }</div>
				}
			</div>
			<!-- "AVANSNI RAČUN Br.: 172-8" -->
			<div class="mt-5 text-center">
				<span class="font-bold italic uppercase text-[16px] print:text-[13pt]">{ fak.Naslov }:</span>
				<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
			</div>
			<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum avansne uplate"), fak.DatumAvansneUplate)
				@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja računa"), fak.MestoIzdavanja)
			</div>
		</div>
	</div>
}

// RobnoStampaFakturaAvansniRekapitulacija renders the totals of the avansni račun in a framed box on the
// right like the legacy report: SVEGA, RABAT, OSNOVICA, for every poreska stopa its OSNOVICA and "PDV
// po stopi od x%" and ZA NAPLATU.
templ RobnoStampaFakturaAvansniRekapitulacija(fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="mt-1 flex justify-end no-break">
		<table class="w-[45%] border-collapse">
			<colgroup>
				<col style="width: 62%"/>
				<col style="width: 38%"/>
			</colgroup>
			<tbody>
				@robnoStampaFakturaAvansniZbir(translator.Label("Svega"), fak.Svega)
				@robnoStampaFakturaAvansniZbir(translator.Label("Rabat"), fak.Rabat)
				for _, p := range fak.PdvPoStopama {
					@robnoStampaFakturaAvansniZbir(translator.Label("Osnovica"), p.Osnovica)
					@robnoStampaFakturaAvansniZbir(translator.Label("PDV po stopi od")+" "+p.Stopa, p.Pdv)
				}
				@robnoStampaFakturaAvansniZbir(translator.Label("Za naplatu"), fak.ZaNaplatu)
			</tbody>
		</table>
	</div>
}

// robnoStampaFakturaAvansniZbir renders one row of the totals of the avansni račun: the label aligned
// to the right and the amount in a framed cell.
templ robnoStampaFakturaAvansniZbir(label, value string) {
	<tr class="font-bold">
		<td class="px-1 py-0.5 text-right uppercase whitespace-nowrap">{ label } :</td>
		<td class="border border-black px-1 py-0.5 text-right text-[12px] print:text-[10pt]">{ value }</td>
	</tr>
}

// RobnoStampaFakturaAvansniPotpisi renders the signatures of the avansni račun (Fakturisao, M.P. and
// Direktor) and the note on the nadležan sud.
templ RobnoStampaFakturaAvansniPotpisi(translator *i18n.Service) {
	<div class="mt-6 no-break">
		<div class="grid grid-cols-3 gap-12 text-center text-[13px] print:text-[11pt]">
			<div>
				<div>{ translator.Label("Fakturisao") }</div>
				<div class="mt-8 border-b border-black mx-4"></div>
			</div>
			<div>
				<div>{ translator.Label("M.P.") }</div>
			</div>
			<div>
				<div>{ translator.Label("Direktor") }</div>
				<div class="mt-8 border-b border-black mx-4"></div>
			</div>
		</div>
		<div class="mt-4">{ translator.Text("faktura_nadlezan_sud") }</div>
	</div>
}

// robnoStampaFakturaAvansniColumnWidths are the widths of the columns of the stavke of the avansni
// račun: redni broj, opis, količina, cena, % rabata, poreska stopa and iznos.
var robnoStampaFakturaAvansniColumnWidths = []string{"6%", "41%", "10%", "14%", "7%", "8%", "14%"}

//
// Štampa nivelacije maloprodaje: the report RobnoStampaNivelacijaMaloprodaje (the group MNI of the vrste
// dokumenta, the legacy RPT_NIVELACIJA_MALOPRODAJE)
//

// RobnoStampaNivelacijaMaloprodaje renders the printed nivelacije maloprodaje of the selection, every
// document from a new page.
templ RobnoStampaNivelacijaMaloprodaje(repParams domain.ReportParameters, nivelacije []domain.RobnoStampaNivelacijaMPView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaNivelacijaMPDokumenti(nivelacije, translator), translator))
}

// robnoStampaNivelacijaMPDokumenti returns the printed nivelacije for RobnoStampaDokumenti.
func robnoStampaNivelacijaMPDokumenti(nivelacije []domain.RobnoStampaNivelacijaMPView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(nivelacije))
	for _, n := range nivelacije {
		out = append(out, RobnoStampaNivelacijaMPContent(n, translator))
	}
	return out
}

// RobnoStampaNivelacijaMPContent renders one nivelacija maloprodaje like the legacy report: the header
// and the header of the stavke (two lines: the cena per unit, the vrednost) are the <thead> of the table;
// the stavke on two lines, the total of the document, the porezi per nova poreska oznaka and the
// signatures.
templ RobnoStampaNivelacijaMPContent(n domain.RobnoStampaNivelacijaMPView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaNivelacijaMPColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaNivelacijaMPColumnWidths)) } class="pb-2">
						@RobnoStampaNivelacijaMPZaglavlje(n, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Red. Br.") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Naziv artikla") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Količina") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Stara MP cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Nova MP cena") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Razlika") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("St. SP") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Stara stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Stari porez") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("No. SP") }</th>
					<th rowspan="2" class={ robnoStampaThClass }>{ translator.Label("Nova stopa") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Novi porez") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Razlika poreza") }</th>
					<th class={ robnoStampaThClass }>RUC</th>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					for range 7 {
						<th class={ robnoStampaThClass }>{ translator.Label("Vrednost") }</th>
					}
				</tr>
			</thead>
			for _, st := range n.Stavke {
				<tbody class="print:page-break-inside-avoid" style="break-inside: avoid;">
					<tr>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Rbr }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-right" }>{ st.Kolicina }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StaraCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NovaCena }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Razlika }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-center" }>{ st.StaraOznaka }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-center" }>{ st.StaraStopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StariPorez }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-center" }>{ st.NovaOznaka }</td>
						<td rowspan="2" class={ robnoStampaTdClass + " text-center" }>{ st.NovaStopa }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NoviPorez }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.RazlikaPoreza }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Ruc }</td>
					</tr>
					<tr>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StaraVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NovaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.RazlikaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.StariPorezVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.NoviPorezVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.RazlikaPorezaVrednost }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.RucVrednost }</td>
					</tr>
				</tbody>
			}
			<tfoot>
				<tr class="font-bold bg-gray-200 print:bg-gray-200 print:page-break-inside-avoid">
					<td colspan="3" class="px-1 py-0.5">{ translator.Label("Ukupno za dokument") }: { n.BrojDokumenta }</td>
					@robnoStampaKalkulacijaUkupno(n.Ukupno.StaraVrednost)
					@robnoStampaKalkulacijaUkupno(n.Ukupno.NovaVrednost)
					@robnoStampaKalkulacijaUkupno(n.Ukupno.RazlikaVrednost)
					<td colspan="2"></td>
					@robnoStampaKalkulacijaUkupno(n.Ukupno.StariPorezVrednost)
					<td colspan="2"></td>
					@robnoStampaKalkulacijaUkupno(n.Ukupno.NoviPorezVrednost)
					@robnoStampaKalkulacijaUkupno(n.Ukupno.RazlikaPorezaVrednost)
					@robnoStampaKalkulacijaUkupno(n.Ukupno.RucVrednost)
				</tr>
			</tfoot>
		</table>
		if len(n.Porezi) > 0 {
			<div class="mt-4 flex justify-center no-break">
				<table class="border-collapse text-[11px] print:text-[9pt]" style="width: 75%; table-layout: fixed;">
					<thead>
						<tr class="font-bold">
							for _, caption := range []string{"SP", "Tarifa", "Stara osnovica", "Nova osnovica", "Stopa", "Stari porez", "Novi porez", "Razlika poreza"} {
								<th class="px-1 py-0.5 text-center">{ translator.Label(caption) }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, pz := range n.Porezi {
							<tr>
								<td class="px-1 py-0.5 text-center">{ pz.Sp }</td>
								<td class="px-1 py-0.5 text-center">{ pz.Tarifa }</td>
								<td class="px-1 py-0.5 text-right">{ pz.StaraOsnovica }</td>
								<td class="px-1 py-0.5 text-right">{ pz.NovaOsnovica }</td>
								<td class="px-1 py-0.5 text-right">{ pz.Stopa }</td>
								<td class="px-1 py-0.5 text-right">{ pz.StariPorez }</td>
								<td class="px-1 py-0.5 text-right">{ pz.NoviPorez }</td>
								<td class="px-1 py-0.5 text-right">{ pz.RazlikaPoreza }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="mt-12 grid grid-cols-3 gap-12 px-8 text-[12px] print:text-[10pt] no-break">
			for _, potpis := range []string{"Sastavio", "Kontrolisao", "Odobrio"} {
				<div class="flex items-end gap-2">
					<span>{ translator.Label(potpis) }:</span>
					<span class="flex-1 border-b border-black"></span>
				</div>
			}
		</div>
	</div>
}

// RobnoStampaNivelacijaMPZaglavlje renders the page header of the nivelacija maloprodaje like the legacy
// report: the izdavalac on the left, "NIVELACIJA BR.: vrsta-broj" with the prodavnica in the middle, the
// datum nivelacije and the date and time of the print on the right.
templ RobnoStampaNivelacijaMPZaglavlje(n domain.RobnoStampaNivelacijaMPView, translator *i18n.Service) {
	<div class="grid grid-cols-[1fr_1.4fr_1fr] gap-4 items-start text-left font-normal">
		<div class="text-[10px] leading-snug">
			<div class="font-bold text-sm">{ n.FirmaNaziv }</div>
			<div>{ n.FirmaAdresa }</div>
			<div class="flex gap-6">
				<span>{ n.FirmaPib }</span>
				<span>{ n.FirmaMbr }</span>
			</div>
			<div>{ n.FirmaRegbr }</div>
		</div>
		<div class="text-center leading-snug">
			<div class="font-bold text-[14px] print:text-[12pt] uppercase">{ translator.Label("Nivelacija br.") }: { n.BrojDokumenta }</div>
			if n.Prodavnica != "" {
				<div class="mt-2">
					<span class="font-bold">{ n.Prodavnica }</span>
					<span class="ml-2">{ n.ProdavnicaNaziv }</span>
				</div>
			}
		</div>
		<div class="text-right leading-snug">
			<div class="text-[10px]">{ n.DatumStampe }</div>
			<div class="mt-1">{ translator.Label("Datum nivelacije") }: <span class="font-bold">{ n.DatumNivelacije }</span></div>
		</div>
	</div>
}

// robnoStampaNivelacijaMPColumnWidths are the widths of the columns of the stavke of the nivelacija
// maloprodaje: rbr, naziv, količina, stara and nova MP cena, razlika, stara poreska oznaka and stopa,
// stari porez, nova poreska oznaka and stopa, novi porez, razlika poreza and RUC.
var robnoStampaNivelacijaMPColumnWidths = []string{"3%", "18%", "6%", "7.5%", "7.5%", "7%", "3%", "7%", "7.5%", "3%", "7%", "7.5%", "7.5%", "8.5%"}

//
// Štampa zaduženja za obaveze: the report RobnoStampaZaduzenjeCO (the group FCO of the vrste dokumenta,
// the legacy ROB_RPT_STAMPA_ZADUZENJA_CO)
//

// RobnoStampaZaduzenjeCO renders the printed zaduženja za obaveze or (the view marked Razduzenje, the
// legacy ROB_RPT_STAMPA_RAZDUZENJA_CO) razduženja za obaveze of the selection, every document from a new
// page.
templ RobnoStampaZaduzenjeCO(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) {
	@rep.Report(repParams, domain.TableData{}, translator, nil, nil, RobnoStampaDokumenti(robnoStampaZaduzenjeCODokumenti(repParams, fakture, translator), translator))
}

// robnoStampaZaduzenjeCODokumenti returns the printed zaduženja for RobnoStampaDokumenti.
func robnoStampaZaduzenjeCODokumenti(repParams domain.ReportParameters, fakture []domain.RobnoStampaFakturaView, translator *i18n.Service) []templ.Component {
	dokumenti := make([]templ.Component, 0, len(fakture))
	for _, fak := range fakture {
		dokumenti = append(dokumenti, RobnoStampaZaduzenjeCOContent(repParams, fak, translator))
	}
	return dokumenti
}

// RobnoStampaZaduzenjeCOContent renders one zaduženje za obaveze like the legacy report: the header and
// the header of the stavke are the <thead> of the table (repeated on every printed page); the stavke
// (konto, analitička šifra, naziv and iznos), the avansi, the totals (the PDV per stopa, SVEGA, RABAT, ZA
// NAPLATU, za naplatu po danima, the avansni PDV), the ambalaža, the poreska napomena, the rate and the
// end of the document (the napomena, Dokument izdao and the važne napomene on the payment).
templ RobnoStampaZaduzenjeCOContent(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-[11px] print:text-[9pt] text-black">
		<table class="w-full border-collapse" style="table-layout: fixed;">
			<colgroup>
				for _, width := range robnoStampaZaduzenjeCOColumnWidths {
					<col style={ "width: " + width }/>
				}
			</colgroup>
			<thead>
				<tr>
					<td colspan={ fmt.Sprintf("%d", len(robnoStampaZaduzenjeCOColumnWidths)) } class="pb-2">
						@RobnoStampaZaduzenjeCOZaglavlje(repParams, fak, translator)
					</td>
				</tr>
				<tr class="bg-gray-200 print:bg-gray-200">
					<th class={ robnoStampaThClass }>{ translator.Label("Red. br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Konto br.") }</th>
					<th class={ robnoStampaThClass }>{ translator.Label("Anal. br.") }</th>
					if fak.Razduzenje {
						<th class={ robnoStampaThClass }>{ translator.Label("Naziv/oznaka razduženja") }</th>
					} else {
						<th class={ robnoStampaThClass }>{ translator.Label("Naziv/oznaka zaduženja") }</th>
					}
					<th class={ robnoStampaThClass }>{ translator.Label("Iznos dinara") }</th>
				</tr>
			</thead>
			<tbody>
				for _, st := range fak.Stavke {
					<tr class="print:page-break-inside-avoid">
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Rbr }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Konto }</td>
						<td class={ robnoStampaTdClass + " text-center" }>{ st.Analitika }</td>
						<td class={ robnoStampaTdClass + " break-words" }>{ st.Naziv }</td>
						<td class={ robnoStampaTdClass + " text-right" }>{ st.Iznos }</td>
					</tr>
				}
			</tbody>
		</table>
		@RobnoStampaFakturaAvansi(fak, translator)
		@RobnoStampaFakturaRekapitulacija(fak, translator)
		@RobnoStampaFakturaAmbalaza(fak, translator)
		@RobnoStampaFakturaNapomene(fak, translator)
		@RobnoStampaFakturaRate(fak, translator)
		<div class="mt-4 no-break">
			if fak.Razduzenje {
				<div class="font-bold">{ translator.Label("Stanje na računu za prihode i rashode od imovine nakon razduženja") }:</div>
				<div class="mt-1 grid grid-cols-[auto_auto] justify-start gap-x-4 leading-snug">
					<span>{ translator.Label("Zaduženje") }:</span>
					<span class="text-right">{ fak.StanjeFakture }</span>
					<span>{ translator.Label("Uplate") }:</span>
					<span class="text-right">{ fak.StanjeUplate }</span>
					<span class="font-bold">{ translator.Label("Saldo") }:</span>
					<span class="text-right font-bold">{ fak.StanjeSaldo }</span>
				</div>
			}
			<div class="grid grid-cols-3 gap-4 items-end">
				<div class="col-span-2 min-h-[3rem] whitespace-pre-line">{ fak.Napomena }</div>
				<div class="text-center text-[13px] print:text-[11pt]">
					<div>{ translator.Label("Dokument izdao") }</div>
					<div class="mt-8 border-b border-black mx-4"></div>
				</div>
			</div>
			<div class="mt-6 border-t border-dashed border-gray-500 pt-2 leading-snug">
				<div class="font-bold">{ translator.Label("Važne napomene") }:</div>
				<ol class="list-decimal ml-5">
					if fak.Razduzenje {
						<li>{ translator.Text("razduzenje_co_napomena_1") }</li>
					} else {
						<li>{ translator.Text("zaduzenje_co_napomena_1") }</li>
						<li>{ translator.Text("zaduzenje_co_napomena_2") }</li>
						<li>{ translator.Text("zaduzenje_co_napomena_3") }</li>
					}
				</ol>
			</div>
		</div>
	</div>
}

// RobnoStampaZaduzenjeCOZaglavlje renders the page header of the zaduženje za obaveze like the legacy
// report: on the left the logo and the firm (with the adresa of the magacin) with its data and the
// tekući račun; on the right the kupac (in a box marked by its corners) with the mesto isporuke; under
// them the title with the broj, the dates, the rok and the uslovi plaćanja, the mesto izdavanja and the
// nalog.
templ RobnoStampaZaduzenjeCOZaglavlje(repParams domain.ReportParameters, fak domain.RobnoStampaFakturaView, translator *i18n.Service) {
	<div class="text-left font-normal">
		<div class="grid grid-cols-2 gap-6 items-start">
			<div>
				if repParams.CompanyLogo != "" {
					<img src={ repParams.CompanyLogo } alt="" class="h-16 mb-2 mx-auto object-contain"/>
				}
				<div class="leading-snug">
					<div class="font-bold text-[13px] print:text-[11pt]">{ repParams.CompanyName }</div>
					<div>{ fak.FirmaAdresa }</div>
				</div>
				<div class="mt-1 text-[10px] print:text-[8pt] grid grid-cols-2 gap-x-4 leading-snug">
					<div>{ fak.FirmaObveznik }</div>
					<div>{ fak.FirmaEmail }</div>
					<div>{ fak.FirmaPib }</div>
					<div>{ fak.FirmaMbr }</div>
					<div>{ fak.FirmaSifdel }</div>
					<div>{ fak.FirmaTel }</div>
				</div>
				<div class="mt-1">{ fak.FirmaZiro }</div>
			</div>
			<div class="relative px-3 py-2 leading-snug">
				<span class="absolute top-0 left-0 w-4 h-4 border-t border-l border-black"></span>
				<span class="absolute top-0 right-0 w-4 h-4 border-t border-r border-black"></span>
				<span class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-black"></span>
				<span class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-black"></span>
				<div>
					<span class="font-bold italic uppercase">{ translator.Label("Kupac") }:</span>
					<span class="ml-1">{ strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra) }</span>
				</div>
				<div class="font-bold text-[14px] print:text-[12pt] mt-0.5">{ fak.KupacNaziv }</div>
				<div>{ fak.KupacAdresa }</div>
				<div class="flex justify-between gap-2">
					<span>{ fak.KupacMesto }</span>
					<span class="whitespace-nowrap mr-4">{ translator.Label("PAK") }<span class="ml-6">{ fak.KupacPak }</span></span>
				</div>
				if fak.KupacPib != "" {
					<div>{ translator.Label("PIB") } : { fak.KupacPib }</div>
				}
				if fak.KupacTelefon != "" {
					<div>{ translator.Label("Tel/fax") } : { fak.KupacTelefon }</div>
				}
				if fak.MestoIsporuke != "" {
					<div class="mt-1">
						<div>{ fak.MestoIsporuke }</div>
						<div>{ fak.MestoIsporuke2 }</div>
					</div>
				}
			</div>
		</div>
		<div class="mt-6 grid grid-cols-2 gap-6 items-start">
			<div>
				<div class="ml-16">
					<span class="font-bold italic uppercase text-[16px] print:text-[13pt]">{ fak.Naslov } :</span>
					<span class="font-bold text-[16px] print:text-[13pt] ml-1">{ fak.BrojDokumenta }</span>
				</div>
				<div class="mt-2 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
					@robnoStampaFakturaDesnoPolje(translator.Label("Datum dokumenta"), fak.DatumDokumenta)
					if !fak.Razduzenje {
						@robnoStampaFakturaDesnoPolje(translator.Label("Rok plaćanja"), strings.TrimSpace(fak.RokPlacanja+" "+translator.Label("dana")))
						@robnoStampaFakturaDesnoPolje(translator.Label("Valuta"), fak.Valuta)
						@robnoStampaFakturaDesnoPolje(translator.Label("Uslovi plaćanja"), translator.Text("zaduzenje_co_uslovi_placanja"))
					}
				</div>
				if fak.Razduzenje {
					<div class="mt-1 grid grid-cols-[auto_1fr] gap-x-2 leading-snug text-[12px] print:text-[10pt] font-bold">
						<span class="font-normal text-right">{ translator.Label("Način razduženja") } :</span>
						<span>{ translator.TextWithParams("razduzenje_co_nacin_partija", map[string]string{"konto": strings.TrimSpace(fak.KupacKonto + " " + fak.KupacSifra)}) }</span>
						<span class="font-normal text-right">{ translator.Label("ili") }</span>
						<span>{ translator.Text("razduzenje_co_nacin_racun") }</span>
						<span class="font-normal text-right">{ translator.Label("ili") }</span>
						<span>{ translator.Text("razduzenje_co_nacin_blagajna") }</span>
					</div>
				}
			</div>
			<div class="mt-8 grid grid-cols-[1fr_auto] gap-x-1 leading-snug text-[12px] print:text-[10pt]">
				@robnoStampaFakturaDesnoPolje(translator.Label("Mesto izdavanja"), fak.MestoIzdavanja)
				@robnoStampaFakturaDesnoPolje(translator.Label("Nalog"), fak.Nalog)
			</div>
		</div>
	</div>
}

// robnoStampaZaduzenjeCOColumnWidths are the widths of the columns of the stavke of the zaduženje za
// obaveze: Red. br., konto, analitička šifra, naziv and iznos.
var robnoStampaZaduzenjeCOColumnWidths = []string{"6%", "10%", "11%", "56%", "17%"}
