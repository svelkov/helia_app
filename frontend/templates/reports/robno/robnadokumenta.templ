// robnoStampaZaduzenjeSIDokumenti returns the printed zaduženja sitnog inventara for RobnoStampaDokumenti.
func robnoStampaZaduzenjeSIDokumenti(repParams domain.ReportParameters, dokumenti []domain.RobnoStampaPopisView, translator *i18n.Service) []templ.Component {
	out := make([]templ.Component, 0, len(dokumenti))
