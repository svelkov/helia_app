				<span class="font-semibold ml-6">{ translator.Label("Do grupe") }:</span>
				<span class="font-bold">{ params.DoGrupe }</span>
			</div>
		</div>
		<div class="flex items-center justify-between gap-2 mb-1">
			<div class="flex items-center gap-2">
				<span class="font-semibold">{ translator.Label("Konto") }:</span>
				if konto, ok := paramItems["Konto"]; ok {
					<span class="font-bold">{ konto.Value }</span>
				}
				<span class="font-semibold ml-6">{ translator.Label("Od artikla") }:</span>
				<span class="font-bold">{ params.OdArtikla }</span>
				<span class="font-semibold ml-2">{ translator.Label("Do artikla") }:</span>
				<span class="font-bold">{ params.DoArtikla }</span>
			</div>
		</div>
		<div class="flex items-center justify-between gap-2">
			<div class="flex items-center gap-2">
				<span class="font-semibold">{ translator.Label("Od datuma") }:</span>
				<span class="font-bold">{ robnoKompodaciStampaFormatDate(params.OdDatuma) }</span>
				<span class="font-semibold ml-6">{ translator.Label("Do datuma") }:</span>
				<span class="font-bold">{ robnoKompodaciStampaFormatDate(params.DoDatuma) }</span>
			</div>
		</div>
