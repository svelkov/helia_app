}

// StanjaSubsintetickogKontaStampa renders the printable "Saldo subsintetičkog konta" report: the
// summary (početno stanje / tekući promet / ukupan promet), the monthly saldo table and the bar
// chart - the same layout as the "Salda pojedinačnih konta" report.
templ StanjaSubsintetickogKontaStampa(tbl domain.TableData, total domain.RobnoStanjaTotal, repParams domain.ReportParameters, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, nil, nil, StanjaSubsintetickogKontaReport(tbl, total, repParams, translator))
}

templ StanjaSubsintetickogKontaReport(tbl domain.TableData, total domain.RobnoStanjaTotal, repParams domain.ReportParameters, translator *i18n.Service) {
	@rep.ReportPageHeader(repParams, StanjaSubsintetickogKontaParam(repParams, translator), translator)
	@StanjaSubsintetickogKontaReportBody(tbl, translator)
	@StanjaSubsintetickogKontaReportChart()
	@rep.ReportEnd(nil)
}

templ StanjaSubsintetickogKontaParam(repParams domain.ReportParameters, translator *i18n.Service) {
	<!-- Parameters (magacin, konto) -->
	<div class="text-center text-[11px] font-semibold mb-3 print:text-[9pt] print:mb-1">
		{ translator.Label("Magacin") }: <span class="font-bold">{ repParams.ParameterItems["Magacin"].Value }</span>
		&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{ translator.Label("Konto") }: <span class="font-bold">{ repParams.ParameterItems["Konto"].Value }</span>
	</div>
}

// StanjaSubsintetickogKontaReportSummary renders the opening balance, the turnover of the current
// period and the total turnover of the account.
templ StanjaSubsintetickogKontaReportSummary(total domain.RobnoStanjaTotal, translator *i18n.Service) {
	<div class="mb-4">
		<table class="w-full border-collapse report-table mt-4 print:w-full print:text-[11pt] print:table-auto print:border-collapse">
			<colgroup>
				<col style="width:72px"/>
				<col style="width:100px"/>
				<col style="width:100px"/>
				<col style="width:100px"/>
			</colgroup>
			<thead>
				<tr class="bg-blue-900 text-white print:bg-gray-200 print:text-black print:page-break-inside-auto">
					<th class="border border-gray-300 px-1"></th>
					<th class="border border-gray-300 px-1 text-sm text-center">{ translator.Label("Duguje") }</th>
					<th class="border border-gray-300 px-1 text-sm text-center">{ translator.Label("Potražuje") }</th>
					<th class="border border-gray-300 px-1 text-sm text-center">{ translator.Label("Saldo") }</th>
				</tr>
			</thead>
			<tbody>
				<tr class="bg-gray-50 print:bg-gray-50 print:page-break-inside-avoid">
					<td class="border border-gray-300 px-1 text-sm">{ translator.Label("Početno stanje") }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.PocStanjeDug, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.PocStanjePot, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.PocStanjeSaldo, 2) }</td>
				</tr>
				<tr class="bg-white print:bg-white print:page-break-inside-avoid">
					<td class="border border-gray-300 px-1 text-sm">{ translator.Label("Tekući promet") }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.TekuciPromDug, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.TekuciPromPot, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.TekuciPromSaldo, 2) }</td>
				</tr>
				<tr class="bg-gray-50 print:bg-gray-50 print:page-break-inside-avoid">
					<td class="border border-gray-300 px-1 text-sm">{ translator.Label("Ukupan promet") }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.UkPromDug, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.UkPromPot, 2) }</td>
					<td class="border border-gray-300 px-1 text-sm text-right">{ common.FormatNumberWithSystemLocale(total.UkPromSaldo, 2) }</td>
				</tr>
			</tbody>
		</table>
	</div>
}

// StanjaSubsintetickogKontaReportBody renders the monthly table (početno stanje + duguje/potražuje,
// saldo u mesecu and saldo na kraju meseca for every month).
templ StanjaSubsintetickogKontaReportBody(tbl domain.TableData, translator *i18n.Service) {
	@rep.ReportTable(tbl, translator)
}

// StanjaSubsintetickogKontaReportChart renders the bar chart of the monthly duguje / potražuje /
// saldo. The chart is built on the client from the monthly table (the table that has 5 columns),
// exactly like in the "Salda pojedinačnih konta" report.
templ StanjaSubsintetickogKontaReportChart() {
	<div class="mt-6 no-break" id="subsintetickokonta-report-chart-wrap">
		<div class="text-[11px] font-bold mb-2">Grafički prikaz salda</div>
		<canvas id="subsintetickokonta-report-chart" style="width:100%;height:260px;max-height:260px;"></canvas>
	</div>
	<script>
		(function() {
			function buildSubsintetickoKontaReportChart() {
				var canvas = document.getElementById('subsintetickokonta-report-chart');
				if (!canvas || typeof Chart === 'undefined') return;

				// Read data from the monthly table (the first table on page that has 5 columns)
				var months = [], duguje = [], potrazuje = [], saldo = [];
				var tables = document.querySelectorAll('table');
				var dataTable = null;
				for (var i = 0; i < tables.length; i++) {
					var th = tables[i].querySelectorAll('thead th');
					if (th.length === 5) { dataTable = tables[i]; break; }
				}
				if (!dataTable) return;

				// Parses a number formatted with the server locale ("1,234,567.89" or "1.234.567,89"):
				// the last separator is the decimal separator, the other one is the thousand separator.
				function parseNum(s) {
					var clean = s.trim().replace(/\s/g, '').replace(/[^\d,.-]/g, '');
					var lastComma = clean.lastIndexOf(',');
					var lastDot = clean.lastIndexOf('.');
					if (lastComma > lastDot) {
						clean = clean.replace(/\./g, '').replace(',', '.');
					} else {
						clean = clean.replace(/,/g, '');
					}
					return parseFloat(clean) || 0;
				}

				var rows = dataTable.querySelectorAll('tbody tr');
				rows.forEach(function(row) {
					var cells = row.querySelectorAll('td');
					if (cells.length < 4) return;
					months.push(cells[0].textContent.trim());
					duguje.push(parseNum(cells[1].textContent));
					potrazuje.push(parseNum(cells[2].textContent));
					saldo.push(parseNum(cells[3].textContent));
				});

				if (months.length === 0) return;

				new Chart(canvas, {
					type: 'bar',
					data: {
						labels: months,
						datasets: [
							{
								label: 'Duguje',
								data: duguje,
								backgroundColor: 'rgba(59,130,246,0.55)',
								borderColor: 'rgba(59,130,246,1)',
								borderWidth: 1
							},
							{
								label: 'Potražuje',
								data: potrazuje,
								backgroundColor: 'rgba(34,197,94,0.55)',
								borderColor: 'rgba(34,197,94,1)',
								borderWidth: 1
							},
							{
								label: 'Saldo',
								data: saldo,
								backgroundColor: 'rgba(239,68,68,0.55)',
								borderColor: 'rgba(239,68,68,1)',
								borderWidth: 1
							}
						]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						animation: { duration: 0 },
						plugins: {
							legend: { position: 'top' },
							title: { display: false }
						},
						scales: { y: { beginAtZero: true } }
					}
				});
			}

			// Run after DOM + Chart.js are ready
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', buildSubsintetickoKontaReportChart);
			} else {
				buildSubsintetickoKontaReportChart();
			}
		})();
	</script>
}
