package robno

import (
	"fmt"

	rep "helia/frontend/templates/reports"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

// RobnoStanjaArtikalStampa renders a printable "Prikaz stanja artikla" report:
// the article header (identification, names and totals) followed by the monthly
// movements table (Ulaz/Izlaz/Duguje/Potražuje).
templ RobnoStanjaArtikalStampa(repParams domain.ReportParameters, params domain.RobnoStanjaParams, total domain.RobnoStanjaTotal, tbl domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, RobnoStanjaArtikalParam(params, total, translator), nil, nil)
}

// RobnoStanjaArtikalParam displays the article identification, names and the
// overall totals (Ulaz/Izlaz/Stanje/Duguje/Potražuje/Saldo), mirroring the
// on-screen "Prikaz stanja pojedinačnog artikla" form.
templ RobnoStanjaArtikalParam(params domain.RobnoStanjaParams, total domain.RobnoStanjaTotal, translator *i18n.Service) {
	<div class="mb-3 text-sm print:text-[9pt]">
		<div class="grid grid-cols-[2fr_3fr_2fr] gap-x-6 gap-y-1 items-start">
			<!-- Identifikacija -->
			<div class="flex flex-col gap-1">
				<div class="flex items-center gap-2">
					<span class="font-semibold w-24">{ translator.Label("Šifra artikla") }</span>
					<span class="font-bold">{ total.Sifra }</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="font-semibold w-24">{ translator.Label("Konto") }</span>
					<span class="font-bold">{ params.Konto }</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="font-semibold w-24">{ translator.Label("Magacin") }</span>
					<span class="font-bold">{ fmt.Sprintf("%d", params.Magacin) }</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="font-semibold w-24">{ translator.Label("JM") }</span>
					<span class="font-bold">{ total.Jm }</span>
				</div>
			</div>
			<!-- Nazivi -->
			<div class="flex flex-col gap-1">
				<div class="font-bold">{ total.NazivArtikla }</div>
				<div class="font-bold">{ total.KontoNaziv }</div>
				<div class="font-bold">{ total.MagacinNaziv }</div>
				<div class="flex items-center gap-2">
					<span class="font-semibold w-24">{ translator.Label("Cena") }</span>
					<span class="font-bold">{ common.FormatNumberWithSystemLocale(total.Cena, 2) }</span>
				</div>
			</div>
			<!-- Ukupno -->
			<div class="flex flex-col gap-1">
				<div class="flex items-center justify-end gap-2">
					<span class="font-semibold w-20 text-right">{ translator.Label("Ulaz") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Ulaz, 3) }</span>
					<span class="font-semibold w-24 text-right ml-4">{ translator.Label("Duguje") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Duguje, 2) }</span>
				</div>
				<div class="flex items-center justify-end gap-2">
					<span class="font-semibold w-20 text-right">{ translator.Label("Izlaz") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Izlaz, 3) }</span>
					<span class="font-semibold w-24 text-right ml-4">{ translator.Label("Potražuje") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Potrazuje, 2) }</span>
				</div>
				<div class="flex items-center justify-end gap-2">
					<span class="font-semibold w-20 text-right">{ translator.Label("Stanje") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Stanje, 3) }</span>
					<span class="font-semibold w-24 text-right ml-4">{ translator.Label("Saldo") }</span>
					<span class="font-bold w-24 text-right">{ common.FormatNumberWithSystemLocale(total.Saldo, 2) }</span>
				</div>
			</div>
		</div>
	</div>
}

// RobnoStanjaArtikalTable renders the report grid. When pageHeader is set, it is rendered as the
// first row of the table <thead>, which makes the browser repeat it at the top of every printed page.
templ RobnoStanjaArtikalTable(tbl domain.TableData, translator *i18n.Service) {
	<div class="mb-8">
		<table class={ rep.ReportTableClass() }>
			@rep.ReportTableColgroup(rep.ReportColumnWidths(tbl.Headers))
			// @rep.ReportTableHeadWithPageHeader(tbl, translator, pageHeader)
			<tbody>
				for i, row := range tbl.Rows {
					if row.ClassRow == "group-header" || row.ClassRow == "group-header-new-page" {
						<tr
							class={ func() string {
								if row.ClassRow == "group-header-new-page" {
									return "bg-gray-200 font-bold print:bg-gray-200 page-break-before"
								}
								return "bg-gray-200 font-bold print:bg-gray-200"
							}() }
						>
							<td
								colspan={ fmt.Sprintf("%d", len(tbl.Headers)) }
								class="border border-gray-300 px-1 text-sm font-bold text-left print:text-[10pt] print:px-1"
							>
								{ row.Fields[0] }
							</td>
						</tr>
					} else if row.ClassRow == "group-total" {
						<tr class="bg-blue-50 font-bold border-t-2 border-blue-900 print:bg-blue-50 print:page-break-inside-avoid">
							for j, cell := range row.Fields {
								<td
									class={ fmt.Sprintf("border border-gray-300 px-1 text-sm font-bold print:text-[10pt] print:px-1 %s",
										func() string {
											if j == 0 {
												return "text-left"
											}
											return "text-right"
										}()) }
								>
									{ cell }
								</td>
							}
						</tr>
					} else {
						<tr
							class={ fmt.Sprintf("hover:bg-yellow-50 print:hover:bg-white print:page-break-inside-avoid %s",
								func() string {
									if i%2 == 1 {
										return "bg-gray-50 print:bg-gray-50"
									}
									return "bg-white print:bg-white"
								}()) }
						>
							for j, cell := range row.Fields {
								<td
									class={ fmt.Sprintf("border border-gray-300 px-1 text-sm print:text-[10pt] print:px-1 print:break-words print:whitespace-normal %s",
										func() string {
											if j < len(tbl.Headers) && tbl.Headers[j].TextAlign != "" {
												return fmt.Sprintf("text-%s", tbl.Headers[j].TextAlign)
											}
											return ""
										}()) }
								>
									{ cell }
								</td>
							}
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// RobnoStanjaViseArtikalaSifraStampa renders the printable "Prikaz stanja artikala" report
// (variant "po šifri"): the parameter block, one line per article and the total line.
templ RobnoStanjaViseArtikalaSifraStampa(repParams domain.ReportParameters, params domain.RobnoStanjaParams, magacinNaziv string, tbl domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, nil, nil, RobnoStanjaViseArtikalaSifraContent(repParams, params, magacinNaziv, tbl, translator))
}

templ RobnoStanjaViseArtikalaSifraContent(repParams domain.ReportParameters, params domain.RobnoStanjaParams, magacinNaziv string, tbl domain.TableData, translator *i18n.Service) {
	@rep.ReportPageHeader(repParams, RobnoStanjaViseArtikalaSifraParam(params, magacinNaziv, translator), translator)
	@rep.ReportTable(tbl, translator)
	@rep.ReportEnd(nil)
}

// RobnoStanjaViseArtikalaSifraParam prints the parameters the report was run with, including the
// state of the display options, like the legacy report does. It is rendered inside the centre
// column of the report header, directly below the report title.
templ RobnoStanjaViseArtikalaSifraParam(params domain.RobnoStanjaParams, magacinNaziv string, translator *i18n.Service) {
	<div class="text-[10px] print:text-[9pt] leading-tight">
		<!-- Line 1: ranges the report was run with (whitespace-nowrap keeps every item intact so the
		     whole row fits on a single printed line). -->
		<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 print:gap-x-2 print:gap-y-0">
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Magacin") }</span>
				<span class="font-bold">{ magacinNaziv }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Od konta") }:</span>
				<span class="font-bold">{ params.OdKonta }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Do konta") }:</span>
				<span class="font-bold">{ params.DoKonta }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Od šifre") }:</span>
				<span class="font-bold">{ params.OdSifre }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Do šifre") }:</span>
				<span class="font-bold">{ params.DoSifre }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Od meseca") }:</span>
				<span class="font-bold">{ fmt.Sprintf("%d", robnoStanjeMesec(params.OdMeseca, 1)) }</span>
			</div>
			<div class="flex items-center gap-1 whitespace-nowrap">
				<span class="font-semibold">{ translator.Label("Do meseca") }:</span>
				<span class="font-bold">{ fmt.Sprintf("%d", robnoStanjeMesec(params.DoMeseca, 12)) }</span>
			</div>
		</div>
		<!-- Line 2: state of the display options. -->
		<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0.5 mt-0.5 print:mt-0 print:gap-x-2 print:gap-y-0">
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.FinansijskiIznos) } { translator.Label("Finansijski iznos") }</span>
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.ArtikliSaStanjem) } { translator.Label("Artikli sa stanjem") }</span>
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.ArtikliBezStanja) } { translator.Label("Artikli bez stanja") }</span>
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.ProsecnaCenaStanje) } { translator.Label("Pros. cena / stanje") }</span>
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.ProsecnaCenaUlaz) } { translator.Label("Pros. cena / ulaz") }</span>
			<span class="whitespace-nowrap">{ robnoStanjeCbx(params.ZaDobavljaca) } { translator.Label("Za dobavljača") }</span>
		</div>
	</div>
}

// robnoStanjeCbx prints the state of a report option as a checkbox glyph.
func robnoStanjeCbx(checked bool) string {
	if checked {
		return "☑"
	}
	return "☐"
}

// robnoStanjeMesec clamps a month form value into 1..12 for the report header (fallback is used
// when the value is empty or out of range, e.g. 99 for "through the end of the year").
func robnoStanjeMesec(value string, fallback int) int {
	month := common.StringToInt(value)
	if month < 1 || month > 12 {
		return fallback
	}
	return month
}

// RobnoStanjaViseArtikalaGrupaStampa renders the printable "Prikaz stanja artikala" report
// (variant "po grupi"): the parameter block, one group per band with its articles and the total
// line. When "Nova strana po grupi" is selected every group starts on a new page.
templ RobnoStanjaViseArtikalaGrupaStampa(repParams domain.ReportParameters, params domain.RobnoStanjaParams, magacinNaziv string, tbl domain.TableData, translator *i18n.Service) {
	@rep.Report(repParams, tbl, translator, nil, nil, RobnoStanjaViseArtikalaGrupaContent(repParams, params, magacinNaziv, tbl, translator))
}

templ RobnoStanjaViseArtikalaGrupaContent(repParams domain.ReportParameters, params domain.RobnoStanjaParams, magacinNaziv string, tbl domain.TableData, translator *i18n.Service) {
	@rep.ReportPageHeader(repParams, RobnoStanjaViseArtikalaGrupaParam(params, magacinNaziv, translator), translator)
	@RobnoStanjaArtikalTable(tbl, translator)
	@rep.ReportEnd(nil)
}

