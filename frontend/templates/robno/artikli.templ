package robno

import (
	"fmt"
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

templ ArtikliMain(tbl domain.TableData, searchInput domain.InputControl, btnPrint domain.Button, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
			<!-- Search bar with button in flex row -->
			<div class="flex items-center justify-between">
				<div class="flex-1">
					@components.Search_Part(tbl, searchInput)
				</div>
				<div class="flex-shrink-0 mb-1">
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
			<!-- Table -->
			<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				@components.Table(tbl, translator)
			</div>
		</div>
		<div id="dialog-artikli-stampa"></div>
	</div>
	@tmpl.OpenPrintWithParamsScript()
}

templ ArtikliDialog(dialog domain.Dialog, action string, model domain.Rsif, btnSave domain.Button, btnCancel domain.Button, btnClose domain.Button, modelCombo []domain.ComboItem, jmCombo []domain.ComboItem, gruCombo []domain.ComboItem, pgruCombo []domain.ComboItem, translator *i18n.Service, csrfToken string) {
	<div id={ dialog.Id } class={ common.ClassMainDialogDiv }>
		<div class="bg-white rounded-lg shadow-2xl relative animate-fade-in min-w-[1200px]">
			<!-- Title Bar -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg">
				<h2 class="text-lg font-semibold ml-4">{ translator.Title(dialog.Title) }</h2>
				@components.CloseButton(btnClose)
			</div>
			<div class="flex flex-col">
				<form
					if dialog.HxRequestType == "PUT" {
						hx-put={ dialog.HxActionURL }
						hx-on::after-request={ templ.JSFuncCall("handleFormResponse", templ.JSExpression("event"), "PUT", dialog.Id, true) }
					}
					if dialog.HxRequestType == "POST" {
						hx-post={ dialog.HxActionURL }
						hx-on::after-request={ templ.JSFuncCall("handleFormResponse", templ.JSExpression("event"), "POST", dialog.Id, true) }
					}
					hx-target="#dialog-artikli-message"
					hx-boost="false"
					onsubmit="return false;"
					class="p-3 rounded-b-lg max-h-[75vh] overflow-y-auto"
				>
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<input type="hidden" name="rsifid" value={ fmt.Sprintf("%d", model.RsifID) }/>
					@artikliFormContentNew(model, modelCombo, jmCombo, gruCombo, pgruCombo, action, translator)
					<!-- Buttons -->
					<div class="flex justify-end gap-1 pt-3 border-t border-gray-300 mt-3">
						@components.ConfirmButton(btnSave, translator)
						@components.CancelButton(btnCancel, translator)
					</div>
				</form>
				<div id="dialog-artikli-message" class="hidden w-full whitespace-normal break-words px-4 pb-2"></div>
			</div>
		</div>
	</div>
	@tmpl.HandleFormResponseScript()
	@tmpl.ShowMessageScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.CloseDialogScript()
}

templ artikliFormContentNew(model domain.Rsif, modelCombo []domain.ComboItem, jmCombo []domain.ComboItem, gruCombo []domain.ComboItem, pgruCombo []domain.ComboItem, action string, translator *i18n.Service) {
	<div class="grid grid-cols-2 gap-4">
		<div class="flex flex-col gap-1">
			<div class="flex items-center gap-1">
				@artikliInput("Šifra", "sifra", fmt.Sprintf("%d", model.Sifra), "number", "w-24", "1", translator)
				@artikliInput("Barkod", "barkod", model.Barkod, "text", "flex-1", "2", translator)
			</div>
			@artikliInput("Naziv", "naziv", model.Naziv, "text", "flex-1", "3", translator)
			@artikliInput("Dodatni naziv", "dodatnaziv", model.DodatnaNaziv, "text", "flex-1", "4", translator)
			<div class="flex items-start gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "komercopis", LabelText: translator.Label("Komercijalni opis artikla"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextAreaField(domain.InputFieldConfig{Name: "komercopis", ID: "komercopis", Value: model.KomercOpis, ClassInput: common.ClassInputTextEnabled + " flex-1 h-16 resize-none", MaxLength: "500", TabIndex: "5"})
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Proizvođač", "pro", model.Pro, "text", "flex-1", "6", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Proizv. šifra", "proizsifra", model.ProizSifra, "text", "flex-1", "7", translator)
				@artikliInput("Serijski broj", "serbr", model.Serbr, "text", "flex-1", "8", translator)
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "kdob", LabelText: translator.Label("Dobavljač"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{Name: "kdob", ID: "kdob", FieldType: "text", Value: model.Kdob, ClassInput: common.ClassInputTextEnabled + " w-24", TabIndex: "9"})
				@components.SearchButton(domain.SearchButtonConfig{ID: "btn-search-dobavljac", Name: "search-dobavljac", HxUrl: "/api/promet/searchbutton", HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `{"destfield": "kdob"}`, ClassButton: common.ClassButton})
				@components.TextInputField(domain.InputFieldConfig{Name: "fsime", ID: "fsime", FieldType: "text", Value: model.FSimE, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1"})
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Zemlja porekla", "zemljaproizv", model.ZemljaProizv, "text", "flex-1", "10", translator)
				@artikliInput("Zemlja uvoza", "zemljauvoza", model.ZemljaUvoza, "text", "flex-1", "11", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Godina proizvodnje", "godproiz", fmt.Sprintf("%d", model.GodProiz), "number", "flex-1", "12", translator)
				@artikliInput("Godina uvoza", "goduvoza", fmt.Sprintf("%d", model.GodUvoza), "number", "flex-1", "13", translator)
			</div>
			<fieldset class="border border-gray-300 p-2 mt-1 rounded">
				<legend class="text-xs font-semibold text-gray-700 px-1">{ translator.Label("Vrsta artikla") }</legend>
				<div class="grid grid-cols-3 gap-2">
					@artikliRadio("artroba", "Roba", model.ArtRoba, "14", translator)
					@artikliRadio("artsir", "Sirovina", model.ArtSir, "15", translator)
					@artikliRadio("arttrosak", "Trošak", false, "16", translator)
					@artikliRadio("artproizv", "Gotov proizvod", model.ArtProizv, "17", translator)
					@artikliRadio("artpolup", "Poluproizvod", model.ArtPolup, "18", translator)
					@artikliRadio("artrezdeo", "Rezervni deo", false, "19", translator)
					@artikliRadio("artusl", "Usluga", model.ArtUsl, "20", translator)
					@artikliRadio("artamb", "Ambalaza", model.ArtAmb, "21", translator)
					@artikliRadio("artpotmat", "Potrošni materijal", false, "22", translator)
				</div>
			</fieldset>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "konto", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{Name: "konto", ID: "konto", FieldType: "text", Value: model.Konto, ClassInput: common.ClassInputTextEnabled + " w-28", TabIndex: "23"})
				@components.SearchButton(domain.SearchButtonConfig{ID: "btn-search-konto", Name: "search-konto", HxUrl: "/api/promet/searchbutton", HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `{"destfield": "konto"}`, ClassButton: common.ClassButton})
			@components.TextInputField(domain.InputFieldConfig{Name: "kontonaziv", ID: "kontonaziv", FieldType: "text", Disabled: true, Value: model.KontoNaziv, ClassInput: common.ClassInputTextDisabled + " flex-1"})
            </div>
		</div>
		<div class="flex flex-col gap-1">
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "tarifnaozn", LabelText: translator.Label("Šifra poreske tarife"), ClassLabel: common.ClassLabel + " w-32"})
				@components.TextInputField(domain.InputFieldConfig{Name: "tarifnaozn", ID: "tarifnaozn", FieldType: "number", Value: fmt.Sprintf("%d", model.TarifnaOzn), ClassInput: common.ClassInputTextEnabled + " w-24", TabIndex: "24"})
				@components.SearchButton(domain.SearchButtonConfig{ID: "btn-search-tarifa", Name: "search-tarifa", HxUrl: "/api/promet/searchbutton", HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `{"destfield": "tarifnaozn"}`, ClassButton: common.ClassButton})
				@artikliInput("Porez", "porez", "20,00%", "text", "w-24", "25", translator)
			</div>
			@artikliCombo("Model kalkulisanja", "model", modelCombo, model.Model, "26", translator)
			@artikliCombo("Jedinica mere", "jm", jmCombo, model.JM, "27", translator)
			@artikliCombo("Robna grupa", "gru", gruCombo, fmt.Sprintf("%d", model.Gru), "28", translator)
			@artikliCombo("Robna podgrupa", "pgru", pgruCombo, fmt.Sprintf("%d", model.Pgru), "29", translator)
			<div class="flex items-center gap-1">
				@artikliInput("Minimalne zalihe", "minzalihe", "0.000", "number", "flex-1", "30", translator)
				@artikliInput("Maksimalne zalihe", "maxzalihe", "0.000", "number", "flex-1", "31", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Transportno pakovanje", "trpakov", fmt.Sprintf("%d", model.TrPakov), "number", "flex-1", "32", translator)
				@artikliInput("Težina po jm", "tezjm", fmt.Sprintf("%.3f", model.TezJM), "number", "flex-1", "33", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Kubikaža", "kubikaza", fmt.Sprintf("%.3f", model.Kubikaza), "number", "flex-1", "34", translator)
				@artikliInput("Kvalitet", "kvalitet", model.Kvalitet, "text", "flex-1", "35", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Pakovanje", "pakov", fmt.Sprintf("%.0f", model.Pakov), "number", "flex-1", "36", translator)
				@artikliInput("Količina u pakovanju", "kolicinap", "0.00", "number", "flex-1", "37", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Tarifna šifra", "sifradobav", model.SifraDobaV, "text", "flex-1", "38", translator)
				@artikliInput("Lokacija", "lokacija", model.Lokacija, "text", "flex-1", "39", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Uvoznik", "uvoznik", model.Uvoznik, "text", "flex-1", "40", translator)
			</div>
			<div class="flex items-center gap-1">
				@artikliInput("Rok", "roktra", model.RokTra, "text", "flex-1", "41", translator)
			</div>
		</div>
	</div>
}

templ artikliInput(label, fieldName, value, fieldType, inputClass, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 flex-1">
		@components.LabelField(domain.LabelFieldConfig{ID: fieldName, LabelText: translator.Label(label), ClassLabel: common.ClassLabel + " w-32"})
		@components.TextInputField(domain.InputFieldConfig{Name: fieldName, ID: fieldName, FieldType: fieldType, Value: value, ClassInput: common.ClassInputTextEnabled + " " + inputClass, MaxLength: "100", TabIndex: tabIndex})
	</div>
}

templ artikliCombo(label, fieldName string, options []domain.ComboItem, selected, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1">
		@components.LabelField(domain.LabelFieldConfig{ID: fieldName, LabelText: translator.Label(label), ClassLabel: common.ClassLabel + " w-32"})
		@components.ComboBoxField(domain.ComboFieldConfig{ID: fieldName, Name: fieldName, LabelText: translator.Label(label), ClassLabel: common.ClassLabel, ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: options, SelectedValue: selected, TabIndex: tabIndex}, translator)
	</div>
}

// artikliRadio adapts the shared radio component for article type selection.
templ artikliRadio(fieldName string, label string, checked bool, tabIndex string, translator *i18n.Service) {
	@components.RadioButtonField(domain.RadioFieldConfig{
		ID:          fieldName,
		Name:        "vrsta-artikla",
		LabelText:   translator.Label(label),
		ClassLabel:  "text-xs text-gray-700",
		ClassSelect: common.ClassRadioSet,
		IsSelected:  checked,
		TabIndex:    tabIndex,
		Value:       fieldName,
	}, translator)
}
