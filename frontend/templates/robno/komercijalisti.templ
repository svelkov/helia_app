package robno

import (
	"fmt"
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

templ KomercijalistiMain(tbl domain.TableData, searchInput domain.InputControl, btnPrint domain.Button, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1">
			<!-- Search bar with button in flex row -->
			<div class="flex items-center justify-between">
				<div class="flex-1">
					@components.Search_Part(tbl, searchInput)
				</div>
				<div class="flex-shrink-0 mb-1">
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
			<!-- Table -->
			<div class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				@components.Table(tbl, translator)
			</div>
		</div>
		<div id="dialog-komercijalisti-stampa"></div>
	</div>
	@tmpl.OpenPrintWithParamsScript()
}

templ KomercijalistiDialog(dialog domain.Dialog, action string, model domain.Komercijalisti, btnSave domain.Button, btnCancel domain.Button, btnClose domain.Button, translator *i18n.Service, csrfToken string) {
	@tmpl.Dialog("komercijalisti-form", csrfToken, komercijalistiFormContent(model, translator), dialog, btnSave, btnCancel, btnClose, translator)
}

templ komercijalistiFormContent(model domain.Komercijalisti, translator *i18n.Service) {
	<div class="grid grid-cols-3 gap-2">
		<!-- Left Column: Main Fields -->
		<div class="col-span-2">
			<!-- Šifra komercijaliste (required) -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "sifkom",
					LabelText:  translator.Label("Šifra komercijaliste"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "sifkom",
					Name:       "sifkom",
					Value:      fmt.Sprintf("%d", model.Sifkom),
					FieldType:  "number",
					Required:   true,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					TabIndex:   "1",
					OnInput:    "clearFieldError",
					OnFocus:    "clearFieldError",
				})
			</div>
			<!-- Šifra nadređene osobe -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "sifnadred",
					LabelText:  translator.Label("Šifra nadređene osobe"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "sifnadred",
					Name:       "sifnadred",
					Value:      fmt.Sprintf("%d", model.SifNadred),
					FieldType:  "number",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					TabIndex:   "2",
				})
			</div>
			<!-- Ime i prezime (required) -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "imeprezime",
					LabelText:  translator.Label("Ime i prezime"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "imeprezime",
					Name:       "imeprezime",
					Value:      model.ImePrezime,
					FieldType:  "text",
					Required:   true,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "100",
					TabIndex:   "3",
					OnInput:    "clearFieldError",
					OnFocus:    "clearFieldError",
				})
			</div>
			<!-- Adresa -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "adresa",
					LabelText:  translator.Label("Adresa"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "adresa",
					Name:       "adresa",
					Value:      model.Adresa,
					FieldType:  "text",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "100",
					TabIndex:   "4",
				})
			</div>
			<!-- Mesto -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "mesto",
					LabelText:  translator.Label("Mesto"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "mesto",
					Name:       "mesto",
					Value:      model.Mesto,
					FieldType:  "text",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "100",
					TabIndex:   "5",
				})
			</div>
			<!-- Telefon posao -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "telposao",
					LabelText:  translator.Label("Telefon posao"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "telposao",
					Name:       "telposao",
					Value:      model.TelPosao,
					FieldType:  "text",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "20",
					TabIndex:   "6",
				})
			</div>
			<!-- Telefon mobilni -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "telmob",
					LabelText:  translator.Label("Telefon mobilni"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "telmob",
					Name:       "telmob",
					Value:      model.TelMob,
					FieldType:  "text",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "20",
					TabIndex:   "7",
				})
			</div>
			<!-- Login name -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "loginname",
					LabelText:  translator.Label("Login name"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "loginname",
					Name:       "loginname",
					Value:      model.LoginName,
					FieldType:  "text",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " flex-1",
					MaxLength:  "15",
					TabIndex:   "8",
				})
			</div>
		</div>
		
		<!-- Right Column: Statistics -->
		<div class="col-span-1 bg-blue-50 p-2 rounded border border-blue-300">
			<div class="font-bold text-left mb-3">{ translator.Label("Stanje") }</div>
			<!-- Ukupna prodaja -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "totprod-label",
					LabelText:  translator.Label("Ukupna prodaja"),
					ClassLabel: common.ClassLabel + " text-xs",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "totprod",
					Name:       "totprod",
					Value:      fmt.Sprintf("%.2f", model.TotProd),
					FieldType:  "number",
					Required:   false,
					Disabled:   true,
					ClassInput: common.ClassInputTextDisabled + " w-24",
					TabIndex:   "9",
				})
			</div>
			<!-- Ukupan profit -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "totprofit-label",
					LabelText:  translator.Label("Ukupan profit"),
					ClassLabel: common.ClassLabel + " text-xs",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "totprofit",
					Name:       "totprofit",
					Value:      fmt.Sprintf("%.2f", model.TotProfit),
					FieldType:  "number",
					Required:   false,
					Disabled:   true,
					ClassInput: common.ClassInputTextDisabled + " w-24",
					TabIndex:   "10",
				})
			</div>
			<!-- Ukupno naplaćeno -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "totnaplaceno-label",
					LabelText:  translator.Label("Ukupno naplaćeno"),
					ClassLabel: common.ClassLabel + " text-xs",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "totnaplaceno",
					Name:       "totnaplaceno",
					Value:      fmt.Sprintf("%.2f", model.TotNaplaceno),
					FieldType:  "number",
					Required:   false,
					Disabled:   true,
					ClassInput: common.ClassInputTextDisabled + " w-24",
					TabIndex:   "11",
				})
			</div>
			<!-- Poslednji datum prodaje -->
			<div class="flex items-center mt-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "zaddatprod-label",
					LabelText:  translator.Label("Poslednji datum"),
					ClassLabel: common.ClassLabel + " text-xs",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "zaddatprod",
					Name:       "zaddatprod",
					Value:      model.ZadDatProd.Format("2006-01-02"),
					FieldType:  "date",
					Required:   false,
					Disabled:   false,
					ClassInput: common.ClassInputTextEnabled + " w-24",
					TabIndex:   "12",
				})
			</div>
		</div>
	</div>
}
