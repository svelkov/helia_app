package robno

import (
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

templ KrajPoslovneGodineMain(tabs, subtabs domain.TabData, tbl domain.TableData, mag []domain.ComboItem, tr *i18n.Service) {
	<div id="tab-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@KrajPoslovneGodinePopis(tabs, subtabs, tbl, mag, tr)
	</div>
	@tmpl.HideDropdownScript()
}

templ KrajPoslovneGodinePopis(tabs, subtabs domain.TabData, tbl domain.TableData, mag []domain.ComboItem, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kraj poslovne godine"), tabs, "#tab-content", "kpg-panel", translator)
		</div>
		<div class="border-b border-blue-600 pt-1 mb-1">
			@tmpl.TabNav("", subtabs, "#tab-content", "kpg-subpanel", translator)
		</div>
		@KrajPoslovneGodineParameters(mag, translator, "/api/robno-kraj-poslovne-godine/popis")
		<div class="border border-blue-400 bg-blue-100 p-1 mb-1 rounded-lg flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	</div>
}

templ KrajPoslovneGodineParameters(mag []domain.ComboItem, translator *i18n.Service, action string) {
	<form
		class="border border-blue-400 p-1 rounded-lg grid grid-cols-1 md:grid-cols-3 gap-1 mb-1"
		hx-get={ action }
		hx-target="#kpg-table"
		hx-swap="outerHTML"
		hx-headers='{"X-Request-Source":"btnobrada"}'
	>
		<div class="flex items-center gap-1 mb-1">
			<label class={ common.ClassLabel + " w-24" } for="magacin">{ translator.Label("Magacin") }</label>@components.ComboBoxField(domain.ComboFieldConfig{ID: "magacin", Name: "magacin", OptionValues: mag, ClassSelect: common.ClassInputTextEnabled + " flex-1"}, translator)
		</div>
		<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-24" } for="odkonta">{ translator.Label("Od konta") }</label><input id="odkonta" name="odkonta" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
		<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-24" } for="dokonta">{ translator.Label("Do konta") }</label><input id="dokonta" name="dokonta" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
		<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-24" } for="odsifre">{ translator.Label("Od šifre") }</label><input id="odsifre" name="odsifre" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
		<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-24" } for="dosifre">{ translator.Label("Do šifre") }</label><input id="dosifre" name="dosifre" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
		<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-24" } for="obradinule">{ translator.Label("Obradi nule") }</label><input id="obradinule" name="obradinule" type="checkbox"/></div>
		<div class="md:col-span-3 flex justify-end gap-1"><button class={ common.ClassSaveButton } type="submit">{ translator.Button("Obradi") }</button><button class={ common.ClassPrintButton } type="button" hx-get="/api/robno-kraj-poslovne-godine/popis/stampa" hx-target="body" hx-include="closest form">{ translator.Button("Štampaj") }</button><button class={ common.ClassPrintButton } type="button" hx-get="/api/robno-kraj-poslovne-godine/popis/stampa2" hx-target="body" hx-include="closest form">{ translator.Button("Štampaj 2") }</button></div>
	</form>
}

templ KrajPoslovneGodineObrada(tabs domain.TabData, tbl domain.TableData, mag []domain.ComboItem, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kraj poslovne godine"), tabs, "#tab-content", "kpg-panel", translator)
		</div>
		<form class="border border-blue-400 p-1 rounded-lg grid grid-cols-1 md:grid-cols-3 gap-1" hx-get="/api/robno-kraj-poslovne-godine/obrada" hx-headers='{"X-Request-Source":"btnobrada"}'>
			<div class="flex items-center gap-1">
				<label class={ common.ClassLabel + " w-28" } for="magacin">{ translator.Label("Magacin") }</label>@components.ComboBoxField(domain.ComboFieldConfig{ID: "magacin", Name: "magacin", OptionValues: mag, ClassSelect: common.ClassInputTextEnabled + " flex-1"}, translator)
			</div>
			<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-28" } for="novagod">{ translator.Label("Nova godina") }</label><input id="novagod" name="novagod" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
			<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-28" } for="nalog">{ translator.Label("Nalog") }</label><input id="nalog" name="nalog" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
			<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-28" } for="dokum">{ translator.Label("Dokument") }</label><input id="dokum" name="dokum" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
			<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-28" } for="vrd">{ translator.Label("Vrsta dokumenta") }</label><input id="vrd" name="vrd" type="number" class={ common.ClassInputTextEnabled + " flex-1" }/></div>
			<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-28" } for="tipzal">{ translator.Label("TIPZAL") }</label><select id="tipzal" name="tipzal" class={ common.ClassInputTextEnabled + " flex-1" }><option value="1">1</option><option value="2">2</option></select></div>
		</form>
		<div class="flex justify-end p-1"><button class={ common.ClassSaveButton } hx-get="/api/robno-kraj-poslovne-godine/obrada" hx-headers='{"X-Request-Source":"btnobrada"}' hx-include="form">{ translator.Button("Obradi viškove/manjkove") }</button></div>
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	</div>
}

templ KrajPoslovneGodinePrepis(tabs domain.TabData, tbl domain.TableData, mag []domain.ComboItem, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Kraj poslovne godine"), tabs, "#tab-content", "kpg-panel", translator)
		</div>
		<form class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1" hx-get="/api/robno-kraj-poslovne-godine/prepis" hx-headers='{"X-Request-Source":"btnprepis"}'>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-1">
				@kpgInput("magacin", "Magacin", "text", "", translator)
				@kpgInput("vrd", "Vrsta naloga za knjiženje", "text", "00 - POČETNO STANJE", translator)
				@kpgInput("orgjed", "OJ", "text", "", translator)
				@kpgInput("danobrade", "Datum obrade", "date", "", translator)
				@kpgInput("mestotroska", "Mesto troška", "text", "", translator)
				@kpgInput("opis", "Opis knjiženja", "text", "", translator)
				@kpgInput("staragod", "Stara godina", "number", "", translator)
				@kpgInput("nalog", "Broj naloga", "number", "", translator)
				@kpgInput("dannalog", "Datum naloga", "date", "", translator)
				@kpgInput("dokum", "Broj dokumenta", "number", "", translator)
				@kpgInput("dandokum", "Datum dokumenta", "date", "", translator)
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1">
				@components.RadioButtonField(domain.RadioFieldConfig{ID: "cena1", Name: "cena", Value: "1", LabelText: "Prepis zaliha po zadnjim prodajnim cenama", IsSelected: true, ClassSelect: common.ClassRadioSet}, translator)
				@components.RadioButtonField(domain.RadioFieldConfig{ID: "cena2", Name: "cena", Value: "2", LabelText: "Prepis zaliha po prosečnim nabavnim cenama", ClassSelect: common.ClassRadioSet}, translator)
				@components.RadioButtonField(domain.RadioFieldConfig{ID: "cena3", Name: "cena", Value: "3", LabelText: "Prepis zaliha po MP cenama", ClassSelect: common.ClassRadioSet}, translator)
				@components.RadioButtonField(domain.RadioFieldConfig{ID: "cena4", Name: "cena", Value: "4", LabelText: "Prepis zaliha po planskim cenama", ClassSelect: common.ClassRadioSet}, translator)
			</div>
			<div class="flex justify-end"><button class={ common.ClassSaveButton } type="submit">{ translator.Button("Prepis (F4)") }</button></div>
		</form>
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	</div>
}

templ kpgInput(id, label, inputType, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1"><label class={ common.ClassLabel + " w-40" } for={ id }>{ translator.Label(label) }</label><input id={ id } name={ id } type={ inputType } value={ value } class={ common.ClassInputTextEnabled + " flex-1 min-w-0" }/></div>
}
