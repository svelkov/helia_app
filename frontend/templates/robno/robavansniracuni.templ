package robno

import (
	"helia/frontend/components"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
)

//
// Avansni računi (the legacy rob_AvansniRacuni and rob_AvansniRacuni_DET, the vrste dokumenata of the groups ARA
// and ARU): the screen of the fakture usluga (Rob_FaktureUsluga) with the header of the avansni račun and its
// stavke (RobAvansniStavkeFields: the ids of the stavke of the usluge, so the script of the usluge serves them).
//

// RobAvansniStavkeFields renders the stavke of the avansni račun (the legacy rob_AvansniRacuni_DET): the data of
// the document, the form of a stavka (the šifra 0 and the konto of the magacin hidden, the opis of the robe or
// usluge, the količina 1 read only, the tarifa with its stopa, the poreska kategorija with its osnov
// oslobođenja, the cena and the iznos), its buttons and the grid of the stavke.
templ RobAvansniStavkeFields(ui domain.RobnoFaktureUI, stavka domain.RobnoUslugeStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
		<div class="flex flex-wrap items-center gap-2 min-w-0">
			@RobnoFaktureStavkaInfo("vrdstavke", translator.Label("Vrsta dokumenta"), stavka.Vrd, "!w-16 text-right")
			@RobnoFaktureStavkaInfo("brdokstavke", translator.Label("Broj dokumenta"), stavka.Brdok, "!w-24 text-right")
			@RobnoFaktureStavkaInfo("datumdokstavke", translator.Label("Datum dokumenta"), stavka.DatumDokumenta, "!w-28 text-center")
			@RobnoFaktureStavkaInfo("kupacstavke", translator.Label("Kupac"), stavka.KupacNaziv, "flex-1")
		</div>
	</fieldset>
	<fieldset
		id="robno-usluge-stavka"
		class="border border-blue-400 bg-blue-100 p-1 rounded-lg"
		data-artikal-url={ ui.ArtikalURL }
		data-stopa-url={ ui.ArtikalURL + "/stopa" }
		data-grupa={ stavka.Grupa }
		data-tipzal="1"
		data-vpcena="false"
		data-nabcena="false"
		data-kurs="0"
		data-vaziza="0"
	>
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<input type="hidden" id="stavkarproid" name="rproid" value={ strconv.FormatInt(stavka.RproID, 10) }/>
		<!-- The šifra 0 (a usluga with its own opis) and the konto of the magacin -->
		<input type="hidden" id="sifraartikla" name="sifraartikla" value="0"/>
		<input type="hidden" id="kontostavke" name="kontostavke" value={ stavka.Konto }/>
		<div class="flex items-center gap-1 mb-1 min-w-0">
			@components.LabelField(domain.LabelFieldConfig{ID: "opisusluge", LabelText: translator.Label("Opis robe ili usluge"), ClassLabel: common.ClassLabel + " w-40"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:         "opisusluge",
				Name:       "opisusluge",
				FieldType:  "text",
				Value:      stavka.OpisUsluge,
				ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
				MaxLength:  "1000",
				OnInput:    "clearFieldError",
				OnFocus:    "clearFieldError",
				TabIndex:   "1"})
		</div>
		<div class="grid grid-cols-[minmax(0,26rem)_minmax(0,1fr)] gap-x-3">
			<div class="flex flex-col min-w-0">
				<!-- The količina of a stavka of the avansni račun is 1 (read only, like the legacy) -->
				@robUslugeBroj("kolicina", translator.Label("Količina"), stavka.Kolicina, "15", "", true)
				@robUslugeBroj("cenausluge", translator.Label("Cena"), stavka.ProdajnaCena, "18", "4", false)
				@robUslugeBroj("iznosusluge", translator.Label("Iznos"), stavka.Iznos, "18", "", true)
			</div>
			<div class="flex flex-col min-w-0">
				<!-- The tarifa with its stopa, the poreska kategorija and, for S10 and S20, its osnov oslobođenja -->
				<div class="flex items-center gap-1 mb-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "tarifa", LabelText: translator.Label("Šifra poreske tarife"), ClassLabel: common.ClassLabel + " w-40"})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "tarifa",
						Name:       "tarifa",
						FieldType:  "text",
						Value:      stavka.Tarifa,
						ClassInput: common.ClassInputTextEnabled + " !w-12 text-right",
						MaxLength:  "4",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError",
						TabIndex:   "2"})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "stopastavke",
						FieldType:  "text",
						Value:      stavka.Stopa,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-14 text-right"})
					<span class="text-sm">%</span>
				</div>
				<div class="flex items-center gap-1 mb-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "taxcat", LabelText: translator.Label("Poreska kategorija"), ClassLabel: common.ClassLabel + " w-40"})
					@components.ComboBoxField(domain.ComboFieldConfig{
						ID:            "taxcat",
						Name:          "taxcat",
						ClassSelect:   common.ClassInputTextEnabled + " !w-24",
						OptionValues:  stavka.CbxTaxcat,
						SelectedValue: stavka.Taxcat,
						TabIndex:      "3"}, translator)
					<span id="robno-usluge-taxexem" class={ robnoFaktureTaxexemClass(stavka.Taxcat) }>
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "taxexreco",
							Name:          "taxexreco",
							ClassSelect:   common.ClassInputTextEnabled + " !w-28",
							OptionValues:  stavka.CbxTaxexreco,
							SelectedValue: stavka.Taxexreco,
							TabIndex:      "5"}, translator)
					</span>
				</div>
			</div>
		</div>
	</fieldset>
	<div class="flex items-center justify-end gap-1">
		@RobnoFaktureStavkeButtons(btns)
	</div>
	if tbl.TableID != "" {
		<div id="robno-usluge-stavke-grid" class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// robAvansniNaslov is the title of the dialog (i 0), of the first tab (1) and of the tab "Pregled" (2) of the
// screen of the fakture usluga: of an avansni račun the ones of the legacy rob_AvansniRacuni.
func robAvansniNaslov(header domain.RobnoFaktureHeaderView, naslov string, i int) string {
	if header.Avansni {
		return []string{"Avansni računi", "Avansni račun", "Pregled avansnih računa"}[i]
	}
	return []string{naslov, naslov, "Pregled faktura"}[i]
}

// robAvansniHeaderNaslov is the title of the header control: of an avansni račun "Podaci o avansnom računu".
func robAvansniHeaderNaslov(header domain.RobnoFaktureHeaderView) string {
	if header.Avansni {
		return "Podaci o avansnom računu"
	}
	return "Podaci o fakturi"
}

// robAvansniLegenda is the title of a panel of the header of the faktura: of an avansni račun (whose header has
// not all the fields of the faktura) avansni, else faktura.
func robAvansniLegenda(header domain.RobnoFaktureHeaderView, faktura, avansni string) string {
	if header.Avansni {
		return avansni
	}
	return faktura
}
