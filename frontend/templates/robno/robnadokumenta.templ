						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "serija",
						Name:       "serija",
						FieldType:  "text",
						Value:      stavka.Serija,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "13"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "rokstavke",
						LabelText:  translator.Label("Rok"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "rokstavke",
