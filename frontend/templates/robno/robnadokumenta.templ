								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
