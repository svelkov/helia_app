					<!-- Third column: the range of the dates -->
					<div class="flex flex-col">
						<!-- Od datuma -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oddanal",
								LabelText:  translator.Label("Od datuma"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oddanal",
								Name:       "oddanal",
								FieldType:  "date",
								Value:      params.OdDanal,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "9",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<!-- Do datuma -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dodanal",
								LabelText:  translator.Label("Do datuma"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "dodanal",
								Name:       "dodanal",
								FieldType:  "date",
								Value:      params.DoDanal,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "10",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
					</div>
				</div>
				<!-- State of the print: "Štampaj samo zbir" and the radio buttons "Specifikacija" / "Fakturna knjiga" -->
				<div class="flex flex-wrap items-center gap-3 pl-44 mb-1">
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "stampajsamozbir",
						Name:              "stampajsamozbir",
						LabelText:         "Štampaj samo zbir",
						ClassLabel:        common.ClassCheckboxLabel,
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
						IsChecked:         params.StampajSamoZbir,
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "specifikacija",
						Name:        "tipspecifikacije",
						LabelText:   "Specifikacija",
						Value:       "1",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.TipSpecifikacije != "2",
						TabIndex:    "11",
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "fakturnaknjiga",
						Name:        "tipspecifikacije",
						LabelText:   "Fakturna knjiga",
						Value:       "2",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.TipSpecifikacije == "2",
						TabIndex:    "12",
					}, translator)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Obrada i štampa") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Tab 4 - Kontiranje dokumenata (sub-tabs "Knjiženje dokumenata", "Pregled proknjiženih /
// neproknjiženih dokumenata" and "Pregled proknjiženih / neproknjiženih dokumenata po magacinima")
//

// RobnoDokumentaKontiranjeKnjizenje renders the "Knjiženje dokumenata" sub-tab of "Kontiranje
// dokumentata": the parameters of the selection of the documents (vrsta naloga za knjiženje, vrsta
// dokumenta, magacin and the ranges of the broj naloga, the broj dokumenta and the datum naloga),
// the buttons of the posting ("Obrada", "Proveri ravnotežu" and "Knjiži") and the grid of the robni
// dokumenti.
templ RobnoDokumentaKontiranjeKnjizenje(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjeKnjizenjeBody(tbl, tipdokValues, vrstaDokumentaValues, magValues, params, btnObrada, btnRavnoteza, btnKnjizi, searchInput, translator))
}

// RobnoDokumentaKontiranjeKnjizenjeBody renders the body of the "Knjiženje dokumenata" sub-tab. The
// parameters (left) and the "Knjiženje" panel with the buttons (right) have the same height, like
// the header of the "Unos dokumenta" tab.
templ RobnoDokumentaKontiranjeKnjizenjeBody(tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "2",
							}, translator)
						</div>
						<!-- Vrsta dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "vrd",
								Name:          "vrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  vrstaDokumentaValues,
								SelectedValue: params.Vrd,
								TabIndex:      "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Knjiženje") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnRavnoteza)
					@components.Button(btnKnjizi)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePregled renders the "Pregled proknjiženih / neproknjiženih dokumenata"
// sub-tab of "Kontiranje dokumenata": the parameters of the selection, the state of the posting
// (the radio buttons "Proknjiženi dokumenti" / "Neproknjiženi dokumenti" and the checkbox that
// marks the displayed documents as not posted) and the grid of the robni dokumenti.
templ RobnoDokumentaKontiranjePregled(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePregledBody(tbl, tipdokValues, magValues, params, btnObrada, btnOznaci, searchInput, translator))
}

// RobnoDokumentaKontiranjePregledBody renders the body of the "Pregled proknjiženih /
// neproknjiženih dokumenata" sub-tab.
templ RobnoDokumentaKontiranjePregledBody(tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "2",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "3", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "4", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "5", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "6", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "7", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "8", translator)
					</div>
				</div>
				<!-- State of the posting: the radio buttons "Proknjiženi / Neproknjiženi dokumenti" and the
				     checkbox that marks the displayed documents as not posted, in one row -->
				<div class="flex flex-wrap items-center gap-3 pl-44 mb-1">
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "proknjizeni",
						Name:        "proknjizen",
						LabelText:   "Proknjiženi dokumenti",
						Value:       "D",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "D",
						TabIndex:    "9",
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "neproknjizeni",
						Name:        "proknjizen",
						LabelText:   "Neproknjiženi dokumenti",
						Value:       "N",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "N",
						TabIndex:    "10",
					}, translator)
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "oznacineproknjizenim",
						Name:              "oznacineproknjizenim",
						LabelText:         "Označi prikazana dokumenta kao neproknjižena",
						ClassLabel:        common.ClassCheckboxLabel,
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
						IsChecked:         params.OznaciNeproknjizenim,
					}, translator)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnOznaci)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePoMagacinima renders the "Pregled proknjiženih / neproknjiženih
// dokumenata po magacinima" sub-tab of "Kontiranje dokumenata": the same filters as the previous
// sub-tab without the vrsta naloga (the grid is grouped by the magacin of the document).
templ RobnoDokumentaKontiranjePoMagacinima(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePoMagacinimaBody(tbl, magValues, params, btnObrada, searchInput, translator))
}

// RobnoDokumentaKontiranjePoMagacinimaBody renders the body of the "Pregled ... po magacinima"
// sub-tab.
templ RobnoDokumentaKontiranjePoMagacinimaBody(tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the magacin and the radios) takes the free space, the ranges and the dates
				     are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- State of the posting: proknjiženi / neproknjiženi dokumenti -->
						<div class="flex flex-wrap items-center gap-2 pt-1">
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "proknjizeni",
								Name:        "proknjizen",
								LabelText:   "Proknjiženi dokumenti",
								Value:       "D",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "D",
								TabIndex:    "2",
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "neproknjizeni",
								Name:        "proknjizen",
								LabelText:   "Neproknjiženi dokumenti",
								Value:       "N",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "N",
								TabIndex:    "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The button is aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaRangeField renders one "Od/Do broja ..." range of the "Kontiranje dokumenata" tab
// (a whole number typed as text).
templ RobnoDokumentaRangeField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "text",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
			MaxLength:  "9",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// RobnoDokumentaDateField renders one "Od/Do datuma naloga" date of the "Kontiranje dokumenata" tab.
templ RobnoDokumentaDateField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "date",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-32",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// Tab 5 - Prepis dokumenta
templ RobnoDokumentaPrepis(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEmptyBody("Prepis dokumenta", tbl, btnObrada, btnPrint, searchInput, translator))
}

// Tab 6 - Prikaz ukupne obrade
templ RobnoDokumentaPrikazUkupneObrade(tabs, subTabs domain.TabData, tbl domain.TableData, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazUkupneObradeBody(tbl, btnPrint, searchInput, translator))
}

// RobnoDokumentaPrikazUkupneObradeBody renders the body of the "Prikaz ukupne obrade" tab: the grid
templ RobnoDokumentaPrikazUkupneObradeBody(tbl domain.TableData, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- The print button is the only control of the tab: it is pushed to the right, like the toolbar of
	     the other tabs of the option ("justify-end" on the flex container that holds it). -->
	<div class="flex items-center justify-end gap-1 mt-1 mb-1">
		@components.Search_PartPrintButton(btnPrint)
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 7 - Prikaz naloga
//
// The tab shows the robni nalozi of the current period filtered by magacin, the range of the vrste
// naloga and the range of the broj naloga. The three checkboxes ("Po datumu naloga", "Po datumu
// obrade" and "Po operateru") enable their fields when they are checked (controlToggle of
// EnableDisableFieldsScripts, like "Prikaz kartice artikla" of the robno kartica does).
templ RobnoDokumentaPrikazNaloga(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaParametriNalogaBody renders the body of the tabs that select robni nalozi ("Prikaz
// naloga" and "Prikaz dokumenata u nalogu"): the parameters of the selection (the only panel of the
// tab - the buttons "Obrada" and "Štampaj" are in the row of the "Po operateru" checkbox, aligned
// to the right) and the grid of the tab (the columns come from the table of the tab). Every checkbox
// is in the same row as the fields it enables.
templ RobnoDokumentaParametriNalogaBody(tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab): the fields of the nalog in the first
	     third of the panel and, in the other two thirds, every checkbox with the fields it enables in
	     one row. The buttons "Obrada" and "Štampaj" are at the bottom right of the panel.
	     The wrapper is a flex column that fills the body of the tab (flex-1 min-h-0), so that the grid
	     under the parameters (flex-1) stretches to the bottom like the grids of the other tabs. -->
	<div class="no-border bg-blue-100 rounded-lg flex-1 min-h-0 flex flex-col">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 mb-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<!-- The rows of the second column are one below the other (mb-2) and the free space of every
			     row is distributed between its controls (justify-between); the date fields are kept
			     narrow (w-40) so that there is enough space between the controls. -->
			<div class="grid grid-cols-3 gap-x-2 mb-1">
				<!-- Magacin, the range of the vrste naloga and the range of the broj naloga -->
				<div class="flex flex-col">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odvrd",
							LabelText:  translator.Label("Od vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "odvrd",
							Name:          "odvrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.OdVrd,
							TabIndex:      "2",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dovrd",
							LabelText:  translator.Label("Do vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "dovrd",
							Name:          "dovrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.DoVrd,
							TabIndex:      "3",
						}, translator)
					</div>
					<!-- Od broja naloga (the label has the width of the labels of the fields above) -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odnaloga",
							LabelText:  translator.Label("Od broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odnaloga",
							Name:       "odnaloga",
							FieldType:  "text",
							Value:      params.OdNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do broja naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "donaloga",
							LabelText:  translator.Label("Do broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "donaloga",
							Name:       "donaloga",
							FieldType:  "text",
							Value:      params.DoNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- The checkbox of every filter with the fields it enables, in one row -->
				<div class="col-span-2 flex flex-col">
					<!-- Po datumu naloga -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "6", translator)
						<!-- The controls of the row start right after the checkbox (flex-1 wrapper), so the
						     labels of all the rows are aligned one below the other. Every label stays with
						     its own field (as in the first column), so the fields of rows 1-3 all start at
						     the same x -->
						<div class="flex-1 flex items-center justify-between gap-1">
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "oddanal",
									LabelText:  translator.Label("Od datuma naloga"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "oddanal",
									Name:       "oddanal",
									FieldType:  "date",
									Value:      params.OdDanal,
									Disabled:   !params.ChkDatumNaloga,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "7"})
							</div>
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "dodanal",
									LabelText:  translator.Label("Do datuma naloga"),
									ClassLabel: common.ClassLabel + " w-32 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "dodanal",
									Name:       "dodanal",
									FieldType:  "date",
									Value:      params.DoDanal,
									Disabled:   !params.ChkDatumNaloga,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "8"})
							</div>
						</div>
					</div>
					<!-- Po datumu obrade -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "9", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "oddatob",
									LabelText:  translator.Label("Od datuma obrade"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "oddatob",
									Name:       "oddatob",
									FieldType:  "date",
									Value:      params.OdDatob,
									Disabled:   !params.ChkDatumObrade,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "10"})
							</div>
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "dodatob",
									LabelText:  translator.Label("Do datuma obrade"),
									ClassLabel: common.ClassLabel + " w-32 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "dodatob",
									Name:       "dodatob",
									FieldType:  "date",
									Value:      params.DoDatob,
									Disabled:   !params.ChkDatumObrade,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "11"})
							</div>
						</div>
					</div>
					<!-- Po operateru: the checkbox and the operator, in the third row of the panel, so the
					     operator control is in line with the "Do vrste naloga" combo box of the first
					     column (that row has the same height and spacing as the rows of the first column). -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "12", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oper",
								LabelText:  translator.Label("Operater"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oper",
								Name:       "oper",
								FieldType:  "text",
								Value:      params.Oper,
								Disabled:   !params.ChkOperator,
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								MaxLength:  "20",
								TabIndex:   "13"})
						</div>
					</div>
					<!-- The buttons of the tab, at the bottom right of the panel (in line with the "Do broja
					     naloga" field of the first column) -->
					<div class="flex items-center justify-end gap-1 mt-auto">
						@components.FormObradaButton(btnObrada, translator)
						@components.Search_PartPrintButton(btnPrint)
					</div>
				</div>
			</div>
		</fieldset>
		<!-- Group Data Table -->
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
			@components.LoadingSpinner()
			@components.Search_Part(tbl, searchInput)
			<!-- Table -->
			<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				@components.Table(tbl, translator)
			</div>
		</div>
	</div>
}

// RobnoDokumentaCheckBox renders one of the checkboxes of the "Prikaz naloga" tab that enable the
// fields of a filter (the same pattern as "Prikaz kartice artikla": controlToggle switches the
// disabled state of the fields listed in the JSON array of the onchange handler).
templ RobnoDokumentaCheckBox(id, labelText, fields string, isChecked bool, tabIndex string, translator *i18n.Service) {
	<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0 h-8 sm:h-7 md:h-6" }>
		<input
			type="checkbox"
			id={ id }
			name={ id }
			class={ common.ClassCheckbox }
			tabindex={ tabIndex }
			if isChecked {
				checked="checked"
			}
			onchange={ templ.JSFuncCall("controlToggle", templ.JSExpression("this"), templ.JSExpression(fields)) }
		/>
		<span class={ common.ClassCheckboxSpan }>{ translator.Label(labelText) }</span>
	</label>
}

// Tab 8 - Prikaz dokumenata u nalogu
//
// The tab shows the robni dokumenti of the selected nalozi: it uses the same parameters and the
// same layout as the "Prikaz naloga" tab (the body of the two tabs is shared), only the columns of
// its grid differ.
templ RobnoDokumentaPrikazDokumenataUNalogu(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, searchInput, translator))
}

// Tab 9 - Prikaz dokumenata po operateru
templ RobnoDokumentaPrikazDokumenataPoOperateru(tabs, subTabs domain.TabData, tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazDokumenataPoOperateruBody(tbl, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaPrikazDokumenataPoOperateruBody renders the body of the "Prikaz dokumenata po
templ RobnoDokumentaPrikazDokumenataPoOperateruBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab) in the three columns of the legacy
	     screen: the checkboxes of the filters, the "Od" fields and the "Do" fields. The buttons
	     "Obrada" and "Štampaj" are at the bottom right of the panel. -->
	<div class="no-border bg-blue-100 rounded-lg">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<div class="grid grid-cols-[11rem_1fr_1fr] gap-x-4 gap-y-1 items-center">
				<!-- Row 1: the range of the broj naloga (it has no checkbox of its own) -->
				<div></div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "odnaloga",
						LabelText:  translator.Label("Od broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "odnaloga",
						Name:       "odnaloga",
						FieldType:  "text",
						Value:      params.OdNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "donaloga",
						LabelText:  translator.Label("Do broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "donaloga",
						Name:       "donaloga",
						FieldType:  "text",
						Value:      params.DoNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "2",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<!-- Row 2: Po datumu naloga with the range of the datuma naloga -->
				@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "3", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddanal",
						LabelText:  translator.Label("Od datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddanal",
						Name:       "oddanal",
						FieldType:  "date",
						Value:      params.OdDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "4"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodanal",
						LabelText:  translator.Label("Do datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodanal",
						Name:       "dodanal",
						FieldType:  "date",
						Value:      params.DoDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "5"})
				</div>
				<!-- Row 3: Po datumu obrade with the range of the datuma obrade -->
				@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "6", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddatob",
						LabelText:  translator.Label("Od datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddatob",
						Name:       "oddatob",
						FieldType:  "date",
						Value:      params.OdDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "7"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodatob",
						LabelText:  translator.Label("Do datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodatob",
						Name:       "dodatob",
						FieldType:  "date",
						Value:      params.DoDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "8"})
				</div>
				<!-- Row 4: Po operateru with the operator (the row has no field in the third column) -->
				@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "9", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oper",
						LabelText:  translator.Label("Operater"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oper",
						Name:       "oper",
						FieldType:  "text",
						Value:      params.Oper,
						Disabled:   !params.ChkOperator,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "20",
						TabIndex:   "10"})
				</div>
				<!-- The buttons of the tab, at the bottom right of the panel (in line with the "Do broja
					     naloga" field of the first column) -->
				<div class="flex items-center justify-end gap-1 mt-auto">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
		</fieldset>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}
