package robno

import (
	"strconv"

	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

// hxValsRobnoDokumentaUnos sends the whole header of the nalog. It is used by the requests of the
// tab (search, paging, reload on the change of the vrsta naloga) so that the typed values of the
// form are kept.
const hxValsRobnoDokumentaUnos = `js:{"tipdok": document.getElementById("tipdok")?.value, ` +
	`"vrd": document.getElementById("vrd")?.value, ` +
	`"magaciniid": document.getElementById("magaciniid")?.value, ` +
	`"nalog": document.getElementById("nalog")?.value, ` +
	`"danal": document.getElementById("danal")?.value, ` +
	`"datob": document.getElementById("datob")?.value, ` +
	`"opis": document.getElementById("opis")?.value}`

// hxValsRobnoDokumentaTipdok is sent when the vrsta naloga changes. The source parameter tells the
// handler to render only the grid (the header of the form is kept) and the hidden #nalog-trigger
// element then asks for the next broj naloga of the new vrsta naloga.
const hxValsRobnoDokumentaTipdok = `js:{"tipdok": document.getElementById("tipdok")?.value, ` +
	`"vrd": document.getElementById("vrd")?.value, ` +
	`"magaciniid": document.getElementById("magaciniid")?.value, ` +
	`"source": "tipdok"}`

// hxValsRobnoDokumentaNalog sends the vrsta naloga and the broj naloga of the header to the check
// of an existing nalog (GET /api/robno-dokumenta/nalog-data).
const hxValsRobnoDokumentaNalog = `js:{"tipdok": document.getElementById("tipdok")?.value, ` +
	`"nalog": document.getElementById("nalog")?.value}`

	// RobnoDokumentaMain renders the "Robna dokumenta" option (robni nalozi / robni dokumenti).
	// The first tab ("Unos dokumenta") is rendered inside the container that the tab navigation
	// replaces with the content of the active tab, like "Robno stanja" and "Robno promet" do.

templ RobnoDokumentaMain(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div id="robno-dokumenta-content" class="bg-blue-100 p-1 flex flex-col h-full">
		@RobnoDokumentaUnos(tabs, subTabs, tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, btnFakture, searchInput, translator)
		<!-- TODO (temporary): the dialog of the "Fakture veleprodaje" screen (RobnoFaktureDialog) is
		     rendered into this element by the "Fakture veleprodaje (preview)" button of the tab. It
		     sits inside the content of the tab, so a reload or a change of the tab closes the
		     dialog. -->
		<div id={ RobnoDokumentaFaktureDialogStagingID } class="top-0 z-50"></div>
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.CloseDialogScript()
	<!-- Scripts of the header of the "Unos dokumenta" tab (the same ones the "Nalozi" screen uses) -->
	@tmpl.HandleNextNalogResponseScript()
	@tmpl.HandleUpdateNalogDataResponseScript()
	@tmpl.HandleTipdokAfterRequestScript()
	@tmpl.HandleDblClickNalogSelectionScript()
	@tmpl.SelectRowScript()
}

// RobnoDokumentaShell renders the tab bar of the option - followed by the sub-tab bar when the
// active tab has sub-tabs - and then the body of the active tab. Every tab uses it so the
// navigation markup stays in one place.
templ RobnoDokumentaShell(tabs, subTabs domain.TabData, translator *i18n.Service, body templ.Component) {
	<div class="bg-blue-100 flex flex-col h-full">
		<!-- Tab navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robna dokumenta"), tabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
		</div>
		<!-- Sub-tab navigation of the active tab (not rendered while it has no sub-tabs) -->
		if len(subTabs.Tabs) > 0 {
			<div class="border-b border-blue-600 pt-1">
				@tmpl.TabNav("", subTabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
			</div>
		}
		<!-- Tab body -->
		<div class="flex-1 min-h-0 flex flex-col gap-1">
			@body
		</div>
	</div>
}

// RobnoDokumentaEmptyBody is the placeholder body of a tab that is not implemented yet: an empty
// parameter box and an empty grid. It is replaced by the real content of the tab as soon as the
// tab is built.
templ RobnoDokumentaEmptyBody(tabLabel string, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters - TODO: parameters of the tab -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-2 gap-1 items-start">
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="p-1 text-sm text-gray-600">{ tabLabel } - TODO</div>
			</fieldset>
		</div>
		<div class="flex justify-end gap-1 pt-2">
			@components.Button(btnObrada)
			@components.Search_PartPrintButton(btnPrint)
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Tab 1 - Unos dokumenta
//
templ RobnoDokumentaUnos(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaUnosForm(tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, btnFakture, searchInput, translator))
}

// RobnoDokumentaUnosForm renders the header of the robni nalog ("Vrsta naloga za knjiženje",
// "Vrsta dokumenta", "Datum obrade", "Broj naloga", "Datum naloga", "Opis knjiženja" i "Magacin"),
// the "Prikaz ukupne obrade" panel and the grid of the nalozi of the selected vrsta naloga.
templ RobnoDokumentaUnosForm(tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Header of the nalog (left) + "Prikaz ukupne obrade" (right). items-stretch makes
	     "Prikaz ukupne obrade" exactly as tall as "Parametri" (the default align-items of a grid). -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2 items-stretch">
			<!-- Header of the nalog -->
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<form id="robno-dokumenta-unos-form" onsubmit="return false;">
					<!-- Next broj naloga of the selected vrsta naloga: fired when the vrsta naloga changes
					     and answered by handleNextNalogResponse, like the "Nalozi" screen -->
					<div
						id="nalog-trigger"
						hx-get="/api/robno-dokumenta/nextnalog"
						hx-trigger="tipdokChanged"
						hx-vals='js:{"tipdok": document.getElementById("tipdok").value}'
						hx-on::after-request="handleNextNalogResponse('robno-dokumenta-unos-form')"
						style="display:none;"
					></div>
					<!-- Vrsta naloga za knjiženje: changing it reloads the grid and, through the trigger
					     above, the broj naloga of the new vrsta naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "tipdok",
							LabelText:  translator.Label("Vrsta naloga za knjiženje"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:               "tipdok",
							Name:             "tipdok",
							HasLabel:         false,
							ClassSelect:      common.ClassInputTextEnabled + " flex-1",
							OptionValues:     tipdokValues,
							SelectedValue:    payload.Tipdok,
							ChangeEndpoint:   "/api/robno-dokumenta/unos",
							HxChangeTarget:   "robno-dokumenta-unos-table",
							HxSwap:           "innerHTML",
							HxVals:           hxValsRobnoDokumentaTipdok,
							HxOnAfterRequest: "handleTipdokAfterRequest",
							TabIndex:         "1",
						}, translator)
					</div>
					<!-- Vrsta dokumenta: TODO: the legacy "+" and "..." buttons next to the combo -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vrd",
							LabelText:  translator.Label("Vrsta dokumenta"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "vrd",
							Name:          "vrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  vrstaDokumentaValues,
							SelectedValue: payload.Vrd,
							TabIndex:      "2",
						}, translator)
					</div>
					<!-- Datum obrade, Broj naloga i Datum naloga in one row. The label of Datum obrade
					     keeps the width of the labels of the other rows, so the fields are aligned. -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datob",
							LabelText:  translator.Label("Datum obrade"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datob",
							Name:       "datob",
							FieldType:  "date",
							Value:      payload.Datob,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
						<!-- Broj naloga: when the user leaves it, the data of an existing nalog is loaded -->
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nalog",
							LabelText:  translator.Label("Broj naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:               "nalog",
							Name:             "nalog",
							FieldType:        "text",
							Value:            payload.Nalog,
							ClassInput:       common.ClassInputTextEnabled + " flex-1 min-w-0",
							HxGet:            "/api/robno-dokumenta/nalog-data",
							HxTrigger:        "blur delay:100ms",
							HxInclude:        "select[name='tipdok']",
							HxVals:           hxValsRobnoDokumentaNalog,
							HxSwap:           "none",
							HxOnAfterRequest: "handleUpdateNalogDataResponse",
							MinLength:        "1",
							MaxLength:        "10",
							TabIndex:         "4",
							OnInput:          "clearFieldError",
							OnFocus:          "clearFieldError"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "danal",
							LabelText:  translator.Label("Datum naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "danal",
							Name:       "danal",
							FieldType:  "date",
							Value:      payload.Danal,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Opis knjiženja -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis knjiženja"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      payload.Opis,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MinLength:  "0",
							MaxLength:  "120",
							TabIndex:   "6"})
					</div>
					<!-- Magacin: TODO: the legacy "+" and "..." buttons next to the combo -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(payload.MagaciniID),
							TabIndex:      "7",
						}, translator)
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 pt-1">
						<!-- TODO (temporary): opens the new "Fakture veleprodaje" screen (RobnoFakture) while the
						     handler of the fakture is not written yet; remove this button together with the
						     robnoDokumentaURLFakturePreview routes of the handler. -->
						@components.Button(btnFakture)
						@components.SaveButton(btnSave, translator)
						@components.AddButton(btnNoviNalog, translator)
					</div>
				</form>
			</fieldset>
			<!-- Prikaz ukupne obrade -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Prikaz ukupne obrade") }</legend>
				@RobnoDokumentaUnosTotalRow("ukupnoNaloga", translator.Label("Ukupno naloga"), total.UkNaloga, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDokumenata", translator.Label("Ukupno dokumenata"), total.UkDokumenata, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoStavki", translator.Label("Ukupno stavki"), total.UkStavki, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDuguje", translator.Label("Duguje"), total.Duguje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoPotrazuje", translator.Label("Potražuje"), total.Potrazuje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoSaldo", translator.Label("Saldo"), total.Saldo, translator)
			</fieldset>
		</div>
	</div>
	<!-- Grid of the nalozi of the selected vrsta naloga -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
	<!-- Staging element of the confirm dialog of the save (like the "Nalozi" screen) -->
	<div id="dialog-confirm" class="top-0 z-50"></div>
}

// RobnoDokumentaUnosTotalRow renders one read only row of the "Prikaz ukupne obrade" panel. The
// value is right aligned and bold, like the numeric cells of the grids.
templ RobnoDokumentaUnosTotalRow(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-[60%]"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right font-bold",
		})
	</div>
}

// magaciniSelection returns the key of the selected magacin ("" when no magacin is selected).
func magaciniSelection(magaciniID int) string {
	if magaciniID <= 0 {
		return ""
	}
	return strconv.Itoa(magaciniID)
}

//
// Tab 2 - Pregled dokumenta (sub-tabs "Štampa" and "eFaktura")
//

// RobnoDokumentaPregled renders the "Štampa" sub-tab of "Pregled dokumenta": the filters (magacin,
// vrsta dokumenta and the range of the dates of the nalog), the buttons "Obradi" and "Štampaj" and
// the grid of the robni dokumenti with the partner of every document.
templ RobnoDokumentaPregled(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPregledBody(tbl, magValues, vrstaDokumentaValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaPregledBody renders the body of the "Štampa" sub-tab. The parameters (left) and the
// "Obrada i štampa" panel (right) have the same height, like the header of the "Unos dokumenta" tab.
templ RobnoDokumentaPregledBody(tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Magacin -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<!-- Vrsta dokumenta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vrd",
							LabelText:  translator.Label("Vrsta dokumenta"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "vrd",
							Name:          "vrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  vrstaDokumentaValues,
							SelectedValue: params.Vrd,
							TabIndex:      "2",
						}, translator)
					</div>
					<!-- Od datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Obrada i štampa") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.PrintButton(btnPrint, translator)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Grid of the documents -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaEFaktura renders the "eFaktura" sub-tab of "Pregled dokumenta": the filters (grupe
// dokumenata and the range of the dates of the documents), the actions of the eFaktura, the date of
// the ažuriranje statusa and the grid with the status of every document.
templ RobnoDokumentaEFaktura(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEFakturaBody(tbl, params, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus, searchInput, translator))
}

// RobnoDokumentaEFakturaBody renders the body of the "eFaktura" sub-tab. The parameters with the
// actions (left) and the "Status eFaktura" panel (right) have the same height, like the header of
// the "Unos dokumenta" tab.
templ RobnoDokumentaEFakturaBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters and actions -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- Grupe dokumenata -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "grupedokumenata",
						LabelText:  translator.Label("Grupe dokumenata"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "grupedokumenata",
						Name:       "grupedokumenata",
						FieldType:  "text",
						Value:      params.GrupeDokumenata,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "120",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Od datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- Obrada and the actions of the eFaktura -->
				<div class="flex flex-wrap items-center justify-end gap-1 mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnPosalji)
					@components.Button(btnProveri)
					@components.Button(btnStornirajPE)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Status eFaktura") }</legend>
				<!-- Datum za ažuriranje statusa -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "datumstatusa",
						LabelText:  translator.Label("Datum za ažuriranje statusa"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "datumstatusa",
						Name:       "datumstatusa",
						FieldType:  "date",
						Value:      params.DatumStatusa,
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "4"})
				</div>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.Button(btnOtkazi)
					@components.Button(btnStorniraj)
					@components.Button(btnAzurirajStatus)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Grid of the documents with their eFaktura status -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Tabs that are still empty
//

// Tab 3 - Specifikacije dokumenta
templ RobnoDokumentaSpecifikacije(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEmptyBody("Specifikacije dokumenta", tbl, btnObrada, btnPrint, searchInput, translator))
}

//
// Tab 4 - Kontiranje dokumenata (sub-tabs "Knjiženje dokumenata", "Pregled proknjiženih /
// neproknjiženih dokumenata" and "Pregled proknjiženih / neproknjiženih dokumenata po magacinima")
//

// RobnoDokumentaKontiranjeKnjizenje renders the "Knjiženje dokumenata" sub-tab of "Kontiranje
// dokumentata": the parameters of the selection of the documents (vrsta naloga za knjiženje, vrsta
// dokumenta, magacin and the ranges of the broj naloga, the broj dokumenta and the datum naloga),
// the buttons of the posting ("Obrada", "Proveri ravnotežu" and "Knjiži") and the grid of the robni
// dokumenti.
templ RobnoDokumentaKontiranjeKnjizenje(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjeKnjizenjeBody(tbl, tipdokValues, vrstaDokumentaValues, magValues, params, btnObrada, btnRavnoteza, btnKnjizi, searchInput, translator))
}

// RobnoDokumentaKontiranjeKnjizenjeBody renders the body of the "Knjiženje dokumenata" sub-tab. The
// parameters (left) and the "Knjiženje" panel with the buttons (right) have the same height, like
// the header of the "Unos dokumenta" tab.
templ RobnoDokumentaKontiranjeKnjizenjeBody(tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "vrd",
								Name:          "vrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  vrstaDokumentaValues,
								SelectedValue: params.Vrd,
								TabIndex:      "2",
							}, translator)
						</div>
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Knjiženje") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnRavnoteza)
					@components.Button(btnKnjizi)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Grid of the robni dokumenti of the selection -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePregled renders the "Pregled proknjiženih / neproknjiženih dokumenata"
// sub-tab of "Kontiranje dokumenata": the parameters of the selection, the state of the posting
// (the radio buttons "Proknjiženi dokumenti" / "Neproknjiženi dokumenti" and the checkbox that
// marks the displayed documents as not posted) and the grid of the robni dokumenti.
templ RobnoDokumentaKontiranjePregled(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePregledBody(tbl, tipdokValues, magValues, params, btnObrada, btnOznaci, searchInput, translator))
}

// RobnoDokumentaKontiranjePregledBody renders the body of the "Pregled proknjiženih /
// neproknjiženih dokumenata" sub-tab.
templ RobnoDokumentaKontiranjePregledBody(tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "2",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "3", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "4", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "5", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "6", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "7", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "8", translator)
					</div>
				</div>
				<!-- State of the posting: the radio buttons "Proknjiženi / Neproknjiženi dokumenti" and the
				     checkbox that marks the displayed documents as not posted, in one row -->
				<div class="flex flex-wrap items-center gap-3 pl-44 mb-1">
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "proknjizeni",
						Name:        "proknjizen",
						LabelText:   "Proknjiženi dokumenti",
						Value:       "D",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "D",
						TabIndex:    "9",
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "neproknjizeni",
						Name:        "proknjizen",
						LabelText:   "Neproknjiženi dokumenti",
						Value:       "N",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "N",
						TabIndex:    "10",
					}, translator)
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "oznacineproknjizenim",
						Name:              "oznacineproknjizenim",
						LabelText:         "Označi prikazana dokumenta kao neproknjižena",
						ClassLabel:        common.ClassCheckboxLabel,
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
						IsChecked:         params.OznaciNeproknjizenim,
					}, translator)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnOznaci)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Grid of the robni dokumenti of the selection -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePoMagacinima renders the "Pregled proknjiženih / neproknjiženih
// dokumenata po magacinima" sub-tab of "Kontiranje dokumenata": the same filters as the previous
// sub-tab without the vrsta naloga (the grid is grouped by the magacin of the document).
templ RobnoDokumentaKontiranjePoMagacinima(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePoMagacinimaBody(tbl, magValues, params, btnObrada, searchInput, translator))
}

// RobnoDokumentaKontiranjePoMagacinimaBody renders the body of the "Pregled ... po magacinima"
// sub-tab.
templ RobnoDokumentaKontiranjePoMagacinimaBody(tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the magacin and the radios) takes the free space, the ranges and the dates
				     are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- State of the posting: proknjiženi / neproknjiženi dokumenti -->
						<div class="flex flex-wrap items-center gap-2 pt-1">
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "proknjizeni",
								Name:        "proknjizen",
								LabelText:   "Proknjiženi dokumenti",
								Value:       "D",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "D",
								TabIndex:    "2",
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "neproknjizeni",
								Name:        "proknjizen",
								LabelText:   "Neproknjiženi dokumenti",
								Value:       "N",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "N",
								TabIndex:    "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The button is aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Grid of the robni dokumenti of the selection, grouped by magacin -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaRangeField renders one "Od/Do broja ..." range of the "Kontiranje dokumenata" tab
// (a whole number typed as text).
templ RobnoDokumentaRangeField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "text",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
			MaxLength:  "9",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// RobnoDokumentaDateField renders one "Od/Do datuma naloga" date of the "Kontiranje dokumenata" tab.
templ RobnoDokumentaDateField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "date",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-32",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// Tab 5 - Prepis dokumenta
templ RobnoDokumentaPrepis(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEmptyBody("Prepis dokumenta", tbl, btnObrada, btnPrint, searchInput, translator))
}

// Tab 6 - Prikaz ukupne obrade
//
// The tab has no parameters of the selection and no "Obrada" button: it shows the totals of the
// robni nalozi of every magacin of the current period (the "Prikaz ukupne obrade" panel of the
// first tab, per magacin) and the print button of the list in the toolbar of the grid.
templ RobnoDokumentaPrikazUkupneObrade(tabs, subTabs domain.TabData, tbl domain.TableData, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazUkupneObradeBody(tbl, translator))
}

// RobnoDokumentaPrikazUkupneObradeBody renders the body of the "Prikaz ukupne obrade" tab: the grid
// with the totals. The search input is not rendered (the tab has no parameters), only the title and
// the print button of the toolbar of the grid (tbl.BtnPrint).
templ RobnoDokumentaPrikazUkupneObradeBody(tbl domain.TableData, translator *i18n.Service) {
	<!-- Grid of the totals of the robni nalozi of every magacin -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, domain.InputControl{})
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 7 - Prikaz naloga
//
// The tab shows the robni nalozi of the current period filtered by magacin, the range of the vrste
// naloga and the range of the broj naloga. The three checkboxes ("Po datumu naloga", "Po datumu
// obrade" and "Po operateru") enable their fields when they are checked (controlToggle of
// EnableDisableFieldsScripts, like "Prikaz kartice artikla" of the robno kartica does).
templ RobnoDokumentaPrikazNaloga(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, translator))
	@tmpl.EnableDisableFieldsScripts()
}

// RobnoDokumentaParametriNalogaBody renders the body of the tabs that select robni nalozi ("Prikaz
// naloga" and "Prikaz dokumenata u nalogu"): the parameters of the selection (the only panel of the
// tab - the buttons "Obrada" and "Štampaj" are in the row of the "Po operateru" checkbox, aligned
// to the right) and the grid of the tab (the columns come from the table of the tab). Every checkbox
// is in the same row as the fields it enables.
templ RobnoDokumentaParametriNalogaBody(tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab): the fields of the nalog in the first
	     third of the panel and, in the other two thirds, every checkbox with the fields it enables in
	     one row. The buttons "Obrada" and "Štampaj" are at the bottom right of the panel. -->
	<div class="no-border bg-blue-100 rounded-lg">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<!-- The rows of the second column are one below the other (mb-2) and the free space of every
			     row is distributed between its controls (justify-between); the date fields are kept
			     narrow (w-40) so that there is enough space between the controls. -->
			<div class="grid grid-cols-3 gap-x-2">
				<!-- Magacin, the range of the vrste naloga and the range of the broj naloga -->
				<div class="flex flex-col">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odvrd",
							LabelText:  translator.Label("Od vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "odvrd",
							Name:          "odvrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.OdVrd,
							TabIndex:      "2",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dovrd",
							LabelText:  translator.Label("Do vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "dovrd",
							Name:          "dovrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.DoVrd,
							TabIndex:      "3",
						}, translator)
					</div>
					<!-- Od broja naloga (the label has the width of the labels of the fields above) -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odnaloga",
							LabelText:  translator.Label("Od broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odnaloga",
							Name:       "odnaloga",
							FieldType:  "text",
							Value:      params.OdNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do broja naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "donaloga",
							LabelText:  translator.Label("Do broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "donaloga",
							Name:       "donaloga",
							FieldType:  "text",
							Value:      params.DoNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- The checkbox of every filter with the fields it enables, in one row -->
				<div class="col-span-2 flex flex-col">
					<!-- Po datumu naloga -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "6", translator)
						<!-- The controls of the row start right after the checkbox (flex-1 wrapper), so the
						     labels of all the rows are aligned one below the other. Every label stays with
						     its own field (as in the first column), so the fields of rows 1-3 all start at
						     the same x -->
						<div class="flex-1 flex items-center justify-between gap-1">
						<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma naloga"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							Disabled:   !params.ChkDatumNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-40",
							TabIndex:   "7"})
						</div>
						<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma naloga"),
							ClassLabel: common.ClassLabel + " w-32 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							Disabled:   !params.ChkDatumNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-40",
							TabIndex:   "8"})
						</div>
						</div>
					</div>
					<!-- Po datumu obrade -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "9", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
						<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddatob",
							LabelText:  translator.Label("Od datuma obrade"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddatob",
							Name:       "oddatob",
							FieldType:  "date",
							Value:      params.OdDatob,
							Disabled:   !params.ChkDatumObrade,
							ClassInput: common.ClassInputTextEnabled + " !w-40",
							TabIndex:   "10"})
						</div>
						<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodatob",
							LabelText:  translator.Label("Do datuma obrade"),
							ClassLabel: common.ClassLabel + " w-32 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodatob",
							Name:       "dodatob",
							FieldType:  "date",
							Value:      params.DoDatob,
							Disabled:   !params.ChkDatumObrade,
							ClassInput: common.ClassInputTextEnabled + " !w-40",
							TabIndex:   "11"})
						</div>
						</div>
					</div>
					<!-- Po operateru: the checkbox and the operator, in the third row of the panel, so the
					     operator control is in line with the "Do vrste naloga" combo box of the first
					     column (that row has the same height and spacing as the rows of the first column). -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "12", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oper",
							LabelText:  translator.Label("Operater"),
							ClassLabel: common.ClassLabel + " w-32",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oper",
							Name:       "oper",
							FieldType:  "text",
							Value:      params.Oper,
							Disabled:   !params.ChkOperator,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MaxLength:  "20",
							TabIndex:   "13"})
						</div>
					</div>
					<!-- The buttons of the tab, at the bottom right of the panel (in line with the "Do broja
					     naloga" field of the first column) -->
					<div class="flex items-center justify-end gap-1 mt-auto">
						@components.FormObradaButton(btnObrada, translator)
						@components.PrintButton(btnPrint, translator)
					</div>
				</div>
			</div>
		</fieldset>
	</div>
	<!-- Grid of the selected robni nalozi (or of their documents) -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, domain.InputControl{})
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaCheckBox renders one of the checkboxes of the "Prikaz naloga" tab that enable the
// fields of a filter (the same pattern as "Prikaz kartice artikla": controlToggle switches the
// disabled state of the fields listed in the JSON array of the onchange handler).
templ RobnoDokumentaCheckBox(id, labelText, fields string, isChecked bool, tabIndex string, translator *i18n.Service) {
	<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0 h-8 sm:h-7 md:h-6" }>
		<input
			type="checkbox"
			id={ id }
			name={ id }
			class={ common.ClassCheckbox }
			tabindex={ tabIndex }
			if isChecked {
				checked="checked"
			}
			onchange={ templ.JSFuncCall("controlToggle", templ.JSExpression("this"), templ.JSExpression(fields)) }
		/>
		<span class={ common.ClassCheckboxSpan }>{ translator.Label(labelText) }</span>
	</label>
}

// Tab 8 - Prikaz dokumenata u nalogu
//
// The tab shows the robni dokumenti of the selected nalozi: it uses the same parameters and the
// same layout as the "Prikaz naloga" tab (the body of the two tabs is shared), only the columns of
// its grid differ.
templ RobnoDokumentaPrikazDokumenataUNalogu(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, translator))
	@tmpl.EnableDisableFieldsScripts()
}

// Tab 9 - Prikaz dokumenata po operateru
//
// The tab shows the same robni dokumenti as the "Prikaz dokumenata u nalogu" tab, grouped by the
// operater. Its panel has no magacin / vrsta naloga selection (the legacy screen of the tab has none
// either): the parameters are shown in three columns, like the legacy screen draws them (the
// checkboxes of the filters, the "Od" fields and the "Do" fields).
templ RobnoDokumentaPrikazDokumenataPooperateru(tabs, subTabs domain.TabData, tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazDokumenataPooperateruBody(tbl, params, btnObrada, btnPrint, translator))
	@tmpl.EnableDisableFieldsScripts()
}

// RobnoDokumentaPrikazDokumenataPooperateruBody renders the body of the "Prikaz dokumenata po
// operateru" tab: the parameters of the selection (the only panel of the tab) and the grid. The
// panel of this tab is the same as the one of the two tabs before it but without the magacin and the
// vrsta naloga controls (magaciniid, odvrd and dovrd are not part of its parameters) and with its
// controls in the three columns of the legacy screen (the checkboxes, the "Od" fields and the "Do"
// fields); every checkbox enables its own fields (the dates and the operater), like the other tabs.
templ RobnoDokumentaPrikazDokumenataPooperateruBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab) in the three columns of the legacy
	     screen: the checkboxes of the filters, the "Od" fields and the "Do" fields. The buttons
	     "Obrada" and "Štampaj" are at the bottom right of the panel. -->
	<div class="no-border bg-blue-100 rounded-lg">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<div class="grid grid-cols-[11rem_1fr_1fr] gap-x-4 gap-y-1 items-center">
				<!-- Row 1: the range of the broj naloga (it has no checkbox of its own) -->
				<div></div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "odnaloga",
						LabelText:  translator.Label("Od broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "odnaloga",
						Name:       "odnaloga",
						FieldType:  "text",
						Value:      params.OdNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "donaloga",
						LabelText:  translator.Label("Do broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "donaloga",
						Name:       "donaloga",
						FieldType:  "text",
						Value:      params.DoNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "2",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<!-- Row 2: Po datumu naloga with the range of the datuma naloga -->
				@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "3", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddanal",
						LabelText:  translator.Label("Od datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddanal",
						Name:       "oddanal",
						FieldType:  "date",
						Value:      params.OdDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "4"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodanal",
						LabelText:  translator.Label("Do datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodanal",
						Name:       "dodanal",
						FieldType:  "date",
						Value:      params.DoDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "5"})
				</div>
				<!-- Row 3: Po datumu obrade with the range of the datuma obrade -->
				@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "6", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddatob",
						LabelText:  translator.Label("Od datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddatob",
						Name:       "oddatob",
						FieldType:  "date",
						Value:      params.OdDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "7"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodatob",
						LabelText:  translator.Label("Do datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodatob",
						Name:       "dodatob",
						FieldType:  "date",
						Value:      params.DoDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "8"})
				</div>
				<!-- Row 4: Po operateru with the operator (the row has no field in the third column) -->
				@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "9", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oper",
						LabelText:  translator.Label("Operater"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oper",
						Name:       "oper",
						FieldType:  "text",
						Value:      params.Oper,
						Disabled:   !params.ChkOperator,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "20",
						TabIndex:   "10"})
				</div>
			</div>
			<!-- The buttons of the tab, at the bottom right of the panel -->
			<div class="flex items-center justify-end gap-1 mt-auto">
				@components.FormObradaButton(btnObrada, translator)
				@components.PrintButton(btnPrint, translator)
			</div>
		</fieldset>
	</div>
	<!-- Grid of the documents of the selection -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.Search_Part(tbl, domain.InputControl{})
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the tab -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Fakture veleprodaje - the header of the faktura and its stavke
//
// The two WinDev windows of the option ("Fakture veleprodaje" and "Fakture veleprodaje - stavke") are
// rendered as two collapsible controls (<details>/<summary>): the header of the faktura in the first
// control and its stavke in the second one. Only one of the two controls is editable at a time:
//   - while the header is not saved (RobnoFaktureHeader.Snimljen is false) the header is editable and
//     the stavke control is closed, disabled and cannot even be opened,
//   - after a successful save the header is locked and the stavke become available,
//   - the "Izmeni" button of the header locks the stavke again and unlocks the header.
// The initial state is rendered by the server (RobnoFaktureHeader.Snimljen) and the state is switched
// by robnoFaktureSetMode (RobnoFaktureScript) after the save, so a reload of the tab and a save leave
// the screen in the same state.
//
// TODO: the handler and the routes of the screen are not written yet; the URLs below are the ones the
// screen will use (the prefix of the other tabs of "Robna dokumenta").
const (
	robnoFaktureURL           = "/api/robno-dokumenta/fakture"
	robnoFaktureSaveURL       = robnoFaktureURL + "/save"
	robnoFaktureNoviURL       = robnoFaktureURL + "/novi"
	robnoFaktureDeleteURL     = robnoFaktureURL + "/brisi"
	robnoFaktureStavkaSaveURL = robnoFaktureURL + "/stavka/save"
	robnoFaktureStavkaDelURL  = robnoFaktureURL + "/stavka/brisi"
	robnoFaktureArtikalSearch = "/api/promet/searchbutton"
	robnoFakturePartnerSearch = "/api/partneri/searchbutton"

	// Ids of the two collapsible controls. They are given to the script (see RobnoFaktureScript) so
	// that every id is written in one place only.
	robnoFaktureHeaderPanelID = "robno-fakture-header-panel"
	robnoFaktureStavkePanelID = "robno-fakture-stavke-panel"

	// RobnoDokumentaFaktureDialogStagingID is the element of the "Unos dokumenta" tab (see
	// RobnoDokumentaMain) the dialog of the "Fakture veleprodaje" screen is rendered into and
	// RobnoFaktureDialogID the id of the dialog itself (the one closeDialog hides). Both are exported
	// because the handler of the tab builds the button that opens the dialog (its hx-target is the
	// staging element) and the "Zatvori" button of the dialog (its IdDialog is the dialog id).
	RobnoDokumentaFaktureDialogStagingID = "robno-fakture-dialog-staging"
	RobnoFaktureDialogID                 = "robno-fakture-dialog"

	// robnoFaktureContentID is the container the tab navigation swaps (see RobnoDokumentaShell); it is
	// the target of the buttons that reload the whole screen.
	robnoFaktureContentID = "#robno-dokumenta-content"
)

// RobnoFaktureHeader holds the values of the header of the faktura (the first window). The values are
// the ones the handler reads from the form (all strings, the handler formats the numbers), so the
// template only lays them out.
type RobnoFaktureHeader struct {
	// Snimljen tells whether the header is saved: while it is false the header is editable and the
	// stavke control is disabled, afterwards the other way round.
	Snimljen bool

	// Nalog (the read only strip at the top of both windows).
	VrNal, Nalog, DatumNaloga, UkDokum, UkStavki, Duguje, Potrazuje, IznosDokum, Magacin string

	// Otpremnica / Račun and "Štampaj detalje u stavkama".
	Otpremnica     bool
	StampajDetalje bool

	// Podaci o dokumentu.
	Vrd, Brdok, DatumFakturisanja, BrdokOrg, DatumIzvora, Opis string
	ZaPeriod                                                   bool
	PeriodOd, PeriodDo, DatumSmanjenja                         string

	// Podaci o kupcu.
	KupacKonto, KupacSifra, KupacNaziv, KupacAdresa string
	KupacPostanskiBroj, KupacMesto, KupacPib         string
	SistemPdv                                        string

	// Podaci o načinu otpreme, rokovima, valuti i avansima.
	Valuta, Kurs, VaziZa, BrojRata, DatumPrveRate, IznosFakture string
	UsloviPlacanja, Rok, Dospeva                                 string
	BrojUgovora, Narudzbenica, IzvoRacun, NacinOtpreme           string
	RegBr, Vozac, Teret, BrutoTezina                             string
	BrojKutija, NetoTezina, BrojPaleta, IzvozIzjava              string
	BankaUplatu, Popdv, IzvozniDokument                          string

	// Podaci o porezom oslobođenju, nastanku PDV obaveze.
	PbrKategorija, NapomenaPoresko, RbrPdv string
	MestoTroska, MestoIsporuke, Komercijalista string
	PostanskiBroj, IfBroj                   string
	JavnaNabavka                           bool
	BjkosNosilac, BrojTendera, Kst          string

	// Finansijsko stanje kupca (realizovano / planirano / reprogramirano and the saldo columns).
	Realizovana, Planirana, Reproknjizena, Ukupno string
	Saldo, Dospeo, ReproDospeo, SaldoDospeo       string
}

// RobnoFaktureStavka holds the values of the entry form of one stavka (the second window). The first
// group of fields is read only: it repeats the kupac and the podaci o dokumentu of the header.
type RobnoFaktureStavka struct {
	KontoMagacina, KontoKupca, Vrd, Brdok, DatumDokumenta string

	SifraArtikla, SifraArtiklaNaziv string
	JM, Stanje                       string
	Tarifa, Dani                     string
	Kolicina, Iznos                  string
	ProdajnaCena, MagacinskaCena     string
	Rabat, IznosRabata               string
	NabavnaCena, NetoProdajnaCena    string
	Deklaracije, BarKod, Serija, Rok string

	// "Zadnja cena po kojoj je kupac kupovao ovaj artikal".
	ZadnjaCena, ZadnjiRabat, ZadnjiDatum string
	KoristiPoslednjiRabat                bool
}

// RobnoFaktureButtons groups the buttons of the screen so that the signature of the template stays
// short: the header and the stavke have their own save/delete buttons.
type RobnoFaktureButtons struct {
	Save   domain.Button // "Sačuvaj" the header of the faktura
	Modify domain.Button // "Izmeni" the header (unlocks the header, locks the stavke)
	New    domain.Button // "Novi dok."
	Delete domain.Button // "Briši" the document
	Back   domain.Button // "Nazad"

	SaveStavka   domain.Button
	ModifyStavka domain.Button
	DeleteStavka domain.Button
}

// RobnoFakture renders the "Fakture veleprodaje" screen: the two collapsible controls inside the shell
// of "Robna dokumenta" (tabs and sub-tabs) and the script that switches the editable control.
templ RobnoFakture(tabs, subTabs domain.TabData, tbl, avansiTbl domain.TableData, header RobnoFaktureHeader, stavka RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues []domain.ComboItem, btns RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoFaktureBody(tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, btns, searchInput, translator))
	<!-- Scripts the screen shares with the other robno forms: the search popups (F3 / "...") and the
	     inline validation errors -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@RobnoFaktureScript()
}

// RobnoFaktureDialog renders the "Fakture veleprodaje" screen inside a modal dialog: the same content
// as RobnoFakture without the tab bar of the option (the dialog covers the tab, which stays open
// behind it) plus the title bar with the "Zatvori" button. It is the response of the "Fakture
// veleprodaje (preview)" button of the "Unos dokumenta" tab, swapped into the
// RobnoDokumentaFaktureDialogStagingID element (see RobnoDokumentaMain). The dialog is not removed when
// it is closed (closeDialog only hides it, so that the fade-out is visible): the next request renders
// it again.
templ RobnoFaktureDialog(tbl, avansiTbl domain.TableData, header RobnoFaktureHeader, stavka RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues []domain.ComboItem, btns RobnoFaktureButtons, btnClose domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div id={ RobnoFaktureDialogID } class={ common.ClassMainDialogDiv }>
		<div class="bg-blue-100 rounded-lg shadow-2xl flex flex-col w-[95vw] h-[90vh]">
			<!-- Title bar of the dialog -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg flex-shrink-0">
				<h2 class="text-lg font-semibold ml-4">{ translator.Label("Fakture veleprodaje") }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- Content: the strip of the vrsta fakture, the collapsible control of the header and the
			     collapsible control of the stavke -->
			<div class="flex-1 min-h-0 overflow-auto p-1">
				@RobnoFaktureBody(tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, btns, searchInput, translator)
			</div>
		</div>
	</div>
	@RobnoFaktureScript()
	<!-- The scripts the tab installs for the screen (the dialog is rendered on its own, so it has to
	     install them itself) -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
}

// RobnoFaktureBody renders the content of the screen: the strip with the vrsta fakture, the first
// collapsible control (the header of the faktura) and the second one (the stavke).
templ RobnoFaktureBody(tbl, avansiTbl domain.TableData, header RobnoFaktureHeader, stavka RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues []domain.ComboItem, btns RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0">
		@RobnoFaktureDokumentBar(header, btns.Back, translator)
		@RobnoFaktureHeaderPanel(header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, btns, translator)
		@RobnoFaktureStavkePanel(tbl, header, stavka, btns, searchInput, translator)
	</div>
}

// RobnoFakturePanel is one of the two collapsible controls of the screen: a <details> element whose
// <summary> is the title bar. While the control is disabled its fields are not editable and its
// summary does not open it, so the user can see and change only the control that is currently active.
// The fields and the buttons are two slots: the script disables the controls of [data-panel-fields]
// only, so the buttons of the control (e.g. "Izmeni" of the header) stay clickable even when the
// control itself is locked. The fields of a disabled control carry the inert attribute, so they cannot
// be reached with the mouse or with the keyboard either.
templ RobnoFakturePanel(id, title, stateText string, open, enabled bool, fields, buttons templ.Component) {
	<details
		id={ id }
		open?={ open }
		data-enabled={ robnoFaktureState(enabled) }
		class="group w-full rounded-lg border border-blue-400 bg-blue-100"
	>
		<summary
			onclick="return robnoFaktureCanToggle(this)"
			class="px-2 py-1 cursor-pointer select-none flex items-center gap-1 bg-blue-200 rounded-t-lg font-semibold text-sm text-blue-900"
		>
			<span class="text-blue-700 transition-transform group-open:rotate-90">&#9654;</span>
			{ title }
			<span class="ml-auto font-normal text-xs text-blue-800">{ stateText }</span>
		</summary>
		<div class="p-1 flex flex-col gap-1">
			<div data-panel-fields inert?={ !enabled } class={ robnoFaktureFieldsClass(enabled) }>
				@fields
			</div>
			<div class="flex items-center justify-end gap-1">
				@buttons
			</div>
		</div>
	</details>
}

// RobnoFaktureDokumentBar renders the strip above the two controls: the vrsta fakture (Otpremnica /
// Račun) with the checkbox "Štampaj detalje u stavkama" and the "Nazad" button, like the blue bar of
// the two WinDev windows. The radios are disabled while the header is saved (they belong to the
// header), the checkbox too.
templ RobnoFaktureDokumentBar(header RobnoFaktureHeader, btnBack domain.Button, translator *i18n.Service) {
	<div class="flex items-center gap-2 border border-blue-400 bg-blue-100 rounded-lg px-1 py-0.5">
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="otpremnica"
				value="O"
				class={ common.ClassCheckbox }
				checked?={ header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-24" }>{ translator.Label("Otpremnica") }</span>
		</label>
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="racun"
				value="R"
				class={ common.ClassCheckbox }
				checked?={ !header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-16" }>{ translator.Label("Račun") }</span>
		</label>
		<div class="flex-1 flex justify-center">
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "stampajdetalje",
				Name:              "stampajdetalje",
				LabelText:         translator.Label("Štampaj detalje u stavkama"),
				ClassLabel:        common.ClassLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: "text-sm",
				IsChecked:         header.StampajDetalje,
				Disabled:          header.Snimljen,
				TabIndex:          "0"}, translator)
		</div>
		@components.Button(btnBack)
	</div>
}

// RobnoFaktureHeaderPanel renders the first collapsible control: the header of the faktura, i.e. the
// strip of the nalog, the podaci o dokumentu, the podaci o kupcu, the podaci o načinu otpreme / rokovima
// / valuti, the podaci o porezom oslobođenju, the finansijsko stanje kupca and the grid of the avansi.
// The values of the fields that are not in the form yet are documented with a TODO (the same fields
// the legacy windows read from the tables the robna dokumenta tabs do not show).
templ RobnoFaktureHeaderPanel(header RobnoFaktureHeader, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues []domain.ComboItem, btns RobnoFaktureButtons, translator *i18n.Service) {
	@RobnoFakturePanel(robnoFaktureHeaderPanelID, translator.Label("Podaci o fakturi"), robnoFaktureHeaderStateText(header.Snimljen, translator), !header.Snimljen, !header.Snimljen, RobnoFaktureHeaderFields(header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, translator), RobnoFaktureHeaderButtons(btns))
}

// RobnoFaktureHeaderFields is the body of the header control: the strip of the nalog, the panels of
// the header (podaci o dokumentu, kupac, način otpreme / rokovi / valuta, poresko oslobođenje,
// finansijsko stanje kupca) and the grid of the avansi. The buttons of the control are rendered by
// RobnoFaktureHeaderButtons, outside of the fields the script disables.
templ RobnoFaktureHeaderFields(header RobnoFaktureHeader, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues []domain.ComboItem, translator *i18n.Service) {
	<!-- Nalog: the read only strip both windows show above the form -->
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Nalog") }</legend>
		<div class="grid grid-cols-5 gap-x-2 gap-y-1">
			@RobnoFaktureReadOnly("vrnal", translator.Label("Vr. nal."), header.VrNal, translator)
			@RobnoFaktureReadOnly("nalog", translator.Label("Nalog"), header.Nalog, translator)
			@RobnoFaktureReadOnly("datumnaloga", translator.Label("Datum naloga"), header.DatumNaloga, translator)
			@RobnoFaktureReadOnly("ukdokum", translator.Label("Uk. dokum."), header.UkDokum, translator)
			@RobnoFaktureReadOnly("ukstavki", translator.Label("Uk. stavki"), header.UkStavki, translator)
			@RobnoFaktureReadOnly("duguje", translator.Label("Duguje"), header.Duguje, translator)
			@RobnoFaktureReadOnly("potrazuje", translator.Label("Potražuje"), header.Potrazuje, translator)
			@RobnoFaktureReadOnly("iznosdokum", translator.Label("Iznos dokum."), header.IznosDokum, translator)
			@RobnoFaktureReadOnly("magacin", translator.Label("Magacin"), header.Magacin, translator)
		</div>
	</fieldset>
	<!-- Podaci o dokumentu -->
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
		<div class="grid grid-cols-3 gap-x-2 gap-y-1">
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "vrd",
					LabelText:  translator.Label("Vrsta dokumenta"),
					ClassLabel: common.ClassLabel + " w-36",
				})
				@components.ComboBoxField(domain.ComboFieldConfig{
					ID:            "vrd",
					Name:          "vrd",
					HasLabel:      false,
					Disabled:      header.Snimljen,
					ClassSelect:   robnoFaktureControlClass(!header.Snimljen, "flex-1"),
					OptionValues:  vrstaDokumentaValues,
					SelectedValue: header.Vrd,
					TabIndex:      "1"}, translator)
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "brdok",
					LabelText:  translator.Label("Broj dokumenta"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "brdok",
					Name:       "brdok",
					FieldType:  "text",
					Value:      header.Brdok,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					MaxLength:  "10",
					TabIndex:   "2",
					OnInput:    "clearFieldError",
					OnFocus:    "clearFieldError"})
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "datumfakturisanja",
					LabelText:  translator.Label("Datum fakturisanja"),
					ClassLabel: common.ClassLabel + " w-36",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "datumfakturisanja",
					Name:       "datumfakturisanja",
					FieldType:  "date",
					Value:      header.DatumFakturisanja,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					TabIndex:   "3",
					OnInput:    "clearFieldError",
					OnFocus:    "clearFieldError"})
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "brdokorg",
					LabelText:  translator.Label("Broj org. dokumenta"),
					ClassLabel: common.ClassLabel + " w-36",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "brdokorg",
					Name:       "brdokorg",
					FieldType:  "text",
					Value:      header.BrdokOrg,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					MaxLength:  "20",
					TabIndex:   "4"})
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "datumizvora",
					LabelText:  translator.Label("Datum izvor. dokum."),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "datumizvora",
					Name:       "datumizvora",
					FieldType:  "date",
					Value:      header.DatumIzvora,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					TabIndex:   "5"})
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "datumsmanjenja",
					LabelText:  translator.Label("Datum smanjenja"),
					ClassLabel: common.ClassLabel + " w-36",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "datumsmanjenja",
					Name:       "datumsmanjenja",
					FieldType:  "date",
					Value:      header.DatumSmanjenja,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					TabIndex:   "6"})
			</div>
			<!-- OPIS: it takes the place of the first two columns of the row -->
			<div class="col-span-2 flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "opis",
					LabelText:  translator.Label("Opis"),
					ClassLabel: common.ClassLabel + " w-36",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "opis",
					Name:       "opis",
					FieldType:  "text",
					Value:      header.Opis,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					MaxLength:  "120",
					TabIndex:   "7"})
			</div>
			<!-- Za period od / do: the checkbox enables the two dates -->
			<div class="flex items-center gap-1">
				@components.CheckboxField(domain.CheckboxFieldConfig{
					ID:                "zaperiod",
					Name:              "zaperiod",
					LabelText:         translator.Label("Za period od / do"),
					ClassLabel:        common.ClassLabel,
					ClassCheckbox:     common.ClassCheckbox,
					ClassCheckboxSpan: "text-sm",
					IsChecked:         header.ZaPeriod,
					Disabled:          header.Snimljen,
					TabIndex:          "8"}, translator)
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "periodod",
					Name:       "periodod",
					FieldType:  "date",
					Value:      header.PeriodOd,
					Disabled:   !header.ZaPeriod || header.Snimljen,
					ClassInput: robnoFaktureControlClass(header.ZaPeriod && !header.Snimljen, "flex-1 min-w-0"),
					TabIndex:   "9"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "perioddo",
					Name:       "perioddo",
					FieldType:  "date",
					Value:      header.PeriodDo,
					Disabled:   !header.ZaPeriod || header.Snimljen,
					ClassInput: robnoFaktureControlClass(header.ZaPeriod && !header.Snimljen, "flex-1 min-w-0"),
					TabIndex:   "10"})
			</div>
		</div>
	</fieldset>
	<!-- Podaci o kupcu -->
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o kupcu") }</legend>
		<div class="grid grid-cols-2 gap-x-2 gap-y-1">
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "kupackonto",
					LabelText:  translator.Label("Konto kupca"),
					ClassLabel: common.ClassLabel + " w-32",
				})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "kupackonto",
					Name:       "kupackonto",
					FieldType:  "text",
					Value:      header.KupacKonto,
					Disabled:   header.Snimljen,
					ClassInput: robnoFaktureControlClass(!header.Snimljen, "flex-1 min-w-0"),
					MaxLength:  "10",
					TabIndex:   "11"})
				@components.SearchButton(domain.SearchButtonConfig{ID: "kupackonto", Name: "search-kupackonto", HxUrl: robnoFakturePartnerSearch, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "kupackonto"}`, ClassButton: common.ClassButton})
			</div>
			<div class="flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{
					ID:         "kupacsifra",
					LabelText:  translator.Label("Analitička šifra"),
					ClassLabel: common.ClassLabel + " w-32",
				})
