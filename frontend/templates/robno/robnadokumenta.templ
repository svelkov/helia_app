package robno

import (
	"strconv"
	"time"

	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

// RobnoDokumentaMain renders the "Robna dokumenta" option (robni nalozi / robni dokumenti).
// The first tab ("Unos dokumenta") is rendered inside the container that the tab navigation
templ RobnoDokumentaMain(ui domain.RobnoFaktureUI, hxValsTipdok, hxValsNalog string, tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div id="robno-dokumenta-content" class="flex flex-col h-full">
		@RobnoDokumentaUnos(hxValsTipdok, hxValsNalog, tabs, subTabs, tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, btnFakture, searchInput, translator)
		<!-- TODO (temporary): the dialog of the "Fakture veleprodaje" screen (RobnoFaktureDialog) is
		     rendered into this element by the "Fakture veleprodaje (preview)" button of the tab. It
		     sits inside the content of the tab, so a reload or a change of the tab closes the
		     dialog. -->
		<div id={ ui.DialogStagingID } class="top-0 z-50"></div>
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.CloseDialogScript()
	@tmpl.HandleNextNalogResponseScript()
	@tmpl.HandleUpdateNalogDataResponseScript()
	@tmpl.HandleTipdokAfterRequestScript()
	@tmpl.HandleDblClickNalogSelectionScript()
	@tmpl.SelectRowScript()
	@tmpl.OpenPrintWithParamsScript()
	@tmpl.EnableDisableFieldsScripts()
}

// RobnoDokumentaShell renders the tab bar of the option - followed by the sub-tab bar when the
// active tab has sub-tabs - and then the body of the active tab. Every tab uses it so the
// navigation markup stays in one place.
templ RobnoDokumentaShell(tabs, subTabs domain.TabData, translator *i18n.Service, body templ.Component) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robna dokumenta"), tabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
		</div>
		<!-- Sub-tab navigation of the active tab (not rendered while it has no sub-tabs) -->
		if len(subTabs.Tabs) > 0 {
			<div class="border-b border-blue-600 pt-1">
				@tmpl.TabNav("", subTabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
			</div>
		}
		<!-- Tab body -->
		<div class="flex-1 min-h-0 flex flex-col gap-1">
			@body
		</div>
		<!-- Staging element of the error dialogs of the tabs (utils.RenderDialogOK) -->
		<div id="robnodokumenta-infomessage"></div>
	</div>
}

// RobnoDokumentaEmptyBody is the placeholder body of a tab that is not implemented yet: an empty
// parameter box and an empty grid. It is replaced by the real content of the tab as soon as the
// tab is built.
templ RobnoDokumentaEmptyBody(tabLabel string, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters - TODO: parameters of the tab -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-2 gap-1 items-start">
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="p-1 text-sm text-gray-600">{ tabLabel } - TODO</div>
			</fieldset>
		</div>
		<div class="flex justify-end gap-1 pt-2">
			@components.Button(btnObrada)
			@components.Search_PartPrintButton(btnPrint)
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 1 - Unos dokumenta
templ RobnoDokumentaUnos(hxValsTipdok, hxValsNalog string, tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaUnosForm(hxValsTipdok, hxValsNalog, tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, btnFakture, searchInput, translator))
}

// RobnoDokumentaUnosForm renders the header of the robni nalog ("Vrsta naloga za knjiženje",
// "Vrsta dokumenta", "Datum obrade", "Broj naloga", "Datum naloga", "Opis knjiženja" i "Magacin"),
// the "Prikaz ukupne obrade" panel and the grid of the nalozi of the selected vrsta naloga.
templ RobnoDokumentaUnosForm(hxValsTipdok, hxValsNalog string, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog, btnFakture domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2 items-stretch">
			<!-- Header of the nalog -->
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<form id="robno-dokumenta-unos-form" onsubmit="return false;">
					<!-- Next broj naloga of the selected vrsta naloga: fired when the vrsta naloga changes
					     and answered by handleNextNalogResponse, like the "Nalozi" screen -->
					<div
						id="nalog-trigger"
						hx-get="/api/robno-dokumenta/nextnalog"
						hx-trigger="tipdokChanged"
						hx-vals='js:{"tipdok": document.getElementById("tipdok").value}'
						hx-on::after-request="handleNextNalogResponse('robno-dokumenta-unos-form')"
						style="display:none;"
					></div>
					<!-- Magacin: TODO: the legacy "+" and "..." buttons next to the combo -->
					@RobnoDokumentaUnosMagCombo(magValues, payload.MagaciniID, false, translator)
					<!-- Vrsta naloga za knjiženje: changing it reloads the grid and, through the trigger
					     above, the broj naloga of the new vrsta naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "tipdok",
							LabelText:  translator.Label("Vrsta naloga za knjiženje"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:               "tipdok",
							Name:             "tipdok",
							HasLabel:         false,
							ClassSelect:      common.ClassInputTextEnabled + " flex-1",
							OptionValues:     tipdokValues,
							SelectedValue:    payload.Tipdok,
							ChangeEndpoint:   "/api/robno-dokumenta/unos",
							HxChangeTarget:   "robno-dokumenta-unos-table",
							HxSwap:           "innerHTML",
							HxVals:           hxValsTipdok,
							HxOnAfterRequest: "handleTipdokAfterRequest",
							TabIndex:         "2",
						}, translator)
					</div>
					<!-- Vrsta dokumenta: TODO: the legacy "+" and "..." buttons next to the combo -->
					@RobnoDokumentaUnosVrdCombo(vrstaDokumentaValues, payload.Vrd, false, translator)
					<!-- Datum obrade, Broj naloga i Datum naloga in one row. The label of Datum obrade
					     keeps the width of the labels of the other rows, so the fields are aligned. -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datob",
							LabelText:  translator.Label("Datum obrade"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datob",
							Name:       "datob",
							FieldType:  "date",
							Value:      payload.Datob,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
						<!-- Broj naloga: when the user leaves it, the data of an existing nalog is loaded -->
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nalog",
							LabelText:  translator.Label("Broj naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:               "nalog",
							Name:             "nalog",
							FieldType:        "text",
							Value:            payload.Nalog,
							ClassInput:       common.ClassInputTextEnabled + " flex-1 min-w-0",
							HxGet:            "/api/robno-dokumenta/nalog-data",
							HxTrigger:        "blur delay:100ms",
							HxInclude:        "select[name='tipdok']",
							HxVals:           hxValsNalog,
							HxSwap:           "none",
							HxOnAfterRequest: "handleUpdateNalogDataResponse",
							MinLength:        "1",
							MaxLength:        "10",
							TabIndex:         "5",
							OnInput:          "clearFieldError",
							OnFocus:          "clearFieldError"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "danal",
							LabelText:  translator.Label("Datum naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "danal",
							Name:       "danal",
							FieldType:  "date",
							Value:      payload.Danal,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Opis knjiženja -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis knjiženja"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      payload.Opis,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MinLength:  "0",
							MaxLength:  "120",
							TabIndex:   "7"})
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 pt-1">
						<!-- TODO (temporary): opens the new "Fakture veleprodaje" screen (RobnoFakture) while the
						     handler of the fakture is not written yet; remove this button together with the
						     robnoDokumentaURLFakturePreview routes of the handler. -->
						@components.Button(btnFakture)
						@components.SaveButton(btnSave, translator)
						@components.AddButton(btnNoviNalog, translator)
					</div>
				</form>
			</fieldset>
			<!-- Prikaz ukupne obrade -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Prikaz ukupne obrade") }</legend>
				@RobnoDokumentaUnosTotalRow("ukupnoNaloga", translator.Label("Ukupno naloga"), total.UkNaloga, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDokumenata", translator.Label("Ukupno dokumenata"), total.UkDokumenata, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoStavki", translator.Label("Ukupno stavki"), total.UkStavki, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDuguje", translator.Label("Duguje"), total.Duguje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoPotrazuje", translator.Label("Potražuje"), total.Potrazuje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoSaldo", translator.Label("Saldo"), total.Saldo, translator)
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
	<!-- Staging element of the confirm dialog of the save (like the "Nalozi" screen) -->
	<div id="dialog-confirm" class="top-0 z-50"></div>
}

// RobnoDokumentaUnosTotalRow renders one read only row of the "Prikaz ukupne obrade" panel. The
// value is right aligned and bold, like the numeric cells of the grids.
templ RobnoDokumentaUnosTotalRow(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-[60%]"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right font-bold",
		})
	</div>
}

// RobnoDokumentaUnosVrdCombo renders the combo of the vrsta dokumenta of the unos dokumenata. With oob
// it replaces the combo of the page out of band (the response to the change of the vrsta naloga, the
// legacy PostaviComboBoxes).
templ RobnoDokumentaUnosVrdCombo(values []domain.ComboItem, selected string, oob bool, translator *i18n.Service) {
	<div
		id="robno-dokumenta-unos-vrd"
		class="flex items-center gap-1 mb-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		@components.LabelField(domain.LabelFieldConfig{
			ID:         "vrd",
			LabelText:  translator.Label("Vrsta dokumenta"),
			ClassLabel: common.ClassLabel + " w-44",
		})
		@components.ComboBoxField(domain.ComboFieldConfig{
			ID:            "vrd",
			Name:          "vrd",
			HasLabel:      false,
			ClassSelect:   common.ClassInputTextEnabled + " flex-1",
			OptionValues:  values,
			SelectedValue: selected,
			TabIndex:      "3",
		}, translator)
	</div>
}

// RobnoDokumentaUnosMagCombo renders the combo of the magacin of the unos dokumenata (with oob out of
// band, see RobnoDokumentaUnosVrdCombo).
templ RobnoDokumentaUnosMagCombo(values []domain.ComboItem, magaciniID int, oob bool, translator *i18n.Service) {
	<div
		id="robno-dokumenta-unos-mag"
		class="flex items-center gap-1 mb-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		@components.LabelField(domain.LabelFieldConfig{
			ID:         "magaciniid",
			LabelText:  translator.Label("Magacin"),
			ClassLabel: common.ClassLabel + " w-44",
		})
		@components.ComboBoxField(domain.ComboFieldConfig{
			ID:            "magaciniid",
			Name:          "magaciniid",
			HasLabel:      false,
			ClassSelect:   common.ClassInputTextEnabled + " flex-1",
			OptionValues:  values,
			SelectedValue: magaciniSelection(magaciniID),
			TabIndex:      "1",
		}, translator)
	</div>
}

// magaciniSelection returns the key of the selected magacin ("" when no magacin is selected).
func magaciniSelection(magaciniID int) string {
	if magaciniID <= 0 {
		return ""
	}
	return strconv.Itoa(magaciniID)
}

//
// Tab 2 - Pregled dokumenta (sub-tabs "Štampa" and "eFaktura")
//

// RobnoDokumentaPregled renders the "Štampa" sub-tab of "Pregled dokumenta": the filters (magacin,
// vrsta dokumenta and the range of the dates of the nalog), the buttons "Obradi" and "Štampaj" and
// the grid of the robni dokumenti with the partner of every document.
templ RobnoDokumentaPregled(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPregledBody(tbl, magValues, vrstaDokumentaValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaPregledBody renders the body of the "Štampa" sub-tab. The parameters (left) and the
// "Obrada i štampa" panel (right) have the same height, like the header of the "Unos dokumenta" tab.
templ RobnoDokumentaPregledBody(tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Magacin -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<!-- Od datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2", OnInput: "clearFieldError",
							OnFocus: "clearFieldError"})
					</div>
					<!-- Vrsta dokumenta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vrd",
							LabelText:  translator.Label("Vrsta dokumenta"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "vrd",
							Name:          "vrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  vrstaDokumentaValues,
							SelectedValue: params.Vrd,
							TabIndex:      "3",
						}, translator)
					</div>
					<!-- Do datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Obrada i štampa") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
				<!-- The rdokid of the row selected in the grid: the "Štampaj" button prints its faktura
				     (empty: the fakture of the whole filter). -->
				<input type="hidden" id="rdokid" name="rdokid" value=""/>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
	@RobnoDokumentaPregledSelectScript()
}

// RobnoDokumentaPregledSelectScript selects the document of the "Štampa" sub-tab whose faktura the
// "Štampaj" button prints: a click on a row of the grid selects it (its data-row-id is the rdokid
// of the document) and a second click clears the selection. A reload of the grid (search, paging,
// "Obrada") clears the selection when the selected row is no longer shown.
templ RobnoDokumentaPregledSelectScript() {
	<script>
		function robnoPregledSelectDokument(row) {
			const input = document.getElementById("rdokid");
			const wasSelected = row.classList.contains("table-row-selected");
			const table = row.closest("table") || document;
			table.querySelectorAll("tr.table-row-selected").forEach(r => r.classList.remove("table-row-selected"));
			if (wasSelected) {
				if (input) input.value = "";
				return;
			}
			row.classList.add("table-row-selected");
			if (input) input.value = row.dataset.rowId || "";
		}
		if (!window.robnoPregledSelectListener) {
			window.robnoPregledSelectListener = true;
			document.body.addEventListener("htmx:afterSwap", function () {
				const input = document.getElementById("rdokid");
				if (input && input.value && !document.querySelector("tr.table-row-selected[data-row-id='" + input.value + "']")) {
					input.value = "";
				}
			});
		}
	</script>
}

// RobnoDokumentaEFaktura renders the "eFaktura" sub-tab of "Pregled dokumenta": the filters (grupe
// dokumenata and the range of the dates of the documents), the actions of the eFaktura, the date of
// the ažuriranje statusa and the grid with the status of every document.
templ RobnoDokumentaEFaktura(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEFakturaBody(tbl, params, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus, searchInput, translator))
}

// RobnoDokumentaEFakturaBody renders the body of the "eFaktura" sub-tab. The parameters with the
// actions (left) and the "Status eFaktura" panel (right) have the same height, like the header of
// the "Unos dokumenta" tab.
templ RobnoDokumentaEFakturaBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters and actions -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- Grupe dokumenata -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "grupedokumenata",
						LabelText:  translator.Label("Grupe dokumenata"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "grupedokumenata",
						Name:       "grupedokumenata",
						FieldType:  "text",
						Value:      params.GrupeDokumenata,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "120",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Od datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- Obrada and the actions of the eFaktura -->
				<div class="flex flex-wrap items-center justify-end gap-1 mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnPosalji)
					@components.Button(btnProveri)
					@components.Button(btnStornirajPE)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Status eFaktura") }</legend>
				<!-- Datum za ažuriranje statusa -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "datumstatusa",
						LabelText:  translator.Label("Datum za ažuriranje statusa"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "datumstatusa",
						Name:       "datumstatusa",
						FieldType:  "date",
						Value:      params.DatumStatusa,
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "4"})
				</div>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.Button(btnOtkazi)
					@components.Button(btnStorniraj)
					@components.Button(btnAzurirajStatus)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 3 - Specifikacije dokumenta
//
// The tab prints the specification of the documents of the selection (the report depends on the group
templ RobnoDokumentaSpecifikacije(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaSpecifikacijeBody(tbl, magValues, tipdokValues, vrstaDokumentaValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaSpecifikacijeBody renders the body of the "Specifikacije dokumenta" tab: the print
templ RobnoDokumentaSpecifikacijeBody(tbl domain.TableData, magValues, tipdokValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the print -->
	<div class="no-border bg-blue-100 rounded-lg">
		<!-- The panel of the parameters takes 4/5 of the width, the "Obrada i štampa" panel 1/5: the
		     two buttons of the print fit into it on one line. -->
		<div class="grid grid-cols-5 gap-2">
			<fieldset class="col-span-4 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right
				     aligned; every field is one label + control row, like the "Pregled dokumenta" sub-tab. -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<!-- First column: the combos (they take the free space of the fieldset) -->
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Od vrste naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "odvrd",
								LabelText:  translator.Label("Od vrste naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "odvrd",
								Name:          "odvrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.OdVrd,
								TabIndex:      "2",
							}, translator)
						</div>
						<!-- Do vrste naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dovrd",
								LabelText:  translator.Label("Do vrste naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "dovrd",
								Name:          "dovrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.DoVrd,
								TabIndex:      "3",
							}, translator)
						</div>
						<!-- Vrsta dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "vrd",
								Name:          "vrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  vrstaDokumentaValues,
								SelectedValue: params.Vrd,
								TabIndex:      "4",
							}, translator)
						</div>
					</div>
					<!-- Second column: the ranges of the broj naloga and of the broj dokumenta -->
					<div class="flex flex-col">
						<!-- Od naloga -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "odnaloga",
								LabelText:  translator.Label("Od naloga"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "odnaloga",
								Name:       "odnaloga",
								FieldType:  "text",
								Value:      params.OdNaloga,
								ClassInput: common.ClassInputTextEnabled + " w-32 text-right",
								MinLength:  "0",
								MaxLength:  "6",
								TabIndex:   "5",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<!-- Do naloga -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "donaloga",
								LabelText:  translator.Label("Do naloga"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "donaloga",
								Name:       "donaloga",
								FieldType:  "text",
								Value:      params.DoNaloga,
								ClassInput: common.ClassInputTextEnabled + " w-32 text-right",
								MinLength:  "0",
								MaxLength:  "6",
								TabIndex:   "6",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<!-- Od dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oddokum",
								LabelText:  translator.Label("Od dokumenta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oddokum",
								Name:       "oddokum",
								FieldType:  "text",
								Value:      params.OdDokum,
								ClassInput: common.ClassInputTextEnabled + " w-32 text-right",
								MinLength:  "0",
								MaxLength:  "6",
								TabIndex:   "7",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<!-- Do dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dodokum",
								LabelText:  translator.Label("Do dokumenta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "dodokum",
								Name:       "dodokum",
								FieldType:  "text",
								Value:      params.DoDokum,
								ClassInput: common.ClassInputTextEnabled + " w-32 text-right",
								MinLength:  "0",
								MaxLength:  "6",
								TabIndex:   "8",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
					</div>
					<!-- Third column: the range of the dates -->
					<div class="flex flex-col">
						<!-- Od datuma -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oddanal",
								LabelText:  translator.Label("Od datuma"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oddanal",
								Name:       "oddanal",
								FieldType:  "date",
								Value:      params.OdDanal,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "9",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<!-- Do datuma -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dodanal",
								LabelText:  translator.Label("Do datuma"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "dodanal",
								Name:       "dodanal",
								FieldType:  "date",
								Value:      params.DoDanal,
								ClassInput: common.ClassInputTextEnabled + " w-32",
								TabIndex:   "10",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
					</div>
				</div>
				<!-- State of the print: "Štampaj samo zbir" and the radio buttons "Specifikacija" / "Fakturna knjiga" -->
				<div class="flex flex-wrap items-center gap-3 pl-44 mb-1">
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "stampajsamozbir",
						Name:              "stampajsamozbir",
						LabelText:         "Štampaj samo zbir",
						ClassLabel:        common.ClassCheckboxLabel,
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
						IsChecked:         params.StampajSamoZbir,
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "specifikacija",
						Name:        "tipspecifikacije",
						LabelText:   "Specifikacija",
						Value:       "1",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.TipSpecifikacije != "2",
						TabIndex:    "11",
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "fakturnaknjiga",
						Name:        "tipspecifikacije",
						LabelText:   "Fakturna knjiga",
						Value:       "2",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.TipSpecifikacije == "2",
						TabIndex:    "12",
					}, translator)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Obrada i štampa") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Tab 4 - Kontiranje dokumenata (sub-tabs "Knjiženje dokumenata", "Pregled proknjiženih /
// neproknjiženih dokumenata" and "Pregled proknjiženih / neproknjiženih dokumenata po magacinima")
//

// RobnoDokumentaKontiranjeKnjizenje renders the "Knjiženje dokumenata" sub-tab of "Kontiranje
// dokumentata": the parameters of the selection of the documents (vrsta naloga za knjiženje, vrsta
// dokumenta, magacin and the ranges of the broj naloga, the broj dokumenta and the datum naloga),
// the buttons of the posting ("Obrada", "Proveri ravnotežu" and "Knjiži") and the grid of the robni
// dokumenti.
templ RobnoDokumentaKontiranjeKnjizenje(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjeKnjizenjeBody(tbl, tipdokValues, vrstaDokumentaValues, magValues, params, btnObrada, btnRavnoteza, btnKnjizi, searchInput, translator))
}

// RobnoDokumentaKontiranjeKnjizenjeBody renders the body of the "Knjiženje dokumenata" sub-tab. The
// parameters (left) and the "Knjiženje" panel with the buttons (right) have the same height, like
// the header of the "Unos dokumenta" tab.
templ RobnoDokumentaKontiranjeKnjizenjeBody(tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnRavnoteza, btnKnjizi domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "2",
							}, translator)
						</div>
						<!-- Vrsta dokumenta -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "vrd",
								Name:          "vrd",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  vrstaDokumentaValues,
								SelectedValue: params.Vrd,
								TabIndex:      "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Knjiženje") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnRavnoteza)
					@components.Button(btnKnjizi)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePregled renders the "Pregled proknjiženih / neproknjiženih dokumenata"
// sub-tab of "Kontiranje dokumenata": the parameters of the selection, the state of the posting
// (the radio buttons "Proknjiženi dokumenti" / "Neproknjiženi dokumenti" and the checkbox that
// marks the displayed documents as not posted) and the grid of the robni dokumenti.
templ RobnoDokumentaKontiranjePregled(tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePregledBody(tbl, tipdokValues, magValues, params, btnObrada, btnOznaci, searchInput, translator))
}

// RobnoDokumentaKontiranjePregledBody renders the body of the "Pregled proknjiženih /
// neproknjiženih dokumenata" sub-tab.
templ RobnoDokumentaKontiranjePregledBody(tbl domain.TableData, tipdokValues, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnOznaci domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the combos) takes the free space, the ranges and the dates are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- Vrsta naloga za knjiženje -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "tipdok",
								LabelText:  translator.Label("Vrsta naloga za knjiženje"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "tipdok",
								Name:          "tipdok",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  tipdokValues,
								SelectedValue: params.Tipdok,
								TabIndex:      "2",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "3", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "4", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "5", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "6", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "7", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "8", translator)
					</div>
				</div>
				<!-- State of the posting: the radio buttons "Proknjiženi / Neproknjiženi dokumenti" and the
				     checkbox that marks the displayed documents as not posted, in one row -->
				<div class="flex flex-wrap items-center gap-3 pl-44 mb-1">
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "proknjizeni",
						Name:        "proknjizen",
						LabelText:   "Proknjiženi dokumenti",
						Value:       "D",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "D",
						TabIndex:    "9",
					}, translator)
					@components.RadioButtonField(domain.RadioFieldConfig{
						ID:          "neproknjizeni",
						Name:        "proknjizen",
						LabelText:   "Neproknjiženi dokumenti",
						Value:       "N",
						ClassSelect: common.ClassRadioSet,
						ClassLabel:  "text-sm text-black whitespace-nowrap",
						IsSelected:  params.Proknjizen == "N",
						TabIndex:    "10",
					}, translator)
					@components.CheckboxField(domain.CheckboxFieldConfig{
						ID:                "oznacineproknjizenim",
						Name:              "oznacineproknjizenim",
						LabelText:         "Označi prikazana dokumenta kao neproknjižena",
						ClassLabel:        common.ClassCheckboxLabel,
						ClassCheckbox:     common.ClassCheckbox,
						ClassCheckboxSpan: common.ClassCheckboxSpan,
						IsChecked:         params.OznaciNeproknjizenim,
					}, translator)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnOznaci)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaKontiranjePoMagacinima renders the "Pregled proknjiženih / neproknjiženih
// dokumenata po magacinima" sub-tab of "Kontiranje dokumenata": the same filters as the previous
// sub-tab without the vrsta naloga (the grid is grouped by the magacin of the document).
templ RobnoDokumentaKontiranjePoMagacinima(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaKontiranjePoMagacinimaBody(tbl, magValues, params, btnObrada, searchInput, translator))
}

// RobnoDokumentaKontiranjePoMagacinimaBody renders the body of the "Pregled ... po magacinima"
// sub-tab.
templ RobnoDokumentaKontiranjePoMagacinimaBody(tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection and the state of the posting -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The first column (the magacin and the radios) takes the free space, the ranges and the dates
				     are right aligned -->
				<div class="grid grid-cols-[1fr_auto_auto] gap-x-2">
					<div class="flex flex-col">
						<!-- Magacin -->
						<div class="flex items-center gap-1 mb-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "magaciniid",
								LabelText:  translator.Label("Magacin"),
								ClassLabel: common.ClassLabel + " w-44",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "magaciniid",
								Name:          "magaciniid",
								HasLabel:      false,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1",
								OptionValues:  magValues,
								SelectedValue: magaciniSelection(params.MagaciniID),
								TabIndex:      "1",
							}, translator)
						</div>
						<!-- State of the posting: proknjiženi / neproknjiženi dokumenti -->
						<div class="flex flex-wrap items-center gap-2 pt-1">
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "proknjizeni",
								Name:        "proknjizen",
								LabelText:   "Proknjiženi dokumenti",
								Value:       "D",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "D",
								TabIndex:    "2",
							}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{
								ID:          "neproknjizeni",
								Name:        "proknjizen",
								LabelText:   "Neproknjiženi dokumenti",
								Value:       "N",
								ClassSelect: common.ClassRadioSet,
								ClassLabel:  "text-sm text-black whitespace-nowrap",
								IsSelected:  params.Proknjizen == "N",
								TabIndex:    "3",
							}, translator)
						</div>
					</div>
					<!-- Ranges of the broj naloga and the broj dokumenta -->
					<div class="flex flex-col">
						@RobnoDokumentaRangeField("odnaloga", "Od broja naloga", params.OdNaloga, "4", translator)
						@RobnoDokumentaRangeField("donaloga", "Do broja naloga", params.DoNaloga, "5", translator)
						@RobnoDokumentaRangeField("oddokum", "Od broja dokumenta", params.OdDokum, "6", translator)
						@RobnoDokumentaRangeField("dodokum", "Do broja dokumenta", params.DoDokum, "7", translator)
					</div>
					<!-- Range of the datum naloga -->
					<div class="flex flex-col">
						@RobnoDokumentaDateField("oddanal", "Od datuma naloga", params.OdDanal, "8", translator)
						@RobnoDokumentaDateField("dodanal", "Do datuma naloga", params.DoDanal, "9", translator)
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Pregled dokumenta") }</legend>
				<!-- The button is aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoDokumentaRangeField renders one "Od/Do broja ..." range of the "Kontiranje dokumenata" tab
// (a whole number typed as text).
templ RobnoDokumentaRangeField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "text",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
			MaxLength:  "9",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// RobnoDokumentaDateField renders one "Od/Do datuma naloga" date of the "Kontiranje dokumenata" tab.
templ RobnoDokumentaDateField(id, label, value, tabIndex string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{
			ID:         id,
			LabelText:  translator.Label(label),
			ClassLabel: common.ClassLabel + " w-32",
		})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Name:       id,
			FieldType:  "date",
			Value:      value,
			ClassInput: common.ClassInputTextEnabled + " !w-32",
			TabIndex:   tabIndex,
			OnInput:    "clearFieldError",
			OnFocus:    "clearFieldError"})
	</div>
}

// Tab 5 - Prepis dokumenta
templ RobnoDokumentaPrepis(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEmptyBody("Prepis dokumenta", tbl, btnObrada, btnPrint, searchInput, translator))
}

// Tab 6 - Prikaz ukupne obrade
templ RobnoDokumentaPrikazUkupneObrade(tabs, subTabs domain.TabData, tbl domain.TableData, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazUkupneObradeBody(tbl, btnPrint, searchInput, translator))
}

// RobnoDokumentaPrikazUkupneObradeBody renders the body of the "Prikaz ukupne obrade" tab: the grid
templ RobnoDokumentaPrikazUkupneObradeBody(tbl domain.TableData, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- The print button is the only control of the tab: it is pushed to the right, like the toolbar of
	     the other tabs of the option ("justify-end" on the flex container that holds it). -->
	<div class="flex items-center justify-end gap-1 mt-1 mb-1">
		@components.Search_PartPrintButton(btnPrint)
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 7 - Prikaz naloga
//
// The tab shows the robni nalozi of the current period filtered by magacin, the range of the vrste
// naloga and the range of the broj naloga. The three checkboxes ("Po datumu naloga", "Po datumu
// obrade" and "Po operateru") enable their fields when they are checked (controlToggle of
// EnableDisableFieldsScripts, like "Prikaz kartice artikla" of the robno kartica does).
templ RobnoDokumentaPrikazNaloga(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaParametriNalogaBody renders the body of the tabs that select robni nalozi ("Prikaz
// naloga" and "Prikaz dokumenata u nalogu"): the parameters of the selection (the only panel of the
// tab - the buttons "Obrada" and "Štampaj" are in the row of the "Po operateru" checkbox, aligned
// to the right) and the grid of the tab (the columns come from the table of the tab). Every checkbox
// is in the same row as the fields it enables.
templ RobnoDokumentaParametriNalogaBody(tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab): the fields of the nalog in the first
	     third of the panel and, in the other two thirds, every checkbox with the fields it enables in
	     one row. The buttons "Obrada" and "Štampaj" are at the bottom right of the panel.
	     The wrapper is a flex column that fills the body of the tab (flex-1 min-h-0), so that the grid
	     under the parameters (flex-1) stretches to the bottom like the grids of the other tabs. -->
	<div class="no-border bg-blue-100 rounded-lg flex-1 min-h-0 flex flex-col">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 mb-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<!-- The rows of the second column are one below the other (mb-2) and the free space of every
			     row is distributed between its controls (justify-between); the date fields are kept
			     narrow (w-40) so that there is enough space between the controls. -->
			<div class="grid grid-cols-3 gap-x-2 mb-1">
				<!-- Magacin, the range of the vrste naloga and the range of the broj naloga -->
				<div class="flex flex-col">
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odvrd",
							LabelText:  translator.Label("Od vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "odvrd",
							Name:          "odvrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.OdVrd,
							TabIndex:      "2",
						}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dovrd",
							LabelText:  translator.Label("Do vrste naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "dovrd",
							Name:          "dovrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  tipdokValues,
							SelectedValue: params.DoVrd,
							TabIndex:      "3",
						}, translator)
					</div>
					<!-- Od broja naloga (the label has the width of the labels of the fields above) -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "odnaloga",
							LabelText:  translator.Label("Od broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "odnaloga",
							Name:       "odnaloga",
							FieldType:  "text",
							Value:      params.OdNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do broja naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "donaloga",
							LabelText:  translator.Label("Do broja naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "donaloga",
							Name:       "donaloga",
							FieldType:  "text",
							Value:      params.DoNaloga,
							ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
							MaxLength:  "9",
							TabIndex:   "5",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- The checkbox of every filter with the fields it enables, in one row -->
				<div class="col-span-2 flex flex-col">
					<!-- Po datumu naloga -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "6", translator)
						<!-- The controls of the row start right after the checkbox (flex-1 wrapper), so the
						     labels of all the rows are aligned one below the other. Every label stays with
						     its own field (as in the first column), so the fields of rows 1-3 all start at
						     the same x -->
						<div class="flex-1 flex items-center justify-between gap-1">
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "oddanal",
									LabelText:  translator.Label("Od datuma naloga"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "oddanal",
									Name:       "oddanal",
									FieldType:  "date",
									Value:      params.OdDanal,
									Disabled:   !params.ChkDatumNaloga,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "7"})
							</div>
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "dodanal",
									LabelText:  translator.Label("Do datuma naloga"),
									ClassLabel: common.ClassLabel + " w-32 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "dodanal",
									Name:       "dodanal",
									FieldType:  "date",
									Value:      params.DoDanal,
									Disabled:   !params.ChkDatumNaloga,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "8"})
							</div>
						</div>
					</div>
					<!-- Po datumu obrade -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "9", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "oddatob",
									LabelText:  translator.Label("Od datuma obrade"),
									ClassLabel: common.ClassLabel + " w-32",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "oddatob",
									Name:       "oddatob",
									FieldType:  "date",
									Value:      params.OdDatob,
									Disabled:   !params.ChkDatumObrade,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "10"})
							</div>
							<div class="flex items-center gap-1">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "dodatob",
									LabelText:  translator.Label("Do datuma obrade"),
									ClassLabel: common.ClassLabel + " w-32 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "dodatob",
									Name:       "dodatob",
									FieldType:  "date",
									Value:      params.DoDatob,
									Disabled:   !params.ChkDatumObrade,
									ClassInput: common.ClassInputTextEnabled + " !w-40",
									TabIndex:   "11"})
							</div>
						</div>
					</div>
					<!-- Po operateru: the checkbox and the operator, in the third row of the panel, so the
					     operator control is in line with the "Do vrste naloga" combo box of the first
					     column (that row has the same height and spacing as the rows of the first column). -->
					<div class="flex items-center gap-1 mb-1">
						@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "12", translator)
						<div class="flex-1 flex items-center justify-between gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oper",
								LabelText:  translator.Label("Operater"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oper",
								Name:       "oper",
								FieldType:  "text",
								Value:      params.Oper,
								Disabled:   !params.ChkOperator,
								ClassInput: common.ClassInputTextEnabled + " flex-1",
								MaxLength:  "20",
								TabIndex:   "13"})
						</div>
					</div>
					<!-- The buttons of the tab, at the bottom right of the panel (in line with the "Do broja
					     naloga" field of the first column) -->
					<div class="flex items-center justify-end gap-1 mt-auto">
						@components.FormObradaButton(btnObrada, translator)
						@components.Search_PartPrintButton(btnPrint)
					</div>
				</div>
			</div>
		</fieldset>
		<!-- Group Data Table -->
		<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
			@components.LoadingSpinner()
			@components.Search_Part(tbl, searchInput)
			<!-- Table -->
			<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
				@components.Table(tbl, translator)
			</div>
		</div>
	</div>
}

// RobnoDokumentaCheckBox renders one of the checkboxes of the "Prikaz naloga" tab that enable the
// fields of a filter (the same pattern as "Prikaz kartice artikla": controlToggle switches the
// disabled state of the fields listed in the JSON array of the onchange handler).
templ RobnoDokumentaCheckBox(id, labelText, fields string, isChecked bool, tabIndex string, translator *i18n.Service) {
	<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0 h-8 sm:h-7 md:h-6" }>
		<input
			type="checkbox"
			id={ id }
			name={ id }
			class={ common.ClassCheckbox }
			tabindex={ tabIndex }
			if isChecked {
				checked="checked"
			}
			onchange={ templ.JSFuncCall("controlToggle", templ.JSExpression("this"), templ.JSExpression(fields)) }
		/>
		<span class={ common.ClassCheckboxSpan }>{ translator.Label(labelText) }</span>
	</label>
}

// Tab 8 - Prikaz dokumenata u nalogu
//
// The tab shows the robni dokumenti of the selected nalozi: it uses the same parameters and the
// same layout as the "Prikaz naloga" tab (the body of the two tabs is shared), only the columns of
// its grid differ.
templ RobnoDokumentaPrikazDokumenataUNalogu(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaParametriNalogaBody(tbl, magValues, tipdokValues, params, btnObrada, btnPrint, searchInput, translator))
}

// Tab 9 - Prikaz dokumenata po operateru
templ RobnoDokumentaPrikazDokumenataPoOperateru(tabs, subTabs domain.TabData, tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPrikazDokumenataPoOperateruBody(tbl, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaPrikazDokumenataPoOperateruBody renders the body of the "Prikaz dokumenata po
templ RobnoDokumentaPrikazDokumenataPoOperateruBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters of the selection (the only panel of the tab) in the three columns of the legacy
	     screen: the checkboxes of the filters, the "Od" fields and the "Do" fields. The buttons
	     "Obrada" and "Štampaj" are at the bottom right of the panel. -->
	<div class="no-border bg-blue-100 rounded-lg">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
			<div class="grid grid-cols-[11rem_1fr_1fr] gap-x-4 gap-y-1 items-center">
				<!-- Row 1: the range of the broj naloga (it has no checkbox of its own) -->
				<div></div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "odnaloga",
						LabelText:  translator.Label("Od broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "odnaloga",
						Name:       "odnaloga",
						FieldType:  "text",
						Value:      params.OdNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "donaloga",
						LabelText:  translator.Label("Do broja naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "donaloga",
						Name:       "donaloga",
						FieldType:  "text",
						Value:      params.DoNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "9",
						TabIndex:   "2",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<!-- Row 2: Po datumu naloga with the range of the datuma naloga -->
				@RobnoDokumentaCheckBox("chkpodatumunaloga", "Po datumu naloga", `["oddanal","dodanal"]`, params.ChkDatumNaloga, "3", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddanal",
						LabelText:  translator.Label("Od datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddanal",
						Name:       "oddanal",
						FieldType:  "date",
						Value:      params.OdDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "4"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodanal",
						LabelText:  translator.Label("Do datuma naloga"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodanal",
						Name:       "dodanal",
						FieldType:  "date",
						Value:      params.DoDanal,
						Disabled:   !params.ChkDatumNaloga,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "5"})
				</div>
				<!-- Row 3: Po datumu obrade with the range of the datuma obrade -->
				@RobnoDokumentaCheckBox("chkpodatumuobrade", "Po datumu obrade", `["oddatob","dodatob"]`, params.ChkDatumObrade, "6", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oddatob",
						LabelText:  translator.Label("Od datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oddatob",
						Name:       "oddatob",
						FieldType:  "date",
						Value:      params.OdDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "7"})
				</div>
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dodatob",
						LabelText:  translator.Label("Do datuma obrade"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dodatob",
						Name:       "dodatob",
						FieldType:  "date",
						Value:      params.DoDatob,
						Disabled:   !params.ChkDatumObrade,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "8"})
				</div>
				<!-- Row 4: Po operateru with the operator (the row has no field in the third column) -->
				@RobnoDokumentaCheckBox("chkpooperateru", "Po operateru", `["oper"]`, params.ChkOperator, "9", translator)
				<div class="flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "oper",
						LabelText:  translator.Label("Operater"),
						ClassLabel: common.ClassLabel + " w-32",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "oper",
						Name:       "oper",
						FieldType:  "text",
						Value:      params.Oper,
						Disabled:   !params.ChkOperator,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "20",
						TabIndex:   "10"})
				</div>
				<!-- The buttons of the tab, at the bottom right of the panel (in line with the "Do broja
					     naloga" field of the first column) -->
				<div class="flex items-center justify-end gap-1 mt-auto">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
		</fieldset>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

//
// Fakture veleprodaje - the header of the faktura and its stavke
// RobnoFakture renders the "Fakture veleprodaje" screen: the two collapsible controls inside the shell
// of "Robna dokumenta" (tabs and sub-tabs) and the script that switches the editable control.
templ RobnoFakture(ui domain.RobnoFaktureUI, tabs, subTabs domain.TabData, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator))
	<!-- Scripts the screen shares with the other robno forms: the search popups (F3 / "...") and the
	     inline validation errors -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@RobnoFaktureScript()
}

// RobnoFaktureDialog renders the "Fakture veleprodaje" screen inside a modal dialog: the same content
// as RobnoFakture without the tab bar of the option (the dialog covers the tab, which stays open
// behind it) plus the title bar with the "Zatvori" button. It is the response of the "Fakture
// veleprodaje (preview)" button of the "Unos dokumenta" tab, swapped into the
// ui.DialogStagingID element (see RobnoDokumentaMain). The dialog is not removed when
// it is closed (closeDialog only hides it, so that the fade-out is visible): the next request renders
// it again.
templ RobnoFaktureDialog(ui domain.RobnoFaktureUI, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, btnClose domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div id={ ui.DialogID } class={ common.ClassMainDialogDiv }>
		<div class="bg-blue-100 rounded-lg shadow-2xl flex flex-col w-[95vw] h-[90vh]">
			<!-- Title bar of the dialog -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg flex-shrink-0">
				<h2 class="text-lg font-semibold ml-4">{ translator.Label("Fakture veleprodaje") }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- Content: the strip of the vrsta fakture, the collapsible control of the header and the
			     collapsible control of the stavke -->
			<div class="flex-1 min-h-0 overflow-auto p-1">
				@RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator)
			</div>
		</div>
	</div>
	@RobnoFaktureScript()
	<!-- The scripts the tab installs for the screen (the dialog is rendered on its own, so it has to
	     install them itself) -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
}

// RobnoFaktureBody renders the content of the screen: the strip with the vrsta fakture, the first
// collapsible control (the header of the faktura) and the second one (the stavke).
templ RobnoFaktureBody(ui domain.RobnoFaktureUI, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0">
		@RobnoFaktureDokumentBar(header, btns.Back, translator)
		@RobnoFaktureHeaderPanel(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, translator)
		@RobnoFaktureStavkePanel(ui, tbl, header, stavka, btns, searchInput, translator)
	</div>
}

// RobnoFakturePanel is one of the two collapsible controls of the screen: a <details> element whose
// <summary> is the title bar. While the control is disabled its fields are not editable and its
// summary does not open it, so the user can see and change only the control that is currently active.
// The fields and the buttons are two slots: the script disables the controls of [data-panel-fields]
// only, so the buttons of the control (e.g. "Izmeni" of the header) stay clickable even when the
// control itself is locked. The fields of a disabled control carry the inert attribute, so they cannot
// be reached with the mouse or with the keyboard either.
templ RobnoFakturePanel(id, title, stateText string, open, enabled bool, fields, buttons templ.Component) {
	<details
		id={ id }
		open?={ open }
		data-enabled={ robnoFaktureState(enabled) }
		class="group w-full rounded-lg border border-blue-400 bg-blue-100"
	>
		<summary
			onclick="return robnoFaktureCanToggle(this)"
			class="px-2 py-1 cursor-pointer select-none flex items-center gap-1 bg-blue-200 rounded-t-lg font-semibold text-sm text-blue-900"
		>
			<span class="text-blue-700 transition-transform group-open:rotate-90">&#9654;</span>
			{ title }
			<span class="ml-auto font-normal text-xs text-blue-800">{ stateText }</span>
		</summary>
		<div class="p-1 flex flex-col gap-1">
			<!-- The fields of a disabled control are dimmed and do not accept the mouse: the same
			     classes robnoFaktureSetPanelEnabled toggles at runtime. -->
			<div
				data-panel-fields
				inert?={ !enabled }
				if enabled {
					class="flex flex-col gap-1"
				} else {
					class="flex flex-col gap-1 opacity-60 pointer-events-none"
				}
			>
				@fields
			</div>
			<div class="flex items-center justify-end gap-1">
				@buttons
			</div>
		</div>
	</details>
}

// RobnoFaktureDokumentBar renders the strip above the two controls: the vrsta fakture (Otpremnica /
// Račun) with the checkbox "Štampaj detalje u stavkama" and the "Nazad" button, like the blue bar of
// the two WinDev windows. The radios are disabled while the header is saved (they belong to the
// header), the checkbox too.
templ RobnoFaktureDokumentBar(header domain.RobnoFaktureHeaderView, btnBack domain.Button, translator *i18n.Service) {
	<div class="flex items-center gap-2 border border-blue-400 bg-blue-100 rounded-lg px-1 py-0.5">
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="otpremnica"
				value="O"
				class={ common.ClassCheckbox }
				checked?={ header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-24" }>{ translator.Label("Otpremnica") }</span>
		</label>
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="racun"
				value="R"
				class={ common.ClassCheckbox }
				checked?={ !header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-16" }>{ translator.Label("Račun") }</span>
		</label>
		<div class="flex-1 flex justify-center">
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "stampajdetalje",
				Name:              "stampajdetalje",
				LabelText:         translator.Label("Štampaj detalje u stavkama"),
				ClassLabel:        common.ClassLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: "text-sm",
				IsChecked:         header.StampajDetalje,
				Disabled:          header.Snimljen,
				TabIndex:          "0"}, translator)
		</div>
		@components.Button(btnBack)
	</div>
}

// RobnoFaktureHeaderPanel renders the first collapsible control: the header of the faktura, i.e. the
templ RobnoFaktureHeaderPanel(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	@RobnoFakturePanel(ui.HeaderPanelID, translator.Label("Podaci o fakturi"), robnoFaktureHeaderStateText(header.Snimljen, translator), !header.Snimljen, !header.Snimljen, RobnoFaktureHeaderFields(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, translator), RobnoFaktureHeaderButtons(btns))
}

// RobnoFaktureHeaderFields renders the fields of the header of the faktura: the strip of the nalog,
templ RobnoFaktureHeaderFields(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, translator *i18n.Service) {
	<!-- Nalog: the read only strip both windows show above the form. It is laid out like the two row
	     header of the legacy window: the first line is the label of the field, the second one its value
	     (see robnoFaktureNalogStripFields). It spans both columns. -->
	<fieldset class="border border-blue-400 bg-blue-100">
		@RobnoFaktureReadOnlyStrip(robnoFaktureNalogStripFields(header, translator))
	</fieldset>
	<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-1">
		<!-- ===== Left column: podaci o dokumentu, podaci o kupcu, podaci o načinu otpreme ===== -->
		<div class="flex flex-col gap-1 min-w-0 h-full">
			<!-- Podaci o dokumentu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
				<div class="flex flex-col gap-y-1">
					<!-- Row 1: the vrsta dokumenta (read only - it is chosen on the "Unos dokumenta" tab) and the
			     broj dokumenta with the search of the robni dokumenti -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "vrd",
								Name:       "vrd",
								FieldType:  "text",
								Value:      header.Vrd,
								Disabled:   true,
								ClassInput: common.ClassInputTextDisabled + " w-80 min-w-0"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdok",
								LabelText:  translator.Label("Broj dokumenta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "brdok",
								Name:       "brdok",
								FieldType:  "text",
								Value:      header.BrojDokum,
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								MaxLength:  "10",
								TabIndex:   "1",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
							@components.SearchButton(domain.SearchButtonConfig{ID: "brdok", Name: "search-brdok", HxUrl: ui.DokumentSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "brdok"}`, ClassButton: common.ClassButton})
						</div>
					</div>
					<!-- Row 2: the datum fakturisanja, the broj and the datum of the izvorni dokument -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumfakturisanja",
								LabelText:  translator.Label("Datum fakturisanja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumfakturisanja",
								Name:       "datumfakturisanja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumDokum),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdokorg",
								LabelText:  translator.Label("Broj orig. dokumenta"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "brdokorg",
								Name:       "brdokorg",
								FieldType:  "text",
								Value:      header.IzvorniDokum,
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								MaxLength:  "20",
								TabIndex:   "3"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumizvora",
								LabelText:  translator.Label("Datum izvor. dokum."),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumizvora",
								Name:       "datumizvora",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.IzvorniDokDatum),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "4"})
						</div>
					</div>
					<!-- Row 3: the opis -->
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      header.Opis,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "5"})
					</div>
					<!-- Row 4: the checkbox "Za period od / do" with its two dates, then the datum smanjenja -->
					<div class="flex flex-wrap items-center gap-1">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "zaperiod",
							Name:              "zaperiod",
							LabelText:         translator.Label("Za period"),
							ClassLabel:        common.ClassLabel + " w-28",
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.ZaPeriod,
							Disabled:          header.Snimljen,
							TabIndex:          "6"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "periodod",
							LabelText:  translator.Label("Od"),
							ClassLabel: common.ClassLabel + " w-7",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "periodod",
							Name:       "periodod",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodOd),
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "7"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "perioddo",
							LabelText:  translator.Label("Do"),
							ClassLabel: common.ClassLabel + " w-10",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "perioddo",
							Name:       "perioddo",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodDo),
							Disabled:   !header.ZaPeriod || header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-[6rem]",
							TabIndex:   "8"})
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumsmanjenja",
								LabelText:  translator.Label("Datum smanjenja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumsmanjenja",
								Name:       "datumsmanjenja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumSmanjenja),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " !w-32",
								TabIndex:   "9"})
						</div>
					</div>
				</div>
			</fieldset>
			<!-- Podaci o kupcu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o kupcu") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Mesto isporuke, komercijalista, tender, napomena..."): the konto and the analitička
				     šifra with their searches of the partneri, the naziv with the adresa, the poštanski broj
				     with the mesto and the PIB with the sistem PDV. Every label has the same width (w-36), so
				     the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Konto kupca and the analitička šifra, every one with the search of the partneri -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupackonto",
							LabelText:  translator.Label("Konto kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupackonto",
							Name:       "kupackonto",
							FieldType:  "text",
							Value:      header.KupacKonto,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "10"})
						@components.SearchButton(domain.SearchButtonConfig{ID: "kupackonto", Name: "search-kupackonto", HxUrl: ui.PartnerSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "kupackonto"}`, ClassButton: common.ClassButton})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacsifra",
							LabelText:  translator.Label("Analitička šifra"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacsifra",
							Name:       "kupacsifra",
							FieldType:  "text",
							Value:      header.KupacSifra,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "11"})
						@components.SearchButton(domain.SearchButtonConfig{ID: "kupacsifra", Name: "search-kupacsifra", HxUrl: ui.PartnerSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "kupacsifra"}`, ClassButton: common.ClassButton})
					</div>
					<!-- Naziv kupca and the adresa (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacnaziv",
							LabelText:  translator.Label("Naziv kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacnaziv",
							Name:       "kupacnaziv",
							FieldType:  "text",
							Value:      header.KupacNaziv,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "60",
							TabIndex:   "12"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacadresa",
							LabelText:  translator.Label("Adresa"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacadresa",
							Name:          "kupacadresa",
							FieldType:     "text",
							Value:         header.KupacAdresa,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "60",
							TabIndex:      "13",
							DataDestField: "kupacadresa"})
					</div>
					<!-- Poštanski broj and the mesto (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpostanskibroj",
							LabelText:  translator.Label("Poštanski broj"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpostanskibroj",
							Name:       "kupacpostanskibroj",
							FieldType:  "text",
							Value:      header.KupacPostanskiBroj,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "14"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacmesto",
							LabelText:  translator.Label("Mesto"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacmesto",
							Name:          "kupacmesto",
							FieldType:     "text",
							Value:         header.KupacMesto,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "40",
							TabIndex:      "15",
							DataDestField: "kupacmesto"})
					</div>
					<!-- PIB / JIB and the sistem PDV (read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpib",
							LabelText:  translator.Label("PIB / JIB"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpib",
							Name:       "kupacpib",
							FieldType:  "text",
							Value:      header.KupacPib,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "16"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sistempdv",
							LabelText:  translator.Label("Sistem PDV"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "sistempdv",
							Name:          "sistempdv",
							HasLabel:      false,
							Disabled:      true,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  sistemPdvValues,
							SelectedValue: header.SistemPdv,
							TabIndex:      "17"}, translator)
					</div>
				</div>
			</fieldset>
			<!-- Podaci o načinu otpreme, rokovima, valuti... : it is the last panel of the column, so it grows
			     to fill the space the right column leaves free at the bottom (both columns end on the same
			     line) -->
			<fieldset class="flex-1 border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o načinu otpreme, rokovima, valuti...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Podaci o kupcu"): the fields of a line stay together in the row (the first row holds the
				     valuta with its kurs and the "važi za", the rows of a single field keep the field over the
				     whole row). Every label has the same width (w-36), so the controls of all the rows start at
				     the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- The šifra valute with its combo over 1/2 of the row and the other two controls (the
					     "važi za" and the kurs) over the other 1/2, 1/4 of the row each -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						<div class="flex-1 flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "valuta",
								LabelText:  translator.Label("Šifra valute"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "valuta",
								Name:          "valuta",
								HasLabel:      false,
								Disabled:      header.Snimljen,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
								OptionValues:  valutaValues,
								SelectedValue: robnoFaktureInt(header.Valuta),
								TabIndex:      "18"}, translator)
						</div>
						<div class="flex-1 flex items-center gap-1 min-w-0">
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "vaziza",
									LabelText:  translator.Label("Važi za (1,100)"),
									ClassLabel: common.ClassLabel + " w-36 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "vaziza",
									Name:       "vaziza",
									FieldType:  "text",
									Value:      robnoFaktureInt(header.VaziZa),
									Disabled:   header.Snimljen,
									ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
									MaxLength:  "3",
									TabIndex:   "19"})
							</div>
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "kurs",
									LabelText:  translator.Label("Kurs"),
									ClassLabel: common.ClassLabel + " w-16 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "kurs",
									Name:       "kurs",
									FieldType:  "text",
									Value:      robnoFaktureDecimal(header.Kurs, 2),
									Disabled:   header.Snimljen,
									ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
									MaxLength:  "15",
									TabIndex:   "20"})
							</div>
						</div>
					</div>
					<!-- BrojRata, DatumPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojrata",
							LabelText:  translator.Label("Broj rata"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojrata",
							Name:       "brojrata",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojRata),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "21"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datumprverate",
							LabelText:  translator.Label("Dat. dosp. prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datumprverate",
							Name:       "datumprverate",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.DatumPrveRate),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "22"})
					</div>
					<!-- IznosFakture, IznosPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosfakture",
							LabelText:  translator.Label("Iznos fakture"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosfakture",
							Name:       "iznosfakture",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosFakture, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "23"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosprverate",
							LabelText:  translator.Label("Iznos prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosprverate",
							Name:       "iznosprverate",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosPrveRate, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "24"})
					</div>
					<!-- UsloviPlacanja, UsloviKamate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "usloviplacanja",
							LabelText:  translator.Label("Uslovi plaćanja"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "usloviplacanja",
							Name:       "usloviplacanja",
							FieldType:  "text",
							Value:      header.UsloviPlacanja,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "25"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "uslovikamate",
							LabelText:  translator.Label("Uslovi kamate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "uslovikamate",
							Name:       "uslovikamate",
							FieldType:  "text",
							Value:      header.UsloviKamate,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "26"})
					</div>
					<!-- Rok, Dospeva -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "rok",
							LabelText:  translator.Label("Rok"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "rok",
							Name:       "rok",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.Rok),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "27"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dospeva",
							LabelText:  translator.Label("Dospeva"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dospeva",
							Name:       "dospeva",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.Dospeva),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "28"})
					</div>
					<!-- ZiroRacun -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "ziroracun",
							LabelText:  translator.Label("Ziro račun"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "ziroracun",
							Name:          "ziroracun",
							HasLabel:      false,
							Disabled:      header.Snimljen,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  zirpRacunValues,
							SelectedValue: header.ZirpRacun,
							TabIndex:      "29"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nacinotpreme",
							LabelText:  translator.Label("Način otpreme"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "nacinotpreme",
							Name:       "nacinotpreme",
							FieldType:  "text",
							Value:      header.NacinOtpreme,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "30"})
					</div>
					<!-- Broj ugovora, Narudžbenica -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojugovora",
							LabelText:  translator.Label("Broj ugovora"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojugovora",
							Name:       "brojugovora",
							FieldType:  "text",
							Value:      header.BrojUgovora,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "31"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "narudzbenica",
							LabelText:  translator.Label("Narudžbenica"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "narudzbenica",
							Name:       "narudzbenica",
							FieldType:  "text",
							Value:      header.Narudzbenica,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "32"})
					</div>
					<!-- Paritet, IzvozIzjava -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "paritet",
							LabelText:  translator.Label("Paritet"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "paritet",
							Name:       "paritet",
							FieldType:  "text",
							Value:      header.Paritet,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "33"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "izvozizjava",
							LabelText:  translator.Label("Izvoz. izjava"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "izvozizjava",
							Name:       "izvozizjava",
							FieldType:  "text",
							Value:      header.IzvozIzjava,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "34"})
					</div>
					<!-- BankaUplatu -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bankauplatu",
							LabelText:  translator.Label("Banka za uplatu - izvoz"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bankauplatu",
							Name:       "bankauplatu",
							FieldType:  "text",
							Value:      header.BankaIzvozUplatu,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "35"})
					</div>
					<!-- Popdv -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "popdv",
							LabelText:  translator.Label("Polje POPDV"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "popdv",
							Name:       "popdv",
							FieldType:  "text",
							Value:      header.Popdv,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "4",
							TabIndex:   "36"})
					</div>
				</div>
			</fieldset>
			<!-- ===== End of the left column, start of the right column ===== -->
		</div>
		<div class="flex flex-col gap-1 min-w-0">
			<!-- Podaci o porezom oslobođenju, nastanku PDV obaveze -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o porezom oslobođenju, nastanku PDV obaveze") }</legend>
				<!-- The rows of the panel: every row is one line of the legacy box. The first row holds the
				     poreska kategorija (combo, 3/4 of the row) with the oznaka next to it (the last 1/4), the
				     second one the napomena over the whole row; below them the nastanak PDV obaveze and, in
				     the last row, the org. jedinica with the mesto troška. Every label of the panel has the
				     same width (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Row 1: the poreska kategorija (3/4) and the oznaka (1/4) -->
					<div class="col-span-3 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "porkat",
							LabelText:  translator.Label("Poreska kategorija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "porkat",
							Name:         "porkat",
							Placeholder:  translator.Placeholder("izaberite poresku kategoriju"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "37",
							OptionValues: header.CbxPorKategorija,
						}, translator)
					</div>
					<div class="flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oznakakat",
							LabelText:  translator.Label("Oznaka"),
							ClassLabel: common.ClassLabel + " w-16",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oznakakat",
							Name:       "oznakakat",
							FieldType:  "text",
							Value:      header.OznakaKat,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "38"})
					</div>
					<!-- Row 2: the napomena o poreskom oslobođenju over the whole row -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "napomporeskoosl",
							LabelText:  translator.Label("Napom. o poreskom osl."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "napomporeskoosl",
							Name:       "napomporeskoosl",
							FieldType:  "text",
							Value:      header.NapomenaPoresko,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "39"})
					</div>
					<!-- Row 3: the nastanak PDV obaveze, as wide as the poreska kategorija above -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nastanakpdv",
							LabelText:  translator.Label("Nastanak PDV obaveze"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "nastanakpdv",
							Name:         "nastanakpdv",
							Placeholder:  translator.Placeholder("izaberite nastanak PDV obaveze"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "40",
							OptionValues: header.CbxNastanakPDV}, translator)
					</div>
					<!-- Row 4: the org. jedinica (its change reloads the mesta troška) with the mesto troška -->
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "idorgjed",
							LabelText:  translator.Label("Org. Jedinica"),
							ClassLabel: common.ClassLabel + " w-40 whitespace-nowrap",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:             "idorgjed",
							Name:           "idorgjed",
							Placeholder:    translator.Placeholder("izaberite organizacionu jedinicu"),
							Disabled:       false,
							ClassSelect:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:       "41",
							OptionValues:   header.CbxOrgjed,
							ChangeEndpoint: "/api/mestotroska",
							HxChangeTarget: "mestotrid",
							HxSwap:         "outerHTML",
						}, translator)
					</div>
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "mestotrid",
							LabelText:  translator.Label("Mesto troska"),
							ClassLabel: common.ClassLabel + " w-28 whitespace-nowrap",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "mestotrid",
							Name:         "mestotrid",
							Placeholder:  "izaberite mesto troska...",
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "42",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
							OptionValues: header.CbxMtroska,
						}, translator)
					</div>
				</div>
			</fieldset>
			<!-- Mesto isporuke, komercijalista, tender, napomena... (the second panel of the legacy box) -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Mesto isporuke, komercijalista, tender, napomena...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row: the mesto isporuke and the
				     komercijalista over the whole row, then the IF broj with the checkbox "Javna nabavka",
				     the BJKOS nosioca with the broj tendera and the KST and, in the last rows, the pairs of
				     the fields of the otprema (broj ugovora / narudžbenica, vozač / reg. br., bruto / neto
				     težina, broj kutija / broj paleta). Every label has the width of the labels of the panel
				     above (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Mesto isporuke -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "fispid",
							LabelText:  translator.Label("Mesto isporuke"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "fispid",
							Name:         "fispid",
							Placeholder:  translator.Placeholder("izaberite mesto isporuke"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "43",
							OptionValues: header.CbxMi,
						}, translator)
					</div>
					<!-- Komercijalista -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "komid",
							LabelText:  translator.Label("Komercijalista"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "komid",
							Name:         "komid",
							Placeholder:  translator.Placeholder("izaberite komercijalistu"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "44",
							OptionValues: header.CbxKomercijalista,
						}, translator)
					</div>
					<!-- Vozač, Reg. br. -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vozac",
							LabelText:  translator.Label("Vozač"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "vozac",
							Name:       "vozac",
							FieldType:  "text",
							Value:      header.Vozac,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "40",
							TabIndex:   "45"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "regbr",
							LabelText:  translator.Label("Reg. br."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "regbr",
							Name:       "regbr",
							FieldType:  "text",
							Value:      header.RegBr,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "46"})
					</div>
					<!-- Bruto težina, Neto težina -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brutotezina",
							LabelText:  translator.Label("Bruto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brutotezina",
							Name:       "brutotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.BrutoTezina, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "47"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "netotezina",
							LabelText:  translator.Label("Neto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "netotezina",
							Name:       "netotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.NetoTezina, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "48"})
					</div>
					<!-- Broj kutija, Broj paleta -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojkutija",
							LabelText:  translator.Label("Broj kutija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojkutija",
							Name:       "brojkutija",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojKutija),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "49"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojpaleta",
							LabelText:  translator.Label("Broj paleta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojpaleta",
							Name:       "brojpaleta",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojPaleta),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "50"})
					</div>
					<!-- checkbox "Javna nabavka",  -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "javnanabavka",
							Name:              "javnanabavka",
							LabelText:         translator.Label("Javna nabavka"),
							ClassLabel:        common.ClassLabel,
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.JavnaNabavka,
							Disabled:          header.Snimljen,
							TabIndex:          "51"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "jbkjsnosilac",
							LabelText:  translator.Label("JBKJS nosioca"),
							ClassLabel: common.ClassLabel + " w-32 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "jbkjsnosilac",
							Name:       "jbkjsnosilac",
							FieldType:  "text",
							Value:      header.JBKJNosioc,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							MaxLength:  "20",
							TabIndex:   "52"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojtendera",
							LabelText:  translator.Label("Broj tendera"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojtendera",
							Name:       "brojtendera",
							FieldType:  "text",
							Value:      header.BrojTendera,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "53"})
					</div>
				</div>
			</fieldset>
			<!-- Finansijsko stanje kupca -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Finansijsko stanje kupca") }</legend>
				<div class="grid grid-cols-2 gap-x-4 gap-y-1">
					<div class="flex flex-col">
						@RobnoFaktureReadOnly("ukrealiz", translator.Label("Realizovana"), robnoFaktureDecimal(header.UkRealiz, 2), translator)
						@RobnoFaktureReadOnly("placeno", translator.Label("Plaćeno"), robnoFaktureDecimal(header.Placeno, 2), translator)
						@RobnoFaktureReadOnly("saldopartnera", translator.Label("Saldo"), robnoFaktureDecimal(header.Saldo, 2), translator)
						@RobnoFaktureReadOnly("dospelo", translator.Label("Dospelo"), robnoFaktureDecimal(header.Dospelo, 2), translator)
						@RobnoFaktureReadOnly("nedospelo", translator.Label("Nedospelo"), robnoFaktureDecimal(header.Nedospelo, 2), translator)
					</div>
					<div class="flex flex-col">
						@RobnoFaktureReadOnly("ukrealizrob", translator.Label("Realizovana roba"), robnoFaktureDecimal(header.UkRealizRob, 2), translator)
						@RobnoFaktureReadOnly("dospelorob", translator.Label("Dospelo roba"), robnoFaktureDecimal(header.DospeloRob, 2), translator)
						@RobnoFaktureReadOnly("nedospelorob", translator.Label("Nedospelo roba"), robnoFaktureDecimal(header.NedospeloRob, 2), translator)
						@RobnoFaktureReadOnly("ukdospelo", translator.Label("Ukupno dospelo"), robnoFaktureDecimal(header.UkDospelo, 2), translator)
						@RobnoFaktureReadOnly("uknedospelo", translator.Label("Ukupno nedospelo"), robnoFaktureDecimal(header.UkNedospelo, 2), translator)
						@RobnoFaktureReadOnly("uksaldo", translator.Label("Ukupno saldo"), robnoFaktureDecimal(header.UkSaldo, 2), translator)
					</div>
				</div>
			</fieldset>
			<!-- Avansi: the grid of the avansi the legacy window shows next to the finansijsko stanje -->
			if avansiTbl.TableID != "" {
				<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col h-40 min-h-0 overflow-hidden">
					@components.Search_Part(avansiTbl, domain.InputControl{})
					<div class="flex-1 min-h-0 overflow-auto">
						@components.Table(avansiTbl, translator)
					</div>
				</div>
			}
			<!-- ===== End of the right column and of the two column layout ===== -->
		</div>
	</div>
}

// RobnoFaktureReadOnly renders one read only label + value row (the strips of the header and the
// "Finansijsko stanje kupca" panel). The value is right aligned like the numeric cells of the grids.
templ RobnoFaktureReadOnly(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-40"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right"})
	</div>
}

// RobnoFaktureReadOnlyStrip renders a read only strip of two lines: the first line is the label of
// every field, the second one its value (the two row grid header of the legacy windows). The values are
// disabled inputs, so the script of the screen (RobnoFaktureScript) treats them like the other read
// only values of the form and never enables them.
templ RobnoFaktureReadOnlyStrip(fields []domain.RobnoFaktureStripField) {
	<table class="w-full table-fixed border-collapse">
		<thead>
			<tr>
				for _, f := range fields {
					<th class={ "border border-blue-400 bg-blue-200 px-1 py-0.5 text-xs font-normal text-blue-900 whitespace-nowrap " + f.WidthClass }>{ f.Label }</th>
				}
			</tr>
		</thead>
		<tbody>
			<tr>
				for _, f := range fields {
					<td class="border border-blue-400 bg-blue-100 px-0.5 py-0.5 align-middle">
						<input
							id={ f.ID }
							name={ f.ID }
							type="text"
							value={ f.Value }
							disabled
							class={ common.ClassInputTextDisabled + " " + f.AlignClass }
						/>
					</td>
				}
			</tr>
		</tbody>
	</table>
}

// RobnoFaktureStavkePanel renders the second collapsible control: the entry form of one stavka and the
// grid of the stavke of the dokument. The control is closed and disabled until the header is saved.
templ RobnoFaktureStavkePanel(ui domain.RobnoFaktureUI, tbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoFakturePanel(ui.StavkePanelID, translator.Label("Stavke fakture"), robnoFaktureStavkeStateText(header.Snimljen, translator), header.Snimljen, header.Snimljen, RobnoFaktureStavkeFields(ui, tbl, stavka, searchInput, translator), RobnoFaktureStavkeButtons(btns))
}

// RobnoFaktureStavkeFields is the body of the stavke control: the kupac and the podaci o dokumentu of
// the header (read only), the entry form of the stavka and the grid of the stavke.
templ RobnoFaktureStavkeFields(ui domain.RobnoFaktureUI, tbl domain.TableData, stavka domain.RobnoFaktureStavka, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- KUPAC + Podaci o dokumentu: the two read only panels of the legacy window -->
	<div class="grid grid-cols-2 gap-1">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Kupac") }</legend>
			<div class="grid grid-cols-2 gap-x-2 gap-y-1">
				@RobnoFaktureReadOnly("kupacmagacin", translator.Label("Konto magacina"), stavka.KontoMagacina, translator)
				@RobnoFaktureReadOnly("kupackontostavke", translator.Label("Konto kupca"), stavka.KontoKupca, translator)
			</div>
		</fieldset>
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
			<div class="grid grid-cols-3 gap-x-2 gap-y-1">
				@RobnoFaktureReadOnly("vrdstavke", translator.Label("Vrsta dokumenta"), stavka.Vrd, translator)
				@RobnoFaktureReadOnly("brdokstavke", translator.Label("Broj dokumenta"), stavka.Brdok, translator)
				@RobnoFaktureReadOnly("datumdokumenta", translator.Label("Datum dokumenta"), stavka.DatumDokumenta, translator)
			</div>
		</fieldset>
	</div>
	<!-- Stavka -->
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Stavka") }</legend>
		<div class="grid grid-cols-3 gap-x-3">
			<!-- First column of the legacy window: the article, its tarifa, the količina and the cene -->
			<div class="flex flex-col">
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "sifraartikla",
						LabelText:  translator.Label("Šifra artikla"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "sifraartikla",
						Name:       "sifraartikla",
						FieldType:  "text",
						Value:      stavka.SifraArtikla,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "10",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
