package robno

import (
	"strconv"

	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

// RobnoDokumentaMain renders the "Robna dokumenta" option (robni nalozi / robni dokumenti).
// The first tab ("Unos dokumenta") is rendered inside the container that the tab navigation
templ RobnoDokumentaMain(hxValsTipdok, hxValsNalog string, tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog domain.Button, searchInput domain.InputControl, translator *i18n.Service, csrfToken string) {
	<div id="robno-dokumenta-content" class="flex flex-col h-full">
		@RobnoDokumentaUnos(hxValsTipdok, hxValsNalog, tabs, subTabs, tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, searchInput, translator, csrfToken)
		<!-- The dialog of the screen of the entry of the documents of the saved nalog (or the message
		     that the screen is not installed), opened by RobnoDokumentaOtvoriDokumentScript. -->
		<div id={ robnoDokumentaDokumentDialogID }></div>
	</div>
	@RobnoDokumentaOtvoriDokumentScript()
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.CloseDialogScript()
	@tmpl.HandleNextNalogResponseScript()
	@tmpl.HandleUpdateNalogDataResponseScript()
	@tmpl.HandleTipdokAfterRequestScript()
	@tmpl.HandleDblClickNalogSelectionScript()
	@tmpl.SelectRowScript()
	@tmpl.OpenPrintWithParamsScript()
	@tmpl.EnableDisableFieldsScripts()
}

// RobnoDokumentaShell renders the tab bar of the option - followed by the sub-tab bar when the
// active tab has sub-tabs - and then the body of the active tab. Every tab uses it so the
// navigation markup stays in one place.
templ RobnoDokumentaShell(tabs, subTabs domain.TabData, translator *i18n.Service, body templ.Component) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<!-- Tab navigation -->
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robna dokumenta"), tabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
		</div>
		<!-- Sub-tab navigation of the active tab (not rendered while it has no sub-tabs) -->
		if len(subTabs.Tabs) > 0 {
			<div class="border-b border-blue-600 pt-1">
				@tmpl.TabNav("", subTabs, "#robno-dokumenta-content", "robno-dokumenta-panel", translator)
			</div>
		}
		<!-- Tab body -->
		<div class="flex-1 min-h-0 flex flex-col gap-1">
			@body
		</div>
		<!-- Staging element of the error dialogs of the tabs (utils.RenderDialogOK) -->
		<div id="robnodokumenta-infomessage"></div>
	</div>
}

// RobnoDokumentaEmptyBody is the placeholder body of a tab that is not implemented yet: an empty
// parameter box and an empty grid. It is replaced by the real content of the tab as soon as the
// tab is built.
templ RobnoDokumentaEmptyBody(tabLabel string, tbl domain.TableData, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters - TODO: parameters of the tab -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-2 gap-1 items-start">
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="p-1 text-sm text-gray-600">{ tabLabel } - TODO</div>
			</fieldset>
		</div>
		<div class="flex justify-end gap-1 pt-2">
			@components.Button(btnObrada)
			@components.Search_PartPrintButton(btnPrint)
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 1 - Unos dokumenta
templ RobnoDokumentaUnos(hxValsTipdok, hxValsNalog string, tabs, subTabs domain.TabData, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog domain.Button, searchInput domain.InputControl, translator *i18n.Service, csrfToken string) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaUnosForm(hxValsTipdok, hxValsNalog, tbl, tipdokValues, vrstaDokumentaValues, magValues, total, payload, btnSave, btnNoviNalog, searchInput, translator, csrfToken))
}

// RobnoDokumentaUnosForm renders the header of the robni nalog ("Vrsta naloga za knjiženje",
// "Vrsta dokumenta", "Datum obrade", "Broj naloga", "Datum naloga", "Opis knjiženja" i "Magacin"),
// the "Prikaz ukupne obrade" panel and the grid of the nalozi of the selected vrsta naloga.
templ RobnoDokumentaUnosForm(hxValsTipdok, hxValsNalog string, tbl domain.TableData, tipdokValues, vrstaDokumentaValues, magValues []domain.ComboItem, total domain.RobnoDokumentaTotal, payload domain.RobnoDokumentaParams, btnSave, btnNoviNalog domain.Button, searchInput domain.InputControl, translator *i18n.Service, csrfToken string) {
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2 items-stretch">
			<!-- Header of the nalog -->
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- The CSRF token of the session: in the header of the requests of the form (hx-headers) and as
				     the field _csrf, so the POST/PUT of the nalog (the confirm and the save, whose buttons include
				     the form) pass the CSRF check, like the form of the "Nalozi" screen. -->
				<form
					id="robno-dokumenta-unos-form"
					hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }
					onsubmit="return false;"
				>
					<input type="hidden" name="_csrf" value={ csrfToken }/>
					<!-- Next broj naloga of the selected vrsta naloga: fired when the vrsta naloga changes
					     and answered by handleNextNalogResponse, like the "Nalozi" screen -->
					<div
						id="nalog-trigger"
						hx-get="/api/robno-dokumenta/nextnalog"
						hx-trigger="tipdokChanged"
						hx-vals='js:{"tipdok": document.getElementById("tipdok").value}'
						hx-on::after-request="handleNextNalogResponse('robno-dokumenta-unos-form')"
						style="display:none;"
					></div>
					<!-- Magacin: TODO: the legacy "+" and "..." buttons next to the combo -->
					@RobnoDokumentaUnosMagCombo(magValues, payload.MagaciniID, false, translator)
					<!-- Vrsta naloga za knjiženje: changing it reloads the grid and, through the trigger
					     above, the broj naloga of the new vrsta naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "tipdok",
							LabelText:  translator.Label("Vrsta naloga za knjiženje"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:               "tipdok",
							Name:             "tipdok",
							HasLabel:         false,
							ClassSelect:      common.ClassInputTextEnabled + " flex-1",
							OptionValues:     tipdokValues,
							SelectedValue:    payload.Tipdok,
							ChangeEndpoint:   "/api/robno-dokumenta/unos",
							HxChangeTarget:   "robno-dokumenta-unos-table",
							HxSwap:           "innerHTML",
							HxVals:           hxValsTipdok,
							HxOnAfterRequest: "handleTipdokAfterRequest",
							TabIndex:         "2",
						}, translator)
					</div>
					<!-- Vrsta dokumenta: TODO: the legacy "+" and "..." buttons next to the combo -->
					@RobnoDokumentaUnosVrdCombo(vrstaDokumentaValues, payload.Vrd, false, translator)
					<!-- Datum obrade, Broj naloga i Datum naloga in one row. The label of Datum obrade
					     keeps the width of the labels of the other rows, so the fields are aligned. -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datob",
							LabelText:  translator.Label("Datum obrade"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datob",
							Name:       "datob",
							FieldType:  "date",
							Value:      payload.Datob,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
						<!-- Broj naloga: when the user leaves it, the data of an existing nalog is loaded -->
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nalog",
							LabelText:  translator.Label("Broj naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:               "nalog",
							Name:             "nalog",
							FieldType:        "text",
							Value:            payload.Nalog,
							ClassInput:       common.ClassInputTextEnabled + " flex-1 min-w-0",
							HxGet:            "/api/robno-dokumenta/nalog-data",
							HxTrigger:        "blur delay:100ms",
							HxInclude:        "select[name='tipdok']",
							HxVals:           hxValsNalog,
							HxSwap:           "none",
							HxOnAfterRequest: "handleUpdateNalogDataResponse",
							MinLength:        "1",
							MaxLength:        "10",
							TabIndex:         "5",
							OnInput:          "clearFieldError",
							OnFocus:          "clearFieldError"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "danal",
							LabelText:  translator.Label("Datum naloga"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "danal",
							Name:       "danal",
							FieldType:  "date",
							Value:      payload.Danal,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "6",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Opis knjiženja -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis knjiženja"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      payload.Opis,
							ClassInput: common.ClassInputTextEnabled + " flex-1",
							MinLength:  "0",
							MaxLength:  "120",
							TabIndex:   "7"})
					</div>
					<!-- Buttons -->
					<div class="flex justify-end gap-1 pt-1">
						@components.SaveButton(btnSave, translator)
						@components.AddButton(btnNoviNalog, translator)
					</div>
				</form>
			</fieldset>
			<!-- Prikaz ukupne obrade -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Prikaz ukupne obrade") }</legend>
				@RobnoDokumentaUnosTotalRow("ukupnoNaloga", translator.Label("Ukupno naloga"), total.UkNaloga, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDokumenata", translator.Label("Ukupno dokumenata"), total.UkDokumenata, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoStavki", translator.Label("Ukupno stavki"), total.UkStavki, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoDuguje", translator.Label("Duguje"), total.Duguje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoPotrazuje", translator.Label("Potražuje"), total.Potrazuje, translator)
				@RobnoDokumentaUnosTotalRow("ukupnoSaldo", translator.Label("Saldo"), total.Saldo, translator)
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
	<!-- Staging element of the confirm dialog of the save (like the "Nalozi" screen) -->
	<div id="dialog-confirm" class="top-0 z-50"></div>
}

// RobnoDokumentaUnosTotalRow renders one read only row of the "Prikaz ukupne obrade" panel. The
// value is right aligned and bold, like the numeric cells of the grids.
templ RobnoDokumentaUnosTotalRow(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-[60%]"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right font-bold",
		})
	</div>
}

// RobnoDokumentaUnosVrdCombo renders the combo of the vrsta dokumenta of the unos dokumenata. With oob
// it replaces the combo of the page out of band (the response to the change of the vrsta naloga, the
// legacy PostaviComboBoxes).
templ RobnoDokumentaUnosVrdCombo(values []domain.ComboItem, selected string, oob bool, translator *i18n.Service) {
	<div
		id="robno-dokumenta-unos-vrd"
		class="flex items-center gap-1 mb-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		@components.LabelField(domain.LabelFieldConfig{
			ID:         "vrd",
			LabelText:  translator.Label("Vrsta dokumenta"),
			ClassLabel: common.ClassLabel + " w-44",
		})
		@components.ComboBoxField(domain.ComboFieldConfig{
			ID:            "vrd",
			Name:          "vrd",
			HasLabel:      false,
			ClassSelect:   common.ClassInputTextEnabled + " flex-1",
			OptionValues:  values,
			SelectedValue: selected,
			TabIndex:      "3",
		}, translator)
	</div>
}

// RobnoDokumentaUnosMagCombo renders the combo of the magacin of the unos dokumenata (with oob out of
// band, see RobnoDokumentaUnosVrdCombo).
templ RobnoDokumentaUnosMagCombo(values []domain.ComboItem, magaciniID int, oob bool, translator *i18n.Service) {
	<div
		id="robno-dokumenta-unos-mag"
		class="flex items-center gap-1 mb-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		@components.LabelField(domain.LabelFieldConfig{
			ID:         "magaciniid",
			LabelText:  translator.Label("Magacin"),
			ClassLabel: common.ClassLabel + " w-44",
		})
		@components.ComboBoxField(domain.ComboFieldConfig{
			ID:            "magaciniid",
			Name:          "magaciniid",
			HasLabel:      false,
			ClassSelect:   common.ClassInputTextEnabled + " flex-1",
			OptionValues:  values,
			SelectedValue: magaciniSelection(magaciniID),
			TabIndex:      "1",
		}, translator)
	</div>
}

// magaciniSelection returns the key of the selected magacin ("" when no magacin is selected).
// robnoDokumentaDokumentDialogID is the container of the dialog of the screen of the entry of the
// documents of a nalog (see RobnoDokumentaOtvoriDokumentScript).
const robnoDokumentaDokumentDialogID = "robno-dokumenta-dokument-dialog"

// RobnoDokumentaOtvoriDokumentScript opens the screen of the entry of the documents after the nalog is
// saved ("Snimi nalog"): the response of the save carries the event robnoNalogSnimljen with the url of
// the screen, which is loaded into the dialog container of the tab. The listener is installed once.
templ RobnoDokumentaOtvoriDokumentScript() {
	<script>
		if (!window.robnoDokumentaOtvoriDokumentInstalled) {
			window.robnoDokumentaOtvoriDokumentInstalled = true;
			document.body.addEventListener('robnoNalogSnimljen', function (evt) {
				const url = evt.detail && evt.detail.url;
				// The confirm dialog of the save is closed first (the update has no after-request hook).
				const zatvori = evt.detail && evt.detail.zatvori;
				if (zatvori && typeof closeDialog === 'function' && document.getElementById(zatvori)) closeDialog(zatvori);
				if (!url || !document.getElementById('robno-dokumenta-dokument-dialog')) return;
				htmx.ajax('GET', url, { target: '#robno-dokumenta-dokument-dialog', swap: 'innerHTML' });
			});
		}
	</script>
}

func magaciniSelection(magaciniID int) string {
	if magaciniID <= 0 {
		return ""
	}
	return strconv.Itoa(magaciniID)
}

//
// Tab 2 - Pregled dokumenta (sub-tabs "Štampa" and "eFaktura")
//

// RobnoDokumentaPregled renders the "Štampa" sub-tab of "Pregled dokumenta": the filters (magacin,
// vrsta dokumenta and the range of the dates of the nalog), the buttons "Obradi" and "Štampaj" and
// the grid of the robni dokumenti with the partner of every document.
templ RobnoDokumentaPregled(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaPregledBody(tbl, magValues, vrstaDokumentaValues, params, btnObrada, btnPrint, searchInput, translator))
}

// RobnoDokumentaPregledBody renders the body of the "Štampa" sub-tab. The parameters (left) and the
// "Obrada i štampa" panel (right) have the same height, like the header of the "Unos dokumenta" tab.
templ RobnoDokumentaPregledBody(tbl domain.TableData, magValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Magacin -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magaciniid",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "magaciniid",
							Name:          "magaciniid",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  magValues,
							SelectedValue: magaciniSelection(params.MagaciniID),
							TabIndex:      "1",
						}, translator)
					</div>
					<!-- Od datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2", OnInput: "clearFieldError",
							OnFocus: "clearFieldError"})
					</div>
					<!-- Vrsta dokumenta -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vrd",
							LabelText:  translator.Label("Vrsta dokumenta"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "vrd",
							Name:          "vrd",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1",
							OptionValues:  vrstaDokumentaValues,
							SelectedValue: params.Vrd,
							TabIndex:      "3",
						}, translator)
					</div>
					<!-- Do datuma naloga -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma naloga"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "4",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Obrada i štampa") }</legend>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex items-center justify-end gap-1 mt-auto mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Search_PartPrintButton(btnPrint)
				</div>
				<!-- The rdokid of the row selected in the grid: the "Štampaj" button prints its faktura
				     (empty: the fakture of the whole filter). -->
				<input type="hidden" id="rdokid" name="rdokid" value=""/>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
	@RobnoDokumentaPregledSelectScript()
}

// RobnoDokumentaPregledSelectScript selects the document of the "Štampa" sub-tab whose faktura the
// "Štampaj" button prints: a click on a row of the grid selects it (its data-row-id is the rdokid
// of the document) and a second click clears the selection. A reload of the grid (search, paging,
// "Obrada") clears the selection when the selected row is no longer shown.
templ RobnoDokumentaPregledSelectScript() {
	<script>
		function robnoPregledSelectDokument(row) {
			const input = document.getElementById("rdokid");
			const wasSelected = row.classList.contains("table-row-selected");
			const table = row.closest("table") || document;
			table.querySelectorAll("tr.table-row-selected").forEach(r => r.classList.remove("table-row-selected"));
			if (wasSelected) {
				if (input) input.value = "";
				return;
			}
			row.classList.add("table-row-selected");
			if (input) input.value = row.dataset.rowId || "";
		}
		if (!window.robnoPregledSelectListener) {
			window.robnoPregledSelectListener = true;
			document.body.addEventListener("htmx:afterSwap", function () {
				const input = document.getElementById("rdokid");
				if (input && input.value && !document.querySelector("tr.table-row-selected[data-row-id='" + input.value + "']")) {
					input.value = "";
				}
			});
		}
	</script>
}

// RobnoDokumentaEFaktura renders the "eFaktura" sub-tab of "Pregled dokumenta": the filters (grupe
// dokumenata and the range of the dates of the documents), the actions of the eFaktura, the date of
// the ažuriranje statusa and the grid with the status of every document.
templ RobnoDokumentaEFaktura(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoDokumentaEFakturaBody(tbl, params, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus, searchInput, translator))
}

// RobnoDokumentaEFakturaBody renders the body of the "eFaktura" sub-tab. The parameters with the
// actions (left) and the "Status eFaktura" panel (right) have the same height, like the header of
// the "Unos dokumenta" tab.
templ RobnoDokumentaEFakturaBody(tbl domain.TableData, params domain.RobnoDokumentaParams, btnObrada, btnPosalji, btnProveri, btnOtkazi, btnStorniraj, btnStornirajPE, btnAzurirajStatus domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Parameters and actions -->
	<div class="no-border bg-blue-100 rounded-lg">
		<div class="grid grid-cols-3 gap-2">
			<fieldset class="col-span-2 border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
				<!-- Grupe dokumenata -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "grupedokumenata",
						LabelText:  translator.Label("Grupe dokumenata"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "grupedokumenata",
						Name:       "grupedokumenata",
						FieldType:  "text",
						Value:      params.GrupeDokumenata,
						ClassInput: common.ClassInputTextEnabled + " flex-1",
						MaxLength:  "120",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="grid grid-cols-2 gap-x-2">
					<!-- Od datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oddanal",
							LabelText:  translator.Label("Od datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oddanal",
							Name:       "oddanal",
							FieldType:  "date",
							Value:      params.OdDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "2",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
					<!-- Do datuma -->
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dodanal",
							LabelText:  translator.Label("Do datuma"),
							ClassLabel: common.ClassLabel + " w-44",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dodanal",
							Name:       "dodanal",
							FieldType:  "date",
							Value:      params.DoDanal,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "3",
							OnInput:    "clearFieldError",
							OnFocus:    "clearFieldError"})
					</div>
				</div>
				<!-- Obrada and the actions of the eFaktura -->
				<div class="flex flex-wrap items-center justify-end gap-1 mb-1">
					@components.FormObradaButton(btnObrada, translator)
					@components.Button(btnPosalji)
					@components.Button(btnProveri)
					@components.Button(btnStornirajPE)
				</div>
			</fieldset>
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Status eFaktura") }</legend>
				<!-- Datum za ažuriranje statusa -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "datumstatusa",
						LabelText:  translator.Label("Datum za ažuriranje statusa"),
						ClassLabel: common.ClassLabel + " w-44",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "datumstatusa",
						Name:       "datumstatusa",
						FieldType:  "date",
						Value:      params.DatumStatusa,
						ClassInput: common.ClassInputTextEnabled + " w-32",
						TabIndex:   "4"})
				</div>
				<!-- The buttons are aligned to the bottom of the panel, like the parameters on the left -->
				<div class="flex flex-wrap items-center justify-end gap-1 mt-auto mb-1">
					@components.Button(btnOtkazi)
					@components.Button(btnStorniraj)
					@components.Button(btnAzurirajStatus)
				</div>
			</fieldset>
		</div>
	</div>
	<!-- Group Data Table -->
	<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table -->
		<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// Tab 3 - Specifikacije dokumenta
//
// The tab prints the specification of the documents of the selection (the report depends on the group
templ RobnoDokumentaSpecifikacije(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, tipdokValues, vrstaDokumentaValues []domain.ComboItem, params domain.RobnoDokumentaParams, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
