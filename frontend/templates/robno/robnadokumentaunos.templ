package robno

// The screens of the entry of the robni dokumenti of a robni nalog (the legacy windows opened by
// "Snimi nalog" of the "Unos dokumenta" tab, by the group of the vrsta dokumenta; see the handler
// RobnoDokumentaUnosHandler). For now: the "Fakture veleprodaje" screen (the groups FAK, FRP, KPK and
// FZR, the legacy rob_Fakture).

import (
	"database/sql"
	"encoding/json"
	"strconv"
	"strings"
	"time"

	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

//
// Fakture veleprodaje - the header of the faktura and its stavke
// RobnoFakture renders the "Fakture veleprodaje" screen: the two collapsible controls inside the shell
// of "Robna dokumenta" (tabs and sub-tabs) and the script that switches the editable control.
templ RobnoFakture(ui domain.RobnoFaktureUI, tabs, subTabs domain.TabData, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator))
	<!-- Scripts the screen shares with the other robno forms: the search popups (F3 / "...") and the
	     inline validation errors -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@tmpl.EnterNavigationScript()
	@RobnoFaktureScript()
}

// Rob_Fakture renders the "Fakture veleprodaje" screen (the legacy rob_Fakture) as a dialog with two
// tabs (RobnoDokumentDialog): "Fakture", the entry of the faktura (the header and the stavke as two
// collapsible controls on one screen), and "Prikaz faktura", the documents of the nalog with the stavke
// of the selected one (RobnoFakturePrikaz). The dialog is not removed when it is closed (closeDialog
// only hides it, so that the fade-out is visible): the next request renders it again.
templ Rob_Fakture(ui domain.RobnoFaktureUI, tbl, avansiTbl, dokumentaTbl, dokumentStavkeTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, btnClose domain.Button, searchInput domain.InputControl, translator *i18n.Service, csrfToken string) {
	@RobnoDokumentDialog(ui.DialogID, translator.Label("Fakture veleprodaje"), translator.Label("Fakture"), translator.Label("Prikaz faktura"), btnClose, csrfToken,
		RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator),
		RobnoFakturePrikaz(ui, dokumentaTbl, dokumentStavkeTbl, domain.InputControl{}, translator))
	<!-- The messages of the screen (e.g. why the selected document cannot be changed) -->
	<div id={ ui.InfoID }></div>
	@RobnoFaktureScript()
}

// RobnoFaktureInfo is the message of the screen sent with the reloaded content (an out of band swap
// into the element infoID), e.g. why the selected document cannot be changed.
templ RobnoFaktureInfo(infoID, message string, dialog domain.Dialog, btnClose, btnOk domain.Button, translator *i18n.Service) {
	<div id={ infoID } hx-swap-oob="innerHTML">
		@tmpl.DialogOk(message, dialog, btnClose, btnOk, translator)
	</div>
}

// RobnoDokumentDialog is the dialog of the screens of the entry of the robni dokumenti (the windows the
// legacy "Snimi nalog" opens): the title bar with the "Zatvori" button and two tabs, the entry of the
// document (unos) and the list of the documents of the nalog (prikaz). The tabs are switched in the
// browser (robnoDokumentTab), so the entered data stay in the form. The CSRF token of the session goes
// in the header of the requests of the dialog, like the forms of the other screens.
templ RobnoDokumentDialog(dialogID, title, tabUnos, tabPrikaz string, btnClose domain.Button, csrfToken string, unos, prikaz templ.Component) {
	<div id={ dialogID } class={ common.ClassMainDialogDiv } hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }>
		<div class="bg-blue-100 rounded-lg shadow-2xl flex flex-col w-[95vw] h-[90vh]">
			<!-- Title bar of the dialog -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg flex-shrink-0">
				<h2 class="text-lg font-semibold ml-4">{ title }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- The two tabs (styled like the tabs of the other screens, templates.TabNav) -->
			<nav class="py-1 px-1 h-8 text-sm font-medium text-gray-700 flex items-center gap-1 whitespace-nowrap flex-shrink-0" aria-label="Tabs">
				<button
					type="button"
					data-robno-tab="0"
					data-active-class={ common.ClassDialogTabActive }
					data-inactive-class={ common.ClassDialogTabInactive }
					aria-selected="true"
					onclick={ templ.JSFuncCall("robnoDokumentTab", dialogID, 0) }
					class={ robnoDokumentTabClass(true) }
				>{ tabUnos }</button>
				<button
					type="button"
					data-robno-tab="1"
					data-active-class={ common.ClassDialogTabActive }
					data-inactive-class={ common.ClassDialogTabInactive }
					aria-selected="false"
					onclick={ templ.JSFuncCall("robnoDokumentTab", dialogID, 1) }
					class={ robnoDokumentTabClass(false) }
				>{ tabPrikaz }</button>
			</nav>
			<div data-robno-panel="0" class="flex-1 min-h-0 overflow-auto p-1">
				@unos
			</div>
			<div data-robno-panel="1" class="flex-1 min-h-0 overflow-auto p-1" hidden>
				@prikaz
			</div>
		</div>
	</div>
	@robnoDokumentDialogScript.Once() {
		<script>
			// Shows the tab index of the dialog of a robni dokument and hides the other one.
			function robnoDokumentTab(dialogID, index) {
				const dialog = document.getElementById(dialogID);
				if (!dialog) return;
				dialog.querySelectorAll('[data-robno-panel]').forEach(p => { p.hidden = p.dataset.robnoPanel !== String(index); });
				dialog.querySelectorAll('[data-robno-tab]').forEach(t => {
					const active = t.dataset.robnoTab === String(index);
					t.className = active ? t.dataset.activeClass : t.dataset.inactiveClass;
					t.setAttribute('aria-selected', active ? 'true' : 'false');
				});
				// The content of the shown tab that is filled when it is shown (data-on-show: the function
				// that loads it, called with the element).
				const panel = dialog.querySelector('[data-robno-panel="' + index + '"]');
				const hook = panel && panel.querySelector('[data-on-show]');
				if (hook && typeof window[hook.dataset.onShow] === 'function') window[hook.dataset.onShow](hook);
			}
		</script>
	}
	<!-- The scripts of the search popups, of the inline validation errors and of Enter that moves to the
	     next field of the forms with data-enter-nav (the dialog is rendered on its own, so it installs
	     them itself; every screen of the robni dokumenti uses this dialog) -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleBackendResponseScript()
	@tmpl.OpenPrintWithParamsScript()
	@components.SpinnerScript()
	@tmpl.EnterNavigationScript()
}

var robnoDokumentDialogScript = templ.NewOnceHandle()

// robnoDokumentTabClass returns the class of a tab of RobnoDokumentDialog (common.ClassDialogTabActive
// or common.ClassDialogTabInactive). Every tab carries both (data-active-class and data-inactive-class),
// so the script robnoDokumentTab switches them without repeating them.
func robnoDokumentTabClass(active bool) string {
	if active {
		return common.ClassDialogTabActive
	}
	return common.ClassDialogTabInactive
}

// RobnoFakturePrikaz renders the "Prikaz faktura" tab: the documents of the nalog (DOKUMENTA) and the
// stavke of the selected document (STAVKE DOKUMENTA), like the second tab of the legacy window.
// The content is reloaded every time the tab is shown (data-on-show: robnoFakturePrikazUcitaj, called by
// robnoDokumentTab), with the documents of the vrsta of the screen (the nalog and the vrsta of the content
// of the first tab, data-body-id); a click of a row of the documents loads its stavke into the container
// ui.PrikazStavkeID and selects the document "Štampaj" prints (data-stampa-id). Every screen of the robni
// dokumenti uses it (the faktura, the interni prenos) with its own ids.
templ RobnoFakturePrikaz(ui domain.RobnoFaktureUI, dokumentaTbl, dokumentStavkeTbl domain.TableData, searchInput domain.InputControl, translator *i18n.Service) {
	<div
		id={ ui.PrikazID }
		data-on-show="robnoFakturePrikazUcitaj"
		data-url={ ui.PrikazURL }
		data-body-id={ ui.BodyID }
		data-stampa-id={ ui.PrikazStampaID }
		class="flex flex-col gap-1 h-full min-h-0"
	>
		<!-- The selected document (the rdokid the print button sends; kept when the grid is reloaded) -->
		<input type="hidden" id={ ui.PrikazRdokID } name="rdokid" value=""/>
		<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 basis-1/2 overflow-hidden">
			<!-- The title and the search of the documents (the search and the pagination of the grid reload
			     the grid only) -->
			<div class="flex items-center justify-between gap-2">
				<div class="font-semibold text-sm text-blue-900 uppercase px-1">{ translator.Label("Dokumenta") }</div>
				<div class="flex-1">
					@components.Search_Part(robnoTabelaBezNaslova(dokumentaTbl), searchInput)
				</div>
			</div>
			if dokumentaTbl.TableID != "" {
				<div class="flex-1 min-h-0 overflow-auto">
					@components.Table(dokumentaTbl, translator)
				</div>
			}
		</div>
		<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 basis-1/2 overflow-hidden">
			<div class="font-semibold text-sm text-blue-900 uppercase px-1">{ translator.Label(robnoPrikazStavkeNaslov(ui)) }</div>
			<div id={ ui.PrikazStavkeID } class="flex-1 min-h-0 overflow-auto">
				@RobnoFakturePrikazStavke(dokumentStavkeTbl, translator)
			</div>
		</div>
	</div>
	@robnoFakturePrikazScript.Once() {
		<script>
			// Fills the second tab of a screen (its content is replaced): the documents of the vrsta of the
			// screen (the nalog and the vrsta of the content of the first tab, data-body-id).
			function robnoFakturePrikazUcitaj(el) {
				const body = el && document.getElementById(el.dataset.bodyId);
				if (!el || !body || !el.dataset.url) return;
				htmx.ajax('GET', el.dataset.url, { target: el, swap: 'outerHTML',
					values: { rnalid: body.dataset.rnalid, vrd: body.dataset.vrd } });
			}

			// The click of a row of the documents selects the document to print (the hidden rdokid of the tab)
			// and enables "Štampaj" of the tab (data-stampa-id).
			function robnoFakturePrikazIzbor(row) {
				const prikaz = row && row.closest('[data-on-show="robnoFakturePrikazUcitaj"]');
				const rdokid = prikaz && prikaz.querySelector('input[type="hidden"][name="rdokid"]');
				if (!rdokid) return;
				rdokid.value = row.dataset.rowId || '';
				const btn = document.getElementById(prikaz.dataset.stampaId);
				if (btn && rdokid.value) btn.classList.remove('opacity-50', 'pointer-events-none');
			}

			// "Štampaj" of a tab without a selected document does nothing (also from the keyboard: the disabled
			// look stops the mouse only). The listener is installed once, before the onclick of the button.
			if (!window.robnoFakturePrikazStampaListener) {
				window.robnoFakturePrikazStampaListener = true;
				document.addEventListener('click', function (evt) {
					const btn = evt.target.closest && evt.target.closest('a[id], button[id]');
					const prikaz = btn && btn.closest('[data-on-show="robnoFakturePrikazUcitaj"]');
					if (!prikaz || prikaz.dataset.stampaId !== btn.id) return;
					const rdokid = prikaz.querySelector('input[type="hidden"][name="rdokid"]');
					if (rdokid && rdokid.value) return;
					evt.preventDefault();
					evt.stopImmediatePropagation();
				}, true);
			}
		</script>
	}
}

var robnoFakturePrikazScript = templ.NewOnceHandle()

// robnoPrikazStavkeNaslov is the title of the grid of the stavke of the second tab (the label of the screen,
// "Stavke dokumenta" without one).
func robnoPrikazStavkeNaslov(ui domain.RobnoFaktureUI) string {
	if ui.PrikazStavkeNaslov != "" {
		return ui.PrikazStavkeNaslov
	}
	return "Stavke dokumenta"
}

// robnoTabelaBezNaslova returns the grid without its title (for Search_Part next to the own title).
func robnoTabelaBezNaslova(tbl domain.TableData) domain.TableData {
	tbl.ContentTitle = ""
	return tbl
}

// RobnoFakturePrikazStavke renders the grid of the stavke of the selected document of the tab "Prikaz
// faktura" (the content of the container ui.PrikazStavkeID).
templ RobnoFakturePrikazStavke(tbl domain.TableData, translator *i18n.Service) {
	if tbl.TableID != "" {
		@components.Table(tbl, translator)
	}
}

// RobnoFaktureBody renders the content of the screen: the strip with the vrsta fakture, the first
// collapsible control (the header of the faktura) and the second one (the stavke).
templ RobnoFaktureBody(ui domain.RobnoFaktureUI, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- The selected or typed broj dokumenta reloads the content with its document (an existing one of
	     the nalog by its id, or a new one), like the legacy exit of EDT_DOKUM: robnoFaktureOtvoriDokument
	     and robnoFaktureNoviBroj read the urls, the nalog and the vrsta here. -->
	<div
		id={ ui.BodyID }
		data-stavke-aktivne={ robnoFaktureState(header.Snimljen) }
		data-dokument-url={ ui.DokumentURL }
		data-novi-url={ ui.NoviURL }
		data-rnalid={ strconv.FormatInt(header.RnalID, 10) }
		data-vrd={ header.Vrd }
		class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0"
	>
		@RobnoFaktureDokumentBar(header, btns.Print, btns.Back, translator)
		@RobnoFaktureHeaderPanel(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, translator)
		@RobnoFaktureStavkePanel(ui, tbl, header, stavka, btns, searchInput, translator)
	</div>
}

// RobnoFakturePanel is one of the two collapsible controls of the screen: a <details> element whose
// <summary> is the title bar. While the control is disabled its fields are not editable and its
// summary does not open it, so the user can see and change only the control that is currently active.
// The fields and the buttons are two slots: the script disables the controls of [data-panel-fields]
// only, so the buttons of the control (e.g. "Izmeni" of the header) stay clickable even when the
// control itself is locked. The fields of a disabled control carry the inert attribute, so they cannot
// be reached with the mouse or with the keyboard either. Enter moves through the fields like Tab
// (tmpl.EnterNavigationScript, data-enter-nav) and after the last one to the button saveID ("Sačuvaj").
templ RobnoFakturePanel(id, title, stateText string, open, enabled, fill bool, saveID string, akcija, fields, buttons templ.Component) {
	<details
		id={ id }
		open?={ open }
		data-enabled={ robnoFaktureState(enabled) }
		class={ "group w-full rounded-lg border border-blue-400 bg-blue-100" + robnoFakturePanelFill(fill, " robno-fill open:flex-1 open:min-h-0 open:flex open:flex-col") }
	>
		<summary
			onclick="return robnoFaktureCanToggle(this)"
			class="px-2 py-1 cursor-pointer select-none flex flex-shrink-0 items-center gap-1 bg-blue-200 rounded-t-lg font-semibold text-sm text-blue-900"
		>
			<span class="text-blue-700 transition-transform group-open:rotate-90">&#9654;</span>
			{ title }
			<!-- The state of the control and the action of the title bar (e.g. "Izmeni" of the header) -->
			<span class="ml-auto flex items-center gap-2">
				<span class="font-normal text-xs text-blue-800">{ stateText }</span>
				@akcija
			</span>
		</summary>
		<div class={ "p-1 flex flex-col gap-1" + robnoFakturePanelFill(fill, " flex-1 min-h-0") }>
			<!-- The fields of a disabled control are dimmed and do not accept the mouse: the same
			     classes robnoFaktureSetPanelEnabled toggles at runtime. -->
			<div
				data-panel-fields
				data-enter-nav={ saveID }
				inert?={ !enabled }
				if enabled {
					class={ "flex flex-col gap-1" + robnoFakturePanelFill(fill, " flex-1 min-h-0") }
				} else {
					class={ "flex flex-col gap-1 opacity-60 pointer-events-none" + robnoFakturePanelFill(fill, " flex-1 min-h-0") }
				}
			>
				@fields
			</div>
			<div class="flex items-center justify-end gap-1">
				@buttons
			</div>
		</div>
	</details>
}

// RobnoFaktureDokumentBar renders the strip above the two controls: the vrsta fakture (Otpremnica /
// Račun) with the checkbox "Štampaj detalje u stavkama" and the "Nazad" button, like the blue bar of
// the two WinDev windows. The radios are disabled while the header is saved (they belong to the
// header), the checkbox too.
templ RobnoFaktureDokumentBar(header domain.RobnoFaktureHeaderView, btnPrint, btnBack domain.Button, translator *i18n.Service) {
	<div class="flex items-center gap-2 border border-blue-400 bg-blue-100 rounded-lg px-1 py-0.5">
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="otpremnica"
				value="O"
				class={ common.ClassCheckbox }
				checked?={ header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-24" }>{ translator.Label("Otpremnica") }</span>
		</label>
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="racun"
				value="R"
				class={ common.ClassCheckbox }
				checked?={ !header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-16" }>{ translator.Label("Račun") }</span>
		</label>
		<div class="flex-1 flex justify-center">
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "stampajdetalje",
				Name:              "stampajdetalje",
				LabelText:         translator.Label("Štampaj detalje u stavkama"),
				ClassLabel:        common.ClassLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: "text-sm",
				IsChecked:         header.StampajDetalje,
				Disabled:          header.Snimljen,
				TabIndex:          "0"}, translator)
		</div>
		<!-- "Štampaj" of the document of the form: only a saved document (a new one has nothing to print) -->
		if header.RdokID > 0 {
			@components.Search_PartPrintButton(btnPrint)
		} else {
			<span class={ btnPrint.BtnClass + " opacity-50 cursor-not-allowed" } title={ translator.Message("Dokument nije sačuvan") }>
				@components.Icon("stampa", common.ClassIcon)
				{ btnPrint.LabelText }
			</span>
		}
		@components.Button(btnBack)
	</div>
}

// RobnoFaktureHeaderPanel renders the first collapsible control: the header of the faktura, i.e. the
templ RobnoFaktureHeaderPanel(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	@RobnoFakturePanel(ui.HeaderPanelID, translator.Label("Podaci o fakturi"), robnoFaktureHeaderStateText(header.Snimljen, translator), !header.Snimljen, !header.Snimljen, false, btns.Save.Id, RobnoFaktureIzmeniZaglavlje(btns.Modify, header.Snimljen), RobnoFaktureHeaderFields(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, translator), RobnoFaktureHeaderButtons(btns))
}

// RobnoFaktureHeaderFields renders the fields of the header of the faktura: the strip of the nalog,
templ RobnoFaktureHeaderFields(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, translator *i18n.Service) {
	<!-- Nalog: the read only strip both windows show above the form. It is laid out like the two row
	     header of the legacy window: the first line is the label of the field, the second one its value
	     (see robnoFaktureNalogStripFields). It spans both columns. -->
	<fieldset class="border border-blue-400 bg-blue-100">
		@RobnoFaktureReadOnlyStrip(robnoFaktureNalogStripFields(header, translator))
	</fieldset>
	<!-- The nalog and the document the header belongs to (sent with the header; the server reads the
	     vrsta, the broj and the magacin of the nalog; no ids: the tab "Unos dokumenta" under the dialog
	     has fields with the same names) -->
	<input type="hidden" name="rnalid" value={ strconv.FormatInt(header.RnalID, 10) }/>
	<input type="hidden" name="rdokid" value={ strconv.FormatInt(header.RdokID, 10) }/>
	<!-- The vrsta dokumenta (its field is read only, so disabled and not sent) -->
	<input type="hidden" name="vrd" value={ header.Vrd }/>
	<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-1">
		<!-- ===== Left column: podaci o dokumentu, podaci o kupcu, podaci o načinu otpreme ===== -->
		<div class="flex flex-col gap-1 min-w-0 h-full">
			<!-- Podaci o dokumentu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
				<div class="flex flex-col gap-y-1">
					<!-- Row 1: the vrsta dokumenta (read only - it is chosen on the "Unos dokumenta" tab) and the
			     broj dokumenta with the search of the robni dokumenti -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "vrd",
								Name:       "vrd",
								FieldType:  "text",
								Value:      header.Vrd,
								Disabled:   true,
								ClassInput: common.ClassInputTextDisabled + " w-80 min-w-0"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdok",
								LabelText:  translator.Label("Broj dokumenta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							<!-- The broj of the document for the save; the combo holds the id of the selected one. -->
							<input type="hidden" id="brdok" name="brdok" value={ header.BrojDokum }/>
							@components.TableCombo(domain.TableComboConfig{
								ID:           "brdok-combo",
								Name:         "brdokrdokid",
								ValueID:      "brdokrdokid",
								Value:        robnoFaktureID(header.RdokID),
								DisplayValue: header.BrojDokum,
								Placeholder:  "Pretraži po broju ili kupcu",
								ClassInput:   common.ClassInputTextEnabled + " w-full",
								SearchURL:    "/api/search/robni-dokumenti",
								// The documents of the vrsta in the nalog.
								HxVals: robnoFaktureDokumentSearchVals(header),
								// A selected row opens its document by the id; a typed broj opens its document, or a
								// new one with that broj.
								OnSelect:   "robnoFaktureOtvoriDokument",
								FreeText:   true,
								OnFreeText: "robnoFaktureNoviBroj",
								// Not disabled: the control of the header locks it (a disabled field would stay read
								// only after "Izmeni").
								TabIndex: "1",
							}, translator)
						</div>
					</div>
					<!-- Row 2: the datum fakturisanja, the broj and the datum of the izvorni dokument -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumfakturisanja",
								LabelText:  translator.Label("Datum fakturisanja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumfakturisanja",
								Name:       "datumfakturisanja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumDokum),
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdokorg",
								LabelText:  translator.Label("Broj orig. dokumenta"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "brdokorg",
								Name:       "brdokorg",
								FieldType:  "text",
								Value:      header.IzvorniDokum,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								MaxLength:  "20",
								TabIndex:   "3"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumizvora",
								LabelText:  translator.Label("Datum izvor. dokum."),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumizvora",
								Name:       "datumizvora",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.IzvorniDokDatum),
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "4"})
						</div>
					</div>
					<!-- Row 3: the opis -->
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      header.Opis,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "5"})
					</div>
					<!-- Row 4: the checkbox "Za period od / do" with its two dates, then the datum smanjenja (the fakture
					     usluga: only the knjižno pismo finansijsko, the datum smanjenja of its storno) -->
					if !header.Usluge || header.Knjizno {
					<div class="flex flex-wrap items-center gap-1">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "zaperiod",
							Name:              "zaperiod",
							LabelText:         translator.Label("Za period"),
							ClassLabel:        common.ClassLabel + " w-28",
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.ZaPeriod,
							TabIndex:          "6"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "periodod",
							LabelText:  translator.Label("Od"),
							ClassLabel: common.ClassLabel + " w-7",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "periodod",
							Name:       "periodod",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodOd),
							Disabled:   !header.ZaPeriod,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "7"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "perioddo",
							LabelText:  translator.Label("Do"),
							ClassLabel: common.ClassLabel + " w-10",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "perioddo",
							Name:       "perioddo",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodDo),
							Disabled:   !header.ZaPeriod,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-[6rem]",
							TabIndex:   "8"})
						if !header.Usluge || header.Storno {
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumsmanjenja",
								LabelText:  translator.Label("Datum smanjenja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumsmanjenja",
								Name:       "datumsmanjenja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumSmanjenja),
								ClassInput: common.ClassInputTextEnabled + " !w-32",
								TabIndex:   "9"})
						</div>
						}
					</div>
					}
				</div>
			</fieldset>
			<!-- Podaci o kupcu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o kupcu") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Mesto isporuke, komercijalista, tender, napomena..."): the konto and the analitička
				     šifra with their searches of the partneri, the naziv with the adresa, the poštanski broj
				     with the mesto and the PIB with the sistem PDV. Every label has the same width (w-36), so
				     the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Konto kupca and the analitička šifra, every one with the search of the partneri -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupackonto",
							LabelText:  translator.Label("Konto kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "kupackonto-combo",
							Name:         "kupackonto",
							ValueID:      "kupackonto",
							Value:        header.KupacKonto,
							DisplayValue: header.KupacKonto,
							Placeholder:  "Pretraži po kontu ili nazivu",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/konta",
							TabIndex:     "10",
						}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacsifra",
							LabelText:  translator.Label("Analitička šifra"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "kupacsifra-combo",
							Name:         "kupacsifra",
							ValueID:      "kupacsifra",
							Value:        header.KupacSifra,
							DisplayValue: strings.TrimSpace(header.KupacSifra + " " + header.KupacNaziv),
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/analitika",
							HxInclude:    "#kupackonto",
							// The šifra is searched in the selected konto only (robnoFaktureKontoIzabran: without the
							// konto no search, the hint to choose it first); the search runs again when the konto is
							// selected while the šifra has the focus.
							HxTrigger: "input[robnoFaktureKontoIzabran()] changed delay:300ms, focus[tableComboEmpty(this) && robnoFaktureKontoIzabran()], change[document.activeElement === this] from:#kupackonto",
							// The selected kupac fills its naziv, adresa, poštanski broj, mesto and PIB (their own
							// fields, so no details under the input).
							OnSelect:    "robnoFaktureKupacSelected",
							HideDetails: true,
							TabIndex:    "11",
						}, translator)
						<!-- The hint of the šifra without the konto (robnoFaktureKontoIzabran) -->
						<span id="robno-fakture-konto-hint" class="hidden">{ translator.Label("Prvo izaberite konto kupca") }</span>
					</div>
					<!-- Naziv kupca and the adresa (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacnaziv",
							LabelText:  translator.Label("Naziv kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacnaziv",
							Name:       "kupacnaziv",
							FieldType:  "text",
							Value:      header.KupacNaziv,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "60",
							TabIndex:   "12"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacadresa",
							LabelText:  translator.Label("Adresa"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacadresa",
							Name:          "kupacadresa",
							FieldType:     "text",
							Value:         header.KupacAdresa,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "60",
							TabIndex:      "13",
							DataDestField: "kupacadresa"})
					</div>
					<!-- Poštanski broj and the mesto (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpostanskibroj",
							LabelText:  translator.Label("Poštanski broj"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpostanskibroj",
							Name:       "kupacpostanskibroj",
							FieldType:  "text",
							Value:      header.KupacPostanskiBroj,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "14"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacmesto",
							LabelText:  translator.Label("Mesto"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacmesto",
							Name:          "kupacmesto",
							FieldType:     "text",
							Value:         header.KupacMesto,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "40",
							TabIndex:      "15",
							DataDestField: "kupacmesto"})
					</div>
					<!-- PIB and the sistem PDV (read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpib",
							LabelText:  translator.Label("PIB"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpib",
							Name:       "kupacpib",
							FieldType:  "text",
							Value:      header.KupacPib,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "16"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sistempdv",
							LabelText:  translator.Label("Sistem PDV"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "sistempdv",
							Name:          "sistempdv",
							HasLabel:      false,
							Disabled:      true,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  sistemPdvValues,
							SelectedValue: header.SistemPdv,
							TabIndex:      "17"}, translator)
					</div>
					<!-- The text of the kupac (read only, the box under the data of the kupac of the legacy
					     window) -->
					<div class="col-span-4 flex min-w-0">
						<textarea
							id="kupacinfo"
							name="kupacinfo"
							rows="2"
							disabled
							class={ common.ClassInputTextDisabled + " w-full !h-auto resize-none" }
						>{ header.KupacInfo }</textarea>
					</div>
				</div>
			</fieldset>
			<!-- Podaci o načinu otpreme, rokovima, valuti... : it is the last panel of the column, so it grows
			     to fill the space the right column leaves free at the bottom (both columns end on the same
			     line) -->
			<fieldset class="flex-1 border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o načinu otpreme, rokovima, valuti...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Podaci o kupcu"): the fields of a line stay together in the row (the first row holds the
				     valuta with its kurs and the "važi za", the rows of a single field keep the field over the
				     whole row). Every label has the same width (w-36), so the controls of all the rows start at
				     the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- The šifra valute with its combo over 1/2 of the row and the other two controls (the
					     "važi za" and the kurs) over the other 1/2, 1/4 of the row each -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						<div class="flex-1 flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "idvalute",
								LabelText:  translator.Label("Šifra valute"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TableCombo(domain.TableComboConfig{
								ID:           "idvalute-combo",
								Name:         "idvalute",
								ValueID:      "idvalute",
								Value:        robnoFaktureNullID(header.IDValute),
								DisplayValue: header.ValutaText,
								Placeholder:  "Pretraži po šifri ili nazivu",
								ClassWrapper: "relative flex-1 min-w-0",
								ClassInput:   common.ClassInputTextEnabled + " w-full",
								SearchURL:    "/api/search/valute",
								// No value ("-") is saved as NULL.
								AllowEmpty: true,
								TabIndex:   "18",
							}, translator)
						</div>
						<div class="flex-1 flex items-center gap-1 min-w-0">
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "vaziza",
									LabelText:  translator.Label("Važi za (1,100)"),
									ClassLabel: common.ClassLabel + " w-36 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "vaziza",
									Name:       "vaziza",
									FieldType:  "text",
									Value:      robnoFaktureInt(header.VaziZa),
									ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
									MaxLength:  "3",
									TabIndex:   "19"})
							</div>
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "kurs",
									LabelText:  translator.Label("Kurs"),
									ClassLabel: common.ClassLabel + " w-16 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "kurs",
									Name:       "kurs",
									FieldType:  "text",
									Value:      robnoFaktureDecimal(header.Kurs, 2),
									ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
									MaxLength:  "15",
									TabIndex:   "20"})
							</div>
						</div>
					</div>
					<!-- BrojRata, DatumPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojrata",
							LabelText:  translator.Label("Broj rata"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojrata",
							Name:       "brojrata",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojRata),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "21"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datumprverate",
							LabelText:  translator.Label("Dat. dosp. prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datumprverate",
							Name:       "datumprverate",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.DatumPrveRate),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "22"})
					</div>
					<!-- IznosFakture, IznosPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosfakture",
							LabelText:  translator.Label("Iznos fakture"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosfakture",
							Name:       "iznosfakture",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosFakture, 2),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "23"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosprverate",
							LabelText:  translator.Label("Iznos prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosprverate",
							Name:       "iznosprverate",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosPrveRate, 2),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "24"})
					</div>
					<!-- UsloviPlacanja, UsloviKamate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "usloviplacanja",
							LabelText:  translator.Label("Uslovi plaćanja"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "usloviplacanja",
							Name:       "usloviplacanja",
							FieldType:  "text",
							Value:      header.UsloviPlacanja,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "25"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "uslovikamate",
							LabelText:  translator.Label("Uslovi kamate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "uslovikamate",
							Name:       "uslovikamate",
							FieldType:  "text",
							Value:      header.UsloviKamate,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "26"})
					</div>
					<!-- Rok, Dospeva -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "rok",
							LabelText:  translator.Label("Rok"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "rok",
							Name:       "rok",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.Rok),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "27"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dospeva",
							LabelText:  translator.Label("Dospeva"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dospeva",
							Name:       "dospeva",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.Dospeva),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "28"})
					</div>
					<!-- ZiroRacun -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "ziroracun",
							LabelText:  translator.Label("Ziro račun"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "ziroracun",
							Name:          "ziroracun",
							HasLabel:      false,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  zirpRacunValues,
							SelectedValue: header.ZirpRacun,
							TabIndex:      "29"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nacinotpreme",
							LabelText:  translator.Label("Način otpreme"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "nacinotpreme",
							Name:       "nacinotpreme",
							FieldType:  "text",
							Value:      header.NacinOtpreme,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "30"})
					</div>
					<!-- Broj ugovora, Narudžbenica -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojugovora",
							LabelText:  translator.Label("Broj ugovora"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojugovora",
							Name:       "brojugovora",
							FieldType:  "text",
							Value:      header.BrojUgovora,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "31"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "narudzbenica",
							LabelText:  translator.Label("Narudžbenica"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "narudzbenica",
							Name:       "narudzbenica",
							FieldType:  "text",
							Value:      header.Narudzbenica,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "32"})
					</div>
					<!-- Paritet, IzvozIzjava and the banka za uplatu - izvoz (not of the fakture usluga) -->
					if !header.Usluge {
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "paritet",
							LabelText:  translator.Label("Paritet"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "paritet",
							Name:       "paritet",
							FieldType:  "text",
							Value:      header.Paritet,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "33"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "izvozizjava",
							LabelText:  translator.Label("Izvoz. izjava"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "izvozizjava",
							Name:       "izvozizjava",
							FieldType:  "text",
							Value:      header.IzvozIzjava,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "34"})
					</div>
					<!-- BankaUplatu -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bnkizvid",
							LabelText:  translator.Label("Banka za uplatu - izvoz"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "bnkizvid-combo",
							Name:         "bnkizvid",
							ValueID:      "bnkizvid",
							Value:        robnoFaktureNullID(header.IDBankaIzvoz),
							DisplayValue: header.BankaIzvozText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/banke-izvoz",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							TabIndex:   "35",
						}, translator)
					</div>
					}
					<!-- Popdv -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "popdv",
							LabelText:  translator.Label("Polje POPDV"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "popdv-combo",
							Name:         "popdv",
							ValueID:      "popdv",
							Value:        header.Popdv,
							DisplayValue: header.PopdvText,
							Placeholder:  "Pretraži po polju ili opisu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/popdv",
							// The polja of the evidencija of the izlazni računi.
							HxVals: `{"vktip": "I"}`,
							// No value ("-"): the POPDV polje is required only for the vrste with the POPDV.
							AllowEmpty: true,
							TabIndex:   "36",
						}, translator)
					</div>
				</div>
			</fieldset>
			<!-- ===== End of the left column, start of the right column ===== -->
		</div>
		<div class="flex flex-col gap-1 min-w-0">
			<!-- Podaci o porezom oslobođenju, nastanku PDV obaveze -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o porezom oslobođenju, nastanku PDV obaveze") }</legend>
				<!-- The rows of the panel: every row is one line of the legacy box. The first row holds the
				     poreska kategorija (combo, 3/4 of the row) with the oznaka next to it (the last 1/4), the
				     second one the napomena over the whole row; below them the nastanak PDV obaveze and, in
				     the last row, the org. jedinica with the mesto troška. Every label of the panel has the
				     same width (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Row 1: the poreska kategorija (3/4) and the oznaka (1/4) -->
					<div class="col-span-3 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "porkatid",
							LabelText:  translator.Label("Poreska kategorija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "porkatid-combo",
							Name:         "porkatid",
							ValueID:      "porkatid",
							Value:        robnoFaktureNullID(header.IDPorKat),
							DisplayValue: header.PorKatText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/poreske-kategorije",
							// The poreske kategorije of the PDV obveznici or of the firms out of the PDV.
							HxVals: `{"obveznik": "` + strconv.FormatBool(header.PdvObveznik) + `"}`,
							// The selected kategorija fills the oznaka and the napomena (robnoFaktureKategorijaSelected).
							OnSelect: "robnoFaktureKategorijaSelected",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							TabIndex:   "37",
						}, translator)
						<!-- The selection of a kategorija sets the nastanak PDV obaveze of a PDV obveznik for a
						     document that is not a storno (no name: not sent with the form) -->
						<input type="hidden" id="robno-fakture-porkat-nastanak" value={ robnoFaktureFlag(header.PdvObveznik && !header.Storno) }/>
					</div>
					<div class="flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oznakakat",
							LabelText:  translator.Label("Oznaka"),
							ClassLabel: common.ClassLabel + " w-16",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oznakakat",
							Name:       "oznakakat",
							FieldType:  "text",
							Value:      header.OznakaKat,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "38"})
					</div>
					<!-- Row 2: the napomena o poreskom oslobođenju over the whole row -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "napomporeskoosl",
							LabelText:  translator.Label("Napom. o poreskom osl."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "napomporeskoosl",
							Name:       "napomporeskoosl",
							FieldType:  "text",
							Value:      header.NapomenaPoresko,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "39"})
					</div>
					<!-- Row 3: the nastanak PDV obaveze, as wide as the poreska kategorija above -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nastanakpdv",
							LabelText:  translator.Label("Nastanak PDV obaveze"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "nastanakpdv",
							Name:         "nastanakpdv",
							Placeholder:  translator.Placeholder("izaberite nastanak PDV obaveze"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "40",
							OptionValues: header.CbxNastanakPDV,
							// The default value (RobFaktureNastanakPDV) or the one of the document.
							SelectedValue: header.NastanakPDV}, translator)
					</div>
					<!-- Row 4: the org. jedinica with the mesto troška (searched in the org. jedinica) -->
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "idorgjed",
							LabelText:  translator.Label("Org. Jedinica"),
							ClassLabel: common.ClassLabel + " w-40 whitespace-nowrap",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "idorgjed-combo",
							Name:         "idorgjed",
							ValueID:      "idorgjed",
							Value:        robnoFaktureNullID(header.Orgejed),
							DisplayValue: header.OrgjedText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/org-jedinice",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							Disabled:   false,
							TabIndex:   "41",
						}, translator)
					</div>
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "mestotrid",
							LabelText:  translator.Label("Mesto troska"),
							ClassLabel: common.ClassLabel + " w-28 whitespace-nowrap",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "mestotrid-combo",
							Name:         "mestotrid",
							ValueID:      "mestotrid",
							Value:        robnoFaktureNullID(header.MestoTroska),
							DisplayValue: header.MestoTroskaText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/mesta-troska",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							// The mesta troška of the selected org. jedinica; the search runs again when the org. jedinica
							// is selected while the mesto troška has the focus.
							HxInclude: "#idorgjed",
							HxTrigger: "input changed delay:300ms, focus[tableComboEmpty(this)], change[document.activeElement === this] from:#idorgjed",
							Disabled:  false,
							TabIndex:  "42",
						}, translator)
					</div>
				</div>
			</fieldset>
			<!-- Mesto isporuke, komercijalista, tender, napomena... (the second panel of the legacy box) -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Mesto isporuke, komercijalista, tender, napomena...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row: the mesto isporuke and the
				     komercijalista over the whole row, then the IF broj with the checkbox "Javna nabavka",
				     the BJKOS nosioca with the broj tendera and the KST and, in the last rows, the pairs of
				     the fields of the otprema (broj ugovora / narudžbenica, vozač / reg. br., bruto / neto
				     težina, broj kutija / broj paleta). Every label has the width of the labels of the panel
				     above (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Mesto isporuke -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "fispid",
							LabelText:  translator.Label("Mesto isporuke"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "fispid-combo",
							Name:         "fispid",
							ValueID:      "fispid",
							Value:        robnoFaktureNullID(header.MestoIsporuke),
							DisplayValue: header.MestoIsporukeText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/mesta-isporuke-id",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							// The mesta isporuke of the kupac of the faktura.
							HxInclude: "#kupackonto, #kupacsifra",
							HxTrigger: "input changed delay:300ms, focus[tableComboEmpty(this)], change[document.activeElement === this] from:#kupacsifra",
							Disabled:  false,
							TabIndex:  "43",
						}, translator)
					</div>
					<!-- The poštanski broj and the mesto of the mesto isporuke (read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "misppostanskibroj",
							LabelText:  translator.Label("Poštanski broj"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "misppostanskibroj",
							Name:       "misppostanskibroj",
							FieldType:  "text",
							Value:      header.MispPostanskiBroj,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-24"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "mispmesto",
							LabelText:  translator.Label("Mesto"),
							ClassLabel: common.ClassLabel + " pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "mispmesto",
							Name:       "mispmesto",
							FieldType:  "text",
							Value:      header.MispMesto,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
					</div>
					<!-- Komercijalista -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "komid",
							LabelText:  translator.Label("Komercijalista"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TableCombo(domain.TableComboConfig{
							ID:           "komid-combo",
							Name:         "komid",
							ValueID:      "komid",
							Value:        robnoFaktureNullID(header.Komercijalista),
							DisplayValue: header.KomercijalistaText,
							Placeholder:  "Pretraži po šifri ili nazivu",
							ClassWrapper: "relative flex-1 min-w-0",
							ClassInput:   common.ClassInputTextEnabled + " w-full",
							SearchURL:    "/api/search/komercijalisti-id",
							// No value ("-") is saved as NULL.
							AllowEmpty: true,
							Disabled:   false,
							TabIndex:   "44",
						}, translator)
					</div>
					<!-- Vozač, Reg. br. -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vozac",
							LabelText:  translator.Label("Vozač"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "vozac",
							Name:       "vozac",
							FieldType:  "text",
							Value:      header.Vozac,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "40",
							TabIndex:   "45"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "regbr",
							LabelText:  translator.Label("Reg. br."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "regbr",
							Name:       "regbr",
							FieldType:  "text",
							Value:      header.RegBr,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "46"})
					</div>
					<!-- Bruto težina, Neto težina, broj kutija, broj paleta (not of the fakture usluga) -->
					if !header.Usluge {
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brutotezina",
							LabelText:  translator.Label("Bruto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brutotezina",
							Name:       "brutotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.BrutoTezina, 2),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "47"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "netotezina",
							LabelText:  translator.Label("Neto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "netotezina",
							Name:       "netotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.NetoTezina, 2),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "48"})
					</div>
					<!-- Broj kutija, Broj paleta -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojkutija",
							LabelText:  translator.Label("Broj kutija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojkutija",
							Name:       "brojkutija",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojKutija),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "49"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojpaleta",
							LabelText:  translator.Label("Broj paleta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojpaleta",
							Name:       "brojpaleta",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojPaleta),
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "50"})
					</div>
					}
					<!-- checkbox "Javna nabavka",  -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "javnanabavka",
							Name:              "javnanabavka",
							LabelText:         translator.Label("Javna nabavka"),
							ClassLabel:        common.ClassLabel,
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.JavnaNabavka,
							TabIndex:          "51"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "jbkjsnosilac",
							LabelText:  translator.Label("JBKJS nosioca"),
							ClassLabel: common.ClassLabel + " w-32 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "jbkjsnosilac",
							Name:       "jbkjsnosilac",
							FieldType:  "text",
							Value:      header.JBKJNosioc,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							MaxLength:  "20",
							TabIndex:   "52"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojtendera",
							LabelText:  translator.Label("Broj tendera"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojtendera",
							Name:       "brojtendera",
							FieldType:  "text",
							Value:      header.BrojTendera,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "53"})
					</div>
					<!-- The tekst of the document (rdok.foot) -->
					<div class="col-span-4 flex items-start gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "foot",
							LabelText:  translator.Label("Tekst"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						<textarea
							id="foot"
							name="foot"
							rows="2"
							tabindex="54"
							class={ common.ClassInputTextEnabled + " flex-1 min-w-0 !h-auto" }
						>{ header.Tekst }</textarea>
					</div>
				</div>
			</fieldset>
			<!-- Finansijsko stanje kupca -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Finansijsko stanje kupca") }</legend>
				<!-- The grid of the legacy window: the proknjiženo (realizacija, plaćeno, saldo and its dospelo /
				     nedospelo), the neproknjiženo (realizacija, dospelo, nedospelo) and the ukupno (dospelo,
				     nedospelo, saldo) -->
				<div class="grid grid-cols-3 gap-x-3">
					@RobnoFaktureFinStanjeCell("ukrealiz", translator.Label("Proknjižena realiz."), header.UkRealiz, translator)
					@RobnoFaktureFinStanjeCell("placeno", translator.Label("Plaćeno"), header.Placeno, translator)
					@RobnoFaktureFinStanjeCell("saldopartnera", translator.Label("Saldo"), header.Saldo, translator)
					<div class="flex items-center mb-1 font-semibold text-sm text-blue-900">{ translator.Label("Neproknjiženo") }</div>
					@RobnoFaktureFinStanjeCell("dospelo", translator.Label("Dospelo"), header.Dospelo, translator)
					@RobnoFaktureFinStanjeCell("nedospelo", translator.Label("Nedospelo"), header.Nedospelo, translator)
					@RobnoFaktureFinStanjeCell("ukrealizrob", translator.Label("Neproknjiž. realiz."), header.UkRealizRob, translator)
					@RobnoFaktureFinStanjeCell("dospelorob", translator.Label("Dospelo"), header.DospeloRob, translator)
					@RobnoFaktureFinStanjeCell("nedospelorob", translator.Label("Nedospelo"), header.NedospeloRob, translator)
					@RobnoFaktureFinStanjeCell("ukdospelo", translator.Label("Ukupno")+" "+translator.Label("Dospelo"), header.UkDospelo, translator)
					@RobnoFaktureFinStanjeCell("uknedospelo", translator.Label("Nedospelo"), header.UkNedospelo, translator)
					@RobnoFaktureFinStanjeCell("uksaldo", translator.Label("Saldo"), header.UkSaldo, translator)
				</div>
			</fieldset>
			<!-- Avansi: the avansi closed on the faktura, the grid the legacy window shows next to the
			     finansijsko stanje -->
			if avansiTbl.TableID != "" {
				@RobnoFaktureAvansi(avansiTbl, translator)
			}
			<!-- ===== End of the right column and of the two column layout ===== -->
		</div>
	</div>
}

// RobnoFaktureAvansi renders the editable grid of the avansi closed on the faktura (like the tekući
// računi of the partneri): "+ Dodaj avans" adds an empty row (the template row of the grid), "Obriši"
// removes its row. The user enters the broj of the avansni račun and the iznos closed on the faktura;
// the other columns (the avans, its datum, iznos and ostatak) are read only, filled by the server. The
// grid is inside the fields of the header, so its rows are sent with the header as the parallel lists
// avansid (the key of a saved row, empty for a new one), avansbrdok and avanszatvoreno.
templ RobnoFaktureAvansi(avansiTbl domain.TableData, translator *i18n.Service) {
	<div id={ avansiTbl.TableID } class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col h-40 min-h-0 overflow-hidden">
		<div class="flex items-center justify-between px-1 mb-1">
			<h4 class="text-sm font-semibold text-blue-700">{ translator.Label("Avansi") }</h4>
			<button
				type="button"
				onclick={ templ.JSFuncCall("robnoFaktureAvansDodaj", avansiTbl.TableID) }
				class={ common.ClassAddButton }
			>
				+ { translator.Button("Dodaj avans") }
			</button>
		</div>
		<div class="flex-1 min-h-0 overflow-auto border border-gray-300 rounded bg-white">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-blue-900 text-white sticky top-0">
					<tr>
						for _, h := range avansiTbl.Headers {
							if robnoFaktureAvansKolona(h.Name) {
								<th class={ "border border-gray-300 px-1 text-xs whitespace-nowrap " + robnoFaktureAvansAlign(h.TextAlign) }>{ translator.Label(h.Label) }</th>
							}
						}
						<th class="border border-gray-300 px-1 w-20 text-xs text-center">{ translator.Label("Akcije") }</th>
					</tr>
				</thead>
				<tbody data-robno-avansi>
					for _, row := range avansiTbl.Rows {
						@RobnoFaktureAvansRed(avansiTbl.Headers, row, translator)
					}
				</tbody>
			</table>
		</div>
		<!-- The empty row "+ Dodaj avans" adds -->
		<template data-robno-avansi-novi>
			@RobnoFaktureAvansRed(avansiTbl.Headers, domain.TableRow{}, translator)
		</template>
	</div>
}

// RobnoFaktureAvansRed renders one row of the grid of the avansi: the broj of the avansni račun and
// the iznos closed on the faktura are inputs, the other cells read only text; the hidden avansid is
// the key of the saved row.
templ RobnoFaktureAvansRed(headers []domain.Fields, row domain.TableRow, translator *i18n.Service) {
	<tr class="odd:bg-white even:bg-blue-50 hover:bg-blue-100">
		for i, h := range headers {
			if robnoFaktureAvansKolona(h.Name) {
				<td class={ "border border-gray-200 px-1 " + robnoFaktureAvansAlign(h.TextAlign) }>
					switch h.Name {
						case "trazi":
							<!-- The search of the avansni računi of the kupac (the popup comes later) -->
							<button
								type="button"
								title={ translator.Label("Traži") }
								onclick="robnoFaktureAvansTrazi(this)"
								class="inline-flex items-center justify-center h-6 w-6 rounded text-blue-700 hover:bg-blue-200"
							>
								<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15z"></path>
								</svg>
							</button>
						case "bravans":
							<input type="text" name="avansbrdok" value={ robnoFaktureAvansCell(row, i) } class={ common.ClassInputTextEnabled + " w-full text-right" }/>
						case "iznfakt":
							<!-- Computed by the obračun of the faktura (read only) -->
							{ robnoFaktureAvansCell(row, i) }
						default:
							{ robnoFaktureAvansCell(row, i) }
					}
				</td>
			}
		}
		<td class="border border-gray-200 px-1 text-center">
			<input type="hidden" name="avansid" value={ row.ID }/>
			<button
				type="button"
				onclick="robnoFaktureAvansObrisi(this)"
				class={ common.ClassDeleteButton }
			>
				{ translator.Button("Obriši") }
			</button>
		</td>
	</tr>
}

// robnoFaktureAvansKolona tells whether a column of the avansi is shown (all of them; the column
// "trazi" is the button of the search of the avans).
func robnoFaktureAvansKolona(name string) bool {
	return name != ""
}

// robnoFaktureAvansCell returns the cell i of a row of the avansi ("" for an empty row).
func robnoFaktureAvansCell(row domain.TableRow, i int) string {
	if i < len(row.Fields) {
		return row.Fields[i]
	}
	return ""
}

// robnoFaktureAvansAlign returns the class of the alignment of a column of the avansi.
func robnoFaktureAvansAlign(align string) string {
	switch align {
	case "right":
		return "text-right"
	case "center":
		return "text-center"
	}
	return "text-left"
}

// RobnoFaktureReadOnly renders one read only label + value row (the strips of the header and the
// "Finansijsko stanje kupca" panel). The value is right aligned like the numeric cells of the grids.
templ RobnoFaktureReadOnly(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-40"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right"})
	</div>
}

// RobnoFaktureFinStanjeCell renders one value of the "Finansijsko stanje kupca" grid: the label and the
// read only amount, right aligned like the numeric cells of the grids.
templ RobnoFaktureFinStanjeCell(id, label string, value float64, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-36"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      robnoFaktureDecimal(value, 2),
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0 text-right"})
	</div>
}

// RobnoFaktureStavkaInfo renders a read only value of the document of the stavke (the panels "Kupac"
// and "Podaci o dokumentu"): the label as wide as its text and the value with the width and alignment of
// classInput.
templ RobnoFaktureStavkaInfo(id, label, value, classInput string) {
	<div class={ "flex items-center gap-1 min-w-0 " + robnoFaktureStavkaInfoWrap(classInput) }>
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " whitespace-nowrap"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " " + classInput})
	</div>
}

// robnoFaktureStavkaInfoWrap returns the class of the element of a RobnoFaktureStavkaInfo: it takes the
// rest of the row when its value does (flex-1).
func robnoFaktureStavkaInfoWrap(classInput string) string {
	if strings.Contains(classInput, "flex-1") {
		return "flex-1"
	}
	return ""
}

// RobnoFaktureReadOnlyStrip renders a read only strip of two lines: the first line is the label of
// every field, the second one its value (the two row grid header of the legacy windows). The values are
// disabled inputs, so the script of the screen (RobnoFaktureScript) treats them like the other read
// only values of the form and never enables them.
templ RobnoFaktureReadOnlyStrip(fields []domain.RobnoFaktureStripField) {
	<table class="w-full table-fixed border-collapse">
		<thead>
			<tr>
				for _, f := range fields {
					<th class={ "border border-blue-400 bg-blue-200 px-1 py-0.5 text-xs font-normal text-blue-900 whitespace-nowrap " + f.WidthClass }>{ f.Label }</th>
				}
			</tr>
		</thead>
		<tbody>
			<tr>
				for _, f := range fields {
					<td class="border border-blue-400 bg-blue-100 px-0.5 py-0.5 align-middle">
						<input
							id={ f.ID }
							name={ f.ID }
							type="text"
							value={ f.Value }
							disabled
							class={ common.ClassInputTextDisabled + " " + f.AlignClass }
						/>
					</td>
				}
			</tr>
		</tbody>
	</table>
}

// RobnoFaktureStavkePanel renders the second collapsible control: the entry form of one stavka and the
// grid of the stavke of the dokument. The control is closed and disabled until the header is saved.
templ RobnoFaktureStavkePanel(ui domain.RobnoFaktureUI, tbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoFakturePanel(ui.StavkePanelID, translator.Label("Stavke fakture"), robnoFaktureStavkeStateText(header.Snimljen, translator), header.Snimljen, header.Snimljen, true, btns.SaveStavka.Id, templ.NopComponent, RobnoFaktureStavkeFields(ui, tbl, stavka, btns, searchInput, translator), templ.NopComponent)
	<!-- The dialog of the messages of the stavke (e.g. the error of the save of a stavka: the response is
	     retargeted here). Outside the control, so a locked control does not dim it; no box (contents),
	     so it adds no gap to the layout. -->
	<div id={ ui.StavkaInfoID } class="contents"></div>
}

// RobnoFaktureStavkeFields is the body of the stavke control: the kupac and the podaci o dokumentu of
// the header (read only), the entry form of the stavka and the grid of the stavke.
templ RobnoFaktureStavkeFields(ui domain.RobnoFaktureUI, tbl domain.TableData, stavka domain.RobnoFaktureStavka, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- KUPAC + Podaci o dokumentu: the two read only panels of the legacy window -->
	<div class="grid grid-cols-2 gap-1">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Kupac") }</legend>
			<!-- The konta (narrow) and the naziv of the kupac over the rest of the row -->
			<div class="flex items-center gap-2 min-w-0">
				@RobnoFaktureStavkaInfo("kupacmagacin", translator.Label("Konto magacina"), stavka.KontoMagacina, "w-24 text-right")
				@RobnoFaktureStavkaInfo("kupackontostavke", translator.Label("Konto kupca"), stavka.KontoKupca, "w-32 text-right")
				@RobnoFaktureStavkaInfo("kupacnazivstavke", translator.Label("Naziv kupca"), stavka.KupacNaziv, "flex-1 min-w-0")
			</div>
		</fieldset>
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
			<div class="flex items-center gap-2 min-w-0">
				@RobnoFaktureStavkaInfo("vrdstavke", translator.Label("Vrsta dokumenta"), stavka.Vrd, "w-16 text-right")
				@RobnoFaktureStavkaInfo("brdokstavke", translator.Label("Broj dokumenta"), stavka.Brdok, "w-20 text-right")
				@RobnoFaktureStavkaInfo("datumdokumenta", translator.Label("Datum dokumenta"), stavka.DatumDokumenta, "w-24 text-center")
				@RobnoFaktureStavkaInfo("iznosdokumenta", translator.Label("Iznos dokumenta"), stavka.IznosDokumenta, "flex-1 min-w-0 text-right")
			</div>
		</fieldset>
	</div>
	<!-- Stavka: the data the script of the stavke needs (the url of the artikal, the valuta of the
	     document) and the keys of the stavka (the document, the stavka of the form: 0 for a new one) -->
	<fieldset
		id="robno-fakture-stavka"
		class="border border-blue-400 bg-blue-100 p-1 rounded-lg"
		data-artikal-url={ ui.ArtikalURL }
		data-devizni={ robnoFaktureState(stavka.Devizni) }
		data-kurs={ strconv.FormatFloat(stavka.Kurs, 'f', -1, 64) }
		data-vaziza={ strconv.FormatFloat(stavka.VaziZa, 'f', -1, 64) }
	>
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Stavka") }</legend>
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<input type="hidden" id="stavkarproid" name="rproid" value={ strconv.FormatInt(stavka.RproID, 10) }/>
		<div class="grid grid-cols-3 gap-x-3">
			<!-- First column of the legacy window: the article, its tarifa, the količina and the cene -->
			<div class="flex flex-col">
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "sifraartikla",
						LabelText:  translator.Label("Šifra artikla"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TableCombo(domain.TableComboConfig{
						ID:           "sifraartikla-combo",
						Name:         "sifraartikla",
						ValueID:      "sifraartikla",
						Value:        stavka.SifraArtikla,
						DisplayValue: strings.TrimSpace(stavka.SifraArtikla + " " + stavka.SifraArtiklaNaziv),
						Placeholder:  "Pretraži po šifri, nazivu ili barkodu",
						ClassInput:   common.ClassInputTextEnabled + " w-full",
						SearchURL:    "/api/search/artikli",
						// A typed šifra or barkod is taken too; the artikal fills the stavka
						// (robnoFaktureStavkaArtikal, on the change of the šifra).
						FreeText: true,
						TabIndex: "1",
					}, translator)
				</div>
				<!-- The konto of the stavka (the first konto of the magacin, or the konto of the artikal) -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "kontostavke",
						LabelText:  translator.Label("Konto"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "kontostavke",
						Name:       "kontostavke",
						FieldType:  "text",
						Value:      stavka.Konto,
						ClassInput: common.ClassInputTextEnabled + " !w-28",
						MaxLength:  "10",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError",
						TabIndex:   "2"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "tarifa",
						LabelText:  translator.Label("Šifra poreske tarife"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "tarifa",
						Name:       "tarifa",
						FieldType:  "text",
						Value:      stavka.Tarifa,
						ClassInput: common.ClassInputTextEnabled + " !w-20 text-right",
						MaxLength:  "6",
						TabIndex:   "3"})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "stopastavke",
						FieldType:  "text",
						Value:      stavka.Stopa,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-16 text-right"})
					<span class="text-sm">%</span>
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "kolicina",
						LabelText:  translator.Label("Količina"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "kolicina",
						Name:       "kolicina",
						FieldType:  "text",
						Value:      stavka.Kolicina,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "4",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "prodajnacena",
						LabelText:  translator.Label("Prodajna cena"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "prodajnacena",
						Name:       "prodajnacena",
						FieldType:  "text",
						Value:      stavka.ProdajnaCena,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "5"})
					if stavka.ValutaPoruka != "" {
						<span class="text-xs text-blue-800">{ stavka.ValutaPoruka }</span>
					}
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "rabatstavke",
						LabelText:  translator.Label("Rabat"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "rabatstavke",
						Name:       "rabatstavke",
						FieldType:  "text",
						Value:      stavka.Rabat,
						ClassInput: common.ClassInputTextEnabled + " !w-20 text-right",
						MaxLength:  "6",
						TabIndex:   "6"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "netoprodajnacena",
						LabelText:  translator.Label("Neto prodajna cena"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "netoprodajnacena",
						Name:       "netoprodajnacena",
						FieldType:  "text",
						Value:      stavka.NetoProdajnaCena,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "7"})
				</div>
				<!-- The poreska kategorija of the stavka and, for S10 and S20, its osnov oslobođenja -->
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "taxcat",
						LabelText:  translator.Label("Poreska kategorija"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.ComboBoxField(domain.ComboFieldConfig{
						ID:            "taxcat",
						Name:          "taxcat",
						ClassSelect:   common.ClassInputTextEnabled + " !w-24",
						OptionValues:  stavka.CbxTaxcat,
						SelectedValue: stavka.Taxcat,
						TabIndex:      "8"}, translator)
					<span id="robno-fakture-taxexem" class={ robnoFaktureTaxexemClass(stavka.Taxcat) }>
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "taxexreco",
							Name:          "taxexreco",
							ClassSelect:   common.ClassInputTextEnabled + " !w-32",
							OptionValues:  stavka.CbxTaxexreco,
							SelectedValue: stavka.Taxexreco,
							TabIndex:      "9"}, translator)
					</span>
				</div>
			</div>
			<!-- Second column of the legacy window: the stanje, the iznos and the nabavna cena -->
			<div class="flex flex-col">
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "jm",
						LabelText:  translator.Label("JM"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "jm",
						Name:       "jm",
						FieldType:  "text",
						Value:      stavka.JM,
						ClassInput: common.ClassInputTextEnabled + " !w-20",
						MaxLength:  "6",
						TabIndex:   "10"})
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "stanje",
						LabelText:  translator.Label("Stanje"),
						ClassLabel: common.ClassLabel + " pl-2",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "stanje",
						Name:       "stanje",
						FieldType:  "text",
						Value:      stavka.Stanje,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dani",
						LabelText:  translator.Label("Dan(i)"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dani",
						Name:       "dani",
						FieldType:  "text",
						Value:      stavka.Dani,
						ClassInput: common.ClassInputTextEnabled + " !w-16 text-right",
						MaxLength:  "3",
						TabIndex:   "11"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "iznosstavke",
						LabelText:  translator.Label("Iznos"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "iznosstavke",
						Name:       "iznosstavke",
						FieldType:  "text",
						Value:      stavka.Iznos,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "12"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "magacinskacena",
						LabelText:  translator.Label("Magacinska cena"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "magacinskacena",
						Name:       "magacinskacena",
						FieldType:  "text",
						Value:      stavka.MagacinskaCena,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "iznosrabata",
						LabelText:  translator.Label("Iznos rabata"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "iznosrabata",
						Name:       "iznosrabata",
						FieldType:  "text",
						Value:      stavka.IznosRabata,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "nabavnacena",
						LabelText:  translator.Label("Nabavna cena"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "nabavnacena",
						Name:       "nabavnacena",
						FieldType:  "text",
						Value:      stavka.NabavnaCena,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "13"})
				</div>
			</div>
			<!-- Third column of the legacy window: the last price of the kupac and the dokument fields -->
			<div class="flex flex-col">
				<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg mb-1">
					<legend class="px-1 font-semibold text-xs text-blue-900">{ translator.Label("Zadnja cena po kojoj je kupac kupovao ovaj artikal") }</legend>
					<p id="zadnjacenaporuka" class="text-xs text-blue-800 empty:hidden"></p>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjacena",
							LabelText:  translator.Label("Cena"),
							ClassLabel: common.ClassLabel + " w-14",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjacena",
							Name:       "zadnjacena",
							FieldType:  "text",
							Value:      stavka.ZadnjaCena,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjirabat",
							LabelText:  translator.Label("Rabat"),
							ClassLabel: common.ClassLabel + " w-14 pl-1",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjirabat",
							Name:       "zadnjirabat",
							FieldType:  "text",
							Value:      stavka.ZadnjiRabat,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-20 text-right"})
					</div>
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjidatum",
							LabelText:  translator.Label("Datum"),
							ClassLabel: common.ClassLabel + " w-14",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjidatum",
							Name:       "zadnjidatum",
							FieldType:  "date",
							Value:      stavka.ZadnjiDatum,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-40"})
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "koristiposlednjirabat",
							Name:              "koristiposlednjirabat",
							LabelText:         translator.Label("Koristi poslednji rabat za ovu fakturu"),
							ClassLabel:        "text-xs leading-4 max-w-[14rem]",
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-xs",
							IsChecked:         stavka.KoristiPoslednjiRabat,
							TabIndex:          "14"}, translator)
					</div>
				</fieldset>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "deklaracije",
						LabelText:  translator.Label("Deklaracije"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "deklaracije",
						Name:       "deklaracije",
						FieldType:  "text",
						Value:      stavka.Deklaracije,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "60",
						TabIndex:   "15"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "barkod",
						LabelText:  translator.Label("Bar kod"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "barkod",
						Name:       "barkod",
						FieldType:  "text",
						Value:      stavka.BarKod,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "16"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "otk",
						LabelText:  translator.Label("OTK"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "otk",
						Name:       "otk",
						FieldType:  "text",
						Value:      stavka.Otk,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "17"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "serija",
						LabelText:  translator.Label("Šerija"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "serija",
						Name:       "serija",
						FieldType:  "text",
						Value:      stavka.Serija,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "18"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "rokstavke",
						LabelText:  translator.Label("Rok"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "rokstavke",
						Name:       "rokstavke",
						FieldType:  "date",
						Value:      stavka.Rok,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "19"})
				</div>
			</div>
		</div>
	</fieldset>
	<!-- "Sačuvaj" of the stavka, above the grid of the stavke (the change and the deletion of a stavka are the
	     buttons of its row) -->
	<div class="flex items-center justify-end gap-1">
		@RobnoFaktureStavkeButtons(btns)
	</div>
	<!-- The confirmation of the deletion of a stavka ("Obriši" of its row) -->
	<div id="robno-fakture-potvrda" class="relative z-[60]"></div>
	<!-- Grid of the stavke of the dokument (locked while a stavka of it is changed, robnoFaktureStavkaUcitaj) -->
	<div id="robno-fakture-stavke-grid" class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the control -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoFaktureStavkeButtons renders the buttons of the stavke control (the "Sačuvaj", "Izmeni" and
// "Briši" of the legacy window).
templ RobnoFaktureStavkeButtons(btns domain.RobnoFaktureButtons) {
	@components.Button(btns.SaveStavka)
	@components.Button(btns.CancelStavka)
}

// RobnoFaktureIzmeniZaglavlje renders "Izmeni" of the header in the title bar of its control: it switches
// from the stavke back to the header (robnoFaktureModifyHeader), so it is enabled only while the stavke
// are active (the header saved; robnoFaktureSetMode keeps it so). Its click does not open or close the
// control (robnoFaktureIzmeniKlik).
templ RobnoFaktureIzmeniZaglavlje(btn domain.Button, snimljen bool) {
	<button
		type="button"
		id={ btn.Id }
		disabled?={ !snimljen }
		onclick={ templ.JSFuncCall("robnoFaktureIzmeniKlik", append([]any{templ.JSExpression("event")}, btn.HxOnClickArg...)...) }
		class={ btn.BtnClass + " disabled:opacity-50 disabled:cursor-not-allowed" }
	>
		if btn.Icon != "" {
			@components.Icon(btn.Icon, common.ClassIcon)
		}
		{ btn.LabelText }
	</button>
}

// RobnoFaktureHeaderButtons renders the buttons of the header control. They are rendered outside of
// [data-panel-fields], so the script never disables them and the header can always be saved ("Izmeni",
// which unlocks the header again, is in the title bar of the control: RobnoFaktureIzmeniZaglavlje).
templ RobnoFaktureHeaderButtons(btns domain.RobnoFaktureButtons) {
	@components.Button(btns.Save)
	@components.Button(btns.New)
	@components.Button(btns.Delete)
}

// RobnoFaktureScript is the small script that keeps only one of the two controls editable. The server
// renders the same state (domain.RobnoFaktureHeaderView.Snimljen and the Disabled flags of the fields), so the
// screen works both after a save and after a reload of the tab.
templ RobnoFaktureScript() {
	<style>
		details.robno-fill[open]::details-content {
			display: contents;
		}
	</style>
	<script>
		// Opens or closes one of the two controls, the same thing as clicking its title bar.
		function robnoFaktureSetPanelOpen(panelId, open) {
			const panel = document.getElementById(panelId);
			if (panel) {
				panel.open = open;
			}
		}

		// Enables or disables the fields of one of the two controls. The controls that are disabled in
		// the rendered markup (the read only strips of the nalog, of the kupac and of the cene) are
		// remembered the first time and are never enabled again.
		function robnoFaktureSetPanelEnabled(panelId, enabled) {
			const panel = document.getElementById(panelId);
			if (!panel) {
				return;
			}
			panel.setAttribute('data-enabled', enabled ? 'true' : 'false');
			const fields = panel.querySelector('[data-panel-fields]');
			if (!fields) {
				return;
			}
			// inert keeps the fields of the disabled control out of the focus order and out of reach of
			// the mouse, exactly like the markup the server renders.
			fields.classList.toggle('pointer-events-none', !enabled);
			fields.classList.toggle('opacity-60', !enabled);
			fields.inert = !enabled;
			fields.querySelectorAll('input, select, textarea').forEach(function (element) {
				if (element.dataset.robnoFaktureReadOnly === undefined) {
					element.dataset.robnoFaktureReadOnly = element.disabled ? 'true' : 'false';
				}
				if (element.dataset.robnoFaktureReadOnly === 'true') {
					return;
				}
				element.disabled = !enabled;
			});
		}

		// Only one control is editable: stavkeEditable = true locks the header and unlocks the stavke,
		// stavkeEditable = false does the opposite.
		function robnoFaktureSetMode(stavkeEditable, headerPanelId, stavkePanelId) {
			robnoFaktureSetPanelOpen(headerPanelId, !stavkeEditable);
			robnoFaktureSetPanelEnabled(headerPanelId, !stavkeEditable);
			robnoFaktureSetPanelOpen(stavkePanelId, stavkeEditable);
			robnoFaktureSetPanelEnabled(stavkePanelId, stavkeEditable);
			// "Izmeni" of the header switches from the stavke to the header: enabled with the stavke.
			const izmeni = document.getElementById('robno-fakture-izmeni');
			if (izmeni) izmeni.disabled = !stavkeEditable;
			if (stavkeEditable) robnoFaktureFokusStavke();
		}

		// The click of "Izmeni" in the title bar of the header: it does not open or close the control (the
		// click of its summary), it switches to the header.
		function robnoFaktureIzmeniKlik(evt, headerPanelId, stavkePanelId) {
			evt.preventDefault();
			evt.stopPropagation();
			robnoFaktureModifyHeader(headerPanelId, stavkePanelId);
		}

		// robnoFaktureUcitajDokument reloads the content of the screen (body) with a document (GET url with
		// the values; an error leaves the screen as it is).
		function robnoFaktureUcitajDokument(url, values, body) {
			htmx.ajax('GET', url, { target: '#' + body.id, swap: 'outerHTML', values: values });
		}

		// robnoFaktureBody returns the content of the screen of a combo (the element with the urls of the
		// documents: the faktura, the interni prenos, ...).
		function robnoFaktureBody(comboID) {
			const el = document.getElementById(comboID);
			return (el && el.closest('[data-dokument-url]')) || document.getElementById('robno-fakture-body');
		}

		// The broj dokumenta of a selected row opens its document by its id (OnSelect of the combo).
		function robnoFaktureOtvoriDokument(comboID, rdokid) {
			const body = robnoFaktureBody(comboID);
			if (!body || !rdokid) return;
			robnoFaktureUcitajDokument(body.dataset.dokumentUrl + '/' + encodeURIComponent(rdokid), { rnalid: body.dataset.rnalid }, body);
		}

		// A typed broj dokumenta opens its document of the vrsta, or a new one with that broj (OnFreeText of
		// the combo).
		function robnoFaktureNoviBroj(comboID, brdok) {
			const body = robnoFaktureBody(comboID);
			if (!body) return;
			// The broj of the screen left unchanged (e.g. the new document passed with Tab) keeps the form.
			const current = document.getElementById('brdok');
			if (current && current.value === brdok) return;
			robnoFaktureUcitajDokument(body.dataset.noviUrl, { rnalid: body.dataset.rnalid, vrd: body.dataset.vrd, brdok: brdok }, body);
		}

		// The focus in the šifra artikla, the first field of the stavke, when they become active.
		function robnoFaktureFokusStavke() {
			const sifra = document.getElementById('sifraartikla-combo-input');
			if (sifra && !sifra.disabled) {
				sifra.focus();
			}
		}

		// The content of the tab swapped with the saved header (the stavke active, see SaveRobFakture):
		// the focus goes to the šifra artikla.
		if (!window.robnoFaktureFokusListener) {
			window.robnoFaktureFokusListener = true;
			document.body.addEventListener('htmx:afterSettle', function () {
				const body = document.querySelector('[data-dokument-url][data-stavke-aktivne="true"]:not([data-fokus-postavljen])');
				if (!body) return;
				body.dataset.fokusPostavljen = 'true';
				robnoFaktureFokusStavke();
			});
		}

		// The title bar of a disabled control does not open it: the stavke are not available until the
		// header is saved.
		function robnoFaktureCanToggle(summary) {
			const panel = summary.parentElement;
			return !panel || panel.getAttribute('data-enabled') !== 'false';
		}

		// hx-on::after-request of "Sačuvaj" and of "Novi dok.": the header is locked and the stavke are
		// enabled only when the request was successful; otherwise the header stays editable (the handler
		// shows its messages).
		// After "Sačuvaj" of the header: the saved document replaced the content of the tab (the header
		// locked, the stavke open); the errors of the validation (JSON, not swapped) are shown under
		// their fields.
		function robnoFaktureAfterHeaderSave(headerPanelId, stavkePanelId) {
			if (!event.detail.successful) {
				handleBackendResponse();
			}
		}

		// OnSelect of the analitička šifra (a table combo of the search "analitika", whose cells are konto,
		// šifra, naziv, adresa, "poštanski broj mesto" and PIB): the data of the kupac are filled.
		// The filter of the search of the analitička šifra: the konto of the kupac is chosen first (the šifra
		// is searched in it); without it the details line of the šifra shows the hint to choose it.
		function robnoFaktureKontoIzabran() {
			const konto = document.getElementById('kupackonto');
			const izabran = !!(konto && konto.value.trim() !== '');
			const details = document.getElementById('kupacsifra-combo-details');
			const hint = document.getElementById('robno-fakture-konto-hint');
			if (details) details.textContent = izabran ? '' : (hint ? hint.textContent : '');
			return izabran;
		}

		// A new konto of the kupac clears the šifra and the data of the kupac (they belong to the old konto).
		if (!window.robnoFaktureKontoListener) {
			window.robnoFaktureKontoListener = true;
			// The konto before the change: kept when its field gets the focus.
			document.addEventListener('focusin', function (evt) {
				if (!evt.target || evt.target.id !== 'kupackonto-combo-input') return;
				const konto = document.getElementById('kupackonto');
				if (konto) konto.dataset.prethodni = konto.value;
			});
			document.addEventListener('change', function (evt) {
				if (!evt.target || evt.target.id !== 'kupackonto') return;
				if (evt.target.dataset.prethodni === evt.target.value) return;
				evt.target.dataset.prethodni = evt.target.value;
				['kupacsifra', 'kupacnaziv', 'kupacadresa', 'kupacpostanskibroj', 'kupacmesto', 'kupacpib'].forEach(id => {
					const el = document.getElementById(id);
					if (el) el.value = '';
				});
				const input = document.getElementById('kupacsifra-combo-input');
				if (input) input.value = '';
				const details = document.getElementById('kupacsifra-combo-details');
				if (details) details.textContent = '';
			});
		}

		function robnoFaktureKupacSelected(comboID, key, cells) {
			const set = (id, value) => { const el = document.getElementById(id); if (el) el.value = value || ''; };
			const mesto = (cells[4] || '').trim();
			const m = mesto.match(/^(\d+)\s+(.*)$/);
			set('kupacnaziv', cells[2]);
			set('kupacadresa', cells[3]);
			set('kupacpostanskibroj', m ? m[1] : '');
			set('kupacmesto', m ? m[2] : mesto);
			set('kupacpib', cells[5]);
		}

		// OnSelect of the poreska kategorija (a table combo of the search "poreske-kategorije", whose cells
		// are šifra, kategorija, tekst, zakon, član, stav, tačka and podtačka): the oznaka gets the
		// kategorija and the napomena o poreskom oslobođenju the članovi of the zakon ("član 24 stav 1
		// tačka 2", the parts "0" left out), like the legacy rob_Fakture; for a PDV obveznik and a
		// document that is not a storno the nastanak PDV obaveze is set to "-" (999), so the user has to
		// choose it again (the validation requires it). "-" clears them.
		function robnoFaktureKategorijaSelected(comboID, key, cells) {
			const set = (id, value) => { const el = document.getElementById(id); if (el) el.value = value; };
			const part = i => (cells[i] || '').trim();
			if (!key) {
				set('oznakakat', '');
				set('napomporeskoosl', '');
				return;
			}
			set('oznakakat', part(1));
			let napomena = 'član ' + part(4);
			[[5, ' stav '], [6, ' tačka '], [7, ' podtačka ']].forEach(([i, text]) => {
				if (part(i) !== '' && part(i) !== '0') napomena += text + part(i);
			});
			set('napomporeskoosl', napomena);
			const nastanak = document.getElementById('nastanakpdv');
			if (document.getElementById('robno-fakture-porkat-nastanak')?.value === '1' && nastanak &&
				Array.from(nastanak.options || []).some(o => o.value === '999')) {
				nastanak.value = '999';
			}
		}

		// ---- The stavke (the legacy rob_FAKTURE_DET) ----

		// A number of a field (1.234,56 or 1234.56; 0 when empty).
		function robnoBroj(id) {
			const el = document.getElementById(id);
			let v = el ? el.value.trim() : '';
			if (v === '') return 0;
			const zarez = v.lastIndexOf(','), tacka = v.lastIndexOf('.');
			if (zarez >= 0 && tacka >= 0) {
				v = zarez > tacka ? v.replace(/\./g, '').replace(',', '.') : v.replace(/,/g, '');
			} else if (zarez >= 0) {
				v = v.replace(',', '.');
			}
			const n = parseFloat(v);
			return isNaN(n) ? 0 : n;
		}
		function robnoUpisi(id, value) {
			const el = document.getElementById(id);
			if (el) el.value = value;
		}
		function robnoZaokruzi(n, decimale) {
			const f = Math.pow(10, decimale);
			return Math.round(n * f) / f;
		}

		// The iznos, the neto prodajna cena and the iznos of the rabat of the stavka (the legacy obracunaj, the
		// exits of the rabat); a changed neto prodajna cena gives the rabat (the legacy EDT_PRCE).
		function robnoFaktureStavkaObracunaj(izvor) {
			const kolicina = robnoBroj('kolicina'), cena = robnoBroj('prodajnacena');
			let rabat = robnoBroj('rabatstavke');
			if (izvor === 'netoprodajnacena' && cena !== 0) {
				const neto = robnoBroj('netoprodajnacena');
				if (neto !== robnoZaokruzi(cena - rabat * cena / 100, 4)) {
					rabat = (cena - neto) / cena * 100;
					robnoUpisi('rabatstavke', String(robnoZaokruzi(rabat, 4)));
				}
			} else {
				robnoUpisi('netoprodajnacena', String(robnoZaokruzi(cena - rabat * cena / 100, 4)));
			}
			const iznos = kolicina * cena;
			robnoUpisi('iznosstavke', iznos.toFixed(2));
			robnoUpisi('iznosrabata', (rabat * iznos / 100).toFixed(2));
		}

		// The osnov oslobođenja is shown for the poreske kategorije S10 and S20 (else "-").
		function robnoFaktureTaxcat() {
			const taxcat = document.getElementById('taxcat');
			const wrap = document.getElementById('robno-fakture-taxexem');
			if (!taxcat || !wrap) return;
			const vidljiv = taxcat.value === 'S10' || taxcat.value === 'S20';
			wrap.classList.toggle('hidden', !vidljiv);
			if (!vidljiv) robnoUpisi('taxexreco', '-');
		}

		// The artikal of the stavka (the legacy exit of EDT_SIFRA): its data, its stanje and cene in the konto
		// of the magacin and the last cena to the kupac come from the server.
		function robnoFaktureStavkaArtikal() {
			const forma = document.getElementById('robno-fakture-stavka');
			const sifra = document.getElementById('sifraartikla');
			if (!forma || !sifra) return;
			const vrednost = sifra.value.trim();
			const details = document.getElementById('sifraartikla-combo-details');
			if (details) details.textContent = '';
			if (vrednost === '') return;
			const url = forma.dataset.artikalUrl + '?' + new URLSearchParams({
				rdokid: document.getElementById('stavkardokid').value, sifra: vrednost,
				konto: document.getElementById('kontostavke').value,
			});
			fetch(url, { headers: { 'Accept': 'application/json' } })
				.then(r => r.json())
				.then(odgovor => {
					if (!odgovor.found) {
						if (details) details.textContent = odgovor.message || 'Artikal ne postoji.';
						['jm', 'stopastavke', 'stanje', 'prodajnacena', 'nabavnacena', 'magacinskacena', 'dani'].forEach(id => robnoUpisi(id, ''));
						return;
					}
					const a = odgovor.artikal;
					sifra.value = String(a.sifra);
					robnoUpisi('sifraartikla-combo-input', a.sifra + ' - ' + a.naziv);
					robnoUpisi('jm', a.jm);
					robnoUpisi('tarifa', String(a.tarifa));
					robnoUpisi('stopastavke', String(a.stopa));
					robnoUpisi('dani', String(a.dani));
					robnoUpisi('kontostavke', a.konto);
					robnoUpisi('stanje', String(a.stanje));
					robnoUpisi('prodajnacena', String(a.cena));
					robnoUpisi('magacinskacena', String(a.magacinskacena));
					robnoUpisi('nabavnacena', String(a.nabavnacena));
					const nabavna = document.getElementById('nabavnacena');
					if (nabavna) nabavna.readOnly = !a.nabavnaunos;
					const taxcat = document.getElementById('taxcat');
					if (a.taxcat && taxcat && Array.from(taxcat.options).some(o => o.value === a.taxcat)) {
						taxcat.value = a.taxcat;
						robnoFaktureTaxcat();
					}
					robnoUpisi('zadnjacena', String(a.zadnjacena));
					robnoUpisi('zadnjirabat', String(a.zadnjirabat));
					robnoUpisi('zadnjidatum', a.zadnjidatum);
					const poruka = document.getElementById('zadnjacenaporuka');
					if (poruka) poruka.textContent = a.poruka || '';
					const koristi = document.getElementById('koristiposlednjirabat');
					robnoUpisi('rabatstavke', koristi && koristi.checked ? String(a.zadnjirabat) : '0');
					robnoFaktureStavkaObracunaj();
					const kolicina = document.getElementById('kolicina');
					if (kolicina) kolicina.focus();
				});
		}

		// "Izmeni" of a row of the grid of the stavke (the legacy "Izmene"): the stavka of the answer (JSON) in
		// the form; it is saved as a change (the stanje gets the difference).
		function robnoFaktureStavkaUcitaj(evt) {
			let odgovor;
			try {
				odgovor = JSON.parse(evt.detail.xhr.responseText);
			} catch (e) {
				return;
			}
			if (!odgovor.found) {
				alert(odgovor.message || 'Stavka ne postoji.');
				return;
			}
			const st = odgovor.stavka;
			robnoUpisi('stavkarproid', String(st.rproid));
			robnoUpisi('sifraartikla', String(st.sifra));
			robnoUpisi('sifraartikla-combo-input', st.sifra + ' - ' + st.naziv);
			robnoUpisi('kontostavke', st.konto);
			robnoUpisi('jm', st.jm);
			robnoUpisi('kolicina', String(st.kolicina));
			robnoUpisi('prodajnacena', String(st.cena));
			robnoUpisi('rabatstavke', String(st.rabat));
			robnoUpisi('tarifa', String(st.tarifa));
			robnoUpisi('stopastavke', String(st.stopa));
			robnoUpisi('dani', String(st.dani));
			robnoUpisi('nabavnacena', String(st.nabavnacena));
			robnoUpisi('magacinskacena', String(st.magacinskacena));
			robnoUpisi('stanje', String(st.stanje));
			robnoUpisi('otk', st.otk);
			robnoUpisi('serija', st.serija);
			robnoUpisi('rokstavke', st.rok);
			robnoUpisi('taxcat', st.taxcat);
			robnoUpisi('taxexreco', st.taxexreco);
			robnoFaktureTaxcat();
			const nabavna = document.getElementById('nabavnacena');
			if (nabavna) nabavna.readOnly = st.nabavnacena !== 0;
			robnoFaktureStavkaObracunaj();
			robnoFaktureStavkeGridEnabled(false);
			robnoFaktureOdustaniEnabled(true);
			const kolicina = document.getElementById('kolicina');
			if (kolicina) kolicina.focus();
		}

		// "Odustani" of the change of a stavka: the grid of the stavke and its search are unlocked again and
		// "Odustani" is disabled; the form is no more the stavka of the row (a next "Sačuvaj" adds a stavka).
		function robnoFaktureStavkaOdustani() {
			robnoUpisi('stavkarproid', '0');
			robnoFaktureStavkeGridEnabled(true);
			robnoFaktureOdustaniEnabled(false);
		}

		// The state of "Odustani" of the change of a stavka.
		function robnoFaktureOdustaniEnabled(enabled) {
			const btn = document.getElementById('robno-fakture-stavka-odustani');
			if (!btn) return;
			btn.disabled = !enabled;
			btn.classList.toggle('opacity-50', !enabled);
			btn.classList.toggle('cursor-not-allowed', !enabled);
		}

		// The grid of the stavke with its search: locked while a stavka is changed (no other row can be
		// chosen), unlocked again by the content of the tab that comes back after "Sačuvaj".
		function robnoFaktureStavkeGridEnabled(enabled) {
			const grid = document.getElementById('robno-fakture-stavke-grid');
			if (!grid) return;
			grid.inert = !enabled;
			grid.classList.toggle('opacity-50', !enabled);
			grid.classList.toggle('pointer-events-none', !enabled);
			grid.querySelectorAll('input, select, button').forEach(el => { el.disabled = !enabled; });
		}

		// After "Sačuvaj" of the stavka: the content came back with the saved stavka (the focus to the šifra
		// for the next one); the errors of the validation (JSON, not swapped) are shown under their fields.
		function robnoFaktureAfterStavkaSave() {
			if (!event.detail.successful) {
				handleBackendResponse();
			}
		}

		// The events of the form of the stavke (delegated: the form comes back with the content of the tab).
		if (!window.robnoFaktureStavkeListener) {
			window.robnoFaktureStavkeListener = true;
			document.addEventListener('input', function (evt) {
				const id = evt.target && evt.target.id;
				if (id === 'kolicina' || id === 'prodajnacena' || id === 'rabatstavke') robnoFaktureStavkaObracunaj(id);
				if (id === 'netoprodajnacena') robnoFaktureStavkaObracunaj('netoprodajnacena');
			});
			document.addEventListener('change', function (evt) {
				const id = evt.target && evt.target.id;
				if (id === 'sifraartikla') robnoFaktureStavkaArtikal();
				if (id === 'taxcat') robnoFaktureTaxcat();
				if (id === 'koristiposlednjirabat') {
					const rabat = document.getElementById('rabatstavke');
					if (evt.target.checked) {
						rabat.dataset.stariRabat = rabat.value;
						rabat.value = document.getElementById('zadnjirabat').value;
					} else if (rabat.dataset.stariRabat !== undefined) {
						rabat.value = rabat.dataset.stariRabat;
					}
					robnoFaktureStavkaObracunaj();
				}
			});
			// The cena of a document in a foreign valuta is entered in its valuta and converted by the kurs
			// (the legacy exit of EDT_CENA).
			document.addEventListener('focusout', function (evt) {
				if (!evt.target || evt.target.id !== 'prodajnacena') return;
				const forma = document.getElementById('robno-fakture-stavka');
				if (!forma || forma.dataset.devizni !== 'true' || evt.target.dataset.konvertovano === evt.target.value) return;
				const kurs = parseFloat(forma.dataset.kurs) || 0, vaziza = parseFloat(forma.dataset.vaziza) || 0;
				if (kurs !== 0 && vaziza > 0) {
					evt.target.value = String(robnoZaokruzi(robnoBroj('prodajnacena') * kurs / vaziza, 4));
					evt.target.dataset.konvertovano = evt.target.value;
					robnoFaktureStavkaObracunaj();
				}
			});
		}

		// "+ Dodaj avans": a new empty row (a copy of the template row) at the end of the grid of the
		// avansi, with the focus in its broj of the avansni račun.
		function robnoFaktureAvansDodaj(gridID) {
			const grid = document.getElementById(gridID);
			const body = grid && grid.querySelector('[data-robno-avansi]');
			const tpl = grid && grid.querySelector('template[data-robno-avansi-novi]');
			if (!body || !tpl || !tpl.content.firstElementChild) return;
			const row = tpl.content.firstElementChild.cloneNode(true);
			body.appendChild(row);
			const input = row.querySelector('input[name="avansbrdok"]');
			if (input) input.focus();
		}

		// "Traži" of a row of the avansi: the search of the avansni računi of the kupac, which fills the
		// row with the selected avans (TODO: the popup of the legacy search of the avansi).
		function robnoFaktureAvansTrazi(button) {
			const row = button.closest('tr');
			const input = row && row.querySelector('input[name="avansbrdok"]');
			if (input) input.focus();
		}

		// "Obriši" of a row of the avansi: the row is removed (the header is saved without it).
		function robnoFaktureAvansObrisi(button) {
			const row = button.closest('tr');
			if (row) row.remove();
		}

		// onclick of "Izmeni": the header is unlocked and the stavke are locked again.
		function robnoFaktureModifyHeader(headerPanelId, stavkePanelId) {
			robnoFaktureSetMode(false, headerPanelId, stavkePanelId);
		}
	</script>
}

// robnoFaktureHeaderStateText is the text of the title bar of the header control.
func robnoFaktureHeaderStateText(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Podaci su sačuvani - koristite Izmeni za izmenu")
	}
	return translator.Label("Podaci o fakturi nisu sačuvani")
}

// robnoFaktureStavkeStateText is the text of the title bar of the stavke control: the stavke are
// available only after the header is saved.
func robnoFaktureStavkeStateText(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Unos stavki je omogućen")
	}
	return translator.Label("Sačuvajte podatke o fakturi da bi ste mogli da radite sa stavkama")
}

// robnoFaktureState returns the value of the data-enabled attribute of a control.
func robnoFaktureState(enabled bool) string {
	if enabled {
		return "true"
	}
	return "false"
}

// robnoFaktureNalogStripFields defines the fields of the strip of the nalog (the two row header both
// legacy windows show above the form): the nalog, its totals and the magacin of the dokument. Every
// field is one column of the strip: the label is the first line, the value the second one. The widths
// are percentages of the strip, so the strip always fits the form; the magacin has no width, so it
// takes the rest of the strip.
func robnoFaktureNalogStripFields(header domain.RobnoFaktureHeaderView, translator *i18n.Service) []domain.RobnoFaktureStripField {
	return []domain.RobnoFaktureStripField{
		{ID: "vrnal", Label: translator.Label("Vr. nal."), Value: header.VrNal, WidthClass: "w-[5%]"},
		{ID: "nalog", Label: translator.Label("Nalog"), Value: header.Nalog, WidthClass: "w-[7%]"},
		{ID: "datumnaloga", Label: translator.Label("Datum naloga"), Value: header.DatumNaloga, WidthClass: "w-[12%]"},
		{ID: "ukdokum", Label: translator.Label("Uk. dokum."), Value: header.UkDokum, WidthClass: "w-[9%]"},
		{ID: "ukstavki", Label: translator.Label("Uk. stavki"), Value: header.UkStavki, WidthClass: "w-[9%]"},
		{ID: "duguje", Label: translator.Label("Duguje"), Value: header.Duguje, WidthClass: "w-[11%]", AlignClass: "text-right"},
		{ID: "potrazuje", Label: translator.Label("Potražuje"), Value: header.Potrazuje, WidthClass: "w-[13%]", AlignClass: "text-right"},
		{ID: "iznosdokum", Label: translator.Label("Iznos dokum."), Value: header.IznosDokum, WidthClass: "w-[13%]", AlignClass: "text-right"},
		// The magacin is the last field of the strip and takes the rest of its width.
		{ID: "magacin", Label: translator.Label("Magacin"), Value: header.Magacin},
	}
}

// robnoFaktureDate renders a date of the header of the faktura for the date input of the form (the ISO
// layout of an <input type="date">, empty when the date is not set).
func robnoFaktureDate(value time.Time) string {
	if value.IsZero() {
		return ""
	}
	return value.Format(common.HtmlLayout)
}

// robnoFaktureDecimal renders a decimal value of the header of the faktura the way the handler used to
// format it (empty when the value is not set).
func robnoFaktureDecimal(value float64, precision int) string {
	if value == 0 {
		return ""
	}
	return common.FormatNumberWithSystemLocale(value, precision)
}

// robnoFaktureNullID renders the key (primary key) of a table combo of the header (empty when it is
// not set).
func robnoFaktureNullID(value sql.NullInt64) string {
	if !value.Valid || value.Int64 == 0 {
		return ""
	}
	return strconv.FormatInt(value.Int64, 10)
}

// robnoFaktureID renders an id of the screen ("" for 0, a document that is not saved).
func robnoFaktureID(id int64) string {
	if id <= 0 {
		return ""
	}
	return strconv.FormatInt(id, 10)
}

// robnoFaktureDokumentSearchVals are the parameters of the search of the broj dokumenta: the documents
// of the vrsta in the nalog.
func robnoFaktureDokumentSearchVals(header domain.RobnoFaktureHeaderView) string {
	vals, _ := json.Marshal(map[string]string{"vrd": header.Vrd, "rnalid": strconv.FormatInt(header.RnalID, 10)})
	return string(vals)
}

// robnoFaktureTaxexemClass is the class of the osnov oslobođenja of a stavka: shown for the poreske
// kategorije S10 and S20 (the legacy COMBO_TAXEXEM..Visible).
func robnoFaktureTaxexemClass(taxcat string) string {
	if taxcat == "S10" || taxcat == "S20" {
		return ""
	}
	return "hidden"
}

// robnoFakturePanelFill returns the classes of a control that fills the rest of the screen when it is
// open (fill: the stavke, whose grid then reaches the bottom of the dialog), else "".
func robnoFakturePanelFill(fill bool, classes string) string {
	if fill {
		return classes
	}
	return ""
}

// robnoFaktureFlag renders a flag of the screen for its scripts ("1" or "").
func robnoFaktureFlag(value bool) string {
	if value {
		return "1"
	}
	return ""
}

// robnoFaktureInt renders a whole number of the header of the faktura (empty when it is not set).
func robnoFaktureInt(value int) string {
	if value == 0 {
		return ""
	}
	return strconv.Itoa(value)
}
