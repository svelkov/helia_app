package robno

// The screens of the entry of the robni dokumenti of a robni nalog (the legacy windows opened by
// "Snimi nalog" of the "Unos dokumenta" tab, by the group of the vrsta dokumenta; see the handler
// RobnoDokumentaUnosHandler). For now: the "Fakture veleprodaje" screen (the groups FAK, FRP, KPK and
// FZR, the legacy rob_Fakture).

import (
	"strconv"
	"time"

	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

//
// Fakture veleprodaje - the header of the faktura and its stavke
// RobnoFakture renders the "Fakture veleprodaje" screen: the two collapsible controls inside the shell
// of "Robna dokumenta" (tabs and sub-tabs) and the script that switches the editable control.
templ RobnoFakture(ui domain.RobnoFaktureUI, tabs, subTabs domain.TabData, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoDokumentaShell(tabs, subTabs, translator, RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator))
	<!-- Scripts the screen shares with the other robno forms: the search popups (F3 / "...") and the
	     inline validation errors -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
	@RobnoFaktureScript()
}

// RobnoFaktureDialog renders the "Fakture veleprodaje" screen inside a modal dialog: the same content
// as RobnoFakture without the tab bar of the option (the dialog covers the tab, which stays open
// behind it) plus the title bar with the "Zatvori" button. The dialog is not removed when it is
// closed (closeDialog only hides it, so that the fade-out is visible): the next request renders it
// again.
templ Rob_Fakture(ui domain.RobnoFaktureUI, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, btnClose domain.Button, searchInput domain.InputControl, translator *i18n.Service, csrfToken string) {
	<!-- The CSRF token of the session in the header of the requests of the screen (the POST/PUT/DELETE of
	     the header and of the stavke), like the forms of the other screens. -->
	<div id={ ui.DialogID } class={ common.ClassMainDialogDiv } hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }>
		<div class="bg-blue-100 rounded-lg shadow-2xl flex flex-col w-[95vw] h-[90vh]">
			<!-- Title bar of the dialog -->
			<div class="bg-blue-600 text-white h-9 flex justify-between items-center rounded-t-lg flex-shrink-0">
				<h2 class="text-lg font-semibold ml-4">{ translator.Label("Fakture veleprodaje") }</h2>
				@components.CloseButton(btnClose)
			</div>
			<!-- Content: the strip of the vrsta fakture, the collapsible control of the header and the
			     collapsible control of the stavke -->
			<div class="flex-1 min-h-0 overflow-auto p-1">
				@RobnoFaktureBody(ui, tbl, avansiTbl, header, stavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, searchInput, translator)
			</div>
		</div>
	</div>
	@RobnoFaktureScript()
	<!-- The scripts the tab installs for the screen (the dialog is rendered on its own, so it has to
	     install them itself) -->
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@components.SpinnerScript()
}

// RobnoFaktureBody renders the content of the screen: the strip with the vrsta fakture, the first
// collapsible control (the header of the faktura) and the second one (the stavke).
templ RobnoFaktureBody(ui domain.RobnoFaktureUI, tbl, avansiTbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0">
		@RobnoFaktureDokumentBar(header, btns.Back, translator)
		@RobnoFaktureHeaderPanel(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, btns, translator)
		@RobnoFaktureStavkePanel(ui, tbl, header, stavka, btns, searchInput, translator)
	</div>
}

// RobnoFakturePanel is one of the two collapsible controls of the screen: a <details> element whose
// <summary> is the title bar. While the control is disabled its fields are not editable and its
// summary does not open it, so the user can see and change only the control that is currently active.
// The fields and the buttons are two slots: the script disables the controls of [data-panel-fields]
// only, so the buttons of the control (e.g. "Izmeni" of the header) stay clickable even when the
// control itself is locked. The fields of a disabled control carry the inert attribute, so they cannot
// be reached with the mouse or with the keyboard either.
templ RobnoFakturePanel(id, title, stateText string, open, enabled bool, fields, buttons templ.Component) {
	<details
		id={ id }
		open?={ open }
		data-enabled={ robnoFaktureState(enabled) }
		class="group w-full rounded-lg border border-blue-400 bg-blue-100"
	>
		<summary
			onclick="return robnoFaktureCanToggle(this)"
			class="px-2 py-1 cursor-pointer select-none flex items-center gap-1 bg-blue-200 rounded-t-lg font-semibold text-sm text-blue-900"
		>
			<span class="text-blue-700 transition-transform group-open:rotate-90">&#9654;</span>
			{ title }
			<span class="ml-auto font-normal text-xs text-blue-800">{ stateText }</span>
		</summary>
		<div class="p-1 flex flex-col gap-1">
			<!-- The fields of a disabled control are dimmed and do not accept the mouse: the same
			     classes robnoFaktureSetPanelEnabled toggles at runtime. -->
			<div
				data-panel-fields
				inert?={ !enabled }
				if enabled {
					class="flex flex-col gap-1"
				} else {
					class="flex flex-col gap-1 opacity-60 pointer-events-none"
				}
			>
				@fields
			</div>
			<div class="flex items-center justify-end gap-1">
				@buttons
			</div>
		</div>
	</details>
}

// RobnoFaktureDokumentBar renders the strip above the two controls: the vrsta fakture (Otpremnica /
// Račun) with the checkbox "Štampaj detalje u stavkama" and the "Nazad" button, like the blue bar of
// the two WinDev windows. The radios are disabled while the header is saved (they belong to the
// header), the checkbox too.
templ RobnoFaktureDokumentBar(header domain.RobnoFaktureHeaderView, btnBack domain.Button, translator *i18n.Service) {
	<div class="flex items-center gap-2 border border-blue-400 bg-blue-100 rounded-lg px-1 py-0.5">
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="otpremnica"
				value="O"
				class={ common.ClassCheckbox }
				checked?={ header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-24" }>{ translator.Label("Otpremnica") }</span>
		</label>
		<label class="flex items-center gap-1">
			<input
				type="radio"
				name="vrstafakture"
				id="racun"
				value="R"
				class={ common.ClassCheckbox }
				checked?={ !header.Otpremnica }
				disabled?={ header.Snimljen }
			/>
			<span class={ common.ClassLabel + " w-16" }>{ translator.Label("Račun") }</span>
		</label>
		<div class="flex-1 flex justify-center">
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "stampajdetalje",
				Name:              "stampajdetalje",
				LabelText:         translator.Label("Štampaj detalje u stavkama"),
				ClassLabel:        common.ClassLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: "text-sm",
				IsChecked:         header.StampajDetalje,
				Disabled:          header.Snimljen,
				TabIndex:          "0"}, translator)
		</div>
		@components.Button(btnBack)
	</div>
}

// RobnoFaktureHeaderPanel renders the first collapsible control: the header of the faktura, i.e. the
templ RobnoFaktureHeaderPanel(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	@RobnoFakturePanel(ui.HeaderPanelID, translator.Label("Podaci o fakturi"), robnoFaktureHeaderStateText(header.Snimljen, translator), !header.Snimljen, !header.Snimljen, RobnoFaktureHeaderFields(ui, header, avansiTbl, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues, translator), RobnoFaktureHeaderButtons(btns))
}

// RobnoFaktureHeaderFields renders the fields of the header of the faktura: the strip of the nalog,
templ RobnoFaktureHeaderFields(ui domain.RobnoFaktureUI, header domain.RobnoFaktureHeaderView, avansiTbl domain.TableData, vrstaDokumentaValues, valutaValues, sistemPdvValues, zirpRacunValues []domain.ComboItem, translator *i18n.Service) {
	<!-- Nalog: the read only strip both windows show above the form. It is laid out like the two row
	     header of the legacy window: the first line is the label of the field, the second one its value
	     (see robnoFaktureNalogStripFields). It spans both columns. -->
	<fieldset class="border border-blue-400 bg-blue-100">
		@RobnoFaktureReadOnlyStrip(robnoFaktureNalogStripFields(header, translator))
	</fieldset>
	<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-1">
		<!-- ===== Left column: podaci o dokumentu, podaci o kupcu, podaci o načinu otpreme ===== -->
		<div class="flex flex-col gap-1 min-w-0 h-full">
			<!-- Podaci o dokumentu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
				<div class="flex flex-col gap-y-1">
					<!-- Row 1: the vrsta dokumenta (read only - it is chosen on the "Unos dokumenta" tab) and the
			     broj dokumenta with the search of the robni dokumenti -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "vrd",
								LabelText:  translator.Label("Vrsta dokumenta"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "vrd",
								Name:       "vrd",
								FieldType:  "text",
								Value:      header.Vrd,
								Disabled:   true,
								ClassInput: common.ClassInputTextDisabled + " w-80 min-w-0"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdok",
								LabelText:  translator.Label("Broj dokumenta"),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "brdok",
								Name:       "brdok",
								FieldType:  "text",
								Value:      header.BrojDokum,
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								MaxLength:  "10",
								TabIndex:   "1",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
							@components.SearchButton(domain.SearchButtonConfig{ID: "brdok", Name: "search-brdok", HxUrl: ui.DokumentSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "brdok"}`, ClassButton: common.ClassButton})
						</div>
					</div>
					<!-- Row 2: the datum fakturisanja, the broj and the datum of the izvorni dokument -->
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumfakturisanja",
								LabelText:  translator.Label("Datum fakturisanja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumfakturisanja",
								Name:       "datumfakturisanja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumDokum),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "2",
								OnInput:    "clearFieldError",
								OnFocus:    "clearFieldError"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "brdokorg",
								LabelText:  translator.Label("Broj orig. dokumenta"),
								ClassLabel: common.ClassLabel + " w-28",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "brdokorg",
								Name:       "brdokorg",
								FieldType:  "text",
								Value:      header.IzvorniDokum,
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								MaxLength:  "20",
								TabIndex:   "3"})
						</div>
						<div class="flex items-center gap-1 flex-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumizvora",
								LabelText:  translator.Label("Datum izvor. dokum."),
								ClassLabel: common.ClassLabel + " w-32",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumizvora",
								Name:       "datumizvora",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.IzvorniDokDatum),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
								TabIndex:   "4"})
						</div>
					</div>
					<!-- Row 3: the opis -->
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "opis",
							LabelText:  translator.Label("Opis"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "opis",
							Name:       "opis",
							FieldType:  "text",
							Value:      header.Opis,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "5"})
					</div>
					<!-- Row 4: the checkbox "Za period od / do" with its two dates, then the datum smanjenja -->
					<div class="flex flex-wrap items-center gap-1">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "zaperiod",
							Name:              "zaperiod",
							LabelText:         translator.Label("Za period"),
							ClassLabel:        common.ClassLabel + " w-28",
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.ZaPeriod,
							Disabled:          header.Snimljen,
							TabIndex:          "6"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "periodod",
							LabelText:  translator.Label("Od"),
							ClassLabel: common.ClassLabel + " w-7",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "periodod",
							Name:       "periodod",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodOd),
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-32",
							TabIndex:   "7"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "perioddo",
							LabelText:  translator.Label("Do"),
							ClassLabel: common.ClassLabel + " w-10",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "perioddo",
							Name:       "perioddo",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.PeriodDo),
							Disabled:   !header.ZaPeriod || header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-[6rem]",
							TabIndex:   "8"})
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "datumsmanjenja",
								LabelText:  translator.Label("Datum smanjenja"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "datumsmanjenja",
								Name:       "datumsmanjenja",
								FieldType:  "date",
								Value:      robnoFaktureDate(header.DatumSmanjenja),
								Disabled:   header.Snimljen,
								ClassInput: common.ClassInputTextEnabled + " !w-32",
								TabIndex:   "9"})
						</div>
					</div>
				</div>
			</fieldset>
			<!-- Podaci o kupcu -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o kupcu") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Mesto isporuke, komercijalista, tender, napomena..."): the konto and the analitička
				     šifra with their searches of the partneri, the naziv with the adresa, the poštanski broj
				     with the mesto and the PIB with the sistem PDV. Every label has the same width (w-36), so
				     the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Konto kupca and the analitička šifra, every one with the search of the partneri -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupackonto",
							LabelText:  translator.Label("Konto kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupackonto",
							Name:       "kupackonto",
							FieldType:  "text",
							Value:      header.KupacKonto,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "10"})
						@components.SearchButton(domain.SearchButtonConfig{ID: "kupackonto", Name: "search-kupackonto", HxUrl: ui.PartnerSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "kupackonto"}`, ClassButton: common.ClassButton})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacsifra",
							LabelText:  translator.Label("Analitička šifra"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacsifra",
							Name:       "kupacsifra",
							FieldType:  "text",
							Value:      header.KupacSifra,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "11"})
						@components.SearchButton(domain.SearchButtonConfig{ID: "kupacsifra", Name: "search-kupacsifra", HxUrl: ui.PartnerSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "kupacsifra"}`, ClassButton: common.ClassButton})
					</div>
					<!-- Naziv kupca and the adresa (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacnaziv",
							LabelText:  translator.Label("Naziv kupca"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacnaziv",
							Name:       "kupacnaziv",
							FieldType:  "text",
							Value:      header.KupacNaziv,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "60",
							TabIndex:   "12"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacadresa",
							LabelText:  translator.Label("Adresa"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacadresa",
							Name:          "kupacadresa",
							FieldType:     "text",
							Value:         header.KupacAdresa,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "60",
							TabIndex:      "13",
							DataDestField: "kupacadresa"})
					</div>
					<!-- Poštanski broj and the mesto (both of them are read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpostanskibroj",
							LabelText:  translator.Label("Poštanski broj"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpostanskibroj",
							Name:       "kupacpostanskibroj",
							FieldType:  "text",
							Value:      header.KupacPostanskiBroj,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "10",
							TabIndex:   "14"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacmesto",
							LabelText:  translator.Label("Mesto"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:            "kupacmesto",
							Name:          "kupacmesto",
							FieldType:     "text",
							Value:         header.KupacMesto,
							Disabled:      true,
							ClassInput:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:     "40",
							TabIndex:      "15",
							DataDestField: "kupacmesto"})
					</div>
					<!-- PIB / JIB and the sistem PDV (read only) -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "kupacpib",
							LabelText:  translator.Label("PIB / JIB"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kupacpib",
							Name:       "kupacpib",
							FieldType:  "text",
							Value:      header.KupacPib,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "16"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "sistempdv",
							LabelText:  translator.Label("Sistem PDV"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "sistempdv",
							Name:          "sistempdv",
							HasLabel:      false,
							Disabled:      true,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  sistemPdvValues,
							SelectedValue: header.SistemPdv,
							TabIndex:      "17"}, translator)
					</div>
				</div>
			</fieldset>
			<!-- Podaci o načinu otpreme, rokovima, valuti... : it is the last panel of the column, so it grows
			     to fill the space the right column leaves free at the bottom (both columns end on the same
			     line) -->
			<fieldset class="flex-1 border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o načinu otpreme, rokovima, valuti...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row (the same layout as the panel
				     "Podaci o kupcu"): the fields of a line stay together in the row (the first row holds the
				     valuta with its kurs and the "važi za", the rows of a single field keep the field over the
				     whole row). Every label has the same width (w-36), so the controls of all the rows start at
				     the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- The šifra valute with its combo over 1/2 of the row and the other two controls (the
					     "važi za" and the kurs) over the other 1/2, 1/4 of the row each -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						<div class="flex-1 flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "valuta",
								LabelText:  translator.Label("Šifra valute"),
								ClassLabel: common.ClassLabel + " w-36",
							})
							@components.ComboBoxField(domain.ComboFieldConfig{
								ID:            "valuta",
								Name:          "valuta",
								HasLabel:      false,
								Disabled:      header.Snimljen,
								ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
								OptionValues:  valutaValues,
								SelectedValue: robnoFaktureInt(header.Valuta),
								TabIndex:      "18"}, translator)
						</div>
						<div class="flex-1 flex items-center gap-1 min-w-0">
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "vaziza",
									LabelText:  translator.Label("Važi za (1,100)"),
									ClassLabel: common.ClassLabel + " w-36 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "vaziza",
									Name:       "vaziza",
									FieldType:  "text",
									Value:      robnoFaktureInt(header.VaziZa),
									Disabled:   header.Snimljen,
									ClassInput: common.ClassInputTextEnabled + " w-12 text-right",
									MaxLength:  "3",
									TabIndex:   "19"})
							</div>
							<div class="flex-1 flex items-center gap-1 min-w-0">
								@components.LabelField(domain.LabelFieldConfig{
									ID:         "kurs",
									LabelText:  translator.Label("Kurs"),
									ClassLabel: common.ClassLabel + " w-16 pl-2",
								})
								@components.TextInputField(domain.InputFieldConfig{
									ID:         "kurs",
									Name:       "kurs",
									FieldType:  "text",
									Value:      robnoFaktureDecimal(header.Kurs, 2),
									Disabled:   header.Snimljen,
									ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
									MaxLength:  "15",
									TabIndex:   "20"})
							</div>
						</div>
					</div>
					<!-- BrojRata, DatumPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojrata",
							LabelText:  translator.Label("Broj rata"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojrata",
							Name:       "brojrata",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojRata),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "21"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "datumprverate",
							LabelText:  translator.Label("Dat. dosp. prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "datumprverate",
							Name:       "datumprverate",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.DatumPrveRate),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "22"})
					</div>
					<!-- IznosFakture, IznosPrveRate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosfakture",
							LabelText:  translator.Label("Iznos fakture"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosfakture",
							Name:       "iznosfakture",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosFakture, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "23"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "iznosprverate",
							LabelText:  translator.Label("Iznos prve rate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "iznosprverate",
							Name:       "iznosprverate",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.IznosPrveRate, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "24"})
					</div>
					<!-- UsloviPlacanja, UsloviKamate -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "usloviplacanja",
							LabelText:  translator.Label("Uslovi plaćanja"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "usloviplacanja",
							Name:       "usloviplacanja",
							FieldType:  "text",
							Value:      header.UsloviPlacanja,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "25"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "uslovikamate",
							LabelText:  translator.Label("Uslovi kamate"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "uslovikamate",
							Name:       "uslovikamate",
							FieldType:  "text",
							Value:      header.UsloviKamate,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "26"})
					</div>
					<!-- Rok, Dospeva -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "rok",
							LabelText:  translator.Label("Rok"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "rok",
							Name:       "rok",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.Rok),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "3",
							TabIndex:   "27"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "dospeva",
							LabelText:  translator.Label("Dospeva"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "dospeva",
							Name:       "dospeva",
							FieldType:  "date",
							Value:      robnoFaktureDate(header.Dospeva),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:   "28"})
					</div>
					<!-- ZiroRacun -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "ziroracun",
							LabelText:  translator.Label("Ziro račun"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:            "ziroracun",
							Name:          "ziroracun",
							HasLabel:      false,
							Disabled:      header.Snimljen,
							ClassSelect:   common.ClassInputTextEnabled + " flex-1 min-w-0",
							OptionValues:  zirpRacunValues,
							SelectedValue: header.ZirpRacun,
							TabIndex:      "29"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nacinotpreme",
							LabelText:  translator.Label("Način otpreme"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "nacinotpreme",
							Name:       "nacinotpreme",
							FieldType:  "text",
							Value:      header.NacinOtpreme,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "30"})
					</div>
					<!-- Broj ugovora, Narudžbenica -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojugovora",
							LabelText:  translator.Label("Broj ugovora"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojugovora",
							Name:       "brojugovora",
							FieldType:  "text",
							Value:      header.BrojUgovora,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "31"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "narudzbenica",
							LabelText:  translator.Label("Narudžbenica"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "narudzbenica",
							Name:       "narudzbenica",
							FieldType:  "text",
							Value:      header.Narudzbenica,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "32"})
					</div>
					<!-- Paritet, IzvozIzjava -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "paritet",
							LabelText:  translator.Label("Paritet"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "paritet",
							Name:       "paritet",
							FieldType:  "text",
							Value:      header.Paritet,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "33"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "izvozizjava",
							LabelText:  translator.Label("Izvoz. izjava"),
							ClassLabel: common.ClassLabel + " w-36 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "izvozizjava",
							Name:       "izvozizjava",
							FieldType:  "text",
							Value:      header.IzvozIzjava,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "34"})
					</div>
					<!-- BankaUplatu -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "bankauplatu",
							LabelText:  translator.Label("Banka za uplatu - izvoz"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "bankauplatu",
							Name:       "bankauplatu",
							FieldType:  "text",
							Value:      header.BankaIzvozUplatu,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "35"})
					</div>
					<!-- Popdv -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "popdv",
							LabelText:  translator.Label("Polje POPDV"),
							ClassLabel: common.ClassLabel + " w-36",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "popdv",
							Name:       "popdv",
							FieldType:  "text",
							Value:      header.Popdv,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "4",
							TabIndex:   "36"})
					</div>
				</div>
			</fieldset>
			<!-- ===== End of the left column, start of the right column ===== -->
		</div>
		<div class="flex flex-col gap-1 min-w-0">
			<!-- Podaci o porezom oslobođenju, nastanku PDV obaveze -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o porezom oslobođenju, nastanku PDV obaveze") }</legend>
				<!-- The rows of the panel: every row is one line of the legacy box. The first row holds the
				     poreska kategorija (combo, 3/4 of the row) with the oznaka next to it (the last 1/4), the
				     second one the napomena over the whole row; below them the nastanak PDV obaveze and, in
				     the last row, the org. jedinica with the mesto troška. Every label of the panel has the
				     same width (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Row 1: the poreska kategorija (3/4) and the oznaka (1/4) -->
					<div class="col-span-3 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "porkat",
							LabelText:  translator.Label("Poreska kategorija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "porkat",
							Name:         "porkat",
							Placeholder:  translator.Placeholder("izaberite poresku kategoriju"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "37",
							OptionValues: header.CbxPorKategorija,
						}, translator)
					</div>
					<div class="flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "oznakakat",
							LabelText:  translator.Label("Oznaka"),
							ClassLabel: common.ClassLabel + " w-16",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "oznakakat",
							Name:       "oznakakat",
							FieldType:  "text",
							Value:      header.OznakaKat,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "38"})
					</div>
					<!-- Row 2: the napomena o poreskom oslobođenju over the whole row -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "napomporeskoosl",
							LabelText:  translator.Label("Napom. o poreskom osl."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "napomporeskoosl",
							Name:       "napomporeskoosl",
							FieldType:  "text",
							Value:      header.NapomenaPoresko,
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "120",
							TabIndex:   "39"})
					</div>
					<!-- Row 3: the nastanak PDV obaveze, as wide as the poreska kategorija above -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "nastanakpdv",
							LabelText:  translator.Label("Nastanak PDV obaveze"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "nastanakpdv",
							Name:         "nastanakpdv",
							Placeholder:  translator.Placeholder("izaberite nastanak PDV obaveze"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "40",
							OptionValues: header.CbxNastanakPDV}, translator)
					</div>
					<!-- Row 4: the org. jedinica (its change reloads the mesta troška) with the mesto troška -->
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "idorgjed",
							LabelText:  translator.Label("Org. Jedinica"),
							ClassLabel: common.ClassLabel + " w-40 whitespace-nowrap",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:             "idorgjed",
							Name:           "idorgjed",
							Placeholder:    translator.Placeholder("izaberite organizacionu jedinicu"),
							Disabled:       false,
							ClassSelect:    common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:       "41",
							OptionValues:   header.CbxOrgjed,
							ChangeEndpoint: "/api/mestotroska",
							HxChangeTarget: "mestotrid",
							HxSwap:         "outerHTML",
						}, translator)
					</div>
					<div class="col-span-2 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "mestotrid",
							LabelText:  translator.Label("Mesto troska"),
							ClassLabel: common.ClassLabel + " w-28 whitespace-nowrap",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "mestotrid",
							Name:         "mestotrid",
							Placeholder:  "izaberite mesto troska...",
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "42",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
							OptionValues: header.CbxMtroska,
						}, translator)
					</div>
				</div>
			</fieldset>
			<!-- Mesto isporuke, komercijalista, tender, napomena... (the second panel of the legacy box) -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Mesto isporuke, komercijalista, tender, napomena...") }</legend>
				<!-- The rows of the panel, one line of the legacy box per row: the mesto isporuke and the
				     komercijalista over the whole row, then the IF broj with the checkbox "Javna nabavka",
				     the BJKOS nosioca with the broj tendera and the KST and, in the last rows, the pairs of
				     the fields of the otprema (broj ugovora / narudžbenica, vozač / reg. br., bruto / neto
				     težina, broj kutija / broj paleta). Every label has the width of the labels of the panel
				     above (w-44), so the controls of all the rows start at the same x. -->
				<div class="grid grid-cols-4 gap-x-2 gap-y-1">
					<!-- Mesto isporuke -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "fispid",
							LabelText:  translator.Label("Mesto isporuke"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "fispid",
							Name:         "fispid",
							Placeholder:  translator.Placeholder("izaberite mesto isporuke"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "43",
							OptionValues: header.CbxMi,
						}, translator)
					</div>
					<!-- Komercijalista -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "komid",
							LabelText:  translator.Label("Komercijalista"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "komid",
							Name:         "komid",
							Placeholder:  translator.Placeholder("izaberite komercijalistu"),
							Disabled:     false,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1 min-w-0",
							TabIndex:     "44",
							OptionValues: header.CbxKomercijalista,
						}, translator)
					</div>
					<!-- Vozač, Reg. br. -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "vozac",
							LabelText:  translator.Label("Vozač"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "vozac",
							Name:       "vozac",
							FieldType:  "text",
							Value:      header.Vozac,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "40",
							TabIndex:   "45"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "regbr",
							LabelText:  translator.Label("Reg. br."),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "regbr",
							Name:       "regbr",
							FieldType:  "text",
							Value:      header.RegBr,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "46"})
					</div>
					<!-- Bruto težina, Neto težina -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brutotezina",
							LabelText:  translator.Label("Bruto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brutotezina",
							Name:       "brutotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.BrutoTezina, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "47"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "netotezina",
							LabelText:  translator.Label("Neto težina"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "netotezina",
							Name:       "netotezina",
							FieldType:  "text",
							Value:      robnoFaktureDecimal(header.NetoTezina, 2),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "15",
							TabIndex:   "48"})
					</div>
					<!-- Broj kutija, Broj paleta -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojkutija",
							LabelText:  translator.Label("Broj kutija"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojkutija",
							Name:       "brojkutija",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojKutija),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "49"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojpaleta",
							LabelText:  translator.Label("Broj paleta"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojpaleta",
							Name:       "brojpaleta",
							FieldType:  "text",
							Value:      robnoFaktureInt(header.BrojPaleta),
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0 text-right",
							MaxLength:  "6",
							TabIndex:   "50"})
					</div>
					<!-- checkbox "Javna nabavka",  -->
					<div class="col-span-4 flex items-center gap-1 min-w-0">
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "javnanabavka",
							Name:              "javnanabavka",
							LabelText:         translator.Label("Javna nabavka"),
							ClassLabel:        common.ClassLabel,
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-sm",
							IsChecked:         header.JavnaNabavka,
							Disabled:          header.Snimljen,
							TabIndex:          "51"}, translator)
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "jbkjsnosilac",
							LabelText:  translator.Label("JBKJS nosioca"),
							ClassLabel: common.ClassLabel + " w-32 pl-2",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "jbkjsnosilac",
							Name:       "jbkjsnosilac",
							FieldType:  "text",
							Value:      header.JBKJNosioc,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " w-28",
							MaxLength:  "20",
							TabIndex:   "52"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojtendera",
							LabelText:  translator.Label("Broj tendera"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojtendera",
							Name:       "brojtendera",
							FieldType:  "text",
							Value:      header.BrojTendera,
							Disabled:   header.Snimljen,
							ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
							MaxLength:  "20",
							TabIndex:   "53"})
					</div>
				</div>
			</fieldset>
			<!-- Finansijsko stanje kupca -->
			<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
				<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Finansijsko stanje kupca") }</legend>
				<div class="grid grid-cols-2 gap-x-4 gap-y-1">
					<div class="flex flex-col">
						@RobnoFaktureReadOnly("ukrealiz", translator.Label("Realizovana"), robnoFaktureDecimal(header.UkRealiz, 2), translator)
						@RobnoFaktureReadOnly("placeno", translator.Label("Plaćeno"), robnoFaktureDecimal(header.Placeno, 2), translator)
						@RobnoFaktureReadOnly("saldopartnera", translator.Label("Saldo"), robnoFaktureDecimal(header.Saldo, 2), translator)
						@RobnoFaktureReadOnly("dospelo", translator.Label("Dospelo"), robnoFaktureDecimal(header.Dospelo, 2), translator)
						@RobnoFaktureReadOnly("nedospelo", translator.Label("Nedospelo"), robnoFaktureDecimal(header.Nedospelo, 2), translator)
					</div>
					<div class="flex flex-col">
						@RobnoFaktureReadOnly("ukrealizrob", translator.Label("Realizovana roba"), robnoFaktureDecimal(header.UkRealizRob, 2), translator)
						@RobnoFaktureReadOnly("dospelorob", translator.Label("Dospelo roba"), robnoFaktureDecimal(header.DospeloRob, 2), translator)
						@RobnoFaktureReadOnly("nedospelorob", translator.Label("Nedospelo roba"), robnoFaktureDecimal(header.NedospeloRob, 2), translator)
						@RobnoFaktureReadOnly("ukdospelo", translator.Label("Ukupno dospelo"), robnoFaktureDecimal(header.UkDospelo, 2), translator)
						@RobnoFaktureReadOnly("uknedospelo", translator.Label("Ukupno nedospelo"), robnoFaktureDecimal(header.UkNedospelo, 2), translator)
						@RobnoFaktureReadOnly("uksaldo", translator.Label("Ukupno saldo"), robnoFaktureDecimal(header.UkSaldo, 2), translator)
					</div>
				</div>
			</fieldset>
			<!-- Avansi: the grid of the avansi the legacy window shows next to the finansijsko stanje -->
			if avansiTbl.TableID != "" {
				<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col h-40 min-h-0 overflow-hidden">
					@components.Search_Part(avansiTbl, domain.InputControl{})
					<div class="flex-1 min-h-0 overflow-auto">
						@components.Table(avansiTbl, translator)
					</div>
				</div>
			}
			<!-- ===== End of the right column and of the two column layout ===== -->
		</div>
	</div>
}

// RobnoFaktureReadOnly renders one read only label + value row (the strips of the header and the
// "Finansijsko stanje kupca" panel). The value is right aligned like the numeric cells of the grids.
templ RobnoFaktureReadOnly(id, label, value string, translator *i18n.Service) {
	<div class="flex items-center gap-1 mb-1">
		@components.LabelField(domain.LabelFieldConfig{ID: id, LabelText: label, ClassLabel: common.ClassLabel + " w-40"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         id,
			Value:      value,
			FieldType:  "text",
			Disabled:   true,
			ClassInput: common.ClassInputTextDisabled + " text-right"})
	</div>
}

// RobnoFaktureReadOnlyStrip renders a read only strip of two lines: the first line is the label of
// every field, the second one its value (the two row grid header of the legacy windows). The values are
// disabled inputs, so the script of the screen (RobnoFaktureScript) treats them like the other read
// only values of the form and never enables them.
templ RobnoFaktureReadOnlyStrip(fields []domain.RobnoFaktureStripField) {
	<table class="w-full table-fixed border-collapse">
		<thead>
			<tr>
				for _, f := range fields {
					<th class={ "border border-blue-400 bg-blue-200 px-1 py-0.5 text-xs font-normal text-blue-900 whitespace-nowrap " + f.WidthClass }>{ f.Label }</th>
				}
			</tr>
		</thead>
		<tbody>
			<tr>
				for _, f := range fields {
					<td class="border border-blue-400 bg-blue-100 px-0.5 py-0.5 align-middle">
						<input
							id={ f.ID }
							name={ f.ID }
							type="text"
							value={ f.Value }
							disabled
							class={ common.ClassInputTextDisabled + " " + f.AlignClass }
						/>
					</td>
				}
			</tr>
		</tbody>
	</table>
}

// RobnoFaktureStavkePanel renders the second collapsible control: the entry form of one stavka and the
// grid of the stavke of the dokument. The control is closed and disabled until the header is saved.
templ RobnoFaktureStavkePanel(ui domain.RobnoFaktureUI, tbl domain.TableData, header domain.RobnoFaktureHeaderView, stavka domain.RobnoFaktureStavka, btns domain.RobnoFaktureButtons, searchInput domain.InputControl, translator *i18n.Service) {
	@RobnoFakturePanel(ui.StavkePanelID, translator.Label("Stavke fakture"), robnoFaktureStavkeStateText(header.Snimljen, translator), header.Snimljen, header.Snimljen, RobnoFaktureStavkeFields(ui, tbl, stavka, searchInput, translator), RobnoFaktureStavkeButtons(btns))
}

// RobnoFaktureStavkeFields is the body of the stavke control: the kupac and the podaci o dokumentu of
// the header (read only), the entry form of the stavka and the grid of the stavke.
templ RobnoFaktureStavkeFields(ui domain.RobnoFaktureUI, tbl domain.TableData, stavka domain.RobnoFaktureStavka, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- KUPAC + Podaci o dokumentu: the two read only panels of the legacy window -->
	<div class="grid grid-cols-2 gap-1">
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Kupac") }</legend>
			<div class="grid grid-cols-2 gap-x-2 gap-y-1">
				@RobnoFaktureReadOnly("kupacmagacin", translator.Label("Konto magacina"), stavka.KontoMagacina, translator)
				@RobnoFaktureReadOnly("kupackontostavke", translator.Label("Konto kupca"), stavka.KontoKupca, translator)
			</div>
		</fieldset>
		<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
			<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Podaci o dokumentu") }</legend>
			<div class="grid grid-cols-3 gap-x-2 gap-y-1">
				@RobnoFaktureReadOnly("vrdstavke", translator.Label("Vrsta dokumenta"), stavka.Vrd, translator)
				@RobnoFaktureReadOnly("brdokstavke", translator.Label("Broj dokumenta"), stavka.Brdok, translator)
				@RobnoFaktureReadOnly("datumdokumenta", translator.Label("Datum dokumenta"), stavka.DatumDokumenta, translator)
			</div>
		</fieldset>
	</div>
	<!-- Stavka -->
	<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
		<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Stavka") }</legend>
		<div class="grid grid-cols-3 gap-x-3">
			<!-- First column of the legacy window: the article, its tarifa, the količina and the cene -->
			<div class="flex flex-col">
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "sifraartikla",
						LabelText:  translator.Label("Šifra artikla"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "sifraartikla",
						Name:       "sifraartikla",
						FieldType:  "text",
						Value:      stavka.SifraArtikla,
						ClassInput: common.ClassInputTextEnabled + " !w-24 text-right",
						MaxLength:  "10",
						TabIndex:   "1",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
					@components.SearchButton(domain.SearchButtonConfig{ID: "sifraartikla", Name: "search-sifraartikla", HxUrl: ui.ArtikalSearchURL, HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `js:{"destfield": "sifraartikla"}`, ClassButton: common.ClassButton})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "nazivartikla",
						Name:       "nazivartikla",
						FieldType:  "text",
						Value:      stavka.SifraArtiklaNaziv,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "tarifa",
						LabelText:  translator.Label("Šifra poreske tarife"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "tarifa",
						Name:       "tarifa",
						FieldType:  "text",
						Value:      stavka.Tarifa,
						ClassInput: common.ClassInputTextEnabled + " !w-20 text-right",
						MaxLength:  "6",
						TabIndex:   "2"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "kolicina",
						LabelText:  translator.Label("Količina"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "kolicina",
						Name:       "kolicina",
						FieldType:  "text",
						Value:      stavka.Kolicina,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "3",
						OnInput:    "clearFieldError",
						OnFocus:    "clearFieldError"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "prodajnacena",
						LabelText:  translator.Label("Prodajna cena"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "prodajnacena",
						Name:       "prodajnacena",
						FieldType:  "text",
						Value:      stavka.ProdajnaCena,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "4"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "rabatstavke",
						LabelText:  translator.Label("Rabat"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "rabatstavke",
						Name:       "rabatstavke",
						FieldType:  "text",
						Value:      stavka.Rabat,
						ClassInput: common.ClassInputTextEnabled + " !w-20 text-right",
						MaxLength:  "6",
						TabIndex:   "5"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "netoprodajnacena",
						LabelText:  translator.Label("Neto prodajna cena"),
						ClassLabel: common.ClassLabel + " w-36",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "netoprodajnacena",
						Name:       "netoprodajnacena",
						FieldType:  "text",
						Value:      stavka.NetoProdajnaCena,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
			</div>
			<!-- Second column of the legacy window: the stanje, the iznos and the nabavna cena -->
			<div class="flex flex-col">
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "jm",
						LabelText:  translator.Label("JM"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "jm",
						Name:       "jm",
						FieldType:  "text",
						Value:      stavka.JM,
						ClassInput: common.ClassInputTextEnabled + " !w-20",
						MaxLength:  "6",
						TabIndex:   "6"})
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "stanje",
						LabelText:  translator.Label("Stanje"),
						ClassLabel: common.ClassLabel + " pl-2",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "stanje",
						Name:       "stanje",
						FieldType:  "text",
						Value:      stavka.Stanje,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "dani",
						LabelText:  translator.Label("Dan(i)"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "dani",
						Name:       "dani",
						FieldType:  "text",
						Value:      stavka.Dani,
						ClassInput: common.ClassInputTextEnabled + " !w-16 text-right",
						MaxLength:  "3",
						TabIndex:   "7"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "iznosstavke",
						LabelText:  translator.Label("Iznos"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "iznosstavke",
						Name:       "iznosstavke",
						FieldType:  "text",
						Value:      stavka.Iznos,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "8"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "magacinskacena",
						LabelText:  translator.Label("Magacinska cena"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "magacinskacena",
						Name:       "magacinskacena",
						FieldType:  "text",
						Value:      stavka.MagacinskaCena,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "iznosrabata",
						LabelText:  translator.Label("Iznos rabata"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "iznosrabata",
						Name:       "iznosrabata",
						FieldType:  "text",
						Value:      stavka.IznosRabata,
						Disabled:   true,
						ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "nabavnacena",
						LabelText:  translator.Label("Nabavna cena"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "nabavnacena",
						Name:       "nabavnacena",
						FieldType:  "text",
						Value:      stavka.NabavnaCena,
						ClassInput: common.ClassInputTextEnabled + " !w-28 text-right",
						MaxLength:  "15",
						TabIndex:   "9"})
				</div>
			</div>
			<!-- Third column of the legacy window: the last price of the kupac and the dokument fields -->
			<div class="flex flex-col">
				<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg mb-1">
					<legend class="px-1 font-semibold text-xs text-blue-900">{ translator.Label("Zadnja cena po kojoj je kupac kupovao ovaj artikal") }</legend>
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjacena",
							LabelText:  translator.Label("Cena"),
							ClassLabel: common.ClassLabel + " w-14",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjacena",
							Name:       "zadnjacena",
							FieldType:  "text",
							Value:      stavka.ZadnjaCena,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-28 text-right"})
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjirabat",
							LabelText:  translator.Label("Rabat"),
							ClassLabel: common.ClassLabel + " w-14 pl-1",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjirabat",
							Name:       "zadnjirabat",
							FieldType:  "text",
							Value:      stavka.ZadnjiRabat,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-20 text-right"})
					</div>
					<div class="flex items-center gap-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "zadnjidatum",
							LabelText:  translator.Label("Datum"),
							ClassLabel: common.ClassLabel + " w-14",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "zadnjidatum",
							Name:       "zadnjidatum",
							FieldType:  "date",
							Value:      stavka.ZadnjiDatum,
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " !w-40"})
						@components.CheckboxField(domain.CheckboxFieldConfig{
							ID:                "koristiposlednjirabat",
							Name:              "koristiposlednjirabat",
							LabelText:         translator.Label("Koristi poslednji rabat za ovu fakturu"),
							ClassLabel:        "text-xs leading-4 max-w-[14rem]",
							ClassCheckbox:     common.ClassCheckbox,
							ClassCheckboxSpan: "text-xs",
							IsChecked:         stavka.KoristiPoslednjiRabat,
							TabIndex:          "10"}, translator)
					</div>
				</fieldset>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "deklaracije",
						LabelText:  translator.Label("Deklaracije"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "deklaracije",
						Name:       "deklaracije",
						FieldType:  "text",
						Value:      stavka.Deklaracije,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "60",
						TabIndex:   "11"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "barkod",
						LabelText:  translator.Label("Bar kod"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "barkod",
						Name:       "barkod",
						FieldType:  "text",
						Value:      stavka.BarKod,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "12"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "serija",
						LabelText:  translator.Label("Šerija"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "serija",
						Name:       "serija",
						FieldType:  "text",
						Value:      stavka.Serija,
						ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
						MaxLength:  "20",
						TabIndex:   "13"})
				</div>
				<div class="flex items-center gap-1 mb-1">
					@components.LabelField(domain.LabelFieldConfig{
						ID:         "rokstavke",
						LabelText:  translator.Label("Rok"),
						ClassLabel: common.ClassLabel + " w-28",
					})
					@components.TextInputField(domain.InputFieldConfig{
						ID:         "rokstavke",
						Name:       "rokstavke",
						FieldType:  "date",
						Value:      stavka.Rok,
						ClassInput: common.ClassInputTextEnabled + " !w-40",
						TabIndex:   "14"})
				</div>
			</div>
		</div>
	</fieldset>
	<!-- Grid of the stavke of the dokument -->
	<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col min-h-0 flex-1 overflow-hidden">
		@components.LoadingSpinner()
		@components.Search_Part(tbl, searchInput)
		<!-- Table: the grid scrolls while the page navigator stays at the bottom of the control -->
		<div class="flex-1 min-h-0">
			@components.Table(tbl, translator)
		</div>
	</div>
}

// RobnoFaktureStavkeButtons renders the buttons of the stavke control (the "Sačuvaj", "Izmeni" and
// "Briši" of the legacy window).
templ RobnoFaktureStavkeButtons(btns domain.RobnoFaktureButtons) {
	@components.Button(btns.SaveStavka)
	@components.Button(btns.ModifyStavka)
	@components.Button(btns.DeleteStavka)
}

// RobnoFaktureHeaderButtons renders the buttons of the header control. They are rendered outside of
// [data-panel-fields], so the script never disables them and the header can always be saved; "Izmeni"
// is the button that unlocks the header again (it keeps the stavke locked, only one control is
// editable at a time).
templ RobnoFaktureHeaderButtons(btns domain.RobnoFaktureButtons) {
	@components.Button(btns.Modify)
	@components.Button(btns.Save)
	@components.Button(btns.New)
	@components.Button(btns.Delete)
}

// RobnoFaktureScript is the small script that keeps only one of the two controls editable. The server
// renders the same state (domain.RobnoFaktureHeaderView.Snimljen and the Disabled flags of the fields), so the
// screen works both after a save and after a reload of the tab.
templ RobnoFaktureScript() {
	<script>
		// Opens or closes one of the two controls, the same thing as clicking its title bar.
		function robnoFaktureSetPanelOpen(panelId, open) {
			const panel = document.getElementById(panelId);
			if (panel) {
				panel.open = open;
			}
		}

		// Enables or disables the fields of one of the two controls. The controls that are disabled in
		// the rendered markup (the read only strips of the nalog, of the kupac and of the cene) are
		// remembered the first time and are never enabled again.
		function robnoFaktureSetPanelEnabled(panelId, enabled) {
			const panel = document.getElementById(panelId);
			if (!panel) {
				return;
			}
			panel.setAttribute('data-enabled', enabled ? 'true' : 'false');
			const fields = panel.querySelector('[data-panel-fields]');
			if (!fields) {
				return;
			}
			// inert keeps the fields of the disabled control out of the focus order and out of reach of
			// the mouse, exactly like the markup the server renders.
			fields.classList.toggle('pointer-events-none', !enabled);
			fields.classList.toggle('opacity-60', !enabled);
			fields.inert = !enabled;
			fields.querySelectorAll('input, select, textarea').forEach(function (element) {
				if (element.dataset.robnoFaktureReadOnly === undefined) {
					element.dataset.robnoFaktureReadOnly = element.disabled ? 'true' : 'false';
				}
				if (element.dataset.robnoFaktureReadOnly === 'true') {
					return;
				}
				element.disabled = !enabled;
			});
		}

		// Only one control is editable: stavkeEditable = true locks the header and unlocks the stavke,
		// stavkeEditable = false does the opposite.
		function robnoFaktureSetMode(stavkeEditable, headerPanelId, stavkePanelId) {
			robnoFaktureSetPanelOpen(headerPanelId, !stavkeEditable);
			robnoFaktureSetPanelEnabled(headerPanelId, !stavkeEditable);
			robnoFaktureSetPanelOpen(stavkePanelId, stavkeEditable);
			robnoFaktureSetPanelEnabled(stavkePanelId, stavkeEditable);
		}

		// The title bar of a disabled control does not open it: the stavke are not available until the
		// header is saved.
		function robnoFaktureCanToggle(summary) {
			const panel = summary.parentElement;
			return !panel || panel.getAttribute('data-enabled') !== 'false';
		}

		// hx-on::after-request of "Sačuvaj" and of "Novi dok.": the header is locked and the stavke are
		// enabled only when the request was successful; otherwise the header stays editable (the handler
		// shows its messages).
		function robnoFaktureAfterHeaderSave(headerPanelId, stavkePanelId) {
			if (!event.detail.successful) {
				return;
			}
			robnoFaktureSetMode(true, headerPanelId, stavkePanelId);
		}

		// onclick of "Izmeni": the header is unlocked and the stavke are locked again.
		function robnoFaktureModifyHeader(headerPanelId, stavkePanelId) {
			robnoFaktureSetMode(false, headerPanelId, stavkePanelId);
		}
	</script>
}

// robnoFaktureHeaderStateText is the text of the title bar of the header control.
func robnoFaktureHeaderStateText(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Podaci su sačuvani - koristite Izmeni za izmenu")
	}
	return translator.Label("Podaci o fakturi nisu sačuvani")
}

// robnoFaktureStavkeStateText is the text of the title bar of the stavke control: the stavke are
// available only after the header is saved.
func robnoFaktureStavkeStateText(snimljen bool, translator *i18n.Service) string {
	if snimljen {
		return translator.Label("Unos stavki je omogućen")
	}
	return translator.Label("Sačuvajte podatke o fakturi da bi ste mogli da radite sa stavkama")
}

// robnoFaktureState returns the value of the data-enabled attribute of a control.
func robnoFaktureState(enabled bool) string {
	if enabled {
		return "true"
	}
	return "false"
}

// robnoFaktureNalogStripFields defines the fields of the strip of the nalog (the two row header both
// legacy windows show above the form): the nalog, its totals and the magacin of the dokument. Every
// field is one column of the strip: the label is the first line, the value the second one. The widths
// are percentages of the strip, so the strip always fits the form; the magacin has no width, so it
// takes the rest of the strip.
func robnoFaktureNalogStripFields(header domain.RobnoFaktureHeaderView, translator *i18n.Service) []domain.RobnoFaktureStripField {
	return []domain.RobnoFaktureStripField{
		{ID: "vrnal", Label: translator.Label("Vr. nal."), Value: header.VrNal, WidthClass: "w-[5%]"},
		{ID: "nalog", Label: translator.Label("Nalog"), Value: header.Nalog, WidthClass: "w-[7%]"},
		{ID: "datumnaloga", Label: translator.Label("Datum naloga"), Value: header.DatumNaloga, WidthClass: "w-[12%]"},
		{ID: "ukdokum", Label: translator.Label("Uk. dokum."), Value: header.UkDokum, WidthClass: "w-[9%]"},
		{ID: "ukstavki", Label: translator.Label("Uk. stavki"), Value: header.UkStavki, WidthClass: "w-[9%]"},
		{ID: "duguje", Label: translator.Label("Duguje"), Value: header.Duguje, WidthClass: "w-[11%]", AlignClass: "text-right"},
		{ID: "potrazuje", Label: translator.Label("Potražuje"), Value: header.Potrazuje, WidthClass: "w-[13%]", AlignClass: "text-right"},
		{ID: "iznosdokum", Label: translator.Label("Iznos dokum."), Value: header.IznosDokum, WidthClass: "w-[13%]", AlignClass: "text-right"},
		// The magacin is the last field of the strip and takes the rest of its width.
		{ID: "magacin", Label: translator.Label("Magacin"), Value: header.Magacin},
	}
}

// robnoFaktureDate renders a date of the header of the faktura for the date input of the form (the ISO
// layout of an <input type="date">, empty when the date is not set).
func robnoFaktureDate(value time.Time) string {
	if value.IsZero() {
		return ""
	}
	return value.Format(common.HtmlLayout)
}

// robnoFaktureDecimal renders a decimal value of the header of the faktura the way the handler used to
// format it (empty when the value is not set).
func robnoFaktureDecimal(value float64, precision int) string {
	if value == 0 {
		return ""
	}
	return common.FormatNumberWithSystemLocale(value, precision)
}

// robnoFaktureInt renders a whole number of the header of the faktura (empty when it is not set).
func robnoFaktureInt(value int) string {
	if value == 0 {
		return ""
	}
	return strconv.Itoa(value)
}
