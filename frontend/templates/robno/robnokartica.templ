package robno

import (
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
)

templ RobnoKarticaMain(tabs domain.TabData, tblData domain.TableData, magacini []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div id="tab-content" class="flex flex-col h-full">
		@RobnoKarticaArtikla(tabs, tblData, magacini, btnObrada, btnPrint, searchInput, translator)
	</div>
	@tmpl.ShowSearchDialogScript()
	@tmpl.HideDropdownScript()
	@tmpl.ClearFieldErrorScript()
	@tmpl.HandleDblClickKontoSelectionScript()
	@tmpl.HandleDialogResponseScript()
	@tmpl.CloseDialogScript()
	@tmpl.OpenPrintWithParamsScript()
	@tmpl.EnableDisableFieldsScripts()
}

templ RobnoKarticaArtikla(tabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<!-- Container with full height -->
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("ROBNO KARTICA"), tabs, "#tab-content", "robno-kartica-panel", translator)
		</div>
		<div class="flex-1 min-h-0 flex flex-col gap-1 pt-1">
			<div class="grid grid-cols-[1fr_4fr_1fr] gap-2 items-start">
				<fieldset class="border border-blue-400 p-1 rounded-lg h-full">
					<legend class="px-1 mb-7 font-semibold text-sm text-blue-900">{ translator.Label("Selekcija") }</legend>
					@RobnoKarticaCheckBox("chkpobrojunaloga", "Po broju naloga ?", `["brojnaloga"]`, translator)
					@RobnoKarticaCheckBox("chkpodatumunaloga", "Po datumu naloga ?", `["oddatumanaloga","dodatumanaloga"]`, translator)
					@RobnoKarticaCheckBox("chkpodatumuobrade", "Po datumu obrade ?", `["oddatumaobrade","dodatumaobrade"]`, translator)
					@RobnoKarticaCheckBox("chkpovrstidokumenta", "Po vrsti dokumenta ?", `["sifvrstedokumenta"]`, translator)
					@RobnoKarticaCheckBox("chkpobrojudokumenta", "Po broju dokumenta ?", `["brojdokumenta"]`, translator)
					@RobnoKarticaCheckBox("chkpodatumdokumenta", "Po datumu dokumenta ?", `["oddatumadok","dodatumaadok"]`, translator)
					@RobnoKarticaCheckBox("chkpoiznosu", "Po iznosu ?", `["odiznosa","doiznosa"]`, translator)
				</fieldset>
				<fieldset class="border border-blue-400 p-1 rounded-lg">
					<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri za obradu") }</legend>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{ID: "magacin", LabelText: translator.Label("Magacin"), ClassLabel: common.ClassLabel + " w-40"})
						@components.ComboBoxField(domain.ComboFieldConfig{ID: "magacin", Name: "magacin", LabelText: translator.Label("Magacin"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: magValues, TabIndex: "1"}, translator)
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{ID: "brojnaloga", LabelText: translator.Label("Broj naloga"), ClassLabel: common.ClassLabel + " w-40"})
						@components.TextInputField(domain.InputFieldConfig{ID: "brojnaloga", Name: "brojnaloga", Disabled: true, ClassInput: common.ClassInputTextEnabled + " w-40", TabIndex: "2"})
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "oddatumanaloga", LabelText: translator.Label("Od datuma naloga"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "oddatumanaloga", Name: "oddatumanaloga", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "3"})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "dodatumanaloga", LabelText: translator.Label("Do datuma naloga"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "dodatumanaloga", Name: "dodatumanaloga", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "4"})
						</div>
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "oddatumaobrade", LabelText: translator.Label("Od datuma obrade"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "oddatumaobrade", Name: "oddatumaobrade", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "3"})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "dodatumaobrade", LabelText: translator.Label("Do datuma obrade"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "dodatumaobrade", Name: "dodatumaobrade", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "4"})
						</div>
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{ID: "sifvrstedokumenta", LabelText: translator.Label("Šifra vrste dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
						@components.TextInputField(domain.InputFieldConfig{ID: "sifvrstedokumenta", Name: "sifvrstedokumenta", Disabled: true, FieldType: "text", ClassInput: common.ClassInputTextEnabled + "  flex-1 w-full", TabIndex: "7"})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{ID: "brojdokumenta", LabelText: translator.Label("Broj dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
						@components.TextInputField(domain.InputFieldConfig{ID: "brojdokumenta", Name: "brojdokumenta", Disabled: true, FieldType: "text", ClassInput: common.ClassInputTextEnabled + "  flex-1 w-full", TabIndex: "7"})
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "oddatumadok", LabelText: translator.Label("Od datuma dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "oddatumadok", Name: "oddatumadok", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "3"})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "dodatumaadok", LabelText: translator.Label("Do datuma dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "dodatumaadok", Name: "dodatumaadok", Disabled: true, FieldType: "date", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "4"})
						</div>
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "odiznosa", LabelText: translator.Label("Od iznosa"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "odiznosa", Name: "odiznosa", Disabled: true, FieldType: "number", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "3"})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{ID: "doiznosa", LabelText: translator.Label("Do iznosa"), ClassLabel: common.ClassLabel + " w-40"})
							@components.TextInputField(domain.InputFieldConfig{ID: "doiznosa", Name: "doiznosa", Disabled: true, FieldType: "number", ClassInput: common.ClassInputTextEnabled + "  w-40", TabIndex: "4"})
						</div>
					</div>
					<div class="grid grid-cols-2 gap-1">
						@RobnoKarticaArtikalRange(translator.Label("Od šifre artikla"), "odsifre", "")
						@RobnoKarticaArtikalRange(translator.Label("Do šifre artikla"), "dosifre", "")
					</div>
				</fieldset>
				<fieldset class="border border-blue-400 p-1 rounded-lg h-full">
					<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Dodatni parametri") }</legend>
					@RobnoKarticaCheckBox("chkpRPROID", "po RPROID", `[]`, translator)
					@RobnoKarticaCheckBox("stampajpomesecima", "Štampaj po mesecima", `[]`, translator)
					<div class="border-t border-blue-400 mt-2 pt-2">
						@components.RadioButtonField(domain.RadioFieldConfig{ID: "sortiranje-nalog", Name: "sortiranje", LabelText: "Sortiranje po datumu naloga", ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "nalog", IsSelected: true}, translator)
						@components.RadioButtonField(domain.RadioFieldConfig{ID: "sortiranje-dokument", Name: "sortiranje", LabelText: "Sortiranje po datumu dokumenta", ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "dokument"}, translator)
					</div>
				</fieldset>
			</div>
			<div class="flex justify-end gap-1">
				@components.Button(btnObrada)
				@components.Search_PartPrintButton(btnPrint)
			</div>
			<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex-1 min-h-0 overflow-hidden">
				@components.Table(tbl, translator)
			</div>
		</div>
	</div>
}

templ RobnoKarticaSubsintetickoKonto(tabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robno kartica"), tabs, "#tab-content", "robno-kartica-panel", translator)
		</div>
		<div class="flex-1 min-h-0 flex flex-col gap-1 pt-1">
			<div class="grid grid-cols-[2fr_4fr] gap-2 items-start">
				<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg h-full">
					<legend class="px-1 mb-14 font-semibold text-sm text-blue-900">{ translator.Label("Selekcija") }</legend>
					@RobnoKarticaCheckBox("chkpobrojunaloga", "Po broju naloga ?", `["brojnaloga"]`, translator)
					@RobnoKarticaCheckBox("chkpodatumunaloga", "Po datumu naloga ?", `["oddatumanaloga","dodatumanaloga"]`, translator)
					@RobnoKarticaCheckBox("chkpoiznosu", "Po iznosu ?", `["odiznosa","doiznosa"]`, translator)
				</fieldset>
				<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg">
					<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri za obradu") }</legend>
					<div class="flex items-center gap-1 pb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "magacin",
							LabelText:  translator.Label("Magacin"),
							ClassLabel: common.ClassLabel + " w-40"})
						@components.ComboBoxField(domain.ComboFieldConfig{
							ID:           "magacin",
							Name:         "magacin",
							LabelText:    translator.Label("Magacin"),
							ClassLabel:   common.ClassLabel,
							ClassSelect:  common.ClassInputTextEnabled + " flex-1",
							OptionValues: magValues,
							TabIndex:     "1"}, translator)
					</div>
					<div class="flex items-center gap-1 pb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "konto",
							LabelText:  translator.Label("Subsintetički konto"),
							ClassLabel: common.ClassLabel + " w-40"})
						@components.TextInputField(domain.InputFieldConfig{
							ID:           "konto",
							Name:         "konto",
							FieldType:    "text",
							Disabled:     false,
							ClassInput:   common.ClassInputTextEnabled + " w-24",
							BlurEndpoint: "api/fkpl/trazikonto",
							HxTarget:     "kontonaziv",
							HxVals:       `js:{"konto": document.getElementById('konto').value, "vkonta": "2", "destfield": "konto"}`,
							HxInclude:    "this",
							MinLength:    "2",
							MaxLength:    "6",
							TabIndex:     "1",
							OnInput:      "clearFieldError",
							OnFocus:      "clearFieldError",
						})
						@components.SearchButton(domain.SearchButtonConfig{
							ID:          "btn-search-konto",
							Name:        "search-konto",
							HxUrl:       "/api/promet/searchbutton",
							HxTarget:    "#search-dropdown",
							HxSwap:      "innerHTML",
							HxVals:      `{"vkonta": "2", "destfield": "konto"}`,
							ClassButton: common.ClassButton,
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "kontonaziv",
							Name:       "kontonaziv",
							FieldType:  "text",
							Disabled:   true,
							ClassInput: common.ClassInputTextDisabled + " w-full",
						})
					</div>
					<div class="flex items-center gap-1 mb-1">
						@components.LabelField(domain.LabelFieldConfig{
							ID:         "brojnaloga",
							LabelText:  translator.Label("Broj naloga"),
							ClassLabel: common.ClassLabel + " w-40",
						})
						@components.TextInputField(domain.InputFieldConfig{
							ID:         "brojnaloga",
							Name:       "brojnaloga",
							Disabled:   true,
							ClassInput: common.ClassInputTextEnabled + " w-40",
							TabIndex:   "2",
						})
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "oddatumanaloga",
								LabelText:  translator.Label("Od datuma naloga"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "oddatumanaloga",
								Name:       "oddatumanaloga",
								Disabled:   true,
								FieldType:  "date",
								ClassInput: common.ClassInputTextEnabled + "  w-40",
								TabIndex:   "3",
							})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "dodatumanaloga",
								LabelText:  translator.Label("Do datuma naloga"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "dodatumanaloga",
								Name:       "dodatumanaloga",
								Disabled:   true,
								FieldType:  "date",
								ClassInput: common.ClassInputTextEnabled + "  w-40",
								TabIndex:   "4",
							})
						</div>
					</div>
					<div class="grid grid-cols-2 gap-1 mb-1">
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "odiznosa",
								LabelText:  translator.Label("Od iznosa"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "odiznosa",
								Name:       "odiznosa",
								Disabled:   true,
								FieldType:  "number",
								ClassInput: common.ClassInputTextEnabled + "  w-40",
								TabIndex:   "3",
							})
						</div>
						<div class="flex items-center gap-1 min-w-0">
							@components.LabelField(domain.LabelFieldConfig{
								ID:         "doiznosa",
								LabelText:  translator.Label("Do iznosa"),
								ClassLabel: common.ClassLabel + " w-40",
							})
							@components.TextInputField(domain.InputFieldConfig{
								ID:         "doiznosa",
								Name:       "doiznosa",
								Disabled:   true,
								FieldType:  "number",
								ClassInput: common.ClassInputTextEnabled + "  w-40",
								TabIndex:   "4",
							})
						</div>
					</div>
				</fieldset>
			</div>
			<div class="flex justify-end gap-1">
				@components.Button(btnObrada)
				@components.Search_PartPrintButton(btnPrint)
			</div>
			<!-- Group Data Table -->
			<div class="border bg-blue-100 border border-blue-400 p-1 rounded-lg flex flex-col min-h-0 overflow-hidden flex-1 relative">
				@components.LoadingSpinner()
				@components.Search_Part(tbl, searchInput)
				<!-- Table -->
				<div id={ tbl.TableID } class="flex-1 overflow-x-auto overflow-y-auto min-h-0">
					@components.Table(tbl, translator)
				</div>
			</div>
		</div>
	</div>
}

templ RobnoKarticaCheckBox(id, labelText, fields string, translator *i18n.Service) {
	<label class={ common.ClassCheckboxLabel + " w-44 flex-shrink-0 h-8 sm:h-7 md:h-6 mb-1" }>
		<input
			type="checkbox"
			id={ id }
			name={ id }
			class={ common.ClassCheckbox }
			onchange={ templ.JSFuncCall("controlToggle", templ.JSExpression("this"), templ.JSExpression(fields)) }
		/>
		<span class={ common.ClassCheckboxSpan }>{ translator.Label(labelText) }</span>
	</label>
}

templ RobnoKarticaArtikalRange(label, name, shortcut string) {
	<div class="flex items-center gap-1">
		@components.LabelField(domain.LabelFieldConfig{ID: name, LabelText: label, ClassLabel: common.ClassLabel + " w-40"})
		@components.TextInputField(domain.InputFieldConfig{ID: name, Name: name, FieldType: "number", ClassInput: common.ClassInputTextEnabled + " w-24"})
		@components.SearchButton(domain.SearchButtonConfig{ID: name, Name: "search-" + name, HxUrl: "/api/kartica/searchbutton", HxTarget: "#search-dropdown", HxSwap: "innerHTML", HxVals: `{"destfield": "` + name + `"}`, ClassButton: common.ClassButton})
		@components.TextInputField(domain.InputFieldConfig{ID: name + "naziv", Name: name + "naziv", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1", Placeholder: shortcut})
	</div>
}
