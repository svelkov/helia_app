// RobnoPrometRucUlazIzlaz renders the "Ulaz/izlaz za period" RUC sub-report.
templ RobnoPrometRucUlazIzlaz(tabs, subTabs domain.TabData, tbl domain.TableData, magValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robno promet"), tabs, "#robno-promet-reports-content", "robno-promet-reports-panel", translator)
		</div>
		<div class="border-b border-blue-600 pt-1">
			@tmpl.TabNav("", subTabs, "#robno-promet-reports-content", "robno-promet-reports-panel", translator)
		</div>
		<div class="flex-1 min-h-0 flex flex-col gap-1 pt-1">
			<div class="no-border bg-blue-100 p-1 rounded-lg">
				<div class="grid grid-cols-2 gap-2 items-start">
					<!-- Left: vrsta prometa + magacini -->
					<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1 h-full">
						<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "ulazizlaz-ulaz", Name: "ulazizlaz", LabelText: translator.Label("Ulaz robe"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "ulaz", IsSelected: true, TabIndex: "1"}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "ulazizlaz-izlaz", Name: "ulazizlaz", LabelText: translator.Label("Izlaz robe"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "izlaz", TabIndex: "2"}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "ulazizlaz-sve", Name: "ulazizlaz", LabelText: translator.Label("Ulaz i izlaz robe"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "ulazizlaz", TabIndex: "3"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "odmagacina", LabelText: translator.Label("Od magacina"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "odmagacina", Name: "odmagacina", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: magValues, TabIndex: "4"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "domagacina", LabelText: translator.Label("Do magacina"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "domagacina", Name: "domagacina", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: magValues, TabIndex: "5"}, translator)
						</div>
					</fieldset>
					<!-- Right: datumi + opcije -->
					<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1 h-full">
						<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Opcije prikaza/štampe") }</legend>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "oddatuma", LabelText: translator.Label("Od datuma"), ClassLabel: common.ClassLabel + " w-28"})
							@components.TextInputField(domain.InputFieldConfig{ID: "oddatuma", Name: "oddatuma", FieldType: "date", ClassInput: common.ClassInputTextEnabled + " flex-1", TabIndex: "6"})
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "dodatuma", LabelText: translator.Label("Do datuma"), ClassLabel: common.ClassLabel + " w-28"})
							@components.TextInputField(domain.InputFieldConfig{ID: "dodatuma", Name: "dodatuma", FieldType: "date", ClassInput: common.ClassInputTextEnabled + " flex-1", TabIndex: "7"})
						</div>
						@components.CheckboxField(domain.CheckboxFieldConfig{ID: "zbirmagacina", Name: "zbirmagacina", LabelText: translator.Label("Zbir izabranih magacina"), ClassCheckbox: common.ClassCheckbox + " mr-2", ClassLabel: common.ClassLabel + " flex items-center", TabIndex: "8"}, translator)
					</fieldset>
				</div>
				<div class="flex justify-end gap-1 pt-2">
					@components.Button(btnObrada)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
			<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex-1 min-h-0 overflow-hidden">
				@components.Search_Part(tbl, searchInput)
				@components.Table(tbl, translator)
