templ RobnoPrometRucLagerLista(tabs, subTabs domain.TabData, tbl domain.TableData, magValues, grupeValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
			@tmpl.TabNav(translator.Title("Robno promet"), tabs, "#robno-promet-reports-content", "robno-promet-reports-panel", translator)
		</div>
		<div class="border-b border-blue-600 pt-1">
			@tmpl.TabNav("", subTabs, "#robno-promet-reports-content", "robno-promet-reports-panel", translator)
		</div>
		<div class="flex-1 min-h-0 flex flex-col gap-1 pt-1">
			<div class="no-border bg-blue-100 p-1 rounded-lg">
				<!-- Vrsta lager liste -->
				<div class="grid grid-cols-2 gap-2 items-start">
					<!-- Left: magacini + stanje -->
					<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1 h-full">
						<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Parametri") }</legend>
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-1">
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "tipcene-netofakturna", Name: "tipcene", LabelText: translator.Label("Lager po neto fakturnim cenama"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "netofakturna", IsSelected: true, TabIndex: "1"}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "tipcene-prosecnanabavna", Name: "tipcene", LabelText: translator.Label("Lager po prosek. nabavnim cenama"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "prosecnanabavna", TabIndex: "2"}, translator)
							@components.RadioButtonField(domain.RadioFieldConfig{ID: "tipcene-prodajna", Name: "tipcene", LabelText: translator.Label("Lager po prodajnim cenama"), ClassLabel: common.ClassLabel, ClassSelect: common.ClassRadioSet, Value: "prodajna", TabIndex: "3"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "odmagacina", LabelText: translator.Label("Od magacina"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "odmagacina", Name: "odmagacina", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: magValues, TabIndex: "4"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "domagacina", LabelText: translator.Label("Do magacina"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "domagacina", Name: "domagacina", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: magValues, TabIndex: "5"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "stanjenadan", LabelText: translator.Label("Stanje na dan"), ClassLabel: common.ClassLabel + " w-28"})
							@components.TextInputField(domain.InputFieldConfig{ID: "stanjenadan", Name: "stanjenadan", FieldType: "date", ClassInput: common.ClassInputTextEnabled + " flex-1", TabIndex: "6"})
						</div>
					</fieldset>
					<!-- Right: opcije + grupe/podgrupe -->
					<fieldset class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1">
						<legend class="px-1 font-semibold text-sm text-blue-900">{ translator.Label("Opcije prikaza/štampe") }</legend>
						<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
							@components.CheckboxField(domain.CheckboxFieldConfig{ID: "stampajgrupapodgrupa", Name: "stampajgrupapodgrupa", LabelText: translator.Label("Štampaj zalihe po grupama i podgrupama"), ClassCheckbox: common.ClassCheckbox + " mr-2", ClassLabel: common.ClassLabel + " flex items-center", TabIndex: "7"}, translator)
							@components.CheckboxField(domain.CheckboxFieldConfig{ID: "zaliheodnule", Name: "zaliheodnule", LabelText: translator.Label("Zalihe <> 0"), ClassCheckbox: common.ClassCheckbox + " mr-2", ClassLabel: common.ClassLabel + " flex items-center", TabIndex: "8"}, translator)
							@components.CheckboxField(domain.CheckboxFieldConfig{ID: "azbucnired", Name: "azbucnired", LabelText: translator.Label("Štampaj zalihe po azbučnom redosledu"), ClassCheckbox: common.ClassCheckbox + " mr-2", ClassLabel: common.ClassLabel + " flex items-center", TabIndex: "9"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "odgrupe", LabelText: translator.Label("Od grupe"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "odgrupe", Name: "odgrupe", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: grupeValues, TabIndex: "10"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "dogrupe", LabelText: translator.Label("Do grupe"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "dogrupe", Name: "dogrupe", ClassSelect: common.ClassInputTextEnabled + " flex-1", OptionValues: grupeValues, TabIndex: "11"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "odpodgrupe", LabelText: translator.Label("Od podgrupe"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "odpodgrupe", Name: "odpodgrupe", ClassSelect: common.ClassInputTextEnabled + " flex-1", TabIndex: "12"}, translator)
						</div>
						<div class="flex items-center gap-1">
							@components.LabelField(domain.LabelFieldConfig{ID: "dopodgrupe", LabelText: translator.Label("Do podgrupe"), ClassLabel: common.ClassLabel + " w-28"})
							@components.ComboBoxField(domain.ComboFieldConfig{ID: "dopodgrupe", Name: "dopodgrupe", ClassSelect: common.ClassInputTextEnabled + " flex-1", TabIndex: "13"}, translator)
						</div>
					</fieldset>
				</div>
				<div class="flex justify-end gap-1 pt-2">
					@components.Button(btnObrada)
					@components.Search_PartPrintButton(btnPrint)
				</div>
			</div>
			<div class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex-1 min-h-0 overflow-hidden">
				@components.Search_Part(tbl, searchInput)
				@components.Table(tbl, translator)
			</div>
		</div>
	</div>
}

templ RobnoPrometGradiliste(tabs domain.TabData, tbl domain.TableData, magValues, grupeValues []domain.ComboItem, btnObrada, btnPrint domain.Button, searchInput domain.InputControl, translator *i18n.Service) {
	<div class="bg-blue-100 p-1 flex flex-col h-full">
		<div class="border-b border-blue-600">
