package robno

import (
	"database/sql"
	"helia/frontend/components"
	tmpl "helia/frontend/templates"
	"helia/i18n"
	"helia/internal/common"
	"helia/internal/domain"
	"strconv"
)

//
// Opšti dokumenti (the legacy rob_opsti_dokumenti_opd, the vrste dokumenata of the groups OPD, POP and POT; FIN and
// KOL, the legacy rob_opsti_dokumenti_FIN and rob_opsti_dokumenti_KOL, with a simpler header and stavke): the
// header and the stavke on one screen, in two parts: the header is saved first (its part enabled, the stavke
// disabled), then the stavke are entered (the header disabled); "Izmeni" switches back to the header. Only one
// part is processed at a time.
//

// Rob_OpstiDokumenti renders the "Opšti dokumenti" screen as a dialog with two tabs (RobnoDokumentDialog): the
// entry of the document and "Pregled", the documents of the vrsta with the stavke of the selected one and
// "Štampaj" of the selected document (RobnoFakturePrikaz, filled when the tab is shown).
templ Rob_OpstiDokumenti(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl, dokumentaTbl, dokumentStavkeTbl domain.TableData, btns domain.RobnoFaktureButtons, btnClose domain.Button, translator *i18n.Service, csrfToken string) {
	@RobnoDokumentDialog(ui.DialogID, translator.Label(robOpstiNaslov(header, 0)), translator.Label(robOpstiNaslov(header, 1)), translator.Label(robOpstiNaslov(header, 2)), btnClose, csrfToken,
		RobOpstiBody(ui, header, stavka, tbl, btns, translator),
		RobnoFakturePrikaz(ui, dokumentaTbl, dokumentStavkeTbl, domain.InputControl{}, translator))
	<!-- The messages of the screen -->
	<div id={ ui.InfoID }></div>
	@RobnoFaktureScript()
	if header.SamoPregled {
		<!-- The kontra dokument of the prenosnica (the legacy vrsta 113): it is made by the prenosnica izlaz, so
		     the tab of the entry is disabled and "Pregled" is shown (the legacy TAB_tAB1[1]..State = Grayed) -->
		<script data-dialog={ ui.DialogID }>
			(function (dialogID) {
				const dialog = document.getElementById(dialogID);
				if (!dialog) return;
				const unos = dialog.querySelector('[data-robno-tab="0"]');
				if (unos) {
					unos.disabled = true;
					unos.classList.add('opacity-50', 'cursor-not-allowed');
				}
				robnoDokumentTab(dialogID, 1);
			})(document.currentScript.dataset.dialog);
		</script>
	}
	<!-- restrictNumericInput / cleanNumberInput of the numbers of the stavke (FieldType "number") -->
	@tmpl.RestrictNumericInputScript()
	@robOpstiScript.Once() {
		@robOpstiScriptBody()
	}
}

var robOpstiScript = templ.NewOnceHandle()

// robOpstiNaslov is the title of the dialog (i 0), of the first tab (1) and of the tab "Pregled" (2): of a
// nivelacija veleprodaje the ones of the legacy rob_Nivelacije_Veleprodaja.
func robOpstiNaslov(header domain.RobnoOpstiHeaderView, i int) string {
	naslovi := []string{"Opšti dokumenti", "Opšti dokument", "Pregled"}
	if header.Niv {
		naslovi = []string{"Nivelacija prodaja", "Nivelacije veleprodaja", "Pregled nivelacija"}
	}
	// The prenosnice (rob_Prenosnice): the izlaz and its kontra dokument, the ulaz.
	if header.Pre || header.SamoPregled {
		naslovi = []string{"Prenosnice", "Prenosnice", "Pregled prenosnica"}
	}
	// The zaduženja gradilišta (rob_ZadauzGRADILISTA).
	if header.Grd {
		naslovi = []string{"Zaduženja gradilišta", "Zaduženja gradilišta", "Pregled zaduženja"}
	}
	// The trebovanja (rob_Trebovanja).
	if header.Otr {
		naslovi = []string{"Trebovanja", "Trebovanja", "Pregled trebovanja"}
	}
	// The popis u toku godine (rob_opsti_dokPOPIS).
	if header.Ptg {
		naslovi = []string{"Popis u toku godine", "Popis u toku godine", "Pregled popisa"}
	}
	return naslovi[i]
}

// RobOpstiBody renders the content of the first tab: the strip of the nalog, the header ("Podaci o dokumentu")
// and the stavke ("Stavke dokumenta"); the part that is not processed is disabled (the header until it is
// saved, then the stavke). The ids of the parts and of their buttons are here for the script (robOpstiSetMode).
templ RobOpstiBody(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div
		id={ ui.BodyID }
		data-opsti-body
		data-stavke-aktivne={ robnoFaktureState(header.Snimljen) }
		data-dokument-url={ ui.DokumentURL }
		data-novi-url={ ui.NoviURL }
		data-konto-magacina-url={ ui.KontoMagacinaURL }
		data-rnalid={ strconv.FormatInt(header.RnalID, 10) }
		data-vrd={ header.Vrd }
		data-header-panel={ ui.HeaderPanelID }
		data-stavke-panel={ ui.StavkePanelID }
		data-header-save={ btns.Save.Id }
		data-novi={ btns.New.Id }
		data-izmeni={ btns.Modify.Id }
		data-stavka-save={ btns.SaveStavka.Id }
		class="bg-blue-100 p-1 flex flex-col gap-1 h-full min-h-0"
	>
		<fieldset class="border border-blue-400 bg-blue-100">
			@RobnoFaktureReadOnlyStrip(robnoFaktureNalogStripFields(header.RobnoFaktureHeaderView, translator))
		</fieldset>
		@robOpstiDeo(ui.HeaderPanelID, translator.Label("Podaci o dokumentu"), !header.Snimljen, false, btns.Save.Id, RobOpstiHeaderFields(header, translator), RobOpstiHeaderButtons(header, btns, translator))
		@robOpstiDeo(ui.StavkePanelID, translator.Label(robOpstiStavkeNaslov(header)), header.Snimljen, true, btns.SaveStavka.Id, RobOpstiStavkeFields(ui, header, stavka, tbl, btns, translator), templ.NopComponent)
		<!-- The dialogs of the stavke (an error of the save, the confirmation of the deletion) -->
		<div id={ ui.StavkaInfoID } class="contents"></div>
	</div>
}

// robOpstiDeo renders one part of the screen (the header or the stavke) with its title, its fields (disabled
// and inert while the part is not processed, like the collapsible controls of the faktura: the script
// robnoFaktureSetPanelEnabled switches them) and its buttons; fill: the part fills the rest of the screen
// (the stavke, whose grid then reaches the bottom of the dialog).
templ robOpstiDeo(id, naslov string, enabled, fill bool, saveID string, fields, buttons templ.Component) {
	<fieldset
		id={ id }
		data-enabled={ robnoFaktureState(enabled) }
		if fill {
			class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1 flex-1 min-h-0"
		} else {
			class="border border-blue-400 bg-blue-100 p-1 rounded-lg flex flex-col gap-1"
		}
	>
		<legend class="px-1 font-semibold text-sm text-blue-900">{ naslov }</legend>
		<div
			data-panel-fields
			data-enter-nav={ saveID }
			inert?={ !enabled }
			if enabled {
				class={ "flex flex-col gap-1" + robnoFakturePanelFill(fill, " flex-1 min-h-0") }
			} else {
				class={ "flex flex-col gap-1 opacity-60 pointer-events-none" + robnoFakturePanelFill(fill, " flex-1 min-h-0") }
			}
		>
			@fields
		</div>
		<div class="flex items-center justify-end gap-1">
			@buttons
		</div>
	</fieldset>
}

// RobOpstiHeaderFields renders the fields of the header of the opšti dokument in two columns: the document
// (vrsta, broj, datumi, izvorni dokument, opis, protivstav konto and šifra) and the org. jedinice and mesta
// troška of the document and of the roba.
templ RobOpstiHeaderFields(header domain.RobnoOpstiHeaderView, translator *i18n.Service) {
	<input type="hidden" name="rnalid" value={ strconv.FormatInt(header.RnalID, 10) }/>
	<input type="hidden" name="rdokid" value={ strconv.FormatInt(header.RdokID, 10) }/>
	<input type="hidden" name="vrd" value={ header.Vrd }/>
	<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-x-3">
		<div class="flex flex-col gap-1 min-w-0">
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "vrdopd", LabelText: translator.Label("Vrsta dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
				@components.TextInputField(domain.InputFieldConfig{ID: "vrdopd", FieldType: "text", Value: header.Vrd, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-16 text-right"})
				@components.TextInputField(domain.InputFieldConfig{ID: "vrdopisopd", FieldType: "text", Value: header.OpisVrste, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
			</div>
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "brdok", LabelText: translator.Label("Broj dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
				<!-- The broj of the document for the save; the combo holds the id of the selected one. -->
				<input type="hidden" id="brdok" name="brdok" value={ header.BrojDokum }/>
				@components.TableCombo(domain.TableComboConfig{
					ID:           "brdok-combo",
					Name:         "brdokrdokid",
					ValueID:      "brdokrdokid",
					Value:        robnoFaktureID(header.RdokID),
					DisplayValue: header.BrojDokum,
					Placeholder:  "Pretraži po broju",
					ClassInput:   common.ClassInputTextEnabled + " w-full",
					// Not shrunk: the datumi of the rows start at the same x.
					ClassWrapper: "!w-32 shrink-0",
					SearchURL:    "/api/search/robni-dokumenti",
					// The documents of the vrsta in the nalog: a selected row opens its document by the id, a typed
					// broj its document or a new one with that broj (like the faktura).
					HxVals:      robnoFaktureDokumentSearchVals(header.RobnoFaktureHeaderView),
					OnSelect:    "robnoFaktureOtvoriDokument",
					FreeText:    true,
					OnFreeText:  "robnoFaktureNoviBroj",
					HideDetails: true,
					TabIndex:    "1",
				}, translator)
				@components.LabelField(domain.LabelFieldConfig{ID: "datumfakturisanja", LabelText: translator.Label("Datum dokumenta"), ClassLabel: common.ClassLabel + " w-44 shrink-0 ml-auto pl-2 whitespace-nowrap"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "datumfakturisanja",
					Name:       "datumfakturisanja",
					FieldType:  "date",
					Value:      robnoFaktureDate(header.DatumDokum),
					ClassInput: common.ClassInputTextEnabled + " !w-36",
					OnFocus:    "clearFieldError",
					TabIndex:   "2"})
			</div>
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "brdokorg", LabelText: translator.Label("Broj orig. dokumenta"), ClassLabel: common.ClassLabel + " w-40"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "brdokorg",
					Name:       "brdokorg",
					FieldType:  "text",
					Value:      header.IzvorniDokum,
					ClassInput: common.ClassInputTextEnabled + " !w-32 shrink-0",
					MaxLength:  "20",
					TabIndex:   "3"})
				@components.LabelField(domain.LabelFieldConfig{ID: "datumizvora", LabelText: translator.Label("Datum izvor. dokumenta"), ClassLabel: common.ClassLabel + " w-44 shrink-0 ml-auto pl-2 whitespace-nowrap"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "datumizvora",
					Name:       "datumizvora",
					FieldType:  "date",
					Value:      robnoFaktureDate(header.IzvorniDokDatum),
					ClassInput: common.ClassInputTextEnabled + " !w-36",
					TabIndex:   "4"})
			</div>
			<div class="flex items-center gap-1 min-w-0">
				@components.LabelField(domain.LabelFieldConfig{ID: "opis", LabelText: translator.Label("Opis"), ClassLabel: common.ClassLabel + " w-40"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "opis",
					Name:       "opis",
					FieldType:  "text",
					Value:      header.Opis,
					ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
					MaxLength:  "120",
					TabIndex:   "5"})
			</div>
			<!-- A prenosnica: the org. jedinica and the mesto troška of the document under the opis -->
			if header.Pre {
				@robOpstiOrgjed("idorgjed", "mestotrid", translator.Label("OJ"), translator.Label("Mesto troška"), header.Orgejed, header.OrgjedText, header.MestoTroska, header.MestoTroskaText, "6", common.ClassLabel+" w-40", translator)
			}
			<!-- The protivstav konto (fkpl.vkonta 2) with its naziv, and its analitička šifra (not of a FIN or a KOL) -->
			if !header.BezProtivstava() {
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "tkonto", LabelText: translator.Label("Protivstav konto"), ClassLabel: common.ClassLabel + " w-40"})
					@components.TableCombo(domain.TableComboConfig{
						ID:           "tkonto-combo",
						Name:         "tkonto",
						ValueID:      "tkonto",
						Value:        header.Tkonto,
						DisplayValue: header.Tkonto,
						Placeholder:  "Pretraži po kontu ili nazivu",
						ClassInput:   common.ClassInputTextEnabled + " w-full",
						ClassWrapper: "!w-32",
						SearchURL:    "/api/search/konta",
						AllowEmpty:   true,
						HideDetails:  true,
						OnSelect:     "robOpstiTkontoIzabran",
						TabIndex:     "6",
					}, translator)
					@components.TextInputField(domain.InputFieldConfig{ID: "tkontonaziv", FieldType: "text", Value: header.TkontoNaziv, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
				</div>
				<div class="flex items-center gap-1 min-w-0">
					@components.LabelField(domain.LabelFieldConfig{ID: "tsifra", LabelText: translator.Label("Protivstav an. šifra"), ClassLabel: common.ClassLabel + " w-40"})
					@components.TableCombo(domain.TableComboConfig{
						ID:           "tsifra-combo",
						Name:         "tsifra",
						ValueID:      "tsifra",
						Value:        header.Tsifra,
						DisplayValue: header.Tsifra,
						Placeholder:  "Pretraži po šifri ili nazivu",
						ClassInput:   common.ClassInputTextEnabled + " w-full",
						ClassWrapper: "!w-32",
						// The šifre of the protivstav konto (the parameter tkonto of the search).
						SearchURL:   "/api/search/analitika",
						HxInclude:   "#tkonto",
						AllowEmpty:  true,
						HideDetails: true,
						OnSelect:    "robOpstiTsifraIzabrana",
						TabIndex:    "7",
					}, translator)
				</div>
			}
		</div>
		<!-- The org. jedinica and the mesto troška of the document and of the roba (where the roba goes; not of a
		     FIN or a KOL); a nivelacija (MNV) has none -->
		<div class={ "flex flex-col gap-1 min-w-0 " + robUslugeVidljivo(!header.Mnv) }>
			if header.Pre {
				@robOpstiPrenos(header, translator)
			} else {
				@robOpstiOrgjed("idorgjed", "mestotrid", translator.Label("OJ"), translator.Label("Mesto troška"), header.Orgejed, header.OrgjedText, header.MestoTroska, header.MestoTroskaText, "8", common.ClassLabel+" w-44", translator)
				if !header.BezProtivstava() {
					@robOpstiOrgjed("idorgjed1", "mestotrid1", translator.Label("OJ gde ide roba"), translator.Label("M. troška gde ide roba"), header.Orgjed1, header.Orgjed1Text, header.MestoTroska1, header.MestoTroska1Text, "10", common.ClassLabel+" w-44", translator)
				}
				if header.Grd {
					@robOpstiGradiliste(header, translator)
				}
				if header.Ptg {
					@robOpstiRadnik(header, translator)
				}
			}
		</div>
	</div>
}

// robOpstiOrgjed renders an org. jedinica and its mesto troška (the search of the mesta troška of the selected
// org. jedinica).
templ robOpstiOrgjed(ojID, mtID, ojLabel, mtLabel string, oj sql.NullInt64, ojText string, mt sql.NullInt64, mtText string, tabIndex, classLabel string, translator *i18n.Service) {
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: ojID, LabelText: ojLabel, ClassLabel: classLabel})
		@components.TableCombo(domain.TableComboConfig{
			ID:           ojID + "-combo",
			Name:         ojID,
			ValueID:      ojID,
			Value:        robnoFaktureNullID(oj),
			DisplayValue: ojText,
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassWrapper: "relative flex-1 min-w-0",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			SearchURL:    "/api/search/org-jedinice",
			AllowEmpty:   true,
			HideDetails:  true,
			TabIndex:     tabIndex,
		}, translator)
	</div>
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: mtID, LabelText: mtLabel, ClassLabel: classLabel})
		@components.TableCombo(domain.TableComboConfig{
			ID:           mtID + "-combo",
			Name:         mtID,
			ValueID:      mtID,
			Value:        robnoFaktureNullID(mt),
			DisplayValue: mtText,
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassWrapper: "relative flex-1 min-w-0",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			SearchURL:    "/api/search/mesta-troska",
			AllowEmpty:   true,
			HideDetails:  true,
			// The mesta troška of the selected org. jedinica.
			HxInclude: "#" + ojID,
			HxTrigger: "input changed delay:300ms, focus[tableComboEmpty(this)], change[document.activeElement === this] from:#" + ojID,
			TabIndex:  robOpstiTab(tabIndex, 1),
		}, translator)
	</div>
}

// robOpstiPrenos renders where the roba of a prenosnica goes (the right column of the header of the legacy
// rob_Prenosnice): the magacin (not changed on a saved document), its konto zaliha (the konta of the selected
// magacin; a new magacin gives its first konto) and the org. jedinica and the mesto troška.
templ robOpstiPrenos(header domain.RobnoOpstiHeaderView, translator *i18n.Service) {
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "magacin1", LabelText: translator.Label("Magacin gde ide roba"), ClassLabel: common.ClassLabel + " w-48"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "magacin1-combo",
			Name:         "magacin1",
			ValueID:      "magacin1",
			Value:        robnoFaktureNullID(header.Magacin1),
			DisplayValue: header.Magacin1Text,
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassWrapper: "relative flex-1 min-w-0",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			SearchURL:    "/api/search/magacini-prenosa",
			HideDetails:  true,
			Disabled:     header.Magacin1Zakljucan,
			OnSelect:     "robOpstiMagacin1Izabran",
			TabIndex:     "8",
		}, translator)
	</div>
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "konto1", LabelText: translator.Label("Konto zaliha gde ide roba"), ClassLabel: common.ClassLabel + " w-48"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "konto1-combo",
			Name:         "konto1",
			ValueID:      "konto1",
			Value:        header.Konto1,
			DisplayValue: header.Konto1Text,
			Placeholder:  "Pretraži po kontu",
			ClassWrapper: "relative flex-1 min-w-0",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			// The konta of the selected magacin.
			SearchURL:   "/api/search/konta-magacina",
			HxInclude:   "#magacin1",
			HideDetails: true,
			TabIndex:    "9",
		}, translator)
	</div>
	@robOpstiOrgjed("idorgjed1", "mestotrid1", translator.Label("OJ gde ide roba"), translator.Label("Mesto troška gde ide roba"), header.Orgjed1, header.Orgjed1Text, header.MestoTroska1, header.MestoTroska1Text, "10", common.ClassLabel+" w-48", translator)
}

// robOpstiGradiliste renders the gradilište of a zaduženje gradilišta (the legacy EDT_PKTO, EDT_PANA and
// EDT_nazProd of rob_ZadauzGRADILISTA): the konto of the kontni plan, its analitička šifra (the šifre of the
// konto) and the naziv of the gradilište; of a trebovanje the konto, the analitička šifra and the naziv of the
// trošak (rob_Trebovanja).
templ robOpstiGradiliste(header domain.RobnoOpstiHeaderView, translator *i18n.Service) {
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "pkto", LabelText: translator.Label(robOpstiGradilisteLabela(header, 0)), ClassLabel: common.ClassLabel + " w-44"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "pkto-combo",
			Name:         "pkto",
			ValueID:      "pkto",
			Value:        header.Pkto,
			DisplayValue: header.Pkto,
			Placeholder:  "Pretraži po kontu ili nazivu",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			ClassWrapper: "!w-32 shrink-0",
			SearchURL:    "/api/search/konta",
			AllowEmpty:   true,
			HideDetails:  true,
			OnSelect:     "robOpstiPktoIzabran",
			TabIndex:     "10",
		}, translator)
		@components.LabelField(domain.LabelFieldConfig{ID: "pana", LabelText: translator.Label(robOpstiGradilisteLabela(header, 1)), ClassLabel: common.ClassLabel + " pl-2"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "pana-combo",
			Name:         "pana",
			ValueID:      "pana",
			Value:        header.Pana,
			DisplayValue: header.Pana,
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			ClassWrapper: "relative flex-1 min-w-0",
			// The šifre of the konto of the gradilište (the parameter pkto of the search).
			SearchURL:   "/api/search/analitika",
			HxInclude:   "#pkto",
			AllowEmpty:  true,
			HideDetails: true,
			OnSelect:    "robOpstiPanaIzabrana",
			TabIndex:    "11",
		}, translator)
	</div>
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "gradilistenaziv", LabelText: translator.Label(robOpstiGradilisteLabela(header, 2)), ClassLabel: common.ClassLabel + " w-44"})
		@components.TextInputField(domain.InputFieldConfig{ID: "gradilistenaziv", FieldType: "text", Value: header.GradilisteNaziv, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
	</div>
}

// robOpstiRadnik renders the radnik of a popis u toku godine (the legacy EDT_PKTO with EDT_NAZKONTO and EDT_PANA
// with EDT_NAZSIFRE of rob_opsti_dokPOPIS): the konto of the kontni plan with its naziv, its analitička šifra (the
// šifre of the konto) with its naziv.
templ robOpstiRadnik(header domain.RobnoOpstiHeaderView, translator *i18n.Service) {
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "pkto", LabelText: translator.Label("Konto radnika"), ClassLabel: common.ClassLabel + " w-44"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "pkto-combo",
			Name:         "pkto",
			ValueID:      "pkto",
			Value:        header.Pkto,
			DisplayValue: header.Pkto,
			Placeholder:  "Pretraži po kontu ili nazivu",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			ClassWrapper: "!w-32 shrink-0",
			SearchURL:    "/api/search/konta",
			AllowEmpty:   true,
			HideDetails:  true,
			OnSelect:     "robOpstiRadnikKonto",
			TabIndex:     "10",
		}, translator)
		@components.TextInputField(domain.InputFieldConfig{ID: "nazivkonta", FieldType: "text", Value: header.PktoNaziv, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
	</div>
	<div class="flex items-center gap-1 min-w-0">
		@components.LabelField(domain.LabelFieldConfig{ID: "pana", LabelText: translator.Label("Šifra radnika"), ClassLabel: common.ClassLabel + " w-44"})
		@components.TableCombo(domain.TableComboConfig{
			ID:           "pana-combo",
			Name:         "pana",
			ValueID:      "pana",
			Value:        header.Pana,
			DisplayValue: header.Pana,
			Placeholder:  "Pretraži po šifri ili nazivu",
			ClassInput:   common.ClassInputTextEnabled + " w-full",
			ClassWrapper: "!w-32 shrink-0",
			// The šifre of the konto of the radnik (the parameter pkto of the search).
			SearchURL:   "/api/search/analitika",
			HxInclude:   "#pkto",
			AllowEmpty:  true,
			HideDetails: true,
			OnSelect:    "robOpstiRadnikSifra",
			TabIndex:    "11",
		}, translator)
		@components.TextInputField(domain.InputFieldConfig{ID: "nazivsifre", FieldType: "text", Value: header.GradilisteNaziv, Disabled: true, ClassInput: common.ClassInputTextDisabled + " flex-1 min-w-0"})
	</div>
}

// RobOpstiHeaderButtons renders the buttons of the header: "Sačuvaj" (the header processed), "Izmeni" (the
// stavke processed: back to the header), "Novi dok.", "Štampaj" of a saved document and "Nazad".
templ RobOpstiHeaderButtons(header domain.RobnoOpstiHeaderView, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	if header.Pre {
		<!-- What the print of the prenosnica shows (the legacy CBOX_NAZIV and CBOX_KOMERCOPIS) -->
		<div class="mr-auto flex items-center gap-3">
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "nazivustampi",
				Name:              "naziv",
				LabelText:         "Naziv artikla u štampi",
				ClassLabel:        common.ClassCheckboxLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: common.ClassCheckboxSpan,
				IsChecked:         true,
				TabIndex:          "-1"}, translator)
			@components.CheckboxField(domain.CheckboxFieldConfig{
				ID:                "komercopis",
				Name:              "komercopis",
				LabelText:         "Komercijalni opis u štampi",
				ClassLabel:        common.ClassCheckboxLabel,
				ClassCheckbox:     common.ClassCheckbox,
				ClassCheckboxSpan: common.ClassCheckboxSpan,
				TabIndex:          "-1"}, translator)
		</div>
	}
	@components.Button(robOpstiDugme(btns.Save, !header.Snimljen))
	@components.Button(robOpstiDugme(btns.Modify, header.Snimljen))
	@components.Button(robOpstiDugme(btns.New, !header.Snimljen))
	<!-- A nivelacija veleprodaje prints from its stavke -->
	if header.RdokID > 0 && !header.Niv {
		@components.Search_PartPrintButton(btns.Print)
	}
	@components.Button(btns.Back)
}

// RobOpstiStavkeButtons renders "Sačuvaj" of the stavka (the stavke processed) and, of a nivelacija
// veleprodaje, "Štampaj" of the saved document (the legacy BTN_Print1 of the stavke).
templ RobOpstiStavkeButtons(header domain.RobnoOpstiHeaderView, btns domain.RobnoFaktureButtons) {
	@components.Button(robOpstiDugme(btns.SaveStavka, header.Snimljen))
	if header.Niv && header.RdokID > 0 {
		@components.Search_PartPrintButton(btns.Print)
	}
}

// RobOpstiStavkeFields renders the stavke of the opšti dokument: the konto and the šifra of the artikal with its
// naziv and stanje, the količina with the JM, the nabavna cena, the cena (veleprodajna or magacinska, not
// entered in a magacin of the nabavna cena) with the iznos, the OTK broj, the serija and the rok (a magacin of
// the tip zaliha 2), "Sačuvaj" of the stavka and the grid of the stavke.
templ RobOpstiStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	if stavka.Fin {
		@RobOpstiFinStavkeFields(ui, header, stavka, tbl, btns, translator)
	} else if stavka.Kol {
		@RobOpstiKolStavkeFields(ui, header, stavka, tbl, btns, translator)
	} else if stavka.Mnv {
		@RobOpstiMnvStavkeFields(ui, header, stavka, tbl, btns, translator)
	} else if stavka.Niv {
		@RobOpstiNivStavkeFields(ui, header, stavka, tbl, btns, translator)
	} else {
		@robOpstiStavkeFields(ui, header, stavka, tbl, btns, translator)
	}
}

// RobOpstiFinStavkeFields renders the stavke of a finansijski opšti dokument (the legacy rob_opsti_dokumenti_FIN):
// the konto and the šifra of the artikal with its naziv and stanje, the iznos with the JM, "Sačuvaj" of the
// stavka and the grid of the stavke.
templ RobOpstiFinStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div id="robno-opsti-stavka" class="flex flex-col" data-artikal-url={ ui.ArtikalURL } data-tipzal="1" data-nabcena="false">
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kontostavke", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:        "kontostavke",
				Name:      "kontostavke",
				FieldType: "text",
				Value:     stavka.Konto,
				// The width of the količina / iznos below it: the labels after them start at the same x.
				ClassInput: common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:  "10",
				OnInput:    "clearFieldError",
				OnFocus:    "clearFieldError",
				TabIndex:   "1"})
			@components.LabelField(domain.LabelFieldConfig{ID: "sifraartikla", LabelText: translator.Label("Šifra artikla"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TableCombo(domain.TableComboConfig{
				ID:           "sifraartikla-combo",
				Name:         "sifraartikla",
				ValueID:      "sifraartikla",
				Placeholder:  "Pretraži po šifri, nazivu ili barkodu",
				ClassInput:   common.ClassInputTextEnabled + " w-full",
				ClassWrapper: "w-[32rem] min-w-0 shrink",
				SearchURL:    "/api/search/artikli",
				FreeText:     true,
				HideDetails:  true,
				TabIndex:     "2",
			}, translator)
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "iznosfin", LabelText: translator.Label("Iznos"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "iznosfin",
				Name:          "iznosfin",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 2,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "3"})
			@components.LabelField(domain.LabelFieldConfig{ID: "jmopd", LabelText: translator.Label("JM"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TextInputField(domain.InputFieldConfig{ID: "jmopd", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-20"})
			<div class="ml-auto flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "stanjeopd", LabelText: translator.Label("Stanje"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "stanjeopd", FieldType: "number", DecimalPlaces: 3, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-32 text-right"})
			</div>
		</div>
	</div>
	<div class="flex items-center justify-end gap-1">
		@RobOpstiStavkeButtons(header, btns)
	</div>
	if tbl.TableID != "" {
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// RobOpstiKolStavkeFields renders the stavke of a količinski opšti dokument (the legacy rob_opsti_dokumenti_KOL):
// the konto and the šifra of the artikal with its naziv and stanje, the količina with the JM, the OTK broj, the
// serija and the rok (the legacy GR_ZALIHE: hidden in a magacin of the tip zaliha 1), "Sačuvaj" of the stavka
// and the grid of the stavke.
templ RobOpstiKolStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div id="robno-opsti-stavka" class="flex flex-col" data-artikal-url={ ui.ArtikalURL } data-tipzal={ strconv.Itoa(stavka.Tipzal) } data-nabcena="false">
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kontostavke", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:        "kontostavke",
				Name:      "kontostavke",
				FieldType: "text",
				Value:     stavka.Konto,
				// The width of the količina / iznos below it: the labels after them start at the same x.
				ClassInput: common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:  "10",
				OnInput:    "clearFieldError",
				OnFocus:    "clearFieldError",
				TabIndex:   "1"})
			@components.LabelField(domain.LabelFieldConfig{ID: "sifraartikla", LabelText: translator.Label("Šifra artikla"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TableCombo(domain.TableComboConfig{
				ID:           "sifraartikla-combo",
				Name:         "sifraartikla",
				ValueID:      "sifraartikla",
				Placeholder:  "Pretraži po šifri, nazivu ili barkodu",
				ClassInput:   common.ClassInputTextEnabled + " w-full",
				ClassWrapper: "w-[32rem] min-w-0 shrink",
				SearchURL:    "/api/search/artikli",
				FreeText:     true,
				HideDetails:  true,
				TabIndex:     "2",
			}, translator)
			<div class="ml-auto flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "stanjeopd", LabelText: translator.Label("Stanje"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "stanjeopd", FieldType: "number", DecimalPlaces: 3, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-32 text-right"})
			</div>
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kolicina", LabelText: translator.Label("Količina"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "kolicina",
				Name:          "kolicina",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 3,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "3"})
			@components.LabelField(domain.LabelFieldConfig{ID: "jmopd", LabelText: translator.Label("JM"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TextInputField(domain.InputFieldConfig{ID: "jmopd", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-20"})
		</div>
		@robOpstiZalihe(stavka.Tipzal != 1, false, "mb-1", "4", translator)
	</div>
	<!-- "Sačuvaj" of the stavka, between the form and the grid -->
	<div class="flex items-center justify-end gap-1">
		@RobOpstiStavkeButtons(header, btns)
	</div>
	if tbl.TableID != "" {
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// RobOpstiMnvStavkeFields renders the stavke of a nivelacija (the legacy rob_opsti_dokumenti_MNV): the naziv of
// the artikal (no šifra), the količina, the stara and the nova cena with the efekat of the nivelacija,
// "Sačuvaj" of the stavka and the grid of the stavke.
templ RobOpstiMnvStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div id="robno-opsti-stavka" class="flex flex-col" data-artikal-url={ ui.ArtikalURL } data-tipzal="1" data-nabcena="false">
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "nazivmnv", LabelText: translator.Label("Naziv artikla"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:         "nazivmnv",
				Name:       "nazivmnv",
				FieldType:  "text",
				ClassInput: common.ClassInputTextEnabled + " flex-1 min-w-0",
				MaxLength:  "1000",
				OnInput:    "clearFieldError",
				OnFocus:    "clearFieldError",
				TabIndex:   "1"})
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kolicina", LabelText: translator.Label("Količina"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "kolicina",
				Name:          "kolicina",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 3,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "2"})
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "staracena", LabelText: translator.Label("Stara cena"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "staracena",
				Name:          "staracena",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 2,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "3"})
			@components.LabelField(domain.LabelFieldConfig{ID: "novacena", LabelText: translator.Label("Nova cena"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "novacena",
				Name:          "novacena",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 2,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "4"})
			<div class="ml-auto flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "efekatmnv", LabelText: translator.Label("Efekat nivelacije"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{
					ID:            "efekatmnv",
					FieldType:     "number",
					Value:         "0",
					DecimalPlaces: 2,
					Disabled:      true,
					ClassInput:    common.ClassInputTextDisabled + " !w-36 shrink-0 text-right"})
			</div>
		</div>
	</div>
	<!-- "Sačuvaj" of the stavka, between the form and the grid -->
	<div class="flex items-center justify-end gap-1">
		@RobOpstiStavkeButtons(header, btns)
	</div>
	if tbl.TableID != "" {
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// RobOpstiNivStavkeFields renders the stavke of a nivelacija veleprodaje (the legacy rob_Nivelacije_Veleprodaja):
// the šifra of the artikal with its naziv, the konto and the JM, the OTK broj, the serija and the rok (shown in a
// magacin of the tip zaliha 2: the stavke are saved per lot of the artikal), the količina and the procenat, the
// stara and the nova cena with the razlika, "Sačuvaj" and "Štampaj" and the grid of the stavke.
templ RobOpstiNivStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div id="robno-opsti-stavka" class="flex flex-col" data-artikal-url={ ui.ArtikalURL } data-tipzal={ strconv.Itoa(stavka.Tipzal) } data-nabcena="false" data-niv="true">
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<!-- The columns: the labels, the šifra (the količina and the stara cena with the procenat and the nova cena),
		the JM and the razlika labels, the JM with the konto and the razlika -->
		<div class="grid grid-cols-[9rem_minmax(min-content,32rem)_auto_auto] justify-start items-center gap-1 mb-1 min-w-0">
			@components.LabelField(domain.LabelFieldConfig{ID: "sifraartikla", LabelText: translator.Label("Šifra artikla"), ClassLabel: common.ClassLabel + " w-36 col-start-1"})
			@components.TableCombo(domain.TableComboConfig{
				ID:           "sifraartikla-combo",
				Name:         "sifraartikla",
				ValueID:      "sifraartikla",
				Placeholder:  "Pretraži po šifri ili nazivu",
				ClassInput:   common.ClassInputTextEnabled + " w-full",
				ClassWrapper: "w-full min-w-0",
				SearchURL:    "/api/search/artikli",
				FreeText:     true,
				HideDetails:  true,
				TabIndex:     "1",
			}, translator)
			@components.LabelField(domain.LabelFieldConfig{ID: "jmopd", LabelText: translator.Label("JM"), ClassLabel: common.ClassLabelDrugoPolje})
			<div class="flex items-center gap-1">
				@components.TextInputField(domain.InputFieldConfig{ID: "jmopd", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-20 shrink-0"})
				@components.LabelField(domain.LabelFieldConfig{ID: "kontostavke", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " pl-2"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:         "kontostavke",
					Name:       "kontostavke",
					FieldType:  "text",
					Value:      stavka.Konto,
					ClassInput: common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
					MaxLength:  "10",
					OnInput:    "clearFieldError",
					OnFocus:    "clearFieldError",
					TabIndex:   "2"})
			</div>
			@robOpstiZalihe(stavka.Tipzal == 2, true, "col-span-full", "-1", translator)
			@components.LabelField(domain.LabelFieldConfig{ID: "kolicina", LabelText: translator.Label("Količina"), ClassLabel: common.ClassLabel + " w-36 col-start-1"})
			<div class="flex items-center gap-1">
				@components.TextInputField(domain.InputFieldConfig{
					ID:            "kolicina",
					Name:          "kolicina",
					FieldType:     "number",
					SelectOnFocus: true,
					Value:         "0",
					DecimalPlaces: 3,
					ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
					MaxLength:     "18",
					OnFocus:       "clearFieldError",
					TabIndex:      "3"})
				<!-- Its input ends at the end of the šifra -->
				<div class="ml-auto flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{ID: "procenatniv", LabelText: translator.Label("Procenat"), ClassLabel: common.ClassLabelDrugoPolje})
					@components.TextInputField(domain.InputFieldConfig{
						ID:            "procenatniv",
						Name:          "procenatniv",
						FieldType:     "number",
						SelectOnFocus: true,
						Value:         "0",
						DecimalPlaces: 2,
						ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
						MaxLength:     "18",
						OnFocus:       "clearFieldError",
						TabIndex:      "4"})
				</div>
			</div>
			@components.LabelField(domain.LabelFieldConfig{ID: "staracena", LabelText: translator.Label("Stara cena"), ClassLabel: common.ClassLabel + " w-36 col-start-1"})
			<div class="flex items-center gap-1">
				@components.TextInputField(domain.InputFieldConfig{
					ID:            "staracena",
					Name:          "staracena",
					FieldType:     "number",
					SelectOnFocus: true,
					Value:         "0",
					DecimalPlaces: 2,
					ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
					MaxLength:     "18",
					OnFocus:       "clearFieldError",
					TabIndex:      "5"})
				<!-- Its input ends at the end of the šifra -->
				<div class="ml-auto flex items-center gap-1">
					@components.LabelField(domain.LabelFieldConfig{ID: "novacena", LabelText: translator.Label("Nova cena"), ClassLabel: common.ClassLabelDrugoPolje})
					@components.TextInputField(domain.InputFieldConfig{
						ID:            "novacena",
						Name:          "novacena",
						FieldType:     "number",
						SelectOnFocus: true,
						Value:         "0",
						DecimalPlaces: 2,
						ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
						MaxLength:     "18",
						OnFocus:       "clearFieldError",
						TabIndex:      "6"})
				</div>
			</div>
			@components.LabelField(domain.LabelFieldConfig{ID: "razlikaniv", LabelText: translator.Label("Razlika"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TextInputField(domain.InputFieldConfig{ID: "razlikaniv", FieldType: "number", Value: "0", DecimalPlaces: 2, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-36 shrink-0 text-right"})
		</div>
	</div>
	<!-- "Sačuvaj" and "Štampaj" of the stavke, between the form and the grid -->
	<div class="flex items-center justify-end gap-1">
		@RobOpstiStavkeButtons(header, btns)
	</div>
	if tbl.TableID != "" {
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// robOpstiStavkeNaslov is the title of the stavke: "Stavke" of a nivelacija (MNV), "Unos stavki" of a
// finansijski or a količinski opšti dokument, else "Stavke dokumenta".
func robOpstiStavkeNaslov(header domain.RobnoOpstiHeaderView) string {
	switch {
	case header.Mnv:
		return "Stavke"
	case header.Fin || header.Kol:
		return "Unos stavki"
	}
	return "Stavke dokumenta"
}

templ robOpstiStavkeFields(ui domain.RobnoFaktureUI, header domain.RobnoOpstiHeaderView, stavka domain.RobnoOpstiStavka, tbl domain.TableData, btns domain.RobnoFaktureButtons, translator *i18n.Service) {
	<div
		id="robno-opsti-stavka"
		class="flex flex-col"
		data-artikal-url={ ui.ArtikalURL }
		data-tipzal={ strconv.Itoa(stavka.Tipzal) }
		data-nabcena={ robnoFaktureState(stavka.NabCena) }
		if stavka.Pre {
			data-dozmenjaj={ robnoFaktureState(stavka.DozMenjajCenu) }
		}
	>
		<input type="hidden" id="stavkardokid" name="rdokid" value={ strconv.FormatInt(stavka.RdokID, 10) }/>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kontostavke", LabelText: translator.Label("Konto"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:        "kontostavke",
				Name:      "kontostavke",
				FieldType: "text",
				Value:     stavka.Konto,
				// The width of the količina / iznos below it: the labels after them start at the same x.
				ClassInput: common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:  "10",
				OnInput:    "clearFieldError",
				OnFocus:    "clearFieldError",
				TabIndex:   "1"})
			@components.LabelField(domain.LabelFieldConfig{ID: "sifraartikla", LabelText: translator.Label("Šifra artikla"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TableCombo(domain.TableComboConfig{
				ID:           "sifraartikla-combo",
				Name:         "sifraartikla",
				ValueID:      "sifraartikla",
				Placeholder:  "Pretraži po šifri, nazivu ili barkodu",
				ClassInput:   common.ClassInputTextEnabled + " w-full",
				ClassWrapper: "w-[32rem] min-w-0 shrink",
				SearchURL:    "/api/search/artikli",
				FreeText:     true,
				HideDetails:  true,
				TabIndex:     "2",
			}, translator)
			<div class="ml-auto flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "stanjeopd", LabelText: translator.Label("Stanje"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "stanjeopd", FieldType: "number", DecimalPlaces: 3, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-32 text-right"})
			</div>
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			@components.LabelField(domain.LabelFieldConfig{ID: "kolicina", LabelText: translator.Label("Količina"), ClassLabel: common.ClassLabel + " w-36"})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "kolicina",
				Name:          "kolicina",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 3,
				ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "3"})
			@components.LabelField(domain.LabelFieldConfig{ID: "jmopd", LabelText: translator.Label("JM"), ClassLabel: common.ClassLabelDrugoPolje})
			@components.TextInputField(domain.InputFieldConfig{ID: "jmopd", FieldType: "text", Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-20"})
			<div class="ml-auto flex items-center gap-1">
				@components.LabelField(domain.LabelFieldConfig{ID: "iznosopd", LabelText: translator.Label("Iznos"), ClassLabel: common.ClassLabel})
				@components.TextInputField(domain.InputFieldConfig{ID: "iznosopd", FieldType: "number", DecimalPlaces: 2, Disabled: true, ClassInput: common.ClassInputTextDisabled + " !w-32 text-right"})
			</div>
		</div>
		<div class="flex items-center gap-1 min-w-0 mb-1">
			<!-- A zaduženje gradilišta has no nabavna cena (its cena is the first field of the row) -->
			if !stavka.Grd {
				@components.LabelField(domain.LabelFieldConfig{ID: "nabavnacena", LabelText: translator.Label("Nabavna cena"), ClassLabel: common.ClassLabel + " w-36"})
				@components.TextInputField(domain.InputFieldConfig{
					ID:            "nabavnacena",
					Name:          "nabavnacena",
					FieldType:     "number",
					SelectOnFocus: true,
					Value:         "0",
					DecimalPlaces: 2,
					ClassInput:    common.ClassInputTextEnabled + " !w-36 shrink-0 text-right",
					MaxLength:     "18",
					OnFocus:       "clearFieldError",
					TabIndex:      "4"})
			}
			@components.LabelField(domain.LabelFieldConfig{ID: "cenaopd", LabelText: translator.Label(stavka.CenaNaziv), ClassLabel: robOpstiCenaLabela(stavka)})
			@components.TextInputField(domain.InputFieldConfig{
				ID:            "cenaopd",
				Name:          "cenaopd",
				FieldType:     "number",
				SelectOnFocus: true,
				Value:         "0",
				DecimalPlaces: 2,
				ReadOnly:      stavka.CenaZakljucana,
				ClassInput:    robOpstiKlasaUnosa(stavka.CenaZakljucana) + " !w-36 shrink-0 text-right",
				MaxLength:     "18",
				OnFocus:       "clearFieldError",
				TabIndex:      "5"})
		</div>
		if !stavka.Grd {
			@robOpstiZalihe(stavka.Tipzal != 1, false, "mb-1", "6", translator)
		} else if stavka.Otr {
			<!-- A trebovanje: the lot in a magacin of the tip zaliha 2 (the legacy GR_ZALIHE of rob_Trebovanja) -->
			@robOpstiZalihe(stavka.Tipzal == 2, false, "mb-1", "6", translator)
		}
	</div>
	<!-- "Sačuvaj" of the stavka, between the form and the grid -->
	<div class="flex items-center justify-end gap-1">
		@RobOpstiStavkeButtons(header, btns)
	</div>
	if tbl.TableID != "" {
		<div class="flex-1 min-h-0 overflow-auto">
			@components.Table(tbl, translator)
		</div>
	}
}

// robOpstiZalihe renders the row of the OTK broj, the serija and the rok of the stavke (shown in a magacin of the
// tip zaliha 2), its fields aligned with the ones of the rows above (read only: the lot of a nivelacija veleprodaje).
templ robOpstiZalihe(vidljivo, readOnly bool, klasa, tabIndex string, translator *i18n.Service) {
	<div id="robno-opsti-zalihe" class={ "flex items-center gap-1 min-w-0 " + klasa + " " + robUslugeVidljivo(vidljivo) }>
		@components.LabelField(domain.LabelFieldConfig{ID: "otk", LabelText: translator.Label("OTK broj"), ClassLabel: common.ClassLabel + " w-36"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         "otk",
			Name:       "otk",
			FieldType:  "text",
			Disabled:   readOnly,
			ClassInput: robOpstiKlasaUnosa(readOnly) + " !w-36 shrink-0",
			MaxLength:  "20",
			TabIndex:   tabIndex})
		@components.LabelField(domain.LabelFieldConfig{ID: "serija", LabelText: translator.Label("Serija"), ClassLabel: common.ClassLabelDrugoPolje})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         "serija",
			Name:       "serija",
			FieldType:  "text",
			Disabled:   readOnly,
			ClassInput: robOpstiKlasaUnosa(readOnly) + " !w-36 shrink-0",
			MaxLength:  "20",
			TabIndex:   robOpstiTab(tabIndex, 1)})
		@components.LabelField(domain.LabelFieldConfig{ID: "rokstavke", LabelText: translator.Label("Rok"), ClassLabel: common.ClassLabel + " pl-2"})
		@components.TextInputField(domain.InputFieldConfig{
			ID:         "rokstavke",
			Name:       "rokstavke",
			FieldType:  robOpstiRokTip(readOnly),
			Disabled:   readOnly,
			ClassInput: robOpstiKlasaUnosa(readOnly) + " !w-40 shrink-0",
			TabIndex:   robOpstiTab(tabIndex, 2)})
	</div>
}

// robOpstiGradilisteLabela is the label of the konto (i 0), of the šifra (1) and of the naziv (2) of the gradilište
// of a zaduženje gradilišta, of the trošak of a trebovanje.
func robOpstiGradilisteLabela(header domain.RobnoOpstiHeaderView, i int) string {
	if header.Otr {
		return []string{"Konto troška", "Analit. šif.", "Naziv troška"}[i]
	}
	return []string{"Konto gradilišta", "Šifra gradilišta", "Naziv gradilišta"}[i]
}

// robOpstiCenaLabela is the class of the label of the cena of the stavke: the second field of its row, the first
// one of a zaduženje gradilišta (no nabavna cena).
func robOpstiCenaLabela(stavka domain.RobnoOpstiStavka) string {
	if stavka.Grd {
		return common.ClassLabel + " w-36"
	}
	return common.ClassLabelDrugoPolje
}

// robOpstiKlasaUnosa is the class of an input of the stavke: disabled when read only (the zalihe of a nivelacija
// veleprodaje, the cena of a magacin of the nabavna cena).
func robOpstiKlasaUnosa(readOnly bool) string {
	if readOnly {
		return common.ClassInputTextDisabled
	}
	return common.ClassInputTextEnabled
}

// robOpstiRokTip is the type of the rok of the row of the zalihe: a date entered, else the text of the lot.
func robOpstiRokTip(readOnly bool) string {
	if readOnly {
		return "text"
	}
	return "date"
}

// robOpstiDugme is a button of a part of the screen, disabled while the part is not processed (the script
// switches it, robOpstiSetMode).
func robOpstiDugme(btn domain.Button, enabled bool) domain.Button {
	if !enabled {
		btn.IsDisabled = true
		btn.BtnClass += " opacity-50 cursor-not-allowed"
	}
	return btn
}

// robOpstiTab is the tabindex after the one of the tabIndex.
func robOpstiTab(tabIndex string, plus int) string {
	return strconv.Itoa(common.StringToInt(tabIndex) + plus)
}

// robOpstiScriptBody is the script of the opšti dokumenti (the legacy exits of the fields of
// rob_opsti_dokumenti_opd and the switch between the header and the stavke).
templ robOpstiScriptBody() {
	<script>
		function robOpstiBody() {
			return document.querySelector('[data-opsti-body]');
		}
		// The magacin where the roba of a prenosnica goes (OnSelect of its combo): its first konto is the konto
		// zaliha (the legacy select of Combo_MAGACIN, ListSelectPlus of Combo_MAGKONTO).
		function robOpstiMagacin1Izabran(comboID, magaciniid) {
			const body = robOpstiBody();
			if (typeof tableComboClear === 'function') tableComboClear('konto1-combo');
			if (!body || !magaciniid) return;
			fetch(body.dataset.kontoMagacinaUrl + '?' + new URLSearchParams({ magaciniid: magaciniid }), { headers: { 'Accept': 'application/json' } })
				.then(r => r.json())
				.then(k => {
					if (!k || !k.konto) return;
					robnoUpisi('konto1', k.konto);
					robnoUpisi('konto1-combo-input', [k.konto, k.naziv].filter(Boolean).join(' - '));
				})
				.catch(() => {});
		}
		function robOpstiDugme(id, enabled) {
			const btn = document.getElementById(id);
			if (!btn) return;
			btn.disabled = !enabled;
			btn.classList.toggle('opacity-50', !enabled);
			btn.classList.toggle('cursor-not-allowed', !enabled);
		}

		// One part at a time: the header (stavke false) or the stavke (true), with the buttons of the part.
		function robOpstiSetMode(stavke) {
			const body = robOpstiBody();
			if (!body) return;
			robnoFaktureSetPanelEnabled(body.dataset.headerPanel, !stavke);
			robnoFaktureSetPanelEnabled(body.dataset.stavkePanel, stavke);
			robOpstiDugme(body.dataset.headerSave, !stavke);
			robOpstiDugme(body.dataset.novi, !stavke);
			robOpstiDugme(body.dataset.izmeni, stavke);
			robOpstiDugme(body.dataset.stavkaSave, stavke);
			body.dataset.stavkeAktivne = stavke ? 'true' : 'false';
			if (stavke) robnoFaktureFokusStavke();
		}
		// "Izmeni": the header is processed again (the stavke disabled).
		function robOpstiIzmeni() {
			robOpstiSetMode(false);
			const datum = document.getElementById('datumfakturisanja');
			if (datum) datum.focus();
		}

		// The protivstav konto: its naziv (the legacy exit of EDT_TKONTO); a new konto clears the šifra (the legacy
		// entry in EDT_TKONTO). The šifra gives the naziv of the analitika (the legacy exit of EDT_TSIFRA).
		function robOpstiTkontoIzabran(comboID, key, cells) {
			robnoUpisi('tkontonaziv', cells[1] || '');
			if (typeof tableComboClear === 'function') tableComboClear('tsifra-combo');
		}
		function robOpstiTsifraIzabrana(comboID, key, cells) {
			robnoUpisi('tkontonaziv', cells[2] || '');
		}
		// The gradilište of a zaduženje gradilišta: the naziv of its konto, of its šifra (the legacy exits of EDT_PKTO
		// and EDT_PANA); another konto clears the šifra.
		function robOpstiPktoIzabran(comboID, key, cells) {
			robnoUpisi('gradilistenaziv', cells[1] || '');
			if (typeof tableComboClear === 'function') tableComboClear('pana-combo');
		}
		function robOpstiPanaIzabrana(comboID, key, cells) {
			robnoUpisi('gradilistenaziv', cells[2] || '');
		}
		// The radnik of a popis u toku godine: the naziv of its konto and of its šifra (the legacy BTN_Sifra3 and
		// BTN_Sifra5); another konto clears the šifra.
		function robOpstiRadnikKonto(comboID, key, cells) {
			robnoUpisi('nazivkonta', cells[1] || '');
			robnoUpisi('nazivsifre', '');
			if (typeof tableComboClear === 'function') tableComboClear('pana-combo');
		}
		function robOpstiRadnikSifra(comboID, key, cells) {
			robnoUpisi('nazivsifre', cells[2] || '');
		}

		// The iznos of the stavke (the exits of EDT_KOLIC and EDT_CENA); of a nivelacija the efekat: the količina by
		// the nova cena less the količina by the stara cena (the exit of EDT_Cena of rob_opsti_dokumenti_MNV).
		function robOpstiIznos() {
			robnoUpisiBroj('iznosopd', robnoBroj('kolicina') * robnoBroj('cenaopd'));
			if (document.getElementById('efekatmnv')) {
				const k = robnoBroj('kolicina');
				robnoUpisiBroj('efekatmnv', k * robnoBroj('novacena') - k * robnoBroj('staracena'));
			}
			// A nivelacija veleprodaje: the razlika, the količina by the nova less the stara cena (the legacy exits of
			// EDT_FCENA and EDT_CENA; with a nova cena).
			if (document.getElementById('razlikaniv') && robnoBroj('novacena') > 0) {
				robnoUpisiBroj('razlikaniv', robnoBroj('kolicina') * (robnoBroj('novacena') - robnoBroj('staracena')));
			}
		}
		// A nivelacija veleprodaje: the procenat of the nova cena to the stara (the legacy exit of EDT_CENA) and the
		// nova cena of a procenat that is not 0 (the legacy exit of EDT_PROCENAT).
		function robOpstiNivProcenat() {
			if (!document.getElementById('procenatniv')) return;
			const stara = robnoBroj('staracena');
			robnoUpisiBroj('procenatniv', stara !== 0 ? robnoZaokruzi((robnoBroj('novacena') - stara) * 100 / stara, 2) : 0);
		}
		function robOpstiNivNovaCena() {
			const p = robnoBroj('procenatniv');
			if (p === 0) return;
			robnoUpisiBroj('novacena', robnoZaokruzi(robnoBroj('staracena') * (100 + p) / 100, 2));
			robOpstiIznos();
		}

		// The fields of the artikal cleared (the legacy PrazniPOLJA of the entry in EDT_SIFRA).
		function robOpstiPrazniPolja() {
			['kolicina', 'cenaopd', 'nabavnacena', 'stanjeopd', 'iznosopd', 'staracena', 'novacena', 'razlikaniv'].forEach(id => robnoUpisiBroj(id, 0));
			['jmopd', 'otk', 'serija', 'rokstavke'].forEach(id => robnoUpisi(id, ''));
		}

		// The artikal of the stavka (the legacy exit of EDT_SIFRA): its naziv, JM, konto, cene and stanje (of the lot
		// of the form in a magacin of the tip zaliha 2).
		function robOpstiArtikal() {
			const forma = document.getElementById('robno-opsti-stavka');
			const sifra = document.getElementById('sifraartikla');
			const konto = document.getElementById('kontostavke');
			if (!forma || !sifra || !konto) return;
			robnoUpisiBroj('cenaopd', 0);
			robnoUpisiBroj('nabavnacena', 0);
			const vrednost = sifra.value.trim();
			if (vrednost === '' || vrednost === '0') return;
			const url = forma.dataset.artikalUrl + '?' + new URLSearchParams({
				rdokid: document.getElementById('stavkardokid').value, sifra: vrednost, konto: konto.value,
				otk: document.getElementById('otk') ? document.getElementById('otk').value : '',
				serija: document.getElementById('serija') ? document.getElementById('serija').value : '',
				rok: document.getElementById('rokstavke') ? document.getElementById('rokstavke').value : '',
			});
			fetch(url, { headers: { 'Accept': 'application/json' } })
				.then(r => r.json())
				.then(odgovor => {
					const a = odgovor.artikal || {};
					// A nivelacija veleprodaje: the naziv and the JM, the količina and the stara cena of the stanje.
					if (forma.dataset.niv === 'true') {
						if (!odgovor.found) {
							robnoUpisi('jmopd', '');
							return;
						}
						robnoUpisi('sifraartikla-combo-input', a.sifra + ' - ' + a.naziv);
						robnoUpisi('jmopd', a.jm);
						robnoUpisiBroj('kolicina', a.kolicina);
						robnoUpisiBroj('staracena', a.staracena);
						robnoUpisiBroj('novacena', 0);
						robnoUpisiBroj('razlikaniv', 0);
						if (a.poruka) alert(a.poruka);
						return;
					}
					if (!odgovor.found) {
						if (a.poruka) alert(a.poruka);
						robnoUpisi('sifraartikla-combo-input', '');
						sifra.value = a.poruka ? '0' : sifra.value;
						return;
					}
					sifra.value = String(a.sifra);
					robnoUpisi('sifraartikla-combo-input', a.sifra + ' - ' + a.naziv);
					robnoUpisi('jmopd', a.jm);
					if (a.konto) konto.value = a.konto;
					robnoUpisiBroj('cenaopd', a.cena);
					robnoUpisiBroj('nabavnacena', a.ncena);
					robnoUpisiBroj('stanjeopd', a.stanje);
					// A prenosnica: the cena of the stanje is not changed when initable DOZMENJAJCENU says "NE" (the
					// legacy DozMenjajCenu).
					if (forma.dataset.dozmenjaj === 'false') {
						const cena = document.getElementById('cenaopd');
						if (cena) cena.readOnly = Number(a.cena) > 0;
					}
					robOpstiIznos();
					const kolicina = document.getElementById('kolicina');
					if (kolicina) kolicina.focus();
				});
		}

		// The events of the form (delegated: the content comes back with the saved document).
		if (!window.robOpstiListener) {
			window.robOpstiListener = true;
			const uFormi = evt => evt.target && evt.target.id && robOpstiBody() && evt.target.closest('#robno-opsti-stavka');
			document.addEventListener('focusin', function (evt) {
				// The entry in the šifra clears the fields of the artikal.
				if (uFormi(evt) && evt.target.id === 'sifraartikla-combo-input') robOpstiPrazniPolja();
				// The org. jedinica before its selection (its mesto troška is chosen again for another one).
				if (robOpstiBody() && evt.target && (evt.target.id === 'idorgjed-combo-input' || evt.target.id === 'idorgjed1-combo-input')) {
					const oj = document.getElementById(evt.target.id.replace('-combo-input', ''));
					if (oj) oj.dataset.prethodna = oj.value;
				}
			});
			document.addEventListener('change', function (evt) {
				if (!robOpstiBody() || !evt.target) return;
				// A new protivstav konto (typed): its šifra and naziv cleared.
				if (evt.target.id === 'tkonto') {
					if (typeof tableComboClear === 'function') tableComboClear('tsifra-combo');
					return;
				}
				// A new konto of the gradilište (typed): its šifra cleared.
				if (evt.target.id === 'pkto') {
					if (typeof tableComboClear === 'function') tableComboClear('pana-combo');
					return;
				}
				// Another org. jedinica: its mesto troška is chosen again (the search gives the mesta troška of the
				// selected org. jedinica, only "-" without it).
				if (evt.target.id === 'idorgjed' || evt.target.id === 'idorgjed1') {
					// The org. jedinica before the selection (kept when its combo got the focus).
					const prethodna = evt.target.dataset.prethodna;
					if ((prethodna === undefined || evt.target.value !== prethodna) && typeof tableComboClear === 'function') {
						tableComboClear(evt.target.id === 'idorgjed' ? 'mestotrid-combo' : 'mestotrid1-combo');
					}
					evt.target.dataset.prethodna = evt.target.value;
					return;
				}
				if (!uFormi(evt)) return;
				switch (evt.target.id) {
					case 'sifraartikla': robOpstiArtikal(); break;
					case 'kontostavke': evt.target.value = evt.target.value.replace(/\s/g, ''); break;
					case 'kolicina':
					case 'cenaopd':
					case 'staracena': robOpstiIznos(); break;
					case 'novacena': robOpstiIznos(); robOpstiNivProcenat(); break;
					case 'procenatniv': robOpstiNivNovaCena(); break;
					case 'nabavnacena': {
						// A magacin of the nabavna cena: the cena is the nabavna cena (the legacy exit of EDT_NCENA).
						const forma = document.getElementById('robno-opsti-stavka');
						if (forma && forma.dataset.nabcena === 'true') {
							robnoUpisiBroj('cenaopd', robnoBroj(evt.target.id));
							robOpstiIznos();
						}
						break;
					}
				}
			});
		}
	</script>
}
