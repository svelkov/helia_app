package templates

import "helia/internal/domain"

templ Search_Part(tbl domain.TableData, searchControl domain.InputControl) {
	<div class="flex justify-between items-center mb-2">
		<h2 class="text-xl font-semibold">{ tbl.ContentTitle }</h2>
		<div class="flex space-x-1 items-center">
			<div class="relative">
				<input
					name="query"
					if searchControl.Class != "" {
						class={ searchControl.Class }
					}
					id={ searchControl.ID }
					type={ searchControl.Type }
					if searchControl.Placeholder != "" {
						placeholder={ searchControl.Placeholder }
					}
					if searchControl.HxActionURL != "" {
						hx-get={ searchControl.HxActionURL }
					}
					if searchControl.HxTarget != "" {
						hx-target={ searchControl.HxTarget }
					}
					if searchControl.HxSwap != "" {
						hx-swap={ searchControl.HxSwap }
					}
					hx-trigger="keyup changed delay:500ms, search"
					if searchControl.HxInclude != "" {
						hx-include={ searchControl.HxInclude }
					}
					if searchControl.Autocomplete != "" {
						autocomplete={ searchControl.Autocomplete }
					}
				/>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-2 top-1/3 transform -translate-y-1 text-gray-400 peer-focus:opacity-0 peer-not-placeholder-shown:opacity-0 transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
			if tbl.BtnAdd.IsVisible {
				@Search_PartAddButton(tbl)
			}
			if tbl.BtnPrint.IsVisible {
				@Search_PartPrintButton(tbl)
			}
		</div>
	</div>
}

templ Search_PartAddButton(tbl domain.TableData) {
	<button
		class="bg-green-500 hover:bg-green-700 text-white h-6 px-1 py-1 mr-1 rounded text-xs flex items-center"
		hx-get={ tbl.BtnAdd.HxActionURL }
		hx-target="#dialog-container"
		hx-swap="innerHTML"
		onclick="deactivateActionsColumn()"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 mr-1">
			<path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd"></path>
		</svg>
		{ tbl.BtnAdd.LabelText }
	</button>
}

templ Search_PartPrintButton(tbl domain.TableData) {
	<a
		href={ templ.URL(tbl.BtnPrint.HxActionURL) }
		target="_blank"
		rel="noopener noreferrer"
		class="bg-blue-500 hover:bg-blue-700 text-white h-6 px-1 py-1 rounded text-xs flex items-center"
	>
		<svg class="h-6 w-6">
			<use href="/frontend/static/icons/allicons.svg#stampa" xlink:href="/frontend/static/icons/allicons.svg#stampa"></use>
		</svg>
		{ tbl.BtnPrint.LabelText }
	</a>
}
