package templates

import "helia/i18n"

templ Setup2FA(translator *i18n.Service, qrCodeDataURL string, backupCodes []string) {
	<div class="max-w-2xl mx-auto bg-white mt-10 p-6 rounded-lg shadow-md">
		<h2 class="text-2xl font-bold mb-6">{ translator.Label("2fa setup") }</h2>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<!-- QR Code Section -->
			<div class="flex flex-col items-center">
				<h3 class="text-lg font-semibold mb-4">{ translator.Label("scan qr code") }</h3>
				<p class="text-gray-600 text-sm mb-4 text-center">
					{ translator.Label("scan qr instructions") }
				</p>
				<img src={ qrCodeDataURL } alt="TOTP QR Code" class="w-64 h-64 border-2 border-gray-300 rounded-lg"/>
				<p class="text-gray-500 text-xs mt-4">Google Authenticator, Microsoft Authenticator, Authy</p>
			</div>
			
			<!-- Backup Codes Section -->
			<div class="flex flex-col">
				<h3 class="text-lg font-semibold mb-4">{ translator.Label("backup codes") }</h3>
				<p class="text-gray-600 text-sm mb-4">
					{ translator.Label("backup codes info") }
				</p>
				<div class="bg-gray-50 p-4 rounded-lg border border-gray-200 flex-grow">
					<ul class="space-y-2 font-mono text-sm">
						for _, code := range backupCodes {
							<li class="text-gray-700 p-2 bg-white rounded border border-gray-200">
								{ code }
							</li>
						}
					</ul>
				</div>
				<button
					onclick="copyBackupCodesToClipboard()"
					type="button"
					class="mt-4 bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600"
				>
					{ translator.Label("copy codes") }
				</button>
			</div>
		</div>
		
		<!-- Warning Section -->
		<div class="mt-8 p-4 bg-yellow-50 border-l-4 border-yellow-400">
			<p class="text-yellow-800 font-semibold">⚠️ { translator.Label("important warning") }</p>
			<ul class="text-yellow-700 text-sm mt-2 space-y-1 list-disc list-inside">
				<li>{ translator.Label("warning save codes") }</li>
				<li>{ translator.Label("warning secure location") }</li>
				<li>{ translator.Label("warning no recovery") }</li>
			</ul>
		</div>
		
		<!-- Confirmation Section -->
		<div class="mt-8 space-y-4">
			<label class="flex items-start">
				<input
					type="checkbox"
					id="confirm_saved"
					class="w-4 h-4 mt-1 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-600"
				/>
				<span class="ml-2 text-gray-700">
					{ translator.Label("confirm saved codes") }
				</span>
			</label>
			<a href="/login" class="block w-full bg-green-600 text-white py-2 px-4 rounded text-center hover:bg-green-700">
				{ translator.Label("continue to login") }
			</a>
		</div>
	</div>
	
	<script>
		function copyBackupCodesToClipboard() {
			const codes = Array.from(document.querySelectorAll('[id*="backup-code"]'))
				.map(el => el.textContent.trim())
				.join('\n');
			navigator.clipboard.writeText(codes).then(() => {
				alert('Backup codes copied to clipboard');
			}).catch(err => {
				console.error('Failed to copy codes:', err);
			});
		}
	</script>
}
