package templates

import (
	"fmt"
	"helia/i18n"
	"helia/internal/domain"
	"strings"
)

templ Table(tbl domain.TableData, translator *i18n.Service) {
	<div id={ tbl.TableID } class="w-full h-full flex flex-col border-collapse">
		<div class="flex-1 overflow-x-auto overflow-y-auto rounded-t-lg">
			<table class="w-full border-collapse border-r">
				@TableHeader(tbl, translator)
				@TableBody(tbl, tbl.URLPrefix, translator)
			</table>
		</div>
		if tbl.ShowPagination {
			<div class="mt-1 flex justify-center items-center">
				@TablePagination(tbl, translator)
			</div>
		}
		<!-- Container for HTMX-loaded dialog -->
		<div id="dialog-container"></div>
	</div>
	@ShowMessageScript()
	@TableSortScript()
	@TableScript(tbl.TableID)
}

templ TableHeader(tbl domain.TableData, translator *i18n.Service) {
	<thead class="bg-blue-900 text-white border-b border-white sticky top-0 z-20">
		<tr class="h-8">
			for _, header := range tbl.Headers {
				<th
					scope="col"
					class={ fmt.Sprintf("px-1 py-1 text-center text-xs font-medium text-white tracking-wider border border-white sticky top-0 z-20 bg-blue-900 %s", 
						func() string {
							if header.Sortable {
								return "cursor-pointer hover:bg-blue-900 select-none"
							}
							return ""
						}()) }
					if header.Sortable {
						hx-get={ fmt.Sprintf("%s%ssortBy=%s", tbl.URLGetAll, func() string {
									if strings.Contains(tbl.URLGetAll, "?") {
										return "&"
									} else {
										return "?"
									}
								}(), header.Name) }
						hx-target={ fmt.Sprintf("#%s", tbl.TableID) }
						hx-swap="innerHTML"
						hx-trigger="click"
						hx-headers='{"X-Request-Source": "tblheader"}'
						hx-vals={ func() string {
							if strings.TrimSpace(tbl.HxVals) == "" {
								return fmt.Sprintf(`js:{sortOrder: getSortOrder('%s', '%s')}`, tbl.TableID, header.Name)
							}

							hxVals := strings.TrimSpace(tbl.HxVals)
							if strings.HasPrefix(hxVals, "js:") {
								hxVals = strings.TrimSpace(strings.TrimPrefix(hxVals, "js:"))
							}

							return fmt.Sprintf(`js:{...(%s), sortOrder: getSortOrder('%s', '%s')}`, hxVals, tbl.TableID, header.Name)
						}() }
						onclick={ templ.JSFuncCall("toggleSort", tbl.TableID, header.Name, "this") }
					}
				>
					<div class="flex items-center justify-start h-full gap-2">
						<span class="flex-1 text-center">
							if header.Params != nil {
								{ translator.LabelWithParams(header.Label, header.Params) }
							} else {
								{ translator.Label(header.Label) }
							}
						</span>
						if header.Sortable {
							<span class={ fmt.Sprintf("sort-indicator-%s flex-shrink-0 inline-block", header.Name) } style="transition: opacity 200ms ease-in-out, transform 200ms ease-in-out;">
								<svg class="w-5 h-5 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
									<path stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="sort-path" d="M8 18V6m0 0L5 9m3 -3 3 3m5 -3v12m0 0 -3 -3m3 3 3 -3" style="opacity: 1; transition: stroke 200ms ease-in-out; height: 100%;"></path>
								</svg>
							</span>
						}
					</div>
				</th>
			}
			if tbl.ShowActions {
				<th scope="col" class=" actions-column px-3 py-2 text-center text-xs font-medium text-white uppercase tracking-wider w-0 whitespace-nowrap border border-white bg-blue-900 sticky right-0 z-20">
					{ translator.Label("Akcije") }
				</th>
			}
		</tr>
	</thead>
}

templ TableBody(tbl domain.TableData, urlPrefix string, translator *i18n.Service) {
	<tbody id={ fmt.Sprintf("%s-body", tbl.TableID) } class="bg-white divide-y divide-gray-200">
		for i, row := range tbl.Rows {
			<tr
				hx-on:click="handleRowClick(this)"
				class={ fmt.Sprintf("cursor-pointer transition-colors hover:bg-green-100 %s", func() string {
				            if i%2 == 1 {
                                return "bg-green-50"
                            } else {
                                return ""
                            }
                        }()) }
				if tbl.FuncClick !="" {
					onclick={ templ.JSUnsafeFuncCall(tbl.FuncClick) }
				}
				if tbl.FuncDblClick !="" {
					if tbl.DestField != "" {
						data-dest-field={ tbl.DestField }
					}
					if tbl.DestFieldColIndex >= 0 {
						data-value-col={ fmt.Sprintf("%d", tbl.DestFieldColIndex) }
					}
					ondblclick={ templ.JSUnsafeFuncCall(tbl.FuncDblClick) }
				}
				if tbl.DetailTarget != "" && tbl.DetailURL != "" {
					if tbl.DetailTarget != "" {
						hx-target={ tbl.DetailTarget }
					}
					if tbl.DetailHxRequestType == "GET" {
						hx-get={ fmt.Sprintf("%s/%s", tbl.DetailURL, row.ID) }
					}
					if tbl.DetailHxRequestType == "PUT" {
						hx-put={ fmt.Sprintf("%s/%s", tbl.DetailURL, row.ID) }
					}
					if tbl.DetailHxRequestType == "POST" {
						hx-post={ fmt.Sprintf("%s/%s", tbl.DetailURL, row.ID) }
					}
					if tbl.DetailHxSwap != "" {
						hx-swap={ tbl.DetailHxSwap }
					}
					if tbl.DetailHxTrigger != "" {
						hx-trigger={ tbl.DetailHxTrigger }
					}
					if tbl.HxVals != "" {
						hx-vals={ tbl.HxVals }
					}
				}
			>
				for j, cell := range row.Fields {
					<td name={ fmt.Sprintf("td-%d-%s", i, tbl.Headers[j].Name) } class={ fmt.Sprintf("px-1 py-1 text-sm whitespace-nowrap border-r text-%s", tbl.Headers[j].TextAlign) }>
						<div
							name={ fmt.Sprintf("tdval-%d-%s", i, tbl.Headers[j].Name) }
							class={ func() string {
							if tbl.Headers[j].TextAlign != "" {
								return fmt.Sprintf("px-1 text-sm text-black text-%s", tbl.Headers[j].TextAlign)
							}
							return "px-1 text-sm text-black"
						}() }
							title={ translator.Message("Double-click za selektovanje") }
						>
							if tbl.Headers[j].Type == "checkbox" {
								if cell == "true" {
									<input type="checkbox" disabled checked class="w-4 h-4"/>
								} else {
									<input type="checkbox" disabled class="w-4 h-4"/>
								}
							} else {
								{ cell }
							}
						</div>
					</td>
				}
				if tbl.ShowActions && ( tbl.BtnUpdate.IsVisible || tbl.BtnDelete.IsVisible ) {
					<td class="actions-column px-3 py-0.5 whitespace-nowrap text-right text-sm font-medium bg-white w-0 sticky right-0 z-10">
						<div class="flex space-x-1 justify-end">
							if row.HasUpdate || tbl.BtnUpdate.IsVisible {
								<button
									if tbl.BtnUpdate.HxRequestType == "GET" {
										hx-get={ tbl.BtnUpdate.HxActionURL }
									}
									if tbl.BtnUpdate.HxRequestType == "PUT" {
										hx-put={ fmt.Sprintf("%s/%s", tbl.BtnUpdate.HxActionURL, row.ID) }
									}
									if tbl.BtnUpdate.HxRequestType == "POST" {
										hx-post={ fmt.Sprintf("%s/%s", tbl.BtnUpdate.HxActionURL, row.ID) }
									}
									if tbl.BtnUpdate.HxSwap != "" {
										hx-swap={ tbl.BtnUpdate.HxSwap }
									}
									if tbl.BtnUpdate.HxTarget != "" {
										hx-target={ tbl.BtnUpdate.HxTarget }
									} else {
										hx-target="#dialog-container"
									}
									if tbl.BtnUpdate.HxOnAfterRequest != "" {
										{ templ.Attributes{"hx-on::after-request": tbl.BtnUpdate.HxOnAfterRequest}... }
									}
									onclick="event.stopPropagation();"
									hx-vals={ func() string {
										if strings.TrimSpace(tbl.HxVals) == "" {
											return fmt.Sprintf(`{"url": "%s", "id": "%s"}`, tbl.URLPrefix, row.ID)
										}

										hxVals := strings.TrimSpace(tbl.HxVals)
										if strings.HasPrefix(hxVals, "js:") {
											hxVals = strings.TrimSpace(strings.TrimPrefix(hxVals, "js:"))
										}

										return fmt.Sprintf(`js:{...(%s), url: "%s", id: "%s"}`, hxVals, tbl.URLPrefix, row.ID)
									}() }
									class="bg-indigo-500 hover:bg-indigo-700 text-white py-1 px-1 rounded text-xs flex items-center"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 mr-1">
										<path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z"></path>
										<path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z"></path>
									</svg>
									{ translator.Button(tbl.BtnUpdate.LabelText) }
								</button>
							}
							if row.HasDelete || tbl.BtnDelete.IsVisible {
								<button
									hx-get={ tbl.BtnDelete.HxActionURL }
									if tbl.BtnDelete.HxSwap != "" {
										hx-swap={ tbl.BtnDelete.HxSwap }
									}
									if tbl.BtnDelete.HxTarget != "" {
										hx-target={ tbl.BtnDelete.HxTarget }
									} else {
										hx-target="#dialog-container"
									}
									if tbl.BtnDelete.HxOnAfterRequest != "" {
										{ templ.Attributes{"hx-on::after-request": tbl.BtnDelete.HxOnAfterRequest}... }
									}
									hx-vals={ func() string {
										if strings.TrimSpace(tbl.HxVals) == "" {
											return fmt.Sprintf(`{"url": "%s", "id": "%s"}`, tbl.URLPrefix, row.ID)
										}

										hxVals := strings.TrimSpace(tbl.HxVals)
										if strings.HasPrefix(hxVals, "js:") {
											hxVals = strings.TrimSpace(strings.TrimPrefix(hxVals, "js:"))
										}

										return fmt.Sprintf(`js:{...(%s), url: "%s", id: "%s"}`, hxVals, tbl.URLPrefix, row.ID)
									}() }
									class="bg-red-500 hover:bg-red-700 text-white py-1 px-2 rounded text-xs flex items-center"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 mr-1">
										<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
									</svg>
									{ translator.Button(tbl.BtnDelete.LabelText) }
								</button>
							}
						</div>
					</td>
				}
			</tr>
		}
	</tbody>
	if tbl.HasTotals && len(tbl.Totals) > 0 {
		<tfoot class="bg-green-200 font-bold border-t-2 border-blue-900 sticky bottom-0 z-20">
			<tr>
				for j, header := range tbl.Headers {
					if header.IncludeInTotals && j < len(tbl.Totals) {
						<td class="px-1 whitespace-nowrap border-r text-right text-sm font-bold bg-green-200 sticky bottom-0 z-20">
							{ tbl.Totals[j] }
						</td>
					} else {
						<td class="px-1 whitespace-nowrap border-r bg-green-200 sticky bottom-0 z-20"></td>
					}
				}
				if tbl.ShowActions {
					<td class="actions-column px-1 whitespace-nowrap bg-green-200 sticky right-0  bottom-0 z-20"></td>
				}
			</tr>
		</tfoot>
	}
}

templ TableScript(tableID string) {
	<span data-tbody-id={ fmt.Sprintf("%s-body", tableID) } style="display:none"></span>
	<script>
	(function() {
		const _tbodyId = document.currentScript.previousElementSibling.dataset.tbodyId;
		const _tbody   = document.getElementById(_tbodyId);
		let _selected  = null;

		function getRows() {
			return _tbody ? Array.from(_tbody.querySelectorAll('tr')) : [];
		}

		function selectRow(row) {
			if (_selected) {
				_selected.classList.remove('!bg-green-200');
				_selected.removeAttribute('data-selected');
			}
			_selected = (row !== _selected) ? row : null;
			if (_selected) {
				_selected.classList.add('!bg-green-200');
				_selected.setAttribute('data-selected', 'true');
			}
		}

		// Exposed globally for hx-on:click="handleRowClick(this)"
		window.handleRowClick = function(row) { selectRow(row); };

		window.handleRowDoubleClick = function(row) {
			selectRow(row);
			const rowData = Array.from(row.querySelectorAll('td')).map(c => c.textContent.trim());
			document.dispatchEvent(new CustomEvent('rowDblSelected', { detail: rowData }));
			window.selectedRecord = rowData;
		};

		document.addEventListener('keydown', function(e) {
			const tag = document.activeElement?.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown' && e.key !== 'Enter') return;

			const rows = getRows();
			if (!rows.length) return;
			e.preventDefault();

			if (e.key === 'Enter' && _selected) { _selected.click(); return; }

			const idx = _selected ? rows.indexOf(_selected) : -1;
			let newIdx;
			if (e.key === 'ArrowUp') {
				newIdx = idx > 0 ? idx - 1 : idx === -1 ? rows.length - 1 : 0;
			} else {
				newIdx = idx < rows.length - 1 ? idx + 1 : idx === -1 ? 0 : rows.length - 1;
			}
			selectRow(rows[newIdx]);
			rows[newIdx].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		});
	})();
	</script>
}

templ TableSortScript() {
	<script>
	// Sort paths and state management - initialize globally only once
	if (!window.sortStates) {
		window.SORT_PATHS = {
			DEFAULT: "M8 18V6m0 0L5 9m3 -3 3 3m5 -3v12m0 0 -3 -3m3 3 3 -3",
			ASC: "M5 20V4m0 16 3-3m-3 3-3-3m9-13h4m-4 4h6m-6 4h8m-8 4h10m-10 4h12",
			DESC: "M5 4v16M5 4l3 3M5 4 2 7m9-3h12M11 8h10m-10 4h8m-8 4h6m-6 4h4"
		};
		window.sortStates = {}; // Store sort state per table: { tableId: { field: 'ASC'/'DESC' } }
		window.currentSortField = {}; // Track which field is currently sorted for each table
	}

	function toggleSort(tableId, field, headerElement) {
		// Initialize sort state for this table if not already done
		if (!window.sortStates[tableId]) {
			window.sortStates[tableId] = {};
		}
		console.log(`Toggling sort for table: ${tableId}, field: ${field}, headerElement:`, headerElement);
		// Get current sort direction for this field
		const currentSort = window.sortStates[tableId][field];
		let nextSort = currentSort === 'DESC' ? 'ASC' : 'DESC';

		// Update sort state
		window.sortStates[tableId][field] = nextSort;
		window.currentSortField[tableId] = field; // Track current sorted field

		// Animate the indicator with slide + scale effect
		const table = document.getElementById(tableId);
		if (table) {
			const indicator = table.querySelector(`[class*="sort-indicator-${field}"]`);
			if (indicator) {
				// Start with scale small and slid to the left
				indicator.style.transitionDuration = '0ms';
				indicator.style.transform = `scale(0.5) translateX(-10px) rotate(0deg)`;
				indicator.style.opacity = '0.5';
				
				// Slide in from left while scaling up and rotating
				requestAnimationFrame(() => {
					indicator.style.transitionDuration = '200ms';
					indicator.style.transitionTimingFunction = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
					indicator.style.transform = `scale(1.2) translateX(0px) rotate(180deg)`;
					indicator.style.opacity = '1';
				});
				
				// Settle to final size
				setTimeout(() => {
					indicator.style.transitionDuration = '100ms';
					indicator.style.transitionTimingFunction = 'ease-out';
					indicator.style.transform = `scale(1) translateX(0px) rotate(0deg)`;
				}, 200);
			}
		}

		// Update sort indicators on all headers for this table
		updateSortIndicators(tableId, field);

		console.log(`Sorting ${tableId} by ${field}: ${nextSort}`);
	}

	function getSortOrder(tableId, field) {
		// Initialize if needed
		if (!window.sortStates[tableId]) {
			window.sortStates[tableId] = {};
		}
		
		// Return next sort order
		const currentSort = window.sortStates[tableId][field];
		return currentSort === 'DESC' ? 'DESC' : 'ASC';
	}

	function updateSortIndicators(tableId, activeField) {
		// Get all sort indicator spans in this table
		const table = document.getElementById(tableId);
		if (!table) return;

		const indicators = table.querySelectorAll('[class*="sort-indicator-"]');
		//console.log(`Found ${indicators.length} indicators in table ${tableId}`);
		
		indicators.forEach(indicator => {
			// Extract field name from class name (e.g., "sort-indicator-fieldname")
			const fieldMatch = indicator.className.match(/sort-indicator-(\w+)/);
			if (fieldMatch) {
				const field = fieldMatch[1];
				const svg = indicator.querySelector('svg');
				const path = svg ? svg.querySelector('.sort-path') : null;
				console.log(`Processing field: ${field}, activeField: ${activeField}, svg exists: ${!!svg}, path exists: ${!!path}`);
				
				if (!svg || !path) return;
				console.log(`Updating indicator for field: ${field}, activeField: ${activeField}`);
				
				if (field === activeField) {
					// Active field: show green color and correct path
					const sortDir = window.sortStates[tableId][field];
					console.log(`Updating active field ${field} with sort ${sortDir}`);
					
					// Update stroke color to green using style
					path.style.stroke = '#22c55e';
					
					// Update the path based on sort direction
					const pathData = window.SORT_PATHS[sortDir] || window.SORT_PATHS.ASC;
					path.setAttribute('d', pathData);
					
					// Set opacity to full
					path.style.opacity = '1';
					console.log(`Applied path for ${sortDir}`);
				} else {
					// Inactive field: white and show default path
					path.style.stroke = 'white';
					path.setAttribute('d', window.SORT_PATHS.DEFAULT); // Use default path for unselected columns
					
					// Set opacity to full but white color
					path.style.opacity = '1';
				}
			}
		});
	}

	// Re-apply sort indicators after HTMX swaps the table content
	function reapplySortIndicators(tableId) {
		// Get the currently sorted field for this table
		const sortedField = window.currentSortField[tableId];
		if (sortedField) {
			//console.log(`Reapplying sort indicators for table ${tableId}, field: ${sortedField}`);
			updateSortIndicators(tableId, sortedField);
		}
	}

	// Listen for HTMX swap completion
	document.addEventListener('htmx:afterSettle', function(event) {
		// Check if this is a table container being updated
		const element = event.detail.target;
		if (element && element.id) {
			// Check for any of our table types
			if (element.id.includes('table') || element.classList.contains('flex')) {
				// Try to find the table ID - could be the element itself or a parent
				let tableId = null;
				if (element.id && (element.id.includes('tipdok') || element.id.includes('zakljucni') || element.id.includes('table'))) {
					tableId = element.id;
				} else {
					// Look for parent with id containing 'table'
					let parent = element.parentElement;
					while (parent && !tableId) {
						if (parent.id && (parent.id.includes('tipdok') || parent.id.includes('zakljucni') || parent.id.includes('table'))) {
							tableId = parent.id;
						}
						parent = parent.parentElement;
					}
				}
				
				if (tableId) {
					reapplySortIndicators(tableId);
				}
			}
		}
	});

	// Add keyboard navigation for arrow up/down scrolling
	document.addEventListener('keydown', function(event) {
		// Only handle arrow keys
		if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
		
		// Find the closest table container with id containing 'table'
		let table = document.activeElement?.closest('[id*="table"]');
		
		// If no focused table, find any table on page
		if (!table) {
			table = document.querySelector('[id*="table"]');
		}
		
		if (!table) return;
		
		// Find the scrollable container (the div with overflow-y-auto)
		const scrollContainer = table.querySelector('.overflow-y-auto, [style*="overflow"]');
		if (!scrollContainer) {
			console.log('No scroll container found');
			return;
		}
		
		const scrollAmount = 40; // pixels to scroll per key press
		
		if (event.key === 'ArrowUp') {
			event.preventDefault();
			scrollContainer.scrollTop -= scrollAmount;
		} else if (event.key === 'ArrowDown') {
			event.preventDefault();
			scrollContainer.scrollTop += scrollAmount;
		}
	});
	</script>
}
