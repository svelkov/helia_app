package templates

import (
	"fmt"
	"helia/internal/common"
	"helia/internal/domain"
)

templ Table(tbl domain.TableData) {
	<div id={ tbl.TableID } class="w-full h-full border-collapse">
		if tbl.HasExportExcel || tbl.HasExportPdf {
			<div class="mb-1 flex justify-end space-x-1">
				if tbl.HasExportExcel {
					<button
						hx-get={ fmt.Sprintf("%s?format=excel", tbl.URLGetAll) }
						hx-trigger="click"
						class={ common.ClassPdfButton }
					>
						@Icon("file_export", "h-5 w-5 mr-1 inline-block")
						Excel
					</button>
				}
				if tbl.HasExportPdf {
					<button
						hx-get={ fmt.Sprintf("%s?format=pdf", tbl.URLGetAll) }
						hx-trigger="click"
						class={ common.ClassPdfButton }
					>
						@Icon("file_export", "h-5 w-5 mr-1 inline-block")
						PDF
					</button>
				}
			</div>
		}
		<div class="overflow-x-auto overflow-y-hidden rounded-t-lg">
			<table class="w-full h-full border-collapse border-r">
				@TableHeader(tbl)
				@TableBody(tbl, tbl.URLPrefix)
			</table>
		</div>
		if tbl.ShowPagination {
			<div class="mt-2 flex justify-center items-center">
				@TablePagination(tbl)
			</div>
		}
		<!-- Container for HTMX-loaded dialog -->
		<div id="dialog-container" hx-on="htmx:afterSwap:deactivateActionsColumn()"></div>
	</div>
	@DeactivateActionsColumn()
	@ShowMessage()
	@OpenDialogScript(tbl.TableID)
}

templ TableHeader(tbl domain.TableData) {
	<thead class="bg-blue-500 text-white border-b border-white">
		<tr>
			for _, header := range tbl.Headers {
				<th
					scope="col"
					class={ fmt.Sprintf("px-1 py-1 text-left text-xs font-medium text-white uppercase tracking-wider border-r border-white %s", 
						func() string {
							if header.Sortable {
								return "cursor-pointer hover:bg-blue-600 select-none"
							}
							return ""
						}()) }
					if header.Sortable {
						hx-get={ fmt.Sprintf("%s?sortBy=%s&sortOrder={sortOrder}", tbl.URLGetAll, header.Field) }
						hx-target={ fmt.Sprintf("#%s-body", tbl.TableID) }
						hx-swap="innerHTML"
						hx-trigger="click"
						hx-vals={ fmt.Sprintf(`js:{sortOrder: getSortOrder('%s', '%s')}`, tbl.TableID, header.Field) }
						onclick={ templ.JSFuncCall("toggleSort", tbl.TableID, header.Field, "this") }
					}
				>
					<div class="flex items-center justify-between">
						<span>{ header.Label }</span>
						if header.Sortable {
							<span class={ fmt.Sprintf("sort-indicator-%s ml-2", header.Field) }>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 opacity-90">
									<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 10 4-6 4 6H8Zm8 4-4 6-4-6h8Z"></path>
								</svg>
							</span>
						}
					</div>
				</th>
			}
			if tbl.ShowActions {
				<th scope="col" class=" actions-column px-3 py-2 text-center text-xs font-medium text-white uppercase tracking-wider w-0 whitespace-nowrap border-r border-white bg-blue-500 sticky right-0 z-10">
					Actions
				</th>
			}
		</tr>
	</thead>
}

templ TableBody(tbl domain.TableData, urlPrefix string) {
	<tbody id={ fmt.Sprintf("%s-body", tbl.TableID) } class="bg-white divide-y divide-gray-200">
		for i, row := range tbl.Rows {
			<tr
				class={ fmt.Sprintf("hover:bg-blue-100 cursor-pointer %s", func() string {
						if i == 0 {
								return "bg-gray-50 selected" 
							}
                            if i%2 == 1 {
                                return "bg-gray-50"
                            } else {
                                return ""
                            }
                        }()) }
				if tbl.FuncClick !="" {
					onclick="selectRow(this)"
				}
				if tbl.FuncDblClick !="" {
					data-dest-field={ tbl.DestField }
					ondblclick="handleDblClickKontoSelection(this)"
				}
				if tbl.DetailTarget != "" && tbl.DetailURL != "" {
					hx-get={ fmt.Sprintf("%s%s", tbl.DetailURL, row.ID) }
					hx-target={ fmt.Sprintf("%s", tbl.DetailTarget) }
					hx.swap="innerHTML"
					hx-vals={ fmt.Sprintf(`{"idfnal": "%s"}`, row.ID) }
				}
			>
				for _, cell := range row.Fields {
					<td class="px-3 py-1 whitespace-nowrap border-r">
						<div class="text-sm text-gray-900">{ cell }</div>
					</td>
				}
				if tbl.ShowActions && ( tbl.BtnUpdate.IsVisible || tbl.BtnDelete.IsVisible ) {
					<td class="actions-column px-3 py-0.5 whitespace-nowrap text-right text-sm font-medium bg-white w-0 sticky right-0  z-10">
						<div class="flex space-x-1 justify-end">
							if tbl.BtnUpdate.IsVisible {
								<button
									hx-get={ tbl.BtnUpdate.HxActionURL }
									hx-target="#dialog-container"
									hx-swap="innerHTML"
									onclick="event.stopPropagation(); openDialog()"
									hx-vals={ fmt.Sprintf(`{"url": "%s", "id": "%s"}`, tbl.URLPrefix, row.ID) }
									class="bg-indigo-500 hover:bg-indigo-700 text-white py-1 px-1 rounded text-xs flex items-center"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 mr-1">
										<path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z"></path>
										<path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z"></path>
									</svg>
									{ tbl.BtnUpdate.LabelText }
								</button>
							}
							if row.HasDelete {
								<button
									hx-get={ tbl.BtnDelete.HxActionURL }
									hx-target="#dialog-container"
									hx-swap="innerHTML"
									onclick="event.stopPropagation(); openDialog()"
									hx-vals={ fmt.Sprintf(`{"url": "%s", "id": "%s"}`, tbl.URLPrefix, row.ID) }
									class="bg-red-500 hover:bg-red-700 text-white py-1 px-2 rounded text-xs flex items-center"
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 mr-1">
										<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
									</svg>
									{ tbl.BtnDelete.LabelText }
								</button>
							}
						</div>
					</td>
				}
			</tr>
		}
	</tbody>
}

templ TableScript() {
	// Add this to your script
	<script>
	document.addEventListener('DOMContentLoaded', function() {
		const tableBody = document.getElementById('promettable-body');
		
		if (tableBody) {
			// Single click for selection
			tableBody.addEventListener('click', function(e) {
				const row = e.target.closest('tr');
				if (row) {
					selectRow(row);
				}
			});
			
			// Double click for selection and closing dialog
			tableBody.addEventListener('dblclick', function(e) {
				const row = e.target.closest('tr');
				if (row) {
					handleRowDoubleClick(row);
				}
			});
		}
	});

	// New function to handle double-click
	function handleRowDoubleClick(row) {
		// Get the selected row data
		const cells = row.querySelectorAll('td');
		const rowData = {
			konto: cells[0].textContent.trim(),
			sifra: cells[1].textContent.trim(),
			naziv: cells[2].textContent.trim()
		};
		
		console.log("Selected record:", rowData);
		
		// You can use this data as needed - for example:
		// - Populate form fields
		// - Update another table
		// - Send to backend
		useSelectedRecord(rowData);
		
		// Close the dialog
		closeDialog();
	}

	function selectRow(row) {
		console.log("Row clicked:", row);
		// Deselect any previously selected row by removing the 'bg-blue-300' class
		const selectedRow = document.querySelector('.bg-blue-300');
		if (selectedRow) {
			selectedRow.classList.remove('bg-blue-300');
		}

		// Select the clicked row
		row.classList.add('bg-blue-300');
	}

	// Function to use the selected record data
	function useSelectedRecord(data) {
		// Example: Populate some input fields
		// document.getElementById('some-input').value = data.konto;
		// document.getElementById('another-input').value = data.naziv;
		
		// Or dispatch a custom event that other parts of your app can listen to
		const event = new CustomEvent('recordSelected', { detail: data });
		document.dispatchEvent(event);
		
		// Or store in a global variable
		window.selectedRecord = data;
		
		console.log("Using selected record:", data);
	}

	// Function to close the dialog (you might need to adjust this based on your dialog implementation)
	function closeDialog() {
		// If using a modal/dialog element
		const dialog = document.getElementById('your-dialog-id');
		if (dialog) {
			dialog.close();
			dialog.style.display = 'none';
		}
		
		// If using a div with display styles
		const dialogDiv = document.querySelector('.dialog-container');
		if (dialogDiv) {
			dialogDiv.style.display = 'none';
		}
		
		// Remove backdrop if exists
		const backdrop = document.querySelector('.dialog-backdrop');
		if (backdrop) {
			backdrop.remove();
		}
	}

</script>
}
