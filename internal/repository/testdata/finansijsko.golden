### bils write the iznosi of the obrada
UPDATE "bils" SET tgod = v.tgod, tgodh = v.tgodh, pgod = v.pgod, pgodh = v.pgodh, pgodps = v.pgodps, pgodhps = v.pgodhps, xopizmene = $1, xdatizmene = now() FROM (values ($2::bigint, $3::numeric, $4::integer, $5::numeric, $6::integer, $7::numeric, $8::integer), ($9::bigint, $10::numeric, $11::integer, $12::numeric, $13::integer, $14::numeric, $15::integer)) v(bilsid, tgod, tgodh, pgod, pgodh, pgodps, pgodhps) WHERE (bils.bilsid = v.bilsid) AND (bils.god = $16) AND (bils.kar = $17)
[]interface {}{"ana", 11, 1.25e+06, 1250, 980000, 980, 980000, 980, 12, 0, 0, 0, 0, 0, 0, 2026, 7}
in transaction: false

