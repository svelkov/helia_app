### final brojevi
select coalesce((select max(x.brotp) from edok x where x.god = $1 and x.kar = $2 and x.mag = $3 and x.vrd = $4 and x.brotp < $5), 0)::int + 1, coalesce((select max(d.dokum) from rdok d where d.god = $6 and d.kar = $7 and d.mag = $8 and d.vrd = $9), 0)::int + 1
[]interface {}{2026, 7, 30, 188, 990000, 2026, 7, 30, 188}
