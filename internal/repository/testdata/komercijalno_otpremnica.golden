[]interface {}{"43", sql.NullTime{Time:time.Date(2026, time.March, 10, 0, 0, 0, 0, time.UTC), Valid:true}, 3, 2026, 7}
in transaction: true

### new robni nalog
insert into rnal (god, kar, magaciniid, mag, dug, pot, opis, datob, danal, nalog, nalsts, oper, rbr, brst, brdo, idtipdok, tipdok, xdatunosa, xopunos) select $1, $2, $3, $4, 0, 0, 'Aut. kreiran nalog', $5, $6, coalesce((select max(x.nalog) from rnal x where x.tipdok = $7 and x.god = $8 and x.kar = $9), 0)::int + 1, '', $10, 0, 0, 0, (select t.idtipdok from tipdok t where t.tipdok = $11 and t.god = $12 and t.kar = $13 limit 1), $14, now(), $15 RETURNING rnalid
[]interface {}{2026, 7, 3, 30, time.Date(2026, time.March, 10, 0, 0, 0, 0, time.UTC), time.Date(2026, time.March, 10, 0, 0, 0, 0, time.UTC), "43", 2026, 7, "ana", "43", 2026, 7, "43", "ana"}
in transaction: true

