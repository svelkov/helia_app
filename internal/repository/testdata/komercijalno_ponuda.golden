### dobavljači of the ids
select f.idfkpl::bigint as idfkpl, coalesce(f.konto, '') as konto, coalesce(f.sifra, '') as sifra, coalesce(f.naziv, '') as naziv, coalesce(p.adresa, '') as adresa, coalesce(p.mesto, '') as mesto, f.idpartneri::bigint as idpartneri from fkpl f left join partneri p on p.idpartneri = f.idpartneri WHERE (f.idfkpl in ($1, $2)) AND (f.god = $3) AND (f.kar = $4)
[]interface {}{101, 102, 2026, 7}
in transaction: false

### dobavljači without ids
(no statement)

### pregled of one magacin
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.rok, 0)::int as rok, coalesce((select string_agg(coalesce(f.naziv, ''), ', ' order by array_position(string_to_array(e.vezniid, ';'), f.idfkpl::text)) from fkpl f where f.god = e.god and f.kar = e.kar and f.idfkpl::text = any(string_to_array(e.vezniid, ';'))), '') as dobavljaci, coalesce(k.sifkom::text || '-' || coalesce(k.imeprezime, ''), '') as referent, coalesce(e.foot, '') as foot from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag left join magacini m on m.magaciniid = e.magaciniid left join komercijalisti k on k.komid = e.komid WHERE (e.vrd = $2) AND (coalesce(e.doksts, '') = $3) AND (e.magaciniid = $4) AND (e.god = $5) AND (e.kar = $6) ORDER BY e.dadok desc nulls last, e.dokum desc
[]interface {}{"ANA", 310, "10", 3, 2026, 7}
in transaction: false

### pregled of all the magacini of the user
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.rok, 0)::int as rok, coalesce((select string_agg(coalesce(f.naziv, ''), ', ' order by array_position(string_to_array(e.vezniid, ';'), f.idfkpl::text)) from fkpl f where f.god = e.god and f.kar = e.kar and f.idfkpl::text = any(string_to_array(e.vezniid, ';'))), '') as dobavljaci, coalesce(k.sifkom::text || '-' || coalesce(k.imeprezime, ''), '') as referent, coalesce(e.foot, '') as foot from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag left join magacini m on m.magaciniid = e.magaciniid left join komercijalisti k on k.komid = e.komid WHERE (e.vrd = $2) AND (coalesce(e.doksts, '') = $3) AND (e.god = $4) AND (e.kar = $5) ORDER BY e.dadok desc nulls last, e.dokum desc
[]interface {}{"ANA", 310, "40", 2026, 7}
in transaction: false

### pregled with the search
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.rok, 0)::int as rok, coalesce((select string_agg(coalesce(f.naziv, ''), ', ' order by array_position(string_to_array(e.vezniid, ';'), f.idfkpl::text)) from fkpl f where f.god = e.god and f.kar = e.kar and f.idfkpl::text = any(string_to_array(e.vezniid, ';'))), '') as dobavljaci, coalesce(k.sifkom::text || '-' || coalesce(k.imeprezime, ''), '') as referent, coalesce(e.foot, '') as foot from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag left join magacini m on m.magaciniid = e.magaciniid left join komercijalisti k on k.komid = e.komid WHERE (e.vrd = $2) AND (coalesce(e.doksts, '') = $3) AND (e.magaciniid = $4) AND ((coalesce(e.dokum::text, '') ilike $5 or coalesce(e.foot, '') ilike $6 or coalesce(k.imeprezime, '') ilike $7)) AND (e.god = $8) AND (e.kar = $9) ORDER BY e.dadok desc nulls last, e.dokum desc
[]interface {}{"ANA", 310, "10", 3, "%12%", "%12%", "%12%", 2026, 7}
in transaction: false

### dobavljač of the print
select coalesce(f.konto, ''), coalesce(f.sifra, ''), coalesce(p.naziv, f.naziv, ''), coalesce(p.adresa, ''), coalesce(p.mesto, ''), coalesce(p.tippdv, 0)::int, coalesce(p.pib, ''), coalesce(p.budzetski, false), coalesce(p.jbkjs, ''), coalesce(p.jmbg, ''), coalesce(p.bpg, ''), coalesce(p.index, ''), coalesce(p.telefon, '') from fkpl f left join partneri p on p.idpartneri = f.idpartneri WHERE (f.idfkpl = $1) AND (f.god = $2) AND (f.kar = $3)
[]interface {}{101, 2026, 7}
in transaction: false

