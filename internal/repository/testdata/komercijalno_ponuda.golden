### add a zahtev za ponudu
insert into edok (god, kar, rnalid, vrd, dokum, dadok, mag, magaciniid, iznos, rbr, opis, rok, fkto, fana, pla, otp, foot, brst, vrdokid, idorgjed, mestotrid, komid, sifval, kurs, vaziza, vezniid, doksts, knjige_1, knjige_2, jm1, jm2, xdatunosa, xopunos) values ($1, $2, 0, $3, $4, $5, $6, $7, 0, 0, $8, $9, '', '', '', '', $10, 0, 0, $11, $12, $13, $14, $15, $16, $17, $18, 'N', 'N', '', '', now(), $19) RETURNING rdokid
[]interface {}{2026, 7, 310, 4, time.Date(2026, time.March, 2, 0, 0, 0, 0, time.UTC), 1, 3, "Zahtev za ponudu br: 4", 10, "Hitno", sql.NullInt64{Int64:2, Valid:true}, sql.NullInt64{Int64:0, Valid:false}, sql.NullInt64{Int64:5, Valid:true}, 941, 1, 1, "101;102;", "10", "ana"}
in transaction: true

### change a zahtev za ponudu
UPDATE "edok" SET dadok = $1, rok = $2, komid = $3, idorgjed = $4, mestotrid = $5, foot = $6, sifval = $7, kurs = $8, vaziza = $9, vezniid = $10, xdatizmene = now(), xopizmene = $11 WHERE (rdokid = $12) AND (god = $13) AND (kar = $14)
[]interface {}{time.Date(2026, time.March, 2, 0, 0, 0, 0, time.UTC), 10, sql.NullInt64{Int64:5, Valid:true}, sql.NullInt64{Int64:2, Valid:true}, sql.NullInt64{Int64:0, Valid:false}, "Hitno", 941, 1, 1, "101;102;", "ana", 15, 2026, 7}
in transaction: true

### change a zahtev za ponudu of another period
UPDATE "edok" SET dadok = $1, rok = $2, komid = $3, idorgjed = $4, mestotrid = $5, foot = $6, sifval = $7, kurs = $8, vaziza = $9, vezniid = $10, xdatizmene = now(), xopizmene = $11 WHERE (rdokid = $12) AND (god = $13) AND (kar = $14)
[]interface {}{time.Date(2026, time.March, 2, 0, 0, 0, 0, time.UTC), 10, sql.NullInt64{Int64:5, Valid:true}, sql.NullInt64{Int64:2, Valid:true}, sql.NullInt64{Int64:0, Valid:false}, "Hitno", 941, 1, 1, "101;102;", "ana", 15, 2026, 7}
in transaction: true

### confirm a zahtev za ponudu for a dobavljač
UPDATE "edok" SET doksts = $1, fkto = $2, fana = $3, xdatizmene = now(), xopizmene = $4 WHERE (rdokid = $5) AND (coalesce(doksts, '') = $6) AND (god = $7) AND (kar = $8)
[]interface {}{"40", "4350", "00012", "ana", 15, "10", 2026, 7}
in transaction: false

### delete a zahtev za ponudu: its sources slobodne again
UPDATE "epro" SET ststatus = $1 WHERE (rproid in (select p.rproid1 from epro p where p.rdokid = $2 and p.god = epro.god and p.kar = epro.kar)) AND (god = $3) AND (kar = $4)
[]interface {}{"S", 15, 2026, 7}
in transaction: true
delete from epro WHERE (rdokid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{15, 2026, 7}
in transaction: true
delete from edok WHERE (rdokid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{15, 2026, 7}
in transaction: true

### slobodne stavke of the potvrđeni zahtevi za nabavku of a magacin
select p.rproid::bigint as rproid, e.rdokid::bigint as rdokid, coalesce(e.god, 0)::int as god, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(o.ojozn::text || '-' || coalesce(o.naziv, ''), '') as oj, coalesce(p.sifra, 0)::int as sifra, coalesce(s.naziv, '') as naziv, coalesce(s.jm, '') as jm, coalesce(p.trazkolic, 0)::float8 as kolicina from epro p join edok e on e.rdokid = p.rdokid and e.god = p.god and e.kar = p.kar left join rsif s on s.rsifid = p.rsifid left join orgjed o on o.idorgjed = e.idorgjed WHERE (coalesce(e.doksts, '') = $1) AND (e.magaciniid = $2) AND (coalesce(p.ststatus, '') = $3) AND (e.vrd in (select v.vrd from dokvrsta v where v.god = e.god and v.kar = e.kar and upper(trim(coalesce(v.modul, ''))) = $4 and upper(trim(coalesce(v.grpdok, ''))) = $5)) AND (p.god = $6) AND (p.kar = $7) ORDER BY e.dadok nulls last, e.dokum, p.rbr
[]interface {}{"40", 3, "S", "PRO", "INR", 2026, 7}
in transaction: false

### a stavka of a zahtev za nabavku to take
select p.rproid::bigint, coalesce(p.sifra, 0)::int, coalesce(s.po, 0)::int, coalesce(p.rsifid, 0)::bigint, coalesce(p.trazkolic, 0)::float8 from epro p join edok e on e.rdokid = p.rdokid and e.god = p.god and e.kar = p.kar left join rsif s on s.rsifid = p.rsifid WHERE (p.rproid = $1) AND (coalesce(e.doksts, '') = $2) AND (coalesce(p.ststatus, '') = $3) AND (not exists (select 1 from epro x where x.rproid1 = p.rproid and x.god = p.god and x.kar = p.kar)) AND (p.god = $4) AND (p.kar = $5)
[]interface {}{21, "40", "S", 2026, 7}
in transaction: true

### a stavka of a zahtev za nabavku already taken
select p.rproid::bigint, coalesce(p.sifra, 0)::int, coalesce(s.po, 0)::int, coalesce(p.rsifid, 0)::bigint, coalesce(p.trazkolic, 0)::float8 from epro p join edok e on e.rdokid = p.rdokid and e.god = p.god and e.kar = p.kar left join rsif s on s.rsifid = p.rsifid WHERE (p.rproid = $1) AND (coalesce(e.doksts, '') = $2) AND (coalesce(p.ststatus, '') = $3) AND (not exists (select 1 from epro x where x.rproid1 = p.rproid and x.god = p.god and x.kar = p.kar)) AND (p.god = $4) AND (p.kar = $5)
[]interface {}{21, "40", "S", 2026, 7}
in transaction: true

