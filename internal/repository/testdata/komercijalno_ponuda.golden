### vrste of the zahtevi za ponudu
select coalesce(v.vrd, 0)::text as key, coalesce(v.vrd, 0)::text || ' - ' || coalesce(v.opis, '') as value from dokvrsta v WHERE (upper(trim(coalesce(v.modul, ''))) = $1) AND (upper(trim(coalesce(v.grpdok, ''))) = $2) AND (v.god = $3) AND (v.kar = $4) ORDER BY v.vrd
[]interface {}{"PRO", "ZPN", 2026, 7}
in transaction: false

### zahtev za ponudu with its texts
select e.rdokid::bigint, coalesce(e.vrd, 0)::int, coalesce(e.dokum, 0)::int, e.dadok, coalesce(e.rok, 0)::int, coalesce(e.magaciniid, 0)::int, coalesce(e.mag, 0)::int, e.komid::bigint, coalesce(k.sifkom, 0)::int, coalesce(k.imeprezime, ''), e.idorgjed::bigint, coalesce(concat_ws(' - ', nullif(o.ojozn::text, ''), nullif(o.naziv, '')), ''), e.mestotrid::bigint, coalesce(concat_ws(' - ', nullif(t.mtroska, ''), nullif(t.opis, '')), ''), coalesce(e.foot, ''), coalesce(e.doksts, ''), coalesce(e.xopunos, ''), coalesce(e.knjige_1, ''), coalesce(e.knjige_4, ''), coalesce(e.sifval, 0)::int, coalesce((select v.oznval from valute v where v.sifval = e.sifval order by v.idvalute limit 1), ''), coalesce(e.kurs, 0)::float8, coalesce(e.vaziza, 0)::int, coalesce(e.vezniid, '') from edok e left join komercijalisti k on k.komid = e.komid left join orgjed o on o.idorgjed = e.idorgjed left join mestotr t on t.mestotrid = e.mestotrid WHERE (e.rdokid = $1) AND (e.god = $2) AND (e.kar = $3)
[]interface {}{15, 2026, 7}
in transaction: false

