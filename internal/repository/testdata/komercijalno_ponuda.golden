### delete a stavka: its source slobodna again
UPDATE "epro" SET ststatus = $1 WHERE (rproid in (select p.rproid1 from epro p where p.rproid = $2 and p.rdokid = $3 and p.god = epro.god and p.kar = epro.kar)) AND (god = $4) AND (kar = $5)
