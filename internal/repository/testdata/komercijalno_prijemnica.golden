[]interface {}{2026, 7, 35, 51, 25, 4, "ana"}
in transaction: true

### pregled of the nepotvrđene of one magacin
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.fkto, '') as fkto, coalesce(e.fana, '') as fana, coalesce(f.naziv, '') as dobavljac, coalesce(e.opis, '') as opis, coalesce(e.rok, 0)::int as rok, e.datiz as datiz, coalesce(e.otp, '') as otp, coalesce(e.kamt, '') as kamt from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag join magacini m on m.magaciniid = e.magaciniid left join fkpl f on f.god = e.god and f.kar = e.kar and f.vkonta = 1 and f.konto = e.fkto and f.sifra = e.fana WHERE (e.vrd in (select v.vrd from dokvrsta v where v.god = m.god and v.kar = m.kar and ( (upper(trim(coalesce(m.tipmag, ''))) in ('P', 'S', 'L', 'D') and upper(trim(coalesce(v.grpdok, ''))) = $2 and upper(trim(coalesce(v.modul, ''))) in ($3, $4)) or (upper(trim(coalesce(m.tipmag, ''))) = 'V' and upper(trim(coalesce(v.grpdok, ''))) = $5 and upper(trim(coalesce(v.modul, ''))) in ($6, $7))))) AND (coalesce(e.doksts, '') = $8) AND (e.magaciniid = $9) AND (e.god = $10) AND (e.kar = $11) ORDER BY e.dadok desc nulls last, e.vrd desc, e.dokum desc
[]interface {}{"ANA", "ULS", "PRO", "SVI", "PLT", "ROB", "SVI", "10", 3, 2026, 7}
in transaction: false

### pregled of the potvrđene of all the magacini with the search
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.fkto, '') as fkto, coalesce(e.fana, '') as fana, coalesce(f.naziv, '') as dobavljac, coalesce(e.opis, '') as opis, coalesce(e.rok, 0)::int as rok, e.datiz as datiz, coalesce(e.otp, '') as otp, coalesce(e.kamt, '') as kamt from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag join magacini m on m.magaciniid = e.magaciniid left join fkpl f on f.god = e.god and f.kar = e.kar and f.vkonta = 1 and f.konto = e.fkto and f.sifra = e.fana WHERE (e.vrd in (select v.vrd from dokvrsta v where v.god = m.god and v.kar = m.kar and ( (upper(trim(coalesce(m.tipmag, ''))) in ('P', 'S', 'L', 'D') and upper(trim(coalesce(v.grpdok, ''))) = $2 and upper(trim(coalesce(v.modul, ''))) in ($3, $4)) or (upper(trim(coalesce(m.tipmag, ''))) = 'V' and upper(trim(coalesce(v.grpdok, ''))) = $5 and upper(trim(coalesce(v.modul, ''))) in ($6, $7))))) AND (coalesce(e.doksts, '') in ($8, $9)) AND ((coalesce(e.dokum::text, '') ilike $10 or coalesce(e.opis, '') ilike $11 or coalesce(f.naziv, '') ilike $12 or coalesce(e.fana, '') ilike $13)) AND (e.god = $14) AND (e.kar = $15) ORDER BY e.dadok desc nulls last, e.vrd desc, e.dokum desc
[]interface {}{"ANA", "ULS", "PRO", "SVI", "PLT", "ROB", "SVI", "30", "40", "%metal%", "%metal%", "%metal%", "%metal%", 2026, 7}
in transaction: false

