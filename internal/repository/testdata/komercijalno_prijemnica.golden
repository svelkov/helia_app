### vrste of the prijemnice of a magacin
select coalesce(v.vrd, 0)::text as key, coalesce(v.vrd, 0)::text || ' - ' || coalesce(v.opis, '') as value from dokvrsta v join magacini m on m.magaciniid = $1 WHERE (v.god = m.god and v.kar = m.kar and ( (upper(trim(coalesce(m.tipmag, ''))) in ('P', 'S', 'L', 'D') and upper(trim(coalesce(v.grpdok, ''))) = $2 and upper(trim(coalesce(v.modul, ''))) in ($3, $4)) or (upper(trim(coalesce(m.tipmag, ''))) = 'V' and upper(trim(coalesce(v.grpdok, ''))) = $5 and upper(trim(coalesce(v.modul, ''))) in ($6, $7)))) AND (v.god = $8) AND (v.kar = $9) ORDER BY v.vrd
[]interface {}{3, "ULS", "PRO", "SVI", "PLT", "ROB", "SVI", 2026, 7}
in transaction: false

### prijemnica not found
select e.rdokid::bigint, coalesce(e.vrd, 0)::int, coalesce((select v.dokvrstaid from dokvrsta v where v.god = e.god and v.kar = e.kar and v.vrd = e.vrd order by v.dokvrstaid limit 1), 0)::bigint, coalesce((select trim(v.predznak) from dokvrsta v where v.god = e.god and v.kar = e.kar and v.vrd = e.vrd order by v.dokvrstaid limit 1), ''), coalesce(e.dokum, 0)::int, e.dadok, e.datotp, coalesce(e.tipdok, ''), coalesce(e.magaciniid, 0)::int, coalesce(e.mag, 0)::int, coalesce(e.mag::text || '-' || coalesce(m.opis, ''), ''), coalesce(m.adresa, ''), coalesce(m.analiza, 0)::int, coalesce(e.fkto, ''), coalesce(e.fana, ''), e.idorgjed::bigint, coalesce(concat_ws(' - ', nullif(o.ojozn::text, ''), nullif(o.naziv, '')), ''), e.mestotrid::bigint, coalesce(concat_ws(' - ', nullif(t.mtroska, ''), nullif(t.opis, '')), ''), coalesce(e.doksts, ''), coalesce(e.knjige_1, ''), coalesce(e.vrdokid, 0)::bigint, coalesce(z.dokum, 0)::int, z.dadok from edok e join magacini m on m.magaciniid = e.magaciniid left join orgjed o on o.idorgjed = e.idorgjed left join mestotr t on t.mestotrid = e.mestotrid left join edok z on z.rdokid = e.vrdokid and z.god = e.god and z.kar = e.kar WHERE (e.rdokid = $1) AND (e.vrd in (select v.vrd from dokvrsta v where v.god = m.god and v.kar = m.kar and ( (upper(trim(coalesce(m.tipmag, ''))) in ('P', 'S', 'L', 'D') and upper(trim(coalesce(v.grpdok, ''))) = $2 and upper(trim(coalesce(v.modul, ''))) in ($3, $4)) or (upper(trim(coalesce(m.tipmag, ''))) = 'V' and upper(trim(coalesce(v.grpdok, ''))) = $5 and upper(trim(coalesce(v.modul, ''))) in ($6, $7))))) AND (e.god = $8) AND (e.kar = $9)
[]interface {}{35, "ULS", "PRO", "SVI", "PLT", "ROB", "SVI", 2026, 7}
in transaction: false

### add a prijemnica of a porudžbenica
insert into edok (god, kar, rnalid, vrd, dokum, dadok, mag, magaciniid, iznos, rbr, opis, rok, fkto, fana, pla, foot, otp, sifval, kurs, vaziza, komid, mi, brst, brotp, datotp, vrdokid, idorgjed, mestotrid, doksts, knjige_1, knjige_2, jm1, jm2, xdatunosa, xopunos) select z.god, z.kar, 0, $1, $2, $3, $4, $5, 0, 0, $6, z.rok, z.fkto, z.fana, z.pla, z.foot, z.otp, z.sifval, z.kurs, z.vaziza, z.komid, z.mi, 0, $7, $8, z.rdokid, z.idorgjed, z.mestotrid, $9, 'N', 'N', '', '', now(), $10 from edok z WHERE (z.rdokid = $11) AND (z.god = $12) AND (z.kar = $13) RETURNING rdokid
[]interface {}{198, 4, time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), 1, 3, "Prijemnica br: 4", 4, time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), "10", "ana", 25, 2026, 7}
in transaction: true

### change the datum of a prijemnica
UPDATE "edok" SET dadok = $1, datotp = $2, xdatizmene = now(), xopizmene = $3 WHERE (rdokid = $4) AND (god = $5) AND (kar = $6)
[]interface {}{time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), "ana", 35, 2026, 7}
in transaction: true

### change a prijemnica of another period
UPDATE "edok" SET dadok = $1, datotp = $2, xdatizmene = now(), xopizmene = $3 WHERE (rdokid = $4) AND (god = $5) AND (kar = $6)
[]interface {}{time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), time.Date(2026, time.March, 9, 0, 0, 0, 0, time.UTC), "ana", 35, 2026, 7}
in transaction: true

### confirm a prijemnica
UPDATE "edok" SET doksts = $1, xdatizmene = now(), xopizmene = $2 WHERE (rdokid = $3) AND (coalesce(doksts, '') = $4) AND (god = $5) AND (kar = $6)
[]interface {}{"40", "ana", 35, "10", 2026, 7}
in transaction: true

### delete a prijemnica with its stavke and pakovanja
