### artikal of any tip
select r.rsifid::bigint, coalesce(r.sifra, 0)::int, coalesce(r.naziv, ''), coalesce(r.jm, ''), coalesce(r.po, 0)::int from rsif r WHERE (r.sifra = $1) AND (r.god = $2) AND (r.kar = $3) ORDER BY r.rsifid LIMIT 1
[]interface {}{1001, 2026, 7}
in transaction: false

### base of the OTK of an artikal
select count(p.sifra)::int from epro p join edok e on e.rdokid = p.rdokid and e.god = p.god and e.kar = p.kar WHERE (e.vrd = $1) AND (p.sifra = $2) AND (coalesce(e.doksts, '') <> $3) AND (e.god = $4) AND (e.kar = $5)
[]interface {}{198, 1001, "10", 2026, 7}
in transaction: false

### konta of a magacin
select distinct trim(k.konto) as key, trim(k.konto) as value from magkonto k WHERE (k.magaciniid = $1) AND (trim(coalesce(k.konto, '')) <> '') AND (k.god = $2) AND (k.kar = $3) ORDER BY trim(k.konto)
[]interface {}{3, 2026, 7}
in transaction: false

### pakovanja of a prijemnica
select p.rproid::bigint as rproid, coalesce(p.rbr, 0)::int as rbr, coalesce(p.sifra, 0)::int as sifra, coalesce(s.naziv, '') as naziv, coalesce(s.jm, '') as jm, coalesce((select k.kolpopak from kolpak k where k.rproid = p.rproid and k.rdokid = p.rdokid and k.god = p.god and k.kar = p.kar order by k.kolpakid limit 1), 0)::float8 as kolpopak, coalesce((select k.brpak from kolpak k where k.rproid = p.rproid and k.rdokid = p.rdokid and k.god = p.god and k.kar = p.kar order by k.kolpakid limit 1), 0)::float8 as brpak from epro p left join rsif s on s.rsifid = p.rsifid WHERE (p.rdokid = $1) AND (p.god = $2) AND (p.kar = $3) ORDER BY p.rbr
[]interface {}{35, 2026, 7}
in transaction: false

