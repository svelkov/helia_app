[]interface {}{1001, 2026, 7}
in transaction: false

### add the nalog of a profaktura
insert into edok (god, kar, rnalid, vrd, tipdok, dokum, dadok, mag, magaciniid, iznos, rbr, opis, rok, fkto, fana, komid, pla, foot, otp, posuslnab, brst, brotp, vaziza, sifval, idorgjed, mestotrid, vrugrabat, ugrabat, vkase, pkase, doksts, rcenovnikhdrid, bttowght, netwght, totboxs, brpaleta, vrdokid, knjige_1, knjige_2, jm1, jm2, xdatunosa, xopunos) select z.god, z.kar, 0, $1, z.tipdok, $2, z.dadok, z.mag, z.magaciniid, z.iznos, 0, $3, z.rok, z.fkto, z.fana, z.komid, z.pla, z.foot, z.otp, z.posuslnab, 0, 0, z.vaziza, z.sifval, z.idorgjed, z.mestotrid, z.vrugrabat, z.ugrabat, z.vkase, z.pkase, $4, z.rcenovnikhdrid, z.bttowght, z.netwght, z.totboxs, z.brpaleta, z.rdokid, 'N', 'N', '', '', now(), $5 from edok z WHERE (z.rdokid = $6) AND (z.god = $7) AND (z.kar = $8) RETURNING rdokid
[]interface {}{350, 3, "Nalog za izdavanje robe br: 3", "10", "ana", 45, 2026, 7}
in transaction: true

### copy the stavke into the nalog
insert into epro (god, kar, rdokid, sifra, po, rsifid, rbr, mag, magaciniid, trazkolic, ncena, cena, fcena, cenaval, rab, otk, serija, roktr, konto, vrd, dokum, dadok, xdatunosa, xopunos) select p.god, p.kar, $1, p.sifra, p.po, p.rsifid, p.rbr, p.mag, p.magaciniid, p.trazkolic, p.ncena, p.cena, p.fcena, p.cenaval, p.rab, p.otk, p.serija, p.roktr, p.konto, $2, $3, p.dadok, now(), $4 from epro p WHERE (p.rdokid = $5) AND (p.god = $6) AND (p.kar = $7)
[]interface {}{46, 350, 3, "ana", 45, 2026, 7}
in transaction: true

### mark the nalog formed
UPDATE "edok" SET doksts = $1, xdatizmene = now(), xopizmene = $2 WHERE (rdokid = $3) AND (coalesce(doksts, '') in ($4, $5, $6)) AND (god = $7) AND (kar = $8)
[]interface {}{"40", "ana", 45, "10", "20", "", 2026, 7}
in transaction: true

### pregled of the nepotvrđene of one magacin
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.fkto, '') as fkto, coalesce(e.fana, '') as fana, coalesce(f.naziv, '') as kupac, coalesce(e.opis, '') as opis, coalesce(e.rok, 0)::int as rok, coalesce(e.otp, '') as otp, coalesce(e.doksts, '') as doksts, coalesce((select n.dokum from edok n where n.vrdokid = e.rdokid and n.god = e.god and n.kar = e.kar order by n.rdokid limit 1), 0)::int as nalogdokum from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag left join magacini m on m.magaciniid = e.magaciniid left join fkpl f on f.god = e.god and f.kar = e.kar and f.vkonta = 1 and f.konto = e.fkto and f.sifra = e.fana WHERE (e.vrd in (select v.vrd from dokvrsta v where v.god = e.god and v.kar = e.kar and upper(trim(coalesce(v.modul, ''))) = $2 and upper(trim(coalesce(v.grpdok, ''))) = $3)) AND (coalesce(e.doksts, '') = $4) AND (e.magaciniid = $5) AND (e.god = $6) AND (e.kar = $7) ORDER BY e.dadok desc nulls last, e.vrd desc, e.dokum desc
[]interface {}{"ANA", "PRO", "PRF", "10", 3, 2026, 7}
in transaction: false

### pregled of the potvrđene of all the magacini with the search
select e.rdokid::bigint as rdokid, coalesce(m.mag::text || '-' || coalesce(m.opis, ''), '') as magacin, coalesce(e.vrd, 0)::int as vrd, coalesce(e.dokum, 0)::int as dokum, e.dadok as dadok, coalesce(e.fkto, '') as fkto, coalesce(e.fana, '') as fana, coalesce(f.naziv, '') as kupac, coalesce(e.opis, '') as opis, coalesce(e.rok, 0)::int as rok, coalesce(e.otp, '') as otp, coalesce(e.doksts, '') as doksts, coalesce((select n.dokum from edok n where n.vrdokid = e.rdokid and n.god = e.god and n.kar = e.kar order by n.rdokid limit 1), 0)::int as nalogdokum from edok e join (select distinct mu.mag from maguser mu where upper(mu.iduser) = $1) u on u.mag = e.mag left join magacini m on m.magaciniid = e.magaciniid left join fkpl f on f.god = e.god and f.kar = e.kar and f.vkonta = 1 and f.konto = e.fkto and f.sifra = e.fana WHERE (e.vrd in (select v.vrd from dokvrsta v where v.god = e.god and v.kar = e.kar and upper(trim(coalesce(v.modul, ''))) = $2 and upper(trim(coalesce(v.grpdok, ''))) = $3)) AND (coalesce(e.doksts, '') in ($4, $5)) AND ((coalesce(e.dokum::text, '') ilike $6 or coalesce(e.foot, '') ilike $7 or coalesce(f.naziv, '') ilike $8 or coalesce(e.fana, '') ilike $9)) AND (e.god = $10) AND (e.kar = $11) ORDER BY e.dadok desc nulls last, e.vrd desc, e.dokum desc
[]interface {}{"ANA", "PRO", "PRF", "20", "40", "%metal%", "%metal%", "%metal%", "%metal%", 2026, 7}
in transaction: false

