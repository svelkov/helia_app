### rnal one document less
UPDATE "rnal" SET brdo = greatest(coalesce(brdo, 0) - 1, 0) WHERE (rnalid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{9, 2026, 7}
in transaction: true

