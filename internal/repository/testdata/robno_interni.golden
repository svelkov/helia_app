[]interface {}{77, 2026, 7}
in transaction: true

### rpro form of a porudžbenica stavka
select r.sifra::text as key, coalesce(r.konto, '') as c1, coalesce(r.kolic, 0)::float8::text as c2, coalesce(r.ncena, 0)::float8::text as c3, coalesce(r.po, 0)::text as c4, coalesce((select x.pp from rpor x where x.po = r.po and x.datum <= r.dadok order by x.datum desc limit 1), 0)::float8::text as c5 from rpro r WHERE (r.rproid = $1) AND (r.rdokid = $2) AND (r.god = $3) AND (r.kar = $4)
[]interface {}{77, 41, 2026, 7}
in transaction: false

