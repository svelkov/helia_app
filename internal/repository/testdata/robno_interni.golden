[]interface {}{2026, 7, 3, "1320", 15}
in transaction: false

### rsif artikal with ncena by barkod
select a.sifra::text as key, coalesce(a.naziv, '') as c1, coalesce(a.jm, '') as c2, coalesce(a.po, 0)::text as c3, coalesce((select x.pp from rpor x where x.po = a.po and x.datum <= $1::date order by x.datum desc limit 1), 0)::float8::text as c4, coalesce((select c.ncena from rcene c where c.god = a.god and c.kar = a.kar and c.sifra = a.sifra limit 1), 0)::float8::text as c5 from rsif a WHERE (a.god = $2) AND (a.kar = $3) AND (a.barkod = $4) LIMIT 1
[]interface {}{interface {}(nil), 2026, 7, "8600123456789"}
in transaction: false

