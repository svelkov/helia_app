### promet ulaz per magacin and artikal
WITH stavke AS (select rdok.mag, rdok.magaciniid, rdok.danal, rpro.sifra, rsif.naziv, rsif.jm, rsif.pro, rsif.proizsifra, rsif.komercopis, upper(dokvrsta.kodknj) as kodknj, 1 as znak, coalesce(rpro.kolic, 0) as kolic, round(coalesce(rpro.kolic, 0) * coalesce(rpro.cena, 0), 2) as magvred, 1 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0), 2) as fakvred, 1 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0) * coalesce(rpro.rab, 0) / 100, 2) as rabat from rdok inner join rpro on rpro.rdokid = rdok.rdokid inner join rsif on rsif.rsifid = rpro.rsifid inner join dokvrsta on dokvrsta.god = rdok.god and dokvrsta.kar = rdok.kar and dokvrsta.vrd = rdok.vrd where rpro.god = $1 and rpro.kar = $2 and rdok.mag >= $3 and rdok.mag <= $4 and rdok.danal >= $5 and rdok.danal <= $6 and upper(dokvrsta.kodknj) in ('D') and rpro.sifra > 0), agg AS (select s.mag as mag, min(s.magaciniid) as magaciniid, s.sifra as sifra_art, coalesce(min(s.naziv), '') as naziv, coalesce(min(s.jm), '') as jm, coalesce(min(s.pro), '') as pro, coalesce(min(s.proizsifra), '') as proizsifra, coalesce(min(s.komercopis), '') as komercopis, coalesce(sum(case when s.danal < $7 then s.znak * s.kolic end), 0) as koldodat, coalesce(sum(case when s.danal >= $8 and s.kodknj = 'D' then s.kolic end), 0) as ulaz, coalesce(sum(case when s.danal >= $9 and s.kodknj = 'P' then s.kolic end), 0) as izlaz, coalesce(sum(s.znak * s.kolic), 0) as kolnadan, coalesce(sum(case when s.danal < $10 then s.fakvred end), 0) as fakvreddo, coalesce(sum(case when s.danal < $11 then s.rabat end), 0) as rabatdo, coalesce(sum(case when s.danal < $12 then s.znak * s.magvred end), 0) as magvreddo, coalesce(sum(case when s.danal >= $13 then s.fakvred end), 0) as fakvrednost, coalesce(sum(case when s.danal >= $14 then s.rabat end), 0) as rabat, coalesce(sum(case when s.danal >= $15 then s.znak * s.magvred end), 0) as magvrednost, coalesce(sum(s.fakvred), 0) as fakvrednostnadan, coalesce(sum(s.rabat), 0) as rabatnadan, coalesce(sum(s.znak * s.magvred), 0) as magvrednostnadan from stavke s group by s.mag, s.sifra) select agg.*, (select coalesce(sum(coalesce(r.ulaz, 0) - coalesce(r.izlaz, 0)), 0) from rsta r where r.god = $16 and r.kar = $17 and r.magaciniid = agg.magaciniid and r.sifra = agg.sifra_art) as stanje from agg ORDER BY agg.sifra_art, agg.mag
[]interface {}{2026, 7, "1", "9", "2026-01-01", "2026-03-31", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", 2026, 7}
in transaction: false

### promet ulaz i izlaz, sum of the magacini
WITH stavke AS (select rdok.mag, rdok.magaciniid, rdok.danal, rpro.sifra, rsif.naziv, rsif.jm, rsif.pro, rsif.proizsifra, rsif.komercopis, upper(dokvrsta.kodknj) as kodknj, case when upper(dokvrsta.kodknj) = 'P' then -1 else 1 end as znak, coalesce(rpro.kolic, 0) as kolic, round(coalesce(rpro.kolic, 0) * coalesce(rpro.cena, 0), 2) as magvred, 0 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0), 2) as fakvred, 0 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0) * coalesce(rpro.rab, 0) / 100, 2) as rabat from rdok inner join rpro on rpro.rdokid = rdok.rdokid inner join rsif on rsif.rsifid = rpro.rsifid inner join dokvrsta on dokvrsta.god = rdok.god and dokvrsta.kar = rdok.kar and dokvrsta.vrd = rdok.vrd where rpro.god = $1 and rpro.kar = $2 and rdok.mag >= $3 and rdok.mag <= $4 and rdok.danal >= $5 and rdok.danal <= $6 and upper(dokvrsta.kodknj) in ('D', 'P') and rpro.sifra > 0), agg AS (select 0 as mag, 0 as magaciniid, s.sifra as sifra_art, coalesce(min(s.naziv), '') as naziv, coalesce(min(s.jm), '') as jm, coalesce(min(s.pro), '') as pro, coalesce(min(s.proizsifra), '') as proizsifra, coalesce(min(s.komercopis), '') as komercopis, coalesce(sum(case when s.danal < $7 then s.znak * s.kolic end), 0) as koldodat, coalesce(sum(case when s.danal >= $8 and s.kodknj = 'D' then s.kolic end), 0) as ulaz, coalesce(sum(case when s.danal >= $9 and s.kodknj = 'P' then s.kolic end), 0) as izlaz, coalesce(sum(s.znak * s.kolic), 0) as kolnadan, coalesce(sum(case when s.danal < $10 then s.fakvred end), 0) as fakvreddo, coalesce(sum(case when s.danal < $11 then s.rabat end), 0) as rabatdo, coalesce(sum(case when s.danal < $12 then s.znak * s.magvred end), 0) as magvreddo, coalesce(sum(case when s.danal >= $13 then s.fakvred end), 0) as fakvrednost, coalesce(sum(case when s.danal >= $14 then s.rabat end), 0) as rabat, coalesce(sum(case when s.danal >= $15 then s.znak * s.magvred end), 0) as magvrednost, coalesce(sum(s.fakvred), 0) as fakvrednostnadan, coalesce(sum(s.rabat), 0) as rabatnadan, coalesce(sum(s.znak * s.magvred), 0) as magvrednostnadan from stavke s group by s.sifra) select agg.*, (select coalesce(sum(coalesce(r.ulaz, 0) - coalesce(r.izlaz, 0)), 0) from rsta r where r.god = $16 and r.kar = $17 and r.sifra = agg.sifra_art and r.mag >= $18 and r.mag <= $19) as stanje from agg ORDER BY agg.sifra_art, agg.mag
[]interface {}{2026, 7, "1", "9", "2026-01-01", "2026-03-31", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", 2026, 7, "1", "9"}
in transaction: false

### promet izlaz
WITH stavke AS (select rdok.mag, rdok.magaciniid, rdok.danal, rpro.sifra, rsif.naziv, rsif.jm, rsif.pro, rsif.proizsifra, rsif.komercopis, upper(dokvrsta.kodknj) as kodknj, 1 as znak, coalesce(rpro.kolic, 0) as kolic, round(coalesce(rpro.kolic, 0) * coalesce(rpro.cena, 0), 2) as magvred, 1 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0), 2) as fakvred, 1 * round(coalesce(rpro.kolic, 0) * coalesce(rpro.fcena, 0) * coalesce(rpro.rab, 0) / 100, 2) as rabat from rdok inner join rpro on rpro.rdokid = rdok.rdokid inner join rsif on rsif.rsifid = rpro.rsifid inner join dokvrsta on dokvrsta.god = rdok.god and dokvrsta.kar = rdok.kar and dokvrsta.vrd = rdok.vrd where rpro.god = $1 and rpro.kar = $2 and rdok.mag >= $3 and rdok.mag <= $4 and rdok.danal >= $5 and rdok.danal <= $6 and upper(dokvrsta.kodknj) in ('P') and rpro.sifra > 0), agg AS (select s.mag as mag, min(s.magaciniid) as magaciniid, s.sifra as sifra_art, coalesce(min(s.naziv), '') as naziv, coalesce(min(s.jm), '') as jm, coalesce(min(s.pro), '') as pro, coalesce(min(s.proizsifra), '') as proizsifra, coalesce(min(s.komercopis), '') as komercopis, coalesce(sum(case when s.danal < $7 then s.znak * s.kolic end), 0) as koldodat, coalesce(sum(case when s.danal >= $8 and s.kodknj = 'D' then s.kolic end), 0) as ulaz, coalesce(sum(case when s.danal >= $9 and s.kodknj = 'P' then s.kolic end), 0) as izlaz, coalesce(sum(s.znak * s.kolic), 0) as kolnadan, coalesce(sum(case when s.danal < $10 then s.fakvred end), 0) as fakvreddo, coalesce(sum(case when s.danal < $11 then s.rabat end), 0) as rabatdo, coalesce(sum(case when s.danal < $12 then s.znak * s.magvred end), 0) as magvreddo, coalesce(sum(case when s.danal >= $13 then s.fakvred end), 0) as fakvrednost, coalesce(sum(case when s.danal >= $14 then s.rabat end), 0) as rabat, coalesce(sum(case when s.danal >= $15 then s.znak * s.magvred end), 0) as magvrednost, coalesce(sum(s.fakvred), 0) as fakvrednostnadan, coalesce(sum(s.rabat), 0) as rabatnadan, coalesce(sum(s.znak * s.magvred), 0) as magvrednostnadan from stavke s group by s.mag, s.sifra) select agg.*, (select coalesce(sum(coalesce(r.ulaz, 0) - coalesce(r.izlaz, 0)), 0) from rsta r where r.god = $16 and r.kar = $17 and r.magaciniid = agg.magaciniid and r.sifra = agg.sifra_art) as stanje from agg ORDER BY agg.sifra_art, agg.mag
[]interface {}{2026, 7, "1", "9", "2026-01-01", "2026-03-31", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", "2026-03-01", 2026, 7}
in transaction: false

### vrste dokumenata of a vrsta naloga
select vrd from dokvrsta d WHERE (exists (select 1 from regexp_split_to_table(coalesce(d.grpnal, ''), '[,;]') g where trim(g) = $1)) AND (d.god = $2) AND (d.kar = $3) ORDER BY vrd
[]interface {}{"70", 2026, 7}
in transaction: false

### ncena: promet of the artikal
select d.vrd::text as key, coalesce(p.kolic, 0)::float8::text as c1, coalesce(p.cena, 0)::float8::text as c2, coalesce(p.ncena, 0)::float8::text as c3, upper(trim(coalesce(v.kodknj, ''))) as c4 from rdok d join rpro p on p.rdokid = d.rdokid left join dokvrsta v on v.god = d.god and v.kar = d.kar and v.vrd = d.vrd WHERE (d.vrd <> 119 and d.vrd <> 133) AND (d.god = $1) AND (d.kar = $2) AND (p.sifra = $3) AND (d.magaciniid = $4) AND (d.danal <= $5) AND (d.dadok <= $6) ORDER BY d.danal asc, d.dadok asc, p.rproid
[]interface {}{2026, 7, 15, 3, time.Date(2026, time.March, 5, 0, 0, 0, 0, time.UTC), time.Date(2026, time.March, 5, 0, 0, 0, 0, time.UTC)}
in transaction: false

### ncena: first ulaz
select coalesce(p.ncena, 0)::float8::text as key from rdok d join rpro p on p.rdokid = d.rdokid WHERE (d.god = $1) AND (d.kar = $2) AND (d.danal >= $3) AND (d.vrd in (101, 110, 113, 117, 121, 129, 198, 131, 189)) AND (p.sifra = $4) AND (d.magaciniid = $5) ORDER BY d.danal asc LIMIT 1
[]interface {}{2026, 7, time.Date(2026, time.March, 5, 0, 0, 0, 0, time.UTC), 15, 3}
in transaction: false

