### rztr of the document
select z.rztrid, coalesce(z.fkto, '') as fkto, coalesce(z.fana, '') as fana, coalesce(k.naziv, '') as naziv, coalesce(z.dokdob, '') as dokdob, z.dadok, coalesce(z.rok, 0)::int as rok, coalesce(z.opis, '') as opis, coalesce(z.pornapomena, '') as pornapomena, coalesce(z.flguvozpdv, false) as flguvozpdv, coalesce(z.polje, '') as polje, coalesce(z.iznfak, 0)::float8 as iznfak, coalesce(z.iznos, 0)::float8 as iznos, coalesce(z.tkonto, '') as tkonto, coalesce(t.naziv, '') as tkontonaziv from rztr z left join lateral (select f.naziv from fkpl f where f.god = z.god and f.kar = z.kar and f.konto = z.fkto and f.sifra = z.fana limit 1) k on true left join lateral (select f.naziv from fkpl f where f.god = z.god and f.kar = z.kar and f.konto = z.tkonto and f.vkonta = 2 limit 1) t on true WHERE (z.rdokid = $1) AND (z.god = $2) AND (z.kar = $3) ORDER BY z.rztrid
[]interface {}{41, 2026, 7}
in transaction: false

