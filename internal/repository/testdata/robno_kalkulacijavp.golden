### rdok columns of the kalkulacija
select coalesce(r.epp_polje, ''), nullif(r.fseppid, 0)::bigint, coalesce(concat_ws(' - ', nullif(f.polje, ''), nullif(f.opis, '')), ''), coalesce(r.odbitni, false), coalesce(r.edokid, 0)::bigint, coalesce(e.dokum, 0)::int, e.dadok from rdok r left join fsepp f on f.fseppid = r.fseppid and f.god = r.god and f.kar = r.kar left join edok e on e.rdokid = r.edokid and e.god = r.god and e.kar = r.kar WHERE (r.rdokid = $1) AND (r.god = $2) AND (r.kar = $3)
[]interface {}{41, 2026, 7}
in transaction: false

