### konto of the magacin or of the stavke
select coalesce( (select m.konto from magkonto m where m.god = $1 and m.kar = $2 and m.magaciniid = $3 and coalesce(m.konto, '') <> '' order by m.magkontoid limit 1), (select p.konto from rpro p where p.rdokid = $4 and p.god = $5 and p.kar = $6 and coalesce(p.konto, '') <> '' order by p.rproid desc limit 1), '')
[]interface {}{2026, 7, 3, 41, 2026, 7}
in transaction: false

### šifre of the šifarnici
select coalesce((select f.mi from fisp f where f.fispid = $1 and f.god = $2 and f.kar = $3), 0)::bigint::text as key, coalesce((select k.sifkom from komercijalisti k where k.komid = $4 and k.god = $5 and k.kar = $6), 0)::text as c1, coalesce((select v.sifval from valute v where v.idvalute = $7), 0)::text as c2, coalesce((select b.sifbank from bnkizv b where b.bnkizvid = $8 and b.god = $9 and b.kar = $10), 0)::text as c3, coalesce((select p.keykat from porkat p where p.porkatid = $11), '') as c4, coalesce((select p.category from porkat p where p.porkatid = $12), '') as c5
[]interface {}{4, 2026, 7, 6, 2026, 7, 2, 8, 2026, 7, 3, 3}
in transaction: false

### avans by broj
select coalesce((select r.rdokid from rdok r where r.god = $1 and r.kar = $2 and r.vrd = 172 and r.dokum = $3 and r.fkto = $4 and r.fana = $5 and exists (select 1 from avansfakt af where af.avansid = r.rdokid) order by r.rdokid limit 1), 0)::bigint
[]interface {}{2026, 7, 4, "2040", "15"}
in transaction: false

### rdok by broj with fana for update
select rdokid, coalesce(fana, '') from rdok WHERE (god = $1) AND (kar = $2) AND (magaciniid = $3) AND (vrd = $4) AND (dokum = $5) FOR UPDATE
[]interface {}{2026, 7, 3, 10, 12}
in transaction: true

