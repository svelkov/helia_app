### rsif artikal of a stavka by barkod
select a.sifra::text as key, coalesce(a.naziv, '') as c1, coalesce(a.jm, '') as c2, coalesce(a.po, 0)::text as c3, coalesce(a.dani, 0)::text as c4, coalesce(nullif(trim(a.konto), ''), $1) as c5, coalesce(a.tip, '') as c6, coalesce((select x.pp from rpor x where x.po = a.po and x.datum <= $2::date order by x.datum desc limit 1), 0)::float8::text as c7, coalesce((select c.pcena from rcene c where c.god = a.god and c.kar = a.kar and c.sifra = a.sifra limit 1), 0)::float8::text as c8 from rsif a WHERE (a.god = $3) AND (a.kar = $4) AND (a.barkod = $5) LIMIT 1
[]interface {}{"1320", time.Date(2026, time.March, 1, 0, 0, 0, 0, time.UTC), 2026, 7, "8600123456789"}
in transaction: false

### rsta stanje of a stavka
select (coalesce(ulaz, 0) - coalesce(izlaz, 0))::float8, coalesce(vpcena, 0)::float8, coalesce(cena, 0)::float8, coalesce(ncena, 0)::float8, coalesce(prosnc, 0)::float8 from rsta WHERE (god = $1) AND (kar = $2) AND (magaciniid = $3) AND (konto = $4) AND (sifra = $5) ORDER BY rstaid LIMIT 1
[]interface {}{2026, 7, 3, "1320", 15}
in transaction: false

### rpro form of a stavka
select r.rproid::text as key, coalesce(r.sifra, 0)::text as c1, coalesce(nullif(r.naz1, ''), a.naziv, '') as c2, coalesce(r.konto, '') as c3, coalesce(r.jm, '') as c4, concat_ws('|', coalesce(r.kolic, 0)::float8, coalesce(r.fcena, 0)::float8, coalesce(r.rab, 0)::float8, coalesce(r.po, 0), coalesce(r.dani, 0), coalesce(r.ncena, 0)::float8, coalesce(r.cena, 0)::float8, coalesce(r.roktr, 0)::bigint, coalesce((select x.pp from rpor x where x.po = r.po and x.datum <= r.dadok order by x.datum desc limit 1), 0)::float8, coalesce((select sum(coalesce(t.ulaz, 0) - coalesce(t.izlaz, 0)) from rsta t where t.god = r.god and t.kar = r.kar and t.magaciniid = r.magaciniid and t.konto = r.konto and t.sifra = r.sifra), 0)::float8) as c5, coalesce(r.otk, '') as c6, coalesce(r.serija, '') as c7, coalesce(r.taxcat, '') as c8 from rpro r left join rsif a on a.god = r.god and a.kar = r.kar and a.sifra = r.sifra WHERE (r.rproid = $1) AND (r.rdokid = $2) AND (r.god = $3) AND (r.kar = $4)
[]interface {}{77, 41, 2026, 7}
in transaction: false

