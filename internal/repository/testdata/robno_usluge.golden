### magacin zalihe
select coalesce(tipzal, 0), coalesce(nacvodzal, 0) from magacini WHERE (magaciniid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{3, 2026, 7}
in transaction: false

### magkonto first konto
select trim(konto) from magkonto WHERE (god = $1) AND (kar = $2) AND (magaciniid = $3) AND (coalesce(trim(konto), '') <> '') ORDER BY magkontoid LIMIT 1
[]interface {}{2026, 7, 3}
in transaction: false

### rdok izvorni of another year
select dadok, coalesce(salesinvoiceid, 0)::float8, coalesce(status_salinv, '') from rdok WHERE (god = $1) AND (kar = $2) AND (mag = $3) AND (vrd = $4) AND (dokum = $5) ORDER BY rdokid LIMIT 1
[]interface {}{2025, 7, 1, 172, 4}
in transaction: false

### rsif artikal of a usluga by šifra
select a.sifra::text as key, coalesce(a.naziv, '') as c1, coalesce(a.jm, '') as c2, coalesce(a.po, 0)::text as c3, coalesce(a.tip, '') as c4, trim(coalesce(a.konto, '')) as c5, coalesce((select x.pp from rpor x where x.po = a.po and x.datum <= $1::date order by x.datum desc limit 1), 0)::float8::text as c6, coalesce((select c.cena from rcene c where c.god = a.god and c.kar = a.kar and c.sifra = a.sifra limit 1), 0)::float8::text as c7 from rsif a WHERE (a.god = $2) AND (a.kar = $3) AND (a.sifra::text = $4) LIMIT 1
[]interface {}{interface {}(nil), 2026, 7, "15"}
in transaction: false

### rsta stanje of a usluga
select (coalesce(ulaz, 0) - coalesce(izlaz, 0))::float8, coalesce(prosnc, 0)::float8, coalesce(vpcena, 0)::float8, coalesce(cena, 0)::float8 from rsta WHERE (god = $1) AND (kar = $2) AND (magaciniid = $3) AND (konto = $4) AND (sifra = $5) ORDER BY rstaid LIMIT 1
[]interface {}{2026, 7, 3, "1320", 15}
in transaction: false

### rdok stopa of a tarifa
select (case when coalesce(d.flgstaripdv, false) then coalesce((select x.pp from rpor x where x.po = $1 and x.datum <= (select max(y.datum) from rpor y where y.po = $2) - 1 order by x.datum desc limit 1), 0) else coalesce((select x.pp from rpor x where x.po = $3 and x.datum <= d.dadok order by x.datum desc limit 1), 0)::float8 end)::float8 from rdok d WHERE (d.rdokid = $4) AND (d.god = $5) AND (d.kar = $6)
[]interface {}{3, 3, 3, 41, 2026, 7}
in transaction: false

### rsif tip and stanje
select coalesce(a.tip, ''), coalesce((select (coalesce(r.ulaz, 0) - coalesce(r.izlaz, 0))::float8 from rsta r where r.god = a.god and r.kar = a.kar and r.magaciniid = $1 and r.konto = $2 and r.sifra = a.sifra order by r.rstaid limit 1), 0)::float8 from rsif a WHERE (a.god = $3) AND (a.kar = $4) AND (a.sifra = $5) LIMIT 1
[]interface {}{3, "1320", 2026, 7, 15}
in transaction: false

### rsif id and tip
select rsifid, coalesce(tip, '') from rsif WHERE (god = $1) AND (kar = $2) AND (sifra = $3) LIMIT 1
[]interface {}{2026, 7, 15}
in transaction: true

### dokusldet changed
select count(*) from dokusldet WHERE (rdokid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{41, 2026, 7}
in transaction: true
UPDATE "dokusldet" SET opisdet = $1 WHERE (rdokid = $2) AND (god = $3) AND (kar = $4)
[]interface {}{"Opis", 41, 2026, 7}
in transaction: true

### dokusldet added
select count(*) from dokusldet WHERE (rdokid = $1) AND (god = $2) AND (kar = $3)
[]interface {}{41, 2026, 7}
in transaction: true
insert into dokusldet (god, kar, edokid, rdokid, opisdet) values ($1, $2, 0, $3, $4)
[]interface {}{2026, 7, 41, "Opis"}
in transaction: true

### rpro stavka of a usluga to delete
select coalesce(p.rdokid, 0)::bigint, coalesce(p.sifra, 0), coalesce(p.konto, ''), coalesce(p.kolic, 0)::float8, coalesce(p.iznos, 0)::float8, coalesce(p.otk, ''), coalesce(p.serija, ''), coalesce(p.roktr, 0)::float8, coalesce(p.rbr, 0), coalesce((select a.tip from rsif a where a.rsifid = p.rsifid), '') from rpro p WHERE (p.rproid = $1) AND (p.god = $2) AND (p.kar = $3) FOR UPDATE
[]interface {}{77, 2026, 7}
in transaction: true

### rdok take iznos
UPDATE "rdok" SET iznos = round((coalesce(iznos, 0) - $1)::numeric, 2) WHERE (rdokid = $2) AND (god = $3) AND (kar = $4)
[]interface {}{10, 41, 2026, 7}
in transaction: true

### rpro form of a usluga
select coalesce(r.sifra, 0)::text as key, coalesce(r.naz1, '') as c1, (coalesce(r.konto, '') || '|' || coalesce(r.jm, '') || '|' || coalesce(r.taxcat, '') || '|' || coalesce(r.taxexreco, '') || '|' || coalesce(r.otk, '') || '|' || coalesce(r.serija, '')) as c2, coalesce(r.po, 0)::text as c3, coalesce((select x.pp from rpor x where x.po = r.po and x.datum <= d.dadok order by x.datum desc limit 1), 0)::float8::text as c4, (abs(coalesce(r.kolic, 0))::float8::text || '|' || coalesce(r.fcena, 0)::float8::text || '|' || coalesce(r.rab, 0)::float8::text || '|' || coalesce(r.ncena, 0)::float8::text) as c5, coalesce(r.roktr, 0)::bigint::text as c6, coalesce((select u.opisdet from dokusldet u where u.rdokid = r.rdokid order by u.dokusldetid limit 1), '') as c7 from rpro r join rdok d on d.rdokid = r.rdokid WHERE (r.rproid = $1) AND (r.rdokid = $2) AND (r.god = $3) AND (r.kar = $4)
[]interface {}{77, 41, 2026, 7}
in transaction: false

### rdok vrd of a stavka
select coalesce(vrd, 0) from rdok WHERE (rdokid = (select rdokid from rpro where rproid = $1)) AND (god = $2) AND (kar = $3)
[]interface {}{77, 2026, 7}
in transaction: false

### dokvrsta vrste of the group
select v.vrd from dokvrsta v WHERE (v.god = $1) AND (v.kar = $2) AND (v.vrd between $3 and $4) AND (upper(trim(coalesce(v.grpdok, ''))) = (select upper(trim(coalesce(g.grpdok, ''))) from dokvrsta g where g.god = $5 and g.kar = $6 and g.vrd = $7 limit 1)) ORDER BY v.vrd
[]interface {}{2026, 7, 1, 199, 2026, 7, 170}
in transaction: false

