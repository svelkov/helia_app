//		end
	CASE "FAK" , "FRP":
		iPreview(i100)
		IF gnDRZAVA = "SRBIJA" THEN
			HReadSeekFirst(RDOK,RDOKID,TBL_DOK.COL_RDOKID,hLockNo)
			HReadSeekFirst(DOKVRSTA,GODKARVRD,[gnGOD,gnKAR,RDOK.VRD],hLockNo)
			IF nTIPPROIZV  = 1 THEN 
				IF RDOK.SIFVAL = 0 OR RDOK.SIFVAL = nFVRSIFVAL THEN
					IF DOKVRSTA.DODOZNFAK <> "" THEN
						sRPTNAME = "ROB_RPT_STAMPA_FAKTURA_" +NoSpace(DOKVRSTA.DODOZNFAK)
					ELSE
						sRPTNAME = "ROB_RPT_STAMPA_FAKTURA"
					END 
					IF Upper(DOKVRSTA.DODOZNFAK) = "OPTISSIMO" THEN
						iPrintReport(sRPTNAME,RDOK.TIPDOK,RDOK.NALOG,RDOK.NALOG,RDOK.DOKUM,RDOK.DOKUM,RDOK.MAG,RDOK.VRD,RDOK.VRD,RADIO_Radio1,nTipStampe)
					ELSE
					    iPrintReport(sRPTNAME,RDOK.TIPDOK,RDOK.NALOG,RDOK.NALOG,RDOK.DOKUM,RDOK.DOKUM,RDOK.MAG,RDOK.VRD,RDOK.VRD,RADIO_Radio1)
					END    
				END
				IF RDOK.SIFVAL > 0 AND RDOK.SIFVAL <> nFVRSIFVAL THEN
					IF DOKVRSTA.DODOZNFAK <> "" THEN
						sRPTNAME = "PR_RPT_FAKTURA_OTPIZV_" +NoSpace(DOKVRSTA.DODOZNFAK)
					ELSE
						sRPTNAME = "PR_RPT_FAKTURA_OTPIZV"
					END 
					iPrintReport(sRPTNAME,RDOK.MAG,RDOK.TIPDOK,RDOK.VRD,RDOK.DOKUM,RDOK.DOKUM,RDOK.NALOG,RDOK.NALOG,RADIO_Radio1,CBOX_NAZIV,CBOX_KOMERCOPIS)
				END
			END
			IF nTIPPROIZV  = 2 THEN 
				IF RDOK.SIFVAL = 0 OR RDOK.SIFVAL = nFVRSIFVAL THEN
					IF DOKVRSTA.DODOZNFAK <> "" THEN
						sRPTNAME = "PR_RPT_FAKTURA_OTP_" +NoSpace(DOKVRSTA.DODOZNFAK)
					ELSE
						sRPTNAME = "PR_RPT_FAKTURA_OTP"
					END 
					iPrintReport(sRPTNAME,RDOK.MAG,RDOK.TIPDOK,RDOK.VRD,RDOK.DOKUM,RDOK.DOKUM,RDOK.NALOG,RDOK.NALOG,RADIO_Radio1)
				END
				IF RDOK.SIFVAL > 0 AND RDOK.SIFVAL <> nFVRSIFVAL THEN
					IF DOKVRSTA.DODOZNFAK <> "" THEN
						sRPTNAME = "PR_RPT_FAKTURA_OTPIZV_" +NoSpace(DOKVRSTA.DODOZNFAK)
					ELSE
						sRPTNAME = "PR_RPT_FAKTURA_OTPIZV"
					END 					
					iPrintReport(sRPTNAME,RDOK.MAG,RDOK.TIPDOK,RDOK.VRD,RDOK.DOKUM,RDOK.DOKUM,RDOK.NALOG,RDOK.NALOG,RADIO_Radio1,CBOX_NAZIV,CBOX_KOMERCOPIS)				
				END
			END
		END
		IF gnDRZAVA = "REPUBLIKA SRPSKA" THEN
			iPrintReport(ROB_RPT_STAMPA_FAKTURA_MED,TBL_DOK.COL_TIPDOK,TBL_DOK.COL_NALOG,TBL_DOK.COL_NALOG,TBL_DOK.COL_BRDOK,TBL_DOK.COL_BRDOK,TBL_DOK.COL_MAG,TBL_DOK.COL_VRD,TBL_DOK.COL_VRD)
