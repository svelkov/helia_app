SWITCH COMBO_VRD.COL_GRPDOK
	CASE "PLT":
	    iPreview(i100)
		IF DOKVRSTA.DODOZNFAK <> "" THEN
			sRPTNAME = "RPT_ROB_KALKULACIJA_" +NoSpace(DOKVRSTA.DODOZNFAK)
		ELSE
